+	workspaceId: z.string(),
+	pageId: z.string(),
+	changeKind: z.enum(PageChangeKind),
+})
+
+export class PageContentChangedEvent extends BaseIntegrationEvent<typeof PageContentChangedEventSchema> {
+	static override readonly name = 'integration.shared.page.content_changed' as const
+	static readonly schema = PageContentChangedEventSchema
+}
