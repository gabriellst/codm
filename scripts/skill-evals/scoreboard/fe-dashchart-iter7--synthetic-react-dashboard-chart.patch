+import { createFileRoute } from '@tanstack/react-router'
+import { z } from 'zod'
+import { zodValidator } from '@/lib/zod-validator'
+import { format, subDays } from 'date-fns'
+import { ChartTypeEnum } from '@template/client-typescript/typescript'
+
+import { SalesReportSection } from './-components/SalesReportSection'
+
+// Search schema: chartType + date range live in URL (bookmarkable/shareable).
+// tenancyScope is app-global store (useTenancyStore); frequency is fixed at DAILY for v1.
+export const reportsSearchSchema = z.object({
+	chartType: z.enum(ChartTypeEnum).default(ChartTypeEnum.income),
+	startDate: z.string().default(() => format(subDays(new Date(), 29), 'yyyy-MM-dd')),
+	endDate: z.string().default(() => format(new Date(), 'yyyy-MM-dd')),
+})
+
+export type ReportsSearch = z.infer<typeof reportsSearchSchema>
+
+export const Route = createFileRoute('/(app)/reports/')({
+	validateSearch: zodValidator(reportsSearchSchema),
+	component: RouteComponent,
+})
+
+function RouteComponent() {
+	return (
+		<div className="flex flex-1 flex-col overflow-y-auto p-6 md:p-8">
+			<SalesReportSection />
+		</div>
+	)
+}
