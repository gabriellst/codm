@@ -0,0 +1,27 @@
+import { SegmentTable } from './SegmentTable'
+import type { VariantProps } from './types'
+
+const PERIOD_ORDER = ['MORNING', 'AFTERNOON', 'EVENING', 'NIGHT'] as const
+
+const PERIOD_LABEL_KEYS: Record<(typeof PERIOD_ORDER)[number], string> = {
+	MORNING: 'dashboard.revenueChart.period.morning',
+	AFTERNOON: 'dashboard.revenueChart.period.afternoon',
+	EVENING: 'dashboard.revenueChart.period.evening',
+	NIGHT: 'dashboard.revenueChart.period.night',
+}
+
+export function PeriodVariant({ data, formatMoney, t }: VariantProps) {
+	if (data.kind !== 'period') return null
+
+	const rows = PERIOD_ORDER.map(key => {
+		const seg = data.segments[key]
+		return {
+			label: t(PERIOD_LABEL_KEYS[key]),
+			revenue: seg.revenue,
+			profit: seg.profit,
+			orders: seg.orders,
+		}
+	})
+
+	return <SegmentTable rows={rows} formatMoney={formatMoney} t={t} showProfit />
+}
diff --git a/packages/app/react/src/routes/(app)/reports/-components/SalesReportSection/RegionVariant.tsx b/packages/app/react/src/routes/(app)/reports/-components/SalesReportSection/RegionVariant.tsx
