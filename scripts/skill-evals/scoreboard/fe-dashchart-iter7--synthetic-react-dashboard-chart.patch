@@ -0,0 +1,24 @@
+import { SegmentTable } from './SegmentTable'
+import type { VariantProps } from './types'
+
+export function RegionVariant({ data, formatMoney, t }: VariantProps) {
+	if (data.kind !== 'region') return null
+
+	const rows = Object.entries(data.regions)
+		.sort(([, a], [, b]) => b.total.amountCents - a.total.amountCents)
+		.map(([key, region]) => ({
+			label: region.state || key,
+			revenue: region.total,
+			orders: region.orders,
+		}))
+
+	return (
+		<SegmentTable
+			rows={rows}
+			formatMoney={formatMoney}
+			t={t}
+			showProfit={false}
+			primaryLabel={t('reports.tableTotal')}
+		/>
+	)
+}
diff --git a/packages/app/react/src/routes/(app)/reports/-components/SalesReportSection/SegmentTable.tsx b/packages/app/react/src/routes/(app)/reports/-components/SalesReportSection/SegmentTable.tsx
new file mode 100644
index 000000000..33c2b5e21
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/SalesReportSection/SegmentTable.tsx
@@ -0,0 +1,57 @@
+import type { ComponentProps } from 'react'
+import type { SignedMoney } from '@template/client-typescript/typescript'
+import { cn } from '@/lib/utils'
+import type { SegmentRow } from './types'
+
+interface SegmentTableProps extends ComponentProps<'div'> {
+	rows: SegmentRow[]
+	formatMoney: (m: SignedMoney) => string
+	t: (k: string) => string
+	showProfit?: boolean
+	primaryLabel?: string
+}
+
+export function SegmentTable({
+	rows,
+	formatMoney,
+	t,
+	showProfit = true,
+	primaryLabel,
+	className,
+	...props
+}: SegmentTableProps) {
+	const maxCents = Math.max(...rows.map(r => r.revenue.amountCents), 1)
+	const revenueHeader = primaryLabel ?? t('reports.tableRevenue')
+
+	return (
+		<div className={cn('flex flex-col gap-0.5', className)} role="list" aria-label={t('reports.listAria')} {...props}>
+			{/* Column headers */}
+			<div className="mb-2 flex items-center gap-3 pb-2 border-b border-border text-xs font-medium text-muted-foreground">
+				<span className="flex-1">{revenueHeader}</span>
+				{showProfit ? <span className="w-24 text-right">{t('reports.tableProfit')}</span> : null}
+				<span className="w-12 text-right">{t('reports.tableOrders')}</span>
+			</div>
+
+			{rows.map(row => {
+				const barPct = maxCents > 0 ? Math.max(2, (row.revenue.amountCents / maxCents) * 100) : 2
+				return (
+					<div key={row.label} className="flex flex-col gap-1 py-2 border-b border-border/50 last:border-0" role="listitem" aria-label={row.label}>
+						<div className="flex items-center gap-3">
+							<span className="flex-1 text-sm font-medium text-foreground truncate">{row.label}</span>
+							<span className="w-24 text-right text-sm text-foreground tabular-nums">{formatMoney(row.revenue)}</span>
+							{showProfit ? (
+								<span className="w-24 text-right text-sm text-muted-foreground tabular-nums">
+									{row.profit ? formatMoney(row.profit) : '—'}
+								</span>
+							) : null}
+							<span className="w-12 text-right text-sm text-muted-foreground tabular-nums">{row.orders}</span>
+						</div>
+						<div className="h-1.5 w-full rounded-full bg-muted overflow-hidden">
+							<div className="h-full rounded-full bg-primary/70 transition-all" style={{ width: `${barPct}%` }} />
+						</div>
+					</div>
+				)
+			})}
+		</div>
+	)
+}
