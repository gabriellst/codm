index 000000000..11fa42d42
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/SalesReportSection/HourVariant.tsx
@@ -0,0 +1,17 @@
+import { SegmentTable } from './SegmentTable'
+import type { VariantProps } from './types'
+
+export function HourVariant({ data, formatMoney, t }: VariantProps) {
+	if (data.kind !== 'hour') return null
+
+	const rows = Object.entries(data.segments)
+		.sort(([a], [b]) => Number(a) - Number(b))
+		.map(([hour, seg]) => ({
+			label: `${hour}h`,
+			revenue: seg.revenue,
+			profit: seg.profit,
+			orders: seg.orders,
+		}))
+
+	return <SegmentTable rows={rows} formatMoney={formatMoney} t={t} showProfit />
+}
