@@ -0,0 +1,17 @@
+import { useLocale } from '@/hooks'
+import { SegmentTable } from './SegmentTable'
+import type { VariantProps } from './types'
+
+export function IncomeVariant({ data, formatMoney, t }: VariantProps) {
+	if (data.kind !== 'income') return null
+	const locale = useLocale()
+
+	const rows = data.buckets.map(b => ({
+		label: new Intl.DateTimeFormat(locale, { day: '2-digit', month: '2-digit' }).format(new Date(b.timestamp)),
+		revenue: b.revenue,
+		profit: b.profit,
+		orders: b.orders,
+	}))
+
+	return <SegmentTable rows={rows} formatMoney={formatMoney} t={t} showProfit />
+}
