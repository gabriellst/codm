index 000000000..d97c66e69
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/SalesReportSection/index.tsx
@@ -0,0 +1,166 @@
+import type { ComponentProps, ComponentType } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import {
+	useGetChart,
+	ChartTypeEnum,
+	type ChartType,
+	type GetChart200,
+	type SignedMoney,
+} from '@template/client-typescript/typescript'
+import { IconChevronDown, IconCheck } from '@tabler/icons-react'
+
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Input } from '@/components/ui/input'
+import {
+	DropdownMenu,
+	DropdownMenuContent,
+	DropdownMenuItem,
+	DropdownMenuTrigger,
+} from '@/components/ui/dropdown-menu'
+import { Empty, EmptyHeader, EmptyTitle, EmptyDescription } from '@/components/ui/empty'
+import { cn } from '@/lib/utils'
+import { useMoney } from '@/hooks'
+import { useTenancyStore } from '@/stores'
+
+import { IncomeVariant } from './IncomeVariant'
+import { WeekdayVariant } from './WeekdayVariant'
+import { HourVariant } from './HourVariant'
+import { PeriodVariant } from './PeriodVariant'
+import { RegionVariant } from './RegionVariant'
+import type { VariantProps } from './types'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+const RECORTE_OPTIONS: { value: ChartType; labelKey: string }[] = [
+	{ value: ChartTypeEnum.income, labelKey: 'enums.ChartType.income' },
+	{ value: ChartTypeEnum.weekday, labelKey: 'enums.ChartType.weekday' },
+	{ value: ChartTypeEnum.hour, labelKey: 'enums.ChartType.hour' },
+	{ value: ChartTypeEnum.period, labelKey: 'enums.ChartType.period' },
+	{ value: ChartTypeEnum.region, labelKey: 'enums.ChartType.region' },
+]
+
+const VARIANT_MAP: Record<ChartType, ComponentType<VariantProps>> = {
+	income: IncomeVariant,
+	weekday: WeekdayVariant,
+	hour: HourVariant,
+	period: PeriodVariant,
+	region: RegionVariant,
+}
+
+function isDataEmpty(data: GetChart200): boolean {
+	if (data.kind === 'income') return data.buckets.length === 0
+	if (data.kind === 'region') return Object.keys(data.regions).length === 0
+	return false
+}
+
+export function SalesReportSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const search = routeApi.useSearch()
+	const navigate = routeApi.useNavigate()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+	const formatMoneyValue = useMoney()
+
+	const { chartType, startDate, endDate } = search
+
+	const { data, isPending, isError } = useGetChart({
+		chartType,
+		tenancyScope,
+		frequency: 'DAILY',
+		startDate,
+		endDate,
+	})
+
+	const activeLabelKey =
+		RECORTE_OPTIONS.find(o => o.value === chartType)?.labelKey ?? 'enums.ChartType.income'
+
+	function handleChartTypeChange(next: ChartType) {
+		navigate({ search: prev => ({ ...prev, chartType: next }) })
+	}
+
+	function handleStartDateChange(e: React.ChangeEvent<HTMLInputElement>) {
+		navigate({ search: prev => ({ ...prev, startDate: e.target.value }) })
+	}
+
+	function handleEndDateChange(e: React.ChangeEvent<HTMLInputElement>) {
+		navigate({ search: prev => ({ ...prev, endDate: e.target.value }) })
+	}
+
+	const formatMoney = (m: SignedMoney) => formatMoneyValue({ amountCents: m.amountCents, currency: m.currency })
+	const tProp = (k: string) => t(k as never)
+
+	const VariantComponent = data ? VARIANT_MAP[data.kind] : null
+	const empty = data ? isDataEmpty(data) : false
+
+	return (
+		<div className={cn('flex flex-col gap-6', className)} {...props}>
+			{/* Header — always visible while data loads */}
+			<div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
+				<h1 className="text-2xl font-bold text-foreground">{t('reports.title')}</h1>
+				<div className="flex flex-wrap items-center gap-3">
+					<div className="flex items-center gap-2">
+						<Input
+							type="date"
+							value={startDate}
+							onChange={handleStartDateChange}
+							aria-label={t('reports.startDate')}
+							className="w-36 text-sm"
+						/>
+						<span className="text-muted-foreground" aria-hidden="true">–</span>
+						<Input
+							type="date"
+							value={endDate}
+							onChange={handleEndDateChange}
+							aria-label={t('reports.endDate')}
+							className="w-36 text-sm"
+						/>
+					</div>
+					<DropdownMenu>
+						<DropdownMenuTrigger
+							className="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent/50 hover:text-foreground"
+							aria-label={t('reports.recorteSelectorAria')}
+						>
+							{t(activeLabelKey as never)}
+							<IconChevronDown size={14} />
+						</DropdownMenuTrigger>
+						<DropdownMenuContent side="bottom" align="end">
+							{RECORTE_OPTIONS.map(opt => (
+								<DropdownMenuItem key={opt.value} onClick={() => handleChartTypeChange(opt.value)}>
+									<span className="flex-1">{t(opt.labelKey as never)}</span>
+									{chartType === opt.value ? <IconCheck size={14} className="text-primary" /> : null}
+								</DropdownMenuItem>
+							))}
+						</DropdownMenuContent>
+					</DropdownMenu>
+				</div>
+			</div>
+
+			{/* Data area */}
+			<Card className="p-6">
+				{isPending ? (
+					<div className="flex flex-col gap-3">
+						{Array.from({ length: 7 }).map((_, i) => (
+							<Skeleton key={i} className="h-10 w-full rounded-md" />
+						))}
+					</div>
+				) : isError ? (
+					<Empty>
+						<EmptyHeader>
+							<EmptyTitle>{t('reports.loadError')}</EmptyTitle>
+						</EmptyHeader>
+					</Empty>
+				) : empty ? (
+					<Empty>
+						<EmptyHeader>
+							<EmptyTitle>{t('reports.emptyTitle')}</EmptyTitle>
+							<EmptyDescription>{t('reports.emptyDescription')}</EmptyDescription>
+						</EmptyHeader>
+					</Empty>
+				) : VariantComponent ? (
+					<VariantComponent data={data!} formatMoney={formatMoney} t={tProp} />
+				) : null}
+			</Card>
+		</div>
+	)
+}
