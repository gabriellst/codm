+import { Text, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import type { CreateKitMutationRequest } from '@template/client-typescript/typescript'
+import { Button } from '@/components/ui/Button'
+import type { KitForm } from '../../-types'
+import { KitItemRow } from '../KitItemRow'
+
+type KitItem = CreateKitMutationRequest['items'][number]
+
+interface KitItemListProps {
+	form: KitForm
+	onOpenPicker: () => void
+}
+
+export function KitItemList({ form, onOpenPicker }: KitItemListProps) {
+	const { t } = useTranslation()
+
+	return (
+		<form.Subscribe selector={s => (s.values.items ?? []) as KitItem[]}>
+			{items => {
+				if (items.length === 0) {
+					return (
+						<View className="mx-5 mt-2 mb-1 items-center py-6 border border-dashed border-white/[0.12] rounded-xl gap-3">
+							<Text className="text-foreground-subtle font-sans text-sm text-center">
+								{t('kitForm.fields.items.empty.title')}
+							</Text>
+							<Button
+								label={t('kitForm.fields.items.empty.cta')}
+								variant="ghost"
+								size="sm"
+								onPress={onOpenPicker}
+							/>
+						</View>
+					)
+				}
+
+				return (
+					<View className="mx-5 mt-2 gap-2">
+						{items.map((item, index) => (
+							<KitItemRow
+								key={`${item.productId}-${index}`}
+								form={form}
+								item={item}
+								index={index}
+							/>
+						))}
+					</View>
+				)
+			}}
+		</form.Subscribe>
+	)
+}
diff --git a/packages/app/expo/app/(sheets)/kit-form/-components/KitItemRow/index.tsx b/packages/app/expo/app/(sheets)/kit-form/-components/KitItemRow/index.tsx
