+import { useState, useEffect } from 'react'
+import { Pressable, ScrollView, Text, View } from 'react-native'
+import { router } from 'expo-router'
+import { useForm } from '@tanstack/react-form'
+import { useQueryClient } from '@tanstack/react-query'
+import { Haptics } from 'react-native-nitro-haptics'
+import { useTranslation } from 'react-i18next'
+import { z } from 'zod/v4'
+import {
+	useCreateKit,
+	createKitMutationRequestSchema,
+	listKitsQueryKey,
+	productCostTypeSchema,
+	ProductCostTypeEnum,
+	QuantityModifierEnum,
+} from '@template/client-typescript/typescript'
+import { Protected } from '@/components/Protected'
+import { KeyboardAware } from '@/components/ui/KeyboardAware'
+import { Button } from '@/components/ui/Button'
+import { Input, InputGroup } from '@/components/ui/Input'
+import { NumField } from '@/components/ui/NumField'
+import { Eyebrow } from '@/components/ui/Eyebrow'
+import { surfaces } from '@/lib/tokens'
+import { useTypedSearchParams } from '@/lib/typed-route'
+import type { DeepPartial } from '@/lib'
+import { kitFormSchema, type KitFormData } from './-types'
+import { useKitFormStore } from './-stores/kit-form-store'
+import { KitItemEditor } from './-components/KitItemEditor'
+import { KitItemList } from './-components/KitItemList'
+import { ProductPickerOverlay } from './-components/ProductPickerOverlay'
+
+const searchParamsSchema = z.object({
+	type: productCostTypeSchema.default('SINGLE'),
+})
+
+export default function KitFormSheet() {
+	const { t } = useTranslation()
+	const queryClient = useQueryClient()
+	const createKit = useCreateKit()
+	const { reset } = useKitFormStore()
+
+	// Reset store on mount + cleanup on unmount so picker state never survives
+	// the sheet being dismissed and reopened.
+	useEffect(() => {
+		reset()
+		return () => {
+			reset()
+		}
+	}, [reset])
+
+	// isPickerOpen is ephemeral overlay state — useState is the sanctioned
+	// approach (CLAUDE.md: "Ephemeral overlay open-state → local useState").
+	const [isPickerOpen, setIsPickerOpen] = useState(false)
+
+	// Every field must be .default()-ed so garbage deep-link params fall back
+	// gracefully (never crash). type=MULTIPLE opens the sheet pre-selected.
+	const [{ type: typeFromParam }] = useTypedSearchParams(searchParamsSchema)
+
+	const defaultValues: DeepPartial<KitFormData> = {
+		type: typeFromParam,
+		shipping: 0,
+		items: [],
+		editingItemIndex: null,
+		draftProductId: null,
+		draftProductName: null,
+		draftQuantity: 1,
+		draftQuantityModifier: QuantityModifierEnum.EQ,
+	}
+
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: kitFormSchema },
+		onSubmit: async ({ value }) => {
+			const result = createKitMutationRequestSchema.safeParse({
+				name: value.name,
+				type: value.type,
+				shipping: value.shipping,
+				cost: value.cost,
+				items: value.items,
+			})
+			if (!result.success) return
+
+			await createKit.mutateAsync(
+				{ data: result.data },
+				{
+					onSuccess: () => {
+						Haptics.notification('success')
+						router.back()
+					},
+					onSettled: () =>
+						queryClient.invalidateQueries({ queryKey: listKitsQueryKey() }),
+				},
+			)
+		},
+	})
+
+	const openPicker = () => setIsPickerOpen(true)
+	const closePicker = () => setIsPickerOpen(false)
+
+	return (
+		<Protected>
+			<KeyboardAware style={{ backgroundColor: surfaces.surface1 }}>
+				<ScrollView
+					className="flex-1"
+					contentContainerStyle={{ paddingBottom: 32 }}
+					keyboardShouldPersistTaps="handled"
+					showsVerticalScrollIndicator={false}
+				>
+					{/* Header */}
+					<View className="px-5 pt-5 pb-1">
+						<Eyebrow>{t('kitForm.eyebrow')}</Eyebrow>
+						<Text className="text-foreground font-sans-bold text-2xl mt-1">
+							{t('kitForm.title')}
+						</Text>
+					</View>
+
+					{/* Kit name */}
+					<View className="px-5 pt-5 gap-1.5">
+						<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+							{t('kitForm.fields.name.label')}
+						</Text>
+						<form.Field name="name">
+							{field => (
+								<>
+									<InputGroup>
+										<Input
+											value={field.state.value ?? ''}
+											onChangeText={field.handleChange}
+											onBlur={field.handleBlur}
+											placeholder={t('kitForm.fields.name.placeholder')}
+										/>
+									</InputGroup>
+									{field.state.meta.isTouched && !field.state.meta.isValid ? (
+										<Text className="text-destructive text-xs font-sans">
+											{field.state.meta.errors.join(', ')}
+										</Text>
+									) : null}
+								</>
+							)}
+						</form.Field>
+					</View>
+
+					{/* Kit type chip selector */}
+					<View className="px-5 pt-4 gap-1.5">
+						<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+							{t('kitForm.fields.type.label')}
+						</Text>
+						<form.Field name="type">
+							{field => (
+								<View className="flex-row gap-2">
+									{([ProductCostTypeEnum.SINGLE, ProductCostTypeEnum.MULTIPLE] as const).map(opt => {
+										const active = field.state.value === opt
+										return (
+											<Pressable
+												key={opt}
+												onPress={() => field.handleChange(opt)}
+												className={[
+													'flex-1 py-3 items-center rounded-xl border',
+													active
+														? 'bg-white/[0.15] border-white/[0.4]'
+														: 'bg-white/[0.04] border-white/[0.08]',
+												].join(' ')}
+											>
+												<Text
+													className={[
+														'font-sans-semi text-sm',
+														active ? 'text-foreground' : 'text-foreground-subtle',
+													].join(' ')}
+												>
+													{t(`enums.ProductCostType.${opt}`)}
+												</Text>
+											</Pressable>
+										)
+									})}
+								</View>
+							)}
+						</form.Field>
+					</View>
+
+					{/* Shipping cost */}
+					<View className="px-5 pt-5 items-center">
+						<form.Field name="shipping">
+							{field => (
+								<NumField
+									label={t('kitForm.fields.shipping.label')}
+									value={field.state.value ?? 0}
+									onChange={field.handleChange}
+									step={0.5}
+									min={0}
+								/>
+							)}
+						</form.Field>
+					</View>
+
+					{/* Optional extra cost */}
+					<View className="px-5 pt-4 items-center">
+						<form.Field name="cost">
+							{field => (
+								<NumField
+									label={t('kitForm.fields.cost.label')}
+									value={field.state.value ?? 0}
+									onChange={field.handleChange}
+									step={0.5}
+									min={0}
+								/>
+							)}
+						</form.Field>
+					</View>
+
+					{/* Items section */}
+					<View className="px-5 pt-6 pb-1">
+						<Eyebrow>{t('kitForm.fields.items.label')}</Eyebrow>
+					</View>
+
+					{/* Item editor is always visible above the items list — owns the
+					    draft fields (product, quantity, modifier). Typing here does NOT
+					    re-render the list rows below (3-mode discriminant selector). */}
+					<KitItemEditor form={form} onOpenPicker={openPicker} />
+					<KitItemList form={form} onOpenPicker={openPicker} />
+
+					{/* Create kit — disabled until the API payload is wire-valid */}
+					<View className="px-5 pt-6">
+						<form.Subscribe
+							selector={s => ({ isSubmitting: s.isSubmitting, values: s.values })}
+						>
+							{({ isSubmitting, values }) => {
+								const isDisabled =
+									isSubmitting ||
+									createKit.isPending ||
+									!createKitMutationRequestSchema.safeParse({
+										name: values.name,
+										type: values.type,
+										shipping: values.shipping,
+										cost: values.cost,
+										items: values.items,
+									}).success
+								return (
+									<Button
+										label={t('kitForm.submit')}
+										fullWidth
+										onPress={() => void form.handleSubmit()}
+										disabled={isDisabled}
+									/>
+								)
+							}}
+						</form.Subscribe>
+					</View>
+				</ScrollView>
+			</KeyboardAware>
+
+			{/* In-page product picker — uses Sheet primitive (not a route change).
+			    useState ensures visibility resets every time the sheet mounts. */}
+			<ProductPickerOverlay open={isPickerOpen} onClose={closePicker} form={form} />
+		</Protected>
+	)
+}
