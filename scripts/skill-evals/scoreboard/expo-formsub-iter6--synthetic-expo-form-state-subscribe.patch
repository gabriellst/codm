+import { z } from 'zod/v4'
+import { useForm } from '@tanstack/react-form'
+import {
+	createKitMutationRequestSchema,
+	quantityModifierSchema,
+} from '@template/client-typescript/typescript'
+import type { DeepPartial } from '@/lib'
+
+// UI-only fields that live in the form but are stripped before submitting
+const kitFormUiSchema = z.object({
+	editingItemIndex: z.number().int().nullable(),
+	draftProductId: z.string().nullable(),
+	draftProductName: z.string().nullable(),
+	draftQuantity: z.number(),
+	draftQuantityModifier: quantityModifierSchema,
+})
+
+// Merged schema: API payload + UI-only editor state
+export const kitFormSchema = createKitMutationRequestSchema.and(kitFormUiSchema)
+
+export type KitFormData = z.infer<typeof kitFormSchema>
+
+// Type-only inference helper — NEVER called at runtime.
+// Gives every consumer a typed `form: KitForm` prop without re-deriving
+// TanStack Form's generic arguments at every call site.
+function _inferKitForm() {
+	const defaults: DeepPartial<KitFormData> = {}
+	return useForm({
+		defaultValues: defaults,
+		validators: { onChange: kitFormSchema },
+	})
+}
+
+export type KitForm = ReturnType<typeof _inferKitForm>
