+import { Pressable, Text, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import {
+	QuantityModifierEnum,
+	type QuantityModifier,
+} from '@template/client-typescript/typescript'
+import { Button } from '@/components/ui/Button'
+import { NumField } from '@/components/ui/NumField'
+import type { KitForm, KitFormData } from '../../-types'
+
+type KitItem = NonNullable<KitFormData['items']>[number]
+
+const MODIFIER_OPTIONS = [
+	QuantityModifierEnum.EQ,
+	QuantityModifierEnum.GT,
+	QuantityModifierEnum.GTE,
+	QuantityModifierEnum.LT,
+	QuantityModifierEnum.LTE,
+] as const
+
+interface KitItemEditorProps {
+	form: KitForm
+	onOpenPicker: () => void
+}
+
+export function KitItemEditor({ form, onOpenPicker }: KitItemEditorProps) {
+	const { t } = useTranslation()
+
+	const handleAction = () => {
+		const values = form.state.values
+		if (!values.draftProductId) return
+		const newItem: KitItem = {
+			productId: values.draftProductId,
+			quantity: values.draftQuantity ?? 1,
+			quantityModifier: (values.draftQuantityModifier ?? QuantityModifierEnum.EQ) as QuantityModifier,
+		}
+		const currentItems = (values.items ?? []) as KitItem[]
+		const idx = values.editingItemIndex
+		if (idx != null) {
+			const updated = [...currentItems]
+			updated[idx] = newItem
+			form.setFieldValue('items', updated)
+			form.setFieldValue('editingItemIndex', null)
+		} else {
+			form.setFieldValue('items', [...currentItems, newItem])
+		}
+		form.setFieldValue('draftProductId', null)
+		form.setFieldValue('draftProductName', null)
+		form.setFieldValue('draftQuantity', 1)
+		form.setFieldValue('draftQuantityModifier', QuantityModifierEnum.EQ)
+	}
+
+	const handleCancel = () => {
+		form.setFieldValue('editingItemIndex', null)
+		form.setFieldValue('draftProductId', null)
+		form.setFieldValue('draftProductName', null)
+		form.setFieldValue('draftQuantity', 1)
+		form.setFieldValue('draftQuantityModifier', QuantityModifierEnum.EQ)
+	}
+
+	return (
+		<View className="mx-5 mt-2 mb-1 border border-white/[0.1] rounded-xl p-4 gap-4">
+			{/* Product selector — tapping opens the in-page picker overlay */}
+			<View className="gap-1.5">
+				<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+					{t('kitForm.fields.productId.label')}
+				</Text>
+				<form.Subscribe selector={s => s.values.draftProductName ?? ''}>
+					{productName => (
+						<Pressable
+							onPress={onOpenPicker}
+							accessibilityRole="button"
+							accessibilityLabel={t('kitForm.fields.productId.label')}
+						>
+							<View className="bg-white/[0.08] rounded-[10px] px-4 py-3 flex-row items-center justify-between">
+								<Text
+									className={[
+										'flex-1 font-sans text-base',
+										productName ? 'text-foreground' : 'text-foreground-disabled',
+									].join(' ')}
+									numberOfLines={1}
+								>
+									{productName || t('kitForm.fields.productId.placeholder')}
+								</Text>
+								<Text className="text-foreground-subtle font-sans text-xs ml-2">
+									{t('kitForm.pickProduct')}
+								</Text>
+							</View>
+						</Pressable>
+					)}
+				</form.Subscribe>
+			</View>
+
+			{/* Quantity */}
+			<form.Field name="draftQuantity">
+				{field => (
+					<NumField
+						label={t('kitForm.fields.quantity.label')}
+						value={field.state.value ?? 1}
+						onChange={field.handleChange}
+						step={1}
+						min={1}
+					/>
+				)}
+			</form.Field>
+
+			{/* Quantity-modifier chip row */}
+			<View className="gap-1.5">
+				<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+					{t('kitForm.fields.quantityModifier.label')}
+				</Text>
+				<form.Field name="draftQuantityModifier">
+					{field => (
+						<View className="flex-row gap-2 flex-wrap">
+							{MODIFIER_OPTIONS.map(mod => {
+								const active = (field.state.value ?? QuantityModifierEnum.EQ) === mod
+								return (
+									<Pressable
+										key={mod}
+										onPress={() => field.handleChange(mod)}
+										className={[
+											'px-3 py-2 rounded-lg border',
+											active
+												? 'bg-white/[0.15] border-white/[0.4]'
+												: 'bg-white/[0.04] border-white/[0.08]',
+										].join(' ')}
+									>
+										<Text
+											className={[
+												'font-sans-semi text-xs',
+												active ? 'text-foreground' : 'text-foreground-subtle',
+											].join(' ')}
+										>
+											{t(`enums.QuantityModifier.${mod}`)}
+										</Text>
+									</Pressable>
+								)
+							})}
+						</View>
+					)}
+				</form.Field>
+			</View>
+
+			{/* Add / Save + Cancel */}
+			<form.Subscribe
+				selector={s => ({
+					canAdd: s.values.draftProductId != null,
+					isEditing: s.values.editingItemIndex != null,
+					isSubmitting: s.isSubmitting,
+				})}
+			>
+				{({ canAdd, isEditing, isSubmitting }) => (
+					<View className="gap-2">
+						<Button
+							label={isEditing ? t('kitForm.saveItem') : t('kitForm.addItem')}
+							fullWidth
+							variant={isEditing ? 'ghost' : 'chrome'}
+							onPress={handleAction}
+							disabled={!canAdd || isSubmitting}
+						/>
+						{isEditing ? (
+							<Button
+								label={t('kitForm.cancelEdit')}
+								variant="ghost"
+								fullWidth
+								onPress={handleCancel}
+								disabled={isSubmitting}
+							/>
+						) : null}
+					</View>
+				)}
+			</form.Subscribe>
+		</View>
+	)
+}
