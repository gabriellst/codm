@@ -0,0 +1,80 @@
+import { Pressable, Text, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import type { CreateKitMutationRequest, QuantityModifier } from '@template/client-typescript/typescript'
+import { useKitFormStore } from '../../-stores/kit-form-store'
+import type { KitForm } from '../../-types'
+
+type KitItem = CreateKitMutationRequest['items'][number]
+
+interface KitItemRowProps {
+	form: KitForm
+	item: KitItem
+	index: number
+}
+
+// 3-mode discriminant selector (FRM-P04 canonical pattern):
+//   0 = idle (no row is being edited)
+//   1 = THIS row is being edited
+//   2 = ANOTHER row is being edited (dim this one)
+// Returns a primitive so TanStack Form's equality check only fires on mode
+// changes — typing in the editor does NOT re-render every row.
+export function KitItemRow({ form, item, index }: KitItemRowProps) {
+	const { t } = useTranslation()
+	const { productNames } = useKitFormStore()
+
+	const handleSelect = () => {
+		form.setFieldValue('editingItemIndex', index)
+		form.setFieldValue('draftProductId', item.productId)
+		form.setFieldValue('draftProductName', productNames[item.productId] ?? null)
+		form.setFieldValue('draftQuantity', item.quantity)
+		form.setFieldValue('draftQuantityModifier', item.quantityModifier as QuantityModifier)
+	}
+
+	return (
+		<form.Subscribe
+			selector={s => {
+				const idx = s.values.editingItemIndex
+				if (idx == null) return 0 as const
+				return idx === index ? (1 as const) : (2 as const)
+			}}
+		>
+			{mode => {
+				const isSelected = mode === 1
+				const isOtherEditing = mode === 2
+				const productName =
+					productNames[item.productId] ?? item.productId.slice(0, 8) + '…'
+
+				return (
+					<Pressable
+						onPress={handleSelect}
+						accessibilityRole="button"
+						accessibilityLabel={t('kitForm.fields.items.editItem')}
+						className={[
+							'flex-row items-center px-4 py-3.5 border rounded-xl gap-3',
+							isOtherEditing ? 'opacity-40' : '',
+							isSelected
+								? 'bg-white/[0.1] border-white/[0.32]'
+								: 'bg-white/[0.04] border-white/[0.08]',
+						].join(' ')}
+					>
+						<View className="flex-1">
+							<Text className="text-foreground font-sans-semi text-sm" numberOfLines={1}>
+								{productName}
+							</Text>
+							<Text className="text-foreground-subtle font-sans text-xs mt-0.5">
+								{item.quantity}×
+								{' · '}
+								{t(`enums.QuantityModifier.${item.quantityModifier as QuantityModifier}`)}
+							</Text>
+						</View>
+						{isSelected ? (
+							<Text className="text-foreground-disabled font-sans-semi text-[10px] uppercase tracking-wider">
+								{t('kitForm.editing')}
+							</Text>
+						) : null}
+					</Pressable>
+				)
+			}}
+		</form.Subscribe>
+	)
+}
