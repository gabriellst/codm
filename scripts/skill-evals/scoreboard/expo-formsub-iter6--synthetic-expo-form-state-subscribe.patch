@@ -0,0 +1,20 @@
+import { create } from 'zustand'
+
+interface KitFormStore {
+	// Maps productId → display name for items added in this session.
+	// Populated by the product picker so KitItemRow can show human-readable names.
+	productNames: Record<string, string>
+	setProductName: (id: string, name: string) => void
+	reset: () => void
+}
+
+const initialState = {
+	productNames: {} as Record<string, string>,
+}
+
+export const useKitFormStore = create<KitFormStore>(set => ({
+	...initialState,
+	setProductName: (id, name) =>
+		set(state => ({ productNames: { ...state.productNames, [id]: name } })),
+	reset: () => set(initialState),
+}))
