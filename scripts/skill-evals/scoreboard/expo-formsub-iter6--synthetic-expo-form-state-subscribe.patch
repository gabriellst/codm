+import { FlatList, Pressable, Text, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import { useListProductsForKit } from '@template/client-typescript/typescript'
+import { Sheet } from '@/components/ui/Sheet'
+import { formatMoney } from '@/lib/format'
+import { useKitFormStore } from '../../-stores/kit-form-store'
+import type { KitForm } from '../../-types'
+
+interface ProductPickerOverlayProps {
+	open: boolean
+	onClose: () => void
+	form: KitForm
+}
+
+export function ProductPickerOverlay({ open, onClose, form }: ProductPickerOverlayProps) {
+	const { t } = useTranslation()
+	const { setProductName } = useKitFormStore()
+
+	const { data } = useListProductsForKit({ page: 1, limit: 20 })
+	const products = data?.items ?? []
+
+	const handleSelect = (id: string, name: string, sku: string | null) => {
+		const displayName = name + (sku ? ` · ${sku}` : '')
+		setProductName(id, displayName)
+		form.setFieldValue('draftProductId', id)
+		form.setFieldValue('draftProductName', displayName)
+		onClose()
+	}
+
+	return (
+		<Sheet
+			open={open}
+			onClose={onClose}
+			title={t('kitForm.productPicker.title')}
+			size="tall"
+		>
+			<FlatList
+				data={products}
+				keyExtractor={p => p.id}
+				showsVerticalScrollIndicator={false}
+				renderItem={({ item: product }) => (
+					<Pressable
+						onPress={() => handleSelect(product.id, product.name, product.sku)}
+						accessibilityRole="button"
+						accessibilityLabel={product.name}
+						className="flex-row items-center justify-between px-1 py-3.5 border-b border-white/[0.06]"
+					>
+						<Text className="text-foreground font-sans-semi text-sm flex-1" numberOfLines={1}>
+							{product.name}
+						</Text>
+						<Text className="text-foreground-subtle font-sans text-xs ml-3">
+							{formatMoney(product.currentCost.amountCents / 100, product.currentCost.currency)}
+						</Text>
+					</Pressable>
+				)}
+				ListEmptyComponent={
+					<View className="py-8 items-center">
+						<Text className="text-foreground-subtle font-sans text-sm">
+							{t('common.loading')}
+						</Text>
+					</View>
+				}
+			/>
+		</Sheet>
+	)
+}
