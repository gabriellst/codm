@@ -0,0 +1,45 @@
+import { useTranslation } from 'react-i18next'
+import { IconCheck, IconChevronDown } from '@tabler/icons-react'
+import { ChartTypeEnum, type ChartType } from '@template/client-typescript/typescript'
+
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from '@/components/ui/dropdown-menu'
+
+const RECORTE_OPTIONS = Object.values(ChartTypeEnum) as ChartType[]
+
+interface RecorteSelectorProps {
+	value: ChartType
+	onChange: (value: ChartType) => void
+}
+
+export function RecorteSelector({ value, onChange }: RecorteSelectorProps) {
+	const { t } = useTranslation()
+
+	// All five label keys are literal — type-checked by react-i18next.
+	const labels: Record<ChartType, string> = {
+		[ChartTypeEnum.income]: t('reports.recorte.income'),
+		[ChartTypeEnum.weekday]: t('reports.recorte.weekday'),
+		[ChartTypeEnum.hour]: t('reports.recorte.hour'),
+		[ChartTypeEnum.period]: t('reports.recorte.period'),
+		[ChartTypeEnum.region]: t('reports.recorte.region'),
+	}
+
+	return (
+		<DropdownMenu>
+			<DropdownMenuTrigger
+				className="inline-flex items-center gap-1.5 rounded-md border border-input bg-background px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:bg-accent/50"
+				aria-label={t('reports.recorteSelectorLabel')}
+			>
+				{labels[value]}
+				<IconChevronDown size={14} />
+			</DropdownMenuTrigger>
+			<DropdownMenuContent side="bottom" align="start">
+				{RECORTE_OPTIONS.map(chartType => (
+					<DropdownMenuItem key={chartType} onClick={() => onChange(chartType)}>
+						<span className="flex-1">{labels[chartType]}</span>
+						{value === chartType ? <IconCheck size={14} className="text-primary" /> : null}
+					</DropdownMenuItem>
+				))}
+			</DropdownMenuContent>
+		</DropdownMenu>
+	)
+}
