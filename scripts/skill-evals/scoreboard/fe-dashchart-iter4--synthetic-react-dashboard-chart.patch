@@ -0,0 +1,85 @@
+import type { ComponentProps, ComponentType } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import type { DateRange } from 'react-day-picker'
+import { ChartTypeEnum, type ChartType } from '@template/client-typescript/typescript'
+
+import { Card } from '@/components/ui/card'
+import { DatePicker } from '@/components/ui/date-picker'
+import { cn } from '@/lib/utils'
+
+import { RecorteSelector } from './RecorteSelector'
+import { IncomeTable } from './IncomeTable'
+import { WeekdayTable } from './WeekdayTable'
+import { HourTable } from './HourTable'
+import { PeriodTable } from './PeriodTable'
+import { RegionTable } from './RegionTable'
+
+// ─── Route API ────────────────────────────────────────────────────────────────
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+// ─── Variant dispatch map ─────────────────────────────────────────────────────
+// Dispatch by URL chartType — each variant component owns its own query.
+// Keyed by ChartType so exhaustiveness is enforced by tsc.
+
+const CHART_COMPONENT: Record<ChartType, ComponentType> = {
+	[ChartTypeEnum.income]: IncomeTable,
+	[ChartTypeEnum.weekday]: WeekdayTable,
+	[ChartTypeEnum.hour]: HourTable,
+	[ChartTypeEnum.period]: PeriodTable,
+	[ChartTypeEnum.region]: RegionTable,
+}
+
+// ─── Component ────────────────────────────────────────────────────────────────
+
+export function ChartSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { chartType, startDate, endDate } = routeApi.useSearch()
+	const navigate = routeApi.useNavigate()
+
+	const dateRange: DateRange = {
+		from: startDate ? new Date(startDate) : undefined,
+		to: endDate ? new Date(endDate) : undefined,
+	}
+
+	function handleRecorteChange(next: ChartType) {
+		navigate({ search: prev => ({ ...prev, chartType: next }) })
+	}
+
+	function handleRangeChange(range: DateRange | undefined) {
+		const from = range?.from
+		const to = range?.to
+		if (!from || !to) return
+		navigate({
+			search: prev => ({
+				...prev,
+				startDate: from.toISOString().substring(0, 10),
+				endDate: to.toISOString().substring(0, 10),
+			}),
+		})
+	}
+
+	const VariantComponent = CHART_COMPONENT[chartType]
+
+	return (
+		<div className={cn('flex flex-col gap-6', className)} {...props}>
+			{/* Header — always visible */}
+			<div className="flex flex-col gap-1">
+				<h1 className="text-2xl font-bold text-foreground">{t('reports.title')}</h1>
+				<p className="text-sm text-muted-foreground">{t('reports.subtitle')}</p>
+			</div>
+
+			{/* Toolbar — always visible */}
+			<div className="flex flex-wrap items-center gap-3">
+				<RecorteSelector value={chartType} onChange={handleRecorteChange} />
+				<DatePicker mode="range" range={dateRange} onRangeChange={handleRangeChange} showPresets />
+			</div>
+
+			{/* Body — variant owns data and loading/empty states */}
+			<Card className="flex min-h-80 flex-col gap-4 p-6">
+				<VariantComponent />
+			</Card>
+		</div>
+	)
+}
