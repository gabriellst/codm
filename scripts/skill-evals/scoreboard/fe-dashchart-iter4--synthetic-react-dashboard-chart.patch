@@ -0,0 +1,40 @@
+import { createFileRoute } from '@tanstack/react-router'
+import { zodValidator } from '@/lib/zod-validator'
+import { z } from 'zod'
+import { chartTypeSchema, ChartTypeEnum } from '@template/client-typescript/typescript'
+import { RouteError } from '@/components/RouteError'
+
+import { ChartSection } from './-components/ChartSection'
+
+// ─── Search schema ─────────────────────────────────────────────────────────────
+// tenancyScope comes from the global store (not URL) — not a bookmarkable filter.
+// frequency is fixed at DAILY for v1.
+
+const reportsSearchSchema = z.object({
+	chartType: chartTypeSchema.optional().default(ChartTypeEnum.income),
+	startDate: z.string().optional().default(() => {
+		const d = new Date()
+		d.setDate(d.getDate() - 30)
+		return d.toISOString().substring(0, 10)
+	}),
+	endDate: z.string().optional().default(() => new Date().toISOString().substring(0, 10)),
+})
+
+export type ReportsSearch = z.infer<typeof reportsSearchSchema>
+
+// ─── Route ────────────────────────────────────────────────────────────────────
+
+export const Route = createFileRoute('/(app)/reports/')({
+	staticData: { breadcrumb: 'Relatórios' },
+	validateSearch: zodValidator(reportsSearchSchema),
+	errorComponent: RouteError,
+	component: RouteComponent,
+})
+
+function RouteComponent() {
+	return (
+		<div className="flex flex-1 flex-col gap-6 overflow-y-auto p-6 md:p-8">
+			<ChartSection />
+		</div>
+	)
+}
