@@ -0,0 +1,102 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useGetChart, ChartTypeEnum } from '@template/client-typescript/typescript'
+
+import { useMoney } from '@/hooks'
+import { useTenancyStore } from '@/stores'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Empty, EmptyHeader, EmptyTitle, EmptyDescription } from '@/components/ui/empty'
+import { cn } from '@/lib/utils'
+
+import { SegmentRow } from './SegmentRow'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+const WEEKDAY_ORDER = ['MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY', 'SUNDAY'] as const
+
+type WeekdayKey = (typeof WEEKDAY_ORDER)[number]
+
+export function WeekdayTable({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { startDate, endDate } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+	const formatMoney = useMoney()
+
+	const { data, isPending, isError } = useGetChart({
+		chartType: ChartTypeEnum.weekday,
+		tenancyScope,
+		frequency: 'DAILY',
+		startDate,
+		endDate,
+	})
+
+	if (isPending) {
+		return (
+			<div className={cn('flex flex-col gap-2', className)} {...props}>
+				{Array.from({ length: 7 }).map((_, i) => (
+					// biome-ignore lint/suspicious/noArrayIndexKey: static skeleton
+					<Skeleton key={i} className="h-9 w-full rounded" />
+				))}
+			</div>
+		)
+	}
+
+	if (isError || !data || data.kind !== 'weekday') {
+		return (
+			<div className={cn('flex flex-1 items-center justify-center', className)} {...props}>
+				<Empty>
+					<EmptyHeader>
+						<EmptyTitle>{t('reports.error.title')}</EmptyTitle>
+						<EmptyDescription>{t('reports.error.description')}</EmptyDescription>
+					</EmptyHeader>
+				</Empty>
+			</div>
+		)
+	}
+
+	const weekdayLabels: Record<WeekdayKey, string> = {
+		MONDAY: t('reports.weekday.MONDAY'),
+		TUESDAY: t('reports.weekday.TUESDAY'),
+		WEDNESDAY: t('reports.weekday.WEDNESDAY'),
+		THURSDAY: t('reports.weekday.THURSDAY'),
+		FRIDAY: t('reports.weekday.FRIDAY'),
+		SATURDAY: t('reports.weekday.SATURDAY'),
+		SUNDAY: t('reports.weekday.SUNDAY'),
+	}
+
+	const maxRevenue = Math.max(
+		0,
+		...WEEKDAY_ORDER.map(k => Math.max(0, data.segments[k].revenue.amountCents)),
+	)
+
+	return (
+		<div className={cn('flex flex-col', className)} {...props}>
+			<div className="flex items-center gap-4 border-b border-border px-2 pb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">
+				<span className="min-w-28 shrink-0">{t('reports.columns.label')}</span>
+				<div className="flex-1" />
+				<span className="w-28 text-right">{t('reports.columns.revenue')}</span>
+				<span className="w-24 text-right">{t('reports.columns.profit')}</span>
+				<span className="w-14 text-right">{t('reports.columns.orders')}</span>
+			</div>
+			<div role="list" aria-label={t('reports.title')}>
+				{WEEKDAY_ORDER.map(key => {
+					const seg = data.segments[key]
+					const barPercent =
+						maxRevenue > 0 ? (Math.max(0, seg.revenue.amountCents) / maxRevenue) * 100 : 0
+					return (
+						<SegmentRow
+							key={key}
+							label={weekdayLabels[key]}
+							revenueStr={formatMoney(seg.revenue)}
+							profitStr={formatMoney(seg.profit)}
+							isPositiveProfit={seg.profit.amountCents >= 0}
+							orders={seg.orders}
+							barPercent={barPercent}
+						/>
+					)
+				})}
+			</div>
+		</div>
+	)
+}
