+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useGetChart, ChartTypeEnum } from '@template/client-typescript/typescript'
+
+import { useMoney } from '@/hooks'
+import { useTenancyStore } from '@/stores'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Empty, EmptyHeader, EmptyTitle, EmptyDescription } from '@/components/ui/empty'
+import { cn } from '@/lib/utils'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+interface RegionRowProps {
+	state: string
+	country: string
+	totalStr: string
+	isPositive: boolean
+	orders: number
+}
+
+function RegionRow({ state, country, totalStr, isPositive, orders }: RegionRowProps) {
+	return (
+		<div
+			role="listitem"
+			className="flex items-center gap-4 border-b border-border px-2 py-2.5 last:border-0"
+		>
+			<span className="min-w-28 shrink-0 text-sm font-medium text-foreground">{state}</span>
+			<span className="flex-1 text-sm text-muted-foreground">{country}</span>
+			<span
+				className={cn(
+					'w-28 text-right text-sm tabular-nums',
+					isPositive ? 'text-success-bright' : 'text-destructive',
+				)}
+			>
+				{totalStr}
+			</span>
+			<span className="w-14 text-right text-sm tabular-nums text-muted-foreground">{orders}</span>
+		</div>
+	)
+}
+
+export function RegionTable({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { startDate, endDate } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+	const formatMoney = useMoney()
+
+	const { data, isPending, isError } = useGetChart({
+		chartType: ChartTypeEnum.region,
+		tenancyScope,
+		frequency: 'DAILY',
+		startDate,
+		endDate,
+	})
+
+	if (isPending) {
+		return (
+			<div className={cn('flex flex-col gap-2', className)} {...props}>
+				{Array.from({ length: 6 }).map((_, i) => (
+					// biome-ignore lint/suspicious/noArrayIndexKey: static skeleton
+					<Skeleton key={i} className="h-9 w-full rounded" />
+				))}
+			</div>
+		)
+	}
+
+	if (isError || !data || data.kind !== 'region') {
+		return (
+			<div className={cn('flex flex-1 items-center justify-center', className)} {...props}>
+				<Empty>
+					<EmptyHeader>
+						<EmptyTitle>{t('reports.error.title')}</EmptyTitle>
+						<EmptyDescription>{t('reports.error.description')}</EmptyDescription>
+					</EmptyHeader>
+				</Empty>
+			</div>
+		)
+	}
+
+	const entries = Object.entries(data.regions).sort(
+		([, a], [, b]) => b.total.amountCents - a.total.amountCents,
+	)
+
+	if (entries.length === 0) {
+		return (
+			<div className={cn('flex flex-1 items-center justify-center', className)} {...props}>
+				<Empty>
+					<EmptyHeader>
+						<EmptyTitle>{t('reports.empty.title')}</EmptyTitle>
+						<EmptyDescription>{t('reports.empty.description')}</EmptyDescription>
+					</EmptyHeader>
+				</Empty>
+			</div>
+		)
+	}
+
+	return (
+		<div className={cn('flex flex-col', className)} {...props}>
+			<div className="flex items-center gap-4 border-b border-border px-2 pb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">
+				<span className="min-w-28 shrink-0">{t('reports.columns.state')}</span>
+				<span className="flex-1">{t('reports.columns.country')}</span>
+				<span className="w-28 text-right">{t('reports.columns.total')}</span>
+				<span className="w-14 text-right">{t('reports.columns.orders')}</span>
+			</div>
+			<div role="list" aria-label={t('reports.title')}>
+				{entries.map(([key, region]) => (
+					<RegionRow
+						key={key}
+						state={region.state || key}
+						country={region.country}
+						totalStr={formatMoney(region.total)}
+						isPositive={region.total.amountCents >= 0}
+						orders={region.orders}
+					/>
+				))}
+			</div>
+		</div>
+	)
+}
