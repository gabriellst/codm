@@ -0,0 +1,66 @@
+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import type { ApplicationErrors } from '../errors'
+import { Space } from '../entities/Space'
+import { WorkspaceRepository } from '../repositories/WorkspaceRepository/WorkspaceRepository'
+import { SpaceRepository } from '../repositories/SpaceRepository/SpaceRepository'
+import { SpaceCreatedEvent } from '../events/SpaceCreatedEvent'
+
+export const CreateSpaceInputSchema = z.object({
+	workspaceId: z.uuid(),
+	name: z.string().min(1),
+})
+
+export const CreateSpaceOutputSchema = z.object({
+	spaceId: z.uuid(),
+})
+
+@injectable()
+export class CreateSpace extends Handler<typeof CreateSpaceInputSchema, typeof CreateSpaceOutputSchema> {
+	readonly name = 'create_space' as const
+	readonly inputSchema = CreateSpaceInputSchema
+	readonly outputSchema = CreateSpaceOutputSchema
+
+	constructor(
+		private readonly workspaceRepo: WorkspaceRepository,
+		private readonly spaceRepo: SpaceRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const workspace = await this.workspaceRepo.findById(input.workspaceId, tx)
+			if (!workspace) {
+				throw new BaseError<ApplicationErrors>('WORKSPACE_NOT_FOUND')
+			}
+
+			const existingSpaces = await this.spaceRepo.findByWorkspaceId(input.workspaceId, tx)
+			const order = existingSpaces.length
+
+			const space = Space.create({
+				workspaceId: input.workspaceId,
+				name: input.name,
+				order,
+			})
+
+			await this.spaceRepo.save(space, tx)
+
+			await this.domainEventRepository.save(
+				new SpaceCreatedEvent({
+					entityId: space.id.value,
+					ownerId: input.workspaceId,
+					payload: {
+						workspaceId: input.workspaceId,
+						spaceId: space.id.value,
+						name: space.name,
+					},
+				}),
+				tx,
+			)
+
+			return { spaceId: space.id.value }
+		})
+	}
+}
