diff --git a/packages/api/typescript/src/ui/usecases/GetBoardView.ts b/packages/api/typescript/src/ui/usecases/GetBoardView.ts
new file mode 100644
index 000000000..1d85434aa
--- /dev/null
+++ b/packages/api/typescript/src/ui/usecases/GetBoardView.ts
@@ -0,0 +1,92 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, Handler, z } from '@template/core-typescript'
+import { taskBoardView } from '@template/contracts/db'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+
+// ---------------------------------------------------------------------------
+// Input
+// ---------------------------------------------------------------------------
+export const GetBoardViewInputSchema = z.object({
+	spaceId: z.uuid(),
+})
+
+// ---------------------------------------------------------------------------
+// Output — one column per TaskStatus in fixed order; empty columns always emitted.
+// ---------------------------------------------------------------------------
+const BoardTaskItemSchema = z.object({
+	taskId: z.string(),
+	title: z.string(),
+	status: z.enum(TaskStatus),
+	priority: z.enum(TaskPriority),
+	assigneeIds: z.array(z.string()),
+	listId: z.string(),
+})
+
+const BoardColumnSchema = z.object({
+	status: z.enum(TaskStatus),
+	tasks: z.array(BoardTaskItemSchema),
+})
+
+export const GetBoardViewOutputSchema = z.object({
+	spaceId: z.string(),
+	columns: z.array(BoardColumnSchema),
+})
+
+/** Fixed column order — the board always renders all four status columns. */
+const COLUMN_ORDER: TaskStatus[] = [TaskStatus.TODO, TaskStatus.IN_PROGRESS, TaskStatus.IN_REVIEW, TaskStatus.DONE]
+
+/**
+ * `GetBoardView` — BFF query that powers the Kanban Board view for a Space.
+ *
+ * Reads all `task_board_view` rows for the space, groups by status, and emits
+ * EXACTLY one column per TaskStatus value in fixed order [TODO, IN_PROGRESS,
+ * IN_REVIEW, DONE] — including empty columns so the board always renders all four.
+ */
+@injectable()
+export class GetBoardView extends Handler<typeof GetBoardViewInputSchema, typeof GetBoardViewOutputSchema> {
+	readonly name = 'get_board_view' as const
+	readonly inputSchema = GetBoardViewInputSchema
+	readonly outputSchema = GetBoardViewOutputSchema
+
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const rows = await this.db
+			.select({
+				taskId: taskBoardView.taskId,
+				listId: taskBoardView.listId,
+				title: taskBoardView.title,
+				status: taskBoardView.status,
+				priority: taskBoardView.priority,
+				assigneeIds: taskBoardView.assigneeIds,
+			})
+			.from(taskBoardView)
+			.where(eq(taskBoardView.spaceId, input.spaceId))
+
+		// Group task rows by status.
+		const tasksByStatus = new Map<string, typeof rows>()
+		for (const row of rows) {
+			const bucket = tasksByStatus.get(row.status) ?? []
+			bucket.push(row)
+			tasksByStatus.set(row.status, bucket)
+		}
+
+		// Emit one column per status in fixed order, empty columns included.
+		const columns = COLUMN_ORDER.map(status => ({
+			status,
+			tasks: (tasksByStatus.get(status) ?? []).map(row => ({
+				taskId: row.taskId,
+				title: row.title,
+				status: row.status as TaskStatus,
+				priority: row.priority as TaskPriority,
+				assigneeIds: row.assigneeIds as string[],
+				listId: row.listId,
+			})),
+		}))
+
+		return { spaceId: input.spaceId, columns }
+	}
+}
