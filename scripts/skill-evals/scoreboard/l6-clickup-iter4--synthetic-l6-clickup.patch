@@ -0,0 +1,177 @@
+import React from 'react'
+import { useTranslation } from 'react-i18next'
+import { toast } from 'sonner'
+import { useQueryClient } from '@tanstack/react-query'
+import { useForm } from '@tanstack/react-form'
+import {
+	useCreateTask,
+	createTaskMutationRequestSchema,
+	getListViewQueryKey,
+	getBoardViewQueryKey,
+	useGetListView,
+	TaskPriorityEnum,
+	type CreateTaskMutationRequest,
+} from '@template/client-typescript/typescript'
+
+import type { DeepPartial } from '@/lib'
+import { cn } from '@/lib/utils'
+import { Button } from '@/components/ui/button'
+import { Field, FieldError, FieldGroup, FieldLabel } from '@/components/ui/field'
+import { Input } from '@/components/ui/input'
+import { Spinner } from '@/components/ui/spinner'
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select'
+import { useDialogStore } from '@/stores/useDialogStore'
+
+type CreateTaskDialogProps = React.ComponentProps<'div'> & {
+	workspaceId: string
+	spaceId: string
+}
+
+/**
+ * CreateTaskDialog — self-contained dialog for creating a task.
+ * Opened via useDialogStore().show(<CreateTaskDialog workspaceId={...} spaceId={...} />).
+ */
+export function CreateTaskDialog({ workspaceId, spaceId, className, ...props }: CreateTaskDialogProps) {
+	const { t } = useTranslation()
+	const hide = useDialogStore(s => s.hide)
+	const queryClient = useQueryClient()
+
+	const { data: listViewData } = useGetListView({ spaceId })
+
+	// H1: declare onSuccess on the hook
+	const createTask = useCreateTask({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('spaceDetail.createDialog.success'))
+				queryClient.invalidateQueries({ queryKey: getListViewQueryKey({ spaceId }) })
+				queryClient.invalidateQueries({ queryKey: getBoardViewQueryKey({ spaceId }) })
+				hide()
+			},
+		},
+	})
+
+	const defaultValues: DeepPartial<CreateTaskMutationRequest> = {
+		workspaceId,
+		spaceId,
+		priority: TaskPriorityEnum.NORMAL,
+		assigneeIds: [],
+	}
+
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: createTaskMutationRequestSchema },
+		onSubmit: async ({ value }) => {
+			const result = createTaskMutationRequestSchema.safeParse(value)
+			if (!result.success) return
+			await createTask.mutateAsync({ data: result.data })
+		},
+	})
+
+	return (
+		<div className={cn('flex flex-col gap-6 p-6', className)} {...props}>
+			<div className="flex flex-col gap-1">
+				<h2 className="text-lg font-semibold text-foreground">{t('spaceDetail.createDialog.title')}</h2>
+			</div>
+
+			<form
+				noValidate
+				onSubmit={e => {
+					e.preventDefault()
+					e.stopPropagation()
+					form.handleSubmit()
+				}}
+			>
+				<FieldGroup>
+					<form.Field name="title">
+						{field => {
+							const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+							return (
+								<Field>
+									<FieldLabel htmlFor={field.name}>{t('spaceDetail.createDialog.titleField')}</FieldLabel>
+									<Input
+										id={field.name}
+										placeholder={t('spaceDetail.createDialog.titlePlaceholder')}
+										value={field.state.value ?? ''}
+										onBlur={field.handleBlur}
+										onChange={e => field.handleChange(e.target.value)}
+										aria-invalid={isInvalid}
+									/>
+									{isInvalid && field.state.meta.errors[0] && (
+										<FieldError>{String(field.state.meta.errors[0])}</FieldError>
+									)}
+								</Field>
+							)
+						}}
+					</form.Field>
+
+					<form.Field name="listId">
+						{field => {
+							const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+							const lists = listViewData?.lists ?? []
+							return (
+								<Field>
+									<FieldLabel htmlFor={field.name}>{t('spaceDetail.createDialog.listField')}</FieldLabel>
+									<Select
+										value={field.state.value ?? null}
+										onValueChange={(v: string | null) => {
+											if (v !== null) field.handleChange(v)
+										}}
+									>
+										<SelectTrigger id={field.name} aria-invalid={isInvalid}>
+											<SelectValue>
+												{field.state.value
+													? lists.find(l => l.id === field.state.value)?.name ?? field.state.value
+													: undefined}
+											</SelectValue>
+										</SelectTrigger>
+										<SelectContent>
+											{lists.map(list => (
+												<SelectItem key={list.id} value={list.id}>
+													{list.name}
+												</SelectItem>
+											))}
+										</SelectContent>
+									</Select>
+									{isInvalid && field.state.meta.errors[0] && (
+										<FieldError>{String(field.state.meta.errors[0])}</FieldError>
+									)}
+								</Field>
+							)
+						}}
+					</form.Field>
+
+					<form.Field name="priority">
+						{field => (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('spaceDetail.createDialog.priorityField')}</FieldLabel>
+								<Select
+									enum={TaskPriorityEnum}
+									i18nPrefix="enums.TaskPriority"
+									value={field.state.value}
+									onValueChange={field.handleChange}
+									id={field.name}
+								/>
+							</Field>
+						)}
+					</form.Field>
+
+					<form.Subscribe selector={s => [s.values, s.isSubmitting] as const}>
+						{([values, isSubmitting]) => (
+							<div className="flex justify-end gap-2 pt-2">
+								<Button type="button" variant="outline" onClick={hide}>
+									{t('spaceDetail.createDialog.cancel')}
+								</Button>
+								<Button
+									type="submit"
+									disabled={!createTaskMutationRequestSchema.safeParse(values).success || isSubmitting}
+								>
+									{isSubmitting ? <Spinner /> : t('spaceDetail.createDialog.submit')}
+								</Button>
+							</div>
+						)}
+					</form.Subscribe>
+				</FieldGroup>
+			</form>
+		</div>
+	)
+}
