+
+export const Route = createFileRoute('/(app)/workspaces/$workspaceId/spaces/$spaceId/')({
+	staticData: { breadcrumb: 'Space' },
+	validateSearch: (search) =>
+		z.object({ viewMode: z.enum(['list', 'board']).default('list') }).parse(search ?? {}),
+	component: RouteComponent,
+})
+
+const routeApi = getRouteApi('/(app)/workspaces/$workspaceId/spaces/$spaceId/')
+
+function RouteComponent() {
+	const { t } = useTranslation()
+	const { workspaceId, spaceId } = routeApi.useParams()
+	const { viewMode } = routeApi.useSearch()
+	const queryClient = useQueryClient()
+	const { show } = useDialogStore()
+
+	// THE SINGLE realtime subscription for task status changes in this app.
+	// The SSE stream is store-scoped server-side; we guard by workspaceId for sub-store scoping.
+	useServerEvents('integration.shared.task.status_changed', event => {
+		if (event.payload.workspaceId !== workspaceId) return
+		queryClient.invalidateQueries({ queryKey: getListViewQueryKey({ spaceId }) })
+		queryClient.invalidateQueries({ queryKey: getBoardViewQueryKey({ spaceId }) })
+	})
+
+	return (
+		<div className="flex flex-1 flex-col gap-6 overflow-y-auto p-6 md:p-8">
+			<header className="flex items-center justify-between">
+				<h1 className="text-2xl font-bold text-foreground">{t('spaceDetail.title')}</h1>
+				<div className="flex items-center gap-3">
+					<ViewToggle />
+					<Button
+						onClick={() =>
+							show(<CreateTaskDialog workspaceId={workspaceId} spaceId={spaceId} />)
+						}
+					>
+						{t('spaceDetail.newTask')}
+					</Button>
+				</div>
+			</header>
+
+			{viewMode === 'list' ? <ListViewSection /> : <BoardViewSection />}
+		</div>
+	)
+}
