new file mode 100644
index 000000000..045d217b3
--- /dev/null
+++ b/packages/api/typescript/src/workspace/repositories/SpaceRepository/DrizzleSpaceRepository.ts
@@ -0,0 +1,95 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { spaces } from '@template/contracts/db'
+import { Space } from '../../entities/Space'
+import { List, ListSchema } from '../../objects/List'
+import { SpaceRepository } from './SpaceRepository'
+
+@injectable()
+export class DrizzleSpaceRepository extends SpaceRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<Space | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(spaces).where(eq(spaces.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async findByWorkspaceId(workspaceId: string, tx?: DrizzleClient): Promise<Space[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			return dbc.select().from(spaces).where(eq(spaces.workspaceId, workspaceId))
+		})
+		if (!result.success || !result.data) return []
+		return result.data.map(row => this.toDomain(row))
+	}
+
+	async save(entity: Space, tx?: DrizzleClient): Promise<Space> {
+		entity.incrementVersion()
+		const dbc = tx ?? this.db
+		const data = this.toPersistence(entity)
+		const result = await tryCatchAsync(async () => {
+			await dbc
+				.insert(spaces)
+				.values(data)
+				.onConflictDoUpdate({
+					target: spaces.id,
+					set: {
+						name: data.name,
+						order: data.order,
+						lists: data.lists,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc.delete(spaces).where(eq(spaces.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: typeof spaces.$inferSelect): Space {
+		const rawLists = Array.isArray(row.lists) ? row.lists : []
+		const lists = rawLists.map((item: unknown) => {
+			const parsed = ListSchema.parse(item)
+			return new List(parsed)
+		})
+		return new Space({
+			id: row.id,
+			workspaceId: row.workspaceId,
+			name: row.name,
