@@ -0,0 +1,20 @@
+import "./_base.tsp";
+
+namespace TemplateContracts;
+
+@doc("Published by the TS `task` bounded context after a Task transitions status. Consumed by the `ui` ListenEvents SSE controller to push live board updates to the browser, keyed by workspaceId.")
+model TaskStatusChangedEvent extends IntegrationEvent {
+  name: "integration.shared.task.status_changed";
+
+  @doc("Workspace the task belongs to. REQUIRED — this is the SSE realtime tenancy filter key.")
+  workspaceId: string;
+
+  @doc("The Task aggregate id.")
+  taskId: string;
+
+  @doc("Status before the transition.")
+  fromStatus: TaskStatus;
+
+  @doc("Status after the transition.")
+  toStatus: TaskStatus;
+}
