@@ -0,0 +1,61 @@
+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import type { TaskDomainErrors } from '../errors'
+
+export const TaskSchema = z.object({
+	workspaceId: z.instance(Id),
+	spaceId: z.instance(Id),
+	listId: z.instance(Id),
+	title: z.string().min(1),
+	status: z.enum(TaskStatus),
+	priority: z.enum(TaskPriority),
+	assigneeIds: z.array(z.uuid()).default([]),
+})
+
+export type TaskProps = Z.infer<typeof TaskSchema>
+
+export class Task extends AggregateRoot<typeof TaskSchema> {
+	static override schema = TaskSchema
+
+	static create(data: {
+		workspaceId: string
+		spaceId: string
+		listId: string
+		title: string
+		priority?: TaskPriority
+		assigneeIds?: string[]
+	}): Task {
+		if (!data.title || data.title.trim().length === 0) {
+			throw new BaseError<TaskDomainErrors>('INVALID_TASK_TITLE')
+		}
+		return new Task({
+			workspaceId: data.workspaceId,
+			spaceId: data.spaceId,
+			listId: data.listId,
+			title: data.title,
+			status: TaskStatus.TODO,
+			priority: data.priority ?? TaskPriority.NORMAL,
+			assigneeIds: data.assigneeIds ?? [],
+		})
+	}
+
+	/**
+	 * Transitions task status.
+	 * Returns the previous status (fromStatus) so the use case can build the event.
+	 */
+	changeStatus(toStatus: TaskStatus): TaskStatus {
+		const fromStatus = this.status
+		this.status = toStatus
+		return fromStatus
+	}
+
+	/**
+	 * Replaces the full set of assignees.
+	 */
+	assign(assigneeIds: string[]): void {
+		this.assigneeIds = assigneeIds
+	}
+}
+
+export interface Task extends TaskProps {}
