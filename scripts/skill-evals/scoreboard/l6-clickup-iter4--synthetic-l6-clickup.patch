+
+export type TaskDomainErrors = 'INVALID_TASK_TITLE'
+export type DomainErrors = BaseDomainErrors | TaskDomainErrors
+
+export type TaskApplicationErrors = 'TASK_NOT_FOUND' | 'TASK_LIST_NOT_IN_SPACE' | 'SPACE_NOT_FOUND'
+export type ApplicationErrors = BaseApplicationErrors | TaskApplicationErrors
+
+export type InterfaceErrors = BaseInterfaceErrors
+export type InfrastructureErrors = BaseInfrastructureErrors
+export type Errors = ApplicationErrors | DomainErrors | InfrastructureErrors | InterfaceErrors
