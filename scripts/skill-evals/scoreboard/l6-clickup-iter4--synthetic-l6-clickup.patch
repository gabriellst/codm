+++ b/packages/contracts/db/schema/tasks.ts
@@ -0,0 +1,179 @@
+import { pgSchema, uuid, text, timestamp, integer, boolean, jsonb, index } from 'drizzle-orm/pg-core'
+
+/**
+ * `tasks` is BK Dash's minimal ClickUp app schema.
+ *
+ * Domain: workspaces → spaces (with embedded list VOs) → tasks.
+ * Read projections: task_list_view (List view) and task_board_view (Board view, grouped by status).
+ *
+ * Tables:
+ *   - `workspaces`       — top-level workspace scoped to a tenancy store
+ *   - `spaces`           — workspace columns/swimlanes; lists stored as jsonb VO collection
+ *   - `tasks`            — task aggregate (write-model)
+ *   - `task_list_view`   — read-side projection optimized for the List view
+ *   - `task_board_view`  — read-side projection optimized for the Board view (grouped by status)
+ */
+export const tasksSchema = pgSchema('tasks')
+
+export const workspaces = tasksSchema.table(
+	'workspaces',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		// Human-readable workspace name.
+		name: text('name').notNull(),
+
+		// References the tenancy store that owns this workspace.
+		// No cross-schema FK constraint — enforced at application level.
+		storeId: uuid('store_id').notNull(),
+
+		// Soft-disable: archived workspaces are hidden from the board UI.
+		isArchived: boolean('is_archived').notNull().default(false),
+
+		// Audit / optimistic concurrency.
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		storeIdx: index('workspaces_store_id_idx').on(t.storeId),
+	}),
+)
+
+export const spaces = tasksSchema.table(
+	'spaces',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		workspaceId: uuid('workspace_id')
+			.notNull()
+			.references(() => workspaces.id, { onDelete: 'cascade' }),
+
+		// Display name for the space.
+		name: text('name').notNull(),
+
+		// Ordering position among sibling spaces in the workspace.
+		order: integer('order').notNull().default(0),
+
+		// Ordered List value object collection [{id, name, order}].
+		// Lists are owned by the Space aggregate — no separate lists table.
+		lists: jsonb('lists').notNull().default('[]'),
+
+		// Audit / optimistic concurrency.
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		workspaceIdx: index('spaces_workspace_id_idx').on(t.workspaceId),
+	}),
+)
+
+export const tasks = tasksSchema.table(
+	'tasks',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		workspaceId: uuid('workspace_id').notNull(),
+
+		spaceId: uuid('space_id')
+			.notNull()
+			.references(() => spaces.id, { onDelete: 'cascade' }),
+
+		// The id of the List VO inside the owning space.
+		listId: uuid('list_id').notNull(),
+
+		// Task content.
+		title: text('title').notNull(),
+		description: text('description'),
+
+		// Stored as text — enum enforcement is application-level (TaskStatus).
+		status: text('status').notNull(),
+
+		// Stored as text — enum enforcement is application-level (TaskPriority).
+		priority: text('priority').notNull().default('NORMAL'),
+
+		// Array of user id strings (UUID strings in jsonb).
+		assigneeIds: jsonb('assignee_ids').notNull().default('[]'),
+
+		// Audit / optimistic concurrency.
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		spaceIdx: index('tasks_space_id_idx').on(t.spaceId),
+		listIdx: index('tasks_list_id_idx').on(t.listId),
+		statusIdx: index('tasks_status_idx').on(t.status),
+		workspaceIdx: index('tasks_workspace_id_idx').on(t.workspaceId),
+	}),
+)
+
+/**
+ * `task_list_view` — read-side projection for the List view.
+ * One row per task, optimized for rendering a flat ordered list inside a space/list.
+ * Written by TaskListViewProjector; never by use cases.
+ */
+export const taskListView = tasksSchema.table(
+	'task_list_view',
+	{
+		taskId: uuid('task_id').primaryKey(),
+
+		workspaceId: uuid('workspace_id').notNull(),
+		spaceId: uuid('space_id').notNull(),
+		listId: uuid('list_id').notNull(),
+
+		title: text('title').notNull(),
+
+		// Stored as text — mirrors TaskStatus enum.
+		status: text('status').notNull(),
+
+		// Stored as text — mirrors TaskPriority enum.
+		priority: text('priority').notNull(),
+
+		// Array of user id strings.
+		assigneeIds: jsonb('assignee_ids').notNull().default('[]'),
+
+		// Display order within the list.
+		order: integer('order').notNull().default(0),
+
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull(),
+	},
+	t => ({
+		spaceIdx: index('task_list_view_space_id_idx').on(t.spaceId),
+		listIdx: index('task_list_view_list_id_idx').on(t.listId),
+	}),
+)
+
+/**
+ * `task_board_view` — read-side projection for the Board view.
+ * One row per task, optimized for rendering grouped-by-status Kanban columns.
+ * Written by TaskBoardViewProjector; never by use cases.
+ */
+export const taskBoardView = tasksSchema.table(
+	'task_board_view',
+	{
+		taskId: uuid('task_id').primaryKey(),
+
+		workspaceId: uuid('workspace_id').notNull(),
+		spaceId: uuid('space_id').notNull(),
+		listId: uuid('list_id').notNull(),
+
+		title: text('title').notNull(),
+
+		// Stored as text — mirrors TaskStatus enum; the primary grouping key.
+		status: text('status').notNull(),
+
+		// Stored as text — mirrors TaskPriority enum.
+		priority: text('priority').notNull(),
+
+		// Array of user id strings.
+		assigneeIds: jsonb('assignee_ids').notNull().default('[]'),
+
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull(),
+	},
+	t => ({
+		spaceIdx: index('task_board_view_space_id_idx').on(t.spaceId),
+		statusIdx: index('task_board_view_status_idx').on(t.status),
+	}),
+)
