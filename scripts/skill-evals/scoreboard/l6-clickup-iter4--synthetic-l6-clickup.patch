+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { taskBoardView } from '@template/contracts/db'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { BoardViewProjection } from '../BoardViewProjection'
+import { TaskBoardViewProjectionRepository } from './TaskBoardViewProjectionRepository'
+
+@injectable()
+export class DrizzleTaskBoardViewProjectionRepository extends TaskBoardViewProjectionRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findByTaskId(taskId: string, tx?: DrizzleClient): Promise<BoardViewProjection | null> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient
+				.select()
+				.from(taskBoardView)
+				.where(eq(taskBoardView.taskId, taskId))
+				.limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return null
+		return this.toDomain(result.data)
+	}
+
+	async save(projection: BoardViewProjection, tx?: DrizzleClient): Promise<void> {
+		const dbClient = tx ?? this.db
+		const data = this.toPersistence(projection)
+		const result = await tryCatchAsync(async () => {
+			await dbClient
+				.insert(taskBoardView)
+				.values(data)
+				.onConflictDoUpdate({
+					target: [taskBoardView.taskId],
+					set: {
+						status: data.status,
+						priority: data.priority,
+						assigneeIds: data.assigneeIds,
+						updatedAt: data.updatedAt,
+					},
+				})
+		})
+		if (!result.success) throw result.error
+	}
+
+	async insertIfNew(projection: BoardViewProjection, tx?: DrizzleClient): Promise<boolean> {
+		const dbClient = tx ?? this.db
+		const data = this.toPersistence(projection)
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient
+				.insert(taskBoardView)
+				.values(data)
+				.onConflictDoNothing()
+				.returning({ taskId: taskBoardView.taskId })
+			return rows.length > 0
+		})
+		if (!result.success) throw result.error
+		return result.data ?? false
+	}
+
+	private toDomain(row: typeof taskBoardView.$inferSelect): BoardViewProjection {
+		const assigneeIds = Array.isArray(row.assigneeIds) ? (row.assigneeIds as string[]) : []
+		return new BoardViewProjection({
+			taskId: row.taskId,
+			workspaceId: row.workspaceId,
+			spaceId: row.spaceId,
+			listId: row.listId,
+			title: row.title,
+			status: row.status as TaskStatus,
+			priority: row.priority as TaskPriority,
+			assigneeIds,
+		})
+	}
+
+	private toPersistence(projection: BoardViewProjection): typeof taskBoardView.$inferInsert {
+		return {
+			taskId: projection.props.taskId,
+			workspaceId: projection.props.workspaceId,
+			spaceId: projection.props.spaceId,
+			listId: projection.props.listId,
+			title: projection.props.title,
+			status: projection.props.status,
+			priority: projection.props.priority,
+			assigneeIds: projection.props.assigneeIds,
+			updatedAt: new Date(),
+		}
+	}
+}
