+import { injectable } from 'tsyringe-neo'
+import type { Transaction } from '@template/core-typescript'
+import { Projector } from '@template/core-typescript'
+import { BoardViewProjection, type BoardViewProjectionEvent } from '../BoardViewProjection'
+import { TaskBoardViewProjectionRepository } from '../TaskBoardViewProjectionRepository/TaskBoardViewProjectionRepository'
+
+@injectable()
+export class BoardViewProjector extends Projector<BoardViewProjectionEvent> {
+	constructor(private repo: TaskBoardViewProjectionRepository) {
+		super()
+	}
+
+	readonly events = [
+		'task.task.created',
+		'task.task.status_changed',
+		'task.task.assigned',
+	] as const
+
+	async handle(event: BoardViewProjectionEvent, tx?: Transaction): Promise<void> {
+		switch (event.name) {
+			case 'task.task.created':
+				await this.repo.insertIfNew(BoardViewProjection.create(event), tx)
+				return
+			case 'task.task.status_changed': {
+				const p = await this.repo.findByTaskId(event.payload.taskId, tx)
+				if (!p) return
+				p.applyEvent(event)
+				await this.repo.save(p, tx)
+				return
+			}
+			case 'task.task.assigned': {
+				const p = await this.repo.findByTaskId(event.payload.taskId, tx)
+				if (!p) return
+				p.applyEvent(event)
+				await this.repo.save(p, tx)
+				return
+			}
+			default: {
+				const _exhaustive: never = event
+				void _exhaustive
+				return
+			}
+		}
+	}
+}
