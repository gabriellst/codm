diff --git a/packages/e2e/tests/clickup-tasks-realtime.spec.ts b/packages/e2e/tests/clickup-tasks-realtime.spec.ts
new file mode 100644
index 000000000..92dd5cafd
--- /dev/null
+++ b/packages/e2e/tests/clickup-tasks-realtime.spec.ts
@@ -0,0 +1,111 @@
+/**
+ * Canonical flow — realtime board update via SSE.
+ *
+ * ## TC-RT-01: Task card moves between columns in real time without page reload
+ *
+ * **As a** workspace member **I want to** see task status changes reflected on the
+ * board immediately **So that** I always have an up-to-date view without manual refreshes.
+ *
+ * ### API Calls Verified
+ * - `POST /v1/workspace/workspaces` — create isolated workspace
+ * - `POST /v1/workspace/spaces`     — create space inside workspace
+ * - `POST /v1/workspace/lists`      — create list inside space
+ * - `POST /v1/task/tasks`           — seed the task (starts in TODO)
+ * - `PATCH /v1/task/tasks/status`   — out-of-band status change driving the SSE path
+ */
+
+import { expect } from '@playwright/test'
+import {
+	addList,
+	changeTaskStatus,
+	createSpace,
+	createTask,
+	createWorkspace,
+	TaskPriorityEnum,
+	TaskStatusEnum,
+} from '@template/client-typescript/typescript'
+import { test } from '../utils/test'
+import { t } from '../utils/i18n'
+
+test('TC-RT-01: task card moves into DONE column via SSE without page reload', async ({ page, given }) => {
+	// ── 1. Create + sign in a fresh user ──────────────────────────────────────
+	const user = await given.freshUser({ name: 'Task Tester' })
+
+	// ── 2. Set up workspace hierarchy via API (request context, not UI) ───────
+	const { workspaceId } = await createWorkspace(
+		{ name: 'Realtime WS' },
+		{ client: user.session.client },
+	)
+
+	const { spaceId } = await createSpace(
+		{ workspaceId, name: 'Realtime Space' },
+		{ client: user.session.client },
+	)
+
+	const { listId } = await addList(
+		{ spaceId, name: 'Backlog' },
+		{ client: user.session.client },
+	)
+
+	const taskTitle = 'Ship realtime board'
+
+	const { taskId } = await createTask(
+		{
+			workspaceId,
+			spaceId,
+			listId,
+			title: taskTitle,
+			priority: TaskPriorityEnum.NORMAL,
+			assigneeIds: [],
+		},
+		{ client: user.session.client },
+	)
+
+	// ── 3. Open the board ─────────────────────────────────────────────────────
+	await page.goto(`/workspaces/${workspaceId}/spaces/${spaceId}?viewMode=board`)
+
+	// ── 4. Assert initial state: card is visible in the TODO column ───────────
+	// Proves the page rendered the board and subscribed to the SSE channel
+	// before the out-of-band mutation fires.
+	await expect(
+		page
+			.getByRole('region', { name: t('enums.TaskStatus.TODO') })
+			.getByText(taskTitle),
+	).toBeVisible()
+
+	// ── 5. Trigger the realtime path out-of-band ──────────────────────────────
+	//
+	// Realtime contract:
+	//   PATCH /v1/task/tasks/status raises TaskStatusChanged domain event
+	//   → OnTaskStatusChangedPublishIntegrationEvent handler publishes
+	//     integration.shared.task.status_changed to the outbox
+	//   → OutboxDispatcher delivers to the SSE broadcaster
+	//   → The route's useServerEvents hook receives the event and calls
+	//     queryClient.invalidateQueries on the board query key
+	//   → React Query refetches the board; the card moves to DONE column
+	//   All of this happens without any page.reload() or navigation.
+	//
+	// We assert using web-first auto-retrying assertions so Playwright polls
+	// until the DOM reflects the SSE-driven refetch or the assertion times out.
+	await changeTaskStatus(
+		{ taskId, status: TaskStatusEnum.DONE },
+		{ client: user.session.client },
+	)
+
+	// ── 6. Assert realtime result WITHOUT page reload ─────────────────────────
+	// Web-first assertions auto-retry; no waitForTimeout, no page.reload().
+
+	// The card must appear inside the DONE column.
+	await expect(
+		page
+			.getByRole('region', { name: t('enums.TaskStatus.DONE') })
+			.getByText(taskTitle),
+	).toBeVisible()
+
+	// The card must no longer be present in the TODO column.
+	await expect(
+		page
+			.getByRole('region', { name: t('enums.TaskStatus.TODO') })
+			.getByText(taskTitle),
+	).toHaveCount(0)
+})
