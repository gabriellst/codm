+
+export type WorkspaceApplicationErrors = 'WORKSPACE_NOT_FOUND' | 'SPACE_NOT_FOUND'
+export type ApplicationErrors = BaseApplicationErrors | WorkspaceApplicationErrors
+
+export type InterfaceErrors = BaseInterfaceErrors
+export type InfrastructureErrors = BaseInfrastructureErrors
+export type Errors = ApplicationErrors | DomainErrors | InfrastructureErrors | InterfaceErrors
+
+registerErrorCodes({
+	INVALID_WORKSPACE_NAME: HttpStatusCode.UNPROCESSABLE_ENTITY,
+	INVALID_LIST_NAME: HttpStatusCode.UNPROCESSABLE_ENTITY,
+	INVALID_SPACE_NAME: HttpStatusCode.UNPROCESSABLE_ENTITY,
