@@ -0,0 +1,55 @@
+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import type { ApplicationErrors } from '../errors'
+import { SpaceRepository } from '../repositories/SpaceRepository/SpaceRepository'
+import { ListAddedEvent } from '../events/ListAddedEvent'
+
+export const AddListInputSchema = z.object({
+	spaceId: z.uuid(),
+	name: z.string().min(1),
+})
+
+export const AddListOutputSchema = z.object({
+	listId: z.uuid(),
+})
+
+@injectable()
+export class AddList extends Handler<typeof AddListInputSchema, typeof AddListOutputSchema> {
+	readonly name = 'add_list' as const
+	readonly inputSchema = AddListInputSchema
+	readonly outputSchema = AddListOutputSchema
+
+	constructor(private readonly spaceRepo: SpaceRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const space = await this.spaceRepo.findById(input.spaceId, tx)
+			if (!space) {
+				throw new BaseError<ApplicationErrors>('SPACE_NOT_FOUND')
+			}
+
+			const list = space.addList(input.name)
+
+			await this.spaceRepo.save(space, tx)
+
+			await this.domainEventRepository.save(
+				new ListAddedEvent({
+					entityId: space.id.value,
+					ownerId: space.workspaceId.value,
+					payload: {
+						workspaceId: space.workspaceId.value,
+						spaceId: space.id.value,
+						listId: list.id,
+						name: list.name,
+					},
+				}),
+				tx,
+			)
+
+			return { listId: list.id }
+		})
+	}
+}
