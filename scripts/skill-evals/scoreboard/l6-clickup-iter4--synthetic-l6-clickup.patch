+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import { List, ListSchema } from '../objects/List'
+import type { WorkspaceDomainErrors } from '../errors'
+
+export const SpaceSchema = z.object({
+	workspaceId: z.instance(Id),
+	name: z.string().min(1),
+	order: z.number().int().min(0).default(0),
+	lists: z.array(z.instance(List)).default([]),
+})
+
+export type SpaceProps = Z.infer<typeof SpaceSchema>
+
+export class Space extends AggregateRoot<typeof SpaceSchema> {
+	static override schema = SpaceSchema
+
+	static create(data: { workspaceId: string; name: string; order?: number }): Space {
+		if (!data.name || data.name.trim().length === 0) {
+			throw new BaseError<WorkspaceDomainErrors>('INVALID_SPACE_NAME')
+		}
+		return new Space({
+			workspaceId: data.workspaceId,
+			name: data.name,
+			order: data.order ?? 0,
+			lists: [],
+		})
+	}
+
+	addList(name: string): List {
+		if (!name || name.trim().length === 0) {
+			throw new BaseError<WorkspaceDomainErrors>('INVALID_LIST_NAME')
+		}
+		const maxOrder = this.lists.length > 0 ? Math.max(...this.lists.map(l => l.order)) : -1
+		const listData = ListSchema.parse({
+			id: crypto.randomUUID(),
+			name,
+			order: maxOrder + 1,
+		})
+		const list = new List(listData)
+		this.lists = [...this.lists, list]
+		return list
+	}
+
+	hasList(listId: string): boolean {
+		return this.lists.some(l => l.id === listId)
+	}
+}
+
+export interface Space extends SpaceProps {}
