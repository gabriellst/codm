+import { useTranslation } from 'react-i18next'
+import { useAssignTask } from '@template/client-typescript/typescript'
+
+import { Button } from '@/components/ui/button'
+import { useSession } from '@/hooks'
+
+interface AssignButtonProps {
+	taskId: string
+	assigneeIds: string[]
+}
+
+/**
+ * AssignButton — assigns/unassigns the current user to a task.
+ * Kept whole (no try/catch, no onError).
+ */
+export function AssignButton({ taskId, assigneeIds }: AssignButtonProps) {
+	const { t } = useTranslation()
+	const session = useSession()
+	const assignTask = useAssignTask()
+
+	const currentUserId = session?.user.id
+
+	if (!currentUserId) return null
+
+	const isAssigned = assigneeIds.includes(currentUserId)
+
+	const handleClick = () => {
+		const nextAssigneeIds = isAssigned
+			? assigneeIds.filter(id => id !== currentUserId)
+			: [...assigneeIds, currentUserId]
+
+		assignTask.mutate({ data: { taskId, assigneeIds: nextAssigneeIds } })
+	}
+
+	return (
+		<Button variant="outline" onClick={handleClick} disabled={assignTask.isPending}>
+			{isAssigned ? t('spaceDetail.assign.unassign') : t('spaceDetail.assign.assignToMe')}
+		</Button>
+	)
+}
