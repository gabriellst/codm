+import Z from 'zod'
+import { z } from '@template/core-typescript'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { TaskCreatedEvent } from '../events/TaskCreatedEvent'
+import { TaskStatusChangedEvent } from '../events/TaskStatusChangedEvent'
+import { TaskAssignedEvent } from '../events/TaskAssignedEvent'
+
+// ── Event union — single source of truth for the projector generic ──────────
+export type ListViewProjectionEvent =
+	| TaskCreatedEvent
+	| TaskStatusChangedEvent
+	| TaskAssignedEvent
+
+// ── Schema + props ───────────────────────────────────────────────────────────
+export const ListViewProjectionSchema = z.object({
+	taskId: z.string(),
+	workspaceId: z.string(),
+	spaceId: z.string(),
+	listId: z.string(),
+	title: z.string(),
+	status: z.enum(TaskStatus),
+	priority: z.enum(TaskPriority),
+	assigneeIds: z.array(z.string()),
+	order: z.number(),
+})
+
+export type ListViewProjectionProps = Z.infer<typeof ListViewProjectionSchema>
+
+// ── Free record class ────────────────────────────────────────────────────────
+export class ListViewProjection {
+	constructor(public props: ListViewProjectionProps) {}
+
+	// ── Creation: only TaskCreated creates a row ──────────────────────────────
+	static create(event: TaskCreatedEvent): ListViewProjection
+	static create(event: TaskCreatedEvent): ListViewProjection {
+		return new ListViewProjection({
+			taskId: event.payload.taskId,
+			workspaceId: event.payload.workspaceId,
+			spaceId: event.payload.spaceId,
+			listId: event.payload.listId,
+			title: event.payload.title,
+			status: event.payload.status,
+			priority: event.payload.priority,
+			assigneeIds: event.payload.assigneeIds,
+			order: 0,
+		})
+	}
+
+	// ── Mutation: status changed and assigned mutate existing rows ────────────
+	applyEvent(event: TaskStatusChangedEvent): void
+	applyEvent(event: TaskAssignedEvent): void
+	applyEvent(event: TaskStatusChangedEvent | TaskAssignedEvent): void {
+		switch (event.name) {
+			case 'task.task.status_changed':
+				this.props.status = event.payload.toStatus
+				return
+			case 'task.task.assigned':
+				this.props.assigneeIds = event.payload.assigneeIds
+				return
+			default: {
+				const _exhaustive: never = event
+				void _exhaustive
+				return
+			}
+		}
+	}
+}
