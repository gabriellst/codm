diff --git a/packages/api/typescript/core/src/types/BaseDomainEvent.ts b/packages/api/typescript/core/src/types/BaseDomainEvent.ts
index c81c206d3..d8b0132b4 100644
--- a/packages/api/typescript/core/src/types/BaseDomainEvent.ts
+++ b/packages/api/typescript/core/src/types/BaseDomainEvent.ts
@@ -17,7 +17,13 @@ export type DomainEventSchemaConstraint = ZodObject<{
 	payload: ZodTypeAny
 }>
 
-export abstract class BaseDomainEvent<EventSchema extends DomainEventSchemaConstraint = typeof BaseDomainEventSchema> extends BaseEvent<
+// Default to the wide constraint, NOT `typeof BaseDomainEventSchema`: bare
+// `BaseDomainEvent` means "a domain event with ANY payload" (the honest type
+// for heterogeneous event sinks like `DomainEventRepository.save`). The empty
+// `BaseDomainEventSchema` payload (`Record<string, never>`) rejected every real
+// event once a concrete subclass redeclared an instance member — e.g. the
+// literal `name` that projector `switch (event.name)` narrowing depends on.
+export abstract class BaseDomainEvent<EventSchema extends DomainEventSchemaConstraint = DomainEventSchemaConstraint> extends BaseEvent<
 	EventSchema['shape']['payload']
 > {
 	readonly entityId?: string
