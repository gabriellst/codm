diff --git a/packages/app/react/src/routes/(app)/reports/-components/ReportsSection/index.tsx b/packages/app/react/src/routes/(app)/reports/-components/ReportsSection/index.tsx
new file mode 100644
index 000000000..7cafde5f2
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/ReportsSection/index.tsx
@@ -0,0 +1,387 @@
+import { type ComponentProps, useMemo } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { endOfDay, startOfDay } from 'date-fns'
+import type { DateRange } from 'react-day-picker'
+import { IconChevronDown, IconCheck } from '@tabler/icons-react'
+import {
+	useGetChart,
+	ChartTypeEnum,
+	DayOfWeekEnum,
+	DayPeriodEnum,
+	type ChartType,
+	type DayOfWeek,
+	type DayPeriod,
+	type GetChartQueryResponse,
+	type SignedMoney,
+} from '@template/client-typescript/typescript'
+
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { BarGraphIcon } from '@/components/ui/icons'
+import { DatePicker } from '@/components/ui/date-picker'
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from '@/components/ui/dropdown-menu'
+import { Empty, EmptyHeader, EmptyTitle, EmptyDescription } from '@/components/ui/empty'
+import { cn } from '@/lib/utils'
+import { tryCatch } from '@/lib/utils'
+import { useMoney, useLocale } from '@/hooks'
+import { useTenancyStore } from '@/stores'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+// ─── Types ────────────────────────────────────────────────────────────────────
+
+interface SegmentRow {
+	label: string
+	revenue: SignedMoney
+	profit: SignedMoney | null
+	orders: number
+}
+
+// Labels are pre-resolved from the i18n catalog before the converter runs — no t() inside converters.
+interface ConverterCtx {
+	locale: string
+	dayOfWeekLabels: Record<DayOfWeek, string>
+	dayPeriodLabels: Record<DayPeriod, string>
+}
+
+// ─── Variant converters — dispatch map (CMP-P18) ──────────────────────────────
+// One entry per discriminant. Keyed by ChartTypeEnum so the record is exhaustive.
+
+type Converter = (data: GetChartQueryResponse, ctx: ConverterCtx) => SegmentRow[]
+
+const WEEKDAY_ORDER: DayOfWeek[] = [
+	DayOfWeekEnum.MONDAY,
+	DayOfWeekEnum.TUESDAY,
+	DayOfWeekEnum.WEDNESDAY,
+	DayOfWeekEnum.THURSDAY,
+	DayOfWeekEnum.FRIDAY,
+	DayOfWeekEnum.SATURDAY,
+	DayOfWeekEnum.SUNDAY,
+]
+
+const PERIOD_ORDER: DayPeriod[] = [
+	DayPeriodEnum.MORNING,
+	DayPeriodEnum.AFTERNOON,
+	DayPeriodEnum.EVENING,
+	DayPeriodEnum.NIGHT,
+]
+
+const VARIANT_TO_ROWS: Record<ChartType, Converter> = {
+	[ChartTypeEnum.income]: (data, ctx) => {
+		if (data.kind !== 'income') return []
+		return data.buckets.map(b => ({
+			label: new Date(b.timestamp).toLocaleDateString(ctx.locale, { day: '2-digit', month: 'short' }),
+			revenue: b.revenue,
+			profit: b.profit,
+			orders: b.orders,
+		}))
+	},
+	[ChartTypeEnum.weekday]: (data, ctx) => {
+		if (data.kind !== 'weekday') return []
+		return WEEKDAY_ORDER.map(key => ({
+			label: ctx.dayOfWeekLabels[key],
+			revenue: data.segments[key].revenue,
+			profit: data.segments[key].profit,
+			orders: data.segments[key].orders,
+		}))
+	},
+	[ChartTypeEnum.hour]: (data) => {
+		if (data.kind !== 'hour') return []
+		return Object.entries(data.segments)
+			.sort(([a], [b]) => Number(a) - Number(b))
+			.map(([hour, seg]) => ({
+				label: `${hour}h`,
+				revenue: seg.revenue,
+				profit: seg.profit,
+				orders: seg.orders,
+			}))
+	},
+	[ChartTypeEnum.period]: (data, ctx) => {
+		if (data.kind !== 'period') return []
+		return PERIOD_ORDER.map(key => ({
+			label: ctx.dayPeriodLabels[key],
+			revenue: data.segments[key].revenue,
+			profit: data.segments[key].profit,
+			orders: data.segments[key].orders,
+		}))
+	},
+	[ChartTypeEnum.region]: (data) => {
+		if (data.kind !== 'region') return []
+		return Object.entries(data.regions).map(([key, r]) => ({
+			label: r.state ? `${r.state}, ${r.country}` : key,
+			revenue: r.total,
+			profit: null,
+			orders: r.orders,
+		}))
+	},
+}
+
+// ─── RecorteSelector ─────────────────────────────────────────────────────────
+
+interface RecorteSelectorProps {
+	value: ChartType
+	onChange: (v: ChartType) => void
+}
+
+function RecorteSelector({ value, onChange }: RecorteSelectorProps) {
+	const { t } = useTranslation()
+
+	// Record keyed by SDK enum — exhaustive, typed literal keys, no template interpolation.
+	const LABELS: Record<ChartType, string> = {
+		[ChartTypeEnum.income]: t('enums.ChartType.income'),
+		[ChartTypeEnum.weekday]: t('enums.ChartType.weekday'),
+		[ChartTypeEnum.hour]: t('enums.ChartType.hour'),
+		[ChartTypeEnum.period]: t('enums.ChartType.period'),
+		[ChartTypeEnum.region]: t('enums.ChartType.region'),
+	}
+
+	return (
+		<DropdownMenu>
+			<DropdownMenuTrigger className="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-sm text-muted-foreground transition-colors hover:bg-accent/50 hover:text-foreground">
+				{LABELS[value]}
+				<IconChevronDown size={14} />
+			</DropdownMenuTrigger>
+			<DropdownMenuContent side="bottom" align="end">
+				{(Object.values(ChartTypeEnum) as ChartType[]).map(v => (
+					<DropdownMenuItem key={v} onClick={() => onChange(v)}>
+						<span className="flex-1">{LABELS[v]}</span>
+						{v === value ? <IconCheck size={14} className="text-primary" /> : null}
+					</DropdownMenuItem>
+				))}
+			</DropdownMenuContent>
+		</DropdownMenu>
+	)
+}
+
+// ─── Bar ─────────────────────────────────────────────────────────────────────
+
+function Bar({ fraction, className, ...props }: ComponentProps<'div'> & { fraction: number }) {
+	return (
+		<div className="h-2 w-full min-w-[3rem] overflow-hidden rounded-full bg-muted" {...props}>
+			<div
+				className={cn('h-2 rounded-full transition-all', className)}
+				style={{ width: `${(Math.max(0, fraction) * 100).toFixed(1)}%` }}
+			/>
+		</div>
+	)
+}
+
+// ─── SegmentTable ─────────────────────────────────────────────────────────────
+
+interface SegmentTableProps {
+	rows: SegmentRow[]
+	showProfit: boolean
+}
+
+function SegmentTable({ rows, showProfit }: SegmentTableProps) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const locale = useLocale()
+
+	const maxRevenueCents = useMemo(() => Math.max(1, ...rows.map(r => r.revenue.amountCents)), [rows])
+	const maxProfitCents = useMemo(
+		() => Math.max(1, ...rows.filter(r => r.profit !== null).map(r => r.profit!.amountCents)),
+		[rows],
+	)
+
+	return (
+		<div className="w-full overflow-x-auto">
+			<div className="min-w-[32rem]">
+				{/* Header */}
+				<div className="grid grid-cols-[10rem_1fr_1fr_5rem] gap-x-4 border-b border-border px-2 pb-2 text-xs font-medium text-muted-foreground">
+					<span>{t('salesReports.columns.label')}</span>
+					<span>{t('salesReports.columns.revenue')}</span>
+					<span>{showProfit ? t('salesReports.columns.profit') : t('salesReports.columns.total')}</span>
+					<span className="text-right">{t('salesReports.columns.orders')}</span>
+				</div>
+				{/* Rows */}
+				{rows.map((row, i) => (
+					<div
+						key={i}
+						className="grid grid-cols-[10rem_1fr_1fr_5rem] gap-x-4 border-b border-border/50 px-2 py-3 text-sm transition-colors hover:bg-muted/30"
+					>
+						<span className="truncate font-medium text-foreground" title={row.label}>
+							{row.label}
+						</span>
+						{/* Revenue */}
+						<div className="flex items-center gap-2">
+							<Bar
+								fraction={row.revenue.amountCents / maxRevenueCents}
+								className="bg-[hsl(var(--primary)/0.8)]"
+							/>
+							<span className="shrink-0 text-xs tabular-nums text-foreground">
+								{formatMoney(row.revenue)}
+							</span>
+						</div>
+						{/* Profit / Total */}
+						<div className="flex items-center gap-2">
+							{row.profit !== null ? (
+								<>
+									<Bar
+										fraction={row.profit.amountCents / maxProfitCents}
+										className="bg-[hsl(var(--success)/0.8)]"
+									/>
+									<span className="shrink-0 text-xs tabular-nums text-foreground">
+										{formatMoney(row.profit)}
+									</span>
+								</>
+							) : (
+								<span className="text-xs text-muted-foreground">—</span>
+							)}
+						</div>
+						{/* Orders */}
+						<span className="text-right text-xs tabular-nums text-muted-foreground">
+							{row.orders.toLocaleString(locale)}
+						</span>
+					</div>
+				))}
+			</div>
+		</div>
+	)
+}
+
+// ─── ReportsSection ───────────────────────────────────────────────────────────
+
+export function ReportsSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const search = routeApi.useSearch()
+	const navigate = routeApi.useNavigate()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+	const locale = useLocale()
+
+	const { chartType, startDate, endDate, productIds } = search
+
+	const { data, isPending, isError } = useGetChart({
+		chartType,
+		tenancyScope,
+		frequency: 'DAILY',
+		startDate,
+		endDate,
+		productIds,
+	})
+
+	// Pre-resolve enum labels from the typed i18n catalog (literal keys — no template literals).
+	const converterCtx = useMemo<ConverterCtx>(
+		() => ({
+			locale,
+			dayOfWeekLabels: {
+				[DayOfWeekEnum.SUNDAY]: t('enums.DayOfWeek.SUNDAY'),
+				[DayOfWeekEnum.MONDAY]: t('enums.DayOfWeek.MONDAY'),
+				[DayOfWeekEnum.TUESDAY]: t('enums.DayOfWeek.TUESDAY'),
+				[DayOfWeekEnum.WEDNESDAY]: t('enums.DayOfWeek.WEDNESDAY'),
+				[DayOfWeekEnum.THURSDAY]: t('enums.DayOfWeek.THURSDAY'),
+				[DayOfWeekEnum.FRIDAY]: t('enums.DayOfWeek.FRIDAY'),
+				[DayOfWeekEnum.SATURDAY]: t('enums.DayOfWeek.SATURDAY'),
+			},
+			dayPeriodLabels: {
+				[DayPeriodEnum.MORNING]: t('enums.DayPeriod.MORNING'),
+				[DayPeriodEnum.AFTERNOON]: t('enums.DayPeriod.AFTERNOON'),
+				[DayPeriodEnum.EVENING]: t('enums.DayPeriod.EVENING'),
+				[DayPeriodEnum.NIGHT]: t('enums.DayPeriod.NIGHT'),
+			},
+		}),
+		[locale, t],
+	)
+
+	// Convert the discriminated-union response into a flat SegmentRow list via the dispatch map.
+	const rows = useMemo<SegmentRow[]>(() => {
+		if (!data) return []
+		return VARIANT_TO_ROWS[chartType](data, converterCtx)
+	}, [data, chartType, converterCtx])
+
+	const showProfit = chartType !== ChartTypeEnum.region
+
+	// ─── Handlers ─────────────────────────────────────────────────────────────
+
+	function handleChartTypeChange(next: ChartType) {
+		navigate({ search: prev => ({ ...prev, chartType: next }) })
+	}
+
+	function handleDateRangeChange(range: DateRange | undefined) {
+		if (!range?.from || !range.to) return
+		navigate({
+			search: prev => ({
+				...prev,
+				startDate: startOfDay(range.from!).toISOString(),
+				endDate: endOfDay(range.to!).toISOString(),
+			}),
+		})
+	}
+
+	// Parse ISO strings from URL back to Date for the picker — use tryCatch (no raw try/catch in app code)
+	const dateRange = useMemo<DateRange | undefined>(() => {
+		const result = tryCatch(() => ({ from: new Date(startDate), to: new Date(endDate) }))
+		return result.success ? result.data : undefined
+	}, [startDate, endDate])
+
+	// ─── Render ────────────────────────────────────────────────────────────────
+
+	return (
+		<Card className={cn('flex flex-col gap-4 p-6', className)} {...props}>
+			{/* Header + controls — always visible */}
+			<div className="flex flex-wrap items-start justify-between gap-3">
+				<div className="flex items-center gap-3">
+					<GradientIconBadge icon={BarGraphIcon} />
+					<div>
+						<h1 className="text-lg font-semibold text-foreground">{t('salesReports.title')}</h1>
+						<p className="text-sm text-muted-foreground">{t('salesReports.subtitle')}</p>
+					</div>
+				</div>
+				<div className="flex flex-wrap items-center gap-2">
+					<RecorteSelector value={chartType} onChange={handleChartTypeChange} />
+					<DatePicker
+						mode="range"
+						range={dateRange}
+						onRangeChange={handleDateRangeChange}
+						showPresets
+						placeholder={t('salesReports.dateRangeLabel')}
+					/>
+				</div>
+			</div>
+
+			{/* Data area — skeleton / error / empty / content */}
+			<div className="min-h-[12rem]">
+				{isPending ? (
+					<div className="flex flex-col gap-2 pt-2">
+						{Array.from({ length: 6 }).map((_, i) => (
+							<Skeleton key={i} className="h-10 w-full rounded-lg" />
+						))}
+					</div>
+				) : isError ? (
+					<Empty className="border-dashed">
+						<EmptyHeader>
+							<EmptyTitle>{t('salesReports.loadError')}</EmptyTitle>
+						</EmptyHeader>
+					</Empty>
+				) : rows.length === 0 ? (
+					<Empty className="border-dashed">
+						<EmptyHeader>
+							<EmptyTitle>{t('salesReports.empty')}</EmptyTitle>
+							<EmptyDescription>{t('salesReports.emptyDescription')}</EmptyDescription>
+						</EmptyHeader>
+					</Empty>
+				) : (
+					<SegmentTable rows={rows} showProfit={showProfit} />
+				)}
+			</div>
+
+			{/* Legend — only when data is present */}
+			{!isPending && !isError && rows.length > 0 ? (
+				<div className="flex items-center gap-4 text-xs text-muted-foreground">
+					<span className="flex items-center gap-1.5">
+						<span className="inline-block size-2.5 rounded-sm bg-[hsl(var(--primary)/0.8)]" />
+						{t('salesReports.columns.revenue')}
+					</span>
+					{showProfit ? (
+						<span className="flex items-center gap-1.5">
+							<span className="inline-block size-2.5 rounded-sm bg-[hsl(var(--success)/0.8)]" />
+							{t('salesReports.columns.profit')}
+						</span>
+					) : null}
+				</div>
+			) : null}
+		</Card>
+	)
+}
