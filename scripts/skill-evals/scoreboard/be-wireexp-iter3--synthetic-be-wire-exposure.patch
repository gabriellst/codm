+import { injectable } from 'tsyringe-neo'
+import type { Transaction } from '@template/core-typescript'
+import { RevenueAdvance } from '../../entities/RevenueAdvance'
+import { RevenueAdvanceRepository } from './RevenueAdvanceRepository'
+
+@injectable()
+export class MockRevenueAdvanceRepository extends RevenueAdvanceRepository {
+	private rows = new Map<string, RevenueAdvance>()
+
+	async findById(id: string, _tx?: Transaction): Promise<RevenueAdvance | undefined> {
+		return this.rows.get(id)
+	}
+
+	async save(entity: RevenueAdvance, _tx?: Transaction): Promise<RevenueAdvance> {
+		entity.incrementVersion()
+		this.rows.set(entity.id.value, entity)
+		return entity
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.rows.delete(id)
+	}
+
+	seed(entity: RevenueAdvance): void {
+		this.rows.set(entity.id.value, entity)
+	}
+
+	clear(): void {
+		this.rows.clear()
+	}
+}
