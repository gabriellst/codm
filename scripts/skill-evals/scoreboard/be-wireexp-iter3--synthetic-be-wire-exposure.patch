+import { AggregateRoot, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import type { CurrencyCode } from '@template/contracts-typescript/wire/enums'
+import { Money } from '../../shared/objects'
+import type { FinanceDomainErrors } from '../errors'
+
+export const RevenueAdvanceSchema = z.object({
+	storeId: z.instance(Id),
+	requestedAmount: z.instance(Money).refine(m => m.amountCents <= 7_500_000, {
+		error: 'ADVANCE_CEILING_EXCEEDED' as FinanceDomainErrors,
+	}),
+	purpose: z.string().min(1).max(500),
+	feeAmount: z.instance(Money),
+})
+
+export type RevenueAdvanceProps = Z.infer<typeof RevenueAdvanceSchema>
+
+export class RevenueAdvance extends AggregateRoot<typeof RevenueAdvanceSchema> {
+	static override schema = RevenueAdvanceSchema
+
+	static create(data: {
+		storeId: string
+		requestedAmount: { amountCents: number; currency: CurrencyCode }
+		purpose: string
+	}): RevenueAdvance {
+		const feeAmountCents = Math.ceil(data.requestedAmount.amountCents * 0.038)
+		return new RevenueAdvance({
+			storeId: data.storeId,
+			requestedAmount: data.requestedAmount,
+			purpose: data.purpose,
+			feeAmount: { amountCents: feeAmountCents, currency: data.requestedAmount.currency },
+		})
+	}
+}
+
+export interface RevenueAdvance extends RevenueAdvanceProps {}
