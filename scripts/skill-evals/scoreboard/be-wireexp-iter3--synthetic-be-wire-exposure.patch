+++ b/packages/api/typescript/src/finance/entities/RevenueAdvance.test.ts
@@ -0,0 +1,76 @@
+import { describe, expect, it } from 'bun:test'
+import { RevenueAdvance } from './RevenueAdvance'
+
+const STORE = '00000000-0000-0000-0000-000000000001'
+
+describe('RevenueAdvance entity', () => {
+	describe('create()', () => {
+		it('accepts requestedAmount at the ceiling (7_500_000 cents)', () => {
+			const advance = RevenueAdvance.create({
+				storeId: STORE,
+				requestedAmount: { amountCents: 7_500_000, currency: 'BRL' },
+				purpose: 'Working capital',
+			})
+			expect(advance.requestedAmount.amountCents).toBe(7_500_000)
+		})
+
+		it('accepts requestedAmount one cent below the ceiling', () => {
+			const advance = RevenueAdvance.create({
+				storeId: STORE,
+				requestedAmount: { amountCents: 7_499_999, currency: 'BRL' },
+				purpose: 'Working capital',
+			})
+			expect(advance.requestedAmount.amountCents).toBe(7_499_999)
+		})
+
+		it('throws ADVANCE_CEILING_EXCEEDED for requestedAmount one cent above the ceiling', () => {
+			expect(() =>
+				RevenueAdvance.create({
+					storeId: STORE,
+					requestedAmount: { amountCents: 7_500_001, currency: 'BRL' },
+					purpose: 'Working capital',
+				}),
+			).toThrow('ADVANCE_CEILING_EXCEEDED')
+		})
+
+		it('throws ADVANCE_CEILING_EXCEEDED for a large amount well above the ceiling', () => {
+			expect(() =>
+				RevenueAdvance.create({
+					storeId: STORE,
+					requestedAmount: { amountCents: 10_000_000, currency: 'BRL' },
+					purpose: 'Working capital',
+				}),
+			).toThrow('ADVANCE_CEILING_EXCEEDED')
+		})
+
+		it('computes feeAmount as Math.ceil(requestedAmount * 0.038), same currency', () => {
+			const advance = RevenueAdvance.create({
+				storeId: STORE,
+				requestedAmount: { amountCents: 1_000_000, currency: 'BRL' },
+				purpose: 'Estoque',
+			})
+			// 1_000_000 * 0.038 = 38_000 (exact — no ceiling needed)
+			expect(advance.feeAmount.amountCents).toBe(38_000)
+			expect(advance.feeAmount.currency).toBe('BRL')
+		})
+
+		it('applies Math.ceil to fractional fee cents', () => {
+			// 100_001 * 0.038 = 3800.038 → Math.ceil → 3801
+			const advance = RevenueAdvance.create({
+				storeId: STORE,
+				requestedAmount: { amountCents: 100_001, currency: 'BRL' },
+				purpose: 'Test rounding',
+			})
+			expect(advance.feeAmount.amountCents).toBe(3_801)
+		})
+
+		it('inherits currency from requestedAmount for feeAmount', () => {
+			const advance = RevenueAdvance.create({
+				storeId: STORE,
+				requestedAmount: { amountCents: 500_000, currency: 'USD' },
+				purpose: 'USD advance',
+			})
+			expect(advance.feeAmount.currency).toBe('USD')
+		})
+	})
+})
