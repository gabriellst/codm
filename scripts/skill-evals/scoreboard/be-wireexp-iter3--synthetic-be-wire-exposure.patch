+ * amount is stored alongside the platform-computed fee (3.8 % of the
+ * requested amount, rounded up) so that historical records remain stable
+ * even if the fee policy changes in the future.
+ *
+ * The ceiling (R$ 75 000,00 / 7_500_000 cents) and fee formula are
+ * server-side business rules enforced by the `RevenueAdvance` entity —
+ * they are intentionally absent from the wire schema.
+ */
+export const revenueAdvances = financeSchema.table(
+	'revenue_advances',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		storeId: uuid('store_id').notNull(),
+
+		// Requested amount — cents + ISO 4217 currency code.
+		requestedAmountCents: bigint('requested_amount_cents', { mode: 'bigint' }).notNull(),
+		requestedAmountCurrency: text('requested_amount_currency').notNull(),
+
+		// Platform financing fee computed at request time.
+		feeAmountCents: bigint('fee_amount_cents', { mode: 'bigint' }).notNull(),
+		feeAmountCurrency: text('fee_amount_currency').notNull(),
+
+		// Short free-text description of the advance purpose.
+		purpose: text('purpose').notNull(),
+
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		storeIdx: index('revenue_advances_store_id_idx').on(t.storeId),
+	}),
+)
