+import { injectable } from 'tsyringe-neo'
+import { Handler, z, type Transaction } from '@template/core-typescript'
+import { MoneySchema } from '../../shared/objects'
+import { RevenueAdvance } from '../entities/RevenueAdvance'
+import { RevenueAdvanceRepository } from '../repositories/RevenueAdvanceRepository'
+import { RevenueAdvanceRequestedEvent } from '../events/RevenueAdvanceRequestedEvent'
+
+export const RequestRevenueAdvanceInputSchema = z.object({
+	storeId: z.uuid(),
+	requestedAmount: MoneySchema,
+	purpose: z.string().min(1).max(500),
+})
+
+export const RequestRevenueAdvanceOutputSchema = z.object({
+	revenueAdvanceId: z.uuid(),
+	feeAmount: MoneySchema,
+})
+
+@injectable()
+export class RequestRevenueAdvance extends Handler<
+	typeof RequestRevenueAdvanceInputSchema,
+	typeof RequestRevenueAdvanceOutputSchema
+> {
+	readonly name = 'request_revenue_advance' as const
+	readonly inputSchema = RequestRevenueAdvanceInputSchema
+	readonly outputSchema = RequestRevenueAdvanceOutputSchema
+
+	constructor(private readonly advances: RevenueAdvanceRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const advance = RevenueAdvance.create({
+				storeId: input.storeId,
+				requestedAmount: input.requestedAmount,
+				purpose: input.purpose,
+			})
+			await this.advances.save(advance, tx)
+
+			await this.domainEventRepository.save(
+				new RevenueAdvanceRequestedEvent({
+					entityId: advance.id.value,
+					ownerId: input.storeId,
+					payload: {
+						revenueAdvance: {
+							storeId: advance.storeId.value,
+							requestedAmount: {
+								amountCents: advance.requestedAmount.amountCents,
+								currency: advance.requestedAmount.currency,
+							},
+							purpose: advance.purpose,
+							feeAmount: {
+								amountCents: advance.feeAmount.amountCents,
+								currency: advance.feeAmount.currency,
+							},
+						},
+					},
+				}),
+				tx,
+			)
+
+			return {
+				revenueAdvanceId: advance.id.value,
+				feeAmount: {
+					amountCents: advance.feeAmount.amountCents,
+					currency: advance.feeAmount.currency,
+				},
+			}
+		})
+	}
+}
