@@ -0,0 +1,91 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { revenueAdvances } from '@template/contracts/db'
+import type { CurrencyCode } from '@template/contracts-typescript/wire/enums'
+import { RevenueAdvance } from '../../entities/RevenueAdvance'
+import { RevenueAdvanceRepository } from './RevenueAdvanceRepository'
+
+@injectable()
+export class DrizzleRevenueAdvanceRepository extends RevenueAdvanceRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<RevenueAdvance | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(revenueAdvances).where(eq(revenueAdvances.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async save(entity: RevenueAdvance, tx?: DrizzleClient): Promise<RevenueAdvance> {
+		entity.incrementVersion()
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+			await dbc
+				.insert(revenueAdvances)
+				.values(data)
+				.onConflictDoUpdate({
+					target: revenueAdvances.id,
+					set: {
+						storeId: data.storeId,
+						requestedAmountCents: data.requestedAmountCents,
+						requestedAmountCurrency: data.requestedAmountCurrency,
+						feeAmountCents: data.feeAmountCents,
+						feeAmountCurrency: data.feeAmountCurrency,
+						purpose: data.purpose,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc.delete(revenueAdvances).where(eq(revenueAdvances.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: typeof revenueAdvances.$inferSelect): RevenueAdvance {
+		return new RevenueAdvance({
+			id: row.id,
+			storeId: row.storeId,
+			requestedAmount: {
+				amountCents: Number(row.requestedAmountCents),
+				currency: row.requestedAmountCurrency as CurrencyCode,
+			},
+			purpose: row.purpose,
+			feeAmount: {
+				amountCents: Number(row.feeAmountCents),
+				currency: row.feeAmountCurrency as CurrencyCode,
+			},
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: RevenueAdvance): typeof revenueAdvances.$inferInsert {
+		return {
+			id: entity.id.value,
+			storeId: entity.storeId.value,
+			requestedAmountCents: BigInt(entity.requestedAmount.amountCents),
+			requestedAmountCurrency: entity.requestedAmount.currency,
+			feeAmountCents: BigInt(entity.feeAmount.amountCents),
+			feeAmountCurrency: entity.feeAmount.currency,
+			purpose: entity.purpose,
+			version: entity.version,
+		}
+	}
+}
