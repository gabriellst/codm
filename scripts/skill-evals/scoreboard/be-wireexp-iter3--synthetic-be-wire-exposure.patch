+import { RevenueAdvanceRepository } from '../repositories/RevenueAdvanceRepository'
+import { RevenueAdvanceRequestedEvent } from '../events'
+
+const STORE = testId('store', '1')
+
+describe('Finance (C?? RequestRevenueAdvance)', () => {
+	let testBed: TestBed
+	let testContainer: DependencyContainer
+	let useCase: RequestRevenueAdvance
+	let repo: RevenueAdvanceRepository
+
+	beforeAll(async () => {
+		testContainer = container.createChildContainer()
+		testBed = await TestBed.create('integration', { testContainer, ownerId: 'integration-tenant' })
+		useCase = testBed.resolve(RequestRevenueAdvance)
+		repo = testBed.resolve(RevenueAdvanceRepository)
+	})
+	beforeEach(async () => {
+		await testBed.reset()
+	})
+	afterAll(async () => {
+		await testBed.destroy()
+	})
+
+	async function readEvents() {
+		return testBed.resolve(DomainEventRepository).findByType(RevenueAdvanceRequestedEvent)
+	}
+
+	it('persists the advance and records the domain event', async () => {
+		const out = await useCase.execute({
+			storeId: STORE,
+			requestedAmount: { amountCents: 1_000_000, currency: 'BRL' },
+			purpose: 'Working capital',
+		})
+
+		expect(out.revenueAdvanceId).toMatch(/^[0-9a-f-]{36}$/)
+		expect(out.feeAmount.amountCents).toBe(38_000)
+		expect(out.feeAmount.currency).toBe('BRL')
+
+		const saved = await repo.findById(out.revenueAdvanceId)
+		expect(saved).toBeDefined()
+		expect(saved!.requestedAmount.amountCents).toBe(1_000_000)
+		expect(saved!.feeAmount.amountCents).toBe(38_000)
+		expect(saved!.purpose).toBe('Working capital')
+
+		const events = await readEvents()
+		expect(events).toHaveLength(1)
+		expect(events[0]!.payload.revenueAdvance.storeId).toBe(STORE)
+		expect(events[0]!.payload.revenueAdvance.requestedAmount.amountCents).toBe(1_000_000)
+		expect(events[0]!.payload.revenueAdvance.feeAmount.amountCents).toBe(38_000)
+	})
+
+	it('rejects amounts above the ceiling and records no event', async () => {
+		await expect(
+			useCase.execute({
+				storeId: STORE,
+				requestedAmount: { amountCents: 7_500_001, currency: 'BRL' },
+				purpose: 'Too large',
+			}),
+		).rejects.toThrow('ADVANCE_CEILING_EXCEEDED')
+
+		const events = await readEvents()
+		expect(events).toHaveLength(0)
+	})
+})
