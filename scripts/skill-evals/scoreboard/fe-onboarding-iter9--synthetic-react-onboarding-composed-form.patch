+import { create } from 'zustand'
+import { ConnectionModeEnum, type ConnectionMode, type StoreIntegrationType } from '@template/client-typescript/typescript'
+
+export type WizardPlatform = 'SHOPIFY' | 'YAMPI' | 'META' | 'MERCADOPAGO'
+
+interface ConnectWizardStore {
+	mode: ConnectionMode
+	platform: WizardPlatform | undefined
+	type: StoreIntegrationType | undefined
+	stepIndex: number
+	direction: 1 | -1
+	setMode: (mode: ConnectionMode) => void
+	setPlatformTarget: (platform: WizardPlatform, type: StoreIntegrationType) => void
+	setStepIndex: (stepIndex: number) => void
+	setDirection: (direction: 1 | -1) => void
+	reset: () => void
+}
+
+const INITIAL_STATE = {
+	mode: ConnectionModeEnum.CREDENTIALS as ConnectionMode,
+	platform: undefined as WizardPlatform | undefined,
+	type: undefined as StoreIntegrationType | undefined,
+	stepIndex: 0,
+	direction: 1 as const,
+}
+
+export const useConnectWizardStore = create<ConnectWizardStore>()(set => ({
+	...INITIAL_STATE,
+	setMode: mode => set({ mode }),
+	setPlatformTarget: (platform, type) => set({ platform, type }),
+	setStepIndex: stepIndex => set({ stepIndex }),
+	setDirection: direction => set({ direction }),
+	reset: () => set({ ...INITIAL_STATE }),
+}))
