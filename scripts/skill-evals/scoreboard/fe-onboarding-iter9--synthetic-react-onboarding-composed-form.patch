+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('integrations.sheet.alias')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				<form.Field name="userToken">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('integrations.sheet.userToken')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				<form.Field name="userSecretKey">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('integrations.sheet.userSecretKey')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="password"
+									autoComplete="new-password"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+			</FieldGroup>
+
+			<form.Subscribe selector={s => ({ canSubmit: s.canSubmit, isSubmitting: s.isSubmitting, values: s.values })}>
+				{({ canSubmit, isSubmitting: formSubmitting, values }) => {
+					const isPending = formSubmitting || isSubmitting
+					const isDisabled = !canSubmit || isPending || !credentialsSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<div>
+								{onBack && (
+									<Button type="button" variant="outline" onClick={onBack} disabled={isPending}>
+										<IconArrowLeft className="mr-1 size-4" />
+										{t('common.back')}
+									</Button>
+								)}
+							</div>
+							<Button type="submit" disabled={isDisabled}>
+								{isPending && <Spinner className="mr-2" />}
+								{t('common.next')}
+								<IconArrowRight className="ml-1 size-4" />
+							</Button>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
