index 47b1a4d96..3eb862335 100644
--- a/packages/app/react/src/lib/union.ts
+++ b/packages/app/react/src/lib/union.ts
@@ -38,12 +38,13 @@ export function unionVariantValues<M extends z.ZodObject>(
 
 /**
  * The member schema whose discriminant fields ALL match `match` — call `.safeParse(value)` on it.
- * `match` keys are constrained to the union's fields and values to their valid literals (typos / bad
- * values are compile errors). Throws if no member matches. NOTE: the return is typed as the whole
- * union (runtime-validates the matched member); for the narrowed *type* use `Extract<Req, { … }>`.
+ * `match` keys are constrained to the union's common fields; values are typed as the union of each
+ * field's values across all members (non-distributive partial). This lets callers pass runtime
+ * union-typed values (e.g. `mode: ConnectionMode`) without a cast, unlike `Partial<Union>` which
+ * distributes and requires a value from a single member. Throws if no member matches.
  * e.g. `pickUnionVariant(connectSchema, { platform: 'SHOPIFY', connectionMode: 'CREDENTIALS' })`.
  */
-export function pickUnionVariant<M extends z.ZodObject>(union: z.ZodUnion<readonly M[]>, match: Partial<UnionShape<M>>): M {
+export function pickUnionVariant<M extends z.ZodObject>(union: z.ZodUnion<readonly M[]>, match: { [K in keyof UnionShape<M>]?: UnionShape<M>[K] }): M {
 	const member = union.options.find(m =>
 		Object.entries(match).every(([field, value]) => typeof value === 'string' && literalsOf(m.shape[field]).includes(value)),
 	)
