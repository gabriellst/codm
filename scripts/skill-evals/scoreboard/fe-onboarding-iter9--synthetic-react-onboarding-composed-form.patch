@@ -0,0 +1,121 @@
+import { type ComponentProps } from 'react'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import {
+	connectIntegrationMutationRequestSchema,
+	ConnectionModeEnum,
+	type ConnectionMode,
+	type StoreIntegrationType,
+} from '@template/client-typescript/typescript'
+import { IconArrowLeft } from '@tabler/icons-react'
+import { useTranslation } from 'react-i18next'
+import { cn } from '@/lib/utils'
+import type { ConnectForm, WizardPlatform } from '../ConnectWizard'
+
+interface ReviewStepProps extends ComponentProps<'div'> {
+	form: ConnectForm
+	platform: WizardPlatform
+	type: StoreIntegrationType | undefined
+	connectionMode: ConnectionMode
+	onSubmit: () => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+// Static label maps — no template-literal interpolation outside the enum-label canon.
+const PLATFORM_NAME_KEYS: Record<WizardPlatform, string> = {
+	SHOPIFY: 'onboarding.targets.SHOPIFY.name',
+	YAMPI: 'onboarding.targets.YAMPI.name',
+	META: 'onboarding.targets.META.name',
+	MERCADOPAGO: 'onboarding.targets.MERCADOPAGO.name',
+} as const
+
+const CREDENTIAL_FIELD_LABEL_KEYS: Record<string, string> = {
+	shopDomain: 'onboarding.review.credentials.shopDomain',
+	clientId: 'onboarding.review.credentials.clientId',
+	clientSecret: 'onboarding.review.credentials.clientSecret',
+	alias: 'onboarding.review.credentials.alias',
+	userToken: 'onboarding.review.credentials.userToken',
+	userSecretKey: 'onboarding.review.credentials.userSecretKey',
+} as const
+
+const SECRET_FIELDS = new Set(['clientSecret', 'userSecretKey', 'accessToken'])
+
+export function ReviewStep({ form, platform, type, connectionMode, onSubmit, onBack, isSubmitting, className, ...props }: ReviewStepProps) {
+	const { t } = useTranslation()
+
+	return (
+		<div className={cn('flex flex-col gap-6 p-6', className)} {...props}>
+			<div className="text-center">
+				<h2 className="text-2xl font-semibold tracking-tight">{t('onboarding.review.title')}</h2>
+				<p className="text-muted-foreground mt-2">{t('onboarding.review.subtitle')}</p>
+			</div>
+
+			<form.Subscribe selector={s => s.values}>
+				{values => {
+					// Gate submit on the full union schema — no as-never cast needed; safeParse
+					// walks the union and succeeds only when one member's discriminants match.
+					const isValid = connectIntegrationMutationRequestSchema.safeParse(values).success
+
+					const credentials = (values as { credentials?: Record<string, string> }).credentials
+					const credentialEntries = credentials
+						? Object.entries(credentials).filter(([, v]) => typeof v === 'string' && v.length > 0)
+						: []
+
+					return (
+						<>
+							<dl className="divide-border divide-y rounded-lg border text-sm">
+								<div className="flex justify-between px-4 py-3">
+									<dt className="text-muted-foreground">{t('onboarding.review.connectionMode')}</dt>
+									{/* Canonical enum-label pattern: t(`enums.<Enum>.${value}`) */}
+									<dd className="font-medium">{t(`enums.ConnectionMode.${connectionMode}`)}</dd>
+								</div>
+								<div className="flex justify-between px-4 py-3">
+									<dt className="text-muted-foreground">{t('onboarding.review.platform')}</dt>
+									<dd className="font-medium">{t(PLATFORM_NAME_KEYS[platform])}</dd>
+								</div>
+								{type && (
+									<div className="flex justify-between px-4 py-3">
+										<dt className="text-muted-foreground">{t('onboarding.review.integrationType')}</dt>
+										<dd className="font-medium">{t(`enums.StoreIntegrationType.${type}`)}</dd>
+									</div>
+								)}
+								{credentialEntries.length > 0
+									? credentialEntries.map(([key, value]) => (
+											<div key={key} className="flex justify-between px-4 py-3">
+												<dt className="text-muted-foreground">
+													{CREDENTIAL_FIELD_LABEL_KEYS[key] ? t(CREDENTIAL_FIELD_LABEL_KEYS[key]) : key}
+												</dt>
+												<dd className="font-mono text-xs font-medium">
+													{SECRET_FIELDS.has(key) ? '••••••••' : value}
+												</dd>
+											</div>
+										))
+									: connectionMode === ConnectionModeEnum.MANUAL && (
+											<div className="px-4 py-3">
+												<dd className="text-muted-foreground">{t('onboarding.review.noCredentials')}</dd>
+											</div>
+										)}
+							</dl>
+
+							<div className="flex justify-between">
+								<div>
+									{onBack && (
+										<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+											<IconArrowLeft className="mr-1 size-4" />
+											{t('common.back')}
+										</Button>
+									)}
+								</div>
+								<Button type="button" disabled={!isValid || isSubmitting} onClick={onSubmit}>
+									{isSubmitting && <Spinner className="mr-2" />}
+									{t('onboarding.review.submit')}
+								</Button>
+							</div>
+						</>
+					)
+				}}
+			</form.Subscribe>
+		</div>
+	)
+}
