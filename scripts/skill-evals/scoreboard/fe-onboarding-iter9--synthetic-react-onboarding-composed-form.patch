+import { type ComponentProps } from 'react'
+import { useForm } from '@tanstack/react-form'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import { type ConnectionMode, type StoreIntegrationType } from '@template/client-typescript/typescript'
+import { IconArrowRight, IconArrowLeft } from '@tabler/icons-react'
+import { useTranslation } from 'react-i18next'
+import { cn } from '@/lib/utils'
+import type { WizardPlatform } from '../ConnectWizard'
+
+export interface TargetStepData {
+	platform: WizardPlatform
+	type: StoreIntegrationType
+	connectionMode: ConnectionMode
+}
+
+// Each onboarding target is a valid (type, platform, connectionMode) discriminant tuple.
+export const ONBOARDING_TARGETS = [
+	{ platform: 'SHOPIFY' as const, type: 'SALES_CHANNEL' as const, connectionMode: 'CREDENTIALS' as const },
+	{ platform: 'YAMPI' as const, type: 'CHECKOUT' as const, connectionMode: 'CREDENTIALS' as const },
+	{ platform: 'META' as const, type: 'MARKETING_PLATFORM' as const, connectionMode: 'MANUAL' as const },
+	{ platform: 'MERCADOPAGO' as const, type: 'PAYMENT_GATEWAY' as const, connectionMode: 'MANUAL' as const },
+] satisfies readonly TargetStepData[]
+
+interface TargetStepProps extends Omit<ComponentProps<'form'>, 'onSubmit'> {
+	mode: ConnectionMode
+	defaultPlatform?: WizardPlatform
+	onSubmit: (data: TargetStepData) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+export function TargetStep({ mode, defaultPlatform, onSubmit, onBack, isSubmitting, className, ...props }: TargetStepProps) {
+	const { t } = useTranslation()
+
+	const form = useForm({
+		defaultValues: { platform: defaultPlatform as WizardPlatform | undefined },
+		onSubmit: async ({ value }) => {
+			const target = ONBOARDING_TARGETS.find(target => target.platform === value.platform && target.connectionMode === mode)
+			if (!target) return
+			onSubmit(target)
+		},
+	})
+
+	const visibleTargets = ONBOARDING_TARGETS.filter(target => target.connectionMode === mode)
+
+	// Static label map — no template-literal interpolation; all keys are typed literals.
+	const PLATFORM_LABELS: Record<WizardPlatform, { name: string; description: string }> = {
+		SHOPIFY: {
+			name: t('onboarding.targets.SHOPIFY.name'),
+			description: t('onboarding.targets.SHOPIFY.description'),
+		},
+		YAMPI: {
+			name: t('onboarding.targets.YAMPI.name'),
+			description: t('onboarding.targets.YAMPI.description'),
+		},
+		META: {
+			name: t('onboarding.targets.META.name'),
+			description: t('onboarding.targets.META.description'),
+		},
+		MERCADOPAGO: {
+			name: t('onboarding.targets.MERCADOPAGO.name'),
+			description: t('onboarding.targets.MERCADOPAGO.description'),
+		},
+	}
+
+	return (
+		<form
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+			className={cn('flex flex-col gap-6 p-6', className)}
+			{...props}
+		>
+			<div className="text-center">
+				<h2 className="text-2xl font-semibold tracking-tight">{t('onboarding.target.title')}</h2>
+				<p className="text-muted-foreground mt-2">{t('onboarding.target.subtitle')}</p>
+			</div>
+
+			<form.Field name="platform">
+				{field => (
+					<div className="flex flex-col gap-3" role="radiogroup" aria-label={t('onboarding.target.title')}>
+						{visibleTargets.map(target => (
+							<button
+								key={target.platform}
+								type="button"
+								role="radio"
+								aria-checked={field.state.value === target.platform}
+								onClick={() => field.handleChange(target.platform)}
+								className={cn(
+									'flex flex-col items-start gap-1 rounded-lg border p-4 text-left transition-colors hover:bg-accent',
+									field.state.value === target.platform ? 'border-primary bg-primary/5' : 'border-border',
+								)}
+							>
+								<span className="font-medium">{PLATFORM_LABELS[target.platform].name}</span>
+								<span className="text-muted-foreground text-sm">{PLATFORM_LABELS[target.platform].description}</span>
+							</button>
+						))}
+					</div>
+				)}
+			</form.Field>
+
+			<form.Subscribe selector={s => s.values.platform}>
+				{selectedPlatform => (
+					<div className="flex justify-between">
+						<div>
+							{onBack && (
+								<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+									<IconArrowLeft className="mr-1 size-4" />
+									{t('common.back')}
+								</Button>
+							)}
+						</div>
+						<Button type="submit" disabled={!selectedPlatform || isSubmitting}>
+							{isSubmitting && <Spinner className="mr-2" />}
+							{t('common.next')}
+							<IconArrowRight className="ml-1 size-4" />
+						</Button>
+					</div>
+				)}
+			</form.Subscribe>
+		</form>
+	)
+}
