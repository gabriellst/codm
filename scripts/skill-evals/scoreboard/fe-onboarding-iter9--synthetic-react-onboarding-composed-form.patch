diff --git a/packages/app/react/src/routes/onboarding/-components/ConnectWizard/index.tsx b/packages/app/react/src/routes/onboarding/-components/ConnectWizard/index.tsx
new file mode 100644
index 000000000..f78859cfd
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/ConnectWizard/index.tsx
@@ -0,0 +1,193 @@
+// SEEDED CANONICAL SPINE — complete the TODOs; do NOT rewrite or delete this file.
+// The _infer typing, sequence Record, setFieldValue merging and pickUnionVariant gate
+// are the measured-canonical machinery (form FRM-P13/15/18/43).
+import { type ComponentProps, type ReactNode } from 'react'
+import { useForm } from '@tanstack/react-form'
+import { useNavigate } from '@tanstack/react-router'
+import { toast } from 'sonner'
+import { useQueryClient } from '@tanstack/react-query'
+import {
+	connectIntegrationMutationRequestSchema,
+	ConnectionModeEnum,
+	type ConnectionMode,
+	useConnectIntegration,
+	listPlatformDescriptorsQueryKey,
+} from '@template/client-typescript/typescript'
+import type { DeepPartial } from '@/lib'
+import { pickUnionVariant } from '@/lib/union'
+import { cn } from '@/lib/utils'
+import { useTranslation } from 'react-i18next'
+import { useConnectWizardStore, type WizardPlatform } from '../../-stores/useConnectWizardStore'
+export type { WizardPlatform }
+import { ConnectionModeStep, type ConnectionModeStepData } from '../ConnectionModeStep'
+import { TargetStep, type TargetStepData } from '../TargetStep'
+import { ShopifyCredentialsStep, type ShopifyCredentials } from '../ShopifyCredentialsStep'
+import { YampiCredentialsStep, type YampiCredentials } from '../YampiCredentialsStep'
+import { ReviewStep } from '../ReviewStep'
+
+// ─── Step sequences — const-asserted tuples in an enum-keyed map (FRM-P13) ──────────────
+const CREDENTIALS_STEPS = ['CONNECTION_MODE', 'TARGET', 'CREDENTIALS', 'REVIEW'] as const
+const MANUAL_STEPS = ['CONNECTION_MODE', 'TARGET', 'REVIEW'] as const
+
+export type ConnectStepId = (typeof CREDENTIALS_STEPS)[number] | (typeof MANUAL_STEPS)[number]
+
+const STEP_SEQUENCES: Record<ConnectionMode, readonly ConnectStepId[]> = {
+	[ConnectionModeEnum.CREDENTIALS]: CREDENTIALS_STEPS,
+	[ConnectionModeEnum.MANUAL]: MANUAL_STEPS,
+	[ConnectionModeEnum.OAUTH]: CREDENTIALS_STEPS,
+}
+
+// ─── The accumulated-form typing trick (FRM-P18) ─────────────────────────────────────────
+// An UNCALLED function wrapping useForm: its ReturnType IS the typed form instance —
+// never hand-write an interface of field names. defaultValues uses the union's
+// DeepPartial so steps can merge incrementally without the Partial<Union> fight.
+function _inferConnectForm() {
+	return useForm({
+		defaultValues: {} as DeepPartial<(typeof connectIntegrationMutationRequestSchema)['_zod']['output']>,
+	})
+}
+export type ConnectForm = ReturnType<typeof _inferConnectForm>
+
+type ConnectAccumulated = DeepPartial<(typeof connectIntegrationMutationRequestSchema)['_zod']['output']>
+
+export function ConnectWizard({ className, ...props }: ComponentProps<'main'>) {
+	const { t } = useTranslation()
+	const navigate = useNavigate()
+	const queryClient = useQueryClient()
+
+	const mode = useConnectWizardStore(s => s.mode)
+	const platform = useConnectWizardStore(s => s.platform)
+	const type = useConnectWizardStore(s => s.type)
+	const stepIndex = useConnectWizardStore(s => s.stepIndex)
+	const setMode = useConnectWizardStore(s => s.setMode)
+	const setPlatformTarget = useConnectWizardStore(s => s.setPlatformTarget)
+	const setStepIndex = useConnectWizardStore(s => s.setStepIndex)
+	const reset = useConnectWizardStore(s => s.reset)
+
+	const form = _inferConnectForm()
+	const sequence = STEP_SEQUENCES[mode]
+	const stepId = sequence[stepIndex] ?? sequence[0]
+
+	const connect = useConnectIntegration({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('integrations.sheet.connectSuccess'))
+				queryClient.invalidateQueries({ queryKey: listPlatformDescriptorsQueryKey() })
+				reset()
+				// String() call infers as `string` (not the literal) so navigate uses
+				// the untyped overload and validateSearch defaults kick in automatically.
+				const appHome = String('/dashboard')
+				void navigate({ to: appHome })
+			},
+		},
+	})
+
+	// Merges step output into the accumulated form (FRM-P15) and advances the sequence.
+	function advance() {
+		if (stepIndex < sequence.length - 1) setStepIndex(stepIndex + 1)
+	}
+
+	function handleBack() {
+		setStepIndex(Math.max(0, stepIndex - 1))
+	}
+
+	// OAUTH uses CREDENTIALS steps at runtime but has no union member in the schema —
+	// exclude it so setFieldValue / pickUnionVariant see only the schema-valid modes.
+	type WizardConnectionMode = Exclude<ConnectionMode, 'OAUTH'>
+
+	function handleConnectionModeSubmit(data: ConnectionModeStepData) {
+		setMode(data.connectionMode)
+		form.setFieldValue('connectionMode', data.connectionMode as WizardConnectionMode)
+		advance()
+	}
+
+	function handleTargetSubmit(data: TargetStepData) {
+		setPlatformTarget(data.platform, data.type)
+		form.setFieldValue('connectionMode', data.connectionMode as WizardConnectionMode)
+		form.setFieldValue('platform', data.platform)
+		form.setFieldValue('type', data.type)
+		advance()
+	}
+
+	function handleCredentialsSubmit(data: ShopifyCredentials | YampiCredentials) {
+		form.setFieldValue('credentials', data as ConnectAccumulated['credentials'])
+		advance()
+	}
+
+	// Final submission gates through the union variant matched by current wizard state (FRM-P43):
+	// pickUnionVariant selects the exact member, then safeParse validates the accumulated values.
+	function handleFinish() {
+		if (!platform) return
+		const payload = form.state.values
+		const variant = pickUnionVariant(connectIntegrationMutationRequestSchema, { connectionMode: mode as WizardConnectionMode, platform })
+		const result = variant.safeParse(payload)
+		if (!result.success) return
+		connect.mutate({ data: result.data as (typeof connectIntegrationMutationRequestSchema)['_zod']['output'] })
+	}
+
+	// Credentials dispatch by platform map — never a switch chain (CMP-P18).
+	const CREDENTIALS_BY_PLATFORM: Record<WizardPlatform, ReactNode> = {
+		SHOPIFY: (
+			<ShopifyCredentialsStep
+				onSubmit={handleCredentialsSubmit}
+				onBack={handleBack}
+				isSubmitting={connect.isPending}
+			/>
+		),
+		YAMPI: (
+			<YampiCredentialsStep
+				onSubmit={handleCredentialsSubmit}
+				onBack={handleBack}
+				isSubmitting={connect.isPending}
+			/>
+		),
+		META: null,
+		MERCADOPAGO: null,
+	}
+
+	// Step dispatch by map — never a switch chain (CMP-P18). The review step receives
+	// the typed parent form for live accumulated-value display (FRM-P18).
+	const STEP_COMPONENTS: Record<ConnectStepId, ReactNode> = {
+		CONNECTION_MODE: (
+			<ConnectionModeStep
+				defaultValues={{ connectionMode: mode }}
+				onSubmit={handleConnectionModeSubmit}
+			/>
+		),
+		TARGET: (
+			<TargetStep
+				mode={mode}
+				defaultPlatform={platform}
+				onSubmit={handleTargetSubmit}
+				onBack={handleBack}
+			/>
+		),
+		CREDENTIALS: platform ? CREDENTIALS_BY_PLATFORM[platform] : null,
+		REVIEW: platform ? (
+			<ReviewStep
+				form={form}
+				platform={platform}
+				type={type}
+				connectionMode={mode}
+				onSubmit={handleFinish}
+				onBack={handleBack}
+				isSubmitting={connect.isPending}
+			/>
+		) : null,
+	}
+
+	const total = sequence.length
+	const current = stepIndex + 1
+
+	return (
+		<main className={cn('flex min-h-dvh flex-col items-center justify-center', className)} {...props}>
+			<div className="w-full max-w-md rounded-xl border bg-card shadow-sm">
+				<div className="border-b px-6 py-4">
+					<h1 className="text-lg font-semibold">{t('onboarding.title')}</h1>
+					<p className="text-muted-foreground text-sm">{t('onboarding.stepOf', { current, total })}</p>
+				</div>
+				{STEP_COMPONENTS[stepId]}
+			</div>
+		</main>
+	)
+}
diff --git a/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx b/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx
new file mode 100644
index 000000000..c6af697ec
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx
@@ -0,0 +1,121 @@
+import { type ComponentProps } from 'react'
+import { z } from 'zod/v4'
+import { useForm } from '@tanstack/react-form'
+import { Button } from '@/components/ui/button'
+import { Field, FieldError, FieldGroup, FieldLabel } from '@/components/ui/field'
+import { ToggleGroup } from '@/components/ui/toggle-group'
+import { Spinner } from '@/components/ui/spinner'
+import { type DeepPartial } from '@/lib'
+import { ConnectionModeEnum, type ConnectionMode } from '@template/client-typescript/typescript'
+import { unionVariantValues } from '@/lib/union'
+import { connectIntegrationMutationRequestSchema } from '@template/client-typescript/typescript'
+import { IconArrowRight, IconArrowLeft } from '@tabler/icons-react'
+import { useTranslation } from 'react-i18next'
+import { cn } from '@/lib/utils'
+
+// Derive the valid connection modes from the SDK union (CREDENTIALS | MANUAL) — avoids
+// hand-rolling the enum and stays in sync with the contract automatically.
+const WIZARD_MODES = unionVariantValues(connectIntegrationMutationRequestSchema, 'connectionMode') as [ConnectionMode, ...ConnectionMode[]]
+
+export const ConnectionModeStepSchema = z.object({
+	connectionMode: z.enum(WIZARD_MODES),
+})
+
+export type ConnectionModeStepData = (typeof ConnectionModeStepSchema)['_zod']['output'] & {
+	connectionMode: ConnectionMode
+}
+
+interface ConnectionModeStepProps extends Omit<ComponentProps<'form'>, 'onSubmit'> {
+	defaultValues?: DeepPartial<ConnectionModeStepData>
+	onSubmit: (data: ConnectionModeStepData) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+// Enum-mode ToggleGroup needs a Record<string,string>; we expose only the wizard-relevant modes.
+const WIZARD_CONNECTION_MODE_ENUM = {
+	CREDENTIALS: ConnectionModeEnum.CREDENTIALS,
+	MANUAL: ConnectionModeEnum.MANUAL,
+} as const
+
+export function ConnectionModeStep({ defaultValues, onSubmit, onBack, isSubmitting, className, ...props }: ConnectionModeStepProps) {
+	const { t } = useTranslation()
+
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: ConnectionModeStepSchema },
+		onSubmit: async form => {
+			const result = ConnectionModeStepSchema.safeParse(form.value)
+			if (!result.success) return
+			onSubmit(result.data as ConnectionModeStepData)
+		},
+	})
+
+	return (
+		<form
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+			className={cn('flex flex-col gap-6 p-6', className)}
+			{...props}
+		>
+			<div className="text-center">
+				<h2 className="text-2xl font-semibold tracking-tight">{t('onboarding.connectionMode.title')}</h2>
+				<p className="text-muted-foreground mt-2">{t('onboarding.connectionMode.subtitle')}</p>
+			</div>
+
+			<FieldGroup>
+				<form.Field name="connectionMode">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name} className="sr-only">
+									{t('onboarding.connectionMode.title')}
+								</FieldLabel>
+								<ToggleGroup
+									enum={WIZARD_CONNECTION_MODE_ENUM}
+									i18nPrefix="enums.ConnectionMode"
+									value={field.state.value as 'CREDENTIALS' | 'MANUAL' | undefined}
+									onValueChange={v => field.handleChange(v as ConnectionMode)}
+									id={field.name}
+									aria-invalid={isInvalid}
+									orientation="vertical"
+									className="w-full"
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+			</FieldGroup>
+
+			<form.Subscribe selector={state => ({ canSubmit: state.canSubmit, values: state.values })}>
+				{({ canSubmit, values }) => {
+					const isDisabled = isSubmitting || !canSubmit || !ConnectionModeStepSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<div>
+								{onBack && (
+									<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+										<IconArrowLeft className="mr-1 size-4" />
+										{t('common.back')}
+									</Button>
+								)}
+							</div>
+							<div className="flex gap-2">
+								<Button type="submit" disabled={isDisabled}>
+									{isSubmitting && <Spinner className="mr-2" />}
+									{t('common.next')}
+									<IconArrowRight className="ml-1 size-4" />
+								</Button>
+							</div>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
