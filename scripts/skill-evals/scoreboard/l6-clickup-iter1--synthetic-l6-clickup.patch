+import { HttpStatusCode, registerErrorCodes } from '@template/core-typescript'
+import type { BaseDomainErrors, BaseApplicationErrors } from '@template/core-typescript'
+
+export type TaskDomainErrors = 'INVALID_TASK_STATUS'
+export type DomainErrors = BaseDomainErrors | TaskDomainErrors
+
+export type TaskApplicationErrors =
+	| 'TASK_NOT_FOUND'
+	| 'SPACE_NOT_FOUND'
+	| 'LIST_NOT_FOUND'
+export type ApplicationErrors = BaseApplicationErrors | TaskApplicationErrors
