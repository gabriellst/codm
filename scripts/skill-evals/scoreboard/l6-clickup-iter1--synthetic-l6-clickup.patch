--- /dev/null
+++ b/packages/api/typescript/src/workspace/repositories/SpaceListRepository/DrizzleSpaceListRepository.ts
@@ -0,0 +1,96 @@
+import { injectable } from 'tsyringe-neo'
+import { asc, eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { spaceLists } from '@template/contracts/db'
+import { SpaceList, SpaceListSchema } from '../../entities/SpaceList'
+import { SpaceListRepository } from './SpaceListRepository'
+
+@injectable()
+export class DrizzleSpaceListRepository extends SpaceListRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<SpaceList | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(spaceLists).where(eq(spaceLists.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async findAllBySpaceId(spaceId: string, tx?: DrizzleClient): Promise<SpaceList[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			return dbc
+				.select()
+				.from(spaceLists)
+				.where(eq(spaceLists.spaceId, spaceId))
+				.orderBy(asc(spaceLists.position))
+		})
+		if (!result.success || !result.data) return []
+		return result.data.map(row => this.toDomain(row))
+	}
+
+	async save(entity: SpaceList, tx?: DrizzleClient): Promise<SpaceList> {
+		entity.incrementVersion()
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+			await dbc
+				.insert(spaceLists)
+				.values(data)
+				.onConflictDoUpdate({
+					target: spaceLists.id,
+					set: {
+						name: data.name,
+						position: data.position,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc.delete(spaceLists).where(eq(spaceLists.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: typeof spaceLists.$inferSelect): SpaceList {
+		const parsed = SpaceListSchema.parse({
+			name: row.name,
+			spaceId: row.spaceId,
+			workspaceId: row.workspaceId,
+			position: row.position,
+		})
+		return new SpaceList({
+			...parsed,
