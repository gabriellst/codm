+import type { ComponentProps } from 'react'
+import { useQueryClient } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+import {
+	useGetListView,
+	getListViewQueryKey,
+} from '@template/client-typescript/typescript'
+import { cn } from '@/lib/utils'
+import { useServerEvents } from '@/hooks'
+import { useDialogStore } from '@/stores/useDialogStore'
+import { CreateTaskDialog } from './CreateTaskDialog'
+
+interface Props extends ComponentProps<'div'> {
+	workspaceId: string
+	spaceId: string
+}
+
+export function SpaceListViewSection({ workspaceId, spaceId, className, ...props }: Props) {
+	const { t } = useTranslation()
+	const queryClient = useQueryClient()
+	const { data } = useGetListView(workspaceId, spaceId)
+
+	useServerEvents('integration.shared.task.status_changed', event => {
+		if (event.payload.workspaceId !== workspaceId) return
+		queryClient.invalidateQueries({ queryKey: getListViewQueryKey(workspaceId, spaceId) })
+	})
+
+	return (
+		<div className={cn('flex flex-col gap-6', className)} {...props}>
+			{data?.lists.map(list => (
+				<div key={list.listId}>
+					<div className="flex items-center justify-between mb-2">
+						<h2 className="text-lg font-semibold">{list.listName}</h2>
+						<button
+							type="button"
+							onClick={() => {
+								useDialogStore.getState().show(
+									<CreateTaskDialog
+										workspaceId={workspaceId}
+										spaceId={spaceId}
+										listId={list.listId}
+									/>,
+								)
+							}}
+						>
+							{t('clickup.spaceView.addTask')}
+						</button>
+					</div>
+					<div className="flex flex-col gap-2">
+						{list.tasks.map(task => (
+							<TaskRow key={task.taskId} task={task} />
+						))}
+					</div>
+				</div>
+			))}
+		</div>
+	)
+}
+
+interface TaskRowProps {
+	task: {
+		taskId: string
+		title: string
+		status: string
+		priority: string
+		assigneeIds: string[]
+	}
+}
+
+function TaskRow({ task }: TaskRowProps) {
+	const { t } = useTranslation()
+	return (
+		<div className="border rounded p-3 flex items-center gap-3">
+			<span className="text-sm font-medium flex-1">{task.title}</span>
+			<span className="text-xs text-muted-foreground">{t(`enums.TaskStatus.${task.status}`)}</span>
+			<span className="text-xs text-muted-foreground">{t(`enums.TaskPriority.${task.priority}`)}</span>
+		</div>
+	)
+}
