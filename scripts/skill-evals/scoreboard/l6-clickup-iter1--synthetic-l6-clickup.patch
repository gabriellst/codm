index 000000000..8db08c83a
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/workspaces/$workspaceId/spaces/$spaceId/-components/CreateTaskDialog.tsx
@@ -0,0 +1,115 @@
+import { useQueryClient } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+import { useForm } from '@tanstack/react-form'
+import {
+	useCreateTask,
+	createTaskMutationRequestSchema,
+	getListViewQueryKey,
+	getBoardViewQueryKey,
+	type CreateTaskMutationRequest,
+} from '@template/client-typescript/typescript'
+import type { DeepPartial } from '@/lib'
+import { useDialogStore } from '@/stores/useDialogStore'
+import { Field, FieldError, FieldLabel } from '@/components/ui/field'
+import { Input } from '@/components/ui/input'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import { DialogContent, DialogFooter, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+
+interface Props {
+	workspaceId: string
+	spaceId: string
+	listId: string
+}
+
+export function CreateTaskDialog({ workspaceId, spaceId, listId }: Props) {
+	const { t } = useTranslation()
+	const queryClient = useQueryClient()
+	const hide = useDialogStore(s => s.hide)
+	const { mutateAsync, isPending } = useCreateTask()
+
+	const defaultValues: DeepPartial<CreateTaskMutationRequest> = {
+		title: '',
+		description: '',
+	}
+
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: createTaskMutationRequestSchema },
+		onSubmit: async ({ value }) => {
+			const result = createTaskMutationRequestSchema.safeParse(value)
+			if (!result.success) return
+			await mutateAsync({ workspaceId, spaceId, listId, data: result.data })
+			await queryClient.invalidateQueries({ queryKey: getListViewQueryKey(workspaceId, spaceId) })
+			await queryClient.invalidateQueries({ queryKey: getBoardViewQueryKey(workspaceId, spaceId) })
+			hide()
+		},
+	})
+
+	return (
+		<DialogContent>
+			<DialogHeader>
+				<DialogTitle>{t('clickup.createTask.title')}</DialogTitle>
+			</DialogHeader>
+			<form
+				noValidate
+				onSubmit={e => {
+					e.preventDefault()
+					e.stopPropagation()
+					form.handleSubmit()
+				}}
+			>
+				<div className="flex flex-col gap-4 py-2">
+					<form.Field name="title">
+						{field => {
+							const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+							return (
+								<Field>
+									<FieldLabel htmlFor={field.name}>
+										{t('clickup.createTask.titleLabel')}
+									</FieldLabel>
+									<Input
+										id={field.name}
+										value={field.state.value ?? ''}
+										onChange={e => field.handleChange(e.target.value)}
+										placeholder={t('clickup.createTask.titlePlaceholder')}
+										aria-invalid={isInvalid}
+									/>
+									{isInvalid && <FieldError errors={field.state.meta.errors} />}
+								</Field>
+							)
+						}}
+					</form.Field>
+
+					<form.Field name="description">
+						{field => {
+							const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+							return (
+								<Field>
+									<FieldLabel htmlFor={field.name}>
+										{t('clickup.createTask.descriptionLabel')}
+									</FieldLabel>
+									<Input
+										id={field.name}
+										value={field.state.value ?? ''}
+										onChange={e => field.handleChange(e.target.value)}
+										placeholder={t('clickup.createTask.descriptionPlaceholder')}
+										aria-invalid={isInvalid}
+									/>
+									{isInvalid && <FieldError errors={field.state.meta.errors} />}
+								</Field>
+							)
+						}}
+					</form.Field>
+				</div>
+
+				<DialogFooter>
+					<Button type="submit" disabled={isPending}>
+						{isPending ? <Spinner /> : null}
+						{t('clickup.createTask.submit')}
+					</Button>
+				</DialogFooter>
+			</form>
+		</DialogContent>
+	)
+}
