+import type { ComponentProps } from 'react'
+import { useQueryClient } from '@tanstack/react-query'
+import {
+	useGetBoardView,
+	getBoardViewQueryKey,
+} from '@template/client-typescript/typescript'
+import { cn } from '@/lib/utils'
+import { useServerEvents } from '@/hooks'
+import { useTranslation } from 'react-i18next'
+
+interface Props extends ComponentProps<'div'> {
+	workspaceId: string
+	spaceId: string
+}
+
+export function SpaceBoardViewSection({ workspaceId, spaceId, className, ...props }: Props) {
+	const queryClient = useQueryClient()
+	const { data } = useGetBoardView(workspaceId, spaceId)
+
+	useServerEvents('integration.shared.task.status_changed', event => {
+		if (event.payload.workspaceId !== workspaceId) return
+		queryClient.invalidateQueries({ queryKey: getBoardViewQueryKey(workspaceId, spaceId) })
+	})
+
+	return (
+		<div className={cn('flex gap-4 overflow-x-auto', className)} {...props}>
+			{data?.columns.map(col => (
+				<BoardColumn key={col.status} col={col} />
+			))}
+		</div>
+	)
+}
+
+interface BoardColumnProps {
+	col: {
+		status: string
+		tasks: Array<{
+			taskId: string
+			title: string
+			priority: string
+			assigneeIds: string[]
+			listId: string
+		}>
+	}
+}
+
+function BoardColumn({ col }: BoardColumnProps) {
+	const { t } = useTranslation()
+	return (
+		<div
+			className="flex flex-col gap-2 min-w-[250px]"
+			data-testid={`board-column-${col.status}`}
+		>
+			<h3 className="text-sm font-semibold uppercase">{t(`enums.TaskStatus.${col.status}`)}</h3>
+			{col.tasks.map(task => (
+				<div
+					key={task.taskId}
+					className="border rounded p-3"
+					data-testid={`task-card-${task.taskId}`}
+				>
+					<span className="text-sm font-medium">{task.title}</span>
+					<span className="text-xs text-muted-foreground ml-2">
+						{t(`enums.TaskPriority.${task.priority}`)}
+					</span>
+				</div>
+			))}
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/(app)/workspaces/$workspaceId/spaces/$spaceId/-components/SpaceListViewSection.tsx b/packages/app/react/src/routes/(app)/workspaces/$workspaceId/spaces/$spaceId/-components/SpaceListViewSection.tsx
