+import type { ComponentProps } from 'react'
+import { useNavigate } from '@tanstack/react-router'
+import { useTranslation } from 'react-i18next'
+import { cn } from '@/lib/utils'
+import { Route } from '../index'
+
+export function ViewToggle({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { view } = Route.useSearch()
+	const navigate = useNavigate({ from: Route.fullPath })
+
+	return (
+		<div className={cn('flex gap-2', className)} {...props}>
+			<button
+				type="button"
+				onClick={() => navigate({ search: prev => ({ ...prev, view: 'list' as const }) })}
+				aria-pressed={view === 'list'}
+				className={view === 'list' ? 'font-semibold underline' : ''}
+			>
+				{t('clickup.spaceView.listView')}
+			</button>
+			<button
+				type="button"
+				onClick={() => navigate({ search: prev => ({ ...prev, view: 'board' as const }) })}
+				aria-pressed={view === 'board'}
+				className={view === 'board' ? 'font-semibold underline' : ''}
+			>
+				{t('clickup.spaceView.boardView')}
+			</button>
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/(app)/workspaces/$workspaceId/spaces/$spaceId/index.tsx b/packages/app/react/src/routes/(app)/workspaces/$workspaceId/spaces/$spaceId/index.tsx
