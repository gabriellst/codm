+import { Repository, DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { tasks } from '@template/contracts/db'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { Task, TaskSchema } from '../entities/Task'
+
+// ─── Abstract interface ───────────────────────────────────────────────────────
+
+export abstract class TaskRepository extends Repository<Task> {
+	abstract findById(id: string, tx?: Transaction): Promise<Task | undefined>
+	abstract findAllBySpaceId(spaceId: string, tx?: Transaction): Promise<Task[]>
+	abstract findAllByListId(listId: string, tx?: Transaction): Promise<Task[]>
+}
+
+// ─── Drizzle implementation ───────────────────────────────────────────────────
+
+@injectable()
+export class DrizzleTaskRepository extends TaskRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<Task | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(tasks).where(eq(tasks.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async findAllBySpaceId(spaceId: string, tx?: DrizzleClient): Promise<Task[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			return dbc.select().from(tasks).where(eq(tasks.spaceId, spaceId))
+		})
+		if (!result.success || !result.data) return []
+		return result.data.map(row => this.toDomain(row))
+	}
+
+	async findAllByListId(listId: string, tx?: DrizzleClient): Promise<Task[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			return dbc.select().from(tasks).where(eq(tasks.listId, listId))
+		})
+		if (!result.success || !result.data) return []
+		return result.data.map(row => this.toDomain(row))
+	}
+
+	async save(entity: Task, tx?: DrizzleClient): Promise<Task> {
+		entity.incrementVersion()
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+			await dbc
+				.insert(tasks)
+				.values(data)
+				.onConflictDoUpdate({
+					target: tasks.id,
+					set: {
+						title: data.title,
+						description: data.description,
+						status: data.status,
+						priority: data.priority,
+						assigneeIds: data.assigneeIds,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc.delete(tasks).where(eq(tasks.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: typeof tasks.$inferSelect): Task {
+		const parsed = TaskSchema.parse({
+			workspaceId: row.workspaceId,
+			spaceId: row.spaceId,
+			listId: row.listId,
+			title: row.title,
+			description: row.description ?? undefined,
+			status: row.status as TaskStatus,
+			priority: row.priority as TaskPriority,
+			assigneeIds: (row.assigneeIds as string[]) ?? [],
+		})
+		return new Task({
+			...parsed,
+			id: row.id,
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: Task): typeof tasks.$inferInsert {
+		return {
+			id: entity.id.value,
+			workspaceId: entity.workspaceId,
+			spaceId: entity.spaceId,
+			listId: entity.listId,
+			title: entity.title,
+			description: entity.description ?? null,
+			status: entity.status,
+			priority: entity.priority,
+			assigneeIds: entity.assigneeIds,
+			createdAt: entity.createdAt,
+			updatedAt: entity.updatedAt,
+			version: entity.version,
+		}
+	}
+}
+
+// ─── Mock implementation ──────────────────────────────────────────────────────
+
+@injectable()
+export class MockTaskRepository extends TaskRepository {
+	private store = new Map<string, Task>()
+
+	async findById(id: string, _tx?: Transaction): Promise<Task | undefined> {
+		return this.store.get(id)
+	}
+
+	async findAllBySpaceId(spaceId: string, _tx?: Transaction): Promise<Task[]> {
+		return Array.from(this.store.values()).filter(t => t.spaceId === spaceId)
+	}
+
+	async findAllByListId(listId: string, _tx?: Transaction): Promise<Task[]> {
+		return Array.from(this.store.values()).filter(t => t.listId === listId)
+	}
+
+	async save(entity: Task, _tx?: Transaction): Promise<Task> {
+		this.store.set(entity.id.value, entity)
+		return entity
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.store.delete(id)
+	}
+
+	seed(task: Task): void {
+		this.store.set(task.id.value, task)
+	}
+
+	clear(): void {
+		this.store.clear()
+	}
+}
