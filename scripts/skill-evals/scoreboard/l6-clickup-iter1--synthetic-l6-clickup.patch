@@ -0,0 +1,65 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { Handler, z, DrizzleClient } from '@template/core-typescript'
+import { taskBoardViewEntries } from '@template/contracts/db'
+
+export const BoardTaskItemSchema = z.object({
+	taskId: z.uuid(),
+	title: z.string(),
+	priority: z.string(),
+	assigneeIds: z.array(z.uuid()),
+	listId: z.uuid(),
+})
+
+export const StatusColumnSchema = z.object({
+	status: z.string(),
+	tasks: z.array(BoardTaskItemSchema),
+})
+
+export const GetBoardViewInputSchema = z.object({
+	spaceId: z.uuid(),
+	workspaceId: z.uuid(),
+})
+
+export const GetBoardViewOutputSchema = z.object({
+	columns: z.array(StatusColumnSchema),
+})
+
+// The canonical status order for board columns
+const STATUS_ORDER = ['TODO', 'IN_PROGRESS', 'IN_REVIEW', 'DONE']
+
+@injectable()
+export class GetBoardView extends Handler<typeof GetBoardViewInputSchema, typeof GetBoardViewOutputSchema> {
+	readonly name = 'get_board_view' as const
+	readonly inputSchema = GetBoardViewInputSchema
+	readonly outputSchema = GetBoardViewOutputSchema
+
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const entries = await this.db
+			.select()
+			.from(taskBoardViewEntries)
+			.where(eq(taskBoardViewEntries.spaceId, input.spaceId))
+
+		const columnMap = new Map<string, Array<{ taskId: string; title: string; priority: string; assigneeIds: string[]; listId: string }>>()
+		for (const status of STATUS_ORDER) columnMap.set(status, [])
+
+		for (const entry of entries) {
+			const col = entry.statusColumn
+			if (!columnMap.has(col)) columnMap.set(col, [])
+			columnMap.get(col)!.push({
+				taskId: entry.taskId,
+				title: entry.title,
+				priority: entry.priority,
+				assigneeIds: (entry.assigneeIds as string[]) ?? [],
+				listId: entry.listId,
+			})
+		}
+
+		const columns = [...columnMap.entries()].map(([status, tasks]) => ({ status, tasks }))
+		return { columns }
+	}
+}
