+import { injectable } from 'tsyringe-neo'
+import { Handler, BaseError, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import type { ApplicationErrors } from '../errors'
+import { SpaceList } from '../entities/SpaceList'
+import { SpaceRepository } from '../repositories/SpaceRepository'
+import { SpaceListRepository } from '../repositories/SpaceListRepository'
+import { SpaceListCreatedEvent } from '../events/SpaceListCreatedEvent'
+
+export const CreateListInputSchema = z.object({
+	spaceId: z.uuid(),
+	workspaceId: z.uuid(),
+	name: z.string().min(1).max(120),
+	position: z.number().int().min(0).optional(),
+	userId: z.uuid(),
+})
+
+export const CreateListOutputSchema = z.object({
+	listId: z.uuid(),
+})
+
+@injectable()
+export class CreateList extends Handler<typeof CreateListInputSchema, typeof CreateListOutputSchema> {
+	readonly name = 'create_list' as const
+	readonly inputSchema = CreateListInputSchema
+	readonly outputSchema = CreateListOutputSchema
+
+	constructor(
+		private readonly spaceRepo: SpaceRepository,
+		private readonly listRepo: SpaceListRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const space = await this.spaceRepo.findById(input.spaceId, tx)
+			if (!space) throw new BaseError<ApplicationErrors>('SPACE_NOT_FOUND')
+			const list = SpaceList.create({
+				name: input.name,
+				spaceId: input.spaceId,
+				workspaceId: input.workspaceId,
+				position: input.position ?? 0,
+			})
+			await this.listRepo.save(list, tx)
+			await this.domainEventRepository.saveMany(
+				[
+					new SpaceListCreatedEvent({
+						entityId: list.id.value,
+						ownerId: input.userId,
+						payload: {
+							spaceListId: list.id.value,
+							spaceId: input.spaceId,
+							workspaceId: input.workspaceId,
+							name: input.name,
+							position: input.position ?? 0,
+						},
+					}),
+				],
+				tx,
+			)
+			return { listId: list.id.value }
+		})
+	}
+}
