+import { injectable } from 'tsyringe-neo'
+import { Handler, BaseError, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { TaskStatus } from '@template/contracts-typescript/wire/enums'
+import type { ApplicationErrors } from '../errors'
+import { TaskRepository } from '../repositories/TaskRepository'
+import { SpaceStatusValidationService } from '../services/SpaceStatusValidationService'
+import { TaskStatusChangedDomainEvent } from '../events/TaskStatusChangedEvent'
+
+export const ChangeTaskStatusInputSchema = z.object({
+	taskId: z.uuid(),
+	newStatus: z.enum(TaskStatus),
+})
+
+export const ChangeTaskStatusOutputSchema = z.object({
+	fromStatus: z.string(),
+	toStatus: z.string(),
+})
+
+@injectable()
+export class ChangeTaskStatus extends Handler<typeof ChangeTaskStatusInputSchema, typeof ChangeTaskStatusOutputSchema> {
+	readonly name = 'change_task_status' as const
+	readonly inputSchema = ChangeTaskStatusInputSchema
+	readonly outputSchema = ChangeTaskStatusOutputSchema
+
+	constructor(
+		private readonly taskRepo: TaskRepository,
+		private readonly spaceStatusValidation: SpaceStatusValidationService,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const task = await this.taskRepo.findById(input.taskId, tx)
+			if (!task) throw new BaseError<ApplicationErrors>('TASK_NOT_FOUND')
+
+			const allowedStatuses = this.spaceStatusValidation.getAllowedStatuses(task.spaceId)
+			const fromStatus = task.changeStatus(input.newStatus, allowedStatuses)
+
+			await this.taskRepo.save(task, tx)
+
+			await this.domainEventRepository.save(
+				new TaskStatusChangedDomainEvent({
+					entityId: task.id.value,
+					payload: {
+						taskId: task.id.value,
+						workspaceId: task.workspaceId,
+						spaceId: task.spaceId,
+						fromStatus,
+						toStatus: input.newStatus,
+					},
+				}),
+				tx,
+			)
+
+			return { fromStatus, toStatus: input.newStatus }
+		})
+	}
+}
