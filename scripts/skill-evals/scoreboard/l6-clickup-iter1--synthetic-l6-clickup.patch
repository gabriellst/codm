@@ -0,0 +1,36 @@
+import { injectable } from 'tsyringe-neo'
+import { Projector } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { TaskCreatedEvent } from '../../events/TaskCreatedEvent'
+import { TaskStatusChangedDomainEvent } from '../../events/TaskStatusChangedEvent'
+import { BoardViewProjection, type BoardViewProjectionEvent } from '../BoardViewProjection'
+import { BoardViewProjectionRepository } from '../BoardViewProjectionRepository'
+
+@injectable()
+export class BoardViewProjector extends Projector<BoardViewProjectionEvent> {
+	readonly events: readonly string[] = [TaskCreatedEvent.name, TaskStatusChangedDomainEvent.name]
+
+	constructor(private readonly repo: BoardViewProjectionRepository) {
+		super()
+	}
+
+	async handle(event: BoardViewProjectionEvent, tx?: Transaction): Promise<void> {
+		switch (event.name) {
+			case TaskCreatedEvent.name: {
+				const projection = BoardViewProjection.create(event as TaskCreatedEvent)
+				await this.repo.insertIfNew(projection, tx)
+				break
+			}
+			case TaskStatusChangedDomainEvent.name: {
+				const e = event as TaskStatusChangedDomainEvent
+				const projection = await this.repo.findByTaskId(e.payload.taskId, tx)
+				if (!projection) break
+				projection.applyEvent(e)
+				await this.repo.save(projection, tx)
+				break
+			}
+			default:
+				break
+		}
+	}
+}
