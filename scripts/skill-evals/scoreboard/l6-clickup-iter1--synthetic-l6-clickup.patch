+import { pgSchema, pgEnum, uuid, text, timestamp, integer, jsonb, index, uniqueIndex } from 'drizzle-orm/pg-core'
+
+// ────────────────────────────────────────────────────────────────────
+// Shared enums (mirrored from contracts wire enums for pg type-safety)
+// ────────────────────────────────────────────────────────────────────
+
+export const taskStatusEnum = pgEnum('task_status', ['TODO', 'IN_PROGRESS', 'IN_REVIEW', 'DONE'])
+export const taskPriorityEnum = pgEnum('task_priority', ['LOW', 'NORMAL', 'HIGH', 'URGENT'])
+
+// ────────────────────────────────────────────────────────────────────
+// workspace BC schema
+// ────────────────────────────────────────────────────────────────────
+
+export const workspaceSchema = pgSchema('workspace')
+
+export const workspaces = workspaceSchema.table(
+	'workspaces',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+		name: text('name').notNull(),
+		ownerId: uuid('owner_id').notNull(),
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		ownerIdx: index('workspaces_owner_id_idx').on(t.ownerId),
+	}),
+)
+
+export const spaces = workspaceSchema.table(
+	'spaces',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+		workspaceId: uuid('workspace_id')
+			.notNull()
+			.references(() => workspaces.id, { onDelete: 'cascade' }),
+		name: text('name').notNull(),
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		workspaceIdx: index('spaces_workspace_id_idx').on(t.workspaceId),
+	}),
+)
+
+export const spaceLists = workspaceSchema.table(
+	'space_lists',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+		spaceId: uuid('space_id')
+			.notNull()
+			.references(() => spaces.id, { onDelete: 'cascade' }),
+		workspaceId: uuid('workspace_id')
+			.notNull()
+			.references(() => workspaces.id, { onDelete: 'cascade' }),
+		name: text('name').notNull(),
+		position: integer('position').notNull().default(0),
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		spaceIdx: index('space_lists_space_id_idx').on(t.spaceId),
+		workspaceIdx: index('space_lists_workspace_id_idx').on(t.workspaceId),
+		positionIdx: index('space_lists_position_idx').on(t.spaceId, t.position),
+	}),
+)
+
+export const workspaceMemberships = workspaceSchema.table(
+	'workspace_memberships',
+	{
+		workspaceId: uuid('workspace_id')
+			.notNull()
+			.references(() => workspaces.id, { onDelete: 'cascade' }),
+		userId: uuid('user_id').notNull(),
+		role: text('role').notNull().default('MEMBER'),
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+	},
+	t => ({
+		pk: uniqueIndex('workspace_memberships_pk').on(t.workspaceId, t.userId),
+		userIdx: index('workspace_memberships_user_id_idx').on(t.userId),
+	}),
+)
+
+// ────────────────────────────────────────────────────────────────────
+// task BC schema
+// ────────────────────────────────────────────────────────────────────
+
+export const taskSchema = pgSchema('task')
+
+export const tasks = taskSchema.table(
+	'tasks',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+		workspaceId: uuid('workspace_id').notNull(),
+		spaceId: uuid('space_id').notNull(),
+		listId: uuid('list_id').notNull(),
+		title: text('title').notNull(),
+		description: text('description'),
+		status: taskStatusEnum('status').notNull().default('TODO'),
+		priority: taskPriorityEnum('priority').notNull().default('NORMAL'),
+		assigneeIds: jsonb('assignee_ids').notNull().default([]),
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		workspaceIdx: index('tasks_workspace_id_idx').on(t.workspaceId),
+		spaceIdx: index('tasks_space_id_idx').on(t.spaceId),
+		listIdx: index('tasks_list_id_idx').on(t.listId),
+		statusIdx: index('tasks_status_idx').on(t.spaceId, t.status),
+	}),
+)
+
+// ────────────────────────────────────────────────────────────────────
+// Projection tables (read-side, written by projectors)
+// ────────────────────────────────────────────────────────────────────
+
+export const uiClickupSchema = pgSchema('ui_clickup')
+
+export const taskListViewEntries = uiClickupSchema.table(
+	'task_list_view_entries',
+	{
+		taskId: uuid('task_id').primaryKey(),
+		spaceId: uuid('space_id').notNull(),
+		workspaceId: uuid('workspace_id').notNull(),
+		listId: uuid('list_id').notNull(),
+		listName: text('list_name').notNull(),
+		listPosition: integer('list_position').notNull().default(0),
+		title: text('title').notNull(),
+		status: text('status').notNull(),
+		priority: text('priority').notNull(),
+		assigneeIds: jsonb('assignee_ids').notNull().default([]),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+	},
+	t => ({
+		spaceListIdx: index('task_list_view_space_list_idx').on(t.spaceId, t.listId),
+		workspaceIdx: index('task_list_view_workspace_idx').on(t.workspaceId),
+	}),
+)
+
+export const taskBoardViewEntries = uiClickupSchema.table(
+	'task_board_view_entries',
+	{
+		taskId: uuid('task_id').primaryKey(),
+		spaceId: uuid('space_id').notNull(),
+		workspaceId: uuid('workspace_id').notNull(),
+		statusColumn: text('status_column').notNull(),
+		listId: uuid('list_id').notNull(),
+		title: text('title').notNull(),
+		priority: text('priority').notNull(),
+		assigneeIds: jsonb('assignee_ids').notNull().default([]),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+	},
+	t => ({
+		spaceStatusIdx: index('task_board_view_space_status_idx').on(t.spaceId, t.statusColumn),
+		workspaceIdx: index('task_board_view_workspace_idx').on(t.workspaceId),
+	}),
+)
