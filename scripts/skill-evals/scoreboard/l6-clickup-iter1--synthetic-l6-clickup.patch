+
+export const TaskItemSchema = z.object({
+	taskId: z.uuid(),
+	title: z.string(),
+	status: z.string(),
+	priority: z.string(),
+	assigneeIds: z.array(z.uuid()),
+})
+
+export const ListGroupSchema = z.object({
+	listId: z.uuid(),
+	listName: z.string(),
+	listPosition: z.number().int(),
+	tasks: z.array(TaskItemSchema),
+})
+
+export const GetListViewInputSchema = z.object({
+	spaceId: z.uuid(),
+	workspaceId: z.uuid(),
+})
+
+export const GetListViewOutputSchema = z.object({
+	lists: z.array(ListGroupSchema),
+})
+
+@injectable()
+export class GetListView extends Handler<typeof GetListViewInputSchema, typeof GetListViewOutputSchema> {
+	readonly name = 'get_list_view' as const
+	readonly inputSchema = GetListViewInputSchema
+	readonly outputSchema = GetListViewOutputSchema
+
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const entries = await this.db
+			.select()
+			.from(taskListViewEntries)
+			.where(eq(taskListViewEntries.spaceId, input.spaceId))
+			.orderBy(asc(taskListViewEntries.listPosition))
+
+		const listMap = new Map<string, { listId: string; listName: string; listPosition: number; tasks: typeof entries }>()
+		for (const entry of entries) {
+			const key = entry.listId
+			if (!listMap.has(key)) {
+				listMap.set(key, { listId: key, listName: entry.listName, listPosition: entry.listPosition, tasks: [] })
+			}
+			listMap.get(key)!.tasks.push(entry)
+		}
+
+		const lists = [...listMap.values()]
+			.sort((a, b) => a.listPosition - b.listPosition)
+			.map(group => ({
+				listId: group.listId,
+				listName: group.listName,
+				listPosition: group.listPosition,
+				tasks: group.tasks.map(e => ({
+					taskId: e.taskId,
+					title: e.title,
+					status: e.status,
+					priority: e.priority,
+					assigneeIds: (e.assigneeIds as string[]) ?? [],
+				})),
+			}))
+
+		return { lists }
+	}
+}
