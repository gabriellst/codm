@@ -0,0 +1,28 @@
+import { createFileRoute } from '@tanstack/react-router'
+import { z } from 'zod'
+import { SpaceListViewSection } from './-components/SpaceListViewSection'
+import { SpaceBoardViewSection } from './-components/SpaceBoardViewSection'
+import { ViewToggle } from './-components/ViewToggle'
+
+export const Route = createFileRoute('/(app)/workspaces/$workspaceId/spaces/$spaceId/')({
+	validateSearch: z.object({
+		view: z.enum(['list', 'board']).default('list'),
+	}),
+	component: SpaceViewPage,
+})
+
+function SpaceViewPage() {
+	const { workspaceId, spaceId } = Route.useParams()
+	const { view } = Route.useSearch()
+
+	return (
+		<div className="flex flex-col gap-4 p-6">
+			<ViewToggle />
+			{view === 'list' ? (
+				<SpaceListViewSection workspaceId={workspaceId} spaceId={spaceId} />
+			) : (
+				<SpaceBoardViewSection workspaceId={workspaceId} spaceId={spaceId} />
+			)}
+		</div>
+	)
+}
