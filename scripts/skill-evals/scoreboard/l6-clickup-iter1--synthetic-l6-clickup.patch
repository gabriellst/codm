new file mode 100644
index 000000000..46ea1f534
--- /dev/null
+++ b/packages/api/typescript/src/task/entities/Task.ts
@@ -0,0 +1,70 @@
+import { AggregateRoot, BaseError, z } from '@template/core-typescript'
+import Z from 'zod'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import type { DomainErrors } from '../errors'
+
+export const TaskSchema = z.object({
+	workspaceId: z.uuid(),
+	spaceId: z.uuid(),
+	listId: z.uuid(),
+	title: z.string().min(1).max(500),
+	description: z.string().optional(),
+	status: z.enum(TaskStatus),
+	priority: z.enum(TaskPriority),
+	assigneeIds: z.array(z.uuid()).default([]),
+})
+
+export type TaskProps = Z.infer<typeof TaskSchema>
+
+export class Task extends AggregateRoot<typeof TaskSchema> {
+	static override schema = TaskSchema
+
+	static create(data: {
+		workspaceId: string
+		spaceId: string
+		listId: string
+		title: string
+		description?: string
+		status?: TaskStatus
+		priority?: TaskPriority
+		assigneeIds?: string[]
+	}): Task {
+		return new Task({
+			workspaceId: data.workspaceId,
+			spaceId: data.spaceId,
+			listId: data.listId,
+			title: data.title,
+			description: data.description,
+			status: data.status ?? TaskStatus.TODO,
+			priority: data.priority ?? TaskPriority.NORMAL,
+			assigneeIds: data.assigneeIds ?? [],
+		})
+	}
+
+	changeStatus(newStatus: TaskStatus, allowedStatuses: TaskStatus[]): TaskStatus {
+		if (!allowedStatuses.includes(newStatus)) {
+			throw new BaseError<DomainErrors>('INVALID_TASK_STATUS')
+		}
+		const fromStatus = this.status
+		this.status = newStatus
+		this.validate()
+		return fromStatus
+	}
+
+	assign(userId: string): void {
+		if (!this.assigneeIds.includes(userId)) {
+			this.assigneeIds = [...this.assigneeIds, userId]
+		}
+	}
+
+	unassign(userId: string): void {
+		this.assigneeIds = this.assigneeIds.filter(id => id !== userId)
+	}
+
+	updateTitle(title: string): void {
+		this.title = title
+		this.validate()
+	}
+}
+
+export interface Task extends TaskProps {}
