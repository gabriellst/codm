diff --git a/packages/e2e/tests/clickup-tasks-realtime.spec.ts b/packages/e2e/tests/clickup-tasks-realtime.spec.ts
new file mode 100644
index 000000000..47fb036b6
--- /dev/null
+++ b/packages/e2e/tests/clickup-tasks-realtime.spec.ts
@@ -0,0 +1,142 @@
+import { expect, test } from '@playwright/test'
+import { apiSignUp, injectSession } from '../utils/given/api'
+import { generateEmail } from '../utils/generators'
+
+/**
+ * Realtime board test — task status changes appear in the correct board column
+ * WITHOUT a page reload, driven by SSE (integration.shared.task.status_changed).
+ *
+ * Assertion model:
+ *   1. Sign up + create store + activate store (RequireStoreMember needs session.storeId)
+ *   2. Create workspace → space → list → task via direct fetch to the API
+ *   3. Navigate to board view
+ *   4. Assert task starts in TODO column
+ *   5. Change task status to IN_PROGRESS via direct fetch (NOT UI interaction)
+ *   6. Assert task moves to IN_PROGRESS column WITHOUT page.reload()
+ *      (proves SSE-driven queryClient.invalidateQueries worked)
+ */
+
+const API_BASE_URL = process.env.API_BASE_URL ?? 'http://localhost:3030'
+
+/**
+ * Helper: call the API with session-cookie auth.
+ * Playwright's `request` fixture uses the frontend baseURL (5173) — use raw
+ * fetch here so we can point at the backend (3030) and inject the session cookie.
+ */
+async function apiCall<T = unknown>(
+	method: string,
+	path: string,
+	sessionToken: string,
+	body?: unknown,
+): Promise<T> {
+	const res = await fetch(`${API_BASE_URL}${path}`, {
+		method,
+		headers: {
+			'Content-Type': 'application/json',
+			Cookie: `better-auth.session_token=${sessionToken}`,
+			Origin: API_BASE_URL,
+		},
+		body: body !== undefined ? JSON.stringify(body) : undefined,
+	})
+
+	if (!res.ok) {
+		const text = await res.text()
+		throw new Error(`API ${method} ${path} failed (${res.status}): ${text}`)
+	}
+
+	return res.json() as Promise<T>
+}
+
+test('task status change updates board column in realtime via SSE', async ({ page, context }) => {
+	// ------------------------------------------------------------------ //
+	// 1. Sign up — creates a fresh authenticated user                     //
+	// ------------------------------------------------------------------ //
+	const session = await apiSignUp({
+		name: 'E2E Realtime User',
+		email: generateEmail('realtime'),
+		password: 'Password123!',
+	})
+
+	// ------------------------------------------------------------------ //
+	// 2. Create a store (required for RequireStoreMember middleware)       //
+	// ------------------------------------------------------------------ //
+	const { storeId } = await apiCall<{ storeId: string }>('POST', '/v1/stores', session.token, {
+		name: 'E2E Realtime Store',
+		reportingCurrency: 'USD',
+		timezone: 'America/Sao_Paulo',
+	})
+
+	// ------------------------------------------------------------------ //
+	// 3. Activate the store — writes activeStoreId into the session row   //
+	//    so subsequent requests pass RequireStoreMember                   //
+	// ------------------------------------------------------------------ //
+	await apiCall('POST', `/v1/stores/${storeId}/activate`, session.token)
+
+	// ------------------------------------------------------------------ //
+	// 4. Inject session cookie into the browser context so the UI         //
+	//    renders the authenticated app                                    //
+	// ------------------------------------------------------------------ //
+	await injectSession(context, session)
+
+	// ------------------------------------------------------------------ //
+	// 5. Create workspace → space → list → task via the API              //
+	// ------------------------------------------------------------------ //
+	const { workspaceId } = await apiCall<{ workspaceId: string }>(
+		'POST',
+		'/v1/workspaces',
+		session.token,
+		{ name: 'E2E Workspace' },
+	)
+
+	const { spaceId } = await apiCall<{ spaceId: string }>(
+		'POST',
+		`/v1/workspaces/${workspaceId}/spaces`,
+		session.token,
+		{ name: 'E2E Space' },
+	)
+
+	const { listId } = await apiCall<{ listId: string }>(
+		'POST',
+		`/v1/workspaces/${workspaceId}/spaces/${spaceId}/lists`,
+		session.token,
+		{ name: 'E2E List' },
+	)
+
+	const { taskId } = await apiCall<{ taskId: string }>(
+		'POST',
+		`/v1/workspaces/${workspaceId}/spaces/${spaceId}/lists/${listId}/tasks`,
+		session.token,
+		{ title: 'Realtime test task', priority: 'NORMAL' },
+	)
+
+	// ------------------------------------------------------------------ //
+	// 6. Navigate to the board view                                       //
+	// ------------------------------------------------------------------ //
+	await page.goto(`/app/workspaces/${workspaceId}/spaces/${spaceId}?view=board`)
+
+	// ------------------------------------------------------------------ //
+	// 7. Assert the task is initially in the TODO column                  //
+	// ------------------------------------------------------------------ //
+	const todoColumn = page.getByTestId('board-column-TODO')
+	const inProgressColumn = page.getByTestId('board-column-IN_PROGRESS')
+
+	await expect(todoColumn.getByTestId(`task-card-${taskId}`)).toBeVisible()
+	await expect(inProgressColumn.getByTestId(`task-card-${taskId}`)).not.toBeVisible()
+
+	// ------------------------------------------------------------------ //
+	// 8. Change task status via API — simulates an external trigger,      //
+	//    NOT a UI click. The board must react via SSE alone.              //
+	// ------------------------------------------------------------------ //
+	await apiCall('PATCH', `/v1/tasks/${taskId}/status`, session.token, {
+		newStatus: 'IN_PROGRESS',
+	})
+
+	// ------------------------------------------------------------------ //
+	// 9. Assert board updates WITHOUT page.reload()                       //
+	//    Playwright retries the assertion until its default timeout.      //
+	//    If this passes, SSE delivered the event and invalidation         //
+	//    triggered a successful refetch.                                  //
+	// ------------------------------------------------------------------ //
+	await expect(inProgressColumn.getByTestId(`task-card-${taskId}`)).toBeVisible()
+	await expect(todoColumn.getByTestId(`task-card-${taskId}`)).not.toBeVisible()
+})
