@@ -0,0 +1,103 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { taskBoardViewEntries } from '@template/contracts/db'
+import { BoardViewProjection } from './BoardViewProjection'
+
+// ─── Abstract interface ───────────────────────────────────────────────────────
+
+export abstract class BoardViewProjectionRepository {
+	abstract findByTaskId(taskId: string, tx?: Transaction): Promise<BoardViewProjection | undefined>
+	abstract save(projection: BoardViewProjection, tx?: Transaction): Promise<void>
+	abstract insertIfNew(projection: BoardViewProjection, tx?: Transaction): Promise<void>
+}
+
+// ─── Drizzle implementation ───────────────────────────────────────────────────
+
+@injectable()
+export class DrizzleBoardViewProjectionRepository extends BoardViewProjectionRepository {
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	async findByTaskId(taskId: string, tx?: DrizzleClient): Promise<BoardViewProjection | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			return dbc.select().from(taskBoardViewEntries).where(eq(taskBoardViewEntries.taskId, taskId)).limit(1)
+		})
+		if (!result.success || !result.data) return undefined
+		const row = result.data[0]
+		if (!row) return undefined
+		return new BoardViewProjection({
+			taskId: row.taskId,
+			spaceId: row.spaceId,
+			workspaceId: row.workspaceId,
+			statusColumn: row.statusColumn,
+			listId: row.listId,
+			title: row.title,
+			priority: row.priority,
+			assigneeIds: (row.assigneeIds as string[]) ?? [],
+			updatedAt: row.updatedAt,
+		})
+	}
+
+	async save(projection: BoardViewProjection, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc
+				.update(taskBoardViewEntries)
+				.set({
+					statusColumn: projection.props.statusColumn,
+					title: projection.props.title,
+					priority: projection.props.priority,
+					assigneeIds: projection.props.assigneeIds,
+					updatedAt: new Date(),
+				})
+				.where(eq(taskBoardViewEntries.taskId, projection.props.taskId))
+		})
+		if (!result.success) throw result.error
+	}
+
+	async insertIfNew(projection: BoardViewProjection, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc
+				.insert(taskBoardViewEntries)
+				.values({
+					taskId: projection.props.taskId,
+					spaceId: projection.props.spaceId,
+					workspaceId: projection.props.workspaceId,
+					statusColumn: projection.props.statusColumn,
+					listId: projection.props.listId,
+					title: projection.props.title,
+					priority: projection.props.priority,
+					assigneeIds: projection.props.assigneeIds,
+					updatedAt: new Date(),
+				})
+				.onConflictDoNothing()
+		})
+		if (!result.success) throw result.error
+	}
+}
+
+// ─── Mock implementation ──────────────────────────────────────────────────────
+
+@injectable()
+export class MockBoardViewProjectionRepository extends BoardViewProjectionRepository {
+	private store = new Map<string, BoardViewProjection>()
+
+	async findByTaskId(taskId: string): Promise<BoardViewProjection | undefined> {
+		return this.store.get(taskId)
+	}
+
+	async save(projection: BoardViewProjection): Promise<void> {
+		this.store.set(projection.props.taskId, projection)
+	}
+
+	async insertIfNew(projection: BoardViewProjection): Promise<void> {
+		if (!this.store.has(projection.props.taskId)) {
+			this.store.set(projection.props.taskId, projection)
+		}
+	}
+}
