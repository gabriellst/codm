@@ -0,0 +1,91 @@
+import { create } from 'zustand'
+import type { ConnectIntegrationMutationRequest } from '@template/client-typescript/typescript'
+
+// SDK-derived discriminant type for the two modes used by onboarding targets
+export type OnboardingConnectionMode = 'CREDENTIALS' | 'MANUAL'
+
+// One entry per onboarding target: the three discriminants required to match a union member.
+export interface OnboardingTarget {
+	platform: 'SHOPIFY' | 'YAMPI' | 'META' | 'MERCADOPAGO'
+	type: 'SALES_CHANNEL' | 'CHECKOUT' | 'MARKETING_PLATFORM' | 'PAYMENT_GATEWAY'
+	connectionMode: OnboardingConnectionMode
+}
+
+// SDK-derived credential types — one per CREDENTIALS-mode target.
+export type ShopifyCredentials = Extract<
+	ConnectIntegrationMutationRequest,
+	{ platform: 'SHOPIFY'; connectionMode: 'CREDENTIALS' }
+>['credentials']
+
+export type YampiCredentials = Extract<
+	ConnectIntegrationMutationRequest,
+	{ platform: 'YAMPI'; connectionMode: 'CREDENTIALS' }
+>['credentials']
+
+// MANUAL targets have empty credential objects.
+export type ManualCredentials = Record<string, never>
+
+export type OnboardingCredentials = ShopifyCredentials | YampiCredentials | ManualCredentials
+
+// Step sequences per connection mode — const-asserted tuples keyed by SDK ConnectionMode.
+export type OnboardingStep = 'CONNECTION_MODE' | 'TARGET' | 'CREDENTIALS' | 'REVIEW'
+
+// Enum object for OnboardingStep — use these constants for comparisons (bp-14).
+export const ONBOARDING_STEP = {
+	CONNECTION_MODE: 'CONNECTION_MODE',
+	TARGET: 'TARGET',
+	CREDENTIALS: 'CREDENTIALS',
+	REVIEW: 'REVIEW',
+} as const satisfies Record<OnboardingStep, OnboardingStep>
+
+export const MODE_STEPS = {
+	CREDENTIALS: ['CONNECTION_MODE', 'TARGET', 'CREDENTIALS', 'REVIEW'] as const,
+	MANUAL: ['CONNECTION_MODE', 'TARGET', 'REVIEW'] as const,
+} satisfies Record<OnboardingConnectionMode, readonly OnboardingStep[]>
+
+// The four onboarding targets — one per (platform, type, connectionMode) tuple.
+export const ONBOARDING_TARGETS: Record<OnboardingConnectionMode, readonly OnboardingTarget[]> = {
+	CREDENTIALS: [
+		{ platform: 'SHOPIFY', type: 'SALES_CHANNEL', connectionMode: 'CREDENTIALS' },
+		{ platform: 'YAMPI', type: 'CHECKOUT', connectionMode: 'CREDENTIALS' },
+	],
+	MANUAL: [
+		{ platform: 'META', type: 'MARKETING_PLATFORM', connectionMode: 'MANUAL' },
+		{ platform: 'MERCADOPAGO', type: 'PAYMENT_GATEWAY', connectionMode: 'MANUAL' },
+	],
+}
+
+interface OnboardingState {
+	currentStepIndex: number
+	direction: 1 | -1
+	selectedMode: OnboardingConnectionMode | undefined
+	selectedTarget: OnboardingTarget | undefined
+	credentials: OnboardingCredentials | undefined
+}
+
+interface OnboardingActions {
+	setCurrentStepIndex: (index: number) => void
+	setDirection: (direction: 1 | -1) => void
+	setSelectedMode: (mode: OnboardingConnectionMode | undefined) => void
+	setSelectedTarget: (target: OnboardingTarget | undefined) => void
+	setCredentials: (credentials: OnboardingCredentials | undefined) => void
+	reset: () => void
+}
+
+const initialState: OnboardingState = {
+	currentStepIndex: 0,
+	direction: 1,
+	selectedMode: undefined,
+	selectedTarget: undefined,
+	credentials: undefined,
+}
+
+export const useOnboardingStore = create<OnboardingState & OnboardingActions>(set => ({
+	...initialState,
+	setCurrentStepIndex: currentStepIndex => set({ currentStepIndex }),
+	setDirection: direction => set({ direction }),
+	setSelectedMode: selectedMode => set({ selectedMode }),
+	setSelectedTarget: selectedTarget => set({ selectedTarget }),
+	setCredentials: credentials => set({ credentials }),
+	reset: () => set(initialState),
+}))
