index 000000000..19c4a1f92
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx
@@ -0,0 +1,78 @@
+import { type ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { ConnectionModeEnum } from '@template/client-typescript/typescript'
+import { cn } from '@/lib/utils'
+import { Button } from '@/components/ui/button'
+import { type OnboardingConnectionMode } from '../../-stores/useOnboardingStore'
+
+interface ModeCardProps {
+	mode: OnboardingConnectionMode
+	label: string
+	description: string
+	selected: boolean
+	onSelect: (mode: OnboardingConnectionMode) => void
+}
+
+function ModeCard({ mode, label, description, selected, onSelect }: ModeCardProps) {
+	return (
+		<button
+			type="button"
+			onClick={() => onSelect(mode)}
+			aria-pressed={selected}
+			className={cn(
+				'flex flex-col gap-1 rounded-xl border-2 p-4 text-left transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring',
+				selected ? 'border-primary bg-primary/5' : 'border-border bg-card',
+			)}
+		>
+			<span className="font-semibold text-foreground">{label}</span>
+			<span className="text-sm text-muted-foreground">{description}</span>
+		</button>
+	)
+}
+
+interface ConnectionModeStepProps extends ComponentProps<'div'> {
+	selectedMode: OnboardingConnectionMode | undefined
+	onModeSelect: (mode: OnboardingConnectionMode) => void
+	onNext: () => void
+}
+
+export function ConnectionModeStep({ selectedMode, onModeSelect, onNext, className, ...props }: ConnectionModeStepProps) {
+	const { t } = useTranslation()
+
+	return (
+		<div className={cn('flex flex-col gap-8', className)} {...props}>
+			<div className="flex flex-col gap-2">
+				<h2 className="text-2xl font-semibold text-foreground">{t('onboarding.welcome.title')}</h2>
+				<p className="text-muted-foreground">{t('onboarding.welcome.subtitle')}</p>
+			</div>
+
+			<div className="flex flex-col gap-4">
+				<p className="text-lg font-medium text-foreground">{t('onboarding.connectionMode.title')}</p>
+				<p className="text-sm text-muted-foreground">{t('onboarding.connectionMode.subtitle')}</p>
+
+				<div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
+					<ModeCard
+						mode={ConnectionModeEnum.CREDENTIALS}
+						label={t('enums.ConnectionMode.CREDENTIALS')}
+						description={t('onboarding.connectionMode.credentialsDescription')}
+						selected={selectedMode === ConnectionModeEnum.CREDENTIALS}
+						onSelect={onModeSelect}
+					/>
+					<ModeCard
+						mode={ConnectionModeEnum.MANUAL}
+						label={t('enums.ConnectionMode.MANUAL')}
+						description={t('onboarding.connectionMode.manualDescription')}
+						selected={selectedMode === ConnectionModeEnum.MANUAL}
+						onSelect={onModeSelect}
+					/>
+				</div>
+			</div>
+
+			<div className="flex justify-end">
+				<Button type="button" disabled={!selectedMode} onClick={onNext}>
+					{t('onboarding.nav.next')}
+				</Button>
+			</div>
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/onboarding/-components/CredentialsStep/index.tsx b/packages/app/react/src/routes/onboarding/-components/CredentialsStep/index.tsx
