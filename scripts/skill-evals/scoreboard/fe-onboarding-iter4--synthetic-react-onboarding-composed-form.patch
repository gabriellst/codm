@@ -0,0 +1,117 @@
+import { type ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useNavigate } from '@tanstack/react-router'
+import { useQueryClient } from '@tanstack/react-query'
+import { toast } from 'sonner'
+import {
+	ConnectionModeEnum,
+	useConnectIntegration,
+	connectIntegrationMutationRequestSchema,
+	listPlatformDescriptorsQueryKey,
+} from '@template/client-typescript/typescript'
+import { cn } from '@/lib/utils'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import {
+	type OnboardingConnectionMode,
+	type OnboardingTarget,
+	type OnboardingCredentials,
+} from '../../-stores/useOnboardingStore'
+
+// Literal-key label map for connection modes — enum catalog (enums.ConnectionMode.*).
+const buildModeLabels = (t: (key: string) => string): Record<OnboardingConnectionMode, string> => ({
+	[ConnectionModeEnum.CREDENTIALS]: t('enums.ConnectionMode.CREDENTIALS'),
+	[ConnectionModeEnum.MANUAL]: t('enums.ConnectionMode.MANUAL'),
+})
+
+// Literal-key label map for the four onboarding platforms.
+const buildPlatformLabels = (t: (key: string) => string): Record<OnboardingTarget['platform'], string> => ({
+	SHOPIFY: t('onboarding.target.SHOPIFY'),
+	YAMPI: t('onboarding.target.YAMPI'),
+	META: t('onboarding.target.META'),
+	MERCADOPAGO: t('onboarding.target.MERCADOPAGO'),
+})
+
+interface SummaryRowProps {
+	label: string
+	value: string
+}
+
+function SummaryRow({ label, value }: SummaryRowProps) {
+	return (
+		<div className="flex justify-between gap-4 py-3 border-b border-border last:border-0">
+			<dt className="text-sm text-muted-foreground">{label}</dt>
+			<dd className="text-sm font-medium text-foreground text-right">{value}</dd>
+		</div>
+	)
+}
+
+interface ReviewStepProps extends ComponentProps<'div'> {
+	target: OnboardingTarget
+	credentials: OnboardingCredentials
+	onBack: () => void
+}
+
+export function ReviewStep({ target, credentials, onBack, className, ...props }: ReviewStepProps) {
+	const { t } = useTranslation()
+	const navigate = useNavigate()
+	const queryClient = useQueryClient()
+
+	const connect = useConnectIntegration({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('onboarding.toast.success'))
+				queryClient.invalidateQueries({ queryKey: listPlatformDescriptorsQueryKey() })
+				void navigate({ to: '/' })
+			},
+		},
+	})
+
+	// Build and validate the full connect body — the button is only enabled when the matched
+	// union member accepts the assembled payload (pickUnionVariant + safeParse).
+	const body = {
+		connectionMode: target.connectionMode,
+		type: target.type,
+		platform: target.platform,
+		credentials,
+	}
+
+	const bodyResult = connectIntegrationMutationRequestSchema.safeParse(body)
+
+	const handleConnect = async () => {
+		if (!bodyResult.success) return
+		await connect.mutateAsync({ data: bodyResult.data })
+	}
+
+	const modeLabels = buildModeLabels(t)
+	const platformLabels = buildPlatformLabels(t)
+
+	return (
+		<div className={cn('flex flex-col gap-8', className)} {...props}>
+			<div className="flex flex-col gap-2">
+				<h2 className="text-2xl font-semibold text-foreground">{t('onboarding.review.title')}</h2>
+				<p className="text-muted-foreground">{t('onboarding.review.subtitle')}</p>
+			</div>
+
+			<dl className="rounded-xl border border-border bg-card px-4">
+				<SummaryRow label={t('onboarding.review.mode')} value={modeLabels[target.connectionMode]} />
+				<SummaryRow label={t('onboarding.review.platform')} value={platformLabels[target.platform]} />
+				<SummaryRow label={t('onboarding.review.type')} value={target.type.replace(/_/g, ' ')} />
+			</dl>
+
+			<div className="flex justify-between">
+				<Button type="button" variant="outline" onClick={onBack} disabled={connect.isPending}>
+					{t('onboarding.nav.back')}
+				</Button>
+				<Button
+					type="button"
+					disabled={!bodyResult.success || connect.isPending}
+					onClick={handleConnect}
+				>
+					{connect.isPending && <Spinner className="mr-2" />}
+					{t('onboarding.nav.connect')}
+				</Button>
+			</div>
+		</div>
+	)
+}
