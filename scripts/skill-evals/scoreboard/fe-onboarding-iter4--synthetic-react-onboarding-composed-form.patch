+import { type ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { cn } from '@/lib/utils'
+import { Button } from '@/components/ui/button'
+import {
+	ONBOARDING_TARGETS,
+	type OnboardingConnectionMode,
+	type OnboardingTarget,
+} from '../../-stores/useOnboardingStore'
+
+interface TargetCardProps {
+	target: OnboardingTarget
+	label: string
+	selected: boolean
+	onSelect: (target: OnboardingTarget) => void
+}
+
+function TargetCard({ target, label, selected, onSelect }: TargetCardProps) {
+	return (
+		<button
+			type="button"
+			onClick={() => onSelect(target)}
+			aria-pressed={selected}
+			className={cn(
+				'flex flex-col gap-1 rounded-xl border-2 p-4 text-left transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring',
+				selected ? 'border-primary bg-primary/5' : 'border-border bg-card',
+			)}
+		>
+			<span className="font-semibold text-foreground">{label}</span>
+			<span className="text-xs text-muted-foreground uppercase tracking-wide">{target.type.replace(/_/g, ' ')}</span>
+		</button>
+	)
+}
+
+interface TargetStepProps extends ComponentProps<'div'> {
+	mode: OnboardingConnectionMode
+	selectedTarget: OnboardingTarget | undefined
+	onTargetSelect: (target: OnboardingTarget) => void
+	onNext: () => void
+	onBack: () => void
+}
+
+export function TargetStep({ mode, selectedTarget, onTargetSelect, onNext, onBack, className, ...props }: TargetStepProps) {
+	const { t } = useTranslation()
+
+	// Literal-key label map — one entry per onboarding platform, no template literals (bp-25).
+	const platformLabels: Record<OnboardingTarget['platform'], string> = {
+		SHOPIFY: t('onboarding.target.SHOPIFY'),
+		YAMPI: t('onboarding.target.YAMPI'),
+		META: t('onboarding.target.META'),
+		MERCADOPAGO: t('onboarding.target.MERCADOPAGO'),
+	}
+
+	const targets = ONBOARDING_TARGETS[mode]
+
+	return (
+		<div className={cn('flex flex-col gap-8', className)} {...props}>
+			<div className="flex flex-col gap-2">
+				<h2 className="text-2xl font-semibold text-foreground">{t('onboarding.target.title')}</h2>
+				<p className="text-muted-foreground">{t('onboarding.target.subtitle')}</p>
+			</div>
+
+			<div className="grid grid-cols-1 sm:grid-cols-2 gap-3" role="list" aria-label={t('onboarding.target.title')}>
+				{targets.map(target => (
+					<div key={target.platform} role="listitem">
+						<TargetCard
+							target={target}
+							label={platformLabels[target.platform]}
+							selected={selectedTarget?.platform === target.platform}
+							onSelect={onTargetSelect}
+						/>
+					</div>
+				))}
+			</div>
+
+			<div className="flex justify-between">
+				<Button type="button" variant="outline" onClick={onBack}>
+					{t('onboarding.nav.back')}
+				</Button>
+				<Button type="button" disabled={!selectedTarget} onClick={onNext}>
+					{t('onboarding.nav.next')}
+				</Button>
+			</div>
+		</div>
+	)
+}
