index 000000000..6872305be
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/CredentialsStep/index.tsx
@@ -0,0 +1,311 @@
+import { type ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useForm } from '@tanstack/react-form'
+import type { z } from 'zod/v4'
+import { connectIntegrationMutationRequestSchema } from '@template/client-typescript/typescript'
+import { pickUnionVariantField } from '@/lib'
+import { cn } from '@/lib/utils'
+import { Field, FieldLabel, FieldError, FieldGroup } from '@/components/ui/field'
+import { Input } from '@/components/ui/input'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import { type OnboardingTarget, type ShopifyCredentials, type YampiCredentials } from '../../-stores/useOnboardingStore'
+
+// ---------------------------------------------------------------------------
+// Shared props contract — both credential forms share this interface so the
+// dispatch map is uniformly typed without casts.
+// ---------------------------------------------------------------------------
+
+interface CredentialsFormProps {
+	onCredentials: (creds: ShopifyCredentials | YampiCredentials) => void
+	onBack: () => void
+}
+
+// ---------------------------------------------------------------------------
+// Shopify credentials form
+// ---------------------------------------------------------------------------
+
+const shopifyCredentialsSchema = pickUnionVariantField(
+	connectIntegrationMutationRequestSchema,
+	{ platform: 'SHOPIFY', connectionMode: 'CREDENTIALS' },
+	'credentials',
+)
+
+export const ShopifyCredentialsStepSchema = shopifyCredentialsSchema
+export type ShopifyCredentialsStepData = z.infer<typeof shopifyCredentialsSchema>
+
+function ShopifyCredentialsForm({ onCredentials, onBack }: CredentialsFormProps) {
+	const { t } = useTranslation()
+
+	const defaultValues: ShopifyCredentials = { shopDomain: '', clientId: '', clientSecret: '' }
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: shopifyCredentialsSchema },
+		onSubmit: async ({ value }) => {
+			const result = shopifyCredentialsSchema.safeParse(value)
+			if (!result.success) return
+			onCredentials(result.data)
+		},
+	})
+
+	return (
+		<form
+			className="flex flex-col gap-6"
+			noValidate
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+		>
+			<FieldGroup>
+				<form.Field name="shopDomain">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.shopDomain')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				<form.Field name="clientId">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.clientId')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				<form.Field name="clientSecret">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.clientSecret')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="password"
+									autoComplete="new-password"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+			</FieldGroup>
+
+			<form.Subscribe selector={s => ({ canSubmit: s.canSubmit, isSubmitting: s.isSubmitting, values: s.values })}>
+				{({ canSubmit, isSubmitting, values }) => {
+					const isDisabled = !canSubmit || isSubmitting || !shopifyCredentialsSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+								{t('onboarding.nav.back')}
+							</Button>
+							<Button type="submit" disabled={isDisabled}>
+								{isSubmitting && <Spinner className="mr-2" />}
+								{t('onboarding.nav.next')}
+							</Button>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Yampi credentials form
+// ---------------------------------------------------------------------------
+
+const yampiCredentialsSchema = pickUnionVariantField(
+	connectIntegrationMutationRequestSchema,
+	{ platform: 'YAMPI', connectionMode: 'CREDENTIALS' },
+	'credentials',
+)
+
+export const YampiCredentialsStepSchema = yampiCredentialsSchema
+export type YampiCredentialsStepData = z.infer<typeof yampiCredentialsSchema>
+
+function YampiCredentialsForm({ onCredentials, onBack }: CredentialsFormProps) {
+	const { t } = useTranslation()
+
+	const defaultValues: YampiCredentials = { alias: '', userToken: '', userSecretKey: '' }
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: yampiCredentialsSchema },
+		onSubmit: async ({ value }) => {
+			const result = yampiCredentialsSchema.safeParse(value)
+			if (!result.success) return
+			onCredentials(result.data)
+		},
+	})
+
+	return (
+		<form
+			className="flex flex-col gap-6"
+			noValidate
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+		>
+			<FieldGroup>
+				<form.Field name="alias">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.alias')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				<form.Field name="userToken">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.userToken')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				<form.Field name="userSecretKey">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.userSecretKey')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="password"
+									autoComplete="new-password"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+			</FieldGroup>
+
+			<form.Subscribe selector={s => ({ canSubmit: s.canSubmit, isSubmitting: s.isSubmitting, values: s.values })}>
+				{({ canSubmit, isSubmitting, values }) => {
+					const isDisabled = !canSubmit || isSubmitting || !yampiCredentialsSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+								{t('onboarding.nav.back')}
+							</Button>
+							<Button type="submit" disabled={isDisabled}>
+								{isSubmitting && <Spinner className="mr-2" />}
+								{t('onboarding.nav.next')}
+							</Button>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Dispatch map — one entry per CREDENTIALS-mode platform (FRM-P43 b).
+// Keyed by platform literal so lookup is O(1) with no if/switch chains.
+// ---------------------------------------------------------------------------
+
+const CREDENTIAL_FORMS = {
+	SHOPIFY: ShopifyCredentialsForm,
+	YAMPI: YampiCredentialsForm,
+} satisfies Record<string, (props: CredentialsFormProps) => React.ReactElement>
+
+type CredentialsPlatform = keyof typeof CREDENTIAL_FORMS
+
+function isCredentialsPlatform(p: OnboardingTarget['platform']): p is CredentialsPlatform {
+	return p in CREDENTIAL_FORMS
+}
+
+// ---------------------------------------------------------------------------
+// CredentialsStep orchestrator
+// ---------------------------------------------------------------------------
+
+interface CredentialsStepProps extends ComponentProps<'div'> {
+	target: OnboardingTarget
+	onCredentials: (creds: ShopifyCredentials | YampiCredentials) => void
+	onBack: () => void
+}
+
+export function CredentialsStep({ target, onCredentials, onBack, className, ...props }: CredentialsStepProps) {
+	const { t } = useTranslation()
+
+	if (!isCredentialsPlatform(target.platform)) return null
+
+	const VariantForm = CREDENTIAL_FORMS[target.platform]
+
+	return (
+		<div className={cn('flex flex-col gap-8', className)} {...props}>
+			<div className="flex flex-col gap-2">
+				<h2 className="text-2xl font-semibold text-foreground">{t('onboarding.credentials.title')}</h2>
+				<p className="text-muted-foreground">{t('onboarding.credentials.subtitle')}</p>
+			</div>
+
+			<VariantForm onCredentials={onCredentials} onBack={onBack} />
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/onboarding/-components/OnboardingWizard/index.tsx b/packages/app/react/src/routes/onboarding/-components/OnboardingWizard/index.tsx
