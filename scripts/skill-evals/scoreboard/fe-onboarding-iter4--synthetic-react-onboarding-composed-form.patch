@@ -0,0 +1,119 @@
+import { type ComponentProps, useEffect } from 'react'
+import { cn } from '@/lib/utils'
+import {
+	useOnboardingStore,
+	MODE_STEPS,
+	ONBOARDING_STEP,
+	type OnboardingConnectionMode,
+	type OnboardingTarget,
+	type ShopifyCredentials,
+	type YampiCredentials,
+} from '../../-stores/useOnboardingStore'
+import { ConnectionModeStep } from '../ConnectionModeStep'
+import { TargetStep } from '../TargetStep'
+import { CredentialsStep } from '../CredentialsStep'
+import { ReviewStep } from '../ReviewStep'
+
+// Resolve step sequence once a mode is known; defaults to CREDENTIALS for initial render.
+const DEFAULT_STEPS = MODE_STEPS.CREDENTIALS
+
+export function OnboardingWizard({ className, ...props }: ComponentProps<'div'>) {
+	const {
+		currentStepIndex,
+		selectedMode,
+		selectedTarget,
+		credentials,
+		setCurrentStepIndex,
+		setSelectedMode,
+		setSelectedTarget,
+		setCredentials,
+		reset,
+	} = useOnboardingStore()
+
+	// Reset ephemeral wizard state when the user leaves this route.
+	useEffect(() => {
+		return () => { reset() }
+	}, [reset])
+
+	const steps = selectedMode ? MODE_STEPS[selectedMode] : DEFAULT_STEPS
+	const totalSteps = steps.length
+	const currentStep = steps[currentStepIndex] ?? ONBOARDING_STEP.CONNECTION_MODE
+
+	const goNext = () => {
+		setCurrentStepIndex(Math.min(currentStepIndex + 1, totalSteps - 1))
+	}
+
+	const goBack = () => {
+		setCurrentStepIndex(Math.max(currentStepIndex - 1, 0))
+	}
+
+	const handleModeSelect = (mode: OnboardingConnectionMode) => {
+		// Reset dependent selections whenever the mode changes.
+		if (mode !== selectedMode) {
+			setSelectedTarget(undefined)
+			setCredentials(undefined)
+		}
+		setSelectedMode(mode)
+	}
+
+	const handleTargetSelect = (target: OnboardingTarget) => {
+		setSelectedTarget(target)
+	}
+
+	const handleCredentials = (creds: ShopifyCredentials | YampiCredentials) => {
+		setCredentials(creds)
+		goNext()
+	}
+
+	return (
+		<div className={cn('flex flex-col gap-6 w-full', className)} {...props}>
+			{/* Step progress indicator */}
+			<div className="flex gap-1.5" role="progressbar" aria-valuenow={currentStepIndex + 1} aria-valuemax={totalSteps}>
+				{steps.map((step, index) => (
+					<div
+						key={step}
+						className={cn(
+							'h-1 flex-1 rounded-full transition-colors',
+							index <= currentStepIndex ? 'bg-primary' : 'bg-border',
+						)}
+					/>
+				))}
+			</div>
+
+			{/* Step dispatcher — enum constants for comparisons (bp-14), one branch per step */}
+			{currentStep === ONBOARDING_STEP.CONNECTION_MODE && (
+				<ConnectionModeStep
+					selectedMode={selectedMode}
+					onModeSelect={handleModeSelect}
+					onNext={goNext}
+				/>
+			)}
+
+			{currentStep === ONBOARDING_STEP.TARGET && selectedMode !== undefined && (
+				<TargetStep
+					mode={selectedMode}
+					selectedTarget={selectedTarget}
+					onTargetSelect={handleTargetSelect}
+					onNext={goNext}
+					onBack={goBack}
+				/>
+			)}
+
+			{currentStep === ONBOARDING_STEP.CREDENTIALS && selectedTarget !== undefined && (
+				<CredentialsStep
+					target={selectedTarget}
+					onCredentials={handleCredentials}
+					onBack={goBack}
+				/>
+			)}
+
+			{currentStep === ONBOARDING_STEP.REVIEW && selectedTarget !== undefined && (
+				<ReviewStep
+					target={selectedTarget}
+					credentials={credentials ?? {}}
+					onBack={goBack}
+				/>
+			)}
+		</div>
+	)
+}
