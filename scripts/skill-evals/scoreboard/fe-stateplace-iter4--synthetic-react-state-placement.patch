diff --git a/packages/app/react/src/routes/(app)/reports/-components/ComparisonPanel/index.tsx b/packages/app/react/src/routes/(app)/reports/-components/ComparisonPanel/index.tsx
new file mode 100644
index 000000000..175adc1cf
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/ComparisonPanel/index.tsx
@@ -0,0 +1,118 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useListQuickProductRanking } from '@template/client-typescript/typescript'
+
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { GroupIcon } from '@/components/ui/icons'
+import { cn } from '@/lib/utils'
+import { useTenancyStore } from '@/stores'
+import { useMoney } from '@/hooks'
+import { useReportsStore } from '../../-stores/useReportsStore'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+export function ComparisonPanel({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const { startDate, endDate } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+	const comparisonBasket = useReportsStore(s => s.comparisonBasket)
+
+	const { data, isPending, isError } = useListQuickProductRanking({
+		tenancyScope,
+		startDate,
+		endDate,
+		productIds: comparisonBasket,
+	})
+
+	const items = data?.items.filter(item => comparisonBasket.includes(item.productId)) ?? []
+
+	return (
+		<Card className={cn('flex flex-col gap-4 p-6', className)} {...props}>
+			<div className="flex items-center gap-4">
+				<GradientIconBadge icon={GroupIcon} />
+				<span className="flex-1 text-lg font-medium text-muted-foreground">
+					{t('reports.comparison.title')}
+				</span>
+			</div>
+
+			<div className="border-t border-border/60" />
+
+			{isPending ? (
+				<ComparisonSkeleton count={comparisonBasket.length} />
+			) : isError ? (
+				<p className="text-sm text-muted-foreground">{t('reports.comparison.loadError')}</p>
+			) : items.length === 0 ? (
+				<p className="text-sm text-muted-foreground">{t('reports.comparison.empty')}</p>
+			) : (
+				<div className="grid gap-4" style={{ gridTemplateColumns: `repeat(${items.length}, 1fr)` }}>
+					{items.map(item => (
+						<div
+							key={item.productId}
+							className="flex flex-col gap-3 rounded-lg border border-border/60 bg-muted/20 p-4"
+						>
+							<div className="flex items-center gap-2">
+								{item.imageUrl ? (
+									<img
+										src={item.imageUrl}
+										alt=""
+										className="size-10 shrink-0 rounded-lg object-cover"
+									/>
+								) : (
+									<div className="size-10 shrink-0 rounded-lg bg-muted" />
+								)}
+								<span className="min-w-0 flex-1 truncate text-sm font-medium text-foreground">
+									{item.name}
+								</span>
+							</div>
+
+							<div className="flex flex-col gap-1">
+								<span className="text-xs text-muted-foreground">
+									{t('reports.comparison.columns.sales')}
+								</span>
+								<span className="text-base font-semibold text-foreground">
+									{item.sales.count.value}
+								</span>
+							</div>
+
+							<div className="flex flex-col gap-1">
+								<span className="text-xs text-muted-foreground">
+									{t('reports.comparison.columns.revenue')}
+								</span>
+								<span className="text-base font-semibold text-foreground">
+									{formatMoney(item.sales.value.value)}
+								</span>
+							</div>
+						</div>
+					))}
+				</div>
+			)}
+		</Card>
+	)
+}
+
+function ComparisonSkeleton({ count }: { count: number }) {
+	const cols = Math.max(1, count)
+	return (
+		<div
+			className="grid gap-4"
+			style={{ gridTemplateColumns: `repeat(${cols}, 1fr)` }}
+		>
+			{Array.from({ length: cols }).map((_, i) => (
+				<div key={`cmp-skeleton-${i}`} className="flex flex-col gap-3 rounded-lg border border-border/60 bg-muted/20 p-4">
+					<div className="flex items-center gap-2">
+						<Skeleton className="size-10 shrink-0 rounded-lg" />
+						<Skeleton className="h-4 flex-1" />
+					</div>
+					<Skeleton className="h-3 w-12" />
+					<Skeleton className="h-5 w-20" />
+					<Skeleton className="h-3 w-12" />
+					<Skeleton className="h-5 w-24" />
+				</div>
+			))}
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/(app)/reports/-components/PeriodTargetCard/index.tsx b/packages/app/react/src/routes/(app)/reports/-components/PeriodTargetCard/index.tsx
new file mode 100644
index 000000000..46d30f6be
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/PeriodTargetCard/index.tsx
@@ -0,0 +1,310 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useForm } from '@tanstack/react-form'
+import { useQueryClient } from '@tanstack/react-query'
+import { toast } from 'sonner'
+import { format, differenceInCalendarDays } from 'date-fns'
+import {
+	useGetGoal,
+	useCreateGoal,
+	getGoalQueryKey,
+	GoalTypeEnum,
+	CurrencyCodeEnum,
+	createGoalMutationRequestSchema,
+	type GetGoalQueryResponse,
+	type CreateGoalMutationRequest,
+} from '@template/client-typescript/typescript'
+
+import { type DeepPartial } from '@/lib'
+import { cn } from '@/lib/utils'
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import { Field, FieldError, FieldGroup, FieldLabel } from '@/components/ui/field'
+import { Input } from '@/components/ui/input'
+import { ToggleGroup } from '@/components/ui/toggle-group'
+import { CurrencyInput } from '@/components/ui/currency-input'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { BalanceIcon } from '@/components/ui/icons'
+import { useMoney } from '@/hooks'
+
+type GoalData = NonNullable<GetGoalQueryResponse['goal']>
+
+function defaultsFromGoal(goal: GoalData | null): DeepPartial<CreateGoalMutationRequest> {
+	return {
+		type: goal?.type ?? GoalTypeEnum.REVENUE,
+		targetAmount: {
+			amountCents: goal?.targetAmount.amountCents ?? 0,
+			currency: goal?.targetAmount.currency ?? CurrencyCodeEnum.BRL,
+		},
+		from: goal?.from ? format(new Date(goal.from), 'yyyy-MM-dd') : '',
+		to: goal?.to ? format(new Date(goal.to), 'yyyy-MM-dd') : '',
+	}
+}
+
+function computeIsDirty(
+	values: DeepPartial<CreateGoalMutationRequest>,
+	goal: GoalData | null,
+): boolean {
+	if (!goal) {
+		return !!(values.targetAmount?.amountCents || values.from || values.to)
+	}
+	const originalFrom = format(new Date(goal.from), 'yyyy-MM-dd')
+	const originalTo = format(new Date(goal.to), 'yyyy-MM-dd')
+	return (
+		values.type !== goal.type ||
+		values.targetAmount?.amountCents !== goal.targetAmount.amountCents ||
+		values.targetAmount?.currency !== goal.targetAmount.currency ||
+		values.from !== originalFrom ||
+		values.to !== originalTo
+	)
+}
+
+// Receives goal as a prop; rendered with key={goal?.id ?? 'new'} so React remounts
+// the form (and TanStack Form state resets) whenever the goal changes.
+function PeriodTargetForm({ goal }: { goal: GoalData | null }) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const queryClient = useQueryClient()
+
+	const createGoal = useCreateGoal({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('reports.periodTarget.saveSuccess'))
+				queryClient.invalidateQueries({ queryKey: getGoalQueryKey() })
+			},
+		},
+	})
+
+	const form = useForm({
+		defaultValues: defaultsFromGoal(goal),
+		validators: { onChange: createGoalMutationRequestSchema },
+		onSubmit: async ({ value }) => {
+			const result = createGoalMutationRequestSchema.safeParse(value)
+			if (!result.success) return
+			await createGoal.mutateAsync({ data: result.data })
+		},
+	})
+
+	return (
+		<form
+			noValidate
+			className="flex flex-col gap-4"
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+		>
+			{/* Unsaved changes banner */}
+			<form.Subscribe selector={s => s.values}>
+				{values => {
+					const isDirty = computeIsDirty(values, goal)
+					return isDirty ? (
+						<div className="rounded-md border border-warning/30 bg-warning/10 px-3 py-2 text-sm text-warning">
+							{t('reports.periodTarget.unsavedChanges')}
+						</div>
+					) : null
+				}}
+			</form.Subscribe>
+
+			<FieldGroup>
+				{/* Goal type — A13: ToggleGroup in enum mode */}
+				<form.Field name="type">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel>{t('reports.periodTarget.form.type')}</FieldLabel>
+								<ToggleGroup
+									enum={GoalTypeEnum}
+									i18nPrefix="enums.GoalType"
+									value={field.state.value}
+									onValueChange={field.handleChange}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				{/* Target amount — A12: CurrencyInput */}
+				<form.Field name="targetAmount">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>
+									{t('reports.periodTarget.form.targetAmount')}
+								</FieldLabel>
+								<CurrencyInput
+									amountCents={field.state.value?.amountCents ?? 0}
+									currency={field.state.value?.currency ?? CurrencyCodeEnum.BRL}
+									onAmountChange={cents =>
+										field.handleChange({ ...field.state.value, amountCents: cents })
+									}
+									onCurrencyChange={c =>
+										field.handleChange({ ...field.state.value, currency: c })
+									}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				<div className="grid grid-cols-2 gap-3">
+					{/* From date */}
+					<form.Field name="from">
+						{field => {
+							const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+							return (
+								<Field>
+									<FieldLabel htmlFor={field.name}>
+										{t('reports.periodTarget.form.from')}
+									</FieldLabel>
+									<Input
+										id={field.name}
+										type="date"
+										value={field.state.value ?? ''}
+										onBlur={field.handleBlur}
+										onChange={e => field.handleChange(e.target.value)}
+										aria-invalid={isInvalid}
+									/>
+									{isInvalid && <FieldError errors={field.state.meta.errors} />}
+								</Field>
+							)
+						}}
+					</form.Field>
+
+					{/* To date */}
+					<form.Field name="to">
+						{field => {
+							const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+							return (
+								<Field>
+									<FieldLabel htmlFor={field.name}>
+										{t('reports.periodTarget.form.to')}
+									</FieldLabel>
+									<Input
+										id={field.name}
+										type="date"
+										value={field.state.value ?? ''}
+										onBlur={field.handleBlur}
+										onChange={e => field.handleChange(e.target.value)}
+										aria-invalid={isInvalid}
+									/>
+									{isInvalid && <FieldError errors={field.state.meta.errors} />}
+								</Field>
+							)
+						}}
+					</form.Field>
+				</div>
+			</FieldGroup>
+
+			{/* Live preview: daily run-rate */}
+			<form.Subscribe
+				selector={s => ({
+					amountCents: s.values.targetAmount?.amountCents ?? 0,
+					currency: s.values.targetAmount?.currency ?? CurrencyCodeEnum.BRL,
+					from: s.values.from ?? '',
+					to: s.values.to ?? '',
+				})}
+			>
+				{({ amountCents, currency, from, to }) => {
+					const fromDate = from ? new Date(from) : null
+					const toDate = to ? new Date(to) : null
+					const days =
+						fromDate && toDate
+							? Math.max(1, differenceInCalendarDays(toDate, fromDate) + 1)
+							: 1
+					const dailyRateCents = amountCents > 0 ? Math.round(amountCents / days) : 0
+					return dailyRateCents > 0 ? (
+						<div className="rounded-md border border-border/60 bg-muted/30 px-3 py-2 text-sm text-muted-foreground">
+							{t('reports.periodTarget.dailyRunRate', {
+								value: formatMoney({ amountCents: dailyRateCents, currency }),
+							})}
+						</div>
+					) : null
+				}}
+			</form.Subscribe>
+
+			{/* Submit button — safeParse-driven */}
+			<form.Subscribe
+				selector={s => ({
+					canSubmit: s.canSubmit,
+					isSubmitting: s.isSubmitting,
+					values: s.values,
+				})}
+			>
+				{({ canSubmit, isSubmitting, values }) => {
+					const isPending = isSubmitting || createGoal.isPending
+					const isDisabled =
+						!canSubmit ||
+						isPending ||
+						!createGoalMutationRequestSchema.safeParse(values).success
+					return (
+						<Button type="submit" disabled={isDisabled} className="w-full">
+							{isPending && <Spinner className="mr-2" />}
+							{t('reports.periodTarget.form.save')}
+						</Button>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+export function PeriodTargetCard({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { data: goalData, isPending: isGoalPending } = useGetGoal()
+	const goal = goalData?.goal ?? null
+
+	return (
+		<Card className={cn('flex flex-col gap-4 p-6', className)} {...props}>
+			<div className="flex items-center gap-4">
+				<GradientIconBadge icon={BalanceIcon} />
+				<span className="flex-1 text-lg font-medium text-muted-foreground">
+					{t('reports.periodTarget.title')}
+				</span>
+			</div>
+
+			<div className="border-t border-border/60" />
+
+			{isGoalPending ? (
+				<PeriodTargetSkeleton />
+			) : (
+				// key causes a fresh TanStack Form mount whenever the loaded goal changes
+				<PeriodTargetForm key={goal?.id ?? 'new'} goal={goal} />
+			)}
+		</Card>
+	)
+}
+
+function PeriodTargetSkeleton() {
+	return (
+		<div className="flex flex-col gap-4">
+			<div className="flex flex-col gap-2">
+				<Skeleton className="h-4 w-16" />
+				<Skeleton className="h-9 w-full" />
+			</div>
+			<div className="flex flex-col gap-2">
+				<Skeleton className="h-4 w-24" />
+				<Skeleton className="h-9 w-full" />
+			</div>
+			<div className="grid grid-cols-2 gap-3">
+				<div className="flex flex-col gap-2">
+					<Skeleton className="h-4 w-16" />
+					<Skeleton className="h-9 w-full" />
+				</div>
+				<div className="flex flex-col gap-2">
+					<Skeleton className="h-4 w-16" />
+					<Skeleton className="h-9 w-full" />
+				</div>
+			</div>
+			<Skeleton className="h-9 w-full" />
+		</div>
+	)
+}
