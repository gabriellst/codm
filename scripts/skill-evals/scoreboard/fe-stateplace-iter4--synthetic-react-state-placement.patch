@@ -0,0 +1,89 @@
+import { createFileRoute, getRouteApi } from '@tanstack/react-router'
+import { endOfDay, startOfDay, subDays } from 'date-fns'
+import { z } from 'zod'
+import { useTranslation } from 'react-i18next'
+import { getChartQueryParamsSchema, AnalyticsFrequencyEnum } from '@template/client-typescript/typescript'
+
+import { Button } from '@/components/ui/button'
+import { useReportsStore } from './-stores/useReportsStore'
+import { RevenueTrendSection } from './-components/RevenueTrendSection'
+import { TopProductsSection } from './-components/TopProductsSection'
+import { PeriodTargetCard } from './-components/PeriodTargetCard'
+import { ComparisonPanel } from './-components/ComparisonPanel'
+
+// Period (startDate/endDate) and granularity (frequency) are URL state — shareable and
+// bookmarkable. tenancyScope comes from the global store. chartType is fixed to 'income'.
+// productIds (optional filter) stays in the URL so it can be deep-linked.
+export const reportsSearchSchema = getChartQueryParamsSchema
+	.omit({ tenancyScope: true, chartType: true, startDate: true, endDate: true, frequency: true })
+	.and(
+		z.object({
+			startDate: z.string().default(() => startOfDay(subDays(new Date(), 29)).toISOString()),
+			endDate: z.string().default(() => endOfDay(new Date()).toISOString()),
+			// CORRECT: .optional().default() ordering per route skill
+			frequency: z
+				.enum([
+					AnalyticsFrequencyEnum.HOURLY,
+					AnalyticsFrequencyEnum.DAILY,
+					AnalyticsFrequencyEnum.WEEKLY,
+					AnalyticsFrequencyEnum.MONTHLY,
+					AnalyticsFrequencyEnum.YEARLY,
+				])
+				.optional()
+				.default(AnalyticsFrequencyEnum.DAILY),
+		}),
+	)
+
+export type ReportsSearchParams = z.infer<typeof reportsSearchSchema>
+
+export const Route = createFileRoute('/(app)/reports/')({
+	staticData: { breadcrumb: 'reports.breadcrumb' },
+	validateSearch: search => reportsSearchSchema.parse(search ?? {}),
+	component: RouteComponent,
+})
+
+function RouteComponent() {
+	return <ReportsPage />
+}
+
+function ReportsPage() {
+	const { t } = useTranslation()
+	const comparisonBasket = useReportsStore(s => s.comparisonBasket)
+	const clearBasket = useReportsStore(s => s.clearBasket)
+
+	return (
+		<div className="flex flex-1 flex-col gap-6 overflow-y-auto p-6 md:p-8">
+			<header className="flex flex-wrap items-center justify-between gap-4">
+				<h1 className="text-2xl font-bold text-foreground">{t('reports.title')}</h1>
+				{comparisonBasket.length > 0 && (
+					<div className="flex items-center gap-2 rounded-lg border border-border bg-muted/40 px-3 py-1.5 text-sm">
+						<span className="font-medium text-foreground">
+							{t('reports.comparison.basketCount', { count: comparisonBasket.length })}
+						</span>
+						<Button
+							variant="ghost"
+							size="sm"
+							className="h-auto px-2 py-0.5 text-xs"
+							onClick={clearBasket}
+							aria-label={t('reports.comparison.clearBasketAria')}
+						>
+							{t('reports.comparison.clearBasket')}
+						</Button>
+					</div>
+				)}
+			</header>
+
+			<RevenueTrendSection />
+
+			<div className="grid grid-cols-1 gap-6 xl:grid-cols-2">
+				<TopProductsSection />
+				<PeriodTargetCard />
+			</div>
+
+			{comparisonBasket.length > 0 && <ComparisonPanel />}
+		</div>
+	)
+}
+
+// Re-export routeApi so components in this route can use it without referencing the string id.
+export const routeApi = getRouteApi('/(app)/reports/')
