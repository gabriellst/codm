@@ -0,0 +1,165 @@
+import { useMemo } from 'react'
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { format } from 'date-fns'
+import { AreaChart, Area, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer } from 'recharts'
+import {
+	useGetChart,
+	AnalyticsFrequencyEnum,
+	type AnalyticsFrequency,
+} from '@template/client-typescript/typescript'
+
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { ToggleGroup } from '@/components/ui/toggle-group'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { BarGraphIcon } from '@/components/ui/icons'
+import { cn } from '@/lib/utils'
+import { useTenancyStore } from '@/stores'
+import { useMoney } from '@/hooks'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+interface ChartPoint {
+	label: string
+	revenueCents: number
+}
+
+function formatTimestampLabel(timestamp: string, frequency: AnalyticsFrequency): string {
+	try {
+		const d = new Date(timestamp)
+		if (frequency === AnalyticsFrequencyEnum.HOURLY) return format(d, 'HH:mm')
+		if (frequency === AnalyticsFrequencyEnum.MONTHLY) return format(d, 'MMM yy')
+		if (frequency === AnalyticsFrequencyEnum.YEARLY) return format(d, 'yyyy')
+		if (frequency === AnalyticsFrequencyEnum.WEEKLY) return format(d, 'dd/MM')
+		return format(d, 'dd/MM')
+	} catch {
+		return timestamp
+	}
+}
+
+export function RevenueTrendSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const navigate = routeApi.useNavigate()
+	const { startDate, endDate, frequency, productIds } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+	const formatMoney = useMoney()
+
+	const { data, isPending, isError } = useGetChart({
+		chartType: 'income',
+		tenancyScope,
+		frequency: frequency ?? AnalyticsFrequencyEnum.DAILY,
+		startDate,
+		endDate,
+		productIds,
+	})
+
+	const points = useMemo((): ChartPoint[] => {
+		if (!data || data.kind !== 'income') return []
+		return data.buckets.map(b => ({
+			label: formatTimestampLabel(b.timestamp, frequency ?? AnalyticsFrequencyEnum.DAILY),
+			revenueCents: b.revenue.amountCents,
+		}))
+	}, [data, frequency])
+
+	const currency = data?.currency ?? 'BRL'
+
+	function handleFrequencyChange(next: AnalyticsFrequency) {
+		navigate({ search: prev => ({ ...prev, frequency: next }) })
+	}
+
+	return (
+		<Card className={cn('flex flex-col gap-4 p-6', className)} {...props}>
+			<div className="flex flex-wrap items-center gap-3">
+				<GradientIconBadge icon={BarGraphIcon} />
+				<span className="flex-1 text-lg font-medium text-muted-foreground">
+					{t('reports.revenueTrend.title')}
+				</span>
+				<ToggleGroup
+					enum={AnalyticsFrequencyEnum}
+					i18nPrefix="enums.AnalyticsFrequency"
+					value={frequency ?? AnalyticsFrequencyEnum.DAILY}
+					onValueChange={handleFrequencyChange}
+					size="sm"
+					aria-label={t('reports.revenueTrend.frequencyAria')}
+				/>
+			</div>
+
+			<div className="min-h-[16rem]">
+				{isPending ? (
+					<Skeleton className="h-64 w-full rounded-lg" />
+				) : isError || points.length === 0 ? (
+					<div className="flex h-64 items-center justify-center text-sm text-muted-foreground">
+						{isError ? t('reports.revenueTrend.loadError') : t('reports.revenueTrend.empty')}
+					</div>
+				) : (
+					<ResponsiveContainer width="100%" height={256}>
+						<AreaChart data={points} margin={{ top: 8, right: 8, left: 8, bottom: 8 }}>
+							<defs>
+								<linearGradient id="revenueGradient" x1="0" y1="0" x2="0" y2="1">
+									<stop offset="5%" stopColor="var(--primary)" stopOpacity={0.2} />
+									<stop offset="95%" stopColor="var(--primary)" stopOpacity={0} />
+								</linearGradient>
+							</defs>
+							<CartesianGrid strokeDasharray="4 4" stroke="color-mix(in oklch, var(--border) 60%, transparent)" />
+							<XAxis
+								dataKey="label"
+								tick={{ fontSize: 11, fill: 'color-mix(in oklch, var(--muted-foreground) 70%, transparent)' }}
+								axisLine={false}
+								tickLine={false}
+								interval="preserveStartEnd"
+							/>
+							<YAxis
+								tickFormatter={v => {
+									const n = Number(v) / 100
+									if (Math.abs(n) >= 1000) return `${(n / 1000).toFixed(0)}k`
+									return n.toFixed(0)
+								}}
+								tick={{ fontSize: 11, fill: 'color-mix(in oklch, var(--muted-foreground) 70%, transparent)' }}
+								axisLine={false}
+								tickLine={false}
+								width={56}
+							/>
+							<Tooltip
+								formatter={(value: unknown) =>
+									typeof value === 'number'
+										? formatMoney({ amountCents: value, currency })
+										: String(value ?? '')
+								}
+								contentStyle={{
+									background: 'var(--card)',
+									border: '1px solid var(--border)',
+									borderRadius: '8px',
+									fontSize: 12,
+								}}
+								labelStyle={{ color: 'var(--foreground)', fontWeight: 600 }}
+								itemStyle={{ color: 'var(--primary)' }}
+								cursor={{ stroke: 'color-mix(in oklch, var(--border) 80%, transparent)' }}
+							/>
+							<Area
+								type="monotone"
+								dataKey="revenueCents"
+								name={t('reports.revenueTrend.legend.revenue')}
+								stroke="var(--primary)"
+								strokeWidth={2.5}
+								fill="url(#revenueGradient)"
+								dot={false}
+								activeDot={{ r: 4, fill: 'var(--primary)' }}
+							/>
+						</AreaChart>
+					</ResponsiveContainer>
+				)}
+			</div>
+
+			{!isPending && !isError && points.length > 0 && (
+				<div className="flex items-center gap-4 text-xs text-muted-foreground">
+					<span className="flex items-center gap-1.5">
+						<span className="inline-block size-2.5 rounded-sm bg-[var(--primary)]" />
+						{t('reports.revenueTrend.legend.revenue')}
+					</span>
+				</div>
+			)}
+		</Card>
+	)
+}
