+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useListQuickProductRanking } from '@template/client-typescript/typescript'
+
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Switch } from '@/components/ui/switch'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { StarIcon } from '@/components/ui/icons'
+import {
+	Table,
+	TableBody,
+	TableCell,
+	TableHead,
+	TableHeader,
+	TableRow,
+} from '@/components/ui/table'
+import { cn } from '@/lib/utils'
+import { useTenancyStore } from '@/stores'
+import { useMoney } from '@/hooks'
+import { useReportsStore } from '../../-stores/useReportsStore'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+const SKELETON_COUNT = 5
+
+export function TopProductsSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const { startDate, endDate, productIds } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+	const comparisonBasket = useReportsStore(s => s.comparisonBasket)
+	const toggleComparison = useReportsStore(s => s.toggleComparison)
+
+	const { data, isPending, isError } = useListQuickProductRanking({
+		tenancyScope,
+		startDate,
+		endDate,
+		productIds,
+	})
+
+	return (
+		<Card className={cn('flex flex-col gap-4 p-6', className)} {...props}>
+			<div className="flex items-center gap-4">
+				<GradientIconBadge icon={StarIcon} />
+				<div className="flex min-w-0 flex-1 flex-col gap-1">
+					<span className="text-lg font-medium text-muted-foreground">
+						{t('reports.topProducts.title')}
+					</span>
+					{!isPending && data && (
+						<span className="text-sm text-muted-foreground">
+							{t('reports.topProducts.totalProducts', { count: data.totalProducts })}
+						</span>
+					)}
+				</div>
+			</div>
+
+			<div className="border-t border-border/60" />
+
+			{isPending ? (
+				<div className="flex flex-col gap-2">
+					{Array.from({ length: SKELETON_COUNT }).map((_, i) => (
+						<div key={`skeleton-${i}`} className="flex items-center gap-3 py-2">
+							<Skeleton className="h-4 w-4 shrink-0" />
+							<Skeleton className="size-8 shrink-0 rounded-lg" />
+							<Skeleton className="h-4 flex-1" />
+							<Skeleton className="h-4 w-20 shrink-0" />
+							<Skeleton className="h-5 w-9 shrink-0 rounded-full" />
+						</div>
+					))}
+				</div>
+			) : isError ? (
+				<p className="text-sm text-muted-foreground">{t('reports.topProducts.loadError')}</p>
+			) : !data || data.items.length === 0 ? (
+				<p className="text-sm text-muted-foreground">{t('reports.topProducts.empty')}</p>
+			) : (
+				<Table>
+					<TableHeader>
+						<TableRow>
+							<TableHead className="w-8 px-2 py-2">#</TableHead>
+							<TableHead className="py-2">{t('reports.topProducts.columns.name')}</TableHead>
+							<TableHead className="py-2 text-right">
+								{t('reports.topProducts.columns.sales')}
+							</TableHead>
+							<TableHead className="py-2 text-right">
+								{t('reports.topProducts.columns.revenue')}
+							</TableHead>
+							<TableHead className="py-2 text-center">
+								{t('reports.topProducts.columns.compare')}
+							</TableHead>
+						</TableRow>
+					</TableHeader>
+					<TableBody
+						role="list"
+						aria-label={t('reports.topProducts.listAria')}
+					>
+						{data.items.map((item, index) => {
+							const isSelected = comparisonBasket.includes(item.productId)
+							return (
+								<TableRow
+									key={item.productId}
+									role="listitem"
+									aria-label={`${item.name}`}
+									className={cn(isSelected && 'bg-primary/5')}
+								>
+									<TableCell className="px-2 py-3 text-sm text-muted-foreground">
+										{index + 1}
+									</TableCell>
+									<TableCell className="py-3">
+										<div className="flex items-center gap-2">
+											{item.imageUrl ? (
+												<img
+													src={item.imageUrl}
+													alt=""
+													className="size-8 shrink-0 rounded-lg object-cover"
+												/>
+											) : (
+												<div className="size-8 shrink-0 rounded-lg bg-muted" />
+											)}
+											<span className="max-w-[140px] truncate text-sm font-medium text-foreground">
+												{item.name}
+											</span>
+										</div>
+									</TableCell>
+									<TableCell className="py-3 text-right text-sm text-muted-foreground">
+										{item.sales.count.value}
+									</TableCell>
+									<TableCell className="py-3 text-right text-sm font-medium text-foreground">
+										{formatMoney(item.sales.value.value)}
+									</TableCell>
+									<TableCell className="py-3 text-center">
+										<Switch
+											checked={isSelected}
+											onCheckedChange={() => toggleComparison(item.productId)}
+											aria-label={t('reports.topProducts.compareToggleAria', {
+												name: item.name,
+											})}
+										/>
+									</TableCell>
+								</TableRow>
+							)
+						})}
+					</TableBody>
+				</Table>
+			)}
+		</Card>
+	)
+}
