+import { useMemo } from 'react'
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { ParentSize } from '@visx/responsive'
+import { Group } from '@visx/group'
+import { Bar, LinePath } from '@visx/shape'
+import { scaleBand, scaleLinear } from '@visx/scale'
+import { AxisBottom, AxisLeft } from '@visx/axis'
+import { GridRows } from '@visx/grid'
+import { curveMonotoneX } from '@visx/curve'
+
+import {
+	useGetChart,
+	AnalyticsFrequencyEnum,
+	type AnalyticsFrequency,
+} from '@template/client-typescript/typescript'
+import type { SignedMoney } from '@template/client-typescript/typescript'
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Select } from '@/components/ui/select'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { BarGraphIcon } from '@/components/ui/icons'
+import { cn } from '@/lib/utils'
+import { useTenancyStore } from '@/stores'
+import { useMoney, useLocale } from '@/hooks'
+import { type Locale, DEFAULT_LOCALE } from '@/lib/locale'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+const COLOR_REVENUE = 'var(--primary)'
+const COLOR_PROFIT = 'var(--success)'
+const COLOR_DESTRUCTIVE = 'var(--destructive)'
+const COLOR_AXIS = 'color-mix(in oklch, var(--muted-foreground) 60%, transparent)'
+const COLOR_GRID = 'color-mix(in oklch, var(--border) 60%, transparent)'
+const MARGIN = { top: 16, right: 8, bottom: 40, left: 64 }
+
+interface IncomeBucket {
+	label: string
+	revenue: SignedMoney
+	profit: SignedMoney
+}
+
+function centsToMajor(amountCents: number): number {
+	return amountCents / 100
+}
+
+function bucketLabel(timestamp: string, locale: Locale = DEFAULT_LOCALE): string {
+	try {
+		return new Date(timestamp).toLocaleDateString(locale, { day: '2-digit', month: '2-digit' })
+	} catch {
+		return timestamp
+	}
+}
+
+interface TrendCanvasProps {
+	buckets: IncomeBucket[]
+}
+
+function TrendCanvas({ buckets }: TrendCanvasProps) {
+	return (
+		<div className="relative h-64 w-full">
+			<ParentSize>
+				{({ width, height }) => {
+					if (width === 0 || height === 0 || buckets.length === 0) return null
+
+					const innerWidth = width - MARGIN.left - MARGIN.right
+					const innerHeight = height - MARGIN.top - MARGIN.bottom
+
+					const xScale = scaleBand<string>({
+						domain: buckets.map(b => b.label),
+						range: [0, innerWidth],
+						padding: 0.3,
+					})
+
+					const maxRevenue = Math.max(1, ...buckets.map(b => centsToMajor(b.revenue.amountCents)))
+					const minProfit = Math.min(0, ...buckets.map(b => centsToMajor(b.profit.amountCents)))
+					const maxProfit = Math.max(0, ...buckets.map(b => centsToMajor(b.profit.amountCents)))
+					const yMax = Math.max(maxRevenue, maxProfit) * 1.15
+					const yMin = Math.min(0, minProfit * 1.15)
+
+					const yScale = scaleLinear<number>({
+						domain: [yMin, yMax],
+						range: [innerHeight, 0],
+						nice: true,
+					})
+
+					const barWidth = xScale.bandwidth()
+					const halfBar = barWidth / 2
+
+					return (
+						<svg width={width} height={height} role="img">
+							<Group top={MARGIN.top} left={MARGIN.left}>
+								<GridRows scale={yScale} width={innerWidth} stroke={COLOR_GRID} strokeWidth={1} numTicks={5} strokeDasharray="4 4" />
+
+								{buckets.map(bucket => {
+									const x0 = xScale(bucket.label) ?? 0
+									const revValue = centsToMajor(bucket.revenue.amountCents)
+									const profitValue = centsToMajor(bucket.profit.amountCents)
+
+									const revY = yScale(Math.max(revValue, 0))
+									const revH = Math.abs(yScale(0) - yScale(revValue))
+
+									const profitY = profitValue >= 0 ? yScale(profitValue) : yScale(0)
+									const profitH = Math.abs(yScale(0) - yScale(profitValue))
+
+									const profW = halfBar * 0.85
+
+									return (
+										<Group key={bucket.label}>
+											<Bar x={x0} y={revY} width={halfBar} height={revH} fill={COLOR_REVENUE} rx={3} />
+											<Bar
+												x={x0 + halfBar * 1.1}
+												y={profitY}
+												width={profW}
+												height={profitH}
+												fill={profitValue >= 0 ? COLOR_PROFIT : COLOR_DESTRUCTIVE}
+												rx={3}
+											/>
+										</Group>
+									)
+								})}
+
+								{/* Revenue trend line overlay */}
+								<LinePath<IncomeBucket>
+									data={buckets}
+									x={b => (xScale(b.label) ?? 0) + halfBar / 2}
+									y={b => yScale(centsToMajor(b.revenue.amountCents))}
+									stroke={COLOR_REVENUE}
+									strokeWidth={1.5}
+									strokeOpacity={0.4}
+									curve={curveMonotoneX}
+								/>
+
+								<AxisBottom
+									top={innerHeight}
+									scale={xScale}
+									stroke={COLOR_AXIS}
+									tickStroke={COLOR_AXIS}
+									tickLabelProps={() => ({ fill: COLOR_AXIS, fontSize: 11, textAnchor: 'middle' })}
+									tickLength={3}
+									numTicks={Math.min(buckets.length, 8)}
+								/>
+
+								<AxisLeft
+									scale={yScale}
+									stroke={COLOR_AXIS}
+									tickStroke={COLOR_AXIS}
+									tickLabelProps={() => ({ fill: COLOR_AXIS, fontSize: 11, textAnchor: 'end', dx: '-0.25em', dy: '0.3em' })}
+									tickLength={3}
+									numTicks={5}
+									tickFormat={v => {
+										const n = Number(v)
+										if (Math.abs(n) >= 1000) return `${(n / 1000).toFixed(0)}k`
+										return String(n.toFixed(0))
+									}}
+								/>
+							</Group>
+						</svg>
+					)
+				}}
+			</ParentSize>
+		</div>
+	)
+}
+
+export function RevenueTrendSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const navigate = routeApi.useNavigate()
+	const { startDate, endDate, frequency } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+	const formatMoney = useMoney()
+	const locale = useLocale()
+
+	const { data, isPending, isError } = useGetChart({
+		chartType: 'income',
+		tenancyScope,
+		frequency: (frequency ?? AnalyticsFrequencyEnum.DAILY) as AnalyticsFrequency,
+		startDate,
+		endDate,
+	})
+
+	const buckets = useMemo((): IncomeBucket[] => {
+		if (!data || data.kind !== 'income') return []
+		return data.buckets.map(b => ({
+			label: bucketLabel(b.timestamp, locale),
+			revenue: b.revenue,
+			profit: b.profit,
+		}))
+	}, [data, locale])
+
+	function handleFrequencyChange(v: AnalyticsFrequency) {
+		navigate({ search: prev => ({ ...prev, frequency: v }) })
+	}
+
+	return (
+		<Card className={cn('flex flex-col gap-4 p-6', className)} {...props}>
+			<div className="flex items-center gap-3">
+				<GradientIconBadge icon={BarGraphIcon} />
+				<span className="flex-1 text-lg font-medium text-muted-foreground">{t('reports.revenueTrend.title')}</span>
+				<Select
+					enum={AnalyticsFrequencyEnum}
+					i18nPrefix="enums.AnalyticsFrequency"
+					value={(frequency ?? AnalyticsFrequencyEnum.DAILY) as AnalyticsFrequency}
+					onValueChange={handleFrequencyChange}
+					aria-label={t('reports.revenueTrend.frequency')}
+				/>
+			</div>
+
+			<div className="min-h-[16rem]">
+				{isPending ? (
+					<Skeleton className="h-64 w-full rounded-lg" />
+				) : isError || buckets.length === 0 ? (
+					<div className="flex h-64 items-center justify-center text-sm text-muted-foreground">
+						{isError ? t('reports.revenueTrend.loadError') : t('reports.revenueTrend.empty')}
+					</div>
+				) : (
+					<TrendCanvas buckets={buckets} />
+				)}
+			</div>
+
+			{!isPending && !isError && buckets.length > 0 && (
+				<div className="flex items-center gap-4 text-xs text-muted-foreground">
+					<span className="flex items-center gap-1.5">
+						<span className="inline-block size-2.5 rounded-sm bg-[var(--primary)]" />
+						{t('reports.revenueTrend.legend.revenue')}
+					</span>
+					<span className="flex items-center gap-1.5">
+						<span className="inline-block size-2.5 rounded-sm bg-[var(--success)]" />
+						{t('reports.revenueTrend.legend.profit')}
+					</span>
+					{data && data.kind === 'income' && (
+						<span className="ml-auto text-xs">
+							{formatMoney({ amountCents: buckets.reduce((s, b) => s + b.revenue.amountCents, 0), currency: data.currency })}
+						</span>
+					)}
+				</div>
+			)}
+		</Card>
+	)
+}
