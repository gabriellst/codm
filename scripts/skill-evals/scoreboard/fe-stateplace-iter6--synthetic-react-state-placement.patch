+						<TableHead>{t('reports.topProducts.columns.name')}</TableHead>
+						<TableHead className="text-right">{t('reports.topProducts.columns.sales')}</TableHead>
+						<TableHead className="text-right">{t('reports.topProducts.columns.revenue')}</TableHead>
