--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/PeriodTargetCard/index.tsx
@@ -0,0 +1,299 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useForm } from '@tanstack/react-form'
+import { useQueryClient } from '@tanstack/react-query'
+import { toast } from 'sonner'
+import {
+	useGetGoal,
+	useCreateGoal,
+	getGoalQueryKey,
+	createGoalMutationRequestSchema,
+	GoalTypeEnum,
+	type CurrencyCodeEnumKey,
+	type GetGoalQueryResponse,
+	type CreateGoalMutationRequest,
+} from '@template/client-typescript/typescript'
+
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import { Select } from '@/components/ui/select'
+import { CurrencyInput } from '@/components/ui/currency-input'
+import { DatePicker } from '@/components/ui/date-picker'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { StarIcon } from '@/components/ui/icons'
+import { FieldError, FieldGroup, FieldLabel } from '@/components/ui/field'
+import { cn } from '@/lib/utils'
+import { type DeepPartial } from '@/lib'
+import { useMoney } from '@/hooks'
+
+type GoalData = NonNullable<GetGoalQueryResponse['goal']>
+
+function normDateStr(iso: string | undefined): string {
+	if (!iso) return ''
+	try {
+		return new Date(iso).toISOString().slice(0, 10)
+	} catch {
+		return iso
+	}
+}
+
+function daysBetween(from: string | undefined, to: string | undefined): number {
+	if (!from || !to) return 1
+	try {
+		const diff = new Date(to).getTime() - new Date(from).getTime()
+		return Math.max(1, Math.round(diff / (1000 * 60 * 60 * 24)))
+	} catch {
+		return 1
+	}
+}
+
+// ─── Skeleton ────────────────────────────────────────────────────────────────
+
+function GoalFormSkeleton() {
+	return (
+		<div className="flex flex-col gap-4">
+			<Skeleton className="h-4 w-32" />
+			<Skeleton className="h-9 w-full" />
+			<Skeleton className="h-9 w-full" />
+			<div className="grid grid-cols-2 gap-3">
+				<Skeleton className="h-9" />
+				<Skeleton className="h-9" />
+			</div>
+			<Skeleton className="h-9 w-full" />
+		</div>
+	)
+}
+
+// ─── Inner form (only mounts after goal data resolves) ────────────────────────
+
+interface GoalFormProps {
+	goal: GoalData | null
+}
+
+function GoalForm({ goal }: GoalFormProps) {
+	const { t } = useTranslation()
+	const queryClient = useQueryClient()
+	const formatMoney = useMoney()
+
+	const invalidateGoal = () => {
+		queryClient.invalidateQueries({ queryKey: getGoalQueryKey() })
+	}
+
+	const createGoal = useCreateGoal({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('reports.periodTarget.saveSuccess'))
+				invalidateGoal()
+			},
+		},
+	})
+
+	const defaultValues: DeepPartial<CreateGoalMutationRequest> = goal
+		? {
+				type: goal.type,
+				targetAmount: {
+					amountCents: goal.targetAmount.amountCents,
+					currency: goal.targetAmount.currency,
+				},
+				from: goal.from,
+				to: goal.to,
+			}
+		: {}
+
+	const form = useForm({
+		defaultValues,
+		validators: {
+			onChange: createGoalMutationRequestSchema,
+		},
+		onSubmit: async form => {
+			const result = createGoalMutationRequestSchema.safeParse(form.value)
+			if (!result.success) return
+			await createGoal.mutateAsync({ data: result.data })
+		},
+	})
+
+	return (
+		<form
+			className="flex flex-col gap-4"
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+		>
+			{/* Unsaved changes banner — reactive via Subscribe */}
+			<form.Subscribe
+				selector={state => ({
+					from: state.values.from,
+					to: state.values.to,
+					type: state.values.type,
+					amountCents: state.values.targetAmount?.amountCents,
+					currency: state.values.targetAmount?.currency,
+				})}
+			>
+				{values => {
+					const hasChanges = goal
+						? values.type !== goal.type ||
+							(values.amountCents ?? 0) !== goal.targetAmount.amountCents ||
+							values.currency !== goal.targetAmount.currency ||
+							normDateStr(values.from) !== normDateStr(goal.from) ||
+							normDateStr(values.to) !== normDateStr(goal.to)
+						: !!(values.type || (values.amountCents ?? 0) > 0 || values.from || values.to)
+
+					return hasChanges ? (
+						<div
+							className="rounded-md border px-3 py-2 text-xs font-medium"
+							style={{
+								background: 'color-mix(in oklch, var(--destructive) 8%, transparent)',
+								borderColor: 'color-mix(in oklch, var(--destructive) 25%, transparent)',
+								color: 'var(--destructive)',
+							}}
+						>
+							{t('reports.periodTarget.form.unsavedChanges')}
+						</div>
+					) : null
+				}}
+			</form.Subscribe>
+
+			{/* Type selector */}
+			<form.Field name="type">
+				{field => {
+					const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+					return (
+						<FieldGroup>
+							<FieldLabel htmlFor={field.name}>{t('reports.periodTarget.form.type')}</FieldLabel>
+							<Select
+								enum={GoalTypeEnum}
+								i18nPrefix="enums.GoalType"
+								value={field.state.value}
+								onValueChange={field.handleChange}
+								id={field.name}
+								aria-invalid={isInvalid}
+							/>
+							{isInvalid && <FieldError errors={field.state.meta.errors} />}
+						</FieldGroup>
+					)
+				}}
+			</form.Field>
+
+			{/* Target amount (currency + cents) */}
+			<form.Field name="targetAmount">
+				{field => (
+					<FieldGroup>
+						<FieldLabel>{t('reports.periodTarget.form.targetAmount')}</FieldLabel>
+						<CurrencyInput
+							amountCents={field.state.value?.amountCents ?? 0}
+							currency={(field.state.value?.currency as CurrencyCodeEnumKey) || ('BRL' as CurrencyCodeEnumKey)}
+							onAmountChange={cents =>
+								field.handleChange({ ...field.state.value, amountCents: cents } as CreateGoalMutationRequest['targetAmount'])
+							}
+							onCurrencyChange={c =>
+								field.handleChange({ ...field.state.value, currency: c } as CreateGoalMutationRequest['targetAmount'])
+							}
+						/>
+						{field.state.meta.isTouched && !field.state.meta.isValid && (
+							<FieldError errors={field.state.meta.errors} />
+						)}
+					</FieldGroup>
+				)}
+			</form.Field>
+
+			{/* Date range */}
+			<div className="grid grid-cols-2 gap-3">
+				<form.Field name="from">
+					{field => (
+						<FieldGroup>
+							<FieldLabel>{t('reports.periodTarget.form.from')}</FieldLabel>
+							<DatePicker
+								date={field.state.value ? new Date(field.state.value as string) : undefined}
+								onDateChange={date => field.handleChange(date ? date.toISOString() : ('' as string))}
+								size="sm"
+							/>
+						</FieldGroup>
+					)}
+				</form.Field>
+
+				<form.Field name="to">
+					{field => (
+						<FieldGroup>
+							<FieldLabel>{t('reports.periodTarget.form.to')}</FieldLabel>
+							<DatePicker
+								date={field.state.value ? new Date(field.state.value as string) : undefined}
+								onDateChange={date => field.handleChange(date ? date.toISOString() : ('' as string))}
+								size="sm"
+							/>
+						</FieldGroup>
+					)}
+				</form.Field>
+			</div>
+
+			{/* Live daily run-rate preview */}
+			<form.Subscribe
+				selector={state => ({
+					from: state.values.from as string | undefined,
+					to: state.values.to as string | undefined,
+					amountCents: state.values.targetAmount?.amountCents,
+					currency: state.values.targetAmount?.currency,
+				})}
+			>
+				{({ from, to, amountCents, currency }) => {
+					if (!from || !to || !amountCents || !currency) return null
+					const days = daysBetween(from, to)
+					const dailyRate = Math.round(amountCents / days)
+					return (
+						<div className="flex items-center justify-between rounded-md border border-border bg-muted/30 px-3 py-2 text-sm">
+							<span className="text-muted-foreground">{t('reports.periodTarget.form.dailyRate')}</span>
+							<span className="font-semibold tabular-nums text-foreground">
+								{formatMoney({ amountCents: dailyRate, currency: currency as CurrencyCodeEnumKey })}
+							</span>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+
+			{/* Submit button */}
+			<form.Subscribe selector={state => ({ canSubmit: state.canSubmit, isSubmitting: state.isSubmitting, values: state.values })}>
+				{({ canSubmit, isSubmitting, values }) => {
+					const isPending = isSubmitting || createGoal.isPending
+					const isDisabled = !canSubmit || isPending || !createGoalMutationRequestSchema.safeParse(values).success
+					return (
+						<Button type="submit" disabled={isDisabled} className="w-full">
+							{isPending && <Spinner className="mr-2" />}
+							{t('reports.periodTarget.form.submit')}
+						</Button>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+// ─── Public card wrapper ──────────────────────────────────────────────────────
+
+export function PeriodTargetCard({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { data: goalData, isPending, isError } = useGetGoal()
+
+	const goal = goalData?.goal ?? null
+
+	return (
+		<Card className={cn('flex flex-col gap-4 p-6', className)} {...props}>
+			<div className="flex items-center gap-4">
+				<GradientIconBadge icon={StarIcon} />
+				<span className="text-muted-foreground text-lg font-medium">{t('reports.periodTarget.title')}</span>
+			</div>
+
+			<div className="border-t border-border/60" />
+
+			{isPending ? (
+				<GoalFormSkeleton />
+			) : isError ? (
+				<p className="text-sm text-muted-foreground">{t('reports.periodTarget.loadError')}</p>
+			) : (
+				<GoalForm key={goal?.id ?? 'new'} goal={goal} />
+			)}
+		</Card>
+	)
+}
