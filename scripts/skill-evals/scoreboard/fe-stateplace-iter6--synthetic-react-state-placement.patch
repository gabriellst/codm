+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+	const { comparisonBasket, toggleCompare, clearBasket } = useReportsStore()
+
+	const { data, isPending, isError } = useListQuickProductRanking({
+		tenancyScope,
+		startDate,
