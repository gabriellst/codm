+import { createFileRoute } from '@tanstack/react-router'
+import { endOfDay, startOfDay, subDays } from 'date-fns'
+import { z } from 'zod'
+import { analyticsFrequencySchema, AnalyticsFrequencyEnum } from '@template/client-typescript/typescript'
+
+import { zodValidator } from '@/lib/zod-validator'
+import { RouteError } from '@/components/RouteError'
+
+import { RevenueTrendSection } from './-components/RevenueTrendSection'
+import { TopProductsSection } from './-components/TopProductsSection'
+import { PeriodTargetCard } from './-components/PeriodTargetCard'
+
+// Period and granularity are shareable/bookmarkable → URL.
+// tenancyScope is account-level → global Zustand store (useTenancyStore), never in URL.
+// comparisonBasket is client-only → route Zustand store (useReportsStore), never in URL.
+export const reportsSearchSchema = z.object({
+	startDate: z.string().default(() => startOfDay(subDays(new Date(), 29)).toISOString()),
+	endDate: z.string().default(() => endOfDay(new Date()).toISOString()),
+	frequency: analyticsFrequencySchema.default(AnalyticsFrequencyEnum.DAILY),
+})
+
+export type ReportsSearchParams = z.infer<typeof reportsSearchSchema>
+
+export const Route = createFileRoute('/(app)/reports/')({
+	staticData: { breadcrumb: 'Relatórios' },
+	validateSearch: zodValidator(reportsSearchSchema),
+	errorComponent: RouteError,
+	component: RouteComponent,
+})
+
+function RouteComponent() {
+	return (
+		<div className="flex flex-1 flex-col gap-6 overflow-y-auto p-6 md:p-8">
+			<div className="grid grid-cols-1 gap-6 xl:grid-cols-3">
+				<div className="flex flex-col gap-6 xl:col-span-2">
+					<RevenueTrendSection />
+					<TopProductsSection />
+				</div>
+				<div>
+					<PeriodTargetCard />
+				</div>
+			</div>
+		</div>
+	)
+}
