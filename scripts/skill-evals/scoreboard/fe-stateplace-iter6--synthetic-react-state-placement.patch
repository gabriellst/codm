+import { create } from 'zustand'
+
+interface ReportsState {
+	/** productIds selected for the comparison panel — client-only, never in URL */
+	comparisonBasket: string[]
+}
+
+interface ReportsActions {
+	toggleCompare: (productId: string) => void
+	clearBasket: () => void
+}
+
+type ReportsStore = ReportsState & ReportsActions
+
+export const useReportsStore = create<ReportsStore>(set => ({
+	comparisonBasket: [],
+
+	toggleCompare: productId =>
+		set(state => ({
+			comparisonBasket: state.comparisonBasket.includes(productId)
+				? state.comparisonBasket.filter(id => id !== productId)
+				: [...state.comparisonBasket, productId],
+		})),
+
+	clearBasket: () => set({ comparisonBasket: [] }),
+}))
