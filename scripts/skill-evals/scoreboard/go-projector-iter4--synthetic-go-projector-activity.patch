+package integrationactivity
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"testing"
+	"time"
+
+	_ "github.com/jackc/pgx/v5/stdlib"
+
+	"template/api-go/internal/sync/projections"
+)
+
+func openTestDB(t *testing.T) *sql.DB {
+	t.Helper()
+	url := os.Getenv("DATABASE_URL")
+	if url == "" {
+		t.Skip("DATABASE_URL not set — skipping integration test")
+	}
+	db, err := sql.Open("pgx", url)
+	if err != nil {
+		t.Fatalf("open: %v", err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	if err := db.PingContext(ctx); err != nil {
+		_ = db.Close()
+		t.Skipf("DB unreachable — skipping: %v", err)
+	}
+	return db
+}
+
+// createTable creates the integration_activity table for the test session.
+// The table may not exist in the Drizzle schema yet (Go-only projection).
+func createTable(t *testing.T, db *sql.DB) {
+	t.Helper()
+	_, err := db.ExecContext(context.Background(), `
+		CREATE TABLE IF NOT EXISTS integration_activity (
+			store_integration_id TEXT PRIMARY KEY,
+			store_id             TEXT NOT NULL,
+			activation_count     INTEGER NOT NULL DEFAULT 0,
+			deactivation_count   INTEGER NOT NULL DEFAULT 0,
+			last_changed_at      TIMESTAMPTZ NOT NULL,
+			active               BOOLEAN NOT NULL DEFAULT FALSE,
+			last_event_id        TEXT NOT NULL
+		)`)
+	if err != nil {
+		t.Fatalf("createTable: %v", err)
+	}
+	t.Cleanup(func() {
+		_, _ = db.ExecContext(context.Background(), `DROP TABLE IF EXISTS integration_activity`)
+	})
+}
+
+func TestPgIntegrationActivityRepository_InsertIfNewAndFind(t *testing.T) {
+	db := openTestDB(t)
+	defer db.Close()
+	createTable(t, db)
+
+	repo := NewPgIntegrationActivityRepository(db)
+	ctx := context.Background()
+
+	p := &projections.IntegrationActivityProjection{
+		StoreIntegrationID: "integ-1",
+		StoreID:            "store-1",
+		ActivationCount:    1,
+		LastChangedAt:      time.Now().UTC(),
+		Active:             true,
+		LastEventID:        "ev-1",
+	}
+
+	inserted, err := repo.InsertIfNew(ctx, p)
+	if err != nil {
+		t.Fatalf("InsertIfNew: %v", err)
+	}
+	if !inserted {
+		t.Fatal("expected inserted=true on first call")
+	}
+
+	// Duplicate insert must be a no-op.
+	inserted2, err := repo.InsertIfNew(ctx, p)
+	if err != nil {
+		t.Fatalf("InsertIfNew duplicate: %v", err)
+	}
+	if inserted2 {
+		t.Fatal("expected inserted=false on duplicate")
+	}
+
+	got, err := repo.FindByIntegration(ctx, "integ-1")
+	if err != nil {
+		t.Fatalf("FindByIntegration: %v", err)
+	}
+	if got == nil {
+		t.Fatal("expected row, got nil")
+	}
+	if got.ActivationCount != 1 || got.StoreID != "store-1" || !got.Active {
+		t.Errorf("round-trip mismatch: %+v", got)
+	}
+}
+
+func TestPgIntegrationActivityRepository_SaveIsIdempotentOnSameEventID(t *testing.T) {
+	db := openTestDB(t)
+	defer db.Close()
+	createTable(t, db)
+
+	repo := NewPgIntegrationActivityRepository(db)
+	ctx := context.Background()
+
+	p := &projections.IntegrationActivityProjection{
+		StoreIntegrationID: "integ-2",
+		StoreID:            "store-2",
+		ActivationCount:    1,
+		LastChangedAt:      time.Now().UTC(),
+		Active:             true,
+		LastEventID:        "ev-1",
+	}
+	if _, err := repo.InsertIfNew(ctx, p); err != nil {
+		t.Fatalf("InsertIfNew: %v", err)
+	}
+
+	// Simulate redelivery: ApplyEvent increments in memory, but same LastEventID.
+	p.ActivationCount = 2
+	// LastEventID unchanged — same event redelivered.
+	if err := repo.Save(ctx, p); err != nil {
+		t.Fatalf("Save: %v", err)
+	}
+
+	got, _ := repo.FindByIntegration(ctx, "integ-2")
+	// The WHERE clause in saveSQL skips the write when last_event_id matches.
+	if got.ActivationCount != 1 {
+		t.Fatalf("idempotency gate failed: ActivationCount = %d, want 1", got.ActivationCount)
+	}
+}
+
+func TestPgIntegrationActivityRepository_SaveAdvancesOnNewEventID(t *testing.T) {
+	db := openTestDB(t)
+	defer db.Close()
+	createTable(t, db)
+
+	repo := NewPgIntegrationActivityRepository(db)
+	ctx := context.Background()
+
+	p := &projections.IntegrationActivityProjection{
+		StoreIntegrationID: "integ-3",
+		StoreID:            "store-3",
+		ActivationCount:    1,
+		LastChangedAt:      time.Now().UTC(),
+		Active:             true,
+		LastEventID:        "ev-1",
+	}
+	if _, err := repo.InsertIfNew(ctx, p); err != nil {
+		t.Fatalf("InsertIfNew: %v", err)
+	}
+
+	p.DeactivationCount = 1
+	p.Active = false
+	p.LastEventID = "ev-2" // new event ID
+	if err := repo.Save(ctx, p); err != nil {
+		t.Fatalf("Save: %v", err)
+	}
+
+	got, _ := repo.FindByIntegration(ctx, "integ-3")
+	if got.DeactivationCount != 1 || got.Active {
+		t.Fatalf("Save did not advance state: %+v", got)
+	}
+	if got.LastEventID != "ev-2" {
+		t.Fatalf("LastEventID = %q, want ev-2", got.LastEventID)
+	}
+}
+
+func TestPgIntegrationActivityRepository_FindByIntegration_ReturnsNilWhenAbsent(t *testing.T) {
+	db := openTestDB(t)
+	defer db.Close()
+	createTable(t, db)
+
+	repo := NewPgIntegrationActivityRepository(db)
+	got, err := repo.FindByIntegration(context.Background(), "nonexistent")
+	if err != nil {
+		t.Fatalf("FindByIntegration: %v", err)
+	}
+	if got != nil {
+		t.Fatalf("expected nil, got %+v", got)
+	}
+}
