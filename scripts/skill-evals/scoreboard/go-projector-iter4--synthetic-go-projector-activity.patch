+package integrationactivity
+
+import (
+	"context"
+
+	"template/api-go/internal/sync/projections"
+)
+
+// MockIntegrationActivityRepository is an in-memory implementation for unit tests.
+type MockIntegrationActivityRepository struct {
+	rows    map[string]*projections.IntegrationActivityProjection
+	Saves   int
+	Inserts int
+}
+
+var _ IntegrationActivityRepository = (*MockIntegrationActivityRepository)(nil)
+
+func NewMockIntegrationActivityRepository() *MockIntegrationActivityRepository {
+	return &MockIntegrationActivityRepository{
+		rows: make(map[string]*projections.IntegrationActivityProjection),
+	}
+}
+
+func (r *MockIntegrationActivityRepository) FindByIntegration(_ context.Context, id string) (*projections.IntegrationActivityProjection, error) {
+	p, ok := r.rows[id]
+	if !ok {
+		return nil, nil
+	}
+	cp := *p
+	return &cp, nil
+}
+
+func (r *MockIntegrationActivityRepository) Save(_ context.Context, p *projections.IntegrationActivityProjection) error {
+	cp := *p
+	r.rows[p.StoreIntegrationID] = &cp
+	r.Saves++
+	return nil
+}
+
+func (r *MockIntegrationActivityRepository) InsertIfNew(_ context.Context, p *projections.IntegrationActivityProjection) (bool, error) {
+	if _, exists := r.rows[p.StoreIntegrationID]; exists {
+		return false, nil
+	}
+	cp := *p
+	r.rows[p.StoreIntegrationID] = &cp
+	r.Inserts++
+	return true, nil
+}
+
+// Reset clears all state. Call between tests.
+func (r *MockIntegrationActivityRepository) Reset() {
+	r.rows = make(map[string]*projections.IntegrationActivityProjection)
+	r.Saves = 0
+	r.Inserts = 0
+}
+
+// Get returns a copy of the stored row by storeIntegrationID, or nil.
+func (r *MockIntegrationActivityRepository) Get(id string) *projections.IntegrationActivityProjection {
+	p := r.rows[id]
+	if p == nil {
+		return nil
+	}
+	cp := *p
+	return &cp
+}
diff --git a/packages/api/go/internal/sync/repositories/integrationactivity/pg_integration_activity_repository.go b/packages/api/go/internal/sync/repositories/integrationactivity/pg_integration_activity_repository.go
