diff --git a/packages/api/go/internal/sync/projections/integration_activity.go b/packages/api/go/internal/sync/projections/integration_activity.go
new file mode 100644
index 000000000..4097b9d4f
--- /dev/null
+++ b/packages/api/go/internal/sync/projections/integration_activity.go
@@ -0,0 +1,55 @@
+// Package projections provides read-model structs for the sync bounded context.
+package projections
+
+import (
+	"time"
+
+	wire "template/contracts-go/wire"
+)
+
+// IntegrationActivityProjection records per-integration activation/deactivation counts.
+// Written by IntegrationActivityProjector; read by the ops dashboard.
+// No domain logic, no invariants — plain record.
+//
+// Idempotency: LastEventID is stored alongside each write. The Postgres Save
+// uses ON CONFLICT ... WHERE last_event_id IS DISTINCT FROM EXCLUDED.last_event_id,
+// so a redelivered event with the same EntityID produces no state change in the DB.
+type IntegrationActivityProjection struct {
+	StoreIntegrationID string    `db:"store_integration_id"`
+	StoreID            string    `db:"store_id"`
+	ActivationCount    int       `db:"activation_count"`
+	DeactivationCount  int       `db:"deactivation_count"`
+	LastChangedAt      time.Time `db:"last_changed_at"`
+	Active             bool      `db:"active"`
+	LastEventID        string    `db:"last_event_id"`
+}
+
+// NewIntegrationActivityProjection constructs the first row from an activation event.
+// Only valid for the creation path — subsequent events mutate via ApplyEvent.
+func NewIntegrationActivityProjection(e wire.IntegrationActivatedIntegrationEvent) *IntegrationActivityProjection {
+	return &IntegrationActivityProjection{
+		StoreIntegrationID: e.StoreIntegrationID,
+		StoreID:            e.StoreID,
+		ActivationCount:    1,
+		LastChangedAt:      e.ActivatedAt,
+		Active:             true,
+		LastEventID:        e.EntityID,
+	}
+}
+
+// ApplyEvent applies an activation or deactivation event to the projection.
+// The projector calls this after find; Save persists the result.
+func (p *IntegrationActivityProjection) ApplyEvent(event wire.IntegrationEvent) {
+	switch e := event.(type) {
+	case wire.IntegrationActivatedIntegrationEvent:
+		p.ActivationCount++
+		p.LastChangedAt = e.ActivatedAt
+		p.Active = true
+		p.LastEventID = e.EntityID
+	case wire.IntegrationDeactivatedIntegrationEvent:
+		p.DeactivationCount++
+		p.LastChangedAt = e.DeactivatedAt
+		p.Active = false
+		p.LastEventID = e.EntityID
+	}
+}
diff --git a/packages/api/go/internal/sync/projections/integration_activity_test.go b/packages/api/go/internal/sync/projections/integration_activity_test.go
