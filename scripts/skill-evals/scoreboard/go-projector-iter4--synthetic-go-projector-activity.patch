@@ -0,0 +1,95 @@
+package integrationactivity
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+
+	"template/api-go/internal/sync/projections"
+)
+
+type pgIntegrationActivityRepository struct {
+	db *sql.DB
+}
+
+// NewPgIntegrationActivityRepository constructs the Postgres implementation.
+// Returns the interface type so fx can bind directly without a wrapper.
+func NewPgIntegrationActivityRepository(db *sql.DB) IntegrationActivityRepository {
+	return &pgIntegrationActivityRepository{db: db}
+}
+
+var _ IntegrationActivityRepository = (*pgIntegrationActivityRepository)(nil)
+
+const findByIntegrationSQL = `
+SELECT store_integration_id, store_id, activation_count, deactivation_count,
+       last_changed_at, active, last_event_id
+FROM integration_activity
+WHERE store_integration_id = $1`
+
+const insertIfNewSQL = `
+INSERT INTO integration_activity
+  (store_integration_id, store_id, activation_count, deactivation_count,
+   last_changed_at, active, last_event_id)
+VALUES ($1, $2, $3, $4, $5, $6, $7)
+ON CONFLICT (store_integration_id) DO NOTHING`
+
+// saveSQL uses a conditional WHERE clause so a redelivered event (same last_event_id)
+// produces no write. This is the idempotency gate for the find → ApplyEvent → save flow.
+const saveSQL = `
+INSERT INTO integration_activity
+  (store_integration_id, store_id, activation_count, deactivation_count,
+   last_changed_at, active, last_event_id)
+VALUES ($1, $2, $3, $4, $5, $6, $7)
+ON CONFLICT (store_integration_id) DO UPDATE SET
+  activation_count   = EXCLUDED.activation_count,
+  deactivation_count = EXCLUDED.deactivation_count,
+  last_changed_at    = EXCLUDED.last_changed_at,
+  active             = EXCLUDED.active,
+  last_event_id      = EXCLUDED.last_event_id
+WHERE integration_activity.last_event_id IS DISTINCT FROM EXCLUDED.last_event_id`
+
+func (r *pgIntegrationActivityRepository) FindByIntegration(ctx context.Context, id string) (*projections.IntegrationActivityProjection, error) {
+	row := r.db.QueryRowContext(ctx, findByIntegrationSQL, id)
+	var p projections.IntegrationActivityProjection
+	err := row.Scan(
+		&p.StoreIntegrationID, &p.StoreID,
+		&p.ActivationCount, &p.DeactivationCount,
+		&p.LastChangedAt, &p.Active, &p.LastEventID,
+	)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("integration_activity find: %w", err)
+	}
+	return &p, nil
+}
+
+func (r *pgIntegrationActivityRepository) Save(ctx context.Context, p *projections.IntegrationActivityProjection) error {
+	_, err := r.db.ExecContext(ctx, saveSQL,
+		p.StoreIntegrationID, p.StoreID,
+		p.ActivationCount, p.DeactivationCount,
+		p.LastChangedAt, p.Active, p.LastEventID,
+	)
+	if err != nil {
+		return fmt.Errorf("integration_activity save: %w", err)
+	}
+	return nil
+}
+
+func (r *pgIntegrationActivityRepository) InsertIfNew(ctx context.Context, p *projections.IntegrationActivityProjection) (bool, error) {
+	result, err := r.db.ExecContext(ctx, insertIfNewSQL,
+		p.StoreIntegrationID, p.StoreID,
+		p.ActivationCount, p.DeactivationCount,
+		p.LastChangedAt, p.Active, p.LastEventID,
+	)
+	if err != nil {
+		return false, fmt.Errorf("integration_activity insert_if_new: %w", err)
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return false, fmt.Errorf("integration_activity insert_if_new rows_affected: %w", err)
+	}
+	return n > 0, nil
+}
diff --git a/packages/api/go/internal/sync/repositories/integrationactivity/pg_integration_activity_repository_test.go b/packages/api/go/internal/sync/repositories/integrationactivity/pg_integration_activity_repository_test.go
