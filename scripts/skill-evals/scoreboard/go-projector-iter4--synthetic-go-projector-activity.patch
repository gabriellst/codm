@@ -0,0 +1,22 @@
+// Package integrationactivity provides persistence for the IntegrationActivityProjection.
+package integrationactivity
+
+import (
+	"context"
+
+	"template/api-go/internal/sync/projections"
+)
+
+// IntegrationActivityRepository defines the write surface for the IntegrationActivityProjection.
+// No shared base — only the surface the projector uses.
+type IntegrationActivityRepository interface {
+	// FindByIntegration returns the row for storeIntegrationID, or nil when absent.
+	FindByIntegration(ctx context.Context, storeIntegrationID string) (*projections.IntegrationActivityProjection, error)
+	// Save persists the mutated projection.
+	// The Postgres implementation uses ON CONFLICT ... WHERE last_event_id IS DISTINCT FROM EXCLUDED.last_event_id
+	// so a redelivered event (same EntityID) produces no write — idempotent by design.
+	Save(ctx context.Context, p *projections.IntegrationActivityProjection) error
+	// InsertIfNew inserts the row when storeIntegrationID is seen for the first time.
+	// Returns (false, nil) on duplicate — not an error.
+	InsertIfNew(ctx context.Context, p *projections.IntegrationActivityProjection) (bool, error)
+}
