@@ -0,0 +1,130 @@
+package projections
+
+import (
+	"testing"
+	"time"
+
+	wire "template/contracts-go/wire"
+)
+
+func TestNewIntegrationActivityProjection(t *testing.T) {
+	at := time.Now().UTC()
+	evt := wire.IntegrationActivatedIntegrationEvent{
+		EntityID:           "ev-1",
+		StoreIntegrationID: "integ-1",
+		StoreID:            "store-1",
+		ActivatedAt:        at,
+	}
+
+	p := NewIntegrationActivityProjection(evt)
+
+	if p.StoreIntegrationID != "integ-1" {
+		t.Fatalf("StoreIntegrationID = %q, want %q", p.StoreIntegrationID, "integ-1")
+	}
+	if p.StoreID != "store-1" {
+		t.Fatalf("StoreID = %q, want %q", p.StoreID, "store-1")
+	}
+	if p.ActivationCount != 1 {
+		t.Fatalf("ActivationCount = %d, want 1", p.ActivationCount)
+	}
+	if p.DeactivationCount != 0 {
+		t.Fatalf("DeactivationCount = %d, want 0", p.DeactivationCount)
+	}
+	if !p.Active {
+		t.Fatal("expected Active = true")
+	}
+	if !p.LastChangedAt.Equal(at) {
+		t.Fatalf("LastChangedAt = %v, want %v", p.LastChangedAt, at)
+	}
+	if p.LastEventID != "ev-1" {
+		t.Fatalf("LastEventID = %q, want %q", p.LastEventID, "ev-1")
+	}
+}
+
+func TestIntegrationActivityProjection_ApplyEvent_Activated(t *testing.T) {
+	p := &IntegrationActivityProjection{
+		StoreIntegrationID: "integ-1",
+		StoreID:            "store-1",
+		ActivationCount:    1,
+		Active:             true,
+		LastEventID:        "ev-0",
+	}
+	at := time.Now().UTC()
+	evt := wire.IntegrationActivatedIntegrationEvent{
+		EntityID:    "ev-1",
+		ActivatedAt: at,
+	}
+
+	p.ApplyEvent(evt)
+
+	if p.ActivationCount != 2 {
+		t.Fatalf("ActivationCount = %d, want 2", p.ActivationCount)
+	}
+	if !p.Active {
+		t.Fatal("expected Active = true")
+	}
+	if !p.LastChangedAt.Equal(at) {
+		t.Fatalf("LastChangedAt = %v, want %v", p.LastChangedAt, at)
+	}
+	if p.LastEventID != "ev-1" {
+		t.Fatalf("LastEventID = %q, want %q", p.LastEventID, "ev-1")
+	}
+}
+
+func TestIntegrationActivityProjection_ApplyEvent_Deactivated(t *testing.T) {
+	p := &IntegrationActivityProjection{
+		StoreIntegrationID: "integ-1",
+		Active:             true,
+		ActivationCount:    1,
+		LastEventID:        "ev-0",
+	}
+	at := time.Now().UTC()
+	evt := wire.IntegrationDeactivatedIntegrationEvent{
+		EntityID:      "ev-2",
+		DeactivatedAt: at,
+	}
+
+	p.ApplyEvent(evt)
+
+	if p.DeactivationCount != 1 {
+		t.Fatalf("DeactivationCount = %d, want 1", p.DeactivationCount)
+	}
+	if p.Active {
+		t.Fatal("expected Active = false after deactivation")
+	}
+	if !p.LastChangedAt.Equal(at) {
+		t.Fatalf("LastChangedAt = %v, want %v", p.LastChangedAt, at)
+	}
+	if p.LastEventID != "ev-2" {
+		t.Fatalf("LastEventID = %q, want %q", p.LastEventID, "ev-2")
+	}
+}
+
+func TestIntegrationActivityProjection_ApplyEvent_Sequence(t *testing.T) {
+	at0 := time.Now().UTC()
+	evt0 := wire.IntegrationActivatedIntegrationEvent{
+		EntityID: "ev-0", StoreIntegrationID: "integ-1", StoreID: "s1", ActivatedAt: at0,
+	}
+	p := NewIntegrationActivityProjection(evt0)
+
+	// Deactivate
+	at1 := at0.Add(time.Hour)
+	p.ApplyEvent(wire.IntegrationDeactivatedIntegrationEvent{EntityID: "ev-1", DeactivatedAt: at1})
+
+	// Re-activate
+	at2 := at1.Add(time.Hour)
+	p.ApplyEvent(wire.IntegrationActivatedIntegrationEvent{EntityID: "ev-2", ActivatedAt: at2})
+
+	if p.ActivationCount != 2 {
+		t.Fatalf("ActivationCount = %d, want 2", p.ActivationCount)
+	}
+	if p.DeactivationCount != 1 {
+		t.Fatalf("DeactivationCount = %d, want 1", p.DeactivationCount)
+	}
+	if !p.Active {
+		t.Fatal("expected Active = true after re-activation")
+	}
+	if p.LastEventID != "ev-2" {
+		t.Fatalf("LastEventID = %q, want ev-2", p.LastEventID)
+	}
+}
diff --git a/packages/api/go/internal/sync/projections/projectors/integration_activity_projector.go b/packages/api/go/internal/sync/projections/projectors/integration_activity_projector.go
new file mode 100644
index 000000000..0cb2f63b1
--- /dev/null
+++ b/packages/api/go/internal/sync/projections/projectors/integration_activity_projector.go
@@ -0,0 +1,158 @@
+// Package projectors contains read-side projectors for the sync bounded context.
+package projectors
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+
+	wire "template/contracts-go/wire"
+	integrationactivity "template/api-go/internal/sync/repositories/integrationactivity"
+	"template/api-go/internal/sync/projections"
+	"template/core-go/types"
+)
+
+// IntegrationActivityProjector keeps the IntegrationActivityProjection current.
+//
+// ONE projector per projection: all transition logic lives here. The mediator
+// interface requires a single EventName per registered handler, so this projector
+// exposes two thin adapters (ActivatedHandler / DeactivatedHandler) that both
+// delegate to the same internal handle path. Register both with ExternalMediator.
+//
+// Idempotency: redelivery of the same event ID is absorbed at the Postgres layer —
+// Save uses ON CONFLICT ... WHERE last_event_id IS DISTINCT FROM EXCLUDED.last_event_id.
+// InsertIfNew uses ON CONFLICT DO NOTHING, so a duplicate first-activation is also safe.
+type IntegrationActivityProjector struct {
+	repo integrationactivity.IntegrationActivityRepository
+}
+
+func NewIntegrationActivityProjector(repo integrationactivity.IntegrationActivityRepository) *IntegrationActivityProjector {
+	return &IntegrationActivityProjector{repo: repo}
+}
+
+// ActivatedHandler returns a mediator-compatible handler for integration.activated.
+// Register this with ExternalMediator in the fx module.
+func (p *IntegrationActivityProjector) ActivatedHandler() *IntegrationActivatedActivityHandler {
+	return &IntegrationActivatedActivityHandler{p: p}
+}
+
+// DeactivatedHandler returns a mediator-compatible handler for integration.deactivated.
+// Register this with ExternalMediator in the fx module.
+func (p *IntegrationActivityProjector) DeactivatedHandler() *IntegrationDeactivatedActivityHandler {
+	return &IntegrationDeactivatedActivityHandler{p: p}
+}
+
+// handleActivated runs the canonical find → ApplyEvent → save path for the activated event.
+// First-time activations use InsertIfNew; subsequent ones mutate the existing row.
+func (p *IntegrationActivityProjector) handleActivated(ctx context.Context, event types.IntegrationEventI) error {
+	e, err := decodeActivated(event)
+	if err != nil {
+		return err
+	}
+
+	row, err := p.repo.FindByIntegration(ctx, e.StoreIntegrationID)
+	if err != nil {
+		return err
+	}
+	if row == nil {
+		proj := projections.NewIntegrationActivityProjection(e)
+		inserted, err := p.repo.InsertIfNew(ctx, proj)
+		if err != nil {
+			return err
+		}
+		if !inserted {
+			slog.Debug("integration_activity: activated — duplicate delivery, row already exists",
+				"integrationId", e.StoreIntegrationID, "eventId", e.EntityID)
+		}
+		return nil
+	}
+
+	row.ApplyEvent(e)
+	return p.repo.Save(ctx, row)
+}
+
+// handleDeactivated runs the canonical find → ApplyEvent → save path for the deactivated event.
+// A missing row is non-fatal (out-of-order delivery); log and return nil.
+func (p *IntegrationActivityProjector) handleDeactivated(ctx context.Context, event types.IntegrationEventI) error {
+	e, err := decodeDeactivated(event)
+	if err != nil {
+		return err
+	}
+
+	row, err := p.repo.FindByIntegration(ctx, e.StoreIntegrationID)
+	if err != nil {
+		return err
+	}
+	if row == nil {
+		slog.Warn("integration_activity: deactivation for unknown integration — skipping",
+			"integrationId", e.StoreIntegrationID, "eventId", e.EntityID)
+		return nil
+	}
+
+	row.ApplyEvent(e)
+	return p.repo.Save(ctx, row)
+}
+
+// IntegrationActivatedActivityHandler is the mediator adapter for integration.activated.
+// It satisfies coremediator.IntegrationEventHandler and forwards to the projector.
+type IntegrationActivatedActivityHandler struct {
+	p *IntegrationActivityProjector
+}
+
+func (h *IntegrationActivatedActivityHandler) EventName() string {
+	return wire.IntegrationActivatedIntegrationEventName
+}
+
+func (h *IntegrationActivatedActivityHandler) Handle(ctx context.Context, event types.IntegrationEventI) error {
+	return h.p.handleActivated(ctx, event)
+}
+
+// IntegrationDeactivatedActivityHandler is the mediator adapter for integration.deactivated.
+// It satisfies coremediator.IntegrationEventHandler and forwards to the projector.
+type IntegrationDeactivatedActivityHandler struct {
+	p *IntegrationActivityProjector
+}
+
+func (h *IntegrationDeactivatedActivityHandler) EventName() string {
+	return wire.IntegrationDeactivatedIntegrationEventName
+}
+
+func (h *IntegrationDeactivatedActivityHandler) Handle(ctx context.Context, event types.IntegrationEventI) error {
+	return h.p.handleDeactivated(ctx, event)
+}
+
+// decodeActivated extracts the wire event from the mediator envelope.
+// Follows the same pattern as the sibling sync handlers.
+func decodeActivated(event types.IntegrationEventI) (wire.IntegrationActivatedIntegrationEvent, error) {
+	provider, ok := event.(interface{ GetPayload() json.RawMessage })
+	if !ok {
+		return wire.IntegrationActivatedIntegrationEvent{}, fmt.Errorf("event %s carries no payload", event.GetEventName())
+	}
+	decoded, err := wire.UnmarshalIntegrationEvent(provider.GetPayload())
+	if err != nil {
+		return wire.IntegrationActivatedIntegrationEvent{}, err
+	}
+	v, ok := decoded.(wire.IntegrationActivatedIntegrationEvent)
+	if !ok {
+		return wire.IntegrationActivatedIntegrationEvent{}, fmt.Errorf("integration_activity_projector: unexpected event type %T", decoded)
+	}
+	return v, nil
+}
+
+// decodeDeactivated extracts the wire event from the mediator envelope.
+func decodeDeactivated(event types.IntegrationEventI) (wire.IntegrationDeactivatedIntegrationEvent, error) {
+	provider, ok := event.(interface{ GetPayload() json.RawMessage })
+	if !ok {
+		return wire.IntegrationDeactivatedIntegrationEvent{}, fmt.Errorf("event %s carries no payload", event.GetEventName())
+	}
+	decoded, err := wire.UnmarshalIntegrationEvent(provider.GetPayload())
+	if err != nil {
+		return wire.IntegrationDeactivatedIntegrationEvent{}, err
+	}
+	v, ok := decoded.(wire.IntegrationDeactivatedIntegrationEvent)
+	if !ok {
+		return wire.IntegrationDeactivatedIntegrationEvent{}, fmt.Errorf("integration_activity_projector: unexpected event type %T", decoded)
+	}
+	return v, nil
+}
