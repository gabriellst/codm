--- /dev/null
+++ b/packages/api/go/core/db/sql/migrations/001_create_integration_activity.sql
@@ -0,0 +1,16 @@
+-- Integration activity projection: per-store-integration activation/deactivation counters.
+-- Written by IntegrationActivityProjector; read by the ops dashboard.
+-- last_event_id enables conditional upserts (ON CONFLICT WHERE IS DISTINCT FROM)
+-- to prevent double-counting on event redelivery.
+CREATE TABLE IF NOT EXISTS integration_activity (
+    store_integration_id TEXT        PRIMARY KEY,
+    store_id             TEXT        NOT NULL,
+    activation_count     INTEGER     NOT NULL DEFAULT 0,
+    deactivation_count   INTEGER     NOT NULL DEFAULT 0,
+    last_changed_at      TIMESTAMPTZ NOT NULL,
+    active               BOOLEAN     NOT NULL DEFAULT FALSE,
+    last_event_id        TEXT        NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS idx_integration_activity_store_id
+    ON integration_activity (store_id);
