+package projectors
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+
+	"template/api-go/internal/sync/repositories/integrationactivity"
+	wire "template/contracts-go/wire"
+	"template/core-go/types"
+)
+
+// fakeEvent wraps a raw JSON payload so the projector's decode path works.
+type fakeEvent struct {
+	name string
+	raw  json.RawMessage
+}
+
+func (e *fakeEvent) GetEventName() string        { return e.name }
+func (e *fakeEvent) GetOwnerID() string          { return "" }
+func (e *fakeEvent) GetPayload() json.RawMessage { return e.raw }
+
+func makeActivatedEvent(e wire.IntegrationActivatedIntegrationEvent) types.IntegrationEventI {
+	e.Name = wire.IntegrationActivatedIntegrationEventName
+	raw, _ := json.Marshal(e)
+	return &fakeEvent{name: wire.IntegrationActivatedIntegrationEventName, raw: raw}
+}
+
+func makeDeactivatedEvent(e wire.IntegrationDeactivatedIntegrationEvent) types.IntegrationEventI {
+	e.Name = wire.IntegrationDeactivatedIntegrationEventName
+	raw, _ := json.Marshal(e)
+	return &fakeEvent{name: wire.IntegrationDeactivatedIntegrationEventName, raw: raw}
+}
+
+func TestIntegrationActivityProjector_CreatesRowOnFirstActivation(t *testing.T) {
+	repo := integrationactivity.NewMockIntegrationActivityRepository()
+	p := NewIntegrationActivityProjector(repo)
+
+	at := time.Now().UTC()
+	err := p.ActivatedHandler().Handle(context.Background(), makeActivatedEvent(wire.IntegrationActivatedIntegrationEvent{
+		EntityID: "ev-1", StoreIntegrationID: "integ-1", StoreID: "store-1", ActivatedAt: at,
+	}))
+	if err != nil {
+		t.Fatalf("Handle: %v", err)
+	}
+
+	row := repo.Get("integ-1")
+	if row == nil {
+		t.Fatal("expected row, got nil")
+	}
+	if row.ActivationCount != 1 {
+		t.Fatalf("ActivationCount = %d, want 1", row.ActivationCount)
+	}
+	if !row.Active {
+		t.Fatal("expected Active = true")
+	}
+	if row.StoreID != "store-1" {
+		t.Fatalf("StoreID = %q, want store-1", row.StoreID)
+	}
+	if repo.Inserts != 1 {
+		t.Fatalf("Inserts = %d, want 1", repo.Inserts)
+	}
+}
+
+func TestIntegrationActivityProjector_IncrementsActivationCountOnReactivation(t *testing.T) {
+	repo := integrationactivity.NewMockIntegrationActivityRepository()
+	p := NewIntegrationActivityProjector(repo)
+
+	at1 := time.Now().UTC()
+	_ = p.ActivatedHandler().Handle(context.Background(), makeActivatedEvent(wire.IntegrationActivatedIntegrationEvent{
+		EntityID: "ev-1", StoreIntegrationID: "integ-1", StoreID: "store-1", ActivatedAt: at1,
+	}))
+
+	at2 := at1.Add(time.Hour)
+	_ = p.DeactivatedHandler().Handle(context.Background(), makeDeactivatedEvent(wire.IntegrationDeactivatedIntegrationEvent{
+		EntityID: "ev-2", StoreIntegrationID: "integ-1", StoreID: "store-1", DeactivatedAt: at2,
+	}))
+
+	at3 := at2.Add(time.Hour)
+	_ = p.ActivatedHandler().Handle(context.Background(), makeActivatedEvent(wire.IntegrationActivatedIntegrationEvent{
+		EntityID: "ev-3", StoreIntegrationID: "integ-1", StoreID: "store-1", ActivatedAt: at3,
+	}))
+
+	row := repo.Get("integ-1")
+	if row.ActivationCount != 2 {
+		t.Fatalf("ActivationCount = %d, want 2", row.ActivationCount)
+	}
+	if row.DeactivationCount != 1 {
+		t.Fatalf("DeactivationCount = %d, want 1", row.DeactivationCount)
+	}
+	if !row.Active {
+		t.Fatal("expected Active = true after reactivation")
+	}
+}
+
+func TestIntegrationActivityProjector_DeactivationForUnknownIntegrationIsNonFatal(t *testing.T) {
+	repo := integrationactivity.NewMockIntegrationActivityRepository()
+	p := NewIntegrationActivityProjector(repo)
+
+	err := p.DeactivatedHandler().Handle(context.Background(), makeDeactivatedEvent(wire.IntegrationDeactivatedIntegrationEvent{
+		EntityID: "ev-1", StoreIntegrationID: "nonexistent", DeactivatedAt: time.Now().UTC(),
+	}))
+	if err != nil {
+		t.Fatalf("expected nil for unknown integration, got %v", err)
+	}
+}
+
+func TestIntegrationActivityProjector_DuplicateFirstActivationIsIdempotent(t *testing.T) {
+	repo := integrationactivity.NewMockIntegrationActivityRepository()
+	p := NewIntegrationActivityProjector(repo)
+
+	evt := makeActivatedEvent(wire.IntegrationActivatedIntegrationEvent{
+		EntityID: "ev-1", StoreIntegrationID: "integ-1", StoreID: "store-1", ActivatedAt: time.Now().UTC(),
+	})
+
+	// Deliver the same first-activation event twice.
+	_ = p.ActivatedHandler().Handle(context.Background(), evt)
+	_ = p.ActivatedHandler().Handle(context.Background(), evt)
+
+	// InsertIfNew returns (false, nil) on duplicate — mock does not double-insert.
+	if repo.Inserts != 1 {
+		t.Fatalf("Inserts = %d, want 1 (InsertIfNew idempotent)", repo.Inserts)
+	}
+}
+
+func TestIntegrationActivityProjector_AdaptersHaveCorrectEventNames(t *testing.T) {
+	repo := integrationactivity.NewMockIntegrationActivityRepository()
+	p := NewIntegrationActivityProjector(repo)
+
+	if got := p.ActivatedHandler().EventName(); got != wire.IntegrationActivatedIntegrationEventName {
+		t.Fatalf("ActivatedHandler.EventName = %q", got)
+	}
+	if got := p.DeactivatedHandler().EventName(); got != wire.IntegrationDeactivatedIntegrationEventName {
+		t.Fatalf("DeactivatedHandler.EventName = %q", got)
+	}
+}
diff --git a/packages/api/go/internal/sync/repositories/integrationactivity/integration_activity_repository.go b/packages/api/go/internal/sync/repositories/integrationactivity/integration_activity_repository.go
