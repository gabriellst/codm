+import { injectable } from 'tsyringe-neo'
+import { Handler, z } from '@template/core-typescript'
+import { BoardViewProjectionRepository } from '../projections/BoardViewProjectionRepository'
+
+export const ListBoardsInputSchema = z.object({
+	storeId: z.string().uuid(),
+})
+
+export const ListBoardsOutputSchema = z.object({
+	boards: z.array(
+		z.object({
+			boardId: z.string().uuid(),
+			name: z.string(),
+			archivedAt: z.date().nullable(),
+			listCount: z.number().int(),
+			cardCount: z.number().int(),
+		}),
+	),
+})
+
+@injectable()
+export class ListBoards extends Handler<typeof ListBoardsInputSchema, typeof ListBoardsOutputSchema> {
+	readonly name = 'list_boards' as const
+	readonly inputSchema = ListBoardsInputSchema
+	readonly outputSchema = ListBoardsOutputSchema
+
+	constructor(private readonly repo: BoardViewProjectionRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const projections = await this.repo.findByStoreId(input.storeId)
+		return {
+			boards: projections.map(p => ({
+				boardId: p.props.boardId,
+				name: p.props.name,
+				archivedAt: p.props.archivedAt,
+				listCount: p.props.lists.length,
+				cardCount: p.props.lists.reduce((sum, l) => sum + l.cards.filter(c => !c.archivedAt).length, 0),
+			})),
+		}
+	}
+}
