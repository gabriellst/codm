@@ -0,0 +1,84 @@
+import { useState, type ComponentProps } from 'react'
+import { useQueryClient } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+import {
+	useMoveCard,
+	getBoardQueryKey,
+	type GetBoardQueryResponse,
+} from '@template/client-typescript/typescript'
+import { cn } from '@/lib/utils'
+import { Button } from '@/components/ui/button'
+import { Card, CardContent } from '@/components/ui/card'
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select'
+
+type CardProps = GetBoardQueryResponse['lists'][number]['cards'][number]
+
+interface CardItemProps extends ComponentProps<'div'> {
+	card: CardProps
+	boardId: string
+	lists: GetBoardQueryResponse['lists']
+}
+
+export function CardItem({ card, boardId, lists, className, ...props }: CardItemProps) {
+	const { t } = useTranslation()
+	const queryClient = useQueryClient()
+	const [targetListId, setTargetListId] = useState<string | null>(null)
+
+	const moveCard = useMoveCard({
+		mutation: {
+			onSuccess: () => {
+				queryClient.invalidateQueries({ queryKey: getBoardQueryKey(boardId) })
+			},
+		},
+	})
+
+	const otherLists = lists.filter(
+		list => !list.cards.some(c => c.cardId === card.cardId),
+	)
+
+	const handleMove = () => {
+		if (!targetListId) return
+		moveCard.mutate({
+			cardId: card.cardId,
+			data: { toListId: targetListId, toPosition: 0 },
+		})
+	}
+
+	return (
+		<Card
+			role="listitem"
+			aria-label={card.title}
+			className={cn('gap-0 py-0', className)}
+			{...props}
+		>
+			<CardContent className="flex flex-col gap-2 p-3">
+				<span className="text-sm font-medium text-foreground">{card.title}</span>
+				{otherLists.length > 0 && (
+					<div className="flex gap-2">
+						<Select value={targetListId} onValueChange={setTargetListId}>
+							<SelectTrigger aria-label={t('board.moveToList')} className="flex-1 text-xs">
+								<SelectValue>{targetListId ? (otherLists.find(l => l.listId === targetListId)?.name ?? t('board.moveToList')) : t('board.moveToList')}</SelectValue>
+							</SelectTrigger>
+							<SelectContent>
+								{otherLists.map(list => (
+									<SelectItem key={list.listId} value={list.listId}>
+										{list.name}
+									</SelectItem>
+								))}
+							</SelectContent>
+						</Select>
+						<Button
+							size="sm"
+							variant="outline"
+							onClick={handleMove}
+							disabled={!targetListId || moveCard.isPending}
+							className="text-xs"
+						>
+							{t('board.moveCard')}
+						</Button>
+					</div>
+				)}
+			</CardContent>
+		</Card>
+	)
+}
