+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import { CardStatus } from '../enums/CardStatus'
+import type { CardApplicationErrors } from '../errors'
+
+const CardSchema = z.object({
+	boardId: z.instance(Id),
+	listId: z.instance(Id),
+	storeId: z.instance(Id),
+	ownerId: z.instance(Id),
+	title: z.string().min(1).max(500),
+	position: z.number().int().min(0),
+	archivedAt: z.date().nullable().default(null),
+	status: z.enum(CardStatus).default(CardStatus.ACTIVE),
+})
+
+export type CardProps = Z.infer<typeof CardSchema>
+
+export class Card extends AggregateRoot<typeof CardSchema> {
+	static override schema = CardSchema
+
+	static create(data: {
+		boardId: string
+		listId: string
+		storeId: string
+		ownerId: string
+		title: string
+		position: number
+	}): Card {
+		return new Card({
+			boardId: data.boardId,
+			listId: data.listId,
+			storeId: data.storeId,
+			ownerId: data.ownerId,
+			title: data.title,
+			position: data.position,
+			archivedAt: null,
+			status: CardStatus.ACTIVE,
+		})
+	}
+
+	move(toListId: string, toPosition: number): void {
+		if (this.isArchived()) throw new BaseError<CardApplicationErrors>('CARD_ALREADY_ARCHIVED')
+		this.listId = new Id(toListId)
+		this.position = toPosition
+		this.validate()
+	}
+
+	archive(): void {
+		if (this.isArchived()) throw new BaseError<CardApplicationErrors>('CARD_ALREADY_ARCHIVED')
+		this.archivedAt = new Date()
+		this.status = CardStatus.ARCHIVED
+		this.validate()
+	}
+
+	isArchived(): boolean {
+		return this.status === CardStatus.ARCHIVED
+	}
+}
+
+export interface Card extends CardProps {}
