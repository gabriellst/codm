+import { HttpStatusCode, registerErrorCodes } from '@template/core-typescript'
+import type { BaseApplicationErrors, BaseDomainErrors } from '@template/core-typescript'
+
+export type CardDomainErrors = never
+export type DomainErrors = BaseDomainErrors | CardDomainErrors
+
+export type CardApplicationErrors =
+	| 'CARD_NOT_FOUND'
+	| 'CARD_ALREADY_ARCHIVED'
+	| 'CARD_LIST_INVALID'
+	| 'CARD_BOARD_ARCHIVED'
+	| 'CARD_BOARD_NOT_FOUND'
+export type ApplicationErrors = BaseApplicationErrors | CardApplicationErrors
+
+registerErrorCodes({
+	CARD_NOT_FOUND: HttpStatusCode.NOT_FOUND,
+	CARD_ALREADY_ARCHIVED: HttpStatusCode.CONFLICT,
+	CARD_LIST_INVALID: HttpStatusCode.UNPROCESSABLE_ENTITY,
+	CARD_BOARD_ARCHIVED: HttpStatusCode.CONFLICT,
+	CARD_BOARD_NOT_FOUND: HttpStatusCode.NOT_FOUND,
+})
