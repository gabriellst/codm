+import { BoardCreatedEventSchema } from '@board/events/BoardCreatedEvent'
+import { BoardArchivedEventSchema } from '@board/events/BoardArchivedEvent'
+import { BoardListAddedEventSchema } from '@board/events/BoardListAddedEvent'
+import { CardCreatedEventSchema } from '@card/events/CardCreatedEvent'
+import { CardMovedEventSchema } from '@card/events/CardMovedEvent'
+import { CardArchivedEventSchema } from '@card/events/CardArchivedEvent'
+
+export const CardSlotSchema = z.object({
+	cardId: z.string().uuid(),
+	title: z.string(),
+	position: z.number().int(),
+	archivedAt: z.string().nullable(),
+})
+
+export const ListViewSlotSchema = z.object({
+	listId: z.string().uuid(),
+	name: z.string(),
+	position: z.number().int(),
+	cards: z.array(CardSlotSchema),
+})
+
+export const BoardViewProjectionSchema = z.object({
+	boardId: z.string().uuid(),
+	storeId: z.string().uuid(),
+	name: z.string(),
+	archivedAt: z.date().nullable(),
+	lists: z.array(ListViewSlotSchema),
+})
+
+export type CardSlot = Z.infer<typeof CardSlotSchema>
+export type ListViewSlot = Z.infer<typeof ListViewSlotSchema>
+export type BoardViewProjectionProps = Z.infer<typeof BoardViewProjectionSchema>
+
+export type BoardViewProjectionEvent =
+	| Z.infer<typeof BoardCreatedEventSchema>
+	| Z.infer<typeof BoardArchivedEventSchema>
+	| Z.infer<typeof BoardListAddedEventSchema>
+	| Z.infer<typeof CardCreatedEventSchema>
+	| Z.infer<typeof CardMovedEventSchema>
+	| Z.infer<typeof CardArchivedEventSchema>
+
+// Payload aliases for applyEvent casts.
+type BoardListAddedPayload = Z.infer<typeof BoardListAddedEventSchema>['payload']
+type CardCreatedPayload = Z.infer<typeof CardCreatedEventSchema>['payload']
+type CardMovedPayload = Z.infer<typeof CardMovedEventSchema>['payload']
+type CardArchivedPayload = Z.infer<typeof CardArchivedEventSchema>['payload']
+
+// The domain event schema types don't carry `name` (only the class instances do at runtime).
+// The implementation union adds `name?: string` so the switch compiles; each case casts
+// payload to the concrete alias (narrowing, not widening).
+type MutatingEvent =
+	| (Z.infer<typeof BoardArchivedEventSchema> & { name?: string })
+	| (Z.infer<typeof BoardListAddedEventSchema> & { name?: string })
+	| (Z.infer<typeof CardCreatedEventSchema> & { name?: string })
+	| (Z.infer<typeof CardMovedEventSchema> & { name?: string })
+	| (Z.infer<typeof CardArchivedEventSchema> & { name?: string })
+
+export class BoardViewProjection {
+	constructor(public props: BoardViewProjectionProps) {}
+
+	// ── static create — overloaded, one signature per creating event ──────────
+
+	static create(event: Z.infer<typeof BoardCreatedEventSchema>): BoardViewProjection
+	static create(event: Z.infer<typeof BoardCreatedEventSchema>): BoardViewProjection {
+		return new BoardViewProjection({
+			boardId: event.payload.boardId,
+			storeId: event.payload.storeId,
+			name: event.payload.name,
+			archivedAt: null,
+			lists: [],
+		})
+	}
+
+	// ── applyEvent — overloaded, one signature per mutating event ─────────────
+
+	applyEvent(event: Z.infer<typeof BoardArchivedEventSchema>): void
+	applyEvent(event: Z.infer<typeof BoardListAddedEventSchema>): void
+	applyEvent(event: Z.infer<typeof CardCreatedEventSchema>): void
+	applyEvent(event: Z.infer<typeof CardMovedEventSchema>): void
+	applyEvent(event: Z.infer<typeof CardArchivedEventSchema>): void
+	applyEvent(event: MutatingEvent): void {
+		switch (event.name) {
+			case 'board.archived':
+				this.markArchived()
+				break
+			case 'board.list_added': {
+				const p = event.payload as BoardListAddedPayload
+				this.addList({ listId: p.listId, name: p.name, position: p.position })
+				break
+			}
+			case 'card.created': {
+				const p = event.payload as CardCreatedPayload
+				this.addCard({ listId: p.listId, cardId: p.cardId, title: p.title, position: p.position })
+				break
+			}
+			case 'card.moved': {
+				const p = event.payload as CardMovedPayload
+				this.moveCard({ cardId: p.cardId, toListId: p.toListId, toPosition: p.position })
+				break
+			}
+			case 'card.archived': {
+				const p = event.payload as CardArchivedPayload
+				this.archiveCard(p.cardId)
+				break
+			}
+		}
+	}
+
+	// ── internal mutation helpers ─────────────────────────────────────────────
+
+	private addCard(data: { listId: string; cardId: string; title: string; position: number }): void {
+		const list = this.props.lists.find(l => l.listId === data.listId)
+		if (!list) return
+		list.cards.push({ cardId: data.cardId, title: data.title, position: data.position, archivedAt: null })
+		list.cards.sort((a, b) => a.position - b.position)
+	}
+
+	private moveCard(data: { cardId: string; toListId: string; toPosition: number }): void {
+		let cardData: CardSlot | undefined
+		for (const list of this.props.lists) {
+			const idx = list.cards.findIndex(c => c.cardId === data.cardId)
+			if (idx !== -1) {
+				cardData = list.cards.splice(idx, 1)[0]
+				break
+			}
+		}
+		if (!cardData) return
+		const newList = this.props.lists.find(l => l.listId === data.toListId)
+		if (!newList) return
+		newList.cards.push({ ...cardData, position: data.toPosition })
+		newList.cards.sort((a, b) => a.position - b.position)
+	}
+
+	private archiveCard(cardId: string): void {
+		for (const list of this.props.lists) {
+			const card = list.cards.find(c => c.cardId === cardId)
+			if (card) {
+				card.archivedAt = new Date().toISOString()
+				break
+			}
+		}
+	}
+
+	private addList(data: { listId: string; name: string; position: number }): void {
+		this.props.lists.push({ listId: data.listId, name: data.name, position: data.position, cards: [] })
+		this.props.lists.sort((a, b) => a.position - b.position)
+	}
+
+	private markArchived(): void {
+		this.props.archivedAt = new Date()
+	}
+}
diff --git a/packages/api/typescript/src/ui/projections/BoardViewProjectionRepository.ts b/packages/api/typescript/src/ui/projections/BoardViewProjectionRepository.ts
new file mode 100644
index 000000000..1003fd889
--- /dev/null
+++ b/packages/api/typescript/src/ui/projections/BoardViewProjectionRepository.ts
@@ -0,0 +1,101 @@
+import { injectable } from 'tsyringe-neo'
+import { DrizzleClient } from '@template/core-typescript'
+import { eq } from 'drizzle-orm'
+import { boardViews } from '@template/contracts/db'
+import { BoardViewProjection, type ListViewSlot } from './BoardViewProjection'
+
+export abstract class BoardViewProjectionRepository {
+	abstract findByBoardId(boardId: string): Promise<BoardViewProjection | null>
+	abstract findByStoreId(storeId: string): Promise<BoardViewProjection[]>
+	abstract save(projection: BoardViewProjection): Promise<void>
+	abstract insertIfNew(projection: BoardViewProjection): Promise<void>
+}
+
+@injectable()
+export class MockBoardViewProjectionRepository extends BoardViewProjectionRepository {
+	private store = new Map<string, BoardViewProjection>()
+
+	async findByBoardId(boardId: string): Promise<BoardViewProjection | null> {
+		return this.store.get(boardId) ?? null
+	}
+
+	async findByStoreId(storeId: string): Promise<BoardViewProjection[]> {
+		return [...this.store.values()].filter(b => b.props.storeId === storeId)
+	}
+
+	async save(projection: BoardViewProjection): Promise<void> {
+		this.store.set(projection.props.boardId, projection)
+	}
+
+	async insertIfNew(projection: BoardViewProjection): Promise<void> {
+		if (!this.store.has(projection.props.boardId)) {
+			this.store.set(projection.props.boardId, projection)
+		}
+	}
+}
+
+type BoardViewRow = typeof boardViews.$inferSelect
+
+function toProjection(row: BoardViewRow): BoardViewProjection {
+	return new BoardViewProjection({
+		boardId: row.boardId,
+		storeId: row.storeId,
+		name: row.name,
+		archivedAt: row.archivedAt,
+		lists: (row.listsJson as ListViewSlot[]) ?? [],
+	})
+}
+
+@injectable()
+export class DrizzleBoardViewProjectionRepository extends BoardViewProjectionRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findByBoardId(boardId: string): Promise<BoardViewProjection | null> {
+		const [row] = await this.db.select().from(boardViews).where(eq(boardViews.boardId, boardId))
+		return row ? toProjection(row) : null
+	}
+
+	async findByStoreId(storeId: string): Promise<BoardViewProjection[]> {
+		const rows = await this.db.select().from(boardViews).where(eq(boardViews.storeId, storeId))
+		return rows.map(toProjection)
+	}
+
+	async save(projection: BoardViewProjection): Promise<void> {
+		const now = new Date()
+		await this.db
+			.insert(boardViews)
+			.values({
+				boardId: projection.props.boardId,
+				storeId: projection.props.storeId,
+				name: projection.props.name,
+				archivedAt: projection.props.archivedAt,
+				listsJson: projection.props.lists,
+				updatedAt: now,
+			})
+			.onConflictDoUpdate({
+				target: boardViews.boardId,
+				set: {
+					name: projection.props.name,
+					archivedAt: projection.props.archivedAt,
+					listsJson: projection.props.lists,
+					updatedAt: now,
+				},
+			})
+	}
+
+	async insertIfNew(projection: BoardViewProjection): Promise<void> {
+		await this.db
+			.insert(boardViews)
+			.values({
+				boardId: projection.props.boardId,
+				storeId: projection.props.storeId,
+				name: projection.props.name,
+				archivedAt: projection.props.archivedAt,
+				listsJson: projection.props.lists,
+				updatedAt: new Date(),
+			})
+			.onConflictDoNothing()
+	}
+}
diff --git a/packages/api/typescript/src/ui/projections/projectors/BoardArchivedProjector.ts b/packages/api/typescript/src/ui/projections/projectors/BoardArchivedProjector.ts
