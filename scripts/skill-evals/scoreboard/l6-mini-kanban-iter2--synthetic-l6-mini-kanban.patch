+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z } from '@template/core-typescript'
+import { BoardViewProjectionRepository } from '../projections/BoardViewProjectionRepository'
+import { ListViewSlotSchema } from '../projections/BoardViewProjection'
+
+export const GetBoardInputSchema = z.object({
+	boardId: z.string().uuid(),
+	storeId: z.string().uuid(),
+})
+
+export const GetBoardOutputSchema = z.object({
+	boardId: z.string().uuid(),
+	storeId: z.string().uuid(),
+	name: z.string(),
+	archivedAt: z.date().nullable(),
+	lists: z.array(ListViewSlotSchema),
+})
+
+@injectable()
+export class GetBoard extends Handler<typeof GetBoardInputSchema, typeof GetBoardOutputSchema> {
+	readonly name = 'get_board' as const
+	readonly inputSchema = GetBoardInputSchema
+	readonly outputSchema = GetBoardOutputSchema
+
+	constructor(private readonly repo: BoardViewProjectionRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const projection = await this.repo.findByBoardId(input.boardId)
+		if (!projection) throw new BaseError('BOARD_NOT_FOUND')
+		return {
+			boardId: projection.props.boardId,
+			storeId: projection.props.storeId,
+			name: projection.props.name,
+			archivedAt: projection.props.archivedAt,
+			lists: projection.props.lists,
+		}
+	}
+}
