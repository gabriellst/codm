@@ -0,0 +1,60 @@
+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, Id, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { BoardRepository } from '../repositories/BoardRepository'
+import { BoardListAddedEvent } from '../events/BoardListAddedEvent'
+import type { ApplicationErrors } from '../errors'
+
+export const AddListToBoardInputSchema = z.object({
+	boardId: z.string().uuid(),
+	name: z.string().min(1).max(100),
+	position: z.number().int().min(0),
+	storeId: z.string().uuid(),
+	userId: z.string().uuid(),
+})
+
+export const AddListToBoardOutputSchema = z.object({
+	listId: z.string().uuid(),
+})
+
+@injectable()
+export class AddListToBoard extends Handler<typeof AddListToBoardInputSchema, typeof AddListToBoardOutputSchema> {
+	readonly name = 'add_list_to_board' as const
+	readonly inputSchema = AddListToBoardInputSchema
+	readonly outputSchema = AddListToBoardOutputSchema
+
+	constructor(private readonly boardRepo: BoardRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		const board = await this.boardRepo.findById(input.boardId, tx)
+		if (board === undefined || board.storeId.value !== input.storeId) {
+			throw new BaseError<ApplicationErrors>('BOARD_NOT_FOUND')
+		}
+
+		const listId = Id.value()
+
+		// Entity throws BOARD_ALREADY_ARCHIVED or BOARD_LIST_LIMIT_REACHED as needed.
+		board.addList({ listId, name: input.name, position: input.position })
+
+		return this.withTransaction(tx, async tx => {
+			await this.boardRepo.save(board, tx)
+			await this.domainEventRepository.save(
+				new BoardListAddedEvent({
+					entityId: board.id.value,
+					ownerId: input.userId,
+					payload: {
+						boardId: board.id.value,
+						storeId: input.storeId,
+						listId,
+						name: input.name,
+						position: input.position,
+					},
+				}),
+				tx,
+			)
+			return { listId }
+		})
+	}
+}
