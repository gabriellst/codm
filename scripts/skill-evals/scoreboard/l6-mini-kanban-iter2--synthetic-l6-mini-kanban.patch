@@ -0,0 +1,52 @@
+import { pgSchema, uuid, text, timestamp, integer, index } from 'drizzle-orm/pg-core'
+
+/**
+ * `card` is the Kanban Card BC schema.
+ *
+ * Cards are owned by a Board (boardId FK) and placed on a specific list (listId).
+ * The listId references a ListSlot.listId in the parent board's listsJson — enforced
+ * at the application layer (Card domain invariant), not via DB FK.
+ *
+ * Tables:
+ *   - `cards` — one row per card
+ */
+export const cardSchema = pgSchema('card')
+
+export const cards = cardSchema.table(
+	'cards',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		// Parent board. Cross-schema ref — no FK constraint (domain layer enforces it).
+		boardId: uuid('board_id').notNull(),
+
+		// The list (column) this card currently belongs to.
+		// References board.boards.listsJson[].listId — application-layer enforced.
+		listId: uuid('list_id').notNull(),
+
+		// Tenant scoping — mirrored from the parent board for fast tenant queries.
+		storeId: uuid('store_id').notNull(),
+
+		// Creator / owner.
+		ownerId: uuid('owner_id').notNull(),
+
+		// Card display text.
+		title: text('title').notNull(),
+
+		// Sort order within its list. Lower = higher on screen.
+		position: integer('position').notNull().default(0),
+
+		// Soft-archive timestamp. Non-null means the card is archived.
+		archivedAt: timestamp('archived_at', { withTimezone: true }),
+
+		// Audit / optimistic concurrency.
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		boardIdx: index('cards_board_id_idx').on(t.boardId),
+		listIdx: index('cards_list_id_idx').on(t.listId),
+		storeIdx: index('cards_store_id_idx').on(t.storeId),
+	}),
+)
