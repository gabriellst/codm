diff --git a/packages/api/typescript/src/board/repositories/BoardRepository.ts b/packages/api/typescript/src/board/repositories/BoardRepository.ts
new file mode 100644
index 000000000..147f755d5
--- /dev/null
+++ b/packages/api/typescript/src/board/repositories/BoardRepository.ts
@@ -0,0 +1,132 @@
+import { injectable } from 'tsyringe-neo'
+import { DrizzleClient, Repository, tryCatchAsync } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { eq } from 'drizzle-orm'
+import { boards } from '@template/contracts/db'
+import { Board } from '../entities/Board'
+import { ListSlot } from '../entities/ListSlot'
+import { BoardStatus } from '../enums/BoardStatus'
+
+export abstract class BoardRepository extends Repository<Board> {
+	abstract findById(id: string, tx?: Transaction): Promise<Board | undefined>
+	abstract findByStoreId(storeId: string, tx?: Transaction): Promise<Board[]>
+}
+
+@injectable()
+export class MockBoardRepository extends BoardRepository {
+	private rows = new Map<string, Board>()
+
+	async findById(id: string, _tx?: Transaction): Promise<Board | undefined> {
+		return this.rows.get(id)
+	}
+
+	async findByStoreId(storeId: string, _tx?: Transaction): Promise<Board[]> {
+		const out: Board[] = []
+		for (const row of this.rows.values()) {
+			if (row.storeId.value === storeId) out.push(row)
+		}
+		return out
+	}
+
+	async save(entity: Board, _tx?: Transaction): Promise<Board> {
+		entity.incrementVersion()
+		this.rows.set(entity.id.value, entity)
+		return entity
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.rows.delete(id)
+	}
+
+	seed(board: Board): void {
+		this.rows.set(board.id.value, board)
+	}
+
+	clear(): void {
+		this.rows.clear()
+	}
+}
+
+type BoardRow = typeof boards.$inferSelect
+
+function toDomain(row: BoardRow): Board {
+	const rawLists = (row.listsJson as Array<{ listId: string; name: string; position: number }>) ?? []
+	return new Board({
+		id: row.id,
+		storeId: row.storeId,
+		ownerId: row.ownerId,
+		name: row.name,
+		listsJson: rawLists.map(l => new ListSlot({ listId: l.listId, name: l.name, position: l.position })),
+		archivedAt: row.archivedAt ?? null,
+		status: row.archivedAt ? BoardStatus.ARCHIVED : BoardStatus.ACTIVE,
+		createdAt: row.createdAt,
+		updatedAt: row.updatedAt,
+		version: row.version,
+	})
+}
+
+@injectable()
+export class DrizzleBoardRepository extends BoardRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: Transaction): Promise<Board | undefined> {
+		const dbc = (tx ?? this.db) as DrizzleClient
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(boards).where(eq(boards.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return toDomain(result.data)
+	}
+
+	async findByStoreId(storeId: string, tx?: Transaction): Promise<Board[]> {
+		const dbc = (tx ?? this.db) as DrizzleClient
+		const result = await tryCatchAsync(async () => {
+			return await dbc.select().from(boards).where(eq(boards.storeId, storeId))
+		})
+		if (!result.success) throw result.error
+		return result.data.map(toDomain)
+	}
+
+	async save(entity: Board, tx?: Transaction): Promise<Board> {
+		entity.incrementVersion()
+		const dbc = (tx ?? this.db) as DrizzleClient
+		const result = await tryCatchAsync(async () => {
+			const rawLists = entity.listsJson.map(l => ({ listId: l.listId, name: l.name, position: l.position }))
+			await dbc
+				.insert(boards)
+				.values({
+					id: entity.id.value,
+					storeId: entity.storeId.value,
+					ownerId: entity.ownerId.value,
+					name: entity.name,
+					listsJson: rawLists,
+					archivedAt: entity.archivedAt,
+					version: entity.version,
+				})
+				.onConflictDoUpdate({
+					target: boards.id,
+					set: {
+						name: entity.name,
+						listsJson: rawLists,
+						archivedAt: entity.archivedAt,
+						updatedAt: new Date(),
+						version: entity.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: Transaction): Promise<void> {
+		const dbc = (tx ?? this.db) as DrizzleClient
+		const result = await tryCatchAsync(async () => {
+			await dbc.delete(boards).where(eq(boards.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+}
