+import { injectable } from 'tsyringe-neo'
+import { DrizzleClient, Repository, tryCatchAsync } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { and, eq, isNull } from 'drizzle-orm'
+import { cards } from '@template/contracts/db'
+import { Card } from '../entities/Card'
+import { CardStatus } from '../enums/CardStatus'
+
+export abstract class CardRepository extends Repository<Card> {
+	abstract findById(id: string, tx?: Transaction): Promise<Card | undefined>
+	abstract findByBoardId(boardId: string, tx?: Transaction): Promise<Card[]>
+	abstract findByListId(boardId: string, listId: string, tx?: Transaction): Promise<Card[]>
+}
+
+@injectable()
+export class MockCardRepository extends CardRepository {
+	private rows = new Map<string, Card>()
+
+	async findById(id: string, _tx?: Transaction): Promise<Card | undefined> {
+		return this.rows.get(id)
+	}
+
+	async findByBoardId(boardId: string, _tx?: Transaction): Promise<Card[]> {
+		const out: Card[] = []
+		for (const row of this.rows.values()) {
+			if (row.boardId.value === boardId) out.push(row)
+		}
+		return out
+	}
+
+	async findByListId(boardId: string, listId: string, _tx?: Transaction): Promise<Card[]> {
+		const out: Card[] = []
+		for (const row of this.rows.values()) {
+			if (row.boardId.value === boardId && row.listId.value === listId && !row.isArchived()) out.push(row)
+		}
+		return out
+	}
+
+	async save(entity: Card, _tx?: Transaction): Promise<Card> {
+		entity.incrementVersion()
+		this.rows.set(entity.id.value, entity)
+		return entity
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.rows.delete(id)
+	}
+
+	seed(card: Card): void {
+		this.rows.set(card.id.value, card)
+	}
+
+	clear(): void {
+		this.rows.clear()
+	}
+}
+
+type CardRow = typeof cards.$inferSelect
+
+function toDomain(row: CardRow): Card {
+	return new Card({
+		id: row.id,
+		boardId: row.boardId,
+		listId: row.listId,
+		storeId: row.storeId,
+		ownerId: row.ownerId,
+		title: row.title,
+		position: row.position,
+		archivedAt: row.archivedAt ?? null,
+		status: row.archivedAt ? CardStatus.ARCHIVED : CardStatus.ACTIVE,
+		createdAt: row.createdAt,
+		updatedAt: row.updatedAt,
+		version: row.version,
+	})
+}
+
+@injectable()
+export class DrizzleCardRepository extends CardRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: Transaction): Promise<Card | undefined> {
+		const dbc = (tx ?? this.db) as DrizzleClient
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(cards).where(eq(cards.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return toDomain(result.data)
+	}
+
+	async findByBoardId(boardId: string, tx?: Transaction): Promise<Card[]> {
+		const dbc = (tx ?? this.db) as DrizzleClient
+		const result = await tryCatchAsync(async () => {
+			return await dbc.select().from(cards).where(eq(cards.boardId, boardId))
+		})
+		if (!result.success) throw result.error
+		return result.data.map(toDomain)
+	}
+
+	async findByListId(boardId: string, listId: string, tx?: Transaction): Promise<Card[]> {
+		const dbc = (tx ?? this.db) as DrizzleClient
+		const result = await tryCatchAsync(async () => {
+			return await dbc
+				.select()
+				.from(cards)
+				.where(and(eq(cards.boardId, boardId), eq(cards.listId, listId), isNull(cards.archivedAt)))
+				.orderBy(cards.position)
+		})
+		if (!result.success) throw result.error
+		return result.data.map(toDomain)
+	}
+
+	async save(entity: Card, tx?: Transaction): Promise<Card> {
+		entity.incrementVersion()
+		const dbc = (tx ?? this.db) as DrizzleClient
+		const result = await tryCatchAsync(async () => {
+			await dbc
+				.insert(cards)
+				.values({
+					id: entity.id.value,
+					boardId: entity.boardId.value,
+					listId: entity.listId.value,
+					storeId: entity.storeId.value,
+					ownerId: entity.ownerId.value,
+					title: entity.title,
+					position: entity.position,
+					archivedAt: entity.archivedAt,
+					version: entity.version,
+				})
+				.onConflictDoUpdate({
+					target: cards.id,
+					set: {
+						listId: entity.listId.value,
+						title: entity.title,
+						position: entity.position,
+						archivedAt: entity.archivedAt,
+						updatedAt: new Date(),
+						version: entity.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: Transaction): Promise<void> {
+		const dbc = (tx ?? this.db) as DrizzleClient
+		const result = await tryCatchAsync(async () => {
+			await dbc.delete(cards).where(eq(cards.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+}
