+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { BoardRepository } from '../repositories/BoardRepository'
+import { BoardArchivedEvent } from '../events/BoardArchivedEvent'
+import type { ApplicationErrors } from '../errors'
+
+export const ArchiveBoardInputSchema = z.object({
+	boardId: z.string().uuid(),
+	storeId: z.string().uuid(),
+	userId: z.string().uuid(),
+})
+
+export const ArchiveBoardOutputSchema = z.object({})
+
+@injectable()
+export class ArchiveBoard extends Handler<typeof ArchiveBoardInputSchema, typeof ArchiveBoardOutputSchema> {
+	readonly name = 'archive_board' as const
+	readonly inputSchema = ArchiveBoardInputSchema
+	readonly outputSchema = ArchiveBoardOutputSchema
+
+	constructor(private readonly boardRepo: BoardRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		const board = await this.boardRepo.findById(input.boardId, tx)
+		if (board === undefined || board.storeId.value !== input.storeId) {
+			throw new BaseError<ApplicationErrors>('BOARD_NOT_FOUND')
+		}
+
+		// Entity throws BOARD_ALREADY_ARCHIVED if already archived.
+		board.archive()
+
+		return this.withTransaction(tx, async tx => {
+			await this.boardRepo.save(board, tx)
+			await this.domainEventRepository.save(
+				new BoardArchivedEvent({
+					entityId: board.id.value,
+					ownerId: input.userId,
+					payload: {
+						boardId: board.id.value,
+						storeId: input.storeId,
+					},
+				}),
+				tx,
+			)
+			return {}
+		})
+	}
+}
