+		</div>
+	)
+}
+
+// ── Board card ────────────────────────────────────────────────────────────────
+
+function BoardCard({ board }: { board: BoardItem }) {
+	const { t } = useTranslation()
+	return (
+		<Card role="listitem" aria-label={board.name}>
+			<CardHeader className="pb-2">
+				<CardTitle className="flex items-center justify-between gap-2 text-base">
+					<span className="truncate">{board.name}</span>
+					{board.archivedAt !== null && (
+						<Badge variant="outline">{t('boards.archived')}</Badge>
+					)}
+				</CardTitle>
+			</CardHeader>
+			<CardContent className="text-sm text-muted-foreground">
+				{t('boards.listCount', { count: board.listCount })} · {t('boards.cardCount', { count: board.cardCount })}
+			</CardContent>
+		</Card>
+	)
+}
+
+// ── Section ───────────────────────────────────────────────────────────────────
+
+export function BoardsSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { show } = useDialogStore()
+	const { data } = useListBoards()
+
+	return (
+		<div className={cn('flex flex-col gap-4', className)} {...props}>
+			{/* Static header — always visible */}
+			<div className="flex items-center justify-between">
+				<h1 className="text-2xl font-bold text-foreground">{t('boards.title')}</h1>
+				<Button onClick={() => show(<CreateBoardDialog />)}>
+					{t('boards.createBoard')}
+				</Button>
+			</div>
+
+			{/* Data-dependent area */}
+			{data ? (
+				data.boards.length === 0 ? (
+					<div className="flex flex-col items-center gap-3 py-16 text-muted-foreground">
+						<IconLayoutKanban className="size-10 opacity-40" />
+						<p>{t('boards.emptyState')}</p>
+					</div>
+				) : (
+					<div
+						role="list"
+						aria-label={t('boards.title')}
+						className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
+					>
+						{data.boards.map(board => (
+							<BoardCard key={board.boardId} board={board} />
+						))}
+					</div>
+				)
+			) : (
+				<BoardsGridSkeleton />
+			)}
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/(app)/boards/-components/CreateBoardDialog.tsx b/packages/app/react/src/routes/(app)/boards/-components/CreateBoardDialog.tsx
new file mode 100644
index 000000000..7e078b45a
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/boards/-components/CreateBoardDialog.tsx
@@ -0,0 +1,120 @@
+import { useTranslation } from 'react-i18next'
+import { useForm } from '@tanstack/react-form'
+import { useQueryClient } from '@tanstack/react-query'
+import { toast } from 'sonner'
+
+import {
+	useCreateBoard,
+	createBoardMutationRequestSchema,
+	listBoardsQueryKey,
+	type CreateBoardMutationRequest,
+} from '@template/client-typescript/typescript'
+import { Button } from '@/components/ui/button'
+import {
+	DialogContent,
+	DialogDescription,
+	DialogFooter,
+	DialogHeader,
+	DialogTitle,
+} from '@/components/ui/dialog'
+import { Field, FieldError, FieldLabel } from '@/components/ui/field'
+import { Input } from '@/components/ui/input'
+import { Spinner } from '@/components/ui/spinner'
+import type { DeepPartial } from '@/lib'
+import { useDialogStore } from '@/stores/useDialogStore'
+
+export function CreateBoardDialog() {
+	const { t } = useTranslation()
+	const hide = useDialogStore(s => s.hide)
+	const queryClient = useQueryClient()
+
+	const createBoard = useCreateBoard({
+		mutation: {
+			onSuccess: () => {
+				queryClient.invalidateQueries({ queryKey: listBoardsQueryKey() })
+				toast.success(t('boards.createSuccess'))
+				hide()
+			},
+		},
+	})
+
+	const defaultValues: DeepPartial<CreateBoardMutationRequest> = {}
+
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: createBoardMutationRequestSchema },
+		onSubmit: async ({ value }) => {
+			const result = createBoardMutationRequestSchema.safeParse(value)
+			if (!result.success) return
+			await createBoard.mutateAsync({ data: result.data })
+		},
+	})
+
+	return (
+		<DialogContent className="sm:max-w-md">
+			<DialogHeader>
+				<DialogTitle>{t('boards.createDialog.title')}</DialogTitle>
+				<DialogDescription>{t('boards.createDialog.description')}</DialogDescription>
+			</DialogHeader>
+
+			<form
+				noValidate
+				className="flex flex-col gap-4"
+				onSubmit={e => {
+					e.preventDefault()
+					e.stopPropagation()
+					form.handleSubmit()
+				}}
+			>
+				<form.Field name="name">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>
+									{t('boards.createDialog.nameLabel')}
+								</FieldLabel>
+								<Input
+									id={field.name}
+									value={field.state.value ?? ''}
+									placeholder={t('boards.createDialog.namePlaceholder')}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				<DialogFooter>
+					<Button type="button" variant="outline" onClick={hide}>
+						{t('boards.createDialog.cancel')}
+					</Button>
+					<form.Subscribe
+						selector={state => ({
+							canSubmit: state.canSubmit,
+							isSubmitting: state.isSubmitting,
+							values: state.values,
+						})}
+					>
+						{({ canSubmit, isSubmitting, values }) => {
+							const isPending = isSubmitting || createBoard.isPending
+							const isDisabled =
+								!canSubmit ||
+								isPending ||
+								!createBoardMutationRequestSchema.safeParse(values).success
+							return (
+								<Button type="submit" disabled={isDisabled}>
+									{isPending && <Spinner className="mr-2" />}
+									{t('boards.createDialog.confirm')}
+								</Button>
+							)
+						}}
+					</form.Subscribe>
+				</DialogFooter>
+			</form>
+		</DialogContent>
+	)
+}
