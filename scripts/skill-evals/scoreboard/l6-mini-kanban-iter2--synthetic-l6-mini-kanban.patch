@@ -0,0 +1,66 @@
+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import { BoardStatus } from '../enums/BoardStatus'
+import type { BoardApplicationErrors } from '../errors'
+import { ListSlot } from './ListSlot'
+
+const MAX_LISTS = 20
+
+const BoardSchema = z.object({
+	storeId: z.instance(Id),
+	ownerId: z.instance(Id),
+	name: z.string().min(1).max(100),
+	listsJson: z.array(z.instance(ListSlot)).default([]),
+	archivedAt: z.date().nullable().default(null),
+	status: z.enum(BoardStatus).default(BoardStatus.ACTIVE),
+})
+
+export type BoardProps = Z.infer<typeof BoardSchema>
+
+export class Board extends AggregateRoot<typeof BoardSchema> {
+	static override schema = BoardSchema
+
+	static create(data: { storeId: string; ownerId: string; name: string }): Board {
+		return new Board({
+			storeId: data.storeId,
+			ownerId: data.ownerId,
+			name: data.name,
+			listsJson: [],
+			archivedAt: null,
+			status: BoardStatus.ACTIVE,
+		})
+	}
+
+	addList(data: { listId: string; name: string; position: number }): void {
+		if (this.isArchived()) throw new BaseError<BoardApplicationErrors>('BOARD_ALREADY_ARCHIVED')
+		if (this.listsJson.length >= MAX_LISTS) throw new BaseError<BoardApplicationErrors>('BOARD_LIST_LIMIT_REACHED')
+		this.listsJson = [...this.listsJson, new ListSlot({ listId: data.listId, name: data.name, position: data.position })]
+		this.validate()
+	}
+
+	archive(): void {
+		if (this.isArchived()) throw new BaseError<BoardApplicationErrors>('BOARD_ALREADY_ARCHIVED')
+		this.archivedAt = new Date()
+		this.status = BoardStatus.ARCHIVED
+		this.validate()
+	}
+
+	updateTitle(name: string): void {
+		this.name = name
+		this.validate()
+	}
+
+	isArchived(): boolean {
+		return this.status === BoardStatus.ARCHIVED
+	}
+
+	hasListWithId(listId: string): boolean {
+		return this.listsJson.some(l => l.listId === listId)
+	}
+
+	getListById(listId: string): ListSlot | undefined {
+		return this.listsJson.find(l => l.listId === listId)
+	}
+}
+
+export interface Board extends BoardProps {}
