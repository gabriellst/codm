@@ -0,0 +1,43 @@
+import { pgSchema, uuid, text, timestamp, integer, jsonb, index } from 'drizzle-orm/pg-core'
+
+/**
+ * `board` is the Kanban Board BC schema.
+ *
+ * The Board aggregate owns its ordered lists as a JSONB array (ListSlot VOs).
+ * Lists are immutable value objects — they have no lifecycle of their own.
+ *
+ * Tables:
+ *   - `boards` — one row per board workspace
+ */
+export const boardSchema = pgSchema('board')
+
+export const boards = boardSchema.table(
+	'boards',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		// Tenant scoping.
+		storeId: uuid('store_id').notNull(),
+
+		// Creator / owner.
+		ownerId: uuid('owner_id').notNull(),
+
+		// Human-readable board name. Mutable.
+		name: text('name').notNull(),
+
+		// Ordered ListSlot VOs: [{ listId: string, name: string, position: number }]
+		// Managed entirely by the Board aggregate. Never written directly by other contexts.
+		listsJson: jsonb('lists_json').notNull().default('[]'),
+
+		// Soft-archive timestamp. Non-null means the board is archived.
+		archivedAt: timestamp('archived_at', { withTimezone: true }),
+
+		// Audit / optimistic concurrency.
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		storeIdx: index('boards_store_id_idx').on(t.storeId),
+	}),
+)
