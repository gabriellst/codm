@@ -0,0 +1,21 @@
+import { injectable } from 'tsyringe-neo'
+import { EventHandler } from '@template/core-typescript'
+import { BoardArchivedEvent } from '@board/events/BoardArchivedEvent'
+import { BoardViewProjection } from '../BoardViewProjection'
+import { BoardViewProjectionRepository } from '../BoardViewProjectionRepository'
+
+@injectable()
+export class BoardArchivedProjector extends EventHandler<typeof BoardArchivedEvent> {
+	readonly event = BoardArchivedEvent
+
+	constructor(private readonly repo: BoardViewProjectionRepository) {
+		super()
+	}
+
+	async handle(event: this['input']): Promise<void> {
+		const projection = await this.repo.findByBoardId(event.payload.boardId)
+		if (!projection) return
+		projection.applyEvent(event)
+		await this.repo.save(projection)
+	}
+}
