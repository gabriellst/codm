diff --git a/packages/api/typescript/src/board/controllers/AddListToBoard.ts b/packages/api/typescript/src/board/controllers/AddListToBoard.ts
new file mode 100644
index 000000000..6fc5c1d16
--- /dev/null
+++ b/packages/api/typescript/src/board/controllers/AddListToBoard.ts
@@ -0,0 +1,52 @@
+import { injectable } from 'tsyringe-neo'
+import { Controller, HttpStatusCode, z } from '@template/core-typescript'
+import { AuthAccountMiddleware } from '@auth/middlewares/AuthAccountMiddleware'
+import { RequireStoreMember } from '@tenancy/middlewares/RequireStoreMember'
+import { AddListToBoard } from '../usecases/AddListToBoard'
+
+export const AddListToBoardControllerInputSchema = z.object({
+	ctx: z.object({
+		user: z.object({ id: z.string() }),
+		session: z.object({ storeId: z.uuid() }),
+	}),
+	params: z.object({
+		boardId: z.uuid(),
+	}),
+	body: z.object({
+		name: z.string().min(1).max(100),
+		position: z.number().int().min(0),
+	}),
+})
+
+export const AddListToBoardControllerOutputSchema = z.object({
+	listId: z.string().uuid(),
+})
+
+@injectable()
+export class AddListToBoardController extends Controller<
+	typeof AddListToBoardControllerInputSchema,
+	typeof AddListToBoardControllerOutputSchema
+> {
+	readonly path = '/boards/:boardId/lists'
+	readonly method = 'post' as const
+	readonly description = 'Add a list to a Kanban board'
+	readonly inputSchema = AddListToBoardControllerInputSchema
+	readonly outputSchema = AddListToBoardControllerOutputSchema
+
+	override middlewares = [AuthAccountMiddleware, RequireStoreMember]
+
+	constructor(private readonly addListToBoard: AddListToBoard) {
+		super()
+	}
+
+	async handle(request: this['input']): Promise<this['output']> {
+		const data = await this.addListToBoard.execute({
+			boardId: request.params.boardId,
+			name: request.body.name,
+			position: request.body.position,
+			storeId: request.ctx.session.storeId,
+			userId: request.ctx.user.id,
+		})
+		return { status: HttpStatusCode.CREATED, data }
+	}
+}
