@@ -0,0 +1,87 @@
+import { ScrollView, Pressable, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import { NotificationCategoryEnum, type NotificationCategory } from '@template/client-typescript/typescript'
+import { Text } from '@/components/ui/Text'
+import { ToggleRow } from '@/components/ui/ToggleRow'
+import { fs, letterSpacingPt, surfaces, border, fg } from '@/lib/tokens'
+
+export const ALL_CATEGORIES = 'ALL' as const
+export type CategoryFilter = NotificationCategory | typeof ALL_CATEGORIES
+
+interface CategoryFilterProps {
+	selected: CategoryFilter
+	unreadOnly: boolean
+	onSelectCategory: (cat: CategoryFilter) => void
+	onToggleUnread: (val: boolean) => void
+}
+
+export function CategoryFilter({ selected, unreadOnly, onSelectCategory, onToggleUnread }: CategoryFilterProps) {
+	const { t } = useTranslation()
+
+	return (
+		<View className="gap-2 pb-2">
+			<ScrollView
+				horizontal
+				showsHorizontalScrollIndicator={false}
+				contentContainerStyle={{ paddingHorizontal: 16, gap: 8, paddingVertical: 4 }}
+			>
+				<CategoryChip
+					label={t('notifications.filterAll')}
+					active={selected === ALL_CATEGORIES}
+					onPress={() => onSelectCategory(ALL_CATEGORIES)}
+				/>
+				{Object.values(NotificationCategoryEnum).map(cat => (
+					<CategoryChip
+						key={cat}
+						label={t(`enums.NotificationCategory.${cat}`)}
+						active={selected === cat}
+						onPress={() => onSelectCategory(cat)}
+					/>
+				))}
+			</ScrollView>
+			<View className="px-4">
+				<ToggleRow
+					label={t('notifications.unreadOnly')}
+					value={unreadOnly}
+					onChange={onToggleUnread}
+				/>
+			</View>
+		</View>
+	)
+}
+
+interface CategoryChipProps {
+	label: string
+	active: boolean
+	onPress: () => void
+}
+
+function CategoryChip({ label, active, onPress }: CategoryChipProps) {
+	return (
+		<Pressable
+			onPress={onPress}
+			accessibilityRole="button"
+			accessibilityState={{ selected: active }}
+			style={{
+				backgroundColor: active ? surfaces.surface3 : surfaces.surface1,
+				borderWidth: 1,
+				borderColor: active ? border.borderStrong : border.borderSubtle,
+				borderRadius: 9999,
+				paddingHorizontal: 12,
+				paddingVertical: 6,
+			}}
+		>
+			<Text
+				className="font-sans-bold uppercase"
+				style={{
+					fontSize: fs.micro,
+					letterSpacing: letterSpacingPt(0.18, fs.micro),
+					color: fg.fg0,
+					opacity: active ? 1 : 0.45,
+				}}
+			>
+				{label}
+			</Text>
+		</Pressable>
+	)
+}
diff --git a/packages/app/expo/app/(tabs)/notifications/-components/NotificationList/index.tsx b/packages/app/expo/app/(tabs)/notifications/-components/NotificationList/index.tsx
