+import { ScrollView, View } from 'react-native'
+import { z } from 'zod'
+import { NotificationCategoryEnum } from '@template/client-typescript/typescript'
+import { useTypedSearchParams } from '@/lib/typed-route'
+import { CategoryFilter } from './-components/CategoryFilter'
+import { NotificationList } from './-components/NotificationList'
+
+const CATEGORY_VALUES = [...Object.values(NotificationCategoryEnum), 'ALL'] as const
+
+const schema = z.object({
+	category: z.enum(CATEGORY_VALUES).default('ALL'),
+	unread: z.enum(['true', 'false']).default('false'),
+})
+
+export default function NotificationsScreen() {
+	const [{ category, unread }, setParams] = useTypedSearchParams(schema)
+
+	return (
+		<View className="flex-1 bg-background">
+			<ScrollView
+				contentContainerStyle={{ paddingBottom: 110 }}
+				contentInsetAdjustmentBehavior="automatic"
+				showsVerticalScrollIndicator={false}
+				className="flex-1"
+			>
+				<CategoryFilter
+					selected={category}
+					unreadOnly={unread === 'true'}
+					onSelectCategory={cat => setParams({ category: cat })}
+					onToggleUnread={val => setParams({ unread: val ? 'true' : 'false' })}
+				/>
+				<NotificationList category={category} unreadOnly={unread === 'true'} />
+			</ScrollView>
+		</View>
+	)
+}
