@@ -0,0 +1,136 @@
+import { ActivityIndicator, Pressable, ScrollView, View } from 'react-native'
+import { router } from 'expo-router'
+import { useQueryClient } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+import { z } from 'zod'
+import { Haptics } from 'react-native-nitro-haptics'
+import {
+	useListNotifications,
+	useMarkNotificationRead,
+	listNotificationsQueryKey,
+} from '@template/client-typescript/typescript'
+import { Protected } from '@/components/Protected'
+import { Text } from '@/components/ui/Text'
+import { ScreenError } from '@/components/ui/ScreenError'
+import { fg, fs, surfaces, accent } from '@/lib/tokens'
+import { useTypedSearchParams } from '@/lib/typed-route'
+import { formatRelativeHistoryDate } from '@/lib/format-date'
+
+const schema = z.object({
+	id: z.string().default(''),
+})
+
+export default function NotificationDetailSheet() {
+	const { t, i18n } = useTranslation()
+	const [{ id }] = useTypedSearchParams(schema)
+	const queryClient = useQueryClient()
+
+	const { data, error, refetch } = useListNotifications({ limit: 100 })
+	const markRead = useMarkNotificationRead()
+
+	const notification = data?.items.find(n => n.id === id) ?? null
+
+	const handleMarkRead = async () => {
+		if (!notification || notification.read) return
+		await markRead.mutateAsync(
+			{ data: { notificationDeliveryIds: [notification.id] } },
+			{
+				onSuccess: () => Haptics.notification('success'),
+				onSettled: () => queryClient.invalidateQueries({ queryKey: listNotificationsQueryKey() }),
+			},
+		)
+	}
+
+	return (
+		<Protected>
+			<View className="flex-1" style={{ backgroundColor: surfaces.surface1 }}>
+				<View className="flex-row items-center justify-between px-5 pt-4 pb-2">
+					<Text
+						className="font-sans-bold"
+						style={{ fontSize: fs.headerTitle, color: fg.fg0 }}
+					>
+						{t('notificationDetail.title')}
+					</Text>
+					<Pressable
+						onPress={() => router.back()}
+						accessibilityRole="button"
+						accessibilityLabel={t('common.close')}
+						hitSlop={12}
+					>
+						<Text style={{ fontSize: fs.sm, color: fg.fg1 }}>{t('common.close')}</Text>
+					</Pressable>
+				</View>
+
+				{error ? (
+					<ScreenError onRetry={() => void refetch()} />
+				) : !data ? (
+					<View className="flex-1 items-center justify-center">
+						<ActivityIndicator color={fg.fg0} />
+					</View>
+				) : !notification ? (
+					<View className="flex-1 items-center justify-center px-8">
+						<Text style={{ fontSize: fs.sm, color: fg.fg2, textAlign: 'center' }}>
+							{t('notifications.emptyFiltered.title')}
+						</Text>
+					</View>
+				) : (
+					<ScrollView
+						className="flex-1"
+						contentContainerStyle={{ paddingHorizontal: 20, paddingBottom: 32, gap: 16 }}
+						showsVerticalScrollIndicator={false}
+					>
+						<Text className="font-sans-bold" style={{ fontSize: fs.lg, color: fg.fg0 }}>
+							{notification.title}
+						</Text>
+
+						<Text className="font-sans" style={{ fontSize: fs.base, color: fg.fg1, lineHeight: fs.base * 1.55 }}>
+							{notification.message}
+						</Text>
+
+						<View className="gap-2 pt-2">
+							<MetaRow
+								label={t('notificationDetail.category')}
+								value={t(`enums.NotificationCategory.${notification.category}`)}
+							/>
+							<MetaRow
+								label={t('notificationDetail.date')}
+								value={formatRelativeHistoryDate({
+									isoDate: notification.createdAt,
+									t,
+									language: i18n.language,
+								})}
+							/>
+						</View>
+
+						{!notification.read && (
+							<Pressable
+								onPress={handleMarkRead}
+								accessibilityRole="button"
+								className="rounded-xl py-3 items-center"
+								style={{ backgroundColor: accent.successBg, borderWidth: 1, borderColor: accent.successBorder }}
+							>
+								<Text style={{ fontSize: fs.sm, color: accent.success, fontWeight: '600' }}>
+									{t('notificationDetail.markRead')}
+								</Text>
+							</Pressable>
+						)}
+					</ScrollView>
+				)}
+			</View>
+		</Protected>
+	)
+}
+
+interface MetaRowProps {
+	label: string
+	value: string
+}
+
+function MetaRow({ label, value }: MetaRowProps) {
+	return (
+		<View className="flex-row items-center justify-between">
+			<Text style={{ fontSize: fs.xs, color: fg.fg2 }}>{label}</Text>
+			<Text style={{ fontSize: fs.xs, color: fg.fg1 }}>{value}</Text>
+		</View>
+	)
+}
