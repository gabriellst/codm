@@ -0,0 +1,54 @@
+import { View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import { useListNotifications } from '@template/client-typescript/typescript'
+import { EmptyState } from '@/components/ui/EmptyState'
+import { ScreenError } from '@/components/ui/ScreenError'
+import { NotificationRow } from '../NotificationRow'
+import { ALL_CATEGORIES } from '../CategoryFilter'
+import type { CategoryFilter } from '../CategoryFilter'
+
+interface NotificationListProps {
+	category: CategoryFilter
+	unreadOnly: boolean
+}
+
+function SkeletonRows() {
+	return (
+		<View className="flex-col gap-3 px-4">
+			{[1, 2, 3, 4, 5].map(key => (
+				<View key={key} className="h-20 rounded-xl" style={{ backgroundColor: 'rgba(255,255,255,0.05)' }} />
+			))}
+		</View>
+	)
+}
+
+export function NotificationList({ category, unreadOnly }: NotificationListProps) {
+	const { t } = useTranslation()
+	const { data, error, refetch } = useListNotifications({ unreadOnly: unreadOnly || undefined })
+
+	if (error) return <ScreenError onRetry={() => void refetch()} />
+
+	const items = data
+		? category === ALL_CATEGORIES
+			? data.items
+			: data.items.filter(n => n.category === category)
+		: null
+
+	return (
+		<View className="flex-col gap-3 px-4 pt-2">
+			{items === null ? (
+				<SkeletonRows />
+			) : items.length === 0 ? (
+				category === ALL_CATEGORIES ? (
+					<EmptyState title={t('notifications.empty.title')} body={t('notifications.empty.body')} />
+				) : (
+					<EmptyState title={t('notifications.emptyFiltered.title')} body={t('notifications.emptyFiltered.body')} />
+				)
+			) : (
+				items.map(notification => (
+					<NotificationRow key={notification.id} notification={notification} />
+				))
+			)}
+		</View>
+	)
+}
