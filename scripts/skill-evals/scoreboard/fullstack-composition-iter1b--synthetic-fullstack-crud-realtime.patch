+import { injectable } from 'tsyringe-neo'
+import { and, count, desc, eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { purchaseOrders } from '@template/contracts/db'
+import { PurchaseOrderStatus } from '@template/contracts-typescript/wire/enums'
+import { PurchaseOrder, PurchaseOrderSchema } from '../../entities/PurchaseOrder'
+import { PurchaseOrderRepository } from './PurchaseOrderRepository'
+
+@injectable()
+export class DrizzlePurchaseOrderRepository extends PurchaseOrderRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: Transaction): Promise<PurchaseOrder | undefined> {
+		const dbc = (tx as DrizzleClient | undefined) ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(purchaseOrders).where(eq(purchaseOrders.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async listByStore(
+		storeId: string,
+		opts: { limit: number; offset: number; status?: string },
+		tx?: Transaction,
+	): Promise<{ items: PurchaseOrder[]; total: number }> {
+		const dbc = (tx as DrizzleClient | undefined) ?? this.db
+		const where = opts.status
+			? and(eq(purchaseOrders.storeId, storeId), eq(purchaseOrders.status, opts.status as PurchaseOrderStatus))
+			: eq(purchaseOrders.storeId, storeId)
+		const result = await tryCatchAsync(async () => {
+			const [items, totalRows] = await Promise.all([
+				dbc
+					.select()
+					.from(purchaseOrders)
+					.where(where)
+					.orderBy(desc(purchaseOrders.createdAt))
+					.limit(opts.limit)
+					.offset(opts.offset),
+				dbc.select({ value: count() }).from(purchaseOrders).where(where),
+			])
+			return { items, total: Number(totalRows[0]?.value ?? 0) }
+		})
+		if (!result.success) throw result.error
+		return { total: result.data.total, items: result.data.items.map(r => this.toDomain(r)) }
+	}
+
+	async save(entity: PurchaseOrder, tx?: Transaction): Promise<PurchaseOrder> {
+		entity.incrementVersion()
+		const dbc = (tx as DrizzleClient | undefined) ?? this.db
+		const data = this.toPersistence(entity)
+		const result = await tryCatchAsync(async () => {
+			await dbc
+				.insert(purchaseOrders)
+				.values(data)
+				.onConflictDoUpdate({
+					target: purchaseOrders.id,
+					set: {
+						supplierName: data.supplierName,
+						status: data.status,
+						totalAmountCents: data.totalAmountCents,
+						totalAmountCurrency: data.totalAmountCurrency,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+		})
+		if (!result.success) throw result.error
+		return entity
+	}
+
+	async delete(_id: string, _tx?: Transaction): Promise<void> {
+		// Purchase orders are cancelled, not deleted — no-op.
+	}
+
+	private toDomain(row: typeof purchaseOrders.$inferSelect): PurchaseOrder {
+		const parsed = PurchaseOrderSchema.parse({
+			storeId: row.storeId,
+			supplierName: row.supplierName,
+			status: row.status,
+			totalAmount: { amountCents: Number(row.totalAmountCents), currency: row.totalAmountCurrency },
+		})
+		return new PurchaseOrder({
+			...parsed,
+			id: row.id,
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: PurchaseOrder): typeof purchaseOrders.$inferInsert {
+		return {
+			id: entity.id.value,
+			storeId: entity.storeId.value,
+			supplierName: entity.supplierName,
+			status: entity.status as PurchaseOrderStatus,
+			totalAmountCents: BigInt(entity.totalAmount.amountCents),
+			totalAmountCurrency: entity.totalAmount.currency,
+			version: entity.version,
+		}
+	}
+}
