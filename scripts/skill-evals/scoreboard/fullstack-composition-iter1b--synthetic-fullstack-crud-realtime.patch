+	const { hide } = useDialogStore()
+	const queryClient = useQueryClient()
+
+	const createPurchaseOrder = useCreatePurchaseOrder({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('purchaseOrders.createDialog.submit'))
+				queryClient.invalidateQueries({ queryKey: listPurchaseOrdersQueryKey() })
+				hide()
+			},
+		},
+	})
+
+	const defaultValues: DeepPartial<CreatePurchaseOrderMutationRequest> = {}
+
+	const form = useForm({
+		defaultValues,
+		validators: {
+			onChange: createPurchaseOrderMutationRequestSchema,
+		},
+		onSubmit: async ({ value }) => {
+			const result = createPurchaseOrderMutationRequestSchema.safeParse(value)
+			if (!result.success) return
+			await createPurchaseOrder.mutateAsync({ data: result.data })
+		},
+	})
+
+	return (
+		<DialogContent className="sm:max-w-md" showCloseButton>
+			<DialogHeader>
+				<DialogTitle>{t('purchaseOrders.createDialog.title')}</DialogTitle>
+			</DialogHeader>
+
+			<form
+				noValidate
+				className="flex flex-col gap-4"
+				onSubmit={e => {
+					e.preventDefault()
+					e.stopPropagation()
+					form.handleSubmit()
+				}}
+			>
+				{/* supplierName */}
+				<form.Field name="supplierName">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<FieldGroup>
+								<FieldLabel htmlFor={field.name}>
+									{t('purchaseOrders.createDialog.supplierNameLabel')}
+								</FieldLabel>
+								<Input
+									id={field.name}
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</FieldGroup>
+						)
+					}}
+				</form.Field>
+
+				{/* totalAmount — CurrencyInput handles amountCents + currency together */}
+				<form.Field name="totalAmount">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>
+									{t('purchaseOrders.createDialog.totalAmountLabel')}
+								</FieldLabel>
+								<CurrencyInput
+									amountCents={field.state.value?.amountCents ?? 0}
+									currency={field.state.value?.currency ?? CurrencyCodeEnum.BRL}
+									onAmountChange={cents =>
+										field.handleChange({ ...field.state.value, amountCents: cents })
+									}
+									onCurrencyChange={c =>
+										field.handleChange({ ...field.state.value, currency: c })
+									}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				<DialogFooter>
+					<Button type="button" variant="outline" onClick={hide}>
+						{t('common.cancel')}
+					</Button>
+
+					<form.Subscribe
+						selector={state => ({
+							canSubmit: state.canSubmit,
+							isSubmitting: state.isSubmitting,
+							values: state.values,
+						})}
+					>
+						{({ canSubmit, isSubmitting, values }) => {
+							const isPending = isSubmitting || createPurchaseOrder.isPending
+							const isDisabled =
+								!canSubmit ||
+								isPending ||
+								!createPurchaseOrderMutationRequestSchema.safeParse(values).success
+							return (
+								<Button type="submit" disabled={isDisabled}>
+									{isPending && <Spinner className="mr-2" />}
+									{t('purchaseOrders.createDialog.submit')}
+								</Button>
+							)
+						}}
+					</form.Subscribe>
+				</DialogFooter>
+			</form>
+		</DialogContent>
+	)
+}
