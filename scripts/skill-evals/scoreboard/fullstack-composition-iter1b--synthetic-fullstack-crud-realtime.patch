new file mode 100644
index 000000000..07c74f154
--- /dev/null
+++ b/packages/api/go/internal/sync/handlers/purchase_order_recorded_handler.go
@@ -0,0 +1,77 @@
+package handlers
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"template/contracts-go/wire"
+	"template/core-go/types"
+)
+
+// PurchaseOrderAuditRepository is the minimal interface for writing audit rows.
+type PurchaseOrderAuditRepository interface {
+	InsertAudit(ctx context.Context, row PurchaseOrderAuditRow) error
+}
+
+// PurchaseOrderAuditRow is the data for one audit entry.
+type PurchaseOrderAuditRow struct {
+	PurchaseOrderID     string
+	StoreID             string
+	SupplierName        string
+	Status              string
+	TotalAmountCents    int64
+	TotalAmountCurrency string
+	OccurredAt          time.Time
+}
+
+// PurchaseOrderRecordedHandler consumes integration.shared.purchase_order.recorded
+// and persists an audit row for observability.
+type PurchaseOrderRecordedHandler struct {
+	repo PurchaseOrderAuditRepository
+}
+
+// NewPurchaseOrderRecordedHandler constructs the handler.
+func NewPurchaseOrderRecordedHandler(repo PurchaseOrderAuditRepository) *PurchaseOrderRecordedHandler {
+	return &PurchaseOrderRecordedHandler{repo: repo}
+}
+
+// EventName returns the wire discriminator this handler listens on.
+func (h *PurchaseOrderRecordedHandler) EventName() string {
+	return wire.PurchaseOrderRecordedEventName
+}
+
+// Handle decodes the event payload and persists the audit row.
+func (h *PurchaseOrderRecordedHandler) Handle(ctx context.Context, event types.IntegrationEventI) error {
+	decoded, err := decodePurchaseOrderRecorded(event)
+	if err != nil {
+		return err
+	}
+
+	return h.repo.InsertAudit(ctx, PurchaseOrderAuditRow{
+		PurchaseOrderID:     decoded.PurchaseOrderID,
+		StoreID:             decoded.StoreID,
+		SupplierName:        decoded.SupplierName,
+		Status:              string(decoded.Status),
+		TotalAmountCents:    decoded.TotalAmountCents,
+		TotalAmountCurrency: string(decoded.TotalAmountCurrency),
+		OccurredAt:          decoded.OccurredAt,
+	})
+}
+
+func decodePurchaseOrderRecorded(event types.IntegrationEventI) (wire.PurchaseOrderRecordedEvent, error) {
+	provider, ok := event.(interface{ GetPayload() json.RawMessage })
+	if !ok {
+		return wire.PurchaseOrderRecordedEvent{}, fmt.Errorf("event %s carries no payload", event.GetEventName())
+	}
+	decoded, err := wire.UnmarshalIntegrationEvent(provider.GetPayload())
+	if err != nil {
+		return wire.PurchaseOrderRecordedEvent{}, err
+	}
+	v, ok := decoded.(wire.PurchaseOrderRecordedEvent)
+	if !ok {
+		return wire.PurchaseOrderRecordedEvent{}, fmt.Errorf("unexpected event type %T", decoded)
+	}
+	return v, nil
+}
diff --git a/packages/api/go/internal/sync/handlers/purchase_order_recorded_handler_test.go b/packages/api/go/internal/sync/handlers/purchase_order_recorded_handler_test.go
