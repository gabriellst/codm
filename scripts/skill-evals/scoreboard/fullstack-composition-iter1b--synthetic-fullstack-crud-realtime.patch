+import React from 'react'
+import { useTranslation } from 'react-i18next'
+import { useQueryClient } from '@tanstack/react-query'
+import { toast } from 'sonner'
+import { IconPlus } from '@tabler/icons-react'
+
+import { cn } from '@/lib/utils'
+
+import {
+	useListPurchaseOrders,
+	useCancelPurchaseOrder,
+	listPurchaseOrdersQueryKey,
+	PurchaseOrderStatusEnum,
+	type ListPurchaseOrdersQueryResponse,
+} from '@template/client-typescript/typescript'
+import { useServerEvents, useMoney, useLocale } from '@/hooks'
+import { useDialogStore } from '@/stores/useDialogStore'
+
+import { Button } from '@/components/ui/button'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table'
+
+import { CreatePurchaseOrderDialog } from '../CreatePurchaseOrderDialog'
+
+// ─── Types ────────────────────────────────────────────────────────────────────
+
+export type PurchaseOrderItem = ListPurchaseOrdersQueryResponse['items'][number]
+
+// ─── Inline skeleton ──────────────────────────────────────────────────────────
+
+function SkeletonRows() {
+	return (
+		<>
+			{Array.from({ length: 5 }, (_, i) => (
+				<TableRow key={i}>
+					<TableCell><Skeleton className="h-4 w-32" /></TableCell>
+					<TableCell><Skeleton className="h-4 w-20" /></TableCell>
+					<TableCell><Skeleton className="h-4 w-24" /></TableCell>
+					<TableCell><Skeleton className="h-4 w-32" /></TableCell>
+					<TableCell><Skeleton className="h-6 w-16" /></TableCell>
+				</TableRow>
+			))}
+		</>
+	)
+}
+
+// ─── Component ────────────────────────────────────────────────────────────────
+
+export function PurchaseOrderListSection({ className, ...props }: React.ComponentProps<'section'>) {
+	const { t } = useTranslation()
+	const queryClient = useQueryClient()
+	const { show } = useDialogStore()
+
+	const { data } = useListPurchaseOrders()
+
+	const cancelPurchaseOrder = useCancelPurchaseOrder({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('purchaseOrders.cancelConfirm'))
+				queryClient.invalidateQueries({ queryKey: listPurchaseOrdersQueryKey() })
+			},
+		},
+	})
+
+	useServerEvents('integration.shared.purchase_order.recorded', () => {
+		queryClient.invalidateQueries({ queryKey: listPurchaseOrdersQueryKey() })
+	})
+
+	const handleCancel = (id: string) => {
+		cancelPurchaseOrder.mutate({ id })
+	}
+
+	return (
+		<section className={cn(className)} aria-label={t('purchaseOrders.title')} {...props}>
+			<header className="mb-6 flex items-center justify-between">
+				<h1 className="text-2xl font-bold text-foreground">{t('purchaseOrders.title')}</h1>
+				<Button onClick={() => show(<CreatePurchaseOrderDialog />)}>
+					<IconPlus className="mr-2 size-4" />
+					{t('purchaseOrders.newButton')}
+				</Button>
+			</header>
+
+			<Table>
+				<TableHeader>
+					<TableRow>
+						<TableHead>{t('purchaseOrders.columns.supplierName')}</TableHead>
+						<TableHead>{t('purchaseOrders.columns.status')}</TableHead>
+						<TableHead>{t('purchaseOrders.columns.totalAmount')}</TableHead>
+						<TableHead>{t('purchaseOrders.columns.createdAt')}</TableHead>
+						<TableHead>{t('purchaseOrders.columns.actions')}</TableHead>
+					</TableRow>
+				</TableHeader>
+				<TableBody>
+					{data ? (
+						data.items.map(item => (
+							<PurchaseOrderRow
+								key={item.id}
+								item={item}
+								onCancel={handleCancel}
+								isCancelling={cancelPurchaseOrder.isPending}
+							/>
+						))
+					) : (
+						<SkeletonRows />
+					)}
+				</TableBody>
+			</Table>
+		</section>
+	)
+}
+
+// ─── Leaf row ─────────────────────────────────────────────────────────────────
+
+interface PurchaseOrderRowProps extends React.ComponentProps<'tr'> {
+	item: PurchaseOrderItem
+	onCancel: (id: string) => void
+	isCancelling: boolean
+}
+
+function PurchaseOrderRow({ item, onCancel, isCancelling, className, ...props }: PurchaseOrderRowProps) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const locale = useLocale()
+	const isDraft = item.status === PurchaseOrderStatusEnum.DRAFT
+
+	return (
+		<TableRow className={cn(className)} {...props}>
+			<TableCell>{item.supplierName}</TableCell>
+			<TableCell>{t(`enums.purchaseOrderStatus.${item.status}`)}</TableCell>
+			<TableCell>
+				{formatMoney({ amountCents: item.totalAmountCents, currency: item.totalAmountCurrency })}
+			</TableCell>
+			<TableCell>{new Date(item.createdAt).toLocaleDateString(locale)}</TableCell>
+			<TableCell>
+				<Button
+					variant="destructive"
+					size="sm"
+					disabled={!isDraft || isCancelling}
+					onClick={() => onCancel(item.id)}
+					aria-label={t('purchaseOrders.cancelButton')}
+				>
+					{t('purchaseOrders.cancelButton')}
+				</Button>
+			</TableCell>
+		</TableRow>
+	)
+}
