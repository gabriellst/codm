@@ -0,0 +1,42 @@
+package purchaseorderaudit
+
+import (
+	"context"
+	"database/sql"
+
+	"template/api-go/internal/sync/handlers"
+)
+
+const insertAuditSQL = `
+INSERT INTO procurement.purchase_order_audit
+  (purchase_order_id, store_id, supplier_name, status,
+   total_amount_cents, total_amount_currency, occurred_at)
+VALUES ($1, $2, $3, $4, $5, $6, $7)
+`
+
+// PgPurchaseOrderAuditRepository persists purchase order audit rows to Postgres.
+type PgPurchaseOrderAuditRepository struct {
+	db *sql.DB
+}
+
+// NewPgPurchaseOrderAuditRepository constructs the repository.
+func NewPgPurchaseOrderAuditRepository(db *sql.DB) *PgPurchaseOrderAuditRepository {
+	return &PgPurchaseOrderAuditRepository{db: db}
+}
+
+// InsertAudit persists one audit row.
+func (r *PgPurchaseOrderAuditRepository) InsertAudit(ctx context.Context, row handlers.PurchaseOrderAuditRow) error {
+	_, err := r.db.ExecContext(ctx, insertAuditSQL,
+		row.PurchaseOrderID,
+		row.StoreID,
+		row.SupplierName,
+		row.Status,
+		row.TotalAmountCents,
+		row.TotalAmountCurrency,
+		row.OccurredAt,
+	)
+	return err
+}
+
+// Compile-time: assert that *PgPurchaseOrderAuditRepository satisfies the handler interface.
+var _ handlers.PurchaseOrderAuditRepository = (*PgPurchaseOrderAuditRepository)(nil)
