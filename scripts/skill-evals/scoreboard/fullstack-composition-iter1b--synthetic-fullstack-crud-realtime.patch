@@ -0,0 +1,50 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { container, type DependencyContainer } from 'tsyringe-neo'
+import { TestBed } from '@test/support'
+import { DomainEventRepository } from '@template/core-typescript'
+import { PurchaseOrderStatus } from '@template/contracts-typescript/wire/enums'
+import { CreatePurchaseOrder } from './CreatePurchaseOrder'
+import { PurchaseOrderRepository } from '../repositories/PurchaseOrderRepository'
+import { PurchaseOrderCreatedEvent } from '../events'
+
+const STORE_ID = '660e8400-e29b-41d4-a716-446655440001'
+
+describe('CreatePurchaseOrder', () => {
+	let testBed: TestBed
+	let testContainer: DependencyContainer
+	let create: CreatePurchaseOrder
+	let repo: PurchaseOrderRepository
+
+	beforeAll(async () => {
+		testContainer = container.createChildContainer()
+		testBed = await TestBed.create('integration', { testContainer, ownerId: 'integration-tenant' })
+		create = testBed.resolve(CreatePurchaseOrder)
+		repo = testBed.resolve(PurchaseOrderRepository)
+	})
+	beforeEach(async () => {
+		await testBed.reset()
+	})
+	afterAll(async () => {
+		await testBed.destroy()
+	})
+
+	it('persists the purchase order with DRAFT status and emits PurchaseOrderCreatedEvent', async () => {
+		const { purchaseOrderId } = await create.execute({
+			storeId: STORE_ID,
+			supplierName: 'Acme Corp',
+			totalAmount: { amountCents: 50000, currency: 'BRL' as any },
+		})
+
+		const saved = await repo.findById(purchaseOrderId)
+		expect(saved).toBeDefined()
+		expect(saved!.supplierName).toBe('Acme Corp')
+		expect(saved!.status).toBe(PurchaseOrderStatus.DRAFT)
+		expect(saved!.totalAmount.amountCents).toBe(50000)
+
+		const eventRepo = testBed.resolve(DomainEventRepository)
+		const emitted = await eventRepo.findByType(PurchaseOrderCreatedEvent)
+		expect(emitted).toHaveLength(1)
+		expect(emitted[0]!.payload.purchaseOrderId).toBe(purchaseOrderId)
+		expect(emitted[0]!.payload.storeId).toBe(STORE_ID)
+	})
+})
