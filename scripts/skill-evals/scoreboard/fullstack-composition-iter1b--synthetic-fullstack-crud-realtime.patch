+import { injectable } from 'tsyringe-neo'
+import { EventHandler, ExternalMediator } from '@template/core-typescript'
+import { PurchaseOrderRecordedEvent } from '@template/contracts-typescript/wire/events'
+import { CurrencyCode, PurchaseOrderStatus } from '@template/contracts-typescript/wire/enums'
+import { PurchaseOrderCreatedEvent } from '../events/PurchaseOrderCreatedEvent'
+import { PurchaseOrderCancelledEvent } from '../events/PurchaseOrderCancelledEvent'
+import { PurchaseOrderRepository } from '../repositories/PurchaseOrderRepository'
+
+@injectable()
+export class PurchaseOrderCreatedIntegrationPublisher extends EventHandler<typeof PurchaseOrderCreatedEvent> {
+	readonly event = PurchaseOrderCreatedEvent
+
+	constructor(private readonly mediator: ExternalMediator) {
+		super()
+	}
+
+	async handle(event: this['input']): Promise<void> {
+		await this.mediator.publish(
+			new PurchaseOrderRecordedEvent({
+				ownerId: event.ownerId ?? '',
+				payload: {
+					purchaseOrderId: event.payload.purchaseOrderId,
+					storeId: event.payload.storeId,
+					supplierName: event.payload.supplierName,
+					status: event.payload.status as PurchaseOrderStatus,
+					totalAmountCents: event.payload.totalAmountCents,
+					totalAmountCurrency: event.payload.totalAmountCurrency as CurrencyCode,
+				},
+			}),
+		)
+	}
+}
+
+@injectable()
+export class PurchaseOrderCancelledIntegrationPublisher extends EventHandler<typeof PurchaseOrderCancelledEvent> {
+	readonly event = PurchaseOrderCancelledEvent
+
+	constructor(
+		private readonly mediator: ExternalMediator,
+		private readonly orders: PurchaseOrderRepository,
+	) {
+		super()
+	}
+
+	async handle(event: this['input']): Promise<void> {
+		const entity = await this.orders.findById(event.payload.purchaseOrderId)
+		if (!entity) return
+		await this.mediator.publish(
+			new PurchaseOrderRecordedEvent({
+				ownerId: event.ownerId ?? '',
+				payload: {
+					purchaseOrderId: entity.id.value,
+					storeId: event.payload.storeId,
+					supplierName: entity.supplierName,
+					status: entity.status as PurchaseOrderStatus,
+					totalAmountCents: entity.totalAmount.amountCents,
+					totalAmountCurrency: entity.totalAmount.currency as CurrencyCode,
+				},
+			}),
+		)
+	}
+}
