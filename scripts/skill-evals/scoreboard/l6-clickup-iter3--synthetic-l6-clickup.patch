@@ -0,0 +1,73 @@
+import { injectable } from 'tsyringe-neo'
+import { Handler, BaseError, z } from '@template/core-typescript'
+import { DrizzleClient } from '@template/core-typescript'
+import { eq } from 'drizzle-orm'
+import { workspaces, spaces, lists } from '@template/contracts/db'
+import type { WorkspaceApplicationErrors } from '../../workspace/errors'
+
+export const GetWorkspaceInputSchema = z.object({
+	workspaceId: z.string().uuid(),
+})
+
+export const GetWorkspaceOutputSchema = z.object({
+	id: z.uuid(),
+	name: z.string(),
+	ownerId: z.uuid(),
+	spaces: z.array(z.object({
+		id: z.uuid(),
+		name: z.string(),
+		color: z.string(),
+		position: z.number().int(),
+		lists: z.array(z.object({
+			id: z.uuid(),
+			name: z.string(),
+			position: z.number().int(),
+		})),
+	})),
+})
+
+@injectable()
+export class GetWorkspace extends Handler<typeof GetWorkspaceInputSchema, typeof GetWorkspaceOutputSchema> {
+	readonly name = 'get_workspace' as const
+	readonly inputSchema = GetWorkspaceInputSchema
+	readonly outputSchema = GetWorkspaceOutputSchema
+
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const [workspaceRows, spaceRows, listRows] = await Promise.all([
+			this.db.select().from(workspaces).where(eq(workspaces.id, input.workspaceId)).limit(1),
+			this.db.select().from(spaces).where(eq(spaces.workspaceId, input.workspaceId)),
+			this.db.select().from(lists).where(eq(lists.workspaceId, input.workspaceId)),
+		])
+
+		const workspace = workspaceRows[0]
+		if (!workspace) throw new BaseError<WorkspaceApplicationErrors>('WORKSPACE_NOT_FOUND')
+
+		const listsBySpaceId = new Map<string, typeof listRows>()
+		for (const list of listRows) {
+			const existing = listsBySpaceId.get(list.spaceId) ?? []
+			existing.push(list)
+			listsBySpaceId.set(list.spaceId, existing)
+		}
+
+		return {
+			id: workspace.id,
+			name: workspace.name,
+			ownerId: workspace.ownerId,
+			spaces: spaceRows.map(space => ({
+				id: space.id,
+				name: space.name,
+				color: space.color,
+				position: space.position,
+				lists: (listsBySpaceId.get(space.id) ?? []).map(list => ({
+					id: list.id,
+					name: list.name,
+					position: list.position,
+				})),
+			})),
+		}
+	}
+}
