+import { cn } from '@/lib/utils'
+import { Skeleton } from '@/components/ui/skeleton'
+import { TaskCard } from './TaskCard'
+
+interface BoardViewSectionProps extends ComponentProps<'div'> {
+	workspaceId: string
+	spaceId: string
+}
+
+const COLUMN_ORDER: TaskStatus[] = [
+	TaskStatusEnum.TODO,
+	TaskStatusEnum.IN_PROGRESS,
+	TaskStatusEnum.IN_REVIEW,
+	TaskStatusEnum.DONE,
+]
+
+const COLUMN_LABEL: Record<TaskStatus, string> = {
+	[TaskStatusEnum.TODO]: 'To Do',
+	[TaskStatusEnum.IN_PROGRESS]: 'In Progress',
+	[TaskStatusEnum.IN_REVIEW]: 'In Review',
+	[TaskStatusEnum.DONE]: 'Done',
+}
+
+export function BoardViewSection({ workspaceId, spaceId, className, ...props }: BoardViewSectionProps) {
+	const { data, isPending } = useGetBoardView(workspaceId, spaceId)
+
+	if (isPending) {
+		return (
+			<div className={cn('flex gap-4 overflow-x-auto pb-4', className)} {...props}>
+				{COLUMN_ORDER.map(status => (
+					<div key={status} className="flex w-72 shrink-0 flex-col gap-3">
+						<Skeleton className="h-6 w-24 rounded" />
+						<div className="flex flex-col gap-2">
+							{Array.from({ length: 3 }).map((_, i) => (
+								<Skeleton key={i} className="h-20 w-full rounded-lg" />
+							))}
+						</div>
+					</div>
+				))}
+			</div>
+		)
+	}
+
+	// Build a map from status → column data for O(1) lookup
+	const columnMap = new Map(
+		(data?.columns ?? []).map(col => [col.status, col]),
+	)
+
+	return (
+		<div className={cn('flex gap-4 overflow-x-auto pb-4', className)} {...props}>
+			{COLUMN_ORDER.map(status => {
+				const column = columnMap.get(status)
+				const tasks = column?.tasks ?? []
+
+				return (
+					<div
+						key={status}
+						className="flex w-72 shrink-0 flex-col gap-3 rounded-lg bg-muted/50 p-3"
+					>
+						<div className="flex items-center justify-between">
+							<span className="text-sm font-semibold text-foreground">{COLUMN_LABEL[status]}</span>
+							<span className="text-xs text-muted-foreground">{tasks.length}</span>
+						</div>
+						<div className="flex flex-col gap-2">
+							{tasks.map(task => (
+								<TaskCard
+									key={task.id}
+									id={task.id}
+									title={task.title}
+									status={status}
+									priority={task.priority}
+									assigneeIds={task.assigneeIds}
+								/>
+							))}
+							{tasks.length === 0 && (
+								<p className="text-xs text-muted-foreground py-2 text-center">No tasks</p>
+							)}
+						</div>
+					</div>
+				)
+			})}
+		</div>
+	)
+}
