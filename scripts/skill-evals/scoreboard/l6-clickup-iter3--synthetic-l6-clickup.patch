new file mode 100644
index 000000000..b90c4c29c
--- /dev/null
+++ b/packages/api/typescript/src/ui/usecases/GetBoardView.ts
@@ -0,0 +1,75 @@
+import { injectable } from 'tsyringe-neo'
+import { Handler, z, DrizzleClient } from '@template/core-typescript'
+import { eq, asc } from 'drizzle-orm'
+import { taskProjections } from '@template/contracts/db'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+
+export const GetBoardViewInputSchema = z.object({
+	workspaceId: z.string().uuid(),
+	spaceId: z.string().uuid(),
+})
+
+export const BoardTaskItemSchema = z.object({
+	id: z.uuid(),
+	title: z.string(),
+	priority: z.enum(TaskPriority),
+	assigneeIds: z.array(z.uuid()),
+	position: z.number().int(),
+	listId: z.uuid(),
+	listName: z.string(),
+})
+
+export const StatusColumnSchema = z.object({
+	status: z.enum(TaskStatus),
+	tasks: z.array(BoardTaskItemSchema),
+})
+
+export const GetBoardViewOutputSchema = z.object({
+	spaceId: z.uuid(),
+	columns: z.array(StatusColumnSchema),
+})
+
+@injectable()
+export class GetBoardView extends Handler<typeof GetBoardViewInputSchema, typeof GetBoardViewOutputSchema> {
+	readonly name = 'get_board_view' as const
+	readonly inputSchema = GetBoardViewInputSchema
+	readonly outputSchema = GetBoardViewOutputSchema
+
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const taskRows = await this.db
+			.select()
+			.from(taskProjections)
+			.where(eq(taskProjections.spaceId, input.spaceId))
+			.orderBy(asc(taskProjections.position))
+
+		// Build columns in canonical status order
+		const statusOrder = [TaskStatus.TODO, TaskStatus.IN_PROGRESS, TaskStatus.IN_REVIEW, TaskStatus.DONE]
+		const tasksByStatus = new Map<TaskStatus, typeof taskRows>()
+		for (const s of statusOrder) tasksByStatus.set(s, [])
+		for (const task of taskRows) {
+			const col = tasksByStatus.get(task.status as TaskStatus) ?? []
+			col.push(task)
+			tasksByStatus.set(task.status as TaskStatus, col)
+		}
+
+		return {
+			spaceId: input.spaceId,
+			columns: statusOrder.map(status => ({
+				status,
+				tasks: (tasksByStatus.get(status) ?? []).map(t => ({
+					id: t.id,
+					title: t.title,
+					priority: t.priority as TaskPriority,
+					assigneeIds: Array.isArray(t.assigneeIds) ? (t.assigneeIds as string[]) : [],
+					position: t.position,
+					listId: t.listId,
+					listName: t.listName,
+				})),
+			})),
+		}
+	}
+}
