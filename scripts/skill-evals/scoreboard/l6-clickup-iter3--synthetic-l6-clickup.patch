+import { injectable } from 'tsyringe-neo'
+import { Repository } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { eq } from 'drizzle-orm'
+import { lists } from '@template/contracts/db'
+import { List, ListSchema } from '../entities/List'
+
+export abstract class ListRepository extends Repository<List> {
+	abstract findById(id: string, tx?: Transaction): Promise<List | undefined>
+	abstract findBySpaceId(spaceId: string, tx?: Transaction): Promise<List[]>
+	abstract findByWorkspaceId(workspaceId: string, tx?: Transaction): Promise<List[]>
+}
+
+@injectable()
+export class MockListRepository extends ListRepository {
+	private store = new Map<string, List>()
+
+	async findById(id: string, _tx?: Transaction): Promise<List | undefined> {
+		return this.store.get(id)
+	}
+
+	async findBySpaceId(spaceId: string, _tx?: Transaction): Promise<List[]> {
+		return [...this.store.values()].filter(l => l.spaceId === spaceId)
+	}
+
+	async findByWorkspaceId(workspaceId: string, _tx?: Transaction): Promise<List[]> {
+		return [...this.store.values()].filter(l => l.workspaceId === workspaceId)
+	}
+
+	async save(entity: List, _tx?: Transaction): Promise<List> {
+		this.store.set(entity.id.value, entity)
+		return entity
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.store.delete(id)
+	}
+
+	seed(list: List): void {
+		this.store.set(list.id.value, list)
+	}
+
+	clear(): void {
+		this.store.clear()
+	}
+}
+
+@injectable()
+export class DrizzleListRepository extends ListRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<List | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(lists).where(eq(lists.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async findBySpaceId(spaceId: string, tx?: DrizzleClient): Promise<List[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () =>
+			dbc.select().from(lists).where(eq(lists.spaceId, spaceId)),
+		)
+		if (!result.success || !result.data) return []
+		return result.data.map(row => this.toDomain(row))
+	}
+
+	async findByWorkspaceId(workspaceId: string, tx?: DrizzleClient): Promise<List[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () =>
+			dbc.select().from(lists).where(eq(lists.workspaceId, workspaceId)),
+		)
+		if (!result.success || !result.data) return []
+		return result.data.map(row => this.toDomain(row))
+	}
+
+	async save(entity: List, tx?: DrizzleClient): Promise<List> {
+		entity.incrementVersion()
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+			await dbc
+				.insert(lists)
+				.values(data)
+				.onConflictDoUpdate({
+					target: lists.id,
+					set: {
+						name: data.name,
+						position: data.position,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc.delete(lists).where(eq(lists.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: typeof lists.$inferSelect): List {
+		const parsed = ListSchema.parse({
+			spaceId: row.spaceId,
+			workspaceId: row.workspaceId,
+			name: row.name,
+			position: row.position,
+		})
+		return new List({
+			...parsed,
+			id: row.id,
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: List): typeof lists.$inferInsert {
+		return {
+			id: entity.id.value,
+			spaceId: entity.spaceId,
+			workspaceId: entity.workspaceId,
+			name: entity.name,
+			position: entity.position,
+			createdAt: entity.createdAt,
+			updatedAt: entity.updatedAt,
+			version: entity.version,
+		}
+	}
+}
