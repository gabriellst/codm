+// Per-env DI bindings for Workspace BC.
+import './errors' // Side-effect: registers context error codes with the framework runtime registry.
+
+import type { InstanceRegistry } from '@template/core-typescript'
+import { WorkspaceRepository, MockWorkspaceRepository, DrizzleWorkspaceRepository } from './repositories/WorkspaceRepository'
+import { SpaceRepository, MockSpaceRepository, DrizzleSpaceRepository } from './repositories/SpaceRepository'
+import { ListRepository, MockListRepository, DrizzleListRepository } from './repositories/ListRepository'
+
+export const INSTANCE_REGISTRY: InstanceRegistry = {
+	mock: [
+		{ token: WorkspaceRepository, instance: MockWorkspaceRepository },
+		{ token: SpaceRepository, instance: MockSpaceRepository },
+		{ token: ListRepository, instance: MockListRepository },
+	],
+	integration: [
+		{ token: WorkspaceRepository, instance: DrizzleWorkspaceRepository },
+		{ token: SpaceRepository, instance: DrizzleSpaceRepository },
+		{ token: ListRepository, instance: DrizzleListRepository },
+	],
+	real: [
+		{ token: WorkspaceRepository, instance: DrizzleWorkspaceRepository },
+		{ token: SpaceRepository, instance: DrizzleSpaceRepository },
+		{ token: ListRepository, instance: DrizzleListRepository },
+	],
+}
