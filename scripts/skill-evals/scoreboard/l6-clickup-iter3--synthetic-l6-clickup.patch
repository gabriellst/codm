+import type { ComponentProps } from 'react'
+import { useGetListView } from '@template/client-typescript/typescript'
+import { cn } from '@/lib/utils'
+import { Skeleton } from '@/components/ui/skeleton'
+import { TaskCard } from './TaskCard'
+
+interface ListViewSectionProps extends ComponentProps<'div'> {
+	workspaceId: string
+	spaceId: string
+	onCreateTask: (listId: string) => void
+}
+
+export function ListViewSection({ workspaceId, spaceId, onCreateTask: _onCreateTask, className, ...props }: ListViewSectionProps) {
+	const { data, isPending } = useGetListView(workspaceId, spaceId)
+
+	if (isPending) {
+		return (
+			<div className={cn('flex flex-col gap-6', className)} {...props}>
+				{Array.from({ length: 2 }).map((_, i) => (
+					<div key={i} className="flex flex-col gap-3">
+						<Skeleton className="h-6 w-40 rounded" />
+						<div className="flex flex-col gap-2">
+							{Array.from({ length: 3 }).map((_, j) => (
+								<Skeleton key={j} className="h-16 w-full rounded-lg" />
+							))}
+						</div>
+					</div>
+				))}
+			</div>
+		)
+	}
+
+	const lists = data?.lists ?? []
+
+	return (
+		<div className={cn('flex flex-col gap-8', className)} {...props}>
+			{lists.map(list => (
+				<div key={list.id} className="flex flex-col gap-3">
+					<h2 className="text-sm font-semibold text-foreground">{list.name}</h2>
+					<div className="flex flex-col gap-2">
+						{list.tasks.map(task => (
+							<TaskCard
+								key={task.id}
+								id={task.id}
+								title={task.title}
+								status={task.status}
+								priority={task.priority}
+								assigneeIds={task.assigneeIds}
+							/>
+						))}
+						{list.tasks.length === 0 && (
+							<p className="text-xs text-muted-foreground py-2">No tasks in this list.</p>
+						)}
+					</div>
+				</div>
+			))}
+			{lists.length === 0 && (
+				<p className="text-sm text-muted-foreground">No lists found in this space.</p>
+			)}
+		</div>
+	)
+}
