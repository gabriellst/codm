new file mode 100644
index 000000000..bd3d34653
--- /dev/null
+++ b/packages/api/typescript/src/task/entities/Task.ts
@@ -0,0 +1,92 @@
+import Z from 'zod'
+import { AggregateRoot, Id, z } from '@template/core-typescript'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { TaskCreatedDomainEvent } from '../events/TaskCreatedDomainEvent'
+import { TaskStatusChangedDomainEvent } from '../events/TaskStatusChangedDomainEvent'
+
+export const TaskSchema = z.object({
+	workspaceId: z.string(),
+	spaceId: z.string(),
+	listId: z.string(),
+	title: z.string(),
+	description: z.string().nullable(),
+	status: z.enum(TaskStatus),
+	priority: z.enum(TaskPriority),
+	assigneeIds: z.array(z.string()),
+	position: z.number().int(),
+})
+
+export type TaskProps = Z.infer<typeof TaskSchema>
+
+export class Task extends AggregateRoot<typeof TaskSchema> {
+	static override schema = TaskSchema
+
+	static create(data: {
+		workspaceId: string
+		spaceId: string
+		listId: string
+		title: string
+		description?: string | null
+		status?: TaskStatus
+		priority?: TaskPriority
+		assigneeIds?: string[]
+		position?: number
+	}): Task {
+		const task = new Task({
+			id: new Id().value,
+			workspaceId: data.workspaceId,
+			spaceId: data.spaceId,
+			listId: data.listId,
+			title: data.title,
+			description: data.description ?? null,
+			status: data.status ?? TaskStatus.TODO,
+			priority: data.priority ?? TaskPriority.NORMAL,
+			assigneeIds: data.assigneeIds ?? [],
+			position: data.position ?? 0,
+		})
+		task.addDomainEvent(
+			new TaskCreatedDomainEvent({
+				entityId: task.id.value,
+				ownerId: data.workspaceId,
+				payload: {
+					taskId: task.id.value,
+					workspaceId: data.workspaceId,
+					spaceId: data.spaceId,
+					listId: data.listId,
+					title: data.title,
+					status: task.status,
+					priority: task.priority,
+					position: task.position,
+				},
+			}),
+		)
+		return task
+	}
+
+	changeStatus(newStatus: TaskStatus): void {
+		const fromStatus = this.status
+		this.status = newStatus
+		this.addDomainEvent(
+			new TaskStatusChangedDomainEvent({
+				entityId: this.id.value,
+				ownerId: this.workspaceId,
+				payload: {
+					taskId: this.id.value,
+					workspaceId: this.workspaceId,
+					fromStatus,
+					toStatus: newStatus,
+				},
+			}),
+		)
+	}
+
+	updatePriority(priority: TaskPriority): void {
+		this.priority = priority
+	}
+
+	updateAssignees(assigneeIds: string[]): void {
+		this.assigneeIds = assigneeIds
+	}
+}
+
+export interface Task extends TaskProps {}
