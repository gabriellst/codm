+	override readonly name = 'create_task' as const
+	readonly description = 'Create a new task in a list'
+	readonly inputSchema = InputSchema
+	readonly outputSchema = OutputSchema
+
+	override middlewares = [AuthAccountMiddleware]
+
+	constructor(private useCase: CreateTask) {
+		super()
+	}
+
+	async handle(request: this['input']): Promise<this['output']> {
+		const data = await this.useCase.execute({
+			workspaceId: request.params.workspaceId,
+			spaceId: request.params.spaceId,
+			listId: request.params.listId,
+			title: request.body.title,
+			description: request.body.description,
+			status: request.body.status,
+			priority: request.body.priority,
+			assigneeIds: request.body.assigneeIds,
+		})
+		return { status: HttpStatusCode.CREATED, data }
+	}
+}
