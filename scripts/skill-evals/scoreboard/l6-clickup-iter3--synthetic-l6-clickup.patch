+import { useState } from 'react'
+import { createFileRoute, getRouteApi } from '@tanstack/react-router'
+import { useQueryClient } from '@tanstack/react-query'
+import { zodValidator } from '@/lib/zod-validator'
+import { z } from 'zod/v4'
+import {
+	getListViewQueryKey,
+	getBoardViewQueryKey,
+} from '@template/client-typescript/typescript'
+import { useServerEvents } from '@/hooks/useServerEvents'
+import { Button } from '@/components/ui/button'
+
+import { SpaceViewToggle } from './-components/SpaceViewToggle'
+import { ListViewSection } from './-components/ListViewSection'
+import { BoardViewSection } from './-components/BoardViewSection'
+import { CreateTaskDialog } from './-components/CreateTaskDialog'
+
+// ── Search schema ─────────────────────────────────────────────────────────────
+
+const spaceSearchSchema = z.object({
+	view: z.enum(['list', 'board']).default('list'),
+})
+
+export const Route = createFileRoute('/(app)/workspaces/$workspaceId/spaces/$spaceId/')({
+	validateSearch: zodValidator(spaceSearchSchema),
+	component: RouteComponent,
+})
+
+const routeApi = getRouteApi('/(app)/workspaces/$workspaceId/spaces/$spaceId/')
+
+function RouteComponent() {
+	const { workspaceId, spaceId } = routeApi.useParams()
+	const { view } = routeApi.useSearch()
+	const navigate = routeApi.useNavigate()
+	const queryClient = useQueryClient()
+	const [dialogState, setDialogState] = useState<{ open: boolean; listId: string }>({
+		open: false,
+		listId: '',
+	})
+
+	// Real-time: invalidate both views when a task status changes
+	useServerEvents('integration.shared.task.status_changed', () => {
+		queryClient.invalidateQueries({ queryKey: getListViewQueryKey(workspaceId, spaceId) })
+		queryClient.invalidateQueries({ queryKey: getBoardViewQueryKey(workspaceId, spaceId) })
+	})
+
+	function openCreateDialog(listId: string) {
+		setDialogState({ open: true, listId })
+	}
+
+	return (
+		<div className="flex flex-1 flex-col gap-4 overflow-y-auto p-6 md:p-8">
+			<div className="flex items-center justify-between gap-4">
+				<SpaceViewToggle
+					view={view}
+					onViewChange={v => navigate({ search: prev => ({ ...prev, view: v }) })}
+				/>
+				<Button onClick={() => openCreateDialog('')}>New Task</Button>
+			</div>
+
+			{view === 'list' ? (
+				<ListViewSection workspaceId={workspaceId} spaceId={spaceId} onCreateTask={openCreateDialog} />
+			) : (
+				<BoardViewSection workspaceId={workspaceId} spaceId={spaceId} />
+			)}
+
+			<CreateTaskDialog
+				workspaceId={workspaceId}
+				spaceId={spaceId}
+				listId={dialogState.listId}
+				open={dialogState.open}
+				onOpenChange={open => setDialogState(prev => ({ ...prev, open }))}
+			/>
+		</div>
+	)
+}
