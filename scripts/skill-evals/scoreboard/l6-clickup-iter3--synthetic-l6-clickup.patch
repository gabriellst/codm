+import { injectable } from 'tsyringe-neo'
+import { Controller, HttpStatusCode, z } from '@template/core-typescript'
+import { AuthAccountMiddleware } from '@auth/middlewares/AuthAccountMiddleware'
+import { TaskStatus } from '@template/contracts-typescript/wire/enums'
+import { ChangeTaskStatus } from '../usecases/ChangeTaskStatus'
+
+const InputSchema = z.object({
+	ctx: z.object({
+		session: z.object({ userId: z.uuid() }),
+	}),
+	params: z.object({
+		taskId: z.uuid(),
+	}),
+	body: z.object({
+		status: z.enum(TaskStatus),
+	}),
+})
+
+const OutputSchema = z.object({
+	id: z.uuid(),
+	status: z.enum(TaskStatus),
+})
+
+@injectable()
+export class ChangeTaskStatusController extends Controller<typeof InputSchema, typeof OutputSchema> {
+	readonly path = '/tasks/:taskId/status'
+	readonly method = 'patch' as const
+	override readonly name = 'change_task_status' as const
+	readonly description = 'Change the status of a task'
+	readonly inputSchema = InputSchema
+	readonly outputSchema = OutputSchema
+
+	override middlewares = [AuthAccountMiddleware]
+
+	constructor(private useCase: ChangeTaskStatus) {
+		super()
+	}
+
+	async handle(request: this['input']): Promise<this['output']> {
+		const data = await this.useCase.execute({
+			taskId: request.params.taskId,
+			status: request.body.status,
+		})
+		return { status: HttpStatusCode.OK, data }
+	}
+}
