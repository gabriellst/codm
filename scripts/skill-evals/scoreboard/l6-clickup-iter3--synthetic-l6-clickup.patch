new file mode 100644
index 000000000..55be76f8a
--- /dev/null
+++ b/packages/contracts/db/schema/task.ts
@@ -0,0 +1,71 @@
+import { pgSchema, uuid, text, timestamp, integer, index, jsonb } from 'drizzle-orm/pg-core'
+
+/**
+ * `task` is the ClickUp-style task aggregate schema.
+ *
+ * A Task belongs to a List (in a Space, in a Workspace). It carries a
+ * status (TaskStatus enum), priority (TaskPriority enum), an ordered
+ * position within its list, and an array of assignee user IDs.
+ *
+ * Tables:
+ *   - `tasks`            — the task aggregate
+ *   - `task_projections` — denormalized read-model used by list-view and board-view BFF queries
+ */
+export const taskSchema = pgSchema('task')
+
+export const tasks = taskSchema.table(
+	'tasks',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+		workspaceId: uuid('workspace_id').notNull(),
+		spaceId: uuid('space_id').notNull(),
+		listId: uuid('list_id').notNull(),
+		title: text('title').notNull(),
+		description: text('description'),
+		// Stored as text — matches TaskStatus enum values (TODO|IN_PROGRESS|IN_REVIEW|DONE)
+		status: text('status').notNull().default('TODO'),
+		// Stored as text — matches TaskPriority enum values (LOW|NORMAL|HIGH|URGENT)
+		priority: text('priority').notNull().default('NORMAL'),
+		// Array of user UUIDs stored as JSONB
+		assigneeIds: jsonb('assignee_ids').notNull().default([]),
+		// Position within the list (ascending = higher in list)
+		position: integer('position').notNull().default(0),
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		listIdx: index('tasks_list_id_idx').on(t.listId),
+		spaceIdx: index('tasks_space_id_idx').on(t.spaceId),
+		workspaceIdx: index('tasks_workspace_id_idx').on(t.workspaceId),
+		statusIdx: index('tasks_status_idx').on(t.status),
+	}),
+)
+
+/**
+ * `task_projections` — denormalized read-model updated by the ui projector
+ * whenever a task is created or its status changes. Used by GetListView and
+ * GetBoardView BFF queries to avoid joins across schemas.
+ */
+export const taskProjections = taskSchema.table(
+	'task_projections',
+	{
+		id: uuid('id').primaryKey(),
+		workspaceId: uuid('workspace_id').notNull(),
+		spaceId: uuid('space_id').notNull(),
+		listId: uuid('list_id').notNull(),
+		listName: text('list_name').notNull(),
+		title: text('title').notNull(),
+		status: text('status').notNull(),
+		priority: text('priority').notNull(),
+		assigneeIds: jsonb('assignee_ids').notNull().default([]),
+		position: integer('position').notNull().default(0),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+	},
+	t => ({
+		spaceIdx: index('task_projections_space_id_idx').on(t.spaceId),
+		workspaceIdx: index('task_projections_workspace_id_idx').on(t.workspaceId),
+		listIdx: index('task_projections_list_id_idx').on(t.listId),
+		statusIdx: index('task_projections_status_idx').on(t.status),
+	}),
+)
diff --git a/packages/contracts/db/schema/workspace.ts b/packages/contracts/db/schema/workspace.ts
new file mode 100644
index 000000000..4cc334592
--- /dev/null
+++ b/packages/contracts/db/schema/workspace.ts
@@ -0,0 +1,64 @@
+import { pgSchema, uuid, text, timestamp, integer, index } from 'drizzle-orm/pg-core'
+
+/**
+ * `workspace` is the ClickUp-style task management BC schema.
+ *
+ * A Workspace is the top-level container. It owns Spaces, each of which
+ * owns an ordered set of Lists. Tasks (in the `task` schema) belong to Lists.
+ *
+ * Tables:
+ *   - `workspaces`  — top-level project container
+ *   - `spaces`      — sections within a workspace
+ *   - `lists`       — ordered task groups within a space
+ */
+export const workspaceSchema = pgSchema('workspace')
+
+export const workspaces = workspaceSchema.table(
+	'workspaces',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+		name: text('name').notNull(),
+		ownerId: uuid('owner_id').notNull(),
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		ownerIdx: index('workspaces_owner_id_idx').on(t.ownerId),
+	}),
+)
+
+export const spaces = workspaceSchema.table(
+	'spaces',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+		workspaceId: uuid('workspace_id').notNull(),
+		name: text('name').notNull(),
+		color: text('color').notNull().default('#6366f1'),
+		position: integer('position').notNull().default(0),
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		workspaceIdx: index('spaces_workspace_id_idx').on(t.workspaceId),
+	}),
+)
+
+export const lists = workspaceSchema.table(
+	'lists',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+		spaceId: uuid('space_id').notNull(),
+		workspaceId: uuid('workspace_id').notNull(),
+		name: text('name').notNull(),
+		position: integer('position').notNull().default(0),
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		spaceIdx: index('lists_space_id_idx').on(t.spaceId),
+		workspaceIdx: index('lists_workspace_id_idx').on(t.workspaceId),
+	}),
+)
