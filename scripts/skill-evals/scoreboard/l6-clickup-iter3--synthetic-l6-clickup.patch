+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Badge } from '@/components/ui/badge'
+import { cn } from '@/lib/utils'
+import type { TaskStatus, TaskPriority } from '@template/client-typescript/typescript'
+import { TaskStatusEnum, TaskPriorityEnum } from '@template/client-typescript/typescript'
+
+interface TaskCardProps extends ComponentProps<'div'> {
+	id: string
+	title: string
+	status: TaskStatus
+	priority: TaskPriority
+	assigneeIds: string[]
+}
+
+const STATUS_VARIANT: Record<TaskStatus, 'success' | 'warning' | 'outline' | 'default'> = {
+	[TaskStatusEnum.TODO]: 'outline',
+	[TaskStatusEnum.IN_PROGRESS]: 'warning',
+	[TaskStatusEnum.IN_REVIEW]: 'default',
+	[TaskStatusEnum.DONE]: 'success',
+}
+
+const PRIORITY_VARIANT: Record<TaskPriority, 'destructive' | 'warning' | 'default' | 'outline'> = {
+	[TaskPriorityEnum.URGENT]: 'destructive',
+	[TaskPriorityEnum.HIGH]: 'warning',
+	[TaskPriorityEnum.NORMAL]: 'default',
+	[TaskPriorityEnum.LOW]: 'outline',
+}
+
+export function TaskCard({ id: _id, title, status, priority, assigneeIds, className, ...props }: TaskCardProps) {
+	const { t } = useTranslation()
+	return (
+		<div className={cn('flex flex-col gap-2 rounded-lg border border-border bg-card p-3 shadow-sm', className)} {...props}>
+			<span className="text-sm font-medium text-foreground line-clamp-2">{title}</span>
+			<div className="flex items-center gap-2 flex-wrap">
+				<Badge variant={STATUS_VARIANT[status]}>{t(`enums.TaskStatus.${status}`)}</Badge>
+				<Badge variant={PRIORITY_VARIANT[priority]}>{t(`enums.TaskPriority.${priority}`)}</Badge>
+				{assigneeIds.length > 0 && (
+					<span className={cn('text-xs text-muted-foreground')}>
+						{assigneeIds.length} assignee{assigneeIds.length > 1 ? 's' : ''}
+					</span>
+				)}
+			</div>
+		</div>
+	)
+}
