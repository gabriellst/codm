+import { injectable } from 'tsyringe-neo'
+import { Handler, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { Task } from '../entities/Task'
+import { TaskRepository } from '../repositories/TaskRepository'
+
+export const CreateTaskInputSchema = z.object({
+	workspaceId: z.string().uuid(),
+	spaceId: z.string().uuid(),
+	listId: z.string().uuid(),
+	title: z.string().min(1).max(255),
+	description: z.string().max(10000).optional(),
+	status: z.enum(TaskStatus).optional(),
+	priority: z.enum(TaskPriority).optional(),
+	assigneeIds: z.array(z.string().uuid()).optional(),
+})
+
+export const CreateTaskOutputSchema = z.object({
+	id: z.uuid(),
+	workspaceId: z.uuid(),
+	spaceId: z.uuid(),
+	listId: z.uuid(),
+	title: z.string(),
+	status: z.enum(TaskStatus),
+	priority: z.enum(TaskPriority),
+})
+
+@injectable()
+export class CreateTask extends Handler<typeof CreateTaskInputSchema, typeof CreateTaskOutputSchema> {
+	readonly name = 'create_task' as const
+	readonly inputSchema = CreateTaskInputSchema
+	readonly outputSchema = CreateTaskOutputSchema
+
+	constructor(private readonly tasks: TaskRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const existing = await this.tasks.findByListId(input.listId, tx)
+			const task = Task.create({
+				workspaceId: input.workspaceId,
+				spaceId: input.spaceId,
+				listId: input.listId,
+				title: input.title,
+				description: input.description,
+				status: input.status,
+				priority: input.priority,
+				assigneeIds: input.assigneeIds,
+				position: existing.length,
+			})
+			await this.tasks.save(task, tx)
+			await this.domainEventRepository.saveMany([...task.pullDomainEvents()], tx)
+			return {
+				id: task.id.value,
+				workspaceId: task.workspaceId,
+				spaceId: task.spaceId,
+				listId: task.listId,
+				title: task.title,
+				status: task.status,
+				priority: task.priority,
+			}
+		})
+	}
+}
