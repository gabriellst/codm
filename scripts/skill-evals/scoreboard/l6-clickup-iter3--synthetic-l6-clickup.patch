new file mode 100644
index 000000000..4404e599a
--- /dev/null
+++ b/packages/api/typescript/src/ui/usecases/GetListView.ts
@@ -0,0 +1,85 @@
+import { injectable } from 'tsyringe-neo'
+import { Handler, z, DrizzleClient } from '@template/core-typescript'
+import { eq, asc } from 'drizzle-orm'
+import { lists, taskProjections } from '@template/contracts/db'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+
+export const GetListViewInputSchema = z.object({
+	workspaceId: z.string().uuid(),
+	spaceId: z.string().uuid(),
+})
+
+export const TaskItemSchema = z.object({
+	id: z.uuid(),
+	title: z.string(),
+	status: z.enum(TaskStatus),
+	priority: z.enum(TaskPriority),
+	assigneeIds: z.array(z.uuid()),
+	position: z.number().int(),
+	listId: z.uuid(),
+})
+
+export const ListWithTasksSchema = z.object({
+	id: z.uuid(),
+	name: z.string(),
+	position: z.number().int(),
+	tasks: z.array(TaskItemSchema),
+})
+
+export const GetListViewOutputSchema = z.object({
+	spaceId: z.uuid(),
+	lists: z.array(ListWithTasksSchema),
+})
+
+@injectable()
+export class GetListView extends Handler<typeof GetListViewInputSchema, typeof GetListViewOutputSchema> {
+	readonly name = 'get_list_view' as const
+	readonly inputSchema = GetListViewInputSchema
+	readonly outputSchema = GetListViewOutputSchema
+
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		// Fetch all lists in this space, ordered by position
+		const listsRows = await this.db
+			.select()
+			.from(lists)
+			.where(eq(lists.spaceId, input.spaceId))
+			.orderBy(asc(lists.position))
+
+		// Fetch all task projections for this space
+		const taskRows = await this.db
+			.select()
+			.from(taskProjections)
+			.where(eq(taskProjections.spaceId, input.spaceId))
+			.orderBy(asc(taskProjections.position))
+
+		// Group tasks by listId
+		const tasksByList = new Map<string, typeof taskRows>()
+		for (const task of taskRows) {
+			const arr = tasksByList.get(task.listId) ?? []
+			arr.push(task)
+			tasksByList.set(task.listId, arr)
+		}
+
+		return {
+			spaceId: input.spaceId,
+			lists: listsRows.map(l => ({
+				id: l.id,
+				name: l.name,
+				position: l.position,
+				tasks: (tasksByList.get(l.id) ?? []).map(t => ({
+					id: t.id,
+					title: t.title,
+					status: t.status as TaskStatus,
+					priority: t.priority as TaskPriority,
+					assigneeIds: Array.isArray(t.assigneeIds) ? (t.assigneeIds as string[]) : [],
+					position: t.position,
+					listId: t.listId,
+				})),
+			})),
+		}
+	}
+}
diff --git a/packages/api/typescript/src/ui/usecases/GetWorkspace.ts b/packages/api/typescript/src/ui/usecases/GetWorkspace.ts
