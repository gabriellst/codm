+import Z from 'zod'
+import { AggregateRoot, Id, z } from '@template/core-typescript'
+import { ListCreatedEvent } from '../events/ListCreatedEvent'
+
+export const ListSchema = z.object({
+	spaceId: z.string(),
+	workspaceId: z.string(),
+	name: z.string(),
+	position: z.number().int(),
+})
+
+export type ListProps = Z.infer<typeof ListSchema>
+
+export class List extends AggregateRoot<typeof ListSchema> {
+	static override schema = ListSchema
+
+	static create(data: { spaceId: string; workspaceId: string; name: string; position?: number }): List {
+		const list = new List({
+			id: new Id().value,
+			spaceId: data.spaceId,
+			workspaceId: data.workspaceId,
+			name: data.name,
+			position: data.position ?? 0,
+		})
+		list.addDomainEvent(
+			new ListCreatedEvent({
+				entityId: list.id.value,
+				ownerId: data.workspaceId,
+				payload: {
+					listId: list.id.value,
+					spaceId: data.spaceId,
+					workspaceId: data.workspaceId,
+					name: data.name,
+				},
+			}),
+		)
+		return list
+	}
+}
+
+export interface List extends ListProps {}
