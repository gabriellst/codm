+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: Workspace): typeof workspaces.$inferInsert {
+		return {
+			id: entity.id.value,
+			name: entity.name,
+			ownerId: entity.ownerId,
+			createdAt: entity.createdAt,
+			updatedAt: entity.updatedAt,
+			version: entity.version,
+		}
+	}
+}
diff --git a/packages/api/typescript/src/workspace/usecases/CreateList.ts b/packages/api/typescript/src/workspace/usecases/CreateList.ts
new file mode 100644
index 000000000..fcc2833b1
--- /dev/null
+++ b/packages/api/typescript/src/workspace/usecases/CreateList.ts
@@ -0,0 +1,46 @@
+import { injectable } from 'tsyringe-neo'
+import { Handler, BaseError, z, type Transaction } from '@template/core-typescript'
+import { List } from '../entities/List'
+import { SpaceRepository } from '../repositories/SpaceRepository'
+import { ListRepository } from '../repositories/ListRepository'
+import type { WorkspaceApplicationErrors } from '../errors'
+
+export const CreateListInputSchema = z.object({
+	spaceId: z.string().uuid(),
+	workspaceId: z.string().uuid(),
+	name: z.string().min(1).max(100),
+})
+
+export const CreateListOutputSchema = z.object({
+	id: z.uuid(),
+	spaceId: z.uuid(),
+	workspaceId: z.uuid(),
+	name: z.string(),
+	position: z.number().int(),
+})
+
+@injectable()
+export class CreateList extends Handler<typeof CreateListInputSchema, typeof CreateListOutputSchema> {
+	readonly name = 'create_list' as const
+	readonly inputSchema = CreateListInputSchema
+	readonly outputSchema = CreateListOutputSchema
+
+	constructor(
+		private readonly spaces: SpaceRepository,
+		private readonly lists: ListRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const space = await this.spaces.findById(input.spaceId, tx)
+			if (!space) throw new BaseError<WorkspaceApplicationErrors>('SPACE_NOT_FOUND')
+			const existing = await this.lists.findBySpaceId(input.spaceId, tx)
+			const list = List.create({ spaceId: input.spaceId, workspaceId: input.workspaceId, name: input.name, position: existing.length })
+			await this.lists.save(list, tx)
+			await this.domainEventRepository.saveMany([...list.pullDomainEvents()], tx)
+			return { id: list.id.value, spaceId: list.spaceId, workspaceId: list.workspaceId, name: list.name, position: list.position }
+		})
+	}
+}
