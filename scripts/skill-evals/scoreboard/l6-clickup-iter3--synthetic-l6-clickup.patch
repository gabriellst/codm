diff --git a/packages/api/typescript/src/task/repositories/TaskRepository.ts b/packages/api/typescript/src/task/repositories/TaskRepository.ts
new file mode 100644
index 000000000..d290dcce2
--- /dev/null
+++ b/packages/api/typescript/src/task/repositories/TaskRepository.ts
@@ -0,0 +1,136 @@
+import { injectable } from 'tsyringe-neo'
+import { Repository, DrizzleClient } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { Task } from '../entities/Task'
+
+export abstract class TaskRepository extends Repository<Task> {
+	abstract findById(id: string, tx?: Transaction): Promise<Task | undefined>
+	abstract findByListId(listId: string, tx?: Transaction): Promise<Task[]>
+	abstract findBySpaceId(spaceId: string, tx?: Transaction): Promise<Task[]>
+}
+
+@injectable()
+export class MockTaskRepository extends TaskRepository {
+	private store = new Map<string, Task>()
+
+	async findById(id: string, _tx?: Transaction): Promise<Task | undefined> {
+		return this.store.get(id)
+	}
+
+	async findByListId(listId: string, _tx?: Transaction): Promise<Task[]> {
+		return [...this.store.values()].filter(t => t.listId === listId)
+	}
+
+	async findBySpaceId(spaceId: string, _tx?: Transaction): Promise<Task[]> {
+		return [...this.store.values()].filter(t => t.spaceId === spaceId)
+	}
+
+	async save(task: Task, _tx?: Transaction): Promise<Task> {
+		this.store.set(task.id.value, task)
+		return task
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.store.delete(id)
+	}
+}
+
+@injectable()
+export class DrizzleTaskRepository extends TaskRepository {
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<Task | undefined> {
+		const client = tx ?? this.db
+		const { tasks } = await import('@template/contracts/db')
+		const { eq } = await import('drizzle-orm')
+		const rows = await client.select().from(tasks).where(eq(tasks.id, id)).limit(1)
+		if (!rows[0]) return undefined
+		return this.toDomain(rows[0])
+	}
+
+	async findByListId(listId: string, tx?: DrizzleClient): Promise<Task[]> {
+		const client = tx ?? this.db
+		const { tasks } = await import('@template/contracts/db')
+		const { eq } = await import('drizzle-orm')
+		const rows = await client.select().from(tasks).where(eq(tasks.listId, listId)).orderBy(tasks.position)
+		return rows.map(r => this.toDomain(r))
+	}
+
+	async findBySpaceId(spaceId: string, tx?: DrizzleClient): Promise<Task[]> {
+		const client = tx ?? this.db
+		const { tasks } = await import('@template/contracts/db')
+		const { eq } = await import('drizzle-orm')
+		const rows = await client.select().from(tasks).where(eq(tasks.spaceId, spaceId)).orderBy(tasks.position)
+		return rows.map(r => this.toDomain(r))
+	}
+
+	async save(task: Task, tx?: DrizzleClient): Promise<Task> {
+		const client = tx ?? this.db
+		const { tasks } = await import('@template/contracts/db')
+		await client
+			.insert(tasks)
+			.values({
+				id: task.id.value,
+				workspaceId: task.workspaceId,
+				spaceId: task.spaceId,
+				listId: task.listId,
+				title: task.title,
+				description: task.description,
+				status: task.status,
+				priority: task.priority,
+				assigneeIds: task.assigneeIds,
+				position: task.position,
+				version: task.version,
+			})
+			.onConflictDoUpdate({
+				target: tasks.id,
+				set: {
+					title: task.title,
+					description: task.description,
+					status: task.status,
+					priority: task.priority,
+					assigneeIds: task.assigneeIds,
+					position: task.position,
+					version: task.version,
+					updatedAt: new Date(),
+				},
+			})
+		return task
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const client = tx ?? this.db
+		const { tasks } = await import('@template/contracts/db')
+		const { eq } = await import('drizzle-orm')
+		await client.delete(tasks).where(eq(tasks.id, id))
+	}
+
+	private toDomain(row: {
+		id: string
+		workspaceId: string
+		spaceId: string
+		listId: string
+		title: string
+		description: string | null
+		status: string
+		priority: string
+		assigneeIds: unknown
+		position: number
+	}): Task {
+		return new Task({
+			id: row.id,
+			workspaceId: row.workspaceId,
+			spaceId: row.spaceId,
+			listId: row.listId,
+			title: row.title,
+			description: row.description,
+			status: row.status as TaskStatus,
+			priority: row.priority as TaskPriority,
+			assigneeIds: Array.isArray(row.assigneeIds) ? (row.assigneeIds as string[]) : [],
+			position: row.position,
+		})
+	}
+}
