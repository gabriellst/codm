diff --git a/packages/e2e/tests/clickup-tasks-realtime.spec.ts b/packages/e2e/tests/clickup-tasks-realtime.spec.ts
new file mode 100644
index 000000000..dd179c364
--- /dev/null
+++ b/packages/e2e/tests/clickup-tasks-realtime.spec.ts
@@ -0,0 +1,306 @@
+import { expect, test } from '@playwright/test'
+import { apiSignUp, injectSession } from '../utils/given/api'
+import { generateEmail } from '../utils/generators'
+
+const API_BASE_URL = process.env.API_BASE_URL ?? 'http://localhost:3030'
+
+/**
+ * ClickUp clone — tasks realtime E2E spec.
+ *
+ * Covers:
+ *   1. List / Board view toggle (search param ?view=list / ?view=board)
+ *   2. Create task via dialog — task appears in list view
+ *   3. Realtime status update via SSE — PATCH /v1/task/tasks/:id/status
+ *      reflected in the UI without a page reload
+ */
+
+// ── Auth + fixture state shared across tests ─────────────────────────────────
+
+interface FixtureState {
+	sessionToken: string
+	workspaceId: string
+	spaceId: string
+	listId: string
+	taskId: string
+	spaceUrl: string
+}
+
+async function setupFixtures(): Promise<FixtureState> {
+	const email = generateEmail('clickup-e2e')
+	const session = await apiSignUp({ name: 'ClickUp Test User', email, password: 'Password123!' })
+
+	// POST /v1/workspace/workspaces — create workspace
+	const workspaceRes = await fetch(`${API_BASE_URL}/v1/workspace/workspaces`, {
+		method: 'POST',
+		headers: {
+			'Content-Type': 'application/json',
+			Cookie: `better-auth.session_token=${session.token}`,
+			Origin: API_BASE_URL,
+		},
+		body: JSON.stringify({ name: 'E2E Workspace' }),
+	})
+	if (!workspaceRes.ok) {
+		throw new Error(`Create workspace failed (${workspaceRes.status}): ${await workspaceRes.text()}`)
+	}
+	const workspace = (await workspaceRes.json()) as { id: string; name: string }
+
+	// POST /v1/workspace/workspaces/:workspaceId/spaces — create space
+	const spaceRes = await fetch(`${API_BASE_URL}/v1/workspace/workspaces/${workspace.id}/spaces`, {
+		method: 'POST',
+		headers: {
+			'Content-Type': 'application/json',
+			Cookie: `better-auth.session_token=${session.token}`,
+			Origin: API_BASE_URL,
+		},
+		body: JSON.stringify({ name: 'E2E Space', color: '#4f46e5' }),
+	})
+	if (!spaceRes.ok) {
+		throw new Error(`Create space failed (${spaceRes.status}): ${await spaceRes.text()}`)
+	}
+	const space = (await spaceRes.json()) as { id: string; workspaceId: string; name: string }
+
+	// POST /v1/workspace/workspaces/:workspaceId/spaces/:spaceId/lists — create list
+	const listRes = await fetch(`${API_BASE_URL}/v1/workspace/workspaces/${workspace.id}/spaces/${space.id}/lists`, {
+		method: 'POST',
+		headers: {
+			'Content-Type': 'application/json',
+			Cookie: `better-auth.session_token=${session.token}`,
+			Origin: API_BASE_URL,
+		},
+		body: JSON.stringify({ name: 'E2E List' }),
+	})
+	if (!listRes.ok) {
+		throw new Error(`Create list failed (${listRes.status}): ${await listRes.text()}`)
+	}
+	const list = (await listRes.json()) as { id: string; spaceId: string; name: string }
+
+	// POST /v1/task/workspaces/:workspaceId/spaces/:spaceId/lists/:listId/tasks — create task
+	const taskRes = await fetch(
+		`${API_BASE_URL}/v1/task/workspaces/${workspace.id}/spaces/${space.id}/lists/${list.id}/tasks`,
+		{
+			method: 'POST',
+			headers: {
+				'Content-Type': 'application/json',
+				Cookie: `better-auth.session_token=${session.token}`,
+				Origin: API_BASE_URL,
+			},
+			body: JSON.stringify({ title: 'E2E Task for Realtime' }),
+		},
+	)
+	if (!taskRes.ok) {
+		throw new Error(`Create task failed (${taskRes.status}): ${await taskRes.text()}`)
+	}
+	const task = (await taskRes.json()) as { id: string; title: string; status: string }
+
+	return {
+		sessionToken: session.token,
+		workspaceId: workspace.id,
+		spaceId: space.id,
+		listId: list.id,
+		taskId: task.id,
+		spaceUrl: `/workspaces/${workspace.id}/spaces/${space.id}`,
+	}
+}
+
+// ── Test 1: List / Board view toggle ─────────────────────────────────────────
+
+test.describe('ClickUp — view toggle', () => {
+	let fixture: FixtureState
+
+	test.beforeAll(async () => {
+		fixture = await setupFixtures()
+	})
+
+	test('toggling between List and Board updates the URL search param', async ({ page, context }) => {
+		const session = await apiSignUp({
+			name: 'Toggle Test User',
+			email: generateEmail('toggle'),
+			password: 'Password123!',
+		})
+		await injectSession(context, session)
+
+		// Navigate to the space (default view = list)
+		await page.goto(fixture.spaceUrl)
+		await expect(page).toHaveURL(new RegExp(`/workspaces/${fixture.workspaceId}/spaces/${fixture.spaceId}`))
+
+		// Default URL either has no view param OR has ?view=list
+		const initialUrl = page.url()
+		const isDefaultList = !initialUrl.includes('view=') || initialUrl.includes('view=list')
+		expect(isDefaultList).toBe(true)
+
+		// Click Board toggle button
+		await page.getByRole('button', { name: 'Board' }).click()
+		await expect(page).toHaveURL(/view=board/)
+
+		// Click List toggle button
+		await page.getByRole('button', { name: 'List' }).click()
+		await expect(page).toHaveURL(/view=list/)
+	})
+})
+
+// ── Test 2: Create task via dialog ────────────────────────────────────────────
+
+test.describe('ClickUp — create task', () => {
+	test('opening New Task dialog and submitting creates a task in list view', async ({ page, context }) => {
+		const session = await apiSignUp({
+			name: 'Create Task User',
+			email: generateEmail('create-task'),
+			password: 'Password123!',
+		})
+		await injectSession(context, session)
+
+		// Set up workspace/space/list for this test
+		const workspaceRes = await fetch(`${API_BASE_URL}/v1/workspace/workspaces`, {
+			method: 'POST',
+			headers: {
+				'Content-Type': 'application/json',
+				Cookie: `better-auth.session_token=${session.token}`,
+				Origin: API_BASE_URL,
+			},
+			body: JSON.stringify({ name: 'Create Task Workspace' }),
+		})
+		const workspace = (await workspaceRes.json()) as { id: string }
+
+		const spaceRes = await fetch(`${API_BASE_URL}/v1/workspace/workspaces/${workspace.id}/spaces`, {
+			method: 'POST',
+			headers: {
+				'Content-Type': 'application/json',
+				Cookie: `better-auth.session_token=${session.token}`,
+				Origin: API_BASE_URL,
+			},
+			body: JSON.stringify({ name: 'Create Task Space', color: '#6366f1' }),
+		})
+		const space = (await spaceRes.json()) as { id: string }
+
+		await fetch(`${API_BASE_URL}/v1/workspace/workspaces/${workspace.id}/spaces/${space.id}/lists`, {
+			method: 'POST',
+			headers: {
+				'Content-Type': 'application/json',
+				Cookie: `better-auth.session_token=${session.token}`,
+				Origin: API_BASE_URL,
+			},
+			body: JSON.stringify({ name: 'My List' }),
+		})
+
+		const spaceUrl = `/workspaces/${workspace.id}/spaces/${space.id}`
+		await page.goto(spaceUrl)
+
+		// Open the Create Task dialog
+		await page.getByRole('button', { name: 'New Task' }).click()
+
+		// Dialog should be visible — find the title input
+		const dialog = page.getByRole('dialog')
+		await expect(dialog).toBeVisible()
+
+		// Fill in the task title
+		const titleInput = dialog.getByRole('textbox').first()
+		await titleInput.fill('My New E2E Task')
+
+		// Submit — look for a button with "Create" text inside the dialog
+		await dialog.getByRole('button', { name: /create/i }).click()
+
+		// Dialog closes
+		await expect(dialog).not.toBeVisible({ timeout: 5_000 })
+
+		// Task appears in the list view
+		await expect(page.getByText('My New E2E Task')).toBeVisible({ timeout: 5_000 })
+	})
+})
+
+// ── Test 3: Realtime status update via SSE ────────────────────────────────────
+
+test.describe('ClickUp — realtime status update via SSE', () => {
+	test('PATCH task status reflects in UI without page reload', async ({ page, context }) => {
+		const session = await apiSignUp({
+			name: 'Realtime Test User',
+			email: generateEmail('realtime'),
+			password: 'Password123!',
+		})
+		await injectSession(context, session)
+
+		// Set up workspace/space/list/task for this user
+		const workspaceRes = await fetch(`${API_BASE_URL}/v1/workspace/workspaces`, {
+			method: 'POST',
+			headers: {
+				'Content-Type': 'application/json',
+				Cookie: `better-auth.session_token=${session.token}`,
+				Origin: API_BASE_URL,
+			},
+			body: JSON.stringify({ name: 'Realtime Workspace' }),
+		})
+		const workspace = (await workspaceRes.json()) as { id: string }
+
+		const spaceRes = await fetch(`${API_BASE_URL}/v1/workspace/workspaces/${workspace.id}/spaces`, {
+			method: 'POST',
+			headers: {
+				'Content-Type': 'application/json',
+				Cookie: `better-auth.session_token=${session.token}`,
+				Origin: API_BASE_URL,
+			},
+			body: JSON.stringify({ name: 'Realtime Space', color: '#8b5cf6' }),
+		})
+		const space = (await spaceRes.json()) as { id: string }
+
+		const listRes = await fetch(`${API_BASE_URL}/v1/workspace/workspaces/${workspace.id}/spaces/${space.id}/lists`, {
+			method: 'POST',
+			headers: {
+				'Content-Type': 'application/json',
+				Cookie: `better-auth.session_token=${session.token}`,
+				Origin: API_BASE_URL,
+			},
+			body: JSON.stringify({ name: 'Realtime List' }),
+		})
+		const list = (await listRes.json()) as { id: string }
+
+		const taskRes = await fetch(
+			`${API_BASE_URL}/v1/task/workspaces/${workspace.id}/spaces/${space.id}/lists/${list.id}/tasks`,
+			{
+				method: 'POST',
+				headers: {
+					'Content-Type': 'application/json',
+					Cookie: `better-auth.session_token=${session.token}`,
+					Origin: API_BASE_URL,
+				},
+				body: JSON.stringify({ title: 'Realtime Task' }),
+			},
+		)
+		const task = (await taskRes.json()) as { id: string; title: string; status: string }
+
+		const spaceUrl = `/workspaces/${workspace.id}/spaces/${space.id}`
+
+		// Navigate to the space — page is now OPEN and watching SSE
+		await page.goto(spaceUrl)
+
+		// Wait for the task to appear in list view (initial load)
+		await expect(page.getByText('Realtime Task')).toBeVisible({ timeout: 10_000 })
+
+		// The task card initially shows TODO status (default)
+		await expect(page.getByText(/TODO/i)).toBeVisible()
+
+		// Wait for the SSE connection to be established
+		// The frontend subscribes to 'integration.shared.task.status_changed' over /v1/ui/events
+		await page.waitForResponse(
+			response => response.url().includes('/v1/ui/events') && response.status() === 200,
+			{ timeout: 10_000 },
+		).catch(() => {
+			// SSE responses may not complete normally — this is expected
+		})
+
+		// PATCH task status to IN_PROGRESS via API (same user session, no page reload)
+		const patchRes = await fetch(`${API_BASE_URL}/v1/task/tasks/${task.id}/status`, {
+			method: 'PATCH',
+			headers: {
+				'Content-Type': 'application/json',
+				Cookie: `better-auth.session_token=${session.token}`,
+				Origin: API_BASE_URL,
+			},
+			body: JSON.stringify({ status: 'IN_PROGRESS' }),
+		})
+		expect(patchRes.ok).toBe(true)
+
+		// WITHOUT any page reload, the task card should update to show IN_PROGRESS status.
+		// The SSE event 'integration.shared.task.status_changed' triggers a query invalidation,
+		// which causes the list view to refetch and the TaskCard renders status.replace('_', ' ').
+		await expect(page.getByText('IN PROGRESS')).toBeVisible({ timeout: 8_000 })
+	})
+})
