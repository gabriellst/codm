+		// without joining through boards.
+		storeId: uuid('store_id').notNull(),
+
+		// Placement: which board and list this card lives in.
+		boardId: uuid('board_id').notNull(),
+		listId: uuid('list_id').notNull(),
+
+		// Card content.
+		title: text('title').notNull(),
+
+		// Numeric position within the list. Lower = higher on the board.
+		// Default 0: newly created cards land at the top.
+		position: integer('position').notNull().default(0),
+
+		// Audit / optimistic concurrency.
+		// No FKs to boards/lists — concurrent writes; referential integrity
+		// is enforced at the application layer.
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		storeIdx: index('cards_store_id_idx').on(t.storeId),
+		boardIdx: index('cards_board_id_idx').on(t.boardId),
+		// Composite index for ordered list reads (the primary query pattern).
+		listPositionIdx: index('cards_list_id_position_idx').on(t.listId, t.position),
+	}),
