diff --git a/packages/api/typescript/src/board/repositories/BoardRepository/DrizzleBoardRepository.ts b/packages/api/typescript/src/board/repositories/BoardRepository/DrizzleBoardRepository.ts
new file mode 100644
index 000000000..1c6351781
--- /dev/null
+++ b/packages/api/typescript/src/board/repositories/BoardRepository/DrizzleBoardRepository.ts
@@ -0,0 +1,87 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { boards } from '@template/contracts/db'
+import { Board } from '../../entities/Board'
+import { BoardList } from '../../objects/BoardList'
+import { BoardRepository } from './BoardRepository'
+
+@injectable()
+export class DrizzleBoardRepository extends BoardRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<Board | undefined> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient.select().from(boards).where(eq(boards.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async save(entity: Board, tx?: DrizzleClient): Promise<Board> {
+		entity.incrementVersion()
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+			await dbClient
+				.insert(boards)
+				.values(data)
+				.onConflictDoUpdate({
+					target: boards.id,
+					set: {
+						name: data.name,
+						isArchived: data.isArchived,
+						lists: data.lists,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbClient.delete(boards).where(eq(boards.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: typeof boards.$inferSelect): Board {
+		const parsed = Board.schema.parse({
+			storeId: row.storeId,
+			name: row.name,
+			isArchived: row.isArchived,
+			lists: (row.lists ?? []).map(l =>
+				BoardList.create({ id: l.id, name: l.name, position: l.position }),
+			),
+		})
+		return new Board({
+			...parsed,
+			id: row.id,
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: Board): typeof boards.$inferInsert {
+		return {
+			id: entity.id.value,
+			storeId: entity.storeId.value,
+			name: entity.name,
+			isArchived: entity.isArchived,
+			lists: entity.lists.map(l => ({ id: l.id, name: l.name, position: l.position })),
+			createdAt: entity.createdAt,
+			updatedAt: entity.updatedAt,
+			version: entity.version,
+		}
+	}
+}
