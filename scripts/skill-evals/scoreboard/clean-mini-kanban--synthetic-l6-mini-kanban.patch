@@ -0,0 +1,69 @@
+import { expect, test } from '../utils/test'
+
+/**
+ * Kanban — realtime card move.
+ *
+ * Verifies the realtime CQRS chain end to end:
+ *   1. A fresh user creates + activates a store (tenancy scope for the board).
+ *   2. Creates a board with two lists (To Do / Doing) and a card on To Do.
+ *   3. Opens the board in the browser — the card renders in the To Do column.
+ *   4. Moves the card to Doing via the API (PATCH /v1/cards/:id/move) — NO page reload.
+ *   5. Asserts the card appears in the Doing column and is gone from To Do, driven
+ *      purely by the SSE `integration.shared.card.moved` frame invalidating the
+ *      GetBoard query (BoardSection's single useServerEvents subscription).
+ *
+ * Setup runs through the API (not UI click-paths). `expect(...).toBeVisible()`
+ * auto-retries, so the realtime assertion needs no waitForTimeout.
+ */
+
+const API_BASE_URL = process.env.API_BASE_URL ?? 'http://localhost:3030'
+
+test('moving a card live-updates an open board without reload', async ({ page, given }) => {
+	const { session } = await given.freshUser({})
+
+	// Authenticated JSON request against the TS API, mirroring utils/given/api.ts.
+	async function api<T>(method: string, path: string, body?: unknown): Promise<T> {
+		const response = await fetch(`${API_BASE_URL}${path}`, {
+			method,
+			headers: {
+				'Content-Type': 'application/json',
+				Cookie: `better-auth.session_token=${session.token}`,
+				Origin: API_BASE_URL,
+			},
+			body: body === undefined ? undefined : JSON.stringify(body),
+		})
+		if (!response.ok) {
+			throw new Error(`${method} ${path} failed (${response.status}): ${await response.text()}`)
+		}
+		return (await response.json()) as T
+	}
+
+	// 1. Store + activate (boards are scoped to ctx.session.storeId).
+	const { storeId } = await api<{ storeId: string }>('POST', '/v1/stores', {
+		name: 'Kanban Co',
+		reportingCurrency: 'USD',
+		timezone: 'UTC',
+	})
+	await api('POST', `/v1/stores/${storeId}/activate`)
+
+	// 2. Board + two lists + a card on the first list.
+	const { boardId } = await api<{ boardId: string }>('POST', '/v1/boards', { name: 'Sprint' })
+	const { listId: listTodo } = await api<{ listId: string }>('POST', `/v1/boards/${boardId}/lists`, { name: 'To Do' })
+	const { listId: listDoing } = await api<{ listId: string }>('POST', `/v1/boards/${boardId}/lists`, { name: 'Doing' })
+	const { cardId } = await api<{ cardId: string }>('POST', '/v1/cards', {
+		boardId,
+		listId: listTodo,
+		title: 'Ship it',
+	})
+
+	// 3. Open the board — the card starts in the To Do column.
+	await page.goto(`/app/boards/${boardId}`)
+	await expect(page.getByTestId(`list-${listTodo}`).getByText('Ship it')).toBeVisible()
+
+	// 4. Move the card to Doing via the API while the page stays open.
+	await api('PATCH', `/v1/cards/${cardId}/move`, { toListId: listDoing, position: 0 })
+
+	// 5. Realtime assert — no reload: the card hops to Doing and leaves To Do.
+	await expect(page.getByTestId(`list-${listDoing}`).getByText('Ship it')).toBeVisible()
+	await expect(page.getByTestId(`list-${listTodo}`).getByText('Ship it')).toHaveCount(0)
+})
