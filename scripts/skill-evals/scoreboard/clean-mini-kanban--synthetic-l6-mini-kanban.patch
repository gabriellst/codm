+		const board = Board.create({ storeId: STORE, name: 'Sprint' })
+		const todo = board.addList('To Do')
+		const doing = board.addList('Doing')
+		await boards.save(board)
+		const { cardId } = await createCard.execute({ storeId: STORE, boardId: board.id.value, listId: todo.id, title: 'Task' })
