+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { BoardRepository } from '../repositories/BoardRepository'
+import { ListAddedToBoardEvent } from '../events'
+import type { ApplicationErrors } from '../errors'
+
+export const AddListInputSchema = z.object({ boardId: z.uuid(), name: z.string().min(1) })
+export const AddListOutputSchema = z.object({ listId: z.uuid(), position: z.number().int() })
+
+@injectable()
+export class AddList extends Handler<typeof AddListInputSchema, typeof AddListOutputSchema> {
+	readonly name = 'add_list' as const
+	readonly inputSchema = AddListInputSchema
+	readonly outputSchema = AddListOutputSchema
+	constructor(private readonly boards: BoardRepository) { super() }
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const board = await this.boards.findById(input.boardId, tx)
+			if (!board) throw new BaseError<ApplicationErrors>('BOARD_NOT_FOUND')
+			const list = board.addList(input.name)
+			await this.boards.save(board, tx)
+			await this.domainEventRepository.save(
+				new ListAddedToBoardEvent({ entityId: board.id.value, ownerId: board.storeId.value, payload: { boardId: board.id.value, storeId: board.storeId.value, listId: list.id, name: input.name, position: list.position } }),
+				tx,
+			)
+			return { listId: list.id, position: list.position }
+		})
+	}
+}
