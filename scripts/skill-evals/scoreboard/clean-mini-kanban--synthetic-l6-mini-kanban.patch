+import { describe, expect, it } from 'bun:test'
+import { Card, type BoardPlacement } from './Card'
+
+const STORE = '019e4d24-6524-7041-9e1c-8108180cddae'
+const BOARD = '019e4d24-6524-7041-9e1c-8108180cddaf'
+const L1 = '019e4d24-6524-7041-9e1c-8108180cdda0'
+const L2 = '019e4d24-6524-7041-9e1c-8108180cdda1'
+const ok: BoardPlacement = { isArchived: false, listIds: [L1, L2] }
+
+function code(fn: () => unknown): string | undefined {
+	try { fn(); return undefined } catch (e) { return (e as { name: string }).name }
+}
+
+describe('Card invariants', () => {
+	it('creates a card on a valid list', () => {
+		const card = Card.create({ storeId: STORE, boardId: BOARD, listId: L1, title: 'T' }, ok)
+		expect(card.listId.value).toBe(L1)
+	})
+	it('rejects creation when the list is not on the board', () => {
+		expect(code(() => Card.create({ storeId: STORE, boardId: BOARD, listId: '019e4d24-6524-7041-9e1c-8108180cdda9', title: 'T' }, ok))).toBe('CARD_LIST_NOT_ON_BOARD')
+	})
+	it('rejects creation on an archived board', () => {
+		expect(code(() => Card.create({ storeId: STORE, boardId: BOARD, listId: L1, title: 'T' }, { isArchived: true, listIds: [L1] }))).toBe('CARD_BOARD_ARCHIVED')
+	})
+	it('moves a card to another existing list and records fromListId', () => {
+		const card = Card.create({ storeId: STORE, boardId: BOARD, listId: L1, title: 'T' }, ok)
+		const r = card.moveTo(L2, 0, ok)
+		expect(r.fromListId).toBe(L1)
+		expect(card.listId.value).toBe(L2)
+	})
+	it('rejects a move onto an archived board', () => {
+		const card = Card.create({ storeId: STORE, boardId: BOARD, listId: L1, title: 'T' }, ok)
+		expect(code(() => card.moveTo(L2, 0, { isArchived: true, listIds: [L1, L2] }))).toBe('CARD_BOARD_ARCHIVED')
+	})
+})
