+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import type { DomainErrors } from '../errors'
+
+export type BoardPlacement = { isArchived: boolean; listIds: string[] }
+
+export const CardSchema = z.object({
+	storeId: z.instance(Id),
+	boardId: z.instance(Id),
+	listId: z.instance(Id),
+	title: z.string().min(1),
+	position: z.number().int(),
+})
+export type CardProps = Z.infer<typeof CardSchema>
+
+export class Card extends AggregateRoot<typeof CardSchema> {
+	static override schema = CardSchema
+
+	private static assertPlacement(listId: string, placement: BoardPlacement): void {
+		if (placement.isArchived) throw new BaseError<DomainErrors>('CARD_BOARD_ARCHIVED')
+		if (!placement.listIds.includes(listId)) throw new BaseError<DomainErrors>('CARD_LIST_NOT_ON_BOARD')
+	}
+
+	static create(
+		data: { storeId: string; boardId: string; listId: string; title: string; position?: number },
+		placement: BoardPlacement,
+	): Card {
+		Card.assertPlacement(data.listId, placement)
+		return new Card({
+			storeId: data.storeId,
+			boardId: data.boardId,
+			listId: data.listId,
+			title: data.title,
+			position: data.position ?? 0,
+		})
+	}
+
+	moveTo(toListId: string, position: number, placement: BoardPlacement): { fromListId: string; toListId: string } {
+		Card.assertPlacement(toListId, placement)
+		const fromListId = this.listId.value
+		this.listId = new Id(toListId)
+		this.position = position
+		this.validate()
+		return { fromListId, toListId }
+	}
+}
+export interface Card extends CardProps {}
