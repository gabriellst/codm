@@ -0,0 +1,87 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { cards } from '@template/contracts/db'
+import { Card } from '../../entities/Card'
+import { CardRepository } from './CardRepository'
+
+@injectable()
+export class DrizzleCardRepository extends CardRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<Card | undefined> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient.select().from(cards).where(eq(cards.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async save(entity: Card, tx?: DrizzleClient): Promise<Card> {
+		entity.incrementVersion()
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+			await dbClient
+				.insert(cards)
+				.values(data)
+				.onConflictDoUpdate({
+					target: cards.id,
+					set: {
+						boardId: data.boardId,
+						listId: data.listId,
+						title: data.title,
+						position: data.position,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbClient.delete(cards).where(eq(cards.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: typeof cards.$inferSelect): Card {
+		const parsed = Card.schema.parse({
+			storeId: row.storeId,
+			boardId: row.boardId,
+			listId: row.listId,
+			title: row.title,
+			position: row.position,
+		})
+		return new Card({
+			...parsed,
+			id: row.id,
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: Card): typeof cards.$inferInsert {
+		return {
+			id: entity.id.value,
+			storeId: entity.storeId.value,
+			boardId: entity.boardId.value,
+			listId: entity.listId.value,
+			title: entity.title,
+			position: entity.position,
+			createdAt: entity.createdAt,
+			updatedAt: entity.updatedAt,
+			version: entity.version,
+		}
+	}
+}
