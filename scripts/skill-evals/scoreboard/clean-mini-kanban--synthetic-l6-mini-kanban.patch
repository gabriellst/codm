+import { injectable } from 'tsyringe-neo'
+import { Controller, HttpStatusCode, z } from '@template/core-typescript'
+import { AuthAccountMiddleware } from '@auth/middlewares/AuthAccountMiddleware'
+import { RequireStoreMember } from '@tenancy/middlewares/RequireStoreMember'
+import { AddList } from '../usecases/AddList'
+
+export const AddListControllerInputSchema = z.object({
+  ctx: z.object({ session: z.object({ storeId: z.uuid() }) }),
+  params: z.object({ boardId: z.uuid() }),
+  body: z.object({ name: z.string().min(1) }),
+})
+export const AddListControllerOutputSchema = z.object({ listId: z.uuid(), position: z.number().int() })
+
+@injectable()
+export class AddListController extends Controller<typeof AddListControllerInputSchema, typeof AddListControllerOutputSchema> {
+  readonly path = '/boards/:boardId/lists'
+  readonly method = 'post' as const
+  readonly description = 'Add a list (column) to a board'
+  readonly inputSchema = AddListControllerInputSchema
+  readonly outputSchema = AddListControllerOutputSchema
+  override middlewares = [AuthAccountMiddleware, RequireStoreMember]
+  constructor(private addList: AddList) { super() }
+  async handle(request: this['input']): Promise<this['output']> {
+    const data = await this.addList.execute({ boardId: request.params.boardId, name: request.body.name })
+    return { status: HttpStatusCode.CREATED, data }
+  }
+}
