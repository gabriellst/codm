+import { describe, expect, it } from 'bun:test'
+import { Board } from './Board'
+
+const STORE = '019e4d24-6524-7041-9e1c-8108180cddae'
+
+describe('Board', () => {
+	it('addList appends with incrementing positions; placement reflects ids', () => {
+		const board = Board.create({ storeId: STORE, name: 'B' })
+		const a = board.addList('To Do')
+		const b = board.addList('Doing')
+		expect(a.position).toBe(0)
+		expect(b.position).toBe(1)
+		expect(board.placement().listIds).toEqual([a.id, b.id])
+		expect(board.placement().isArchived).toBe(false)
+	})
+
+	it('addList on an archived board rejects with BOARD_ARCHIVED', () => {
+		const board = Board.create({ storeId: STORE, name: 'B' })
+		board.archive()
+		let code: string | undefined
+		try { board.addList('x') } catch (e) { code = (e as { name: string }).name }
+		expect(code).toBe('BOARD_ARCHIVED')
+	})
+})
diff --git a/packages/api/typescript/src/board/entities/Board.ts b/packages/api/typescript/src/board/entities/Board.ts
new file mode 100644
index 000000000..9c46d7ace
--- /dev/null
+++ b/packages/api/typescript/src/board/entities/Board.ts
@@ -0,0 +1,52 @@
+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import type { DomainErrors } from '../errors'
+import { BoardList } from '../objects/BoardList'
+
+export const BoardSchema = z.object({
+	storeId: z.instance(Id),
+	name: z.string().min(1),
+	isArchived: z.boolean(),
+	lists: z.array(z.instance(BoardList)).default([]),
+})
+
+export type BoardProps = Z.infer<typeof BoardSchema>
+
+export class Board extends AggregateRoot<typeof BoardSchema> {
+	static override schema = BoardSchema
+
+	static create(data: { storeId: string; name: string }): Board {
+		return new Board({
+			storeId: data.storeId,
+			name: data.name,
+			isArchived: false,
+			lists: [],
+		})
+	}
+
+	addList(name: string): { id: string; position: number } {
+		if (this.isArchived) {
+			throw new BaseError<DomainErrors>('BOARD_ARCHIVED')
+		}
+		const id = Id.value()
+		const position = this.lists.length
+		const list = BoardList.create({ id, name, position })
+		this.lists = [...this.lists, list]
+		this.validate()
+		return { id, position }
+	}
+
+	archive(): void {
+		this.isArchived = true
+		this.validate()
+	}
+
+	placement(): { isArchived: boolean; listIds: string[] } {
+		return {
+			isArchived: this.isArchived,
+			listIds: this.lists.map(l => l.id),
+		}
+	}
+}
+
+export interface Board extends BoardProps {}
diff --git a/packages/api/typescript/src/board/errors/index.ts b/packages/api/typescript/src/board/errors/index.ts
