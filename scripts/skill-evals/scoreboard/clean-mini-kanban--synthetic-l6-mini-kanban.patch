+
+/**
+ * `board_view` — read-model / projection maintained by BoardViewProjector.
+ *
+ * A denormalised snapshot of a single board including all its lists and cards
+ * ordered by position. Updated by the projector on every BoardCreated,
+ * ListAddedToBoard, BoardArchived, CardCreated, and CardMoved event.
+ *
+ * The primary key is boardId — one row per board.
+ */
+export const boardView = kanbanSchema.table(
+	'board_view',
+	{
+		// boardId is the primary key — one projection row per board.
+		boardId: uuid('board_id').primaryKey(),
+
+		// Tenancy anchor — indexed for efficient per-store projector reads.
+		storeId: uuid('store_id').notNull(),
+
+		name: text('name').notNull(),
+
+		isArchived: boolean('is_archived').notNull().default(false),
+
+		// Full denormalised tree: array of { listId, name, position, cards: [...] }.
+		// This is the shape returned directly by GetBoard BFF query.
+		lists: jsonb('lists')
+			.notNull()
+			.default(sql`'[]'::jsonb`)
+			.$type<BoardViewListItem[]>(),
+
+		// Audit — tracks when the projection was last written.
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+	},
+	t => ({
+		storeIdx: index('board_view_store_id_idx').on(t.storeId),
+	}),
+)
