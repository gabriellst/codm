+import { HttpStatusCode, registerErrorCodes } from '@template/core-typescript'
+import type { BaseDomainErrors, BaseApplicationErrors, BaseInterfaceErrors, BaseInfrastructureErrors } from '@template/core-typescript'
+
+export type CardDomainErrors = 'CARD_BOARD_ARCHIVED' | 'CARD_LIST_NOT_ON_BOARD'
+export type DomainErrors = BaseDomainErrors | CardDomainErrors
+
+export type CardApplicationErrors = 'CARD_NOT_FOUND' | 'BOARD_NOT_FOUND'
+export type ApplicationErrors = BaseApplicationErrors | CardApplicationErrors
+
+export type CardInterfaceErrors = never
+export type InterfaceErrors = BaseInterfaceErrors | CardInterfaceErrors
+export type CardInfrastructureErrors = never
+export type InfrastructureErrors = BaseInfrastructureErrors | CardInfrastructureErrors
+export type Errors = ApplicationErrors | DomainErrors | InfrastructureErrors | InterfaceErrors
+
+registerErrorCodes({
+	CARD_BOARD_ARCHIVED: HttpStatusCode.UNPROCESSABLE_ENTITY,
+	CARD_LIST_NOT_ON_BOARD: HttpStatusCode.UNPROCESSABLE_ENTITY,
+	CARD_NOT_FOUND: HttpStatusCode.NOT_FOUND,
+	BOARD_NOT_FOUND: HttpStatusCode.NOT_FOUND,
+})
