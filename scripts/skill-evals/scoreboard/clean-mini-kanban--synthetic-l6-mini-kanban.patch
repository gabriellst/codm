+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { container, type DependencyContainer } from 'tsyringe-neo'
+import { TestBed } from '@test/support'
+import { Board } from '@board/entities/Board'
+import { BoardRepository } from '@board/repositories/BoardRepository'
+import { CardRepository } from '../repositories/CardRepository'
+import { CreateCard } from './CreateCard'
+
+const STORE = '019e4d24-6524-7041-9e1c-8108180cddae'
+
+describe('CreateCard (integration)', () => {
+	let testBed: TestBed
+	let testContainer: DependencyContainer
+	let createCard: CreateCard
+	let boards: BoardRepository
+	let cards: CardRepository
+
+	beforeAll(async () => {
+		testContainer = container.createChildContainer()
+		testBed = await TestBed.create('integration', { testContainer, ownerId: 'integration-tenant' })
+		createCard = testBed.resolve(CreateCard)
+		boards = testBed.resolve(BoardRepository)
+		cards = testBed.resolve(CardRepository)
+	})
+	beforeEach(async () => { await testBed.reset() })
+	afterAll(async () => { await testBed.destroy() })
+
+	async function seedBoard() {
+		const board = Board.create({ storeId: STORE, name: 'Sprint' })
+		const todo = board.addList('To Do')
+		const doing = board.addList('Doing')
+		await boards.save(board)
+		return { boardId: board.id.value, todo, doing }
+	}
+
+	it('creates a card on a valid list and persists it', async () => {
+		const { boardId, todo } = await seedBoard()
+		const { cardId } = await createCard.execute({ storeId: STORE, boardId, listId: todo.id, title: 'Ship it' })
+		const saved = await cards.findById(cardId)
+		expect(saved).toBeDefined()
+		expect(saved?.listId.value).toBe(todo.id)
+		expect(saved?.title).toBe('Ship it')
+	})
+
+	it('rejects creating a card on a list not on the board', async () => {
+		const { boardId } = await seedBoard()
+		try {
+			await createCard.execute({ storeId: STORE, boardId, listId: '019e4d24-6524-7041-9e1c-8108180cddff', title: 'X' })
+			expect(true).toBe(false) // should not reach here
+		} catch (e) {
+			expect((e as { name: string }).name).toBe('CARD_LIST_NOT_ON_BOARD')
+		}
+	})
+})
