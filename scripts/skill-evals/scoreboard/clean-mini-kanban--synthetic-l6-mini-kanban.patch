@@ -0,0 +1,148 @@
+import { pgSchema, uuid, text, timestamp, integer, boolean, jsonb, index } from 'drizzle-orm/pg-core'
+import { sql } from 'drizzle-orm'
+
+/**
+ * `kanban` is BK Dash's Kanban schema.
+ *
+ * Provides the persistence layer for the board and card bounded contexts.
+ * Boards are store-scoped workspaces holding an ordered set of Lists (columns)
+ * as a jsonb value object — there is no separate List table. Cards belong to a
+ * single Board and List, with a numeric position for ordering.
+ *
+ * The `board_view` table is the read-model projection maintained by the
+ * BoardViewProjector — a denormalised tree of lists with their cards, optimised
+ * for the GetBoard BFF query.
+ *
+ * Tables:
+ *   - `boards`     — write-model; lists stored as jsonb value objects
+ *   - `cards`      — write-model; placement tracked by (boardId, listId, position)
+ *   - `board_view` — read-model projection (denormalised board tree)
+ */
+export const kanbanSchema = pgSchema('kanban')
+
+// ----- shared list / card item types for .$type<>() annotations -----
+
+export type BoardListItem = {
+	id: string
+	name: string
+	position: number
+}
+
+export type BoardViewCardItem = {
+	cardId: string
+	title: string
+	position: number
+}
+
+export type BoardViewListItem = {
+	listId: string
+	name: string
+	position: number
+	cards: BoardViewCardItem[]
+}
+
+// ----- tables -----
+
+export const boards = kanbanSchema.table(
+	'boards',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		// Multi-tenancy anchor — every board belongs to exactly one Store.
+		storeId: uuid('store_id').notNull(),
+
