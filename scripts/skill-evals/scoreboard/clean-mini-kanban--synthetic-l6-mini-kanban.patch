+import { injectable } from 'tsyringe-neo'
+import { EventHandler, ExternalMediator } from '@template/core-typescript'
+import { CardMovedEvent as CardMovedIntegrationEvent } from '@template/contracts-typescript/wire/events'
+import { CardMovedEvent } from '../events'
+
+/**
+ * Bridges the in-process `card.card.moved` domain event to the cross-service
+ * `integration.shared.card.moved` integration event. The ui ListenEvents SSE
+ * broadcaster fans this out to browsers whose session store matches payload.storeId.
+ */
+@injectable()
+export class CardMovedHandler extends EventHandler<typeof CardMovedEvent> {
+	readonly event = CardMovedEvent
+
+	constructor(private readonly externalMediator: ExternalMediator) {
+		super()
+	}
+
+	async handle(event: this['input']): Promise<this['output']> {
+		await this.externalMediator.publish(
+			new CardMovedIntegrationEvent({
+				ownerId: event.ownerId ?? '',
+				payload: {
+					storeId: event.payload.storeId,
+					boardId: event.payload.boardId,
+					cardId: event.payload.cardId,
+					fromListId: event.payload.fromListId,
+					toListId: event.payload.toListId,
+				},
+			}),
+		)
+		return
+	}
+}
