diff --git a/packages/api/typescript/src/ui/projections/BoardView.ts b/packages/api/typescript/src/ui/projections/BoardView.ts
new file mode 100644
index 000000000..deac57f9b
--- /dev/null
+++ b/packages/api/typescript/src/ui/projections/BoardView.ts
@@ -0,0 +1,89 @@
+import { z } from '@template/core-typescript'
+import Z from 'zod'
+import type { BoardCreatedEvent, ListAddedToBoardEvent, BoardArchivedEvent } from '@board/events'
+import type { CardCreatedEvent, CardMovedEvent } from '@card/events'
+
+export const BoardViewCardSchema = z.object({ cardId: z.string(), title: z.string(), position: z.number().int() })
+export const BoardViewListSchema = z.object({
+	listId: z.string(),
+	name: z.string(),
+	position: z.number().int(),
+	cards: z.array(BoardViewCardSchema),
+})
+export const BoardViewProjectionSchema = z.object({
+	boardId: z.string(),
+	storeId: z.string(),
+	name: z.string(),
+	isArchived: z.boolean(),
+	lists: z.array(BoardViewListSchema),
+})
+export type BoardViewProjectionProps = Z.infer<typeof BoardViewProjectionSchema>
+
+// Single source of truth for which events affect this projection.
+export type BoardViewProjectionEvent =
+	| BoardCreatedEvent
+	| ListAddedToBoardEvent
+	| BoardArchivedEvent
+	| CardCreatedEvent
+	| CardMovedEvent
+
+export class BoardViewProjection {
+	constructor(public props: BoardViewProjectionProps) {}
+
+	static create(event: BoardCreatedEvent): BoardViewProjection {
+		return new BoardViewProjection({
+			boardId: event.payload.boardId,
+			storeId: event.payload.storeId,
+			name: event.payload.name,
+			isArchived: false,
+			lists: [],
+		})
+	}
+
+	// Discriminates on event.name (runtime-safe: outbox delivers plain objects, so instanceof is NOT usable).
+	// The per-branch `as <ConcreteEvent>` is a precise downcast guarded by the name check — the same accepted
+	// deviation the core DrizzleOutboxDispatcher documents for serialized events. NOT `as any`/`as unknown`.
+	applyEvent(event: BoardViewProjectionEvent): void {
+		switch (event.name) {
+			case 'board.board.list_added': {
+				const p = (event as ListAddedToBoardEvent).payload
+				if (!this.props.lists.some(l => l.listId === p.listId)) {
+					this.props.lists.push({ listId: p.listId, name: p.name, position: p.position, cards: [] })
+					this.props.lists.sort((a, b) => a.position - b.position)
+				}
+				return
+			}
+			case 'card.card.created': {
+				const p = (event as CardCreatedEvent).payload
+				const list = this.props.lists.find(l => l.listId === p.listId)
+				if (list && !list.cards.some(c => c.cardId === p.cardId)) {
+					list.cards.push({ cardId: p.cardId, title: p.title, position: p.position })
+					list.cards.sort((a, b) => a.position - b.position)
+				}
+				return
+			}
+			case 'card.card.moved': {
+				const p = (event as CardMovedEvent).payload
+				const from = this.props.lists.find(l => l.listId === p.fromListId)
+				const to = this.props.lists.find(l => l.listId === p.toListId)
+				if (!from || !to) return
+				const idx = from.cards.findIndex(c => c.cardId === p.cardId)
+				if (idx === -1) return
+				const card = from.cards[idx]
+				if (!card) return
+				from.cards.splice(idx, 1)
+				if (!to.cards.some(c => c.cardId === card.cardId)) {
+					to.cards.push(card)
+					to.cards.sort((a, b) => a.position - b.position)
+				}
+				return
+			}
+			case 'board.board.archived': {
+				this.props.isArchived = true
+				return
+			}
+			default:
+				return
+		}
+	}
+}
diff --git a/packages/api/typescript/src/ui/projections/BoardViewProjectionRepository.ts b/packages/api/typescript/src/ui/projections/BoardViewProjectionRepository.ts
new file mode 100644
index 000000000..60bda9272
--- /dev/null
+++ b/packages/api/typescript/src/ui/projections/BoardViewProjectionRepository.ts
@@ -0,0 +1,89 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { boardView } from '@template/contracts/db'
+import { BoardViewProjection } from './BoardView'
+
+export abstract class BoardViewProjectionRepository {
+	abstract findByBoardId(boardId: string, tx?: Transaction): Promise<BoardViewProjection | null>
+	abstract save(projection: BoardViewProjection, tx?: Transaction): Promise<void>
+	abstract insertIfNew(projection: BoardViewProjection, tx?: Transaction): Promise<boolean>
+}
+
+@injectable()
+export class DrizzleBoardViewProjectionRepository extends BoardViewProjectionRepository {
+	constructor(private db: DrizzleClient) { super() }
+
+	async findByBoardId(boardId: string, tx?: DrizzleClient): Promise<BoardViewProjection | null> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(boardView).where(eq(boardView.boardId, boardId)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return null
+		const row = result.data
+		return new BoardViewProjection({
+			boardId: row.boardId,
+			storeId: row.storeId,
+			name: row.name,
+			isArchived: row.isArchived,
+			lists: (row.lists ?? []).map(l => ({
+				listId: l.listId,
+				name: l.name,
+				position: l.position,
+				cards: l.cards.map(c => ({ cardId: c.cardId, title: c.title, position: c.position })),
+			})),
+		})
+	}
+
+	async save(projection: BoardViewProjection, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const data = {
+			boardId: projection.props.boardId,
+			storeId: projection.props.storeId,
+			name: projection.props.name,
+			isArchived: projection.props.isArchived,
+			lists: projection.props.lists,
+			updatedAt: new Date(),
+		}
+		const result = await tryCatchAsync(async () => {
+			await dbc.insert(boardView).values(data).onConflictDoUpdate({
+				target: boardView.boardId,
+				set: { name: data.name, isArchived: data.isArchived, lists: data.lists, updatedAt: data.updatedAt },
+			})
+		})
+		if (!result.success) throw result.error
+	}
+
+	async insertIfNew(projection: BoardViewProjection, tx?: DrizzleClient): Promise<boolean> {
+		const dbc = tx ?? this.db
+		const existing = await this.findByBoardId(projection.props.boardId, tx)
+		if (existing) return false
+		const data = {
+			boardId: projection.props.boardId,
+			storeId: projection.props.storeId,
+			name: projection.props.name,
+			isArchived: projection.props.isArchived,
+			lists: projection.props.lists,
+			updatedAt: new Date(),
+		}
+		const result = await tryCatchAsync(async () => {
+			await dbc.insert(boardView).values(data)
+		})
+		if (!result.success) return false
+		return true
+	}
+}
+
+@injectable()
+export class MockBoardViewProjectionRepository extends BoardViewProjectionRepository {
+	private store = new Map<string, BoardViewProjection>()
+	async findByBoardId(boardId: string, _tx?: Transaction): Promise<BoardViewProjection | null> { return this.store.get(boardId) ?? null }
+	async save(projection: BoardViewProjection, _tx?: Transaction): Promise<void> { this.store.set(projection.props.boardId, projection) }
+	async insertIfNew(projection: BoardViewProjection, _tx?: Transaction): Promise<boolean> {
+		if (this.store.has(projection.props.boardId)) return false
+		this.store.set(projection.props.boardId, projection)
+		return true
+	}
+}
