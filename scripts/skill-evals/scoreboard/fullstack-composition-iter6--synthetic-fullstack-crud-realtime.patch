@@ -0,0 +1,91 @@
+import { expect, test } from '@playwright/test'
+
+/**
+ * Canonical flow 8 — purchase-orders (create → list, cancel → status flip, real-time list update).
+ *
+ * Asserts that:
+ *   1. (create → list) A user can open the "New order" dialog on
+ *      /app/procurement/purchase-orders, fill in supplier name +
+ *      amount, submit, and the new row appears in the list.
+ *   2. (cancel → status flip) After creating a DRAFT purchase order,
+ *      clicking "Cancel order" flips the row's status badge to
+ *      "Cancelado" (pt-BR locale) without a full page reload.
+ *   3. (real-time) With the list open, a purchase order created
+ *      programmatically via `page.request` (POST
+ *      /v1/procurement/purchase-orders) appears in the list within
+ *      5 seconds — no manual reload.
+ *
+ * Currently test.fixme()d pending Phase F fixtures (auth helper,
+ * store-session cookie injection).
+ */
+
+test('create → list: new purchase order appears in the list', async ({ page }) => {
+	test.fixme() // Pending Phase F fixtures: auth helper, store-session cookie injection
+
+	// 1. Sign in and navigate to the purchase orders route
+	// await given.onboardedUser(page)
+	await page.goto('/app/procurement/purchase-orders')
+	await expect(page).toHaveURL(/\/app\/procurement\/purchase-orders/)
+
+	// 2. Open the create dialog
+	await page.getByRole('button', { name: 'New order' }).click()
+	await expect(page.getByRole('dialog')).toBeVisible()
+
+	// 3. Fill in supplier name and total amount
+	await page.getByLabel('Supplier name').fill('Fornecedor Teste')
+	await page.getByLabel('Amount (cents)').fill('150000')
+	await page.getByRole('button', { name: 'Create' }).click()
+
+	// 4. New row appears in the list
+	await expect(page.getByRole('cell', { name: 'Fornecedor Teste' })).toBeVisible()
+})
+
+test('cancel → status flip: DRAFT order badge changes to Cancelado', async ({ page }) => {
+	test.fixme() // Pending Phase F fixtures: auth helper, store-session cookie injection
+
+	// 1. Sign in, navigate to purchase orders
+	// await given.onboardedUser(page)
+	await page.goto('/app/procurement/purchase-orders')
+	await expect(page).toHaveURL(/\/app\/procurement\/purchase-orders/)
+
+	// 2. Create a DRAFT purchase order via the dialog
+	await page.getByRole('button', { name: 'New order' }).click()
+	await page.getByLabel('Supplier name').fill('Fornecedor Para Cancelar')
+	await page.getByLabel('Amount (cents)').fill('50000')
+	await page.getByRole('button', { name: 'Create' }).click()
+	await expect(page.getByRole('cell', { name: 'Fornecedor Para Cancelar' })).toBeVisible()
+
+	// 3. Click "Cancel order" action on the new row
+	const row = page.getByRole('row', { name: /Fornecedor Para Cancelar/ })
+	await row.getByRole('button', { name: 'Cancel order' }).click()
+
+	// 4. Status badge changes to "Cancelado" (pt-BR) without full reload
+	await expect(row.getByText('Cancelado')).toBeVisible()
+})
+
+test('real-time: order created via API appears in list without reload', async ({ page, request }) => {
+	test.fixme() // Pending Phase F fixtures: auth helper, store-session cookie injection
+
+	// 1. Sign in, navigate to purchase orders list
+	// await given.onboardedUser(page)
+	await page.goto('/app/procurement/purchase-orders')
+	await expect(page.getByRole('heading', { name: /purchase orders/i })).toBeVisible()
+
+	// 2. Record current row count before the programmatic creation
+	const before = await page.getByRole('row').count()
+
+	// 3. Create a new purchase order via API (same session cookies the browser holds)
+	const res = await request.post('http://localhost:3030/v1/procurement/purchase-orders', {
+		data: {
+			supplierName: 'Fornecedor Realtime',
+			totalAmount: { amountCents: 99900, currency: 'BRL' },
+		},
+	})
+	expect(res.status()).toBe(201)
+	const { purchaseOrderId } = await res.json()
+	expect(purchaseOrderId).toBeDefined()
+
+	// 4. Row appears in the live list within 5 seconds — no page reload
+	await expect(page.getByRole('row')).toHaveCount(before + 1, { timeout: 5_000 })
+	await expect(page.getByRole('cell', { name: 'Fornecedor Realtime' })).toBeVisible({ timeout: 5_000 })
+})
