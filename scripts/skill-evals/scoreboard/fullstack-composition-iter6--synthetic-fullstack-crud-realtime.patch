@@ -0,0 +1,184 @@
+import { useMemo } from 'react'
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useQueryClient } from '@tanstack/react-query'
+import {
+	useListPurchaseOrders,
+	listPurchaseOrdersQueryKey,
+	useCancelPurchaseOrder,
+	PurchaseOrderStatusEnum,
+	type ListPurchaseOrdersQueryResponse,
+	type PurchaseOrderStatus,
+	type CurrencyCode,
+} from '@template/client-typescript/typescript'
+import { toast } from 'sonner'
+import { IconX } from '@tabler/icons-react'
+import { format } from 'date-fns'
+
+import { DataTable, DataTableContent, DataTablePagination, type ColumnDef } from '@/components/DataTable'
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Skeleton } from '@/components/ui/skeleton'
+import { useMoney, useLocale, useServerEvents } from '@/hooks'
+import { useDialogStore } from '@/stores/useDialogStore'
+import { cn } from '@/lib/utils'
+
+import { CreatePurchaseOrderDialog } from './CreatePurchaseOrderDialog'
+
+type PurchaseOrderItem = ListPurchaseOrdersQueryResponse['items'][number]
+
+const routeApi = getRouteApi('/(app)/procurement/purchase-orders/')
+
+const STATUS_BADGE_VARIANT: Record<PurchaseOrderStatus, 'default' | 'secondary' | 'destructive'> = {
+	[PurchaseOrderStatusEnum.DRAFT]: 'secondary',
+	[PurchaseOrderStatusEnum.PLACED]: 'default',
+	[PurchaseOrderStatusEnum.CANCELLED]: 'destructive',
+}
+
+export function PurchaseOrderListSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const navigate = routeApi.useNavigate()
+	const queryClient = useQueryClient()
+	const formatMoney = useMoney()
+	const locale = useLocale()
+	const dialogStore = useDialogStore()
+
+	const { status, page, limit } = routeApi.useSearch()
+
+	useServerEvents('integration.shared.purchase_order.recorded', () => {
+		queryClient.invalidateQueries({ queryKey: listPurchaseOrdersQueryKey() })
+	})
+
+	const { data, isPending } = useListPurchaseOrders({ page, limit, status })
+
+	const items = data?.items ?? []
+	const total = data?.total ?? 0
+	const totalPages = data?.totalPages ?? 0
+
+	const { mutate: cancelOrder } = useCancelPurchaseOrder({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('purchaseOrders.cancelSuccess'))
+				queryClient.invalidateQueries({ queryKey: listPurchaseOrdersQueryKey({ page, limit, status }) })
+			},
+		},
+	})
+
+	const columns = useMemo<ColumnDef<PurchaseOrderItem>[]>(
+		() => [
+			{
+				id: 'supplierName',
+				header: t('purchaseOrders.columns.supplierName'),
+				accessorKey: 'supplierName',
+				cell: ({ row }) => <span className="font-medium text-foreground">{row.original.supplierName}</span>,
+			},
+			{
+				id: 'status',
+				header: t('purchaseOrders.columns.status'),
+				accessorKey: 'status',
+				cell: ({ row }) => (
+					<Badge variant={STATUS_BADGE_VARIANT[row.original.status]}>
+						{t(`enums.PurchaseOrderStatus.${row.original.status}`)}
+					</Badge>
+				),
+				meta: { width: '120px' },
+			},
+			{
+				id: 'amount',
+				header: t('purchaseOrders.columns.amount'),
+				accessorKey: 'totalAmountCents',
+				cell: ({ row }) =>
+					formatMoney({
+						amountCents: row.original.totalAmountCents,
+						currency: row.original.totalAmountCurrency as CurrencyCode,
+					}),
+				meta: { align: 'right', width: '130px' },
+			},
+			{
+				id: 'createdAt',
+				header: t('purchaseOrders.columns.createdAt'),
+				accessorKey: 'createdAt',
+				cell: ({ row }) => (
+					<span className="text-sm text-muted-foreground">
+						{format(new Date(row.original.createdAt), 'dd/MM/yyyy')}
+					</span>
+				),
+				meta: { width: '120px' },
+			},
+			{
+				id: 'actions',
+				header: '',
+				cell: ({ row }) => (
+					<div className="flex items-center justify-end gap-1">
+						<Button
+							variant="ghost"
+							size="icon-sm"
+							aria-label={t('purchaseOrders.actions.cancel')}
+							onClick={async () => {
+								const confirmed = await dialogStore.confirm({
+									title: t('purchaseOrders.cancelConfirm.title'),
+									description: t('purchaseOrders.cancelConfirm.description'),
+									actionLabel: t('purchaseOrders.cancelConfirm.action'),
+									cancelLabel: t('purchaseOrders.cancelConfirm.cancel'),
+									variant: 'destructive',
+								})
+								if (confirmed) {
+									cancelOrder({ id: row.original.id })
+								}
+							}}
+						>
+							<IconX className="size-4 text-destructive" />
+						</Button>
+					</div>
+				),
+				meta: { width: '60px' },
+			},
+		],
+		[t, formatMoney, locale, dialogStore, cancelOrder],
+	)
+
+	const skeletonRows = Array.from({ length: limit }, (_, i) => i)
+
+	return (
+		<div className={cn('flex flex-col gap-6', className)} {...props}>
+			<div className="flex items-center justify-between gap-4">
+				<h1 className="text-2xl font-bold text-foreground">{t('purchaseOrders.title')}</h1>
+				<Button onClick={() => dialogStore.show(<CreatePurchaseOrderDialog />)}>
+					{t('purchaseOrders.actions.new')}
+				</Button>
+			</div>
+
+			<DataTable
+				columns={columns}
+				getRowId={r => r.id}
+				data={items}
+				total={total}
+				totalPages={totalPages}
+				isLoading={isPending}
+				page={page}
+				limit={limit}
+				search=""
+				onPageChange={p => navigate({ search: prev => ({ ...prev, page: p }) })}
+				onLimitChange={l => navigate({ search: prev => ({ ...prev, limit: l, page: 1 }) })}
+				onSearchChange={() => {}}
+			>
+				<DataTableContent
+					emptyState={
+						<div className="py-10 text-center text-muted-foreground text-sm">
+							{t('purchaseOrders.empty')}
+						</div>
+					}
+					loadingState={
+						<div className="flex flex-col gap-2 p-2">
+							{skeletonRows.map(i => (
+								<Skeleton key={i} className="h-10 w-full rounded-md" />
+							))}
+						</div>
+					}
+				/>
+				<DataTablePagination />
+			</DataTable>
+		</div>
