+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { container, type DependencyContainer } from 'tsyringe-neo'
+import { TestBed, testId } from '@test/support'
+import { DomainEventRepository } from '@template/core-typescript'
+import { PurchaseOrderStatus, CurrencyCode } from '@template/contracts-typescript/wire/enums'
+import { CreatePurchaseOrder } from './CreatePurchaseOrder'
+import { PurchaseOrderRepository } from '../repositories/PurchaseOrderRepository'
+import { PurchaseOrderCreatedEvent } from '../events'
+
+const STORE = testId('store', '1')
+const USER = testId('user', '1')
+const AMOUNT = { amountCents: 50000, currency: CurrencyCode.BRL }
+
+describe('CreatePurchaseOrder', () => {
+	let testBed: TestBed
+	let testContainer: DependencyContainer
+	let createPurchaseOrder: CreatePurchaseOrder
+	let repo: PurchaseOrderRepository
+
+	beforeAll(async () => {
+		testContainer = container.createChildContainer()
+		testBed = await TestBed.create('integration', { testContainer, ownerId: 'integration-tenant' })
+		createPurchaseOrder = testBed.resolve(CreatePurchaseOrder)
+		repo = testBed.resolve(PurchaseOrderRepository)
+	})
+	beforeEach(async () => {
+		await testBed.reset()
+	})
+	afterAll(async () => {
+		await testBed.destroy()
+	})
+
+	it('saves the purchase order and emits PurchaseOrderCreatedEvent', async () => {
+		const result = await createPurchaseOrder.execute({
+			userId: USER,
+			storeId: STORE,
+			supplierName: 'Supplier A',
+			totalAmount: AMOUNT,
+		})
+
+		expect(result.purchaseOrderId).toBeDefined()
+
+		const saved = await repo.findById(result.purchaseOrderId)
+		expect(saved).toBeDefined()
+		expect(saved!.status).toBe(PurchaseOrderStatus.DRAFT)
+		expect(saved!.supplierName).toBe('Supplier A')
+		expect(saved!.totalAmount.amountCents).toBe(50000)
+
+		const events = await testBed.resolve(DomainEventRepository).findByType(PurchaseOrderCreatedEvent)
+		expect(events).toHaveLength(1)
+		expect(events[0]!.entityId).toBe(result.purchaseOrderId)
+	})
+
+	it('throws VALIDATION_ERROR for empty supplier name', async () => {
+		await expect(
+			createPurchaseOrder.execute({
+				userId: USER,
+				storeId: STORE,
+				supplierName: '',
+				totalAmount: AMOUNT,
+			}),
+		).rejects.toMatchObject({ name: 'VALIDATION_ERROR' })
+	})
+})
