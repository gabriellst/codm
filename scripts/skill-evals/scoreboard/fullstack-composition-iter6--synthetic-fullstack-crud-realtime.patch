@@ -0,0 +1,72 @@
+import { pgSchema, pgEnum, uuid, varchar, text, timestamp, integer, bigint, index, uniqueIndex } from 'drizzle-orm/pg-core'
+
+/**
+ * `procurement` is BK Dash's Procurement schema.
+ *
+ * Owns supplier purchase orders created by merchants. TS-owned — the Go sync
+ * engine only consumes integration events and writes audit rows into a
+ * separate `purchase_order_audit` table (channel-side migration).
+ *
+ * Tables:
+ *   - `purchase_orders` — one row per purchase order with status lifecycle.
+ */
+export const procurementSchema = pgSchema('procurement')
+
+export const purchaseOrderStatusEnum = pgEnum('purchase_order_status', ['DRAFT', 'PLACED', 'CANCELLED'])
+
+/**
+ * `purchase_orders` — supplier purchase orders created by merchants.
+ *
+ * Status lifecycle: DRAFT → PLACED → CANCELLED (cancelled is terminal).
+ * Soft-delete is not used; cancellation is the terminal state.
+ */
+export const purchaseOrders = procurementSchema.table(
+	'purchase_orders',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		storeId: uuid('store_id').notNull(),
+
+		supplierName: text('supplier_name').notNull(),
+
+		// PurchaseOrderStatus: DRAFT | PLACED | CANCELLED
+		status: purchaseOrderStatusEnum('status').notNull().default('DRAFT'),
+
+		// Monetary total — stored as cents (bigint) + ISO-4217 currency code.
+		totalAmountCents: bigint('total_amount_cents', { mode: 'bigint' }).notNull(),
+		totalAmountCurrency: text('total_amount_currency').notNull(),
+
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		storeIdx: index('purchase_orders_store_id_idx').on(t.storeId),
+		statusIdx: index('purchase_orders_status_idx').on(t.status),
+	}),
+)
+
+/**
+ * `purchase_order_audit` — append-only audit log written by the Go sync engine
+ * when it consumes `integration.shared.purchase_order.recorded` events.
+ *
+ * Uniqueness on (purchase_order_id, status) makes inserts idempotent — the
+ * handler uses ON CONFLICT DO NOTHING so redelivered events are safe.
+ */
+export const purchaseOrderAudit = procurementSchema.table(
+	'purchase_order_audit',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+		purchaseOrderId: uuid('purchase_order_id').notNull(),
+		storeId: uuid('store_id').notNull(),
+		supplierName: varchar('supplier_name', { length: 500 }).notNull(),
+		status: purchaseOrderStatusEnum('status').notNull(),
+		totalAmountCents: bigint('total_amount_cents', { mode: 'bigint' }).notNull(),
+		totalAmountCurrency: varchar('total_amount_currency', { length: 3 }).notNull(),
+		recordedAt: timestamp('recorded_at', { withTimezone: true }).defaultNow().notNull(),
+	},
+	t => ({
+		poStatusIdx: uniqueIndex('purchase_order_audit_po_status_idx').on(t.purchaseOrderId, t.status),
+		storeIdx: index('purchase_order_audit_store_idx').on(t.storeId),
+	}),
+)
