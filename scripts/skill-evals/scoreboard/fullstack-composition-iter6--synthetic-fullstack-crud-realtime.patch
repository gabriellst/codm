+package handlers
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/google/uuid"
+	"template/contracts-go/wire"
+	"template/core-go/types"
+)
+
+// PurchaseOrderAuditRepository writes purchase order audit rows.
+type PurchaseOrderAuditRepository struct {
+	db *sql.DB
+}
+
+// NewPurchaseOrderAuditRepository constructs a repository backed by the given db.
+func NewPurchaseOrderAuditRepository(db *sql.DB) *PurchaseOrderAuditRepository {
+	return &PurchaseOrderAuditRepository{db: db}
+}
+
+const insertPurchaseOrderAuditSQL = `
+INSERT INTO procurement.purchase_order_audit
+  (id, purchase_order_id, store_id, supplier_name, status, total_amount_cents, total_amount_currency, recorded_at)
+VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
+ON CONFLICT (purchase_order_id, status) DO NOTHING`
+
+// InsertAudit inserts an audit row for the given event. Idempotent on (purchase_order_id, status).
+func (r *PurchaseOrderAuditRepository) InsertAudit(ctx context.Context, evt wire.PurchaseOrderRecordedEvent) error {
+	id := uuid.New().String()
+	_, err := r.db.ExecContext(ctx, insertPurchaseOrderAuditSQL,
+		id,
+		evt.PurchaseOrderID,
+		evt.StoreID,
+		evt.SupplierName,
+		string(evt.Status),
+		int64(evt.TotalAmountCents),
+		evt.TotalAmountCurrency,
+		time.Now().UTC(),
+	)
+	return err
+}
+
+// PurchaseOrderRecordedHandler consumes integration.shared.purchase_order.recorded
+// and writes an audit row to procurement.purchase_order_audit.
+type PurchaseOrderRecordedHandler struct {
+	repo *PurchaseOrderAuditRepository
+}
+
+// NewPurchaseOrderRecordedHandler wires the handler with its repository.
+func NewPurchaseOrderRecordedHandler(repo *PurchaseOrderAuditRepository) *PurchaseOrderRecordedHandler {
+	return &PurchaseOrderRecordedHandler{repo: repo}
+}
+
+// EventName returns the integration event name this handler listens on.
+func (h *PurchaseOrderRecordedHandler) EventName() string {
+	return wire.PurchaseOrderRecordedEventName
+}
+
+// Handle decodes the integration event payload and writes an audit row.
+func (h *PurchaseOrderRecordedHandler) Handle(ctx context.Context, event types.IntegrationEventI) error {
+	provider, ok := event.(interface{ GetPayload() json.RawMessage })
+	if !ok {
+		return fmt.Errorf("purchase_order_recorded handler: event %s carries no payload", event.GetEventName())
+	}
+	decoded, err := wire.UnmarshalIntegrationEvent(provider.GetPayload())
+	if err != nil {
+		return fmt.Errorf("purchase_order_recorded handler: unmarshal: %w", err)
+	}
+	evt, ok := decoded.(wire.PurchaseOrderRecordedEvent)
+	if !ok {
+		return fmt.Errorf("purchase_order_recorded handler: unexpected event type %T", decoded)
+	}
+	return h.repo.InsertAudit(ctx, evt)
+}
