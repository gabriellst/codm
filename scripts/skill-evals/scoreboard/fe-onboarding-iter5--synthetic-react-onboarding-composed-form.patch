diff --git a/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx b/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx
new file mode 100644
index 000000000..fca7c24e7
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx
@@ -0,0 +1,113 @@
+import { z } from 'zod'
+import { useForm } from '@tanstack/react-form'
+import { Button } from '@/components/ui/button'
+import { type DeepPartial } from '@/lib'
+import { connectIntegrationMutationRequestSchema, ConnectionModeEnum } from '@template/client-typescript/typescript'
+import { unionVariantValues } from '@/lib'
+import { IconArrowRight } from '@tabler/icons-react'
+import { Spinner } from '@/components/ui/spinner'
+import { useTranslation } from 'react-i18next'
+import { cn } from '@/lib/utils'
+import type { ComponentProps } from 'react'
+
+const ALL_MODES = unionVariantValues(connectIntegrationMutationRequestSchema, 'connectionMode')
+const ONBOARDING_MODES = ALL_MODES.filter(
+	(m): m is 'CREDENTIALS' | 'MANUAL' => m === ConnectionModeEnum.CREDENTIALS || m === ConnectionModeEnum.MANUAL,
+) as ['CREDENTIALS', 'MANUAL']
+
+export const ConnectionModeStepSchema = z.object({
+	connectionMode: z.enum(ONBOARDING_MODES),
+})
+
+type ConnectionModeStepData = z.infer<typeof ConnectionModeStepSchema>
+
+interface ConnectionModeStepProps extends Omit<ComponentProps<'form'>, 'onSubmit'> {
+	defaultValues?: DeepPartial<ConnectionModeStepData>
+	onSubmit: (data: ConnectionModeStepData) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+export function ConnectionModeStep({ defaultValues, onSubmit, onBack, isSubmitting, className, ...props }: ConnectionModeStepProps) {
+	const { t } = useTranslation()
+
+	const MODE_DESCRIPTION: Record<'CREDENTIALS' | 'MANUAL', string> = {
+		CREDENTIALS: t('onboarding.connectionMode.CREDENTIALS.description'),
+		MANUAL: t('onboarding.connectionMode.MANUAL.description'),
+	}
+
+	const form = useForm({
+		defaultValues,
+		onSubmit: async form => {
+			const result = ConnectionModeStepSchema.safeParse(form.value)
+			if (!result.success) return
+			onSubmit(result.data)
+		},
+	})
+
+	return (
+		<form
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+			className={cn('flex flex-col gap-6 p-2', className)}
+			{...props}
+		>
+			<div className="text-center">
+				<h2 className="text-2xl font-semibold tracking-tight">{t('onboarding.connectionMode.title')}</h2>
+				<p className="text-muted-foreground mt-2">{t('onboarding.connectionMode.subtitle')}</p>
+			</div>
+
+			<form.Field name="connectionMode">
+				{field => (
+					<div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
+						{ONBOARDING_MODES.map(mode => (
+							<button
+								key={mode}
+								type="button"
+								onClick={() => field.handleChange(mode)}
+								className={cn(
+									'flex flex-col gap-2 rounded-xl border-2 p-5 text-left transition-all',
+									field.state.value === mode
+										? 'border-primary bg-primary/5'
+										: 'border-border hover:border-primary/40',
+								)}
+							>
+								<span className="font-semibold">{t(`enums.ConnectionMode.${mode}`)}</span>
+								<span className="text-sm text-muted-foreground">{MODE_DESCRIPTION[mode]}</span>
+							</button>
+						))}
+					</div>
+				)}
+			</form.Field>
+
+			<form.Subscribe selector={state => ({ canSubmit: state.canSubmit, values: state.values })}>
+				{({ canSubmit, values }) => {
+					const isDisabled = isSubmitting || !canSubmit || !ConnectionModeStepSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<div>
+								{onBack && (
+									<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+										{t('common.back')}
+									</Button>
+								)}
+							</div>
+							<div className="flex gap-2">
+								<Button type="submit" disabled={isDisabled}>
+									{isSubmitting && <Spinner className="mr-2" />}
+									{t('common.next')}
+									<IconArrowRight className="ml-1 size-4" />
+								</Button>
+							</div>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+export type { ConnectionModeStepData }
diff --git a/packages/app/react/src/routes/onboarding/-components/OnboardingWizard/index.tsx b/packages/app/react/src/routes/onboarding/-components/OnboardingWizard/index.tsx
new file mode 100644
index 000000000..55094934d
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/OnboardingWizard/index.tsx
@@ -0,0 +1,206 @@
+import { useCallback, type ComponentProps } from 'react'
+import { useNavigate } from '@tanstack/react-router'
+import { useTranslation } from 'react-i18next'
+import { toast } from 'sonner'
+import { useQueryClient } from '@tanstack/react-query'
+import {
+	useConnectIntegration,
+	connectIntegrationMutationRequestSchema,
+	listPlatformDescriptorsQueryKey,
+} from '@template/client-typescript/typescript'
+import { pickUnionVariant } from '@/lib'
+import { cn } from '@/lib/utils'
+
+import { useOnboardingWizardStore } from '../../-stores/useOnboardingWizardStore'
+import type { OnboardingPlatform, OnboardingIntegrationType } from '../../-stores/useOnboardingWizardStore'
+import { ConnectionModeStep } from '../ConnectionModeStep'
+import type { ConnectionModeStepData } from '../ConnectionModeStep'
+import { PlatformStep } from '../PlatformStep'
+import type { PlatformStepData } from '../PlatformStep'
+import { ShopifyCredentialsStep } from '../ShopifyCredentialsStep'
+import type { ShopifyCredentialsStepData } from '../ShopifyCredentialsStep'
+import { YampiCredentialsStep } from '../YampiCredentialsStep'
+import type { YampiCredentialsStepData } from '../YampiCredentialsStep'
+import { ReviewStep } from '../ReviewStep'
+import type { WizardAccumulated } from '../ReviewStep'
+
+const CREDENTIALS_STEPS = ['CONNECTION_MODE', 'PLATFORM', 'CREDENTIALS', 'REVIEW'] as const
+const MANUAL_STEPS = ['CONNECTION_MODE', 'PLATFORM', 'REVIEW'] as const
+
+type WizardStep = 'CONNECTION_MODE' | 'PLATFORM' | 'CREDENTIALS' | 'REVIEW'
+
+const MODE_STEPS: Record<'CREDENTIALS' | 'MANUAL', readonly WizardStep[]> = {
+	CREDENTIALS: CREDENTIALS_STEPS,
+	MANUAL: MANUAL_STEPS,
+}
+
+const CREDENTIALS_PLATFORMS: Partial<Record<OnboardingPlatform, true>> = {
+	SHOPIFY: true,
+	YAMPI: true,
+}
+
+export function OnboardingWizard({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const navigate = useNavigate()
+	const queryClient = useQueryClient()
+
+	const store = useOnboardingWizardStore()
+	const {
+		connectionMode,
+		platform,
+		integrationType,
+		credentials,
+		currentStepIndex,
+		setConnectionMode,
+		setPlatformAndType,
+		setCredentials,
+		setCurrentStepIndex,
+		setDirection,
+		reset,
+	} = store
+
+	const connectIntegration = useConnectIntegration({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('onboarding.toast.success'), {
+					description: t('onboarding.toast.successDescription'),
+				})
+				queryClient.invalidateQueries({ queryKey: listPlatformDescriptorsQueryKey() })
+				reset()
+				navigate({ to: '/dashboard', search: {} })
+			},
+		},
+	})
+
+	const steps = connectionMode ? MODE_STEPS[connectionMode] : CREDENTIALS_STEPS
+	const currentStep = (steps[currentStepIndex] ?? 'CONNECTION_MODE') as WizardStep
+
+	const advance = useCallback(() => {
+		setDirection(1)
+		setCurrentStepIndex(currentStepIndex + 1)
+	}, [currentStepIndex, setDirection, setCurrentStepIndex])
+
+	const handleBack = useCallback(() => {
+		if (currentStepIndex <= 0) return
+		setDirection(-1)
+		setCurrentStepIndex(currentStepIndex - 1)
+	}, [currentStepIndex, setDirection, setCurrentStepIndex])
+
+	const handleConnectionModeSubmit = useCallback(
+		(data: ConnectionModeStepData) => {
+			setConnectionMode(data.connectionMode)
+			setDirection(1)
+			setCurrentStepIndex(1)
+		},
+		[setConnectionMode, setDirection, setCurrentStepIndex],
+	)
+
+	const handlePlatformSubmit = useCallback(
+		(data: PlatformStepData) => {
+			setPlatformAndType(data.platform as OnboardingPlatform, data.integrationType as OnboardingIntegrationType)
+			advance()
+		},
+		[setPlatformAndType, advance],
+	)
+
+	const handleShopifyCredentialsSubmit = useCallback(
+		(data: ShopifyCredentialsStepData) => {
+			setCredentials(data as Record<string, string>)
+			advance()
+		},
+		[setCredentials, advance],
+	)
+
+	const handleYampiCredentialsSubmit = useCallback(
+		(data: YampiCredentialsStepData) => {
+			setCredentials(data as Record<string, string>)
+			advance()
+		},
+		[setCredentials, advance],
+	)
+
+	const handleFinalSubmit = useCallback(async () => {
+		if (!connectionMode || !platform || !integrationType) return
+		const envelope = { connectionMode, type: integrationType, platform, credentials }
+		let result
+		try {
+			const member = pickUnionVariant(connectIntegrationMutationRequestSchema, { platform, connectionMode })
+			result = member.safeParse(envelope)
+		} catch {
+			return
+		}
+		if (!result.success) return
+		await connectIntegration.mutateAsync({ data: result.data })
+	}, [connectionMode, platform, integrationType, credentials, connectIntegration])
+
+	const CREDENTIAL_STEP: Partial<Record<OnboardingPlatform, React.ReactNode>> = {
+		SHOPIFY: (
+			<ShopifyCredentialsStep
+				defaultValues={credentials as Partial<ShopifyCredentialsStepData>}
+				onSubmit={handleShopifyCredentialsSubmit}
+				onBack={handleBack}
+				isSubmitting={connectIntegration.isPending}
+			/>
+		),
+		YAMPI: (
+			<YampiCredentialsStep
+				defaultValues={credentials as Partial<YampiCredentialsStepData>}
+				onSubmit={handleYampiCredentialsSubmit}
+				onBack={handleBack}
+				isSubmitting={connectIntegration.isPending}
+			/>
+		),
+	}
+
+	const accumulated: WizardAccumulated | undefined =
+		connectionMode && platform && integrationType
+			? { connectionMode, platform, integrationType, credentials }
+			: undefined
+
+	const STEP_CONTENT: Record<WizardStep, React.ReactNode> = {
+		CONNECTION_MODE: (
+			<ConnectionModeStep
+				defaultValues={{ connectionMode }}
+				onSubmit={handleConnectionModeSubmit}
+			/>
+		),
+		PLATFORM: connectionMode ? (
+			<PlatformStep
+				connectionMode={connectionMode}
+				defaultValues={{ platform, integrationType }}
+				onSubmit={handlePlatformSubmit}
+				onBack={handleBack}
+			/>
+		) : null,
+		CREDENTIALS:
+			platform && CREDENTIALS_PLATFORMS[platform]
+				? CREDENTIAL_STEP[platform] ?? null
+				: null,
+		REVIEW: accumulated ? (
+			<ReviewStep
+				accumulated={accumulated}
+				onSubmit={handleFinalSubmit}
+				onBack={handleBack}
+				isSubmitting={connectIntegration.isPending}
+			/>
+		) : null,
+	}
+
+	return (
+		<div className={cn('w-full max-w-lg mx-auto py-12 px-4', className)} {...props}>
+			<div className="mb-8 flex gap-1">
