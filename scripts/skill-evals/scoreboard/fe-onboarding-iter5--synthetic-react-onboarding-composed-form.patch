+import { z } from 'zod'
+import { useForm } from '@tanstack/react-form'
+import { Button } from '@/components/ui/button'
+import { type DeepPartial } from '@/lib'
+import { IconArrowRight, IconArrowLeft } from '@tabler/icons-react'
+import { Spinner } from '@/components/ui/spinner'
+import { useTranslation } from 'react-i18next'
+import { cn } from '@/lib/utils'
+import type { ComponentProps } from 'react'
+import type { OnboardingConnectionMode, OnboardingPlatform } from '../../-stores/useOnboardingWizardStore'
+
+const OnboardingPlatformEnum = {
+	SHOPIFY: 'SHOPIFY',
+	YAMPI: 'YAMPI',
+	META: 'META',
+	MERCADOPAGO: 'MERCADOPAGO',
+} as const
+
+const OnboardingIntegrationTypeEnum = {
+	SALES_CHANNEL: 'SALES_CHANNEL',
+	CHECKOUT: 'CHECKOUT',
+	MARKETING_PLATFORM: 'MARKETING_PLATFORM',
+	PAYMENT_GATEWAY: 'PAYMENT_GATEWAY',
+} as const
+
+export const ONBOARDING_TARGETS = [
+	{ platform: OnboardingPlatformEnum.SHOPIFY, type: OnboardingIntegrationTypeEnum.SALES_CHANNEL, connectionMode: 'CREDENTIALS' as const },
+	{ platform: OnboardingPlatformEnum.YAMPI, type: OnboardingIntegrationTypeEnum.CHECKOUT, connectionMode: 'CREDENTIALS' as const },
+	{ platform: OnboardingPlatformEnum.META, type: OnboardingIntegrationTypeEnum.MARKETING_PLATFORM, connectionMode: 'MANUAL' as const },
+	{ platform: OnboardingPlatformEnum.MERCADOPAGO, type: OnboardingIntegrationTypeEnum.PAYMENT_GATEWAY, connectionMode: 'MANUAL' as const },
+] as const
+
+export const PlatformStepSchema = z.object({
+	platform: z.enum(OnboardingPlatformEnum),
+	integrationType: z.enum(OnboardingIntegrationTypeEnum),
+})
+
+type PlatformStepData = z.infer<typeof PlatformStepSchema>
+
+interface PlatformStepProps extends Omit<ComponentProps<'form'>, 'onSubmit'> {
+	connectionMode: OnboardingConnectionMode
+	defaultValues?: DeepPartial<PlatformStepData>
+	onSubmit: (data: PlatformStepData) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+export function PlatformStep({ connectionMode, defaultValues, onSubmit, onBack, isSubmitting, className, ...props }: PlatformStepProps) {
+	const { t } = useTranslation()
+
+	const availableTargets = ONBOARDING_TARGETS.filter(target => target.connectionMode === connectionMode)
+
+	const PLATFORM_LABEL: Record<OnboardingPlatform, string> = {
+		SHOPIFY: t('onboarding.platform.SHOPIFY.label'),
+		YAMPI: t('onboarding.platform.YAMPI.label'),
+		META: t('onboarding.platform.META.label'),
+		MERCADOPAGO: t('onboarding.platform.MERCADOPAGO.label'),
+	}
+	const PLATFORM_DESCRIPTION: Record<OnboardingPlatform, string> = {
+		SHOPIFY: t('onboarding.platform.SHOPIFY.description'),
+		YAMPI: t('onboarding.platform.YAMPI.description'),
+		META: t('onboarding.platform.META.description'),
+		MERCADOPAGO: t('onboarding.platform.MERCADOPAGO.description'),
+	}
+
+	const form = useForm({
+		defaultValues,
+		onSubmit: async form => {
+			const result = PlatformStepSchema.safeParse(form.value)
+			if (!result.success) return
+			onSubmit(result.data)
+		},
+	})
+
+	return (
+		<form
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+			className={cn('flex flex-col gap-6 p-2', className)}
+			{...props}
+		>
+			<div className="text-center">
+				<h2 className="text-2xl font-semibold tracking-tight">{t('onboarding.platform.title')}</h2>
+				<p className="text-muted-foreground mt-2">{t('onboarding.platform.subtitle')}</p>
+			</div>
+
+			<form.Field name="platform">
+				{platformField => (
+					<form.Field name="integrationType">
+						{typeField => (
+							<div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
+								{availableTargets.map(target => {
+									const isSelected = platformField.state.value === target.platform
+									return (
+										<button
+											key={target.platform}
+											type="button"
+											onClick={() => {
+												platformField.handleChange(target.platform)
+												typeField.handleChange(target.type)
+											}}
+											className={cn(
+												'flex flex-col gap-2 rounded-xl border-2 p-5 text-left transition-all',
+												isSelected
+													? 'border-primary bg-primary/5'
+													: 'border-border hover:border-primary/40',
+											)}
+										>
+											<span className="font-semibold">{PLATFORM_LABEL[target.platform]}</span>
+											<span className="text-sm text-muted-foreground">
+												{PLATFORM_DESCRIPTION[target.platform]}
+											</span>
+										</button>
+									)
+								})}
+							</div>
+						)}
+					</form.Field>
+				)}
+			</form.Field>
+
+			<form.Subscribe selector={state => ({ canSubmit: state.canSubmit, values: state.values })}>
+				{({ canSubmit, values }) => {
+					const isDisabled = isSubmitting || !canSubmit || !PlatformStepSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<div>
+								{onBack && (
+									<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+										<IconArrowLeft className="mr-1 size-4" />
+										{t('common.back')}
+									</Button>
+								)}
+							</div>
+							<div className="flex gap-2">
+								<Button type="submit" disabled={isDisabled}>
+									{isSubmitting && <Spinner className="mr-2" />}
+									{t('common.next')}
+									<IconArrowRight className="ml-1 size-4" />
+								</Button>
+							</div>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+export type { PlatformStepData }
