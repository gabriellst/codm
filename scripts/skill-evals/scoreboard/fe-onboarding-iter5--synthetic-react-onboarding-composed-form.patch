+import { create } from 'zustand'
+
+export type OnboardingConnectionMode = 'CREDENTIALS' | 'MANUAL'
+export type OnboardingPlatform = 'SHOPIFY' | 'YAMPI' | 'META' | 'MERCADOPAGO'
+export type OnboardingIntegrationType = 'SALES_CHANNEL' | 'CHECKOUT' | 'MARKETING_PLATFORM' | 'PAYMENT_GATEWAY'
+
+interface OnboardingWizardStore {
+	connectionMode: OnboardingConnectionMode | undefined
+	platform: OnboardingPlatform | undefined
+	integrationType: OnboardingIntegrationType | undefined
+	credentials: Record<string, string>
+	currentStepIndex: number
+	direction: 1 | -1
+	setConnectionMode: (mode: OnboardingConnectionMode) => void
+	setPlatformAndType: (platform: OnboardingPlatform, integrationType: OnboardingIntegrationType) => void
+	setCredentials: (credentials: Record<string, string>) => void
+	setCurrentStepIndex: (index: number) => void
+	setDirection: (direction: 1 | -1) => void
+	reset: () => void
+}
+
+const INITIAL: Pick<
+	OnboardingWizardStore,
+	'connectionMode' | 'platform' | 'integrationType' | 'credentials' | 'currentStepIndex' | 'direction'
+> = {
+	connectionMode: undefined,
+	platform: undefined,
+	integrationType: undefined,
+	credentials: {},
+	currentStepIndex: 0,
+	direction: 1,
+}
+
+export const useOnboardingWizardStore = create<OnboardingWizardStore>()(set => ({
+	...INITIAL,
+	setConnectionMode: connectionMode => set({ connectionMode }),
+	setPlatformAndType: (platform, integrationType) => set({ platform, integrationType }),
+	setCredentials: credentials => set({ credentials }),
+	setCurrentStepIndex: currentStepIndex => set({ currentStepIndex }),
+	setDirection: direction => set({ direction }),
+	reset: () => set(INITIAL),
+}))
