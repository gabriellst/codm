+import { Button } from '@/components/ui/button'
+import { connectIntegrationMutationRequestSchema } from '@template/client-typescript/typescript'
+import { pickUnionVariant } from '@/lib'
+import { IconArrowLeft } from '@tabler/icons-react'
+import { Spinner } from '@/components/ui/spinner'
+import { useTranslation } from 'react-i18next'
+import { cn } from '@/lib/utils'
+import type { ComponentProps } from 'react'
+import type { OnboardingConnectionMode, OnboardingPlatform, OnboardingIntegrationType } from '../../-stores/useOnboardingWizardStore'
+
+export interface WizardAccumulated {
+	connectionMode: OnboardingConnectionMode
+	platform: OnboardingPlatform
+	integrationType: OnboardingIntegrationType
+	credentials: Record<string, string>
+}
+
+interface ReviewStepProps extends Omit<ComponentProps<'div'>, 'onSubmit'> {
+	accumulated: WizardAccumulated
+	onSubmit: () => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+const CREDENTIAL_FIELD_LABEL: Record<string, string> = {
+	shopDomain: 'integrations.sheet.shopDomain',
+	clientId: 'integrations.sheet.clientId',
+	clientSecret: 'integrations.sheet.clientSecret',
+	alias: 'integrations.sheet.alias',
+	userToken: 'integrations.sheet.userToken',
+	userSecretKey: 'integrations.sheet.userSecretKey',
+}
+
+const PLATFORM_LABEL: Record<OnboardingPlatform, string> = {
+	SHOPIFY: 'onboarding.platform.SHOPIFY.label',
+	YAMPI: 'onboarding.platform.YAMPI.label',
+	META: 'onboarding.platform.META.label',
+	MERCADOPAGO: 'onboarding.platform.MERCADOPAGO.label',
+}
+
+export function ReviewStep({ accumulated, onSubmit, onBack, isSubmitting, className, ...props }: ReviewStepProps) {
+	const { t } = useTranslation()
+
+	const envelope = {
+		connectionMode: accumulated.connectionMode,
+		type: accumulated.integrationType,
+		platform: accumulated.platform,
+		credentials: accumulated.credentials,
+	}
+
+	let isValid = false
+	try {
+		const member = pickUnionVariant(connectIntegrationMutationRequestSchema, {
+			platform: accumulated.platform,
+			connectionMode: accumulated.connectionMode,
+		})
+		isValid = member.safeParse(envelope).success
+	} catch {
+		isValid = false
+	}
+
+	const credentialEntries = Object.entries(accumulated.credentials)
+
+	return (
+		<div className={cn('flex flex-col gap-6 p-2', className)} {...props}>
+			<div className="text-center">
+				<h2 className="text-2xl font-semibold tracking-tight">{t('onboarding.review.title')}</h2>
+				<p className="text-muted-foreground mt-2">{t('onboarding.review.subtitle')}</p>
+			</div>
+
+			<dl className="rounded-xl border divide-y">
+				<div className="flex items-center justify-between px-4 py-3">
+					<dt className="text-sm text-muted-foreground">{t('onboarding.review.platform')}</dt>
+					<dd className="text-sm font-medium">{t(PLATFORM_LABEL[accumulated.platform])}</dd>
+				</div>
+				<div className="flex items-center justify-between px-4 py-3">
+					<dt className="text-sm text-muted-foreground">{t('onboarding.review.connectionMode')}</dt>
+					<dd className="text-sm font-medium">{t(`enums.ConnectionMode.${accumulated.connectionMode}`)}</dd>
+				</div>
+				{credentialEntries.length > 0 && (
+					<>
+						{credentialEntries.map(([key, value]) => (
+							<div key={key} className="flex items-center justify-between px-4 py-3">
+								<dt className="text-sm text-muted-foreground">
+									{CREDENTIAL_FIELD_LABEL[key] ? t(CREDENTIAL_FIELD_LABEL[key]) : key}
+								</dt>
+								<dd className="text-sm font-medium font-mono truncate max-w-48">
+									{key.toLowerCase().includes('secret') || key.toLowerCase().includes('token')
+										? '••••••••'
+										: value}
+								</dd>
+							</div>
+						))}
+					</>
+				)}
+			</dl>
+
+			<div className="flex justify-between">
+				<div>
+					{onBack && (
+						<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+							<IconArrowLeft className="mr-1 size-4" />
+							{t('common.back')}
+						</Button>
+					)}
+				</div>
+				<Button onClick={onSubmit} disabled={!isValid || isSubmitting}>
+					{isSubmitting && <Spinner className="mr-2" />}
+					{t('onboarding.review.connect')}
+				</Button>
+			</div>
+		</div>
+	)
+}
