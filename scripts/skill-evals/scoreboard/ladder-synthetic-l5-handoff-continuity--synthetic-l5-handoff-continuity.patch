--- /dev/null
+++ b/packages/api/typescript/src/sales/usecases/DeactivateCoupon.ts
@@ -0,0 +1,51 @@
+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { CouponDeactivatedEvent } from '../events'
+import { CouponRepository } from '../repositories/CouponRepository/CouponRepository'
+import type { ApplicationErrors } from '../errors'
+
+export const DeactivateCouponInputSchema = z.object({
+	storeId: z.uuid(),
+	couponId: z.uuid(),
+})
+
+export const DeactivateCouponOutputSchema = z.void()
+
+@injectable()
+export class DeactivateCoupon extends Handler<typeof DeactivateCouponInputSchema, typeof DeactivateCouponOutputSchema> {
+	readonly name = 'deactivate_coupon' as const
+	readonly inputSchema = DeactivateCouponInputSchema
+	readonly outputSchema = DeactivateCouponOutputSchema
+
+	constructor(private readonly couponRepo: CouponRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const coupon = await this.couponRepo.findById(input.couponId, tx)
+
+			if (!coupon || coupon.storeId.value !== input.storeId) {
+				throw new BaseError<ApplicationErrors>('COUPON_NOT_FOUND')
+			}
+
+			coupon.deactivate()
+
+			await this.couponRepo.save(coupon, tx)
+
+			await this.domainEventRepository.save(
+				new CouponDeactivatedEvent({
+					entityId: coupon.id.value,
+					ownerId: coupon.storeId.value,
+					payload: {
