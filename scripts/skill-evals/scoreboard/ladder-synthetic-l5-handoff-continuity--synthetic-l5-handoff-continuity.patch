+import { Repository } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { Coupon } from '../../entities/Coupon'
+
+export abstract class CouponRepository extends Repository<Coupon> {
+	abstract findById(id: string, tx?: Transaction): Promise<Coupon | undefined>
+	abstract findByCode(storeId: string, code: string, tx?: Transaction): Promise<Coupon | undefined>
+	abstract override save(entity: Coupon, tx?: Transaction): Promise<Coupon>
+	abstract override delete(id: string, tx?: Transaction): Promise<void>
+}
diff --git a/packages/api/typescript/src/sales/repositories/CouponRepository/DrizzleCouponRepository.ts b/packages/api/typescript/src/sales/repositories/CouponRepository/DrizzleCouponRepository.ts
new file mode 100644
index 000000000..fa2ceba48
--- /dev/null
+++ b/packages/api/typescript/src/sales/repositories/CouponRepository/DrizzleCouponRepository.ts
@@ -0,0 +1,101 @@
+import { injectable } from 'tsyringe-neo'
+import { and, eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { coupons } from '@template/contracts/db'
+import { Coupon } from '../../entities/Coupon'
+import { CouponStatus, CouponType } from '../../enums'
+import { CouponRepository } from './CouponRepository'
+
+@injectable()
+export class DrizzleCouponRepository extends CouponRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<Coupon | undefined> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient.select().from(coupons).where(eq(coupons.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async findByCode(storeId: string, code: string, tx?: DrizzleClient): Promise<Coupon | undefined> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient
+				.select()
+				.from(coupons)
+				.where(and(eq(coupons.storeId, storeId), eq(coupons.code, code)))
+				.limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async save(entity: Coupon, tx?: DrizzleClient): Promise<Coupon> {
+		entity.incrementVersion()
+		const dbClient = tx ?? this.db
+		const data = this.toPersistence(entity)
+		const result = await tryCatchAsync(async () => {
+			await dbClient
+				.insert(coupons)
+				.values(data)
+				.onConflictDoUpdate({
+					target: coupons.id,
+					set: {
+						code: data.code,
+						type: data.type,
+						status: data.status,
+						value: data.value,
+						expiresAt: data.expiresAt,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbClient = tx ?? this.db
+		await tryCatchAsync(async () => {
+			await dbClient.delete(coupons).where(eq(coupons.id, id))
+		})
+	}
+
+	private toDomain(row: typeof coupons.$inferSelect): Coupon {
+		return new Coupon({
+			id: row.id,
+			storeId: row.storeId,
+			code: row.code,
+			type: row.type as CouponType,
+			value: row.value,
+			status: row.status as CouponStatus,
+			expiresAt: row.expiresAt ?? undefined,
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: Coupon): typeof coupons.$inferInsert {
+		return {
+			id: entity.id.value,
+			storeId: entity.storeId.value,
+			code: entity.code,
+			type: entity.type,
+			status: entity.status,
+			value: entity.value,
+			expiresAt: entity.expiresAt ?? null,
+			createdAt: entity.createdAt,
+			updatedAt: entity.updatedAt,
+			version: entity.version,
+		}
+	}
+}
