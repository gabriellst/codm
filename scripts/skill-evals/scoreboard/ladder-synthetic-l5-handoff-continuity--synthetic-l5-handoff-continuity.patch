+import { injectable } from 'tsyringe-neo'
+import { Controller, HttpStatusCode, z } from '@template/core-typescript'
+import { AuthAccountMiddleware } from '@auth/middlewares/AuthAccountMiddleware'
+import { RequireStoreMember } from '@tenancy/middlewares/RequireStoreMember'
+import { DeactivateCoupon } from '../usecases/DeactivateCoupon'
+
+export const DeactivateCouponControllerInputSchema = z.object({
+	ctx: z.object({
+		user: z.object({ id: z.string() }),
+		session: z.object({ storeId: z.uuid() }),
+	}),
+	params: z.object({
+		couponId: z.uuid(),
+	}),
+})
+
+export const DeactivateCouponControllerOutputSchema = z.void()
+
+@injectable()
+export class DeactivateCouponController extends Controller<
+	typeof DeactivateCouponControllerInputSchema,
+	typeof DeactivateCouponControllerOutputSchema
+> {
+	readonly path = '/coupons/:couponId/deactivate'
+	readonly method = 'post' as const
+	readonly description = 'Deactivate a store-scoped coupon (US2 DeactivateCoupon)'
+	readonly inputSchema = DeactivateCouponControllerInputSchema
+	readonly outputSchema = DeactivateCouponControllerOutputSchema
+
+	override middlewares = [AuthAccountMiddleware, RequireStoreMember]
+
+	constructor(private cmd: DeactivateCoupon) {
+		super()
+	}
+
+	async handle(request: this['input']): Promise<this['output']> {
+		await this.cmd.execute({
+			storeId: request.ctx.session.storeId,
+			couponId: request.params.couponId,
+		})
+		return { status: HttpStatusCode.NO_CONTENT, data: undefined }
+	}
+}
