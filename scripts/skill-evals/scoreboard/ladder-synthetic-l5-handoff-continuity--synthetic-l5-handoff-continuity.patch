@@ -0,0 +1,70 @@
+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { Coupon } from '../entities/Coupon'
+import { CouponType } from '../enums'
+import { CouponCreatedEvent } from '../events'
+import { CouponRepository } from '../repositories/CouponRepository/CouponRepository'
+import type { ApplicationErrors } from '../errors'
+
+export const CreateCouponInputSchema = z.object({
+	storeId: z.uuid(),
+	code: z.string(),
+	type: z.enum(CouponType),
+	value: z.number().int(),
+	expiresAt: z.iso.datetime({ offset: true }).optional(),
+})
+
+export const CreateCouponOutputSchema = z.object({
+	couponId: z.uuid(),
+})
+
+@injectable()
+export class CreateCoupon extends Handler<typeof CreateCouponInputSchema, typeof CreateCouponOutputSchema> {
+	readonly name = 'create_coupon' as const
+	readonly inputSchema = CreateCouponInputSchema
+	readonly outputSchema = CreateCouponOutputSchema
+
+	constructor(private readonly couponRepo: CouponRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const code = input.code.trim().toUpperCase()
+
+			const existing = await this.couponRepo.findByCode(input.storeId, code, tx)
+			if (existing) {
+				throw new BaseError<ApplicationErrors>('COUPON_CODE_ALREADY_EXISTS')
+			}
+
+			const coupon = Coupon.create({
+				storeId: input.storeId,
+				code,
+				type: input.type,
+				value: input.value,
+				expiresAt: input.expiresAt,
+			})
+
+			await this.couponRepo.save(coupon, tx)
+
+			await this.domainEventRepository.save(
+				new CouponCreatedEvent({
+					entityId: coupon.id.value,
+					ownerId: coupon.storeId.value,
+					payload: {
+						couponId: coupon.id.value,
+						storeId: coupon.storeId.value,
+						code: coupon.code,
+						type: coupon.type,
+						value: coupon.value,
+						expiresAt: coupon.expiresAt?.toISOString(),
+					},
+				}),
+				tx,
+			)
+
+			return { couponId: coupon.id.value }
+		})
+	}
+}
diff --git a/packages/api/typescript/src/sales/usecases/DeactivateCoupon.ts b/packages/api/typescript/src/sales/usecases/DeactivateCoupon.ts
