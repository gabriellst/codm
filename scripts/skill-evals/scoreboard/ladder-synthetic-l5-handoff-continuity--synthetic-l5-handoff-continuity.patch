+import { injectable } from 'tsyringe-neo'
+import { Controller, HttpStatusCode, z } from '@template/core-typescript'
+import { AuthAccountMiddleware } from '@auth/middlewares/AuthAccountMiddleware'
+import { RequireStoreMember } from '@tenancy/middlewares/RequireStoreMember'
+import { CreateCoupon, CreateCouponInputSchema, CreateCouponOutputSchema } from '../usecases/CreateCoupon'
+
+export const CreateCouponControllerInputSchema = z.object({
+	ctx: z.object({
+		user: z.object({ id: z.string() }),
+		session: z.object({ storeId: z.uuid() }),
+	}),
+	body: CreateCouponInputSchema.omit({ storeId: true }),
+})
+
+export const CreateCouponControllerOutputSchema = CreateCouponOutputSchema
+
+@injectable()
+export class CreateCouponController extends Controller<
+	typeof CreateCouponControllerInputSchema,
+	typeof CreateCouponControllerOutputSchema
+> {
+	readonly path = '/coupons'
+	readonly method = 'post' as const
+	readonly description = 'Create a store-scoped discount coupon (US1 CreateCoupon)'
+	readonly inputSchema = CreateCouponControllerInputSchema
+	readonly outputSchema = CreateCouponControllerOutputSchema
+
+	override middlewares = [AuthAccountMiddleware, RequireStoreMember]
+
+	constructor(private cmd: CreateCoupon) {
+		super()
+	}
+
+	async handle(request: this['input']): Promise<this['output']> {
+		const data = await this.cmd.execute({
+			storeId: request.ctx.session.storeId,
+			code: request.body.code,
+			type: request.body.type,
+			value: request.body.value,
+			expiresAt: request.body.expiresAt,
+		})
+		return { status: HttpStatusCode.CREATED, data }
+	}
+}
