+/**
+ * `coupons` is the TS-owned write-side aggregate for store-scoped discount
+ * coupons (Sales BC, US1/US2). Text columns for type/status — house
+ * no-pgEnum convention. Uniqueness per (store_id, code) enforced by
+ * `coupons_store_id_code_unq` (case-insensitive normalisation happens in
+ * the use case before hitting the DB).
+ */
+export const coupons = salesSchema.table(
+	'coupons',
+	{
+		id: uuid('id').primaryKey(),
+		storeId: uuid('store_id').notNull(),
+		code: text('code').notNull(),
+		type: text('type').notNull(),
+		status: text('status').notNull(),
+		value: integer('value').notNull(),
+		expiresAt: timestamp('expires_at', { withTimezone: true }),
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		storeIdCodeUnq: uniqueIndex('coupons_store_id_code_unq').on(t.storeId, t.code),
+		storeIdIdx: index('coupons_store_id_idx').on(t.storeId),
+	}),
+)
