@@ -0,0 +1,40 @@
+import { injectable } from 'tsyringe-neo'
+import type { Transaction } from '@template/core-typescript'
+import { Coupon } from '../../entities/Coupon'
+import { CouponRepository } from './CouponRepository'
+
+@injectable()
+export class MockCouponRepository extends CouponRepository {
+	private store = new Map<string, Coupon>()
+
+	async findById(id: string, _tx?: Transaction): Promise<Coupon | undefined> {
+		return this.store.get(id)
+	}
+
+	async findByCode(storeId: string, code: string, _tx?: Transaction): Promise<Coupon | undefined> {
+		for (const coupon of this.store.values()) {
+			if (coupon.storeId.value === storeId && coupon.code === code) {
+				return coupon
+			}
+		}
+		return undefined
+	}
+
+	async save(entity: Coupon, _tx?: Transaction): Promise<Coupon> {
+		entity.incrementVersion()
+		this.store.set(entity.id.value, entity)
+		return entity
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.store.delete(id)
+	}
+
+	seed(entity: Coupon): void {
+		this.store.set(entity.id.value, entity)
+	}
+
+	clear(): void {
+		this.store.clear()
+	}
+}
