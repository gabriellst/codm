--- /dev/null
+++ b/packages/app/expo/app/(sheets)/kit-form/-stores/kit-form-store.ts
@@ -0,0 +1,41 @@
+// Route-private Zustand store for kit-form sheet.
+//
+// Responsibility:
+//   1. `pickerOpen` — drives the in-page ProductPicker overlay. Shared state
+//      because both KitItemEditor's product field AND the empty-items CTA can
+//      open it. Local `useState` would require prop-drilling; store keeps it
+//      accessible to any child without threading.
+//   2. `productNames` — maps productId → display name so KitItemRow can show
+//      names without a separate fetch. Populated when the user selects a
+//      product in ProductPicker.
+//
+// The screen calls `reset()` on unmount so picker state never survives the
+// sheet being dismissed and re-pushed (e.g. backgrounding the app).
+
+import { create } from 'zustand'
+
+interface KitFormState {
+	pickerOpen: boolean
+	productNames: Record<string, string>
+}
+
+interface KitFormActions {
+	setPickerOpen: (open: boolean) => void
+	addProductName: (id: string, name: string) => void
+	reset: () => void
+}
+
+type KitFormStore = KitFormState & KitFormActions
+
+const initialState: KitFormState = {
+	pickerOpen: false,
+	productNames: {},
+}
+
+export const useKitFormStore = create<KitFormStore>(set => ({
+	...initialState,
+	setPickerOpen: open => set({ pickerOpen: open }),
+	addProductName: (id, name) =>
+		set(s => ({ productNames: { ...s.productNames, [id]: name } })),
+	reset: () => set(initialState),
+}))
diff --git a/packages/app/expo/app/(sheets)/kit-form/-types.ts b/packages/app/expo/app/(sheets)/kit-form/-types.ts
new file mode 100644
index 000000000..1bb0270a0
--- /dev/null
+++ b/packages/app/expo/app/(sheets)/kit-form/-types.ts
@@ -0,0 +1,55 @@
+// Form schema = API mutation request PLUS UI-only fields that drive the
+// in-sheet item editor. Submit-time we re-parse with the bare API schema
+// to strip the UI fields before sending to the server.
+//
+// `KitForm` is exported as a TYPE only — `_inferKitForm` is a function
+// that is never invoked at runtime. Its presence lets every downstream
+// component type its `form` prop without restating TanStack Form's generic
+// arguments at every call site.
+
+import { z } from 'zod/v4'
+import { useForm } from '@tanstack/react-form'
+import {
+	createKitMutationRequestSchema,
+	QuantityModifierEnum,
+} from '@template/client-typescript/typescript'
+import type { DeepPartial } from '@/lib/types'
+
+/**
+ * null = add mode (editor is building a new item)
+ * number = edit mode for the item at that index in `items[]`
+ */
+const editingItemIndexSchema = z.number().int().nonnegative().nullable()
+
+export type EditingItemIndex = z.infer<typeof editingItemIndexSchema>
+
+/**
+ * Form schema = API payload + in-sheet editor draft.
+ * Validators run against this merged shape; submit-time we re-parse the
+ * API subset with `createKitMutationRequestSchema` to strip UI fields.
+ */
+export const kitFormSchema = createKitMutationRequestSchema.and(
+	z.object({
+		editingItemIndex: editingItemIndexSchema,
+		editorProductId: z.string().nullable(),
+		editorQuantity: z.number(),
+		editorQuantityModifier: z.enum([
+			QuantityModifierEnum.EQ,
+			QuantityModifierEnum.GT,
+			QuantityModifierEnum.GTE,
+			QuantityModifierEnum.LT,
+			QuantityModifierEnum.LTE,
+		]),
+	}),
+)
+
+export type KitFormData = z.infer<typeof kitFormSchema>
+
+function _inferKitForm() {
+	const defaults: DeepPartial<KitFormData> = {}
+	return useForm({
+		defaultValues: defaults,
+		validators: { onChange: kitFormSchema },
+	})
+}
+export type KitForm = ReturnType<typeof _inferKitForm>
