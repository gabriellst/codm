@@ -0,0 +1,189 @@
+// Item editor. Sits above the items list.
+// - Product field: Pressable that shows the selected product name and opens
+//   ProductPicker. Both the field AND the empty-items CTA open the same picker.
+// - Quantity: NumField (integer, min 1).
+// - Modifier: horizontal selector of all QuantityModifier values.
+// - Bottom area subscribes to a narrow slice and branches between:
+//     add mode  (editingItemIndex == null) → "Add item" button
+//     edit mode (editingItemIndex set)     → "Save item" + "Cancel" buttons
+//
+// Typing in the NumField updates editorQuantity in the form. KitItemRow's
+// primitive selector (0|1|2) is unaffected → rows do NOT re-render on keystrokes.
+
+import { Pressable, ScrollView, Text, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import {
+	QuantityModifierEnum,
+	type QuantityModifier,
+} from '@template/client-typescript/typescript'
+import { Button } from '@/components/ui/Button'
+import { NumField } from '@/components/ui/NumField'
+import { Eyebrow } from '@/components/ui/Eyebrow'
+import { useKitFormStore } from '@/app/(sheets)/kit-form/-stores/kit-form-store'
+import type { KitForm } from '@/app/(sheets)/kit-form/-types'
+
+interface KitItemEditorProps {
+	form: KitForm
+}
+
+export function KitItemEditor({ form }: KitItemEditorProps) {
+	const { t } = useTranslation()
+	const setPickerOpen = useKitFormStore(s => s.setPickerOpen)
+	const productNames = useKitFormStore(s => s.productNames)
+
+	const handleAddOrSave = () => {
+		const productId = form.getFieldValue('editorProductId')
+		const quantity = form.getFieldValue('editorQuantity')
+		const modifier = form.getFieldValue('editorQuantityModifier')
+		const editingIdx = form.getFieldValue('editingItemIndex')
+		const currentItems = (form.getFieldValue('items') as { productId: string; quantity: number; quantityModifier: QuantityModifier }[] | undefined) ?? []
+
+		if (!productId || !quantity) return
+
+		const newItem = {
+			productId,
+			quantity: quantity ?? 1,
+			quantityModifier: (modifier ?? QuantityModifierEnum.EQ) as QuantityModifier,
+		}
+
+		if (editingIdx != null) {
+			const updated = [...currentItems]
+			updated[editingIdx] = newItem
+			form.setFieldValue('items', updated)
+		} else {
+			form.setFieldValue('items', [...currentItems, newItem])
+		}
+
+		form.setFieldValue('editingItemIndex', null)
+		form.setFieldValue('editorProductId', null)
+		form.setFieldValue('editorQuantity', 1)
+		form.setFieldValue('editorQuantityModifier', QuantityModifierEnum.EQ)
+	}
+
+	const handleCancel = () => {
+		form.setFieldValue('editingItemIndex', null)
+		form.setFieldValue('editorProductId', null)
+		form.setFieldValue('editorQuantity', 1)
+		form.setFieldValue('editorQuantityModifier', QuantityModifierEnum.EQ)
+	}
+
+	return (
+		<View className="px-5 gap-3 mt-4 mb-2">
+			<Eyebrow>{t('kitForm.editor.eyebrow')}</Eyebrow>
+
+			{/* Product field */}
+			<form.Field name="editorProductId">
+				{field => (
+					<View className="gap-1.5">
+						<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+							{t('kitForm.editor.product.label')}
+						</Text>
+						<Pressable
+							onPress={() => setPickerOpen(true)}
+							accessibilityRole="button"
+							accessibilityLabel={t('kitForm.editor.product.label')}
+							className="h-12 px-4 rounded-lg border border-white/[0.12] bg-card items-center justify-start flex-row"
+						>
+							<Text
+								className={
+									field.state.value
+										? 'text-foreground font-sans-semi text-sm'
+										: 'text-foreground-disabled font-sans text-sm'
+								}
+								numberOfLines={1}
+							>
+								{field.state.value
+									? (productNames[field.state.value] ?? field.state.value)
+									: t('kitForm.editor.product.placeholder')}
+							</Text>
+						</Pressable>
+					</View>
+				)}
+			</form.Field>
+
+			{/* Quantity */}
+			<form.Field name="editorQuantity">
+				{field => (
+					<View className="items-start">
+						<NumField
+							label={t('kitForm.editor.quantity')}
+							value={field.state.value ?? 1}
+							onChange={field.handleChange}
+							step={1}
+							min={1}
+						/>
+					</View>
+				)}
+			</form.Field>
+
+			{/* Modifier selector */}
+			<form.Field name="editorQuantityModifier">
+				{field => (
+					<View className="gap-1.5">
+						<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+							{t('kitForm.editor.modifier')}
+						</Text>
+						<ScrollView
+							horizontal
+							showsHorizontalScrollIndicator={false}
+							contentContainerStyle={{ gap: 6 }}
+						>
+							{Object.values(QuantityModifierEnum).map(mod => {
+								const active = field.state.value === mod
+								return (
+									<Pressable
+										key={mod}
+										onPress={() => field.handleChange(mod)}
+										accessibilityRole="radio"
+										accessibilityState={{ checked: active }}
+										className={[
+											'px-3 py-2 rounded-md border',
+											active
+												? 'bg-muted/40 border-white/[0.32]'
+												: 'bg-card/30 border-white/[0.08]',
+										].join(' ')}
+									>
+										<Text
+											className={`font-sans-semi text-xs ${active ? 'text-foreground' : 'text-foreground-subtle'}`}
+										>
+											{t(`enums.QuantityModifier.${mod}`)}
+										</Text>
+									</Pressable>
+								)
+							})}
+						</ScrollView>
+					</View>
+				)}
+			</form.Field>
+
+			{/* Add / Save / Cancel */}
+			<form.Subscribe
+				selector={s => ({
+					hasProduct: s.values.editorProductId != null,
+					hasQuantity: (s.values.editorQuantity ?? 0) >= 1,
+					isEditing: s.values.editingItemIndex != null,
+				})}
+			>
+				{({ hasProduct, hasQuantity, isEditing }) => (
+					<View className="gap-2">
+						<Button
+							label={isEditing ? t('kitForm.editor.save') : t('kitForm.editor.add')}
+							variant="ghost"
+							fullWidth
+							disabled={!hasProduct || !hasQuantity}
+							onPress={handleAddOrSave}
+						/>
+						{isEditing ? (
+							<Button
+								label={t('kitForm.editor.cancel')}
+								variant="link"
+								fullWidth
+								onPress={handleCancel}
+							/>
+						) : null}
+					</View>
+				)}
+			</form.Subscribe>
+		</View>
+	)
+}
diff --git a/packages/app/expo/app/(sheets)/kit-form/-components/KitItemList/KitItemRow/index.tsx b/packages/app/expo/app/(sheets)/kit-form/-components/KitItemList/KitItemRow/index.tsx
new file mode 100644
index 000000000..174471b3c
--- /dev/null
+++ b/packages/app/expo/app/(sheets)/kit-form/-components/KitItemList/KitItemRow/index.tsx
@@ -0,0 +1,83 @@
+// 3-mode discriminant selector — keystone of the shared-form perf contract.
+//
+//   0 = no row selected for editing   (idle)
+//   1 = THIS row is selected          (highlight)
+//   2 = ANOTHER row is selected       (dim)
+//
+// The selector returns a NUMBER. TanStack Form's structural-equality check
+// only re-renders when the mode actually changes — typing in the editor's
+// NumField does NOT re-render every row.
+//
+// Pressing a row loads its values into the editor and sets editingItemIndex
+// (four batched setFieldValue calls collapse into one React 18 commit).
+
+import { Pressable, Text, View, type PressableProps } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import { QuantityModifierEnum, type QuantityModifier } from '@template/client-typescript/typescript'
+import { useKitFormStore } from '@/app/(sheets)/kit-form/-stores/kit-form-store'
+import type { KitForm } from '@/app/(sheets)/kit-form/-types'
+
+type KitItem = {
+	productId: string
+	quantity: number
+	quantityModifier: QuantityModifier
+}
+
+interface KitItemRowProps extends Omit<PressableProps, 'children' | 'onPress'> {
+	form: KitForm
+	item: KitItem
+	index: number
+}
+
+export function KitItemRow({ form, item, index, ...rest }: KitItemRowProps) {
+	const { t } = useTranslation()
+	const productName = useKitFormStore(s => s.productNames[item.productId] ?? item.productId)
+
+	const handleSelect = () => {
+		form.setFieldValue('editingItemIndex', index)
+		form.setFieldValue('editorProductId', item.productId)
+		form.setFieldValue('editorQuantity', item.quantity)
+		// Cast is safe: quantityModifier comes from the schema-validated form
+		form.setFieldValue('editorQuantityModifier', item.quantityModifier as (typeof QuantityModifierEnum)[keyof typeof QuantityModifierEnum])
+	}
+
+	return (
+		<form.Subscribe
+			selector={s => {
+				const idx = s.values.editingItemIndex
+				if (idx == null) return 0 as const
+				return idx === index ? (1 as const) : (2 as const)
+			}}
+		>
+			{mode => {
+				const isSelected = mode === 1
+				const isOtherEditing = mode === 2
+
+				return (
+					<Pressable
+						onPress={handleSelect}
+						accessibilityRole="button"
+						accessibilityLabel={t('kitForm.items.editRow', { name: productName })}
+						className={[
+							'flex-row items-center gap-2.5 py-3.5 px-3.5 border rounded-md mb-1.5',
+							isOtherEditing ? 'opacity-40' : '',
+							isSelected
+								? 'bg-muted/40 border-white/[0.32]'
+								: 'bg-card/30 border-white/[0.08]',
+						].join(' ')}
+						{...rest}
+					>
+						<View className="flex-1 gap-0.5">
+							<Text className="text-foreground font-sans-semi text-sm" numberOfLines={1}>
+								{productName}
+							</Text>
+							<Text className="text-foreground-subtle font-sans text-xs">
+								{t(`enums.QuantityModifier.${item.quantityModifier}`)} {item.quantity}
+							</Text>
+						</View>
+					</Pressable>
+				)
+			}}
+		</form.Subscribe>
+	)
+}
diff --git a/packages/app/expo/app/(sheets)/kit-form/-components/KitItemList/index.tsx b/packages/app/expo/app/(sheets)/kit-form/-components/KitItemList/index.tsx
