@@ -0,0 +1,65 @@
+// Kit items list. Renders confirmed items (not the live editor draft) via
+// KitItemRow. When empty, shows a call-to-action that opens ProductPicker —
+// the same picker the editor's product field opens.
+//
+// No subscription to editor fields: this component only subscribes to
+// `items` (the committed array), so typing in the editor's NumField never
+// causes this component to re-render.
+
+import { Text, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import type { QuantityModifier } from '@template/client-typescript/typescript'
+import { Button } from '@/components/ui/Button'
+import { Eyebrow } from '@/components/ui/Eyebrow'
+import { useKitFormStore } from '@/app/(sheets)/kit-form/-stores/kit-form-store'
+import type { KitForm } from '@/app/(sheets)/kit-form/-types'
+import { KitItemRow } from './KitItemRow'
+
+type KitItem = { productId: string; quantity: number; quantityModifier: QuantityModifier }
+function isKitItem(v: { productId?: string; quantity?: number; quantityModifier?: QuantityModifier }): v is KitItem {
+	return v.productId != null && v.quantity != null && v.quantityModifier != null
+}
+
+interface KitItemListProps {
+	form: KitForm
+}
+
+export function KitItemList({ form }: KitItemListProps) {
+	const { t } = useTranslation()
+	const setPickerOpen = useKitFormStore(s => s.setPickerOpen)
+
+	return (
+		<form.Subscribe selector={s => s.values.items ?? []}>
+			{items => (
+				<View className="px-5 gap-2">
+					<Eyebrow>{t('kitForm.items.eyebrow')}</Eyebrow>
+
+					{items.length === 0 ? (
+						<View className="py-6 items-center gap-3 border border-dashed border-white/[0.16] rounded-lg">
+							<Text className="text-foreground-subtle font-sans text-sm text-center">
+								{t('kitForm.items.empty')}
+							</Text>
+							<Button
+								label={t('kitForm.items.addCta')}
+								variant="ghost"
+								size="sm"
+								onPress={() => setPickerOpen(true)}
+							/>
+						</View>
+					) : (
+						<View>
+							{items.filter(isKitItem).map((item, index) => (
+								<KitItemRow
+									key={`${item.productId}-${index}`}
+									form={form}
+									item={item}
+									index={index}
+								/>
+							))}
+						</View>
+					)}
+				</View>
+			)}
+		</form.Subscribe>
+	)
+}
