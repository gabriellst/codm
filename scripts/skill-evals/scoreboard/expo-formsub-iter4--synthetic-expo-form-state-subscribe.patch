+import { useEffect } from 'react'
+import { Pressable, ScrollView, Text, View } from 'react-native'
+import { router } from 'expo-router'
+import { useForm } from '@tanstack/react-form'
+import { useQueryClient } from '@tanstack/react-query'
+import { Haptics } from 'react-native-nitro-haptics'
+import { useTranslation } from 'react-i18next'
+import { z } from 'zod'
+import {
+	useCreateKit,
+	createKitMutationRequestSchema,
+	listKitsQueryKey,
+	ProductCostTypeEnum,
+	QuantityModifierEnum,
+} from '@template/client-typescript/typescript'
+import { Protected } from '@/components/Protected'
+import { KeyboardAware } from '@/components/ui/KeyboardAware'
+import { Button } from '@/components/ui/Button'
+import { Input, InputGroup } from '@/components/ui/Input'
+import { NumField } from '@/components/ui/NumField'
+import { Eyebrow } from '@/components/ui/Eyebrow'
+import { surfaces } from '@/lib/tokens'
+import { useTypedSearchParams } from '@/lib/typed-route'
+import type { DeepPartial } from '@/lib/types'
+import { kitFormSchema, type KitFormData } from './-types'
+import { useKitFormStore } from './-stores/kit-form-store'
+import { KitItemEditor } from './-components/KitItemEditor'
+import { KitItemList } from './-components/KitItemList'
+import { ProductPicker } from './-components/ProductPicker'
+
+const searchSchema = z.object({
+	type: z
+		.enum([ProductCostTypeEnum.SINGLE, ProductCostTypeEnum.MULTIPLE])
+		.default(ProductCostTypeEnum.SINGLE),
+})
+
+export default function KitFormSheet() {
+	const { t } = useTranslation()
+	const queryClient = useQueryClient()
+	const createKit = useCreateKit()
+	const [{ type: typeParam }] = useTypedSearchParams(searchSchema)
+	const reset = useKitFormStore(s => s.reset)
+
+	// Reset store on unmount so picker state never survives the sheet being
+	// dismissed and re-pushed (backgrounding the app, deep links, etc.)
+	useEffect(() => {
+		return () => reset()
+	}, [reset])
+
+	const defaultValues: DeepPartial<KitFormData> = {
+		type: typeParam,
+		shipping: 0,
+		items: [],
+		editingItemIndex: null,
+		editorProductId: null,
+		editorQuantity: 1,
+		editorQuantityModifier: QuantityModifierEnum.EQ,
+	}
+
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: kitFormSchema },
+		onSubmit: async ({ value }) => {
+			const result = createKitMutationRequestSchema.safeParse({
+				name: value.name,
+				type: value.type,
+				shipping: value.shipping,
+				cost: value.cost,
+				items: value.items,
+			})
+			if (!result.success) return
+
+			await createKit.mutateAsync(
+				{ data: result.data },
+				{
+					onSuccess: () => {
+						Haptics.notification('success')
+						router.back()
+					},
+					onSettled: () =>
+						queryClient.invalidateQueries({ queryKey: listKitsQueryKey() }),
+				},
+			)
+		},
+	})
+
+	return (
+		<Protected>
+			<KeyboardAware style={{ backgroundColor: surfaces.surface1 }}>
+				<ScrollView
+					className="flex-1"
+					contentContainerStyle={{ paddingBottom: 32 }}
+					keyboardShouldPersistTaps="handled"
+				>
+					<View className="px-5 pt-6 pb-4">
+						<Eyebrow>{t('kitForm.eyebrow')}</Eyebrow>
+					</View>
+
+					{/* Kit name */}
+					<View className="px-5 mb-4">
+						<form.Field name="name">
+							{field => (
+								<View className="gap-1.5">
+									<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+										{t('kitForm.name.label')}
+									</Text>
+									<InputGroup>
+										<Input
+											value={field.state.value ?? ''}
+											onChangeText={field.handleChange}
+											onBlur={field.handleBlur}
+											placeholder={t('kitForm.name.placeholder')}
+											accessibilityLabel={t('kitForm.name.label')}
+										/>
+									</InputGroup>
+									{field.state.meta.isTouched && !field.state.meta.isValid ? (
+										<Text className="text-destructive text-xs font-sans">
+											{field.state.meta.errors.join(', ')}
+										</Text>
+									) : null}
+								</View>
+							)}
+						</form.Field>
+					</View>
+
+					{/* Kit type selector */}
+					<View className="px-5 mb-4">
+						<form.Field name="type">
+							{field => (
+								<View className="gap-1.5">
+									<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+										{t('kitForm.type.label')}
+									</Text>
+									<View className="flex-row gap-2">
+										{Object.values(ProductCostTypeEnum).map(v => {
+											const active = field.state.value === v
+											return (
+												<Pressable
+													key={v}
+													onPress={() => field.handleChange(v)}
+													accessibilityRole="radio"
+													accessibilityState={{ checked: active }}
+													className={[
+														'flex-1 py-3 rounded-md items-center border',
+														active
+															? 'bg-popover border-white/[0.32]'
+															: 'bg-card border-white/[0.08]',
+													].join(' ')}
+												>
+													<Text
+														className={`font-sans-semi text-xs uppercase ${active ? 'text-foreground' : 'text-foreground-subtle'}`}
+													>
+														{t(`enums.ProductCostType.${v}`)}
+													</Text>
+												</Pressable>
+											)
+										})}
+									</View>
+								</View>
+							)}
+						</form.Field>
+					</View>
+
+					{/* Shipping + optional extra cost */}
+					<View className="px-5 flex-row gap-3 mb-4">
+						<form.Field name="shipping">
+							{field => (
+								<View className="flex-1">
+									<NumField
+										label={t('kitForm.shipping.label')}
+										value={field.state.value ?? 0}
+										onChange={field.handleChange}
+										step={0.01}
+										min={0}
+									/>
+								</View>
+							)}
+						</form.Field>
+						<form.Field name="cost">
+							{field => (
+								<View className="flex-1">
+									<NumField
+										label={t('kitForm.cost.label')}
+										value={field.state.value ?? 0}
+										onChange={field.handleChange}
+										step={0.01}
+										min={0}
+									/>
+								</View>
+							)}
+						</form.Field>
+					</View>
+
+					{/* Item editor (above the list, per spec) */}
+					<KitItemEditor form={form} />
+
+					{/* Committed items list */}
+					<KitItemList form={form} />
+
+					{/* Submit */}
+					<View className="px-5 pt-6">
+						<form.Subscribe
+							selector={s => ({ isSubmitting: s.isSubmitting, values: s.values })}
+						>
+							{({ isSubmitting, values }) => {
+								const apiCheck = createKitMutationRequestSchema.safeParse({
+									name: values.name,
+									type: values.type,
+									shipping: values.shipping,
+									cost: values.cost,
+									items: values.items,
+								})
+								const isDisabled =
+									isSubmitting || createKit.isPending || !apiCheck.success
+								return (
+									<Button
+										label={t('kitForm.submit')}
+										fullWidth
+										onPress={() => void form.handleSubmit()}
+										disabled={isDisabled}
+									/>
+								)
+							}}
+						</form.Subscribe>
+					</View>
+				</ScrollView>
+
+				{/* In-page product picker overlay — rendered as a Modal so it floats
+				    above the scroll content without changing the URL */}
+				<ProductPicker form={form} />
+			</KeyboardAware>
+		</Protected>
+	)
+}
