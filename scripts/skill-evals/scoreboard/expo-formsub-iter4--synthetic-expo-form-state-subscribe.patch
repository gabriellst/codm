@@ -0,0 +1,75 @@
+// In-page product picker overlay. Rendered as an in-page Sheet primitive
+// (no URL change). Opened by KitItemEditor's product field or the
+// empty-items CTA. Visibility lives in useKitFormStore so both openers can
+// toggle it without prop-drilling.
+//
+// When the user taps a row:
+//   1. Sets `editorProductId` on the shared form instance.
+//   2. Caches the product name in the store so KitItemRow can display it.
+//   3. Closes the sheet.
+
+import { FlatList, Pressable, Text, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import { useListProductsForKit } from '@template/client-typescript/typescript'
+import { Sheet } from '@/components/ui/Sheet'
+import { formatMoney } from '@/lib/format'
+import type { KitForm } from '@/app/(sheets)/kit-form/-types'
+import { useKitFormStore } from '@/app/(sheets)/kit-form/-stores/kit-form-store'
+
+interface ProductPickerProps {
+	form: KitForm
+}
+
+export function ProductPicker({ form }: ProductPickerProps) {
+	const { t } = useTranslation()
+	const pickerOpen = useKitFormStore(s => s.pickerOpen)
+	const setPickerOpen = useKitFormStore(s => s.setPickerOpen)
+	const addProductName = useKitFormStore(s => s.addProductName)
+	const { data } = useListProductsForKit()
+
+	const handleSelect = (id: string, name: string) => {
+		form.setFieldValue('editorProductId', id)
+		addProductName(id, name)
+		setPickerOpen(false)
+	}
+
+	return (
+		<Sheet
+			open={pickerOpen}
+			onClose={() => setPickerOpen(false)}
+			title={t('kitForm.picker.title')}
+			size="tall"
+		>
+			<FlatList
+				data={data?.items ?? []}
+				keyExtractor={item => item.id}
+				showsVerticalScrollIndicator={false}
+				renderItem={({ item }) => (
+					<Pressable
+						onPress={() => handleSelect(item.id, item.name)}
+						accessibilityRole="button"
+						accessibilityLabel={item.name}
+						className="flex-row items-center justify-between py-3 border-b border-white/[0.06]"
+					>
+						<View className="flex-1 gap-0.5">
+							<Text className="text-foreground font-sans-semi text-sm" numberOfLines={1}>
+								{item.name}
+							</Text>
+							{item.sku ? (
+								<Text className="text-foreground-subtle font-sans text-xs">{item.sku}</Text>
+							) : null}
+						</View>
+						<Text className="text-muted-foreground font-sans-semi text-sm ml-3">
+							{formatMoney(item.currentCost.amountCents / 100, item.currentCost.currency)}
+						</Text>
+					</Pressable>
+				)}
+				ListEmptyComponent={
+					<View className="py-8 items-center">
+						<Text className="text-foreground-subtle font-sans text-sm">{t('common.loading')}</Text>
+					</View>
+				}
+			/>
+		</Sheet>
+	)
+}
diff --git a/packages/app/expo/app/(sheets)/kit-form/-stores/kit-form-store.ts b/packages/app/expo/app/(sheets)/kit-form/-stores/kit-form-store.ts
