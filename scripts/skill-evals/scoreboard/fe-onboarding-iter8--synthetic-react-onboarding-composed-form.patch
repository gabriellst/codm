+import { create } from 'zustand'
+import type { ConnectionMode } from '@template/client-typescript/typescript'
+import { ConnectionModeEnum } from '@template/client-typescript/typescript'
+
+interface OnboardingWizardStore {
+	stepIndex: number
+	mode: ConnectionMode
+	setStepIndex: (index: number) => void
+	setMode: (mode: ConnectionMode) => void
+	reset: () => void
+}
+
+export const useOnboardingWizardStore = create<OnboardingWizardStore>()(set => ({
+	stepIndex: 0,
+	mode: ConnectionModeEnum.CREDENTIALS,
+	setStepIndex: stepIndex => set({ stepIndex }),
+	setMode: mode => set({ mode }),
+	reset: () => set({ stepIndex: 0, mode: ConnectionModeEnum.CREDENTIALS }),
+}))
