+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { connectIntegrationMutationRequestSchema } from '@template/client-typescript/typescript'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import { IconArrowLeft } from '@tabler/icons-react'
+import type { ConnectForm } from '../ConnectWizard'
+import { cn } from '@/lib/utils'
+
+interface ReviewStepProps extends ComponentProps<'div'> {
+	form: ConnectForm
+	onFinish: () => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+export function ReviewStep({ form, onFinish, onBack, isSubmitting, className, ...props }: ReviewStepProps) {
+	const { t } = useTranslation()
+
+	return (
+		<div {...props} className={cn('flex w-full max-w-lg flex-col gap-8', className)}>
+			<div>
+				<h2 className="text-xl font-semibold tracking-tight">{t('onboarding.review.title')}</h2>
+				<p className="text-muted-foreground mt-1 text-sm">{t('onboarding.review.subtitle')}</p>
+			</div>
+
+			{/* Live summary driven by the accumulated parent form — reactive via form.Subscribe */}
+			<form.Subscribe selector={s => s.values}>
+				{values => {
+					const v = values as {
+						connectionMode?: string
+						type?: string
+						platform?: string
+						credentials?: Record<string, string>
+					}
+
+					// Gate the connect button: validate the full union (FRM-P43).
+					// Parsing the union directly avoids as-never casts — any member that matches is accepted.
+					const isValid = connectIntegrationMutationRequestSchema.safeParse(values).success
+
+					const credentialEntries = v.credentials ? Object.entries(v.credentials) : []
+
+					return (
+						<>
+							<dl className="divide-border divide-y rounded-xl border">
+								{v.platform && (
+									<div className="flex justify-between px-4 py-3 text-sm">
+										<dt className="text-muted-foreground">{t('onboarding.review.platform')}</dt>
+										<dd className="font-medium">{v.platform}</dd>
+									</div>
+								)}
+								{v.type && (
+									<div className="flex justify-between px-4 py-3 text-sm">
+										<dt className="text-muted-foreground">{t('onboarding.review.type')}</dt>
+										<dd className="font-medium">{v.type}</dd>
+									</div>
+								)}
+								{v.connectionMode && (
+									<div className="flex justify-between px-4 py-3 text-sm">
+										<dt className="text-muted-foreground">{t('onboarding.review.connectionMode')}</dt>
+										<dd className="font-medium">{v.connectionMode}</dd>
+									</div>
+								)}
+								<div className="px-4 py-3 text-sm">
+									<dt className="text-muted-foreground mb-2">{t('onboarding.review.credentials')}</dt>
+									{credentialEntries.length > 0 ? (
+										<dd className="flex flex-col gap-1">
+											{credentialEntries.map(([key, val]) => (
+												<div key={key} className="flex justify-between">
+													<span className="text-muted-foreground">{key}</span>
+													<span className="font-medium">{`${val ? '••••••' : '—'}`}</span>
+												</div>
+											))}
+										</dd>
+									) : (
+										<dd className="text-muted-foreground italic">{t('onboarding.review.noCredentials')}</dd>
+									)}
+								</div>
+							</dl>
+
+							<div className="flex justify-between">
+								<div>
+									{onBack && (
+										<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+											<IconArrowLeft className="mr-1 size-4" />
+											{t('common.back')}
+										</Button>
+									)}
+								</div>
+								<Button type="button" disabled={!isValid || isSubmitting} onClick={onFinish}>
+									{isSubmitting && <Spinner className="mr-2" />}
+									{t('onboarding.review.connect')}
+								</Button>
+							</div>
+						</>
+					)
+				}}
+			</form.Subscribe>
+		</div>
+	)
+}
