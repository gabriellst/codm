+import type { ComponentProps, ComponentType } from 'react'
+import { useForm } from '@tanstack/react-form'
+import { useTranslation } from 'react-i18next'
+import type { z } from 'zod/v4'
+import { connectIntegrationMutationRequestSchema } from '@template/client-typescript/typescript'
+import { pickUnionVariantField } from '@/lib/union'
+import { type DeepPartial } from '@/lib'
+import { Field, FieldLabel, FieldError, FieldGroup } from '@/components/ui/field'
+import { Input } from '@/components/ui/input'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import { IconArrowRight, IconArrowLeft } from '@tabler/icons-react'
+import type { OnboardingTarget } from '../TargetStep'
+import { cn } from '@/lib/utils'
+
+// ─── Per-platform credential schemas — extracted once from the SDK union (FRM-P44) ─────────
+const shopifyCredentialsSchema = pickUnionVariantField(
+	connectIntegrationMutationRequestSchema,
+	{ platform: 'SHOPIFY', connectionMode: 'CREDENTIALS' },
+	'credentials',
+)
+const yampiCredentialsSchema = pickUnionVariantField(
+	connectIntegrationMutationRequestSchema,
+	{ platform: 'YAMPI', connectionMode: 'CREDENTIALS' },
+	'credentials',
+)
+
+type ShopifyCredentials = z.infer<typeof shopifyCredentialsSchema>
+type YampiCredentials = z.infer<typeof yampiCredentialsSchema>
+
+// ─── Shared inner-form props — onCredentials receives the validated credentials object ──────
+interface InnerFormProps {
+	onCredentials: (credentials: Record<string, string>) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+// ─── Shopify credentials form ─────────────────────────────────────────────────────────────
+function ShopifyCredentialsFields({ onCredentials, onBack, isSubmitting }: InnerFormProps) {
+	const { t } = useTranslation()
+	const defaultValues: DeepPartial<ShopifyCredentials> = { shopDomain: '', clientId: '', clientSecret: '' }
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: shopifyCredentialsSchema },
+		onSubmit: async ({ value }) => {
+			const result = shopifyCredentialsSchema.safeParse(value)
+			if (!result.success) return
+			onCredentials(result.data as Record<string, string>)
+		},
+	})
+	return (
+		<form
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+			className="flex flex-col gap-6"
+		>
+			<FieldGroup>
+				<form.Field name="shopDomain">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.shopDomain')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									placeholder={t('onboarding.credentials.shopDomainPlaceholder')}
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+				<form.Field name="clientId">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.clientId')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									placeholder={t('onboarding.credentials.clientIdPlaceholder')}
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+				<form.Field name="clientSecret">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.clientSecret')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="password"
+									autoComplete="new-password"
+									placeholder={t('onboarding.credentials.clientSecretPlaceholder')}
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+			</FieldGroup>
+			<form.Subscribe selector={s => ({ canSubmit: s.canSubmit, isSubmitting: s.isSubmitting, values: s.values })}>
+				{({ canSubmit, isSubmitting: formPending, values }) => {
+					const isPending = isSubmitting || formPending
+					const isDisabled = !canSubmit || isPending || !shopifyCredentialsSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<div>
+								{onBack && (
+									<Button type="button" variant="outline" onClick={onBack} disabled={isPending}>
+										<IconArrowLeft className="mr-1 size-4" />
+										{t('common.back')}
+									</Button>
+								)}
+							</div>
+							<Button type="submit" disabled={isDisabled}>
+								{isPending && <Spinner className="mr-2" />}
+								{t('common.next')}
+								<IconArrowRight className="ml-1 size-4" />
+							</Button>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+// ─── Yampi credentials form ───────────────────────────────────────────────────────────────
+function YampiCredentialsFields({ onCredentials, onBack, isSubmitting }: InnerFormProps) {
+	const { t } = useTranslation()
+	const defaultValues: DeepPartial<YampiCredentials> = { alias: '', userToken: '', userSecretKey: '' }
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: yampiCredentialsSchema },
+		onSubmit: async ({ value }) => {
+			const result = yampiCredentialsSchema.safeParse(value)
+			if (!result.success) return
+			onCredentials(result.data as Record<string, string>)
+		},
+	})
+	return (
+		<form
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+			className="flex flex-col gap-6"
+		>
+			<FieldGroup>
+				<form.Field name="alias">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.alias')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									placeholder={t('onboarding.credentials.aliasPlaceholder')}
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+				<form.Field name="userToken">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.userToken')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									placeholder={t('onboarding.credentials.userTokenPlaceholder')}
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+				<form.Field name="userSecretKey">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.userSecretKey')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="password"
+									autoComplete="new-password"
+									placeholder={t('onboarding.credentials.userSecretKeyPlaceholder')}
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+			</FieldGroup>
+			<form.Subscribe selector={s => ({ canSubmit: s.canSubmit, isSubmitting: s.isSubmitting, values: s.values })}>
+				{({ canSubmit, isSubmitting: formPending, values }) => {
+					const isPending = isSubmitting || formPending
+					const isDisabled = !canSubmit || isPending || !yampiCredentialsSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<div>
+								{onBack && (
+									<Button type="button" variant="outline" onClick={onBack} disabled={isPending}>
+										<IconArrowLeft className="mr-1 size-4" />
+										{t('common.back')}
+									</Button>
+								)}
+							</div>
+							<Button type="submit" disabled={isDisabled}>
+								{isPending && <Spinner className="mr-2" />}
+								{t('common.next')}
+								<IconArrowRight className="ml-1 size-4" />
+							</Button>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+// ─── Platform dispatch map (CMP-P18 — map, not a switch/if chain) ─────────────────────────
+const PLATFORM_CREDENTIAL_FORMS: Partial<Record<OnboardingTarget['platform'], ComponentType<InnerFormProps>>> = {
+	SHOPIFY: ShopifyCredentialsFields,
+	YAMPI: YampiCredentialsFields,
+}
+
+// ─── CredentialsStep — outer shell that dispatches by platform ────────────────────────────
+interface CredentialsStepProps extends Omit<ComponentProps<'div'>, 'onSubmit'> {
+	target: OnboardingTarget
+	onSubmit: (data: { credentials: Record<string, string> }) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+export function CredentialsStep({ target, onSubmit, onBack, isSubmitting, className, ...props }: CredentialsStepProps) {
+	const { t } = useTranslation()
+	const PlatformForm = PLATFORM_CREDENTIAL_FORMS[target.platform]
+
+	const handleCredentials = (credentials: Record<string, string>) => {
+		onSubmit({ credentials })
+	}
+
+	return (
+		<div {...props} className={cn('flex w-full max-w-lg flex-col gap-8', className)}>
+			<div>
+				<h2 className="text-xl font-semibold tracking-tight">{t('onboarding.credentials.title')}</h2>
+				<p className="text-muted-foreground mt-1 text-sm">{t('onboarding.credentials.subtitle')}</p>
+			</div>
+			{PlatformForm ? (
+				<PlatformForm onCredentials={handleCredentials} onBack={onBack} isSubmitting={isSubmitting} />
+			) : null}
+		</div>
+	)
+}
