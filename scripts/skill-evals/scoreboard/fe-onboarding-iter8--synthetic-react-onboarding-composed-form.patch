diff --git a/packages/app/react/src/routes/onboarding/-components/ConnectWizard/index.tsx b/packages/app/react/src/routes/onboarding/-components/ConnectWizard/index.tsx
new file mode 100644
index 000000000..74e5d5924
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/ConnectWizard/index.tsx
@@ -0,0 +1,152 @@
+// SEEDED CANONICAL SPINE — complete the TODOs; do NOT rewrite or delete this file.
+// The _infer typing, sequence Record, setFieldValue merging and union-parse gate
+// are the measured-canonical machinery (form FRM-P13/15/18/43).
+import { useState, type ComponentProps, type ReactNode } from 'react'
+import { useForm } from '@tanstack/react-form'
+import { useNavigate } from '@tanstack/react-router'
+import { useQueryClient } from '@tanstack/react-query'
+import { toast } from 'sonner'
+import {
+	connectIntegrationMutationRequestSchema,
+	ConnectionModeEnum,
+	type ConnectionMode,
+	useConnectIntegration,
+	listIntegrationsQueryKey,
+} from '@template/client-typescript/typescript'
+import { cn } from '@/lib/utils'
+import { useTranslation } from 'react-i18next'
+import { ConnectionModeStep, type ConnectionModeStepData } from '../ConnectionModeStep'
+import { TargetStep, type OnboardingTarget } from '../TargetStep'
+import { CredentialsStep } from '../CredentialsStep'
+import { ReviewStep } from '../ReviewStep'
+
+// ─── Step sequences — const-asserted tuples in an enum-keyed map (FRM-P13) ──────────────
+const CREDENTIALS_STEPS = ['CONNECTION_MODE', 'TARGET', 'CREDENTIALS', 'REVIEW'] as const
+const MANUAL_STEPS = ['CONNECTION_MODE', 'TARGET', 'REVIEW'] as const
+
+export type ConnectStepId = (typeof CREDENTIALS_STEPS)[number] | (typeof MANUAL_STEPS)[number]
+
+const STEP_SEQUENCES: Record<ConnectionMode, readonly ConnectStepId[]> = {
+	[ConnectionModeEnum.CREDENTIALS]: CREDENTIALS_STEPS,
+	[ConnectionModeEnum.MANUAL]: MANUAL_STEPS,
+	[ConnectionModeEnum.OAUTH]: MANUAL_STEPS, // OAuth not in the onboarding 4 — fallback to manual flow
+}
+
+// ─── Accumulated form shape (FRM-P18) ────────────────────────────────────────────────────
+// A flat typed interface for the wizard accumulator — each step sets its own fields via
+// form.setFieldValue with no casts. The union schema validates the full payload at submit.
+interface ConnectFormValues {
+	type?: string
+	platform?: string
+	connectionMode?: string
+	credentials?: Record<string, string>
+}
+
+// An UNCALLED function wrapping useForm: its ReturnType IS the typed form instance —
+// never hand-write an interface of field names.
+function _inferConnectForm() {
+	return useForm({
+		defaultValues: {} as ConnectFormValues,
+	})
+}
+export type ConnectForm = ReturnType<typeof _inferConnectForm>
+
+// ─── ConnectWizard — bp-20: extends ComponentProps<'main'> so callers can thread className ─
+export function ConnectWizard({ className, ...props }: ComponentProps<'main'>) {
+	const { t } = useTranslation()
+	const navigate = useNavigate()
+	const queryClient = useQueryClient()
+	const [stepIndex, setStepIndex] = useState(0)
+	const [mode, setMode] = useState<ConnectionMode>(ConnectionModeEnum.CREDENTIALS)
+
+	const connect = useConnectIntegration({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('onboarding.toast.success'), { description: t('onboarding.toast.successDescription') })
+				queryClient.invalidateQueries({ queryKey: listIntegrationsQueryKey() })
+				resetWizard()
+				void navigate({ to: '/' })
+			},
+		},
+	})
+
+	const form = _inferConnectForm()
+	const sequence = STEP_SEQUENCES[mode]
+	const stepId = sequence[stepIndex] ?? sequence[0]
+
+	function resetWizard() {
+		setStepIndex(0)
+		setMode(ConnectionModeEnum.CREDENTIALS)
+		form.reset()
+	}
+
+	// CONNECTION_MODE — updates the sequence selector AND merges the field (FRM-P15)
+	function handleConnectionModeSubmit(data: ConnectionModeStepData) {
+		const newMode = data.connectionMode as ConnectionMode
+		setMode(newMode)
+		form.setFieldValue('connectionMode', data.connectionMode)
+		if (stepIndex < STEP_SEQUENCES[newMode].length - 1) setStepIndex(i => i + 1)
+	}
+
+	// TARGET — merges the full discriminant triple into the accumulator
+	function handleTargetSubmit(target: OnboardingTarget) {
+		form.setFieldValue('type', target.type)
+		form.setFieldValue('platform', target.platform)
+		form.setFieldValue('connectionMode', target.connectionMode)
+		if (stepIndex < sequence.length - 1) setStepIndex(i => i + 1)
+	}
+
+	// CREDENTIALS — merges the platform credentials slice
+	function handleCredentialsSubmit(data: { credentials: Record<string, string> }) {
+		form.setFieldValue('credentials', data.credentials)
+		if (stepIndex < sequence.length - 1) setStepIndex(i => i + 1)
+	}
+
+	function handleBack() {
+		setStepIndex(i => Math.max(0, i - 1))
+	}
+
+	// REVIEW / FINISH — gate through the full union schema (FRM-P43). safeParse does not throw;
+	// no try/catch needed. Any member that matches the accumulated values is accepted.
+	function handleFinish() {
+		const parsed = connectIntegrationMutationRequestSchema.safeParse(form.state.values)
+		if (!parsed.success) return
+		void connect.mutateAsync({ data: parsed.data })
+	}
+
+	// Step dispatch by map — never a switch chain (CMP-P18). CREDENTIALS reads the
+	// accumulated platform from form state so CredentialsStep gets the right schema branch.
+	const credentialsNode = (() => {
+		const vals = form.state.values
+		if (!vals.platform || !vals.type || !vals.connectionMode) return null
+		const target: OnboardingTarget = { platform: vals.platform, type: vals.type, connectionMode: vals.connectionMode } as OnboardingTarget
+		return (
+			<CredentialsStep
+				target={target}
+				onSubmit={handleCredentialsSubmit}
+				onBack={handleBack}
+				isSubmitting={connect.isPending}
+			/>
+		)
+	})()
+
+	const STEP_COMPONENTS: Record<ConnectStepId, ReactNode> = {
+		CONNECTION_MODE: (
+			<ConnectionModeStep onSubmit={handleConnectionModeSubmit} isSubmitting={connect.isPending} />
+		),
+		TARGET: (
+			<TargetStep mode={mode} onSubmit={handleTargetSubmit} onBack={handleBack} isSubmitting={connect.isPending} />
+		),
+		CREDENTIALS: credentialsNode,
+		REVIEW: <ReviewStep form={form} onFinish={handleFinish} onBack={handleBack} isSubmitting={connect.isPending} />,
+	}
+
+	return (
+		<main
+			className={cn('flex min-h-dvh flex-col items-center justify-center px-4 py-16', className)}
+			{...props}
+		>
+			{STEP_COMPONENTS[stepId]}
+		</main>
+	)
+}
diff --git a/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx b/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx
new file mode 100644
index 000000000..229c8a5a1
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx
@@ -0,0 +1,119 @@
+import type { ComponentProps } from 'react'
+import { useForm } from '@tanstack/react-form'
+import { Button } from '@/components/ui/button'
+import { Field, FieldLabel, FieldError, FieldGroup } from '@/components/ui/field'
+import { ToggleGroup } from '@/components/ui/toggle-group'
+import { type DeepPartial } from '@/lib'
+import { connectIntegrationMutationRequestSchema, ConnectionModeEnum, type ConnectionMode } from '@template/client-typescript/typescript'
+import { unionVariantValues } from '@/lib/union'
+import { IconArrowRight, IconArrowLeft } from '@tabler/icons-react'
+import { Spinner } from '@/components/ui/spinner'
+import { useTranslation } from 'react-i18next'
+import { z } from 'zod/v4'
+import { cn } from '@/lib/utils'
+
+// Derive allowed connectionMode values from the union — onboarding exposes CREDENTIALS + MANUAL
+const modeValues = unionVariantValues(connectIntegrationMutationRequestSchema, 'connectionMode') as [string, ...string[]]
+export const ConnectionModeStepSchema = z.object({ connectionMode: z.enum(modeValues) })
+
+type ConnectionModeStepData = (typeof ConnectionModeStepSchema)['_zod']['output']
+
+interface ConnectionModeStepProps extends Omit<ComponentProps<'form'>, 'onSubmit'> {
+	defaultValues?: DeepPartial<ConnectionModeStepData>
+	onSubmit: (data: ConnectionModeStepData) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+// The onboarding targets only use CREDENTIALS and MANUAL (not OAUTH)
+const ONBOARDING_MODES: ConnectionMode[] = [ConnectionModeEnum.CREDENTIALS, ConnectionModeEnum.MANUAL]
+
+export function ConnectionModeStep({ defaultValues, onSubmit, onBack, isSubmitting, className, ...props }: ConnectionModeStepProps) {
+	const { t } = useTranslation()
+
+	const form = useForm({
+		defaultValues: defaultValues ?? {},
+		validators: { onChange: ConnectionModeStepSchema },
+		onSubmit: async form => {
+			const result = ConnectionModeStepSchema.safeParse(form.value)
+			if (!result.success) return
+			onSubmit(result.data)
+		},
+	})
+
+	return (
+		<form
+			{...props}
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+			className={cn('flex w-full max-w-lg flex-col gap-8', className)}
+		>
+			<div className="text-center">
+				<h1 className="text-3xl font-bold tracking-tight">{t('onboarding.welcome.title')}</h1>
+				<p className="text-muted-foreground mt-2">{t('onboarding.welcome.subtitle')}</p>
+			</div>
+
+			<div>
+				<h2 className="mb-1 text-lg font-semibold">{t('onboarding.connectionMode.title')}</h2>
+				<p className="text-muted-foreground mb-4 text-sm">{t('onboarding.connectionMode.subtitle')}</p>
+
+				<FieldGroup>
+					<form.Field name="connectionMode">
+						{field => {
+							const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+							return (
+								<Field>
+									<FieldLabel htmlFor={field.name} className="sr-only">
+										{t('onboarding.connectionMode.title')}
+									</FieldLabel>
+									<ToggleGroup
+										enum={ConnectionModeEnum}
+										i18nPrefix="enums.ConnectionMode"
+										values={ONBOARDING_MODES}
+										value={field.state.value as ConnectionMode | undefined}
+										onValueChange={v => field.handleChange(v)}
+										orientation="vertical"
+										id={field.name}
+										aria-invalid={isInvalid}
+										className="w-full"
+									/>
+									{isInvalid && <FieldError errors={field.state.meta.errors} />}
+								</Field>
+							)
+						}}
+					</form.Field>
+				</FieldGroup>
+			</div>
+
+			<form.Subscribe selector={state => ({ canSubmit: state.canSubmit, values: state.values })}>
+				{({ canSubmit, values }) => {
+					const isDisabled = isSubmitting || !canSubmit || !ConnectionModeStepSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<div>
+								{onBack && (
+									<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+										<IconArrowLeft className="mr-1 size-4" />
+										{t('common.back')}
+									</Button>
+								)}
+							</div>
+							<div className="flex gap-2">
+								<Button type="submit" disabled={isDisabled}>
+									{isSubmitting && <Spinner className="mr-2" />}
+									{t('common.next')}
+									<IconArrowRight className="ml-1 size-4" />
+								</Button>
+							</div>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+export type { ConnectionModeStepData }
