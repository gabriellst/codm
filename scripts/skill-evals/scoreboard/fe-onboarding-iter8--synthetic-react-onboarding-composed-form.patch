+import { useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Button } from '@/components/ui/button'
+import { IconArrowRight, IconArrowLeft } from '@tabler/icons-react'
+import type { ComponentProps } from 'react'
+import type { ConnectionMode } from '@template/client-typescript/typescript'
+import { cn } from '@/lib/utils'
+
+// The 4 fixed onboarding targets — each encodes its own discriminant triple
+const ONBOARDING_TARGETS = [
+	{ platform: 'SHOPIFY', type: 'SALES_CHANNEL', connectionMode: 'CREDENTIALS' },
+	{ platform: 'YAMPI', type: 'CHECKOUT', connectionMode: 'CREDENTIALS' },
+	{ platform: 'META', type: 'MARKETING_PLATFORM', connectionMode: 'MANUAL' },
+	{ platform: 'MERCADOPAGO', type: 'PAYMENT_GATEWAY', connectionMode: 'MANUAL' },
+] as const
+
+export type OnboardingTarget = (typeof ONBOARDING_TARGETS)[number]
+
+// Static as-const map so t() receives literal key types, not a template expression (bp-25)
+const TARGET_COPY = {
+	SHOPIFY: { nameKey: 'onboarding.target.SHOPIFY.name', descriptionKey: 'onboarding.target.SHOPIFY.description' },
+	YAMPI: { nameKey: 'onboarding.target.YAMPI.name', descriptionKey: 'onboarding.target.YAMPI.description' },
+	META: { nameKey: 'onboarding.target.META.name', descriptionKey: 'onboarding.target.META.description' },
+	MERCADOPAGO: { nameKey: 'onboarding.target.MERCADOPAGO.name', descriptionKey: 'onboarding.target.MERCADOPAGO.description' },
+} as const
+
+interface TargetStepProps extends Omit<ComponentProps<'div'>, 'onSubmit'> {
+	mode: ConnectionMode
+	onSubmit: (target: OnboardingTarget) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+export function TargetStep({ mode, onSubmit, onBack, isSubmitting, className, ...props }: TargetStepProps) {
+	const { t } = useTranslation()
+	const [selected, setSelected] = useState<OnboardingTarget | undefined>()
+
+	// Filter targets by the connectionMode selected in the previous step
+	const targets = ONBOARDING_TARGETS.filter(target => target.connectionMode === mode)
+
+	return (
+		<div {...props} className={cn('flex w-full max-w-lg flex-col gap-8', className)}>
+			<div>
+				<h2 className="text-xl font-semibold tracking-tight">{t('onboarding.target.title')}</h2>
+				<p className="text-muted-foreground mt-1 text-sm">{t('onboarding.target.subtitle')}</p>
+			</div>
+
+			<div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
+				{targets.map(target => {
+					const isActive = selected?.platform === target.platform
+					const copy = TARGET_COPY[target.platform]
+					return (
+						<button
+							key={target.platform}
+							type="button"
+							onClick={() => setSelected(target)}
+							className={cn(
+								'rounded-xl border-2 p-4 text-left transition-colors',
+								isActive ? 'border-primary bg-primary/5' : 'border-border hover:border-primary/50',
+							)}
+						>
+							<p className="font-semibold">{t(copy.nameKey)}</p>
+							<p className="text-muted-foreground mt-0.5 text-sm">{t(copy.descriptionKey)}</p>
+						</button>
+					)
+				})}
+			</div>
+
+			<div className="flex justify-between">
+				<div>
+					{onBack && (
+						<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+							<IconArrowLeft className="mr-1 size-4" />
+							{t('common.back')}
+						</Button>
+					)}
+				</div>
+				<Button type="button" disabled={!selected || isSubmitting} onClick={() => selected && onSubmit(selected)}>
+					{t('common.next')}
+					<IconArrowRight className="ml-1 size-4" />
+				</Button>
+			</div>
+		</div>
+	)
+}
