@@ -0,0 +1,168 @@
+import { useMemo, type ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useQueryClient } from '@tanstack/react-query'
+import { toast } from 'sonner'
+import {
+	useListPurchaseOrders,
+	listPurchaseOrdersQueryKey,
+	useCancelPurchaseOrder,
+	PurchaseOrderStatusEnum,
+	type PurchaseOrderStatus,
+	type ListPurchaseOrdersQueryResponse,
+} from '@template/client-typescript/typescript'
+
+import { DataTable, DataTableContent, DataTablePagination, type ColumnDef } from '@/components/DataTable'
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Empty, EmptyHeader, EmptyTitle, EmptyDescription } from '@/components/ui/empty'
+import { XIcon } from '@/components/ui/icons'
+import { cn } from '@/lib/utils'
+import { useMoney, useLocale, useServerEvents } from '@/hooks'
+import { useDialogStore } from '@/stores/useDialogStore'
+
+const STATUS_VARIANT: Record<PurchaseOrderStatus, 'default' | 'secondary' | 'destructive'> = {
+	[PurchaseOrderStatusEnum.DRAFT]: 'secondary',
+	[PurchaseOrderStatusEnum.PLACED]: 'default',
+	[PurchaseOrderStatusEnum.CANCELLED]: 'destructive',
+}
+
+type PurchaseOrderRow = ListPurchaseOrdersQueryResponse['list']['items'][number]
+
+const routeApi = getRouteApi('/(app)/procurement/purchase-orders/')
+
+export function PurchaseOrderListSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const navigate = routeApi.useNavigate()
+	const { status, page, limit } = routeApi.useSearch()
+	const queryClient = useQueryClient()
+	const dialogStore = useDialogStore()
+	const formatMoney = useMoney()
+	const locale = useLocale()
+
+	const { data, isPending } = useListPurchaseOrders({ status, page, limit })
+
+	const { mutateAsync: cancel } = useCancelPurchaseOrder({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('purchaseOrders.toast.cancelled'))
+				queryClient.invalidateQueries({ queryKey: listPurchaseOrdersQueryKey() })
+			},
+		},
+	})
+
+	useServerEvents('integration.shared.purchase_order.recorded', () => {
+		queryClient.invalidateQueries({ queryKey: listPurchaseOrdersQueryKey() })
+	})
+
+	const items = data?.list.items ?? []
+	const total = data?.list.total ?? 0
+	const totalPages = data?.list.totalPages ?? 0
+
+	const columns = useMemo<ColumnDef<PurchaseOrderRow>[]>(
+		() => [
+			{
+				id: 'supplierName',
+				header: t('purchaseOrders.table.supplierName'),
+				accessorKey: 'supplierName',
+				cell: ({ row }) => <span className="font-medium text-foreground">{row.original.supplierName}</span>,
+			},
+			{
+				id: 'status',
+				header: t('purchaseOrders.table.status'),
+				cell: ({ row }) => (
+					<Badge variant={STATUS_VARIANT[row.original.status]}>
+						{t(`enums.PurchaseOrderStatus.${row.original.status}`)}
+					</Badge>
+				),
+			},
+			{
+				id: 'totalAmount',
+				header: t('purchaseOrders.table.totalAmount'),
+				cell: ({ row }) =>
+					formatMoney({
+						amountCents: row.original.totalAmountCents,
+						currency: row.original.totalAmountCurrency,
+					}),
+				meta: { align: 'right' },
+			},
+			{
+				id: 'createdAt',
+				header: t('purchaseOrders.table.createdAt'),
+				cell: ({ row }) => (
+					<span className="text-sm text-muted-foreground">
+						{new Date(row.original.createdAt).toLocaleDateString(locale)}
+					</span>
+				),
+			},
+			{
+				id: 'actions',
+				header: '',
+				cell: ({ row }) => {
+					if (row.original.status === PurchaseOrderStatusEnum.CANCELLED) return null
+					return (
+						<Button
+							variant="ghost"
+							size="icon-sm"
+							aria-label={t('purchaseOrders.actions.cancel')}
+							onClick={async () => {
+								const confirmed = await dialogStore.confirm({
+									title: t('purchaseOrders.cancelDialog.title'),
+									description: t('purchaseOrders.cancelDialog.description', {
+										name: row.original.supplierName,
+									}),
+									actionLabel: t('purchaseOrders.cancelDialog.confirm'),
+									variant: 'destructive',
+								})
+								if (confirmed) await cancel({ purchaseOrderId: row.original.id })
+							}}
+						>
+							<XIcon />
+						</Button>
+					)
+				},
+				meta: { align: 'right', width: '60px' },
+			},
+		],
+		[t, locale, formatMoney, dialogStore, cancel],
+	)
+
+	return (
+		<div className={cn('flex flex-col gap-4', className)} {...props}>
+			<DataTable
+				columns={columns}
+				getRowId={r => r.id}
+				data={items}
+				total={total}
+				totalPages={totalPages}
+				isLoading={isPending}
+				page={page}
+				limit={limit}
+				search=""
+				onPageChange={p => navigate({ search: prev => ({ ...prev, page: p }) })}
+				onLimitChange={l => navigate({ search: prev => ({ ...prev, limit: l, page: 1 }) })}
+				onSearchChange={() => {}}
+			>
+				<DataTableContent
+					emptyState={
+						<Empty>
+							<EmptyHeader>
+								<EmptyTitle>{t('purchaseOrders.empty.title')}</EmptyTitle>
+								<EmptyDescription>{t('purchaseOrders.empty.description')}</EmptyDescription>
+							</EmptyHeader>
+						</Empty>
+					}
+					loadingState={
+						<div className="flex flex-col gap-3 p-4">
+							{Array.from({ length: 5 }).map((_, i) => (
+								<Skeleton key={`row-skeleton-${i}`} className="h-10 w-full" />
+							))}
+						</div>
+					}
+				/>
+				<DataTablePagination />
+			</DataTable>
+		</div>
+	)
+}
