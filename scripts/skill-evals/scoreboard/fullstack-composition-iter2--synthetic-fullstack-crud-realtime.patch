new file mode 100644
index 000000000..7cb86bdd8
--- /dev/null
+++ b/packages/e2e/tests/08-purchase-orders.spec.ts
@@ -0,0 +1,89 @@
+import { test, expect } from '../utils/test'
+import { mockSSE } from '../utils/mock'
+import {
+	createPurchaseOrder,
+	CurrencyCodeEnum,
+	listenEventsQueryKey,
+} from '@template/client-typescript/typescript'
+import { t } from '../utils/i18n'
+
+/**
+ * Canonical flow 8 — purchase orders: create → list, cancel → status flip, SSE invalidation.
+ *
+ * Asserts end-to-end that:
+ *   1. A user can create a purchase order via the dialog and it appears in the list
+ *   2. Cancelling an order flips its status badge to CANCELLED
+ *   3. A `purchase_order.recorded` SSE event triggers a list refetch
+ */
+
+test('create purchase order via dialog → appears in list', async ({ page, goto, given }) => {
+	await given.freshUser()
+
+	// SSE must be mocked — prevents infinite retry loops while testing interactions
+	await mockSSE(page, listenEventsQueryKey)
+
+	await goto('/procurement/purchase-orders')
+
+	// Open the create dialog
+	await page.getByRole('button', { name: t('purchaseOrders.actions.create') }).click()
+
+	// Fill in the form fields (labels rely on htmlFor/id set in the dialog component)
+	const dialog = page.getByRole('dialog')
+	await dialog.getByLabel(t('purchaseOrders.fields.supplierName')).fill('ACME Supplies')
+	await dialog.getByLabel(t('purchaseOrders.fields.totalAmount')).fill('500')
+
+	// Submit
+	await dialog.getByRole('button', { name: t('purchaseOrders.createDialog.submit') }).click()
+
+	// Order must appear in the table
+	await expect(page.getByRole('cell', { name: 'ACME Supplies' })).toBeVisible()
+})
+
+test('cancel purchase order → status badge flips to CANCELLED', async ({ page, goto, given }) => {
+	const { session } = await given.freshUser()
+
+	// Create the order via SDK — faster than driving through the UI again
+	await createPurchaseOrder(
+		{ supplierName: 'Beta Supplier', totalAmount: { amountCents: 10_000, currency: CurrencyCodeEnum.BRL } },
+		{ client: session.client },
+	)
+
+	await mockSSE(page, listenEventsQueryKey)
+	await goto('/procurement/purchase-orders')
+
+	// Wait for the seeded order to render
+	await expect(page.getByRole('cell', { name: 'Beta Supplier' })).toBeVisible()
+
+	// Click the cancel icon button on the row (aria-label = "Cancelar ordem")
+	await page.getByRole('button', { name: t('purchaseOrders.actions.cancel') }).click()
+
+	// Confirm the destructive confirmation dialog
+	await page.getByRole('dialog').getByRole('button', { name: t('purchaseOrders.cancelDialog.confirm') }).click()
+
+	// Status badge must update to CANCELLED
+	await expect(page.getByText(t('enums.PurchaseOrderStatus.CANCELLED'))).toBeVisible()
+})
+
+test('SSE purchase_order.recorded event triggers list refetch', async ({ page, goto, given }) => {
+	await given.freshUser()
+
+	// Deliver one purchase_order.recorded event the moment the page connects to the SSE stream
+	await mockSSE(page, listenEventsQueryKey, [
+		{
+			data: JSON.stringify({ name: 'integration.shared.purchase_order.recorded', payload: {} }),
+		},
+	])
+
+	// Count GET requests to the list endpoint
+	let listFetchCount = 0
+	page.on('request', req => {
+		if (req.url().includes('/v1/ui/purchase-orders') && req.method() === 'GET') {
+			listFetchCount++
+		}
+	})
+
+	await goto('/procurement/purchase-orders')
+
+	// Expect at least 2 fetches: initial load + SSE-triggered invalidation refetch
+	await expect.poll(() => listFetchCount, { timeout: 5_000 }).toBeGreaterThanOrEqual(2)
+})
