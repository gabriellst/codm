diff --git a/packages/api/typescript/src/ui/usecases/ListPurchaseOrders.ts b/packages/api/typescript/src/ui/usecases/ListPurchaseOrders.ts
new file mode 100644
index 000000000..a6b4fbc01
--- /dev/null
+++ b/packages/api/typescript/src/ui/usecases/ListPurchaseOrders.ts
@@ -0,0 +1,71 @@
+import { injectable } from 'tsyringe-neo'
+import { DrizzleClient, Handler, z } from '@template/core-typescript'
+import { desc, eq, and } from 'drizzle-orm'
+import { purchaseOrders } from '@template/contracts/db'
+import { CurrencyCode, PurchaseOrderStatus } from '@template/contracts-typescript/wire/enums'
+
+export const PurchaseOrderItemSchema = z.object({
+	id: z.uuid(),
+	supplierName: z.string(),
+	status: z.enum(PurchaseOrderStatus),
+	totalAmountCents: z.number().int(),
+	totalAmountCurrency: z.enum(CurrencyCode),
+	createdAt: z.string().datetime(),
+	updatedAt: z.string().datetime(),
+})
+
+export const ListPurchaseOrdersInputSchema = z.object({
+	storeId: z.uuid(),
+	status: z.enum(PurchaseOrderStatus).optional(),
+	page: z.number().int().min(1).default(1),
+	limit: z.number().int().min(1).max(100).default(20),
+})
+
+export const ListPurchaseOrdersOutputSchema = z.object({
+	list: z.paginatedResponse(PurchaseOrderItemSchema.shape),
+})
+
+@injectable()
+export class ListPurchaseOrders extends Handler<typeof ListPurchaseOrdersInputSchema, typeof ListPurchaseOrdersOutputSchema> {
+	readonly name = 'list_purchase_orders' as const
+	readonly inputSchema = ListPurchaseOrdersInputSchema
+	readonly outputSchema = ListPurchaseOrdersOutputSchema
+
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const conditions = [eq(purchaseOrders.storeId, input.storeId)]
+		if (input.status) conditions.push(eq(purchaseOrders.status, input.status))
+		const where = and(...conditions)
+
+		const offset = (input.page - 1) * input.limit
+
+		const [rows, countRows] = await Promise.all([
+			this.db
+				.select()
+				.from(purchaseOrders)
+				.where(where)
+				.orderBy(desc(purchaseOrders.createdAt))
+				.limit(input.limit)
+				.offset(offset),
+			this.db.select({ id: purchaseOrders.id }).from(purchaseOrders).where(where),
+		])
+
+		const total = countRows.length
+		const totalPages = Math.max(1, Math.ceil(total / input.limit))
+
+		const items = rows.map(r => ({
+			id: r.id,
+			supplierName: r.supplierName,
+			status: r.status as PurchaseOrderStatus,
+			totalAmountCents: Number(r.totalAmountCents),
+			totalAmountCurrency: r.totalAmountCurrency as CurrencyCode,
+			createdAt: r.createdAt.toISOString(),
+			updatedAt: r.updatedAt.toISOString(),
+		}))
+
+		return { list: { items, total, totalPages } }
+	}
+}
