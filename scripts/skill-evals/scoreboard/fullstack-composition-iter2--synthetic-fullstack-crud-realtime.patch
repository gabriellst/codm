+import { describe, it, expect } from 'bun:test'
+import { CurrencyCode, PurchaseOrderStatus } from '@template/contracts-typescript/wire/enums'
+import { PurchaseOrder } from './PurchaseOrder'
+
+const totalAmount = { amountCents: 10000, currency: CurrencyCode.BRL }
+
+const makeOrder = () =>
+	PurchaseOrder.create({
+		storeId: 'a1b2c3d4-e5f6-7890-abcd-ef1234567890',
+		supplierName: 'ACME Supplies',
+		totalAmount,
+	})
+
+describe('PurchaseOrder', () => {
+	describe('create', () => {
+		it('creates a new order in DRAFT status', () => {
+			const order = makeOrder()
+			expect(order.status).toBe(PurchaseOrderStatus.DRAFT)
+			expect(order.supplierName).toBe('ACME Supplies')
+			expect(order.totalAmount.amountCents).toBe(10000)
+		})
+	})
+
+	describe('place', () => {
+		it('transitions DRAFT → PLACED', () => {
+			const order = makeOrder()
+			order.place()
+			expect(order.status).toBe(PurchaseOrderStatus.PLACED)
+		})
+
+		it('throws PURCHASE_ORDER_ALREADY_CANCELLED when order is cancelled', () => {
+			const order = makeOrder()
+			order.cancel()
+			expect(() => order.place()).toThrow(expect.objectContaining({ name: 'PURCHASE_ORDER_ALREADY_CANCELLED' }))
+		})
+	})
+
+	describe('cancel', () => {
+		it('transitions DRAFT → CANCELLED', () => {
+			const order = makeOrder()
+			order.cancel()
+			expect(order.status).toBe(PurchaseOrderStatus.CANCELLED)
+		})
+
+		it('throws PURCHASE_ORDER_ALREADY_CANCELLED when already cancelled', () => {
+			const order = makeOrder()
+			order.cancel()
+			expect(() => order.cancel()).toThrow(expect.objectContaining({ name: 'PURCHASE_ORDER_ALREADY_CANCELLED' }))
+		})
+
+		it('transitions PLACED → CANCELLED', () => {
+			const order = makeOrder()
+			order.place()
+			order.cancel()
+			expect(order.status).toBe(PurchaseOrderStatus.CANCELLED)
+		})
+	})
+})
