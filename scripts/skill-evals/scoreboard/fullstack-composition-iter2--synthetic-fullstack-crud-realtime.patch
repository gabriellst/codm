+const storeId = 'a1b2c3d4-e5f6-7890-abcd-ef1234567890'
+const totalAmount = { amountCents: 50000, currency: CurrencyCode.BRL }
+
+describe('CreatePurchaseOrder use case', () => {
+	let testBed: TestBed
+	let testContainer: DependencyContainer
+	let createUseCase: CreatePurchaseOrder
+	let cancelUseCase: CancelPurchaseOrder
+	let orderRepo: PurchaseOrderRepository
+
+	beforeAll(async () => {
+		testContainer = container.createChildContainer()
+		testBed = await TestBed.create('integration', { testContainer, ownerId: storeId })
+		createUseCase = testBed.resolve(CreatePurchaseOrder)
+		cancelUseCase = testBed.resolve(CancelPurchaseOrder)
+		orderRepo = testBed.resolve(PurchaseOrderRepository)
+	})
+	beforeEach(async () => {
+		await testBed.reset()
+	})
+	afterAll(async () => {
+		await testBed.destroy()
+	})
+
+	it('persists a purchase order in DRAFT status and emits PurchaseOrderCreatedEvent', async () => {
+		const { purchaseOrderId } = await createUseCase.execute({ storeId, supplierName: 'ACME', totalAmount })
+
+		const saved = await orderRepo.findById(purchaseOrderId)
+		expect(saved).toBeDefined()
+		expect(saved!.status).toBe(PurchaseOrderStatus.DRAFT)
+		expect(saved!.supplierName).toBe('ACME')
+
+		const events = await testBed.resolve(DomainEventRepository).findByType(PurchaseOrderCreatedEvent)
+		expect(events).toHaveLength(1)
+		expect(events[0]!.payload.purchaseOrderId).toBe(purchaseOrderId)
+		expect(events[0]!.payload.storeId).toBe(storeId)
+	})
+})
+
+describe('CancelPurchaseOrder use case', () => {
+	let testBed: TestBed
+	let testContainer: DependencyContainer
+	let createUseCase: CreatePurchaseOrder
+	let cancelUseCase: CancelPurchaseOrder
+
+	beforeAll(async () => {
+		testContainer = container.createChildContainer()
+		testBed = await TestBed.create('integration', { testContainer, ownerId: storeId })
+		createUseCase = testBed.resolve(CreatePurchaseOrder)
+		cancelUseCase = testBed.resolve(CancelPurchaseOrder)
+	})
+	beforeEach(async () => {
+		await testBed.reset()
+	})
+	afterAll(async () => {
+		await testBed.destroy()
+	})
+
+	it('cancels an existing order and reflects CANCELLED status', async () => {
+		const { purchaseOrderId } = await createUseCase.execute({ storeId, supplierName: 'Supplier X', totalAmount })
+		const { purchaseOrderId: cancelledId } = await cancelUseCase.execute({ storeId, purchaseOrderId })
+
+		expect(cancelledId).toBe(purchaseOrderId)
+	})
+
+	it('throws PURCHASE_ORDER_NOT_FOUND for unknown id', async () => {
+		await expect(
+			cancelUseCase.execute({ storeId, purchaseOrderId: 'ffffffff-ffff-ffff-ffff-ffffffffffff' }),
+		).rejects.toMatchObject({ name: 'PURCHASE_ORDER_NOT_FOUND' })
+	})
+})
diff --git a/packages/api/typescript/src/procurement/usecases/CreatePurchaseOrder.ts b/packages/api/typescript/src/procurement/usecases/CreatePurchaseOrder.ts
