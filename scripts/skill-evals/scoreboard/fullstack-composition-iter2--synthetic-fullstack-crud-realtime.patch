@@ -0,0 +1,106 @@
+package handlers
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"testing"
+	"time"
+
+	"template/contracts-go/wire"
+)
+
+// fakeAuditDB captures ExecContext calls for assertion.
+type fakeAuditDB struct {
+	capturedArgs []any
+	err          error
+}
+
+func (f *fakeAuditDB) ExecContext(_ context.Context, _ string, args ...any) (sql.Result, error) {
+	f.capturedArgs = args
+	return nil, f.err
+}
+
+// fakePurchaseOrderEvent wraps a raw JSON payload to satisfy types.IntegrationEventI.
+type fakePurchaseOrderEvent struct {
+	name    string
+	ownerID string
+	payload json.RawMessage
+}
+
+func (e fakePurchaseOrderEvent) GetEventName() string        { return e.name }
+func (e fakePurchaseOrderEvent) GetOwnerID() string          { return e.ownerID }
+func (e fakePurchaseOrderEvent) GetPayload() json.RawMessage { return e.payload }
+
+func makePurchaseOrderRecordedPayload(t *testing.T, evt wire.PurchaseOrderRecordedEvent) json.RawMessage {
+	t.Helper()
+	b, err := json.Marshal(evt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+
+func TestPurchaseOrderRecordedHandler_InsertsAuditRow(t *testing.T) {
+	db := &fakeAuditDB{}
+	h := &PurchaseOrderRecordedHandler{db: db}
+
+	now := time.Now().UTC()
+	evt := wire.PurchaseOrderRecordedEvent{
+		Name:                wire.PurchaseOrderRecordedEventName,
+		PurchaseOrderID:     "po-uuid-001",
+		StoreID:             "store-uuid-001",
+		SupplierName:        "ACME Supplies",
+		Status:              wire.PurchaseOrderStatusDRAFT,
+		TotalAmountCents:    50000,
+		TotalAmountCurrency: wire.CurrencyCodeBRL,
+		OccurredAt:          now,
+	}
+
+	raw := makePurchaseOrderRecordedPayload(t, evt)
+	event := fakePurchaseOrderEvent{name: wire.PurchaseOrderRecordedEventName, payload: raw}
+
+	if err := h.Handle(context.Background(), event); err != nil {
+		t.Fatalf("Handle returned unexpected error: %v", err)
+	}
+
+	if len(db.capturedArgs) != 7 {
+		t.Fatalf("expected 7 INSERT args, got %d", len(db.capturedArgs))
+	}
+	if db.capturedArgs[0] != "po-uuid-001" {
+		t.Errorf("purchase_order_id: got %v, want po-uuid-001", db.capturedArgs[0])
+	}
+	if db.capturedArgs[1] != "store-uuid-001" {
+		t.Errorf("store_id: got %v, want store-uuid-001", db.capturedArgs[1])
+	}
+	if db.capturedArgs[2] != "ACME Supplies" {
+		t.Errorf("supplier_name: got %v, want ACME Supplies", db.capturedArgs[2])
+	}
+	if db.capturedArgs[3] != "DRAFT" {
+		t.Errorf("status: got %v, want DRAFT", db.capturedArgs[3])
+	}
+}
+
+func TestPurchaseOrderRecordedHandler_EventName(t *testing.T) {
+	h := &PurchaseOrderRecordedHandler{db: &fakeAuditDB{}}
+	if got := h.EventName(); got != wire.PurchaseOrderRecordedEventName {
+		t.Errorf("EventName: got %q, want %q", got, wire.PurchaseOrderRecordedEventName)
+	}
+}
+
+func TestPurchaseOrderRecordedHandler_RejectsWrongType(t *testing.T) {
+	h := &PurchaseOrderRecordedHandler{db: &fakeAuditDB{}}
+
+	// Event with no GetPayload method — should fail decode.
+	type bareEvent struct{ name string }
+	type integrationEvent interface{ GetEventName() string }
+	// Use fakePurchaseOrderEvent but with bad payload (not a PurchaseOrderRecordedEvent JSON).
+	event := fakePurchaseOrderEvent{
+		name:    wire.PurchaseOrderRecordedEventName,
+		payload: json.RawMessage(`{"name":"integration.shared.finance.operational_cost_recorded"}`),
+	}
+
+	if err := h.Handle(context.Background(), event); err == nil {
+		t.Fatal("expected error for wrong event type, got nil")
+	}
+}
