@@ -0,0 +1,121 @@
+import { useTranslation } from 'react-i18next'
+import { useQueryClient } from '@tanstack/react-query'
+import { useForm } from '@tanstack/react-form'
+import { toast } from 'sonner'
+import {
+	useCreatePurchaseOrder,
+	listPurchaseOrdersQueryKey,
+	createPurchaseOrderMutationRequestSchema,
+	CurrencyCodeEnum,
+	type CreatePurchaseOrderMutationRequest,
+} from '@template/client-typescript/typescript'
+import { DeepPartial } from '@/lib'
+
+import { DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from '@/components/ui/dialog'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import { Input } from '@/components/ui/input'
+import { Field, FieldLabel, FieldError } from '@/components/ui/field'
+import { CurrencyInput } from '@/components/ui/currency-input'
+import { useDialogStore } from '@/stores/useDialogStore'
+
+/**
+ * CreatePurchaseOrderDialog — self-contained dialog for creating a supplier purchase order.
+ * Open via useDialogStore().show(<CreatePurchaseOrderDialog />).
+ */
+export function CreatePurchaseOrderDialog() {
+	const { t } = useTranslation()
+	const dialogStore = useDialogStore()
+	const queryClient = useQueryClient()
+
+	const { mutateAsync, isPending } = useCreatePurchaseOrder({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('purchaseOrders.toast.created'))
+				queryClient.invalidateQueries({ queryKey: listPurchaseOrdersQueryKey() })
+				dialogStore.hide()
+			},
+		},
+	})
+
+	const defaultValues: DeepPartial<CreatePurchaseOrderMutationRequest> = {
+		supplierName: '',
+		totalAmount: { amountCents: 0, currency: CurrencyCodeEnum.BRL },
+	}
+
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: createPurchaseOrderMutationRequestSchema },
+		onSubmit: async ({ value }) => {
+			await mutateAsync({ data: value as CreatePurchaseOrderMutationRequest })
+		},
+	})
+
+	return (
+		<DialogContent className="sm:max-w-md" showCloseButton>
+			<DialogHeader>
+				<DialogTitle>{t('purchaseOrders.createDialog.title')}</DialogTitle>
+				<DialogDescription>{t('purchaseOrders.createDialog.description')}</DialogDescription>
+			</DialogHeader>
+
+			<form
+				className="flex flex-col gap-4"
+				onSubmit={e => {
+					e.preventDefault()
+					form.handleSubmit()
+				}}
+			>
+				<form.Field name="supplierName">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('purchaseOrders.fields.supplierName')}</FieldLabel>
+								<Input
+									id={field.name}
+									value={field.state.value ?? ''}
+									onChange={e => field.handleChange(e.target.value)}
+									placeholder={t('purchaseOrders.fields.supplierNamePlaceholder')}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				<form.Field name="totalAmount">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('purchaseOrders.fields.totalAmount')}</FieldLabel>
+								<CurrencyInput
+									id={field.name}
+									amountCents={field.state.value?.amountCents ?? 0}
+									currency={field.state.value?.currency ?? CurrencyCodeEnum.BRL}
+									onAmountChange={cents => field.handleChange({ ...field.state.value!, amountCents: cents })}
+									onCurrencyChange={currency => field.handleChange({ ...field.state.value!, currency })}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				<DialogFooter>
+					<Button type="button" variant="outline" onClick={() => dialogStore.hide()} disabled={isPending}>
+						{t('purchaseOrders.createDialog.cancel')}
+					</Button>
+					<form.Subscribe selector={s => [s.canSubmit, s.isSubmitting]}>
+						{([canSubmit, isSubmitting]) => (
+							<Button type="submit" disabled={!canSubmit || isSubmitting || isPending}>
+								{(isSubmitting || isPending) && <Spinner className="mr-2" />}
+								{t('purchaseOrders.createDialog.submit')}
+							</Button>
+						)}
+					</form.Subscribe>
+				</DialogFooter>
+			</form>
+		</DialogContent>
+	)
+}
