diff --git a/packages/api/go/internal/sync/handlers/purchase_order_recorded_handler.go b/packages/api/go/internal/sync/handlers/purchase_order_recorded_handler.go
new file mode 100644
index 000000000..071020aac
--- /dev/null
+++ b/packages/api/go/internal/sync/handlers/purchase_order_recorded_handler.go
@@ -0,0 +1,69 @@
+package handlers
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"template/contracts-go/wire"
+	"template/core-go/types"
+)
+
+const insertPurchaseOrderAuditSQL = `
+INSERT INTO procurement.purchase_order_audit
+  (id, purchase_order_id, store_id, supplier_name, status, total_amount_cents, total_amount_currency, recorded_at)
+VALUES (gen_random_uuid(), $1, $2, $3, $4, $5, $6, $7)`
+
+// purchaseOrderAuditInserter abstracts the DB call for testability.
+type purchaseOrderAuditInserter interface {
+	ExecContext(ctx context.Context, query string, args ...any) (sql.Result, error)
+}
+
+// PurchaseOrderRecordedHandler appends an audit row for every purchase_order.recorded event.
+type PurchaseOrderRecordedHandler struct {
+	db purchaseOrderAuditInserter
+}
+
+func NewPurchaseOrderRecordedHandler(db *sql.DB) *PurchaseOrderRecordedHandler {
+	return &PurchaseOrderRecordedHandler{db: db}
+}
+
+func (h *PurchaseOrderRecordedHandler) EventName() string {
+	return wire.PurchaseOrderRecordedEventName
+}
+
+func (h *PurchaseOrderRecordedHandler) Handle(ctx context.Context, event types.IntegrationEventI) error {
+	evt, err := decodePurchaseOrderRecorded(event)
+	if err != nil {
+		return err
+	}
+
+	_, err = h.db.ExecContext(ctx, insertPurchaseOrderAuditSQL,
+		evt.PurchaseOrderID,
+		evt.StoreID,
+		evt.SupplierName,
+		string(evt.Status),
+		evt.TotalAmountCents,
+		string(evt.TotalAmountCurrency),
+		time.Now().UTC(),
+	)
+	return err
+}
+
+func decodePurchaseOrderRecorded(event types.IntegrationEventI) (wire.PurchaseOrderRecordedEvent, error) {
+	provider, ok := event.(interface{ GetPayload() json.RawMessage })
+	if !ok {
+		return wire.PurchaseOrderRecordedEvent{}, fmt.Errorf("purchase_order_recorded: event %s carries no payload", event.GetEventName())
+	}
+	decoded, err := wire.UnmarshalIntegrationEvent(provider.GetPayload())
+	if err != nil {
+		return wire.PurchaseOrderRecordedEvent{}, fmt.Errorf("purchase_order_recorded: unmarshal: %w", err)
+	}
+	v, ok := decoded.(wire.PurchaseOrderRecordedEvent)
+	if !ok {
+		return wire.PurchaseOrderRecordedEvent{}, fmt.Errorf("purchase_order_recorded: unexpected type %T", decoded)
+	}
+	return v, nil
+}
