@@ -0,0 +1,81 @@
+import { bigint, index, integer, pgSchema, text, timestamp, uuid } from 'drizzle-orm/pg-core'
+
+/**
+ * `procurement` is the BK Dash supplier purchase-orders schema.
+ *
+ * TS-owned write-side (PurchaseOrder aggregate via CreatePurchaseOrder /
+ * CancelPurchaseOrder use cases). Go sync worker reads via integration event
+ * to append audit rows.
+ *
+ * Tables:
+ *   - `purchase_orders`       — aggregate root: supplier, status, total amount
+ *   - `purchase_order_audit`  — Go-appended audit log consumed from integration event
+ */
+export const procurementSchema = pgSchema('procurement')
+
+/**
+ * `purchase_orders` — one row per supplier purchase order.
+ *
+ * status stores the PurchaseOrderStatus enum value (DRAFT | PLACED | CANCELLED)
+ * as text; validated at the application layer (no pgEnum coupling).
+ *
+ * total_amount_cents + total_amount_currency store the monetary amount
+ * in the canonical cents + ISO-4217 pattern used across all tables.
+ */
+export const purchaseOrders = procurementSchema.table(
+	'purchase_orders',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		storeId: uuid('store_id').notNull(),
+
+		supplierName: text('supplier_name').notNull(),
+
+		// PurchaseOrderStatus: DRAFT | PLACED | CANCELLED — validated at app layer.
+		status: text('status').notNull(),
+
+		totalAmountCents: bigint('total_amount_cents', { mode: 'bigint' }).notNull(),
+		totalAmountCurrency: text('total_amount_currency').notNull(),
+
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		storeIdx: index('purchase_orders_store_id_idx').on(t.storeId),
+		statusIdx: index('purchase_orders_status_idx').on(t.status),
+		createdAtIdx: index('purchase_orders_created_at_idx').on(t.createdAt),
+	}),
+)
+
+/**
+ * `purchase_order_audit` — append-only audit log written by the Go sync worker
+ * in response to `integration.shared.purchase_order.recorded` events.
+ *
+ * Each row records a status transition. The Go handler never overwrites rows —
+ * it only inserts, so the full lifecycle is queryable by order id.
+ */
+export const purchaseOrderAudit = procurementSchema.table(
+	'purchase_order_audit',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		purchaseOrderId: uuid('purchase_order_id').notNull(),
+
+		storeId: uuid('store_id').notNull(),
+
+		supplierName: text('supplier_name').notNull(),
+
+		// PurchaseOrderStatus at the time the event was received.
+		status: text('status').notNull(),
+
+		totalAmountCents: bigint('total_amount_cents', { mode: 'bigint' }).notNull(),
+		totalAmountCurrency: text('total_amount_currency').notNull(),
+
+		recordedAt: timestamp('recorded_at', { withTimezone: true }).notNull().defaultNow(),
+	},
+	t => ({
+		purchaseOrderIdx: index('purchase_order_audit_po_id_idx').on(t.purchaseOrderId),
+		storeIdx: index('purchase_order_audit_store_id_idx').on(t.storeId),
+	}),
+)
