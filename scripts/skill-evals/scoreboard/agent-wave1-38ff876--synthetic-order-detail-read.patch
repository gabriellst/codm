+import { text, timestamp, integer, index, pgSchema } from 'drizzle-orm/pg-core'
+// Enum column types — single-sourced from the generated wire binding (type-only import: erased at
+// compile, so no package cycle and nothing for drizzle-kit to resolve at runtime).
+import type { CurrencyCode, OrderStatus } from '../../generated/typescript/src/wire/enums'
+
+/**
+ * `sales` — customer orders. Enum-valued columns use `text().$type<Enum>()` (never pgEnum) —
+ * the repo-wide convention; the closed sets live in packages/contracts wire enums.
+ */
+export const salesSchema = pgSchema('sales')
+
+// sales_orders — one row per order, tenant-scoped by ownerId (no FK, cross-context id as text).
+export const orders = salesSchema.table(
+	'sales_orders',
+	{
+		// BaseEntity fields
+		id: text('id').primaryKey(),
+		createdAt: timestamp('created_at', { withTimezone: true }).defaultNow().notNull(),
+		updatedAt: timestamp('updated_at', { withTimezone: true })
+			.defaultNow()
+			.$onUpdate(() => /* @__PURE__ */ new Date())
+			.notNull(),
+		version: integer('version').default(1).notNull(),
+
+		// Aggregate fields — cross-context id stored as plain text (no FK)
+		ownerId: text('owner_id').notNull(),
+		status: text('status').$type<OrderStatus>().notNull(),
+		totalCents: integer('total_cents').notNull(),
+		currency: text('currency').$type<CurrencyCode>().notNull(),
+	},
+	table => [index('sales_orders_owner_idx').on(table.ownerId)],
+)
