@@ -0,0 +1,47 @@
+import { injectable } from 'tsyringe-neo'
+import { Projector } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { ListViewProjection, type ListViewProjectionEvent } from '../ListViewProjection'
+import { TaskListViewProjectionRepository } from '../repositories/TaskListViewProjectionRepository'
+import type { TaskCreatedEvent } from '@task/events/TaskCreatedEvent'
+import type { TaskStatusChangedEvent } from '@task/events/TaskStatusChangedEvent'
+
+/**
+ * ListViewProjector — read-side handler for the ListViewProjection.
+ *
+ * Subscribes to task domain events and keeps `task.task_list_view` fresh:
+ *  - TaskCreatedEvent       → insertIfNew (creation path)
+ *  - TaskStatusChangedEvent → find → applyEvent → save (canonical mutation; status update)
+ */
+@injectable()
+export class ListViewProjector extends Projector<ListViewProjectionEvent> {
+	constructor(private repo: TaskListViewProjectionRepository) {
+		super()
+	}
+
+	readonly events = ['task.task.created', 'task.status_changed'] as const
+
+	async handle(event: ListViewProjectionEvent, tx?: Transaction): Promise<void> {
+		switch (event.name) {
+			// Creation — inserts one list-view row per task.
+			case 'task.task.created':
+				await this.repo.insertIfNew(ListViewProjection.create(event as TaskCreatedEvent), tx as DrizzleClient | undefined)
+				return
+
+			// Canonical mutation — status change updates the task's status column.
+			case 'task.status_changed': {
+				const row = await this.repo.findByTaskId(event.payload.taskId, tx as DrizzleClient | undefined)
+				if (!row) return // replay-safe no-op
+				row.applyEvent(event as TaskStatusChangedEvent)
+				await this.repo.save(row, tx as DrizzleClient | undefined)
+				return
+			}
+
+			default:
+				throw new Error(`ListViewProjector: unhandled event '${(event as { name: string }).name}'`)
+		}
+	}
+}
+
+// Local alias to satisfy the repo's DrizzleClient param without importing infra here.
+type DrizzleClient = Parameters<typeof import('@template/core-typescript')['DrizzleClient']['prototype']['select']> extends never ? never : import('@template/core-typescript').DrizzleClient
