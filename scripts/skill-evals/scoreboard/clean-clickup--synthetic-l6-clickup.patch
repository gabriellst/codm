+++ b/packages/contracts/db/schema/workspace.ts
@@ -0,0 +1,84 @@
+import { pgSchema, uuid, text, integer, jsonb, timestamp, index } from 'drizzle-orm/pg-core'
+
+/**
+ * `workspace` BC schema.
+ *
+ * A Workspace is the top-level container (== tenancy Store) for the ClickUp
+ * feature. Each Workspace contains Spaces; each Space contains ordered Lists.
+ *
+ * Tables:
+ *   - `workspaces` — top-level tenant workspace
+ *   - `spaces`     — workflow containers inside a workspace (hold statuses + lists)
+ *   - `lists`      — ordered lists inside a space (value objects of Space aggregate)
+ */
+export const workspaceSchema = pgSchema('workspace')
+
+export const workspaces = workspaceSchema.table(
+	'workspaces',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		// Human-readable workspace name.
+		name: text('name').notNull(),
+
+		// Owner user id (the workspace creator).
+		ownerId: uuid('owner_id').notNull(),
+
+		// Audit / optimistic concurrency.
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	() => ({}),
+)
+
+export const spaces = workspaceSchema.table(
+	'spaces',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		// Parent workspace.
+		workspaceId: uuid('workspace_id').notNull(),
+
+		// Human-readable space name.
+		name: text('name').notNull(),
+
+		// Array of TaskStatus string values defining the workflow for this space.
+		// Stored as jsonb; application layer enforces membership (TASK_STATUS_NOT_IN_SPACE).
+		statuses: jsonb('statuses').notNull(),
+
+		// Audit / optimistic concurrency.
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		workspaceIdx: index('spaces_workspace_id_idx').on(t.workspaceId),
+	}),
+)
+
+export const lists = workspaceSchema.table(
+	'lists',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		// Parent space. Cascade-delete: removing a space removes all its lists.
+		spaceId: uuid('space_id')
+			.notNull()
+			.references(() => spaces.id, { onDelete: 'cascade' }),
+
+		// Human-readable list name.
+		name: text('name').notNull(),
+
+		// 0-based display order within the space (managed by Space aggregate).
+		position: integer('position').notNull(),
+
+		// Audit / optimistic concurrency.
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		spaceIdx: index('lists_space_id_idx').on(t.spaceId),
+	}),
+)
