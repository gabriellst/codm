@@ -0,0 +1,92 @@
+import { injectable } from 'tsyringe-neo'
+import { Handler, BaseError, z } from '@template/core-typescript'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { SpaceRepository } from '@workspace/repositories/SpaceRepository'
+import { TaskListViewProjectionRepository } from '@ui/projections/repositories/TaskListViewProjectionRepository'
+import type { WorkspaceApplicationErrors } from '@workspace/errors'
+
+// ── Shared DTO — one task card for both list and board views ──────────────
+export const TaskCardDTOSchema = z.object({
+	taskId: z.uuid(),
+	listId: z.uuid(),
+	title: z.string(),
+	status: z.enum(TaskStatus),
+	priority: z.enum(TaskPriority),
+	assigneeIds: z.array(z.string()),
+})
+
+// ── Input ─────────────────────────────────────────────────────────────────
+export const GetListViewInputSchema = z.object({
+	workspaceId: z.uuid(),
+	spaceId: z.uuid(),
+})
+
+// ── Output ────────────────────────────────────────────────────────────────
+export const GetListViewOutputSchema = z.object({
+	spaceId: z.uuid(),
+	lists: z.array(
+		z.object({
+			listId: z.uuid(),
+			name: z.string(),
+			position: z.number().int(),
+			tasks: z.array(TaskCardDTOSchema),
+		}),
+	),
+})
+
+/**
+ * `GetListView` — BFF query for the list view of a space.
+ *
+ * Loads the Space (via SpaceRepository — for list headers including empty
+ * lists, ordered by position) then fetches all task rows from `task_list_view`
+ * grouped under each list. Lists with zero tasks are included.
+ */
+@injectable()
+export class GetListView extends Handler<typeof GetListViewInputSchema, typeof GetListViewOutputSchema> {
+	readonly name = 'get_list_view' as const
+	readonly inputSchema = GetListViewInputSchema
+	readonly outputSchema = GetListViewOutputSchema
+
+	constructor(
+		private readonly spaces: SpaceRepository,
+		private readonly taskListViewRepo: TaskListViewProjectionRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		// Load space for ordered list headers (includes empty lists)
+		const space = await this.spaces.findById(input.spaceId)
+		if (!space) throw new BaseError<WorkspaceApplicationErrors>('SPACE_NOT_FOUND')
+
+		// Load all task rows for this space from the projection
+		const taskRows = await this.taskListViewRepo.listBySpace(input.spaceId)
+
+		// Group tasks by listId
+		const tasksByList = new Map<string, typeof taskRows>()
+		for (const row of taskRows) {
+			const bucket = tasksByList.get(row.props.listId) ?? []
+			bucket.push(row)
+			tasksByList.set(row.props.listId, bucket)
+		}
+
+		// Emit one entry per SpaceList, ordered by position, including empty lists
+		const sortedLists = [...space.lists].sort((a, b) => a.position - b.position)
+
+		const lists = sortedLists.map(spaceList => ({
+			listId: spaceList.listId,
+			name: spaceList.name,
+			position: spaceList.position,
+			tasks: (tasksByList.get(spaceList.listId) ?? []).map(row => ({
+				taskId: row.props.taskId,
+				listId: row.props.listId,
+				title: row.props.title,
+				status: row.props.status,
+				priority: row.props.priority,
+				assigneeIds: row.props.assigneeIds,
+			})),
+		}))
+
+		return { spaceId: input.spaceId, lists }
+	}
+}
