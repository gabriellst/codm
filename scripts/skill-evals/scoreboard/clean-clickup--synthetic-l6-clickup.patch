new file mode 100644
index 000000000..498542552
--- /dev/null
+++ b/packages/api/typescript/src/task/entities/Task.test.ts
@@ -0,0 +1,125 @@
+import { describe, expect, it } from 'bun:test'
+import { BaseError } from '@template/core-typescript'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { Task } from './Task'
+
+const WORKSPACE_ID = '11111111-1111-4111-a111-111111111111'
+const SPACE_ID = '22222222-2222-4222-a222-222222222222'
+const LIST_ID = '33333333-3333-4333-a333-333333333333'
+const OTHER_LIST_ID = '44444444-4444-4444-a444-444444444444'
+
+const ALLOWED_STATUSES = [TaskStatus.TODO, TaskStatus.IN_PROGRESS, TaskStatus.IN_REVIEW, TaskStatus.DONE]
+const SPACE_LIST_IDS = [LIST_ID]
+
+describe('Task aggregate', () => {
+	it('creates with valid status and listId — asserts all fields', () => {
+		const task = Task.create({
+			workspaceId: WORKSPACE_ID,
+			spaceId: SPACE_ID,
+			listId: LIST_ID,
+			title: 'My Task',
+			status: TaskStatus.TODO,
+			priority: TaskPriority.NORMAL,
+			assigneeIds: ['aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa'],
+			allowedStatuses: ALLOWED_STATUSES,
+			spaceListIds: SPACE_LIST_IDS,
+		})
+
+		expect(task.workspaceId.value).toBe(WORKSPACE_ID)
+		expect(task.spaceId.value).toBe(SPACE_ID)
+		expect(task.listId.value).toBe(LIST_ID)
+		expect(task.title).toBe('My Task')
+		expect(task.status).toBe(TaskStatus.TODO)
+		expect(task.priority).toBe(TaskPriority.NORMAL)
+		expect(task.assigneeIds).toEqual(['aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa'])
+	})
+
+	it('creates with no assigneeIds — defaults to empty array', () => {
+		const task = Task.create({
+			workspaceId: WORKSPACE_ID,
+			spaceId: SPACE_ID,
+			listId: LIST_ID,
+			title: 'Task without assignees',
+			status: TaskStatus.TODO,
+			priority: TaskPriority.LOW,
+			allowedStatuses: ALLOWED_STATUSES,
+			spaceListIds: SPACE_LIST_IDS,
+		})
+
+		expect(task.assigneeIds).toEqual([])
+	})
+
+	it('throws TASK_STATUS_NOT_IN_SPACE when status is not in allowedStatuses', () => {
+		try {
+			Task.create({
+				workspaceId: WORKSPACE_ID,
+				spaceId: SPACE_ID,
+				listId: LIST_ID,
+				title: 'Bad status task',
+				status: TaskStatus.CANCELLED,
+				priority: TaskPriority.NORMAL,
+				allowedStatuses: ALLOWED_STATUSES,
+				spaceListIds: SPACE_LIST_IDS,
+			})
+			expect.unreachable('should have thrown')
+		} catch (e) {
+			expect((e as BaseError).name).toBe('TASK_STATUS_NOT_IN_SPACE')
+		}
+	})
+
+	it('throws LIST_NOT_IN_SPACE when listId is not in spaceListIds', () => {
+		try {
+			Task.create({
+				workspaceId: WORKSPACE_ID,
+				spaceId: SPACE_ID,
+				listId: OTHER_LIST_ID,
+				title: 'Bad list task',
+				status: TaskStatus.TODO,
+				priority: TaskPriority.NORMAL,
+				allowedStatuses: ALLOWED_STATUSES,
+				spaceListIds: SPACE_LIST_IDS,
+			})
+			expect.unreachable('should have thrown')
+		} catch (e) {
+			expect((e as BaseError).name).toBe('LIST_NOT_IN_SPACE')
+		}
+	})
+
+	it('changeStatus to disallowed status throws TASK_STATUS_NOT_IN_SPACE', () => {
+		const task = Task.create({
+			workspaceId: WORKSPACE_ID,
+			spaceId: SPACE_ID,
+			listId: LIST_ID,
+			title: 'Status task',
+			status: TaskStatus.TODO,
+			priority: TaskPriority.NORMAL,
+			allowedStatuses: ALLOWED_STATUSES,
+			spaceListIds: SPACE_LIST_IDS,
+		})
+
+		try {
+			task.changeStatus(TaskStatus.CANCELLED, ALLOWED_STATUSES)
+			expect.unreachable('should have thrown')
+		} catch (e) {
+			expect((e as BaseError).name).toBe('TASK_STATUS_NOT_IN_SPACE')
+		}
+	})
+
+	it('changeStatus to allowed status returns the previous status', () => {
+		const task = Task.create({
+			workspaceId: WORKSPACE_ID,
+			spaceId: SPACE_ID,
+			listId: LIST_ID,
+			title: 'Transition task',
+			status: TaskStatus.TODO,
+			priority: TaskPriority.NORMAL,
+			allowedStatuses: ALLOWED_STATUSES,
+			spaceListIds: SPACE_LIST_IDS,
+		})
+
+		const previous = task.changeStatus(TaskStatus.IN_PROGRESS, ALLOWED_STATUSES)
+
+		expect(previous).toBe(TaskStatus.TODO)
+		expect(task.status).toBe(TaskStatus.IN_PROGRESS)
+	})
+})
diff --git a/packages/api/typescript/src/task/entities/Task.ts b/packages/api/typescript/src/task/entities/Task.ts
new file mode 100644
index 000000000..6727d0f04
--- /dev/null
+++ b/packages/api/typescript/src/task/entities/Task.ts
@@ -0,0 +1,79 @@
+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import type { TaskDomainErrors } from '../errors'
+
+const TaskSchema = z.object({
+	workspaceId: z.instance(Id),
+	spaceId: z.instance(Id),
+	listId: z.instance(Id),
+	title: z.string().min(1).max(500),
+	status: z.enum(TaskStatus),
+	priority: z.enum(TaskPriority),
+	assigneeIds: z.array(z.uuid()).default([]),
+})
+
+export type TaskProps = Z.infer<typeof TaskSchema>
+
+/**
+ * Task aggregate root.
+ * Owns the task lifecycle within a Space.
+ * Invariants are enforced at creation and on status transitions.
+ */
+export class Task extends AggregateRoot<typeof TaskSchema> {
+	static override schema = TaskSchema
+
+	static create(data: {
+		workspaceId: string
+		spaceId: string
+		listId: string
+		title: string
+		status: TaskStatus
+		priority: TaskPriority
+		assigneeIds?: string[]
+		allowedStatuses: TaskStatus[]
+		spaceListIds: string[]
+	}): Task {
+		if (!data.spaceListIds.includes(data.listId)) {
+			throw new BaseError<TaskDomainErrors>('LIST_NOT_IN_SPACE', `List "${data.listId}" does not belong to the space`)
+		}
+
+		if (!data.allowedStatuses.includes(data.status)) {
+			throw new BaseError<TaskDomainErrors>('TASK_STATUS_NOT_IN_SPACE', `Status "${data.status}" is not allowed in this space`)
+		}
+
+		return new Task({
+			workspaceId: new Id(data.workspaceId),
+			spaceId: new Id(data.spaceId),
+			listId: new Id(data.listId),
+			title: data.title,
+			status: data.status,
+			priority: data.priority,
+			assigneeIds: data.assigneeIds ?? [],
+		})
+	}
+
+	/**
+	 * Transitions the task to a new status.
+	 * Returns the PREVIOUS status (for event's `fromStatus`).
+	 * Throws `TASK_STATUS_NOT_IN_SPACE` if `next` is not in allowedStatuses.
+	 */
+	changeStatus(next: TaskStatus, allowedStatuses: TaskStatus[]): TaskStatus {
+		if (!allowedStatuses.includes(next)) {
+			throw new BaseError<TaskDomainErrors>('TASK_STATUS_NOT_IN_SPACE', `Status "${next}" is not allowed in this space`)
+		}
+
+		const previous = this.status
+		this.status = next
+		return previous
+	}
+
+	/**
+	 * Replace assignees with the given list of user IDs.
+	 */
+	assign(assigneeIds: string[]): void {
+		this.assigneeIds = assigneeIds
+	}
+}
+
+export interface Task extends TaskProps {}
