+import { injectable } from 'tsyringe-neo'
+import { Handler, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { Space } from '../entities/Space'
+import { SpaceRepository } from '../repositories/SpaceRepository'
+import { SpaceCreatedEvent } from '../events'
+
+export const CreateSpaceInputSchema = z.object({
+	workspaceId: z.uuid(),
+	name: z.string(),
+	listNames: z.array(z.string()).optional(),
+})
+
+export const CreateSpaceOutputSchema = z.object({
+	spaceId: z.uuid(),
+})
+
+@injectable()
+export class CreateSpace extends Handler<
+	typeof CreateSpaceInputSchema,
+	typeof CreateSpaceOutputSchema
+> {
+	readonly name = 'create_space' as const
+	readonly inputSchema = CreateSpaceInputSchema
+	readonly outputSchema = CreateSpaceOutputSchema
+
+	constructor(private readonly spaceRepository: SpaceRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			// Create space with default statuses and no lists initially.
+			const space = Space.create({
+				workspaceId: input.workspaceId,
+				name: input.name,
+			})
+
+			// Add one SpaceList per provided listName at the next position.
+			for (const listName of input.listNames ?? []) {
+				space.addList({ name: listName })
+			}
+
+			await this.spaceRepository.save(space, tx)
+
+			await this.domainEventRepository.save(
+				new SpaceCreatedEvent({
+					entityId: space.id.value,
+					ownerId: input.workspaceId,
+					payload: {
+						spaceId: space.id.value,
+						workspaceId: input.workspaceId,
+						name: input.name,
+						statuses: space.statuses,
+						listIds: space.listIds(),
+					},
+				}),
+				tx,
+			)
+
+			return { spaceId: space.id.value }
+		})
