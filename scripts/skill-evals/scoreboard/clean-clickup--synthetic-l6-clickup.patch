+import { z } from '@template/core-typescript'
+import Z from 'zod'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import type { TaskCreatedEvent } from '@task/events/TaskCreatedEvent'
+import type { TaskStatusChangedEvent } from '@task/events/TaskStatusChangedEvent'
+
+// ── Event union — single source of truth for the Projector's generic ──────
+export type BoardViewProjectionEvent = TaskCreatedEvent | TaskStatusChangedEvent
+
+// ── Flat schema — no nested VOs, no transforms, no invariants ─────────────
+export const BoardViewProjectionSchema = z.object({
+	taskId: z.uuid(),
+	workspaceId: z.uuid(),
+	spaceId: z.uuid(),
+	listId: z.uuid(),
+	title: z.string(),
+	status: z.enum(TaskStatus),
+	priority: z.enum(TaskPriority),
+	assigneeIds: z.array(z.string()),
+})
+
+export type BoardViewProjectionProps = Z.infer<typeof BoardViewProjectionSchema>
+
+// ── Free record — no base class, no domain events, no invariants ──────────
+export class BoardViewProjection {
+	constructor(public props: BoardViewProjectionProps) {}
+
+	// ── Creation: overloaded — only TaskCreatedEvent can create a board view row ──
+	static create(event: TaskCreatedEvent): BoardViewProjection
+	static create(event: TaskCreatedEvent): BoardViewProjection {
+		return new BoardViewProjection({
+			taskId: event.payload.taskId,
+			workspaceId: event.payload.workspaceId,
+			spaceId: event.payload.spaceId,
+			listId: event.payload.listId,
+			title: event.payload.title,
+			status: event.payload.status,
+			priority: event.payload.priority,
+			assigneeIds: event.payload.assigneeIds,
+		})
+	}
+
+	// ── Mutation: overloaded — TaskStatusChangedEvent moves the card to a new column ──
+	applyEvent(event: TaskStatusChangedEvent): void
+	applyEvent(event: TaskStatusChangedEvent): void {
+		this.props.status = event.payload.toStatus
+	}
+}
