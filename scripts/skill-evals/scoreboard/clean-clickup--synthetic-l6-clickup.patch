+	async insertIfNew(projection: ListViewProjection, tx?: DrizzleClient): Promise<boolean> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc
+				.insert(taskListView)
+				.values(this.toPersistence(projection))
+				.onConflictDoNothing({ target: taskListView.taskId })
+				.returning({ taskId: taskListView.taskId })
+			return rows.length > 0
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async findByTaskId(taskId: string, tx?: DrizzleClient): Promise<ListViewProjection | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(taskListView).where(eq(taskListView.taskId, taskId)).limit(1)
+			return rows[0]
+		})
+		if (!result.success) throw result.error
+		if (!result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async save(projection: ListViewProjection, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(projection)
+			await dbc
+				.insert(taskListView)
+				.values(data)
+				.onConflictDoUpdate({
+					target: taskListView.taskId,
+					set: {
+						workspaceId: data.workspaceId,
+						spaceId: data.spaceId,
+						listId: data.listId,
+						title: data.title,
+						status: data.status,
+						priority: data.priority,
+						assigneeIds: data.assigneeIds,
+						updatedAt: new Date(),
+					},
+				})
+		})
+		if (!result.success) throw result.error
+	}
+
+	async listBySpace(spaceId: string, tx?: DrizzleClient): Promise<ListViewProjection[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			return dbc.select().from(taskListView).where(eq(taskListView.spaceId, spaceId))
+		})
+		if (!result.success) throw result.error
+		return result.data.map(row => this.toDomain(row))
+	}
+
+	private toDomain(row: typeof taskListView.$inferSelect): ListViewProjection {
+		return new ListViewProjection({
+			taskId: row.taskId,
+			workspaceId: row.workspaceId,
+			spaceId: row.spaceId,
+			listId: row.listId,
+			title: row.title,
+			status: row.status as TaskStatus,
+			priority: row.priority as TaskPriority,
+			assigneeIds: (row.assigneeIds as string[]) ?? [],
+		})
+	}
+
+	private toPersistence(projection: ListViewProjection): typeof taskListView.$inferInsert {
+		return {
+			taskId: projection.props.taskId,
+			workspaceId: projection.props.workspaceId,
+			spaceId: projection.props.spaceId,
+			listId: projection.props.listId,
+			title: projection.props.title,
+			status: projection.props.status,
+			priority: projection.props.priority,
+			assigneeIds: projection.props.assigneeIds,
+		}
+	}
+}
+
+// ── In-memory mock for tests ──────────────────────────────────────────────
+@injectable()
+export class MockTaskListViewProjectionRepository extends TaskListViewProjectionRepository {
+	private store = new Map<string, ListViewProjection>()
+
+	async insertIfNew(projection: ListViewProjection): Promise<boolean> {
+		if (this.store.has(projection.props.taskId)) return false
+		this.store.set(projection.props.taskId, projection)
+		return true
+	}
+
+	async findByTaskId(taskId: string): Promise<ListViewProjection | undefined> {
+		return this.store.get(taskId)
+	}
+
+	async save(projection: ListViewProjection): Promise<void> {
+		this.store.set(projection.props.taskId, projection)
+	}
+
+	async listBySpace(spaceId: string): Promise<ListViewProjection[]> {
+		return Array.from(this.store.values()).filter(p => p.props.spaceId === spaceId)
+	}
+}
