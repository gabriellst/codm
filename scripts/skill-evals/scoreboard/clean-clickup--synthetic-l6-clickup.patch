+import { injectable } from 'tsyringe-neo'
+import { Handler, BaseError, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { TaskStatus } from '@template/contracts-typescript/wire/enums'
+import { TaskRepository } from '../repositories/TaskRepository'
+import { TaskStatusChangedEvent } from '../events/TaskStatusChangedEvent'
+import { SpaceRepository } from '@workspace/repositories/SpaceRepository'
+import type { Errors } from '../errors'
+
+export const ChangeStatusInputSchema = z.object({
+	taskId: z.uuid(),
+	status: z.enum(TaskStatus),
+})
+
+export const ChangeStatusOutputSchema = z.void()
+
+@injectable()
+export class ChangeStatus extends Handler<
+	typeof ChangeStatusInputSchema,
+	typeof ChangeStatusOutputSchema
+> {
+	readonly name = 'change_status' as const
+	readonly inputSchema = ChangeStatusInputSchema
+	readonly outputSchema = ChangeStatusOutputSchema
+
+	constructor(
+		private readonly tasks: TaskRepository,
+		private readonly spaces: SpaceRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const task = await this.tasks.findById(input.taskId, tx)
+			if (!task) throw new BaseError<Errors>('TASK_NOT_FOUND')
+
+			const space = await this.spaces.findById(task.spaceId.value, tx)
+			if (!space) throw new BaseError<Errors>('SPACE_NOT_FOUND')
+
+			const fromStatus = task.changeStatus(input.status, space.statuses)
+
+			await this.tasks.save(task, tx)
+
+			await this.domainEventRepository.save(
+				new TaskStatusChangedEvent({
+					entityId: task.id.value,
+					ownerId: task.workspaceId.value,
+					payload: {
+						taskId: task.id.value,
+						workspaceId: task.workspaceId.value,
+						spaceId: task.spaceId.value,
+						listId: task.listId.value,
+						fromStatus,
+						toStatus: input.status,
+					},
+				}),
+				tx,
+			)
+		})
+	}
+}
