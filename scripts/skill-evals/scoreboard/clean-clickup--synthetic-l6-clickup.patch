+import { z } from '@template/core-typescript'
+import Z from 'zod'
+
+export const SpaceListSchema = z.object({
+	listId: z.uuid(),
+	name: z.string().min(1).max(200),
+	position: z.number().int().min(0),
+})
+
+export type SpaceListProps = Z.infer<typeof SpaceListSchema>
+
+/**
+ * SpaceList — immutable value object embedded in a Space aggregate.
+ * Represents an ordered list within a space. No identity outside its parent Space.
+ * Persisted in the `lists` table but loaded/saved ONLY through SpaceRepository.
+ */
+export class SpaceList {
+	readonly listId: string
+	readonly name: string
+	readonly position: number
+
+	constructor(props: SpaceListProps) {
+		const parsed = SpaceListSchema.parse(props)
+		this.listId = parsed.listId
+		this.name = parsed.name
+		this.position = parsed.position
+	}
+
+	static create(props: { listId: string; name: string; position: number }): SpaceList {
+		return new SpaceList(props)
+	}
+}
