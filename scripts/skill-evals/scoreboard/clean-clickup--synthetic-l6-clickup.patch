diff --git a/packages/e2e/tests/clickup-tasks-realtime.spec.ts b/packages/e2e/tests/clickup-tasks-realtime.spec.ts
new file mode 100644
index 000000000..d7d5e52ff
--- /dev/null
+++ b/packages/e2e/tests/clickup-tasks-realtime.spec.ts
@@ -0,0 +1,85 @@
+import { expect, test } from '@playwright/test'
+import { givenFreshUser } from '../utils/given'
+
+/**
+ * ClickUp — realtime Board view.
+ *
+ * Flow (FROZEN, see .plans/clickup-FROZEN.md → "E2E"):
+ *   1. given.freshUser → authenticated session (workspaceId === session.storeId).
+ *   2. ALL state is seeded through the authenticated API (session.client), never the UI:
+ *        create workspace → create space → add a list → create a task (status TODO).
+ *   3. Open the Board view in the browser and assert the card renders in the "To Do" column.
+ *   4. Move the task to IN_PROGRESS **via the API** (session.client) and assert the card
+ *      migrates to the "In Progress" column WITHOUT a reload — the ui `ListenEvents` SSE
+ *      controller relays `integration.shared.task.status_changed` (filtered by workspaceId)
+ *      and the live board re-renders.
+ *
+ * Assertions are web-first (`expect(...).toBeVisible()` auto-waiting) and selector-based
+ * (role + accessible name). No `waitForTimeout`, no `.skip`, no `expect(true)`.
+ */
+
+// A board column is the region labelled by its status; scope card lookups to it so a card
+// is asserted to live in a SPECIFIC column, not merely somewhere on the page.
+const TODO_COLUMN = /to do/i
+const IN_PROGRESS_COLUMN = /in progress/i
+
+test('task card moves columns in realtime when its status changes via the API', async ({ page, context }) => {
+	const { session } = await givenFreshUser(context)
+
+	// ── 1. Seed all state through the authenticated API ──────────────────────────
+	await session.client<{ workspaceId: string }, unknown, { name: string }>({
+		method: 'POST',
+		url: '/v1/workspaces',
+		data: { name: 'Acme HQ' },
+	})
+
+	const { data: space } = await session.client<{ spaceId: string }, unknown, { name: string; listNames?: string[] }>({
+		method: 'POST',
+		url: '/v1/spaces',
+		data: { name: 'Engineering' },
+	})
+
+	const { data: list } = await session.client<{ listId: string }, unknown, { name: string }>({
+		method: 'POST',
+		url: `/v1/spaces/${space.spaceId}/lists`,
+		data: { name: 'Sprint Backlog' },
+	})
+
+	const taskTitle = 'Ship the realtime board'
+	const { data: task } = await session.client<
+		{ taskId: string },
+		unknown,
+		{ spaceId: string; listId: string; title: string; status: string; priority: string }
+	>({
+		method: 'POST',
+		url: '/v1/tasks',
+		data: {
+			spaceId: space.spaceId,
+			listId: list.listId,
+			title: taskTitle,
+			status: 'TODO',
+			priority: 'NORMAL',
+		},
+	})
+
+	// ── 2. Open the Board view ───────────────────────────────────────────────────
+	await page.goto(`/app/spaces/${space.spaceId}/board`)
+
+	const todoColumn = page.getByRole('region', { name: TODO_COLUMN })
+	const inProgressColumn = page.getByRole('region', { name: IN_PROGRESS_COLUMN })
+
+	// Card starts in the "To Do" column.
+	await expect(todoColumn.getByText(taskTitle)).toBeVisible()
+	await expect(inProgressColumn.getByText(taskTitle)).toHaveCount(0)
+
+	// ── 3. Move the task to IN_PROGRESS via the API (no UI interaction, no reload) ─
+	await session.client<undefined, unknown, { status: string }>({
+		method: 'POST',
+		url: `/v1/tasks/${task.taskId}/status`,
+		data: { status: 'IN_PROGRESS' },
+	})
+
+	// ── 4. The board re-renders over SSE: the card migrates columns live ─────────
+	await expect(inProgressColumn.getByText(taskTitle)).toBeVisible()
+	await expect(todoColumn.getByText(taskTitle)).toHaveCount(0)
+})
