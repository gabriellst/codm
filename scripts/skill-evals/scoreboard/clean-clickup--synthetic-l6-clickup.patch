@@ -0,0 +1,52 @@
+import { injectable } from 'tsyringe-neo'
+import { Projector, DrizzleClient } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import type { TaskCreatedEvent } from '@task/events/TaskCreatedEvent'
+import type { TaskStatusChangedEvent } from '@task/events/TaskStatusChangedEvent'
+import { BoardViewProjection, type BoardViewProjectionEvent } from '../BoardViewProjection'
+import { TaskBoardViewProjectionRepository } from '../repositories/TaskBoardViewProjectionRepository'
+
+/**
+ * BoardViewProjector — read-side handler for the BoardViewProjection.
+ *
+ * Subscribes to task domain events and keeps `task.task_board_view` fresh:
+ *  - TaskCreatedEvent       → insertIfNew (creation path)
+ *  - TaskStatusChangedEvent → find → applyEvent → save (canonical mutation; status = column move)
+ *
+ * Note: `event.name` is typed as `string` on BaseDomainEvent, so we cast to the
+ * concrete event type inside each case — identical to the pattern used in all
+ * internal handlers in this codebase.
+ */
+@injectable()
+export class BoardViewProjector extends Projector<BoardViewProjectionEvent> {
+	constructor(private repo: TaskBoardViewProjectionRepository) {
+		super()
+	}
+
+	readonly events = ['task.task.created', 'task.status_changed'] as const
+
+	async handle(event: BoardViewProjectionEvent, tx?: Transaction): Promise<void> {
+		// Transaction is `unknown` at the abstraction boundary; Drizzle repo impls
+		// receive it and use it as DrizzleClient internally.
+		const dbc = tx as DrizzleClient | undefined
+
+		switch (event.name) {
+			// Creation — inserts one board-view row per new task.
+			case 'task.task.created':
+				await this.repo.insertIfNew(BoardViewProjection.create(event as TaskCreatedEvent), dbc)
+				return
+
+			// Canonical mutation — status change is the "column move" on the board.
+			case 'task.status_changed': {
+				const row = await this.repo.findByTaskId((event as TaskStatusChangedEvent).payload.taskId, dbc)
+				if (!row) return // replay-safe no-op
+				row.applyEvent(event as TaskStatusChangedEvent)
+				await this.repo.save(row, dbc)
+				return
+			}
+
+			default:
+				return
+		}
+	}
+}
diff --git a/packages/api/typescript/src/ui/projections/projectors/ListViewProjector.ts b/packages/api/typescript/src/ui/projections/projectors/ListViewProjector.ts
