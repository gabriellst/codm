+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { container, type DependencyContainer } from 'tsyringe-neo'
+import { TestBed, testId } from '@test/support'
+import { DomainEventRepository } from '@template/core-typescript'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { CreateTask } from './CreateTask'
+import { ChangeStatus } from './ChangeStatus'
+import { TaskRepository } from '../repositories/TaskRepository'
+import { TaskCreatedEvent, TaskStatusChangedEvent } from '../events'
+import { SpaceRepository } from '@workspace/repositories'
+import { Space } from '@workspace/entities/Space'
+
+describe('Task use cases (integration)', () => {
+	let testBed: TestBed
+	let testContainer: DependencyContainer
+	let createTask: CreateTask
+	let changeStatus: ChangeStatus
+	let taskRepo: TaskRepository
+	let spaceRepo: SpaceRepository
+
+	// Seeded space data
+	let workspaceId: string
+	let spaceId: string
+	let listId: string
+
+	beforeAll(async () => {
+		testContainer = container.createChildContainer()
+		testBed = await TestBed.create('integration', { testContainer, ownerId: 'integration-tenant' })
+		createTask = testBed.resolve(CreateTask)
+		changeStatus = testBed.resolve(ChangeStatus)
+		taskRepo = testBed.resolve(TaskRepository)
+		spaceRepo = testBed.resolve(SpaceRepository)
+	})
+
+	beforeEach(async () => {
+		await testBed.reset()
+
+		// Seed a Space with one list after each reset so each test starts clean
+		workspaceId = testId('workspace', '1')
+		const space = Space.create({
+			workspaceId,
+			name: 'Test Space',
+			// Use default statuses (TODO, IN_PROGRESS, IN_REVIEW, DONE)
+		})
+		space.addList({ name: 'Todo' })
+		await spaceRepo.save(space)
+
+		spaceId = space.id.value
+		listId = space.listIds()[0]!
+	})
+
+	afterAll(async () => {
+		await testBed.destroy()
+	})
+
+	describe('CreateTask', () => {
+		it('persists the task and emits TaskCreatedEvent', async () => {
+			const { taskId } = await createTask.execute({
+				workspaceId,
+				spaceId,
+				listId,
+				title: 'T1',
+				status: TaskStatus.TODO,
+				priority: TaskPriority.NORMAL,
+			})
+
+			const persisted = await taskRepo.findById(taskId)
+			expect(persisted).toBeDefined()
+			expect(persisted!.status).toBe(TaskStatus.TODO)
+			expect(persisted!.title).toBe('T1')
+
+			const events = await testBed.resolve(DomainEventRepository).findByType(TaskCreatedEvent)
+			expect(events).toHaveLength(1)
+		})
+
+		it('throws SPACE_NOT_FOUND for an unknown spaceId', async () => {
+			await expect(
+				createTask.execute({
+					workspaceId,
+					spaceId: testId('space', 'nonexistent'),
+					listId,
+					title: 'T2',
+					status: TaskStatus.TODO,
+					priority: TaskPriority.NORMAL,
+				}),
+			).rejects.toMatchObject({ name: 'SPACE_NOT_FOUND' })
+		})
+	})
+
+	describe('ChangeStatus', () => {
+		it('transitions the task status and emits TaskStatusChangedEvent', async () => {
+			const { taskId } = await createTask.execute({
+				workspaceId,
+				spaceId,
+				listId,
+				title: 'Status Task',
+				status: TaskStatus.TODO,
+				priority: TaskPriority.NORMAL,
+			})
+
+			await changeStatus.execute({ taskId, status: TaskStatus.IN_PROGRESS })
+
+			const persisted = await taskRepo.findById(taskId)
+			expect(persisted).toBeDefined()
+			expect(persisted!.status).toBe(TaskStatus.IN_PROGRESS)
+
+			const events = await testBed.resolve(DomainEventRepository).findByType(TaskStatusChangedEvent)
+			expect(events.length).toBeGreaterThanOrEqual(1)
+		})
+
+		it('throws TASK_NOT_FOUND for an unknown taskId', async () => {
+			await expect(
+				changeStatus.execute({
+					taskId: testId('task', 'nonexistent'),
+					status: TaskStatus.IN_PROGRESS,
+				}),
+			).rejects.toMatchObject({ name: 'TASK_NOT_FOUND' })
+		})
+	})
+})
