@@ -0,0 +1,81 @@
+import { injectable } from 'tsyringe-neo'
+import { Handler, z } from '@template/core-typescript'
+import Z from 'zod'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { TaskBoardViewProjectionRepository } from '../projections/repositories/TaskBoardViewProjectionRepository'
+
+// ── DTOs ─────────────────────────────────────────────────────────────────
+export const TaskCardDTOSchema = z.object({
+	taskId: z.uuid(),
+	listId: z.uuid(),
+	title: z.string(),
+	status: z.enum(TaskStatus),
+	priority: z.enum(TaskPriority),
+	assigneeIds: z.array(z.string()),
+})
+
+export type TaskCardDTO = Z.infer<typeof TaskCardDTOSchema>
+
+// ── Input / Output ────────────────────────────────────────────────────────
+export const GetBoardViewInputSchema = z.object({
+	workspaceId: z.uuid(),
+	spaceId: z.uuid(),
+})
+
+export const GetBoardViewOutputSchema = z.object({
+	spaceId: z.uuid(),
+	columns: z.array(
+		z.object({
+			status: z.enum(TaskStatus),
+			tasks: z.array(TaskCardDTOSchema),
+		}),
+	),
+})
+
+/**
+ * `GetBoardView` — BFF query for the kanban board.
+ *
+ * Reads the `task_board_view` projection for the given space and groups
+ * tasks by status into ALL FOUR `TaskStatus` columns — including empty ones.
+ * Columns are emitted in the canonical order: TODO, IN_PROGRESS, IN_REVIEW, DONE.
+ */
+@injectable()
+export class GetBoardView extends Handler<typeof GetBoardViewInputSchema, typeof GetBoardViewOutputSchema> {
+	readonly name = 'get_board_view' as const
+	readonly inputSchema = GetBoardViewInputSchema
+	readonly outputSchema = GetBoardViewOutputSchema
+
+	constructor(private readonly repo: TaskBoardViewProjectionRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const rows = await this.repo.listBySpace(input.spaceId)
+
+		// Group tasks by status — ALL FOUR columns always emitted (even if empty).
+		const grouped = new Map<TaskStatus, TaskCardDTO[]>()
+		for (const status of Object.values(TaskStatus)) {
+			grouped.set(status, [])
+		}
+
+		for (const row of rows) {
+			const col = grouped.get(row.props.status) ?? []
+			col.push({
+				taskId: row.props.taskId,
+				listId: row.props.listId,
+				title: row.props.title,
+				status: row.props.status,
+				priority: row.props.priority,
+				assigneeIds: row.props.assigneeIds,
+			})
+			grouped.set(row.props.status, col)
+		}
+
+		const columns = Object.values(TaskStatus).map(status => ({
+			status,
+			tasks: grouped.get(status) ?? [],
+		}))
+
+		return { spaceId: input.spaceId, columns }
+	}
+}
diff --git a/packages/api/typescript/src/ui/usecases/GetListView.ts b/packages/api/typescript/src/ui/usecases/GetListView.ts
