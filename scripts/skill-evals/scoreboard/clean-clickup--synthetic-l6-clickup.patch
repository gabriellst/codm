+import { injectable } from 'tsyringe-neo'
+import { EventHandler, ExternalMediator } from '@template/core-typescript'
+import { TaskStatusChangedEvent as TaskStatusChangedIntegrationEvent } from '@template/contracts-typescript/wire/events'
+import { TaskStatusChangedEvent } from '../events/TaskStatusChangedEvent'
+
+@injectable()
+export class TaskStatusChangedHandler extends EventHandler<typeof TaskStatusChangedEvent> {
+	readonly event = TaskStatusChangedEvent
+	constructor(private readonly externalMediator: ExternalMediator) {
+		super()
+	}
+	async handle(event: this['input']): Promise<this['output']> {
+		await this.externalMediator.publish(
+			new TaskStatusChangedIntegrationEvent({
+				ownerId: event.payload.workspaceId,
+				payload: {
+					workspaceId: event.payload.workspaceId,
+					taskId: event.payload.taskId,
+					fromStatus: event.payload.fromStatus,
+					toStatus: event.payload.toStatus,
+				},
+			}),
+		)
+		return
+	}
+}
