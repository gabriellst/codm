+++ b/packages/contracts/db/schema/task.ts
@@ -0,0 +1,111 @@
+import { pgSchema, uuid, text, integer, jsonb, timestamp, index } from 'drizzle-orm/pg-core'
+
+/**
+ * `task` BC schema.
+ *
+ * Contains the Task write-model table and two read-model projection tables
+ * (list view and board view) used by BFF queries.
+ *
+ * Tables:
+ *   - `tasks`           — write-model (authoritative task state)
+ *   - `task_list_view`  — READ MODEL: ListViewProjection, one row per task, indexed for list queries
+ *   - `task_board_view` — READ MODEL: BoardViewProjection, one row per task, indexed for board queries
+ */
+export const taskSchema = pgSchema('task')
+
+export const tasks = taskSchema.table(
+	'tasks',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		// Tenant workspace (== storeId).
+		workspaceId: uuid('workspace_id').notNull(),
+
+		// Parent space.
+		spaceId: uuid('space_id').notNull(),
+
+		// Parent list within the space (SpaceList VO id).
+		listId: uuid('list_id').notNull(),
+
+		// Human-readable task title.
+		title: text('title').notNull(),
+
+		// TaskStatus string value (membership validated at use-case level).
+		status: text('status').notNull(),
+
+		// TaskPriority string value.
+		priority: text('priority').notNull(),
+
+		// Array of user-id strings (assignees). Default empty array.
+		assigneeIds: jsonb('assignee_ids').notNull().default('[]'),
+
+		// Audit / optimistic concurrency.
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		spaceIdx: index('tasks_space_id_idx').on(t.spaceId),
+		listIdx: index('tasks_list_id_idx').on(t.listId),
+	}),
+)
+
+/**
+ * `task_list_view` — READ MODEL (ListViewProjection).
+ *
+ * One row per task, maintained by the ListViewProjector. Indexed for
+ * efficient list-grouped queries (GetListView BFF: all tasks in a space,
+ * grouped by list ordered by position).
+ */
+export const taskListView = taskSchema.table(
+	'task_list_view',
+	{
+		taskId: uuid('task_id').primaryKey(),
+
+		workspaceId: uuid('workspace_id').notNull(),
+		spaceId: uuid('space_id').notNull(),
+		listId: uuid('list_id').notNull(),
+		title: text('title').notNull(),
+		status: text('status').notNull(),
+		priority: text('priority').notNull(),
+		assigneeIds: jsonb('assignee_ids').notNull().default('[]'),
+
+		// Audit / optimistic concurrency.
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		spaceListIdx: index('task_list_view_space_list_idx').on(t.spaceId, t.listId),
+	}),
+)
+
+/**
+ * `task_board_view` — READ MODEL (BoardViewProjection).
+ *
+ * One row per task, maintained by the BoardViewProjector. Indexed for
+ * efficient status-column queries (GetBoardView BFF: all tasks in a space,
+ * grouped by status).
+ */
+export const taskBoardView = taskSchema.table(
