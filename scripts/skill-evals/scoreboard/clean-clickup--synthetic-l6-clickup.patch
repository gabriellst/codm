diff --git a/packages/api/typescript/src/ui/projections/repositories/TaskBoardViewProjectionRepository.ts b/packages/api/typescript/src/ui/projections/repositories/TaskBoardViewProjectionRepository.ts
new file mode 100644
index 000000000..959da0f07
--- /dev/null
+++ b/packages/api/typescript/src/ui/projections/repositories/TaskBoardViewProjectionRepository.ts
@@ -0,0 +1,130 @@
+import { injectable } from 'tsyringe-neo'
+import { eq, and } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { taskBoardView } from '@template/contracts/db'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { BoardViewProjection } from '../BoardViewProjection'
+
+// ── Abstract repo — defines the ops this projection needs ────────────────
+export abstract class TaskBoardViewProjectionRepository {
+	abstract insertIfNew(projection: BoardViewProjection, tx?: DrizzleClient): Promise<boolean>
+	abstract findByTaskId(taskId: string, tx?: DrizzleClient): Promise<BoardViewProjection | undefined>
+	abstract save(projection: BoardViewProjection, tx?: DrizzleClient): Promise<void>
+	abstract listBySpace(spaceId: string, tx?: DrizzleClient): Promise<BoardViewProjection[]>
+}
+
+// ── Drizzle implementation ────────────────────────────────────────────────
+@injectable()
+export class DrizzleTaskBoardViewProjectionRepository extends TaskBoardViewProjectionRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async insertIfNew(projection: BoardViewProjection, tx?: DrizzleClient): Promise<boolean> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc
+				.insert(taskBoardView)
+				.values(this.toPersistence(projection))
+				.onConflictDoNothing({ target: taskBoardView.taskId })
+				.returning({ taskId: taskBoardView.taskId })
+			return rows.length > 0
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async findByTaskId(taskId: string, tx?: DrizzleClient): Promise<BoardViewProjection | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(taskBoardView).where(eq(taskBoardView.taskId, taskId)).limit(1)
+			return rows[0]
+		})
+		if (!result.success) throw result.error
+		if (!result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async save(projection: BoardViewProjection, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(projection)
+			await dbc
+				.insert(taskBoardView)
+				.values(data)
+				.onConflictDoUpdate({
+					target: taskBoardView.taskId,
+					set: {
+						workspaceId: data.workspaceId,
+						spaceId: data.spaceId,
+						listId: data.listId,
+						title: data.title,
+						status: data.status,
+						priority: data.priority,
+						assigneeIds: data.assigneeIds,
+						updatedAt: new Date(),
+					},
+				})
+		})
+		if (!result.success) throw result.error
+	}
+
+	async listBySpace(spaceId: string, tx?: DrizzleClient): Promise<BoardViewProjection[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			return dbc.select().from(taskBoardView).where(eq(taskBoardView.spaceId, spaceId))
+		})
+		if (!result.success) throw result.error
+		return result.data.map(row => this.toDomain(row))
+	}
+
+	private toDomain(row: typeof taskBoardView.$inferSelect): BoardViewProjection {
+		return new BoardViewProjection({
+			taskId: row.taskId,
+			workspaceId: row.workspaceId,
+			spaceId: row.spaceId,
+			listId: row.listId,
+			title: row.title,
+			status: row.status as TaskStatus,
+			priority: row.priority as TaskPriority,
+			assigneeIds: (row.assigneeIds as string[]) ?? [],
+		})
+	}
+
+	private toPersistence(projection: BoardViewProjection): typeof taskBoardView.$inferInsert {
+		return {
+			taskId: projection.props.taskId,
+			workspaceId: projection.props.workspaceId,
+			spaceId: projection.props.spaceId,
+			listId: projection.props.listId,
+			title: projection.props.title,
+			status: projection.props.status,
+			priority: projection.props.priority,
+			assigneeIds: projection.props.assigneeIds,
+		}
+	}
+}
+
+// ── In-memory mock for tests ──────────────────────────────────────────────
+@injectable()
+export class MockTaskBoardViewProjectionRepository extends TaskBoardViewProjectionRepository {
+	private store = new Map<string, BoardViewProjection>()
+
+	async insertIfNew(projection: BoardViewProjection): Promise<boolean> {
+		if (this.store.has(projection.props.taskId)) return false
+		this.store.set(projection.props.taskId, projection)
+		return true
+	}
+
+	async findByTaskId(taskId: string): Promise<BoardViewProjection | undefined> {
+		return this.store.get(taskId)
+	}
+
+	async save(projection: BoardViewProjection): Promise<void> {
+		this.store.set(projection.props.taskId, projection)
+	}
+
+	async listBySpace(spaceId: string): Promise<BoardViewProjection[]> {
+		return Array.from(this.store.values()).filter(p => p.props.spaceId === spaceId)
+	}
+}
