@@ -0,0 +1,65 @@
+import { AggregateRoot, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import { TaskStatus } from '@template/contracts-typescript/wire/enums'
+import { SpaceList } from '../objects/SpaceList'
+
+const DEFAULT_STATUSES: TaskStatus[] = [
+	TaskStatus.TODO,
+	TaskStatus.IN_PROGRESS,
+	TaskStatus.IN_REVIEW,
+	TaskStatus.DONE,
+]
+
+const SpaceSchema = z.object({
+	workspaceId: z.instance(Id),
+	name: z.string().min(1).max(200),
+	lists: z.array(z.custom<SpaceList>(v => v instanceof SpaceList)).default([]),
+	statuses: z.array(z.enum(TaskStatus)).default(DEFAULT_STATUSES),
+})
+
+export type SpaceProps = Z.infer<typeof SpaceSchema>
+
+/**
+ * Space aggregate root. Workflow container inside a Workspace.
+ * Owns SpaceList value objects (persisted in `lists` table but loaded/saved only here).
+ * Owns `statuses` — the allowed TaskStatus values for tasks in this space.
+ */
+export class Space extends AggregateRoot<typeof SpaceSchema> {
+	static override schema = SpaceSchema
+
+	static create(data: {
+		workspaceId: string
+		name: string
+		lists?: SpaceList[]
+		statuses?: TaskStatus[]
+	}): Space {
+		return new Space({
+			workspaceId: new Id(data.workspaceId),
+			name: data.name,
+			lists: data.lists ?? [],
+			statuses: data.statuses ?? DEFAULT_STATUSES,
+		})
+	}
+
+	/**
+	 * Append a new SpaceList at the next position.
+	 */
+	addList(params: { name: string }): void {
+		const position = this.lists.length
+		const listItem = SpaceList.create({
+			listId: new Id().value,
+			name: params.name,
+			position,
+		})
+		this.lists.push(listItem)
+	}
+
+	/**
+	 * Returns all list IDs in order. Used by the `task` context for membership checks.
+	 */
+	listIds(): string[] {
+		return this.lists.map(l => l.listId)
+	}
+}
+
+export interface Space extends SpaceProps {}
