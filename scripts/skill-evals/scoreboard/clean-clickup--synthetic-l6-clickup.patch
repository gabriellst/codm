diff --git a/packages/api/typescript/src/workspace/repositories/SpaceRepository/DrizzleSpaceRepository.ts b/packages/api/typescript/src/workspace/repositories/SpaceRepository/DrizzleSpaceRepository.ts
new file mode 100644
index 000000000..fa88ef091
--- /dev/null
+++ b/packages/api/typescript/src/workspace/repositories/SpaceRepository/DrizzleSpaceRepository.ts
@@ -0,0 +1,142 @@
+import { injectable } from 'tsyringe-neo'
+import { eq, asc } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { spaces, lists } from '@template/contracts/db'
+import { TaskStatus } from '@template/contracts-typescript/wire/enums'
+import { Space } from '../../entities/Space'
+import { SpaceList } from '../../objects/SpaceList'
+import { SpaceRepository } from './SpaceRepository'
+
+@injectable()
+export class DrizzleSpaceRepository extends SpaceRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	/**
+	 * Load a Space by ID, hydrating its SpaceList VOs from the `lists` table
+	 * (ordered by position) and its statuses from the `spaces` row.
+	 */
+	async findById(id: string, tx?: DrizzleClient): Promise<Space | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(spaces).where(eq(spaces.id, id)).limit(1)
+			const row = rows[0]
+			if (!row) return undefined
+
+			const listRows = await dbc
+				.select()
+				.from(lists)
+				.where(eq(lists.spaceId, id))
+				.orderBy(asc(lists.position))
+
+			return { row, listRows }
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data.row, result.data.listRows)
+	}
+
+	/**
+	 * Persist the Space: UPSERT the spaces row and sync the lists table —
+	 * inserting any new SpaceList VOs that don't exist yet.
+	 */
+	async save(entity: Space, tx?: DrizzleClient): Promise<Space> {
+		entity.incrementVersion()
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+
+			// 1. Upsert the spaces row.
+			await dbc
+				.insert(spaces)
+				.values(data.space)
+				.onConflictDoUpdate({
+					target: spaces.id,
+					set: {
+						name: data.space.name,
+						statuses: data.space.statuses,
+						updatedAt: new Date(),
+						version: data.space.version,
+					},
+				})
+
+			// 2. Sync lists: insert any new SpaceList VOs (identified by listId).
+			//    Existing rows are left untouched (position is immutable after creation).
+			for (const listData of data.lists) {
+				await dbc
+					.insert(lists)
+					.values(listData)
+					.onConflictDoUpdate({
+						target: lists.id,
+						set: {
+							name: listData.name,
+							position: listData.position,
+							updatedAt: new Date(),
+						},
+					})
+			}
+
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc.delete(spaces).where(eq(spaces.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(
+		row: typeof spaces.$inferSelect,
+		listRows: (typeof lists.$inferSelect)[],
+	): Space {
+		const spaceListVOs = listRows.map(
+			l =>
+				new SpaceList({
+					listId: l.id,
+					name: l.name,
+					position: l.position,
+				}),
+		)
+
+		const parsed = Space.schema.parse({
+			workspaceId: row.workspaceId,
+			name: row.name,
+			lists: spaceListVOs,
+			statuses: row.statuses as TaskStatus[],
+		})
+
+		return new Space({
+			...parsed,
+			id: row.id,
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: Space): {
+		space: typeof spaces.$inferInsert
+		lists: (typeof lists.$inferInsert)[]
+	} {
+		return {
+			space: {
+				id: entity.id.value,
+				workspaceId: entity.workspaceId.value,
+				name: entity.name,
+				statuses: entity.statuses,
+				version: entity.version,
+			},
+			lists: entity.lists.map(l => ({
+				id: l.listId,
+				spaceId: entity.id.value,
+				name: l.name,
+				position: l.position,
+			})),
+		}
+	}
+}
