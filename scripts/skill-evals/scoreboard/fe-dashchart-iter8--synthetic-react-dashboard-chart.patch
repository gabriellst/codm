+import { createFileRoute } from '@tanstack/react-router'
+import { zodValidator } from '@/lib/zod-validator'
+import { z } from 'zod'
+import { startOfDay, endOfDay, subDays } from 'date-fns'
+
+import { ChartTypeEnum } from '@template/client-typescript/typescript'
+import { RouteError } from '@/components/RouteError'
+import { ReportsChartSection } from './-components/ReportsChartSection'
+
+// ─── Search schema ────────────────────────────────────────────────────────────
+// chartType + date range live in the URL so the view is bookmarkable and shareable.
+// tenancyScope comes from the app-global store; frequency is fixed at DAILY.
+
+const reportsSearchSchema = z.object({
+	chartType: z.enum(ChartTypeEnum).optional().default(ChartTypeEnum.income),
+	startDate: z.string().optional().default(() => startOfDay(subDays(new Date(), 29)).toISOString()),
+	endDate: z.string().optional().default(() => endOfDay(new Date()).toISOString()),
+})
+
+export type ReportsSearch = z.infer<typeof reportsSearchSchema>
+
+// ─── Route ────────────────────────────────────────────────────────────────────
+
+export const Route = createFileRoute('/(app)/reports/')({
+	staticData: { breadcrumb: 'Relatórios de Vendas' },
+	validateSearch: zodValidator(reportsSearchSchema),
+	errorComponent: RouteError,
+	component: RouteComponent,
+})
+
+function RouteComponent() {
+	return (
+		<div className="flex flex-1 flex-col gap-6 overflow-y-auto p-6 md:p-8">
+			<ReportsChartSection />
+		</div>
+	)
+}
