new file mode 100644
index 000000000..b7b9eff90
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/boards/$boardId/-components/BoardSection/index.tsx
@@ -0,0 +1,171 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useQueryClient } from '@tanstack/react-query'
+import { toast } from 'sonner'
+import {
+	useGetBoardView,
+	getBoardViewQueryKey,
+	useMoveCard,
+	type GetBoardViewQueryResponse,
+} from '@template/client-typescript/typescript'
+import type { VariantProps } from 'class-variance-authority'
+
+import { Badge, badgeVariants } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { cn } from '@/lib/utils'
+import { useServerEvents } from '@/hooks'
+import { useDialogStore } from '@/stores/useDialogStore'
+
+import { AddListDialog } from '../AddListDialog'
+import { CreateCardDialog } from '../CreateCardDialog'
+
+type BoardList = GetBoardViewQueryResponse['lists'][number]
+type BoardCard = BoardList['cards'][number]
+
+const routeApi = getRouteApi('/(app)/boards/$boardId/')
+
+const STATUS_BADGE_VARIANT: Record<string, VariantProps<typeof badgeVariants>['variant']> = {
+	ACTIVE: 'success',
+	ARCHIVED: 'secondary',
+}
+
+const STATUS_I18N_KEY: Record<string, 'enums.BoardStatus.ACTIVE' | 'enums.BoardStatus.ARCHIVED'> = {
+	ACTIVE: 'enums.BoardStatus.ACTIVE',
+	ARCHIVED: 'enums.BoardStatus.ARCHIVED',
+}
+
+function BoardSkeleton() {
+	return (
+		<div className="flex gap-4 p-6">
+			{[1, 2, 3].map(key => (
+				<div key={key} className="flex flex-col gap-2 min-w-[280px]">
+					<Skeleton className="h-8 w-40" />
+					{[1, 2].map(i => (
+						<Skeleton key={i} className="h-20 w-full rounded-lg" />
+					))}
+				</div>
+			))}
+		</div>
+	)
+}
+
+function CardItem({ card, boardId, lists, currentListIndex }: { card: BoardCard; boardId: string; lists: BoardList[]; currentListIndex: number }) {
+	const { t } = useTranslation()
+	const queryClient = useQueryClient()
+
+	const moveCard = useMoveCard({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('kanban.board.moveSuccessToast'))
+				queryClient.invalidateQueries({ queryKey: getBoardViewQueryKey(boardId) })
+			},
+		},
+	})
+
+	const handleMove = () => {
+		const nextIndex = (currentListIndex + 1) % lists.length
+		const targetList = lists[nextIndex]
+		if (!targetList) return
+		moveCard.mutate({ boardId, cardId: card.id, data: { listId: targetList.id, position: 0 } })
+	}
+
+	return (
+		<Card className="p-3">
+			<div className="flex items-start justify-between gap-2">
+				<span className="text-sm font-medium text-foreground">{card.title}</span>
+				{lists.length > 1 && (
+					<Button
+						variant="ghost"
+						size="sm"
+						onClick={handleMove}
+						disabled={moveCard.isPending}
+						aria-label={t('kanban.board.moveCard')}
+					>
+						{t('kanban.board.moveCard')}
+					</Button>
+				)}
+			</div>
+		</Card>
+	)
+}
+
+function ListColumn({ list, boardId, lists, listIndex }: { list: BoardList; boardId: string; lists: BoardList[]; listIndex: number }) {
+	const { t } = useTranslation()
+	const { show } = useDialogStore()
+
+	return (
+		<div className="flex flex-col gap-2 min-w-[280px]">
+			<div className="flex items-center justify-between">
+				<h3 className="font-semibold text-foreground">{list.name}</h3>
+				<Button
+					variant="ghost"
+					size="sm"
+					onClick={() => show(<CreateCardDialog boardId={boardId} listId={list.id} />)}
+				>
+					{t('kanban.board.addCard')}
+				</Button>
+			</div>
+			<div className="flex flex-col gap-2" role="list" aria-label={list.name}>
+				{list.cards.map(card => (
+					<div key={card.id} role="listitem">
+						<CardItem card={card} boardId={boardId} lists={lists} currentListIndex={listIndex} />
+					</div>
+				))}
+			</div>
+		</div>
+	)
+}
+
+export function BoardSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { boardId } = routeApi.useParams()
+	const queryClient = useQueryClient()
+	const { show } = useDialogStore()
+
+	const { data, isPending } = useGetBoardView(boardId)
+
+	useServerEvents('integration.shared.card.moved', event => {
+		if (event.payload.boardId !== boardId) return
+		queryClient.invalidateQueries({ queryKey: getBoardViewQueryKey(boardId) })
+	})
+
+	return (
+		<div className={cn('flex flex-1 flex-col', className)} {...props}>
+			{isPending ? (
+				<BoardSkeleton />
+			) : !data ? null : (
+				<>
+					<div className="flex items-center gap-3 p-6 pb-4 border-b border-border/60">
+						<h1 className="text-2xl font-bold text-foreground">{data.name}</h1>
+						<Badge variant={STATUS_BADGE_VARIANT[data.status] ?? 'secondary'}>
+							{t(STATUS_I18N_KEY[data.status] ?? 'enums.BoardStatus.ACTIVE')}
+						</Badge>
+						<Button
+							variant="outline"
+							size="sm"
+							className="ml-auto"
+							onClick={() => show(<AddListDialog boardId={boardId} />)}
+						>
+							{t('kanban.board.addList')}
+						</Button>
+					</div>
+
+					{data.lists.length === 0 ? (
+						<p className="p-6 text-sm text-muted-foreground">{t('kanban.board.emptyLists')}</p>
+					) : (
+						<div className="flex gap-4 p-6 overflow-x-auto" role="list" aria-label={data.name}>
+							{data.lists.map((list, listIndex) => (
+								<div key={list.id} role="listitem">
+									<ListColumn list={list} boardId={boardId} lists={data.lists} listIndex={listIndex} />
+								</div>
+							))}
+						</div>
+					)}
+				</>
+			)}
+		</div>
+	)
+}
