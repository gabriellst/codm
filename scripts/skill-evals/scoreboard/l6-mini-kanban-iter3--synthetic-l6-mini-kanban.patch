diff --git a/packages/api/typescript/src/ui/projections/BoardViewProjection.ts b/packages/api/typescript/src/ui/projections/BoardViewProjection.ts
new file mode 100644
index 000000000..13766956f
--- /dev/null
+++ b/packages/api/typescript/src/ui/projections/BoardViewProjection.ts
@@ -0,0 +1,90 @@
+import { z } from 'zod'
+import { BoardCreatedEvent } from '@board/events'
+import { ListAddedEvent } from '@board/events'
+import { CardCreatedEvent } from '@card/events'
+import { CardMovedDomainEvent } from '@card/events'
+
+export type BoardViewProjectionEvent = BoardCreatedEvent | ListAddedEvent | CardCreatedEvent | CardMovedDomainEvent
+
+const BoardViewCardSchema = z.object({
+	id: z.string(),
+	title: z.string(),
+	position: z.number(),
+})
+
+const BoardViewListSchema = z.object({
+	id: z.string(),
+	name: z.string(),
+	position: z.number(),
+	cards: z.array(BoardViewCardSchema),
+})
+
+const BoardViewProjectionSchema = z.object({
+	boardId: z.string(),
+	storeId: z.string(),
+	name: z.string(),
+	status: z.string(),
+	lists: z.array(BoardViewListSchema),
+})
+
+export type BoardViewCard = z.infer<typeof BoardViewCardSchema>
+export type BoardViewList = z.infer<typeof BoardViewListSchema>
+export type BoardViewProjectionProps = z.infer<typeof BoardViewProjectionSchema>
+
+export class BoardViewProjection {
+	constructor(public props: BoardViewProjectionProps) {}
+
+	static create(event: BoardCreatedEvent): BoardViewProjection {
+		if (!event.entityId) throw new Error('BoardCreatedEvent missing entityId')
+		return new BoardViewProjection({
+			boardId: event.entityId,
+			storeId: event.payload.board.storeId,
+			name: event.payload.board.name,
+			status: event.payload.board.status,
+			lists: [],
+		})
+	}
+
+	applyEvent(event: ListAddedEvent | CardCreatedEvent | CardMovedDomainEvent): void {
+		switch (event.name) {
+			case ListAddedEvent.name: {
+				const e = event as ListAddedEvent
+				this.props.lists.push({
+					id: e.payload.list.id,
+					name: e.payload.list.name,
+					position: e.payload.list.position,
+					cards: [],
+				})
+				this.props.lists.sort((a, b) => a.position - b.position)
+				break
+			}
+			case CardCreatedEvent.name: {
+				const e = event as CardCreatedEvent
+				if (!e.entityId) return
+				const list = this.props.lists.find(l => l.id === e.payload.card.listId)
+				if (!list) return
+				list.cards.push({
+					id: e.entityId,
+					title: e.payload.card.title,
+					position: e.payload.card.position ?? 0,
+				})
+				list.cards.sort((a, b) => a.position - b.position)
+				break
+			}
+			case CardMovedDomainEvent.name: {
+				const e = event as CardMovedDomainEvent
+				const { cardId, fromListId, toListId } = e.payload
+				const fromList = this.props.lists.find(l => l.id === fromListId)
+				const toList = this.props.lists.find(l => l.id === toListId)
+				if (!fromList || !toList) return
+				const cardIdx = fromList.cards.findIndex(c => c.id === cardId)
+				if (cardIdx === -1) return
+				const [card] = fromList.cards.splice(cardIdx, 1)
+				if (!card) return
+				toList.cards.push(card)
+				toList.cards.sort((a, b) => a.position - b.position)
+				break
+			}
+		}
+	}
+}
diff --git a/packages/api/typescript/src/ui/projections/BoardViewProjectionRepository.ts b/packages/api/typescript/src/ui/projections/BoardViewProjectionRepository.ts
new file mode 100644
index 000000000..e84adc64f
--- /dev/null
+++ b/packages/api/typescript/src/ui/projections/BoardViewProjectionRepository.ts
@@ -0,0 +1,79 @@
+import { injectable } from 'tsyringe-neo'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { eq } from 'drizzle-orm'
+import { boardViewProjections } from '@template/contracts/db'
+import { BoardViewProjection, type BoardViewProjectionProps } from './BoardViewProjection'
+
+/**
+ * Port — infra-agnostic. All signatures use Transaction (unknown).
+ *   - findByBoardId: read half of `find → applyEvent → save`
+ *   - save: write half
+ *   - insertIfNew: replay-safe creation (ON CONFLICT DO NOTHING)
+ */
+export abstract class BoardViewProjectionRepository {
+	abstract findByBoardId(boardId: string, tx?: Transaction): Promise<BoardViewProjection | undefined>
+	abstract save(projection: BoardViewProjection, tx?: Transaction): Promise<void>
+	abstract insertIfNew(projection: BoardViewProjection, tx?: Transaction): Promise<void>
+}
+
+@injectable()
+export class DrizzleBoardViewProjectionRepository extends BoardViewProjectionRepository {
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	async findByBoardId(boardId: string, tx?: Transaction): Promise<BoardViewProjection | undefined> {
+		const dbc = (tx as DrizzleClient | undefined) ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(boardViewProjections).where(eq(boardViewProjections.boardId, boardId)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return new BoardViewProjection(result.data.snapshot as BoardViewProjectionProps)
+	}
+
+	async save(projection: BoardViewProjection, tx?: Transaction): Promise<void> {
+		const dbc = (tx as DrizzleClient | undefined) ?? this.db
+		await tryCatchAsync(async () => {
+			await dbc
+				.update(boardViewProjections)
+				.set({ snapshot: projection.props, updatedAt: new Date() })
+				.where(eq(boardViewProjections.boardId, projection.props.boardId))
+		})
+	}
+
+	async insertIfNew(projection: BoardViewProjection, tx?: Transaction): Promise<void> {
+		const dbc = (tx as DrizzleClient | undefined) ?? this.db
+		await tryCatchAsync(async () => {
+			await dbc
+				.insert(boardViewProjections)
+				.values({
+					boardId: projection.props.boardId,
+					storeId: projection.props.storeId,
+					snapshot: projection.props,
+					updatedAt: new Date(),
+				})
+				.onConflictDoNothing()
+		})
+	}
+}
+
+@injectable()
+export class MockBoardViewProjectionRepository extends BoardViewProjectionRepository {
+	private rows = new Map<string, BoardViewProjection>()
+
+	async findByBoardId(boardId: string, _tx?: Transaction): Promise<BoardViewProjection | undefined> {
+		return this.rows.get(boardId)
+	}
+
+	async save(projection: BoardViewProjection, _tx?: Transaction): Promise<void> {
+		this.rows.set(projection.props.boardId, projection)
+	}
+
+	async insertIfNew(projection: BoardViewProjection, _tx?: Transaction): Promise<void> {
+		if (!this.rows.has(projection.props.boardId)) {
+			this.rows.set(projection.props.boardId, projection)
+		}
+	}
+}
