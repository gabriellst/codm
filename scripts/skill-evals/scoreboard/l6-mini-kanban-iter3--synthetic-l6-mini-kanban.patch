@@ -0,0 +1,54 @@
+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z } from '@template/core-typescript'
+import type { UiApplicationErrors } from '../errors'
+import { BoardViewProjectionRepository } from '../projections/BoardViewProjectionRepository'
+
+export const GetBoardViewInputSchema = z.object({
+	boardId: z.uuid(),
+	storeId: z.uuid(),
+})
+
+export const GetBoardViewOutputSchema = z.object({
+	boardId: z.uuid(),
+	storeId: z.uuid(),
+	name: z.string(),
+	status: z.string(),
+	lists: z.array(
+		z.object({
+			id: z.uuid(),
+			name: z.string(),
+			position: z.number(),
+			cards: z.array(
+				z.object({
+					id: z.uuid(),
+					title: z.string(),
+					position: z.number(),
+				}),
+			),
+		}),
+	),
+})
+
+/**
+ * `GetBoardView` — reads the board view projection snapshot for a single board.
+ * The snapshot already carries the full ordered list+card structure materialized
+ * by `BoardViewProjector`. Throws BOARD_VIEW_NOT_FOUND when no projection exists.
+ */
+@injectable()
+export class GetBoardView extends Handler<typeof GetBoardViewInputSchema, typeof GetBoardViewOutputSchema> {
+	readonly name = 'get_board_view' as const
+	readonly inputSchema = GetBoardViewInputSchema
+	readonly outputSchema = GetBoardViewOutputSchema
+
+	constructor(private readonly boardViews: BoardViewProjectionRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const projection = await this.boardViews.findByBoardId(input.boardId)
+		if (!projection) {
+			throw new BaseError<UiApplicationErrors>('BOARD_VIEW_NOT_FOUND')
+		}
+		return projection.props
+	}
+}
diff --git a/packages/api/typescript/src/ui/usecases/ListBoards.ts b/packages/api/typescript/src/ui/usecases/ListBoards.ts
