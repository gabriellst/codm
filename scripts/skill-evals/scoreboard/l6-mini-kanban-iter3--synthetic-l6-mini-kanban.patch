diff --git a/packages/e2e/tests/kanban-board-realtime.spec.ts b/packages/e2e/tests/kanban-board-realtime.spec.ts
new file mode 100644
index 000000000..902d11e03
--- /dev/null
+++ b/packages/e2e/tests/kanban-board-realtime.spec.ts
@@ -0,0 +1,68 @@
+import { expect, test } from '@playwright/test'
+
+/**
+ * Verifies that a card moved via the API appears in its new column in the board view
+ * without a page reload — driven by the SSE CardMovedEvent → useServerEvents invalidation.
+ *
+ * Setup path: page.request (shares browser cookies with the page context) creates the
+ * board, lists, and card via the REST API. The move is also triggered via API so the
+ * SSE path is exercised, not a UI drag-and-drop.
+ */
+test('board view updates in real-time when a card is moved via API', async ({ page }) => {
+	const email = `kanban-e2e-${Date.now()}@test.invalid`
+	const password = 'E2ePassword1!'
+
+	// Sign up — page.request shares the browser cookie jar so subsequent requests
+	// and page navigations are authenticated with the same session.
+	const signUpRes = await page.request.post('http://localhost:3030/api/auth/sign-up/email', {
+		data: { email, password, name: 'E2E Kanban User' },
+	})
+	expect(signUpRes.ok()).toBeTruthy()
+
+	// Create a board
+	const boardRes = await page.request.post('http://localhost:3030/v1/board/boards', {
+		data: { name: 'E2E Test Board' },
+	})
+	expect(boardRes.ok()).toBeTruthy()
+	const { boardId } = await boardRes.json()
+
+	// Add two lists
+	const list1Res = await page.request.post(`http://localhost:3030/v1/board/boards/${boardId}/lists`, {
+		data: { name: 'To Do' },
+	})
+	expect(list1Res.ok()).toBeTruthy()
+	const { listId: list1Id } = await list1Res.json()
+
+	const list2Res = await page.request.post(`http://localhost:3030/v1/board/boards/${boardId}/lists`, {
+		data: { name: 'Done' },
+	})
+	expect(list2Res.ok()).toBeTruthy()
+	const { listId: list2Id } = await list2Res.json()
+
+	// Create a card on the first list
+	const cardRes = await page.request.post(`http://localhost:3030/v1/card/boards/${boardId}/cards`, {
+		data: { listId: list1Id, title: 'Real-Time Card', position: 0 },
+	})
+	expect(cardRes.ok()).toBeTruthy()
+	const { cardId } = await cardRes.json()
+
+	// Open the board page
+	await page.goto(`/app/boards/${boardId}`)
+	await expect(page.getByRole('heading', { name: 'E2E Test Board', level: 1 })).toBeVisible()
+
+	// Card starts in "To Do"
+	const todoList = page.getByRole('list', { name: 'To Do' })
+	await expect(todoList.getByText('Real-Time Card')).toBeVisible()
+
+	// Move the card via API — triggers CardMovedDomainEvent → CardMovedIntegrationEvent → SSE
+	const moveRes = await page.request.patch(
+		`http://localhost:3030/v1/card/boards/${boardId}/cards/${cardId}/move`,
+		{ data: { listId: list2Id, position: 0 } },
+	)
+	expect(moveRes.ok()).toBeTruthy()
+
+	// Without page.reload(): the SSE event invalidates getBoardViewQueryKey and the UI re-renders
+	const doneList = page.getByRole('list', { name: 'Done' })
+	await expect(doneList.getByText('Real-Time Card')).toBeVisible()
+	await expect(todoList.getByText('Real-Time Card')).not.toBeVisible()
+})
