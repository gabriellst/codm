+}
diff --git a/packages/api/typescript/src/card/repositories/CardRepository/DrizzleCardRepository.ts b/packages/api/typescript/src/card/repositories/CardRepository/DrizzleCardRepository.ts
new file mode 100644
index 000000000..0cc28cd79
--- /dev/null
+++ b/packages/api/typescript/src/card/repositories/CardRepository/DrizzleCardRepository.ts
@@ -0,0 +1,93 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { cards } from '@template/contracts/db'
+import { Card, CardSchema } from '../../entities/Card'
+import { CardRepository } from './CardRepository'
+
+@injectable()
+export class DrizzleCardRepository extends CardRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<Card | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(cards).where(eq(cards.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async listByBoardId(boardId: string, tx?: DrizzleClient): Promise<Card[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			return await dbc.select().from(cards).where(eq(cards.boardId, boardId))
+		})
+		if (!result.success) throw result.error
+		return (result.data ?? []).map(row => this.toDomain(row))
+	}
+
+	async save(entity: Card, tx?: DrizzleClient): Promise<Card> {
+		entity.incrementVersion()
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+			await dbc
+				.insert(cards)
+				.values(data)
+				.onConflictDoUpdate({
+					target: cards.id,
+					set: {
+						listId: data.listId,
+						title: data.title,
+						position: data.position,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc.delete(cards).where(eq(cards.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: typeof cards.$inferSelect): Card {
+		const parsed = CardSchema.parse({
+			boardId: row.boardId,
+			storeId: row.storeId,
+			listId: row.listId,
+			title: row.title,
+			position: row.position,
+		})
+		return new Card({
+			...parsed,
+			id: row.id,
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: Card): typeof cards.$inferInsert {
+		return {
+			id: entity.id.value,
+			boardId: entity.boardId.value,
+			storeId: entity.storeId.value,
+			listId: entity.listId,
+			title: entity.title,
+			position: entity.position,
+			version: entity.version,
+		}
+	}
+}
