new file mode 100644
index 000000000..b6a523f91
--- /dev/null
+++ b/packages/api/typescript/src/ui/projections/projectors/BoardViewProjector.ts
@@ -0,0 +1,60 @@
+import { injectable } from 'tsyringe-neo'
+import { Projector } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { BoardCreatedEvent } from '@board/events'
+import { ListAddedEvent } from '@board/events'
+import { CardCreatedEvent } from '@card/events'
+import { CardMovedDomainEvent } from '@card/events'
+import { BoardViewProjection, type BoardViewProjectionEvent } from '../BoardViewProjection'
+import { BoardViewProjectionRepository } from '../BoardViewProjectionRepository'
+
+@injectable()
+export class BoardViewProjector extends Projector<BoardViewProjectionEvent> {
+	readonly events: readonly string[] = [
+		BoardCreatedEvent.name,
+		ListAddedEvent.name,
+		CardCreatedEvent.name,
+		CardMovedDomainEvent.name,
+	]
+
+	constructor(private readonly repo: BoardViewProjectionRepository) {
+		super()
+	}
+
+	async handle(event: BoardViewProjectionEvent, tx?: Transaction): Promise<void> {
+		switch (event.name) {
+			case BoardCreatedEvent.name: {
+				const e = event as BoardCreatedEvent
+				await this.repo.insertIfNew(BoardViewProjection.create(e), tx)
+				break
+			}
+			case ListAddedEvent.name: {
+				const e = event as ListAddedEvent
+				const proj = await this.repo.findByBoardId(e.payload.boardId, tx)
+				if (!proj) return
+				proj.applyEvent(e)
+				await this.repo.save(proj, tx)
+				break
+			}
+			case CardCreatedEvent.name: {
+				const e = event as CardCreatedEvent
+				const boardId = e.payload.card.boardId
+				const proj = await this.repo.findByBoardId(boardId, tx)
+				if (!proj) return
+				proj.applyEvent(e)
+				await this.repo.save(proj, tx)
+				break
+			}
+			case CardMovedDomainEvent.name: {
+				const e = event as CardMovedDomainEvent
+				const proj = await this.repo.findByBoardId(e.payload.boardId, tx)
+				if (!proj) return
+				proj.applyEvent(e)
+				await this.repo.save(proj, tx)
+				break
+			}
+			default:
+				break
+		}
+	}
+}
