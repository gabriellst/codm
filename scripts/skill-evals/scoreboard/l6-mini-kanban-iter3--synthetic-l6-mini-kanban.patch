+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { boards } from '@template/contracts/db'
+
+export interface BoardSnapshot {
+	status: string
+	listIds: string[]
+}
+
+export abstract class BoardQueryService {
+	abstract getBoardSnapshot(boardId: string): Promise<BoardSnapshot | undefined>
+}
+
+@injectable()
+export class DrizzleBoardQueryService extends BoardQueryService {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async getBoardSnapshot(boardId: string): Promise<BoardSnapshot | undefined> {
+		const result = await tryCatchAsync(async () => {
+			const rows = await this.db.select().from(boards).where(eq(boards.id, boardId)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		const row = result.data
+		const listsJson = Array.isArray(row.listsJson) ? (row.listsJson as Array<{ id: string }>) : []
+		return {
+			status: row.status,
+			listIds: listsJson.map(l => l.id),
+		}
+	}
+}
+
+@injectable()
+export class MockBoardQueryService extends BoardQueryService {
+	async getBoardSnapshot(_boardId: string): Promise<BoardSnapshot | undefined> {
+		return { status: 'ACTIVE', listIds: [] }
+	}
+}
