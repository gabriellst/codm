@@ -0,0 +1,65 @@
+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z, type Transaction } from '@template/core-typescript'
+import { Card } from '../entities/Card'
+import { CardRepository } from '../repositories/CardRepository'
+import { BoardQueryService } from '../services/BoardQueryService'
+import { CardCreatedEvent } from '../events'
+import type { CardApplicationErrors, CardDomainErrors } from '../errors'
+
+export const CreateCardInputSchema = z.object({
+	boardId: z.uuid(),
+	storeId: z.uuid(),
+	listId: z.uuid(),
+	title: z.string().min(1).max(500),
+	position: z.number().int().min(0).optional(),
+})
+
+export const CreateCardOutputSchema = z.object({
+	cardId: z.uuid(),
+})
+
+@injectable()
+export class CreateCard extends Handler<typeof CreateCardInputSchema, typeof CreateCardOutputSchema> {
+	readonly name = 'create_card' as const
+	readonly inputSchema = CreateCardInputSchema
+	readonly outputSchema = CreateCardOutputSchema
+
+	constructor(
+		private readonly cards: CardRepository,
+		private readonly boardQueryService: BoardQueryService,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const board = await this.boardQueryService.getBoardSnapshot(input.boardId)
+			if (!board) {
+				throw new BaseError<CardApplicationErrors>('CARD_BOARD_NOT_FOUND')
+			}
+			if (board.status === 'ARCHIVED') {
+				throw new BaseError<CardDomainErrors>('CARD_BOARD_ARCHIVED')
+			}
+			if (board.listIds.length > 0 && !board.listIds.includes(input.listId)) {
+				throw new BaseError<CardDomainErrors>('CARD_LIST_NOT_ON_BOARD')
+			}
+			const entity = Card.create({
+				boardId: input.boardId,
+				storeId: input.storeId,
+				listId: input.listId,
+				title: input.title,
+				position: input.position,
+			})
+			await this.cards.save(entity, tx)
+			await this.domainEventRepository.save(
+				new CardCreatedEvent({
+					entityId: entity.id.value,
+					ownerId: input.storeId,
+					payload: { card: entity.toJSON() },
+				}),
+				tx,
+			)
+			return { cardId: entity.id.value }
+		})
+	}
+}
