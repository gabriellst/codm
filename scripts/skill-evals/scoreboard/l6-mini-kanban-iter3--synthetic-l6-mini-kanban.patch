+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Link } from '@tanstack/react-router'
+import { useListBoards, type ListBoardsQueryResponse } from '@template/client-typescript/typescript'
+import type { VariantProps } from 'class-variance-authority'
+
+import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
+import { Badge, badgeVariants } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Skeleton } from '@/components/ui/skeleton'
+import { cn } from '@/lib/utils'
+import { useDialogStore } from '@/stores/useDialogStore'
+
+import { CreateBoardDialog } from '../CreateBoardDialog'
+
+type BoardItem = ListBoardsQueryResponse['items'][number]
+
+const STATUS_BADGE_VARIANT: Record<string, VariantProps<typeof badgeVariants>['variant']> = {
+	ACTIVE: 'success',
+	ARCHIVED: 'secondary',
+}
+
+const STATUS_I18N_KEY: Record<string, 'enums.BoardStatus.ACTIVE' | 'enums.BoardStatus.ARCHIVED'> = {
+	ACTIVE: 'enums.BoardStatus.ACTIVE',
+	ARCHIVED: 'enums.BoardStatus.ARCHIVED',
+}
+
+function BoardListSkeleton() {
+	return (
+		<div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
+			{[1, 2, 3].map(key => (
+				<Card key={key} className="p-4">
+					<Skeleton className="h-5 w-32 mb-2" />
+					<Skeleton className="h-4 w-16" />
+				</Card>
+			))}
+		</div>
+	)
+}
+
+function BoardCard({ board }: { board: BoardItem }) {
+	const { t } = useTranslation()
+
+	return (
+		<Link to="/boards/$boardId" params={{ boardId: board.id }}>
+			<Card className="hover:border-primary/50 transition-colors cursor-pointer">
+				<CardHeader className="pb-2">
+					<CardTitle className="text-base font-semibold">{board.name}</CardTitle>
+				</CardHeader>
+				<CardContent>
+					<Badge variant={STATUS_BADGE_VARIANT[board.status] ?? 'secondary'}>
+						{t(STATUS_I18N_KEY[board.status] ?? 'enums.BoardStatus.ACTIVE')}
+					</Badge>
+				</CardContent>
+			</Card>
+		</Link>
+	)
+}
+
+export function BoardListSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { show } = useDialogStore()
+	const { data, isPending } = useListBoards()
+
+	return (
+		<div className={cn('flex flex-col gap-4', className)} {...props}>
+			<div className="flex items-center justify-between">
+				<Button onClick={() => show(<CreateBoardDialog />)}>
+					{t('kanban.boards.newBoard')}
+				</Button>
+			</div>
+
+			{isPending ? (
+				<BoardListSkeleton />
+			) : !data || data.items.length === 0 ? (
+				<p className="text-sm text-muted-foreground">{t('kanban.boards.emptyState')}</p>
+			) : (
+				<div
+					className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
+					role="list"
+					aria-label={t('kanban.boards.pageTitle')}
+				>
+					{data.items.map(board => (
+						<div key={board.id} role="listitem">
+							<BoardCard board={board} />
+						</div>
+					))}
+				</div>
+			)}
+		</div>
+	)
+}
