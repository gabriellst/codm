+import { injectable } from 'tsyringe-neo'
+import { Handler, Id, BaseError, z, type Transaction } from '@template/core-typescript'
+import { BoardRepository } from '../repositories/BoardRepository/BoardRepository'
+import { ListAddedEvent } from '../events'
+import type { BoardApplicationErrors } from '../errors'
+
+export const AddListInputSchema = z.object({
+	boardId: z.uuid(),
+	storeId: z.uuid(),
+	name: z.string().min(1).max(200),
+})
+
+export const AddListOutputSchema = z.object({
+	listId: z.uuid(),
+})
+
+@injectable()
+export class AddList extends Handler<typeof AddListInputSchema, typeof AddListOutputSchema> {
+	readonly name = 'add_list' as const
+	readonly inputSchema = AddListInputSchema
+	readonly outputSchema = AddListOutputSchema
+
+	constructor(private readonly boards: BoardRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const board = await this.boards.findById(input.boardId, tx)
+			if (!board) {
+				throw new BaseError<BoardApplicationErrors>('BOARD_NOT_FOUND')
+			}
+
+			const listId = new Id().value
+
+			// Entity enforces BOARD_ARCHIVED invariant
+			board.addList({ id: listId, name: input.name })
+
+			await this.boards.save(board, tx)
+			await this.domainEventRepository.save(
+				new ListAddedEvent({
+					entityId: input.boardId,
+					ownerId: input.storeId,
+					payload: {
+						boardId: board.id.value,
+						storeId: input.storeId,
+						list: { id: listId, name: input.name, position: board.lists.length - 1 },
+					},
+				}),
+				tx,
+			)
+
+			return { listId }
+		})
+	}
+}
