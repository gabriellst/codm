@@ -0,0 +1,65 @@
+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z, type Transaction } from '@template/core-typescript'
+import { CardRepository } from '../repositories/CardRepository'
+import { BoardQueryService } from '../services/BoardQueryService'
+import { CardMovedDomainEvent } from '../events'
+import type { CardApplicationErrors, CardDomainErrors } from '../errors'
+
+export const MoveCardInputSchema = z.object({
+	cardId: z.uuid(),
+	listId: z.uuid(),
+	position: z.number().int().min(0),
+})
+
+export const MoveCardOutputSchema = z.void()
+
+@injectable()
+export class MoveCard extends Handler<typeof MoveCardInputSchema, typeof MoveCardOutputSchema> {
+	readonly name = 'move_card' as const
+	readonly inputSchema = MoveCardInputSchema
+	readonly outputSchema = MoveCardOutputSchema
+
+	constructor(
+		private readonly cards: CardRepository,
+		private readonly boardQueryService: BoardQueryService,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		await this.withTransaction(tx, async tx => {
+			const entity = await this.cards.findById(input.cardId, tx)
+			if (!entity) {
+				throw new BaseError<CardApplicationErrors>('CARD_NOT_FOUND')
+			}
+			const board = await this.boardQueryService.getBoardSnapshot(entity.boardId.value)
+			if (!board) {
+				throw new BaseError<CardApplicationErrors>('CARD_BOARD_NOT_FOUND')
+			}
+			if (board.status === 'ARCHIVED') {
+				throw new BaseError<CardDomainErrors>('CARD_BOARD_ARCHIVED')
+			}
+			if (board.listIds.length > 0 && !board.listIds.includes(input.listId)) {
+				throw new BaseError<CardDomainErrors>('CARD_LIST_NOT_ON_BOARD')
+			}
+			const fromListId = entity.listId
+			entity.moveTo(input.listId, input.position)
+			await this.cards.save(entity, tx)
+			await this.domainEventRepository.save(
+				new CardMovedDomainEvent({
+					entityId: entity.id.value,
+					ownerId: entity.storeId.value,
+					payload: {
+						cardId: entity.id.value,
+						boardId: entity.boardId.value,
+						storeId: entity.storeId.value,
+						fromListId,
+						toListId: input.listId,
+					},
+				}),
+				tx,
+			)
+		})
+		return
+	}
+}
