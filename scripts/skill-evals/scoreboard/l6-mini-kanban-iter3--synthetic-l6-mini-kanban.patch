+import { injectable } from 'tsyringe-neo'
+import type { Transaction } from '@template/core-typescript'
+import { Card } from '../../entities/Card'
+import { CardRepository } from './CardRepository'
+
+@injectable()
+export class MockCardRepository extends CardRepository {
+	private rows = new Map<string, Card>()
+
+	async findById(id: string, _tx?: Transaction): Promise<Card | undefined> {
+		return this.rows.get(id)
+	}
+
+	async listByBoardId(boardId: string, _tx?: Transaction): Promise<Card[]> {
+		return [...this.rows.values()].filter(c => c.boardId.value === boardId)
+	}
+
+	async save(entity: Card, _tx?: Transaction): Promise<Card> {
+		entity.incrementVersion()
+		this.rows.set(entity.id.value, entity)
+		return entity
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.rows.delete(id)
+	}
+
+	seed(entity: Card): void {
+		this.rows.set(entity.id.value, entity)
+	}
+
+	clear(): void {
+		this.rows.clear()
+	}
+}
