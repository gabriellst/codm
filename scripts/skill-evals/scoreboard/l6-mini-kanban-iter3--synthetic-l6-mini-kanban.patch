+import { injectable } from 'tsyringe-neo'
+import { Handler, z, type Transaction } from '@template/core-typescript'
+import { Board } from '../entities/Board'
+import { BoardRepository } from '../repositories/BoardRepository/BoardRepository'
+import { BoardCreatedEvent } from '../events'
+
+export const CreateBoardInputSchema = z.object({
+	storeId: z.uuid(),
+	name: z.string().min(1).max(200),
+})
+
+export const CreateBoardOutputSchema = z.object({
+	boardId: z.uuid(),
+})
+
+@injectable()
+export class CreateBoard extends Handler<typeof CreateBoardInputSchema, typeof CreateBoardOutputSchema> {
+	readonly name = 'create_board' as const
+	readonly inputSchema = CreateBoardInputSchema
+	readonly outputSchema = CreateBoardOutputSchema
+
+	constructor(private readonly boards: BoardRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const entity = Board.create({
+				storeId: input.storeId,
+				name: input.name,
+			})
+			await this.boards.save(entity, tx)
+			await this.domainEventRepository.save(
+				new BoardCreatedEvent({
+					entityId: entity.id.value,
+					ownerId: input.storeId,
+					payload: { board: entity.toJSON() },
+				}),
+				tx,
+			)
+			return { boardId: entity.id.value }
+		})
+	}
+}
