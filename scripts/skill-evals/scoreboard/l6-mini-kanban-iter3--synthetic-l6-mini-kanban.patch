+import { AggregateRoot, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+
+export const CardSchema = z.object({
+	boardId: z.instance(Id),
+	storeId: z.instance(Id),
+	listId: z.uuid(),
+	title: z.string().min(1).max(500),
+	position: z.number().int().min(0).default(0),
+})
+
+export type CardProps = Z.infer<typeof CardSchema>
+
+/**
+ * `Card` aggregate — a card on a Kanban board list.
+ * Cards belong to a board and are positioned within a list.
+ */
+export class Card extends AggregateRoot<typeof CardSchema> {
+	static override schema = CardSchema
+
+	static create(data: {
+		boardId: string
+		storeId: string
+		listId: string
+		title: string
+		position?: number
+	}): Card {
+		return new Card({
+			boardId: data.boardId,
+			storeId: data.storeId,
+			listId: data.listId,
+			title: data.title,
+			position: data.position ?? 0,
+		})
+	}
+
+	moveTo(listId: string, position: number): void {
+		this.listId = listId
+		this.position = position
+		this.validate()
+	}
+}
+
+export interface Card extends CardProps {}
