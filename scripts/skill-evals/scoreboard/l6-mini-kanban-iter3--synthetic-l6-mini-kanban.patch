diff --git a/packages/api/typescript/src/board/entities/Board.ts b/packages/api/typescript/src/board/entities/Board.ts
new file mode 100644
index 000000000..95ad8c559
--- /dev/null
+++ b/packages/api/typescript/src/board/entities/Board.ts
@@ -0,0 +1,53 @@
+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import { BoardStatus } from '@template/contracts-typescript/wire/enums'
+import { ListColumnSchema } from '../objects/ListColumn'
+import type { BoardDomainErrors } from '../errors'
+
+export const BoardSchema = z.object({
+	storeId: z.instance(Id),
+	name: z.string().min(1).max(200),
+	status: z.enum(BoardStatus),
+	lists: z.array(ListColumnSchema).default([]),
+})
+
+export type BoardProps = Z.infer<typeof BoardSchema>
+
+/**
+ * `Board` aggregate — Kanban board with ordered lists.
+ * Status transitions: ACTIVE → ARCHIVED (irreversible).
+ */
+export class Board extends AggregateRoot<typeof BoardSchema> {
+	static override schema = BoardSchema
+
+	static create(data: { storeId: string; name: string }): Board {
+		return new Board({
+			storeId: data.storeId,
+			name: data.name,
+			status: BoardStatus.ACTIVE,
+			lists: [],
+		})
+	}
+
+	addList(data: { id: string; name: string }): void {
+		if (this.status === BoardStatus.ARCHIVED) {
+			throw new BaseError<BoardDomainErrors>('BOARD_ARCHIVED')
+		}
+		this.lists = [
+			...this.lists,
+			{ id: data.id, name: data.name, position: this.lists.length },
+		]
+		this.validate()
+	}
+
+	archive(): void {
+		this.status = BoardStatus.ARCHIVED
+		this.validate()
+	}
+
+	hasListId(listId: string): boolean {
+		return this.lists.some(l => l.id === listId)
+	}
+}
+
+export interface Board extends BoardProps {}
