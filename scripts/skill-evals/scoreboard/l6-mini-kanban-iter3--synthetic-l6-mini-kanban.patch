@@ -0,0 +1,55 @@
+import { pgSchema, uuid, text, timestamp, integer, jsonb, index } from 'drizzle-orm/pg-core'
+
+/**
+ * `kanban` PostgreSQL schema — Kanban boards (lists stored as JSONB),
+ * cards, and the BoardView read-side projection.
+ */
+export const kanbanSchema = pgSchema('kanban')
+
+export const boards = kanbanSchema.table(
+  'boards',
+  {
+    id: uuid('id').primaryKey().defaultRandom(),
+    storeId: uuid('store_id').notNull(),
+    name: text('name').notNull(),
+    status: text('status').notNull().default('ACTIVE'),
+    // Ordered lists: [{id: string, name: string, position: number}]
+    listsJson: jsonb('lists_json').notNull().$default(() => []),
+    createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+    updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+    version: integer('version').notNull().default(1),
+  },
+  table => [index('boards_store_id_idx').on(table.storeId)],
+)
+
+export const cards = kanbanSchema.table(
+  'cards',
+  {
+    id: uuid('id').primaryKey().defaultRandom(),
+    boardId: uuid('board_id').notNull(),
+    storeId: uuid('store_id').notNull(),
+    listId: uuid('list_id').notNull(),
+    title: text('title').notNull(),
+    position: integer('position').notNull().default(0),
+    createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+    updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+    version: integer('version').notNull().default(1),
+  },
+  table => [
+    index('cards_board_id_idx').on(table.boardId),
+    index('cards_list_id_idx').on(table.listId),
+    index('cards_store_id_idx').on(table.storeId),
+  ],
+)
+
+export const boardViewProjections = kanbanSchema.table(
+  'board_view_projections',
+  {
+    boardId: uuid('board_id').primaryKey(),
+    storeId: uuid('store_id').notNull(),
+    // JSON: { boardId, storeId, name, status, lists: [{id, name, position, cards: [{id, title, position}]}] }
+    snapshot: jsonb('snapshot').notNull(),
+    updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+  },
+  table => [index('board_view_projections_store_id_idx').on(table.storeId)],
+)
