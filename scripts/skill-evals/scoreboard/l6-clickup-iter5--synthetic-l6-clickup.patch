+
+export const CreateTaskControllerInputSchema = z.object({
+	body: z.object({
+		spaceId: z.uuid(),
+		listId: z.uuid(),
+		title: z.string().min(1),
+		priority: z.enum(TaskPriority).optional(),
+		assigneeIds: z.array(z.uuid()).optional(),
