diff --git a/packages/api/typescript/src/finance/entities/OperationalCost.test.ts b/packages/api/typescript/src/finance/entities/OperationalCost.test.ts
new file mode 100644
index 000000000..78e386bc3
--- /dev/null
+++ b/packages/api/typescript/src/finance/entities/OperationalCost.test.ts
@@ -0,0 +1,36 @@
+import { describe, it, expect } from 'bun:test'
+import { OperationalCost } from './OperationalCost'
+import { CurrencyCode, OperationalCostCategory, OperationalCostRecurrency } from '@template/contracts-typescript/wire/enums'
+
+const base = {
+	storeId: 'a0000000-0000-0000-0000-000000000001',
+	category: OperationalCostCategory.RENT,
+	description: 'Office rent',
+	amount: { amountCents: 100000, currency: CurrencyCode.BRL },
+	recurrency: OperationalCostRecurrency.MONTHLY,
+	startDate: new Date('2026-01-01'),
+}
+
+describe('OperationalCost.vendorName', () => {
+	it('trims whitespace on create', () => {
+		const entity = OperationalCost.create({ ...base, vendorName: '  Adobe  ' })
+		expect(entity.vendorName).toBe('Adobe')
+	})
+
+	it('defaults vendorName to null when omitted', () => {
+		const entity = OperationalCost.create({ ...base })
+		expect(entity.vendorName).toBeNull()
+	})
+
+	it('throws INVALID_VENDOR_NAME when vendorName exceeds 120 chars', () => {
+		const long = 'A'.repeat(121)
+		expect(() => OperationalCost.create({ ...base, vendorName: long })).toThrow('INVALID_VENDOR_NAME')
+	})
+
+	it('clears vendorName when update receives null', () => {
+		const entity = OperationalCost.create({ ...base, vendorName: 'Adobe' })
+		expect(entity.vendorName).toBe('Adobe')
+		entity.update({ vendorName: null })
+		expect(entity.vendorName).toBeNull()
+	})
+})
