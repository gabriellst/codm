@@ -0,0 +1,77 @@
+import Z from 'zod'
+import { BlockSchema } from '../objects/Block'
+import type { Block } from '../objects/Block'
+import type { PageCreatedEvent } from '../events/PageCreatedEvent'
+import type { BlockAddedEvent } from '../events/BlockAddedEvent'
+import type { BlockEditedEvent } from '../events/BlockEditedEvent'
+
+export const PageViewProjectionSchema = Z.object({
+	pageId: Z.string().uuid(),
+	workspaceId: Z.string().uuid(),
+	parentPageId: Z.string().uuid().nullable(),
+	title: Z.string(),
+	blocks: Z.array(BlockSchema as Z.ZodTypeAny),
+	childPages: Z.array(Z.object({ id: Z.string().uuid(), title: Z.string() })),
+})
+
+export type PageViewProjectionProps = Omit<Z.infer<typeof PageViewProjectionSchema>, 'blocks'> & { blocks: Block[] }
+
+export type PageViewProjectionEvent = PageCreatedEvent | BlockAddedEvent | BlockEditedEvent
+
+export class PageViewProjection {
+	constructor(public props: PageViewProjectionProps) {}
+
+	static create(event: PageCreatedEvent): PageViewProjection {
+		return new PageViewProjection({
+			pageId: event.payload.pageId,
+			workspaceId: event.payload.workspaceId,
+			parentPageId: event.payload.parentPageId,
+			title: event.payload.title,
+			blocks: [],
+			childPages: [],
+		})
+	}
+
+	applyEvent(event: BlockAddedEvent): void
+	applyEvent(event: BlockEditedEvent): void
+	applyEvent(event: BlockAddedEvent | BlockEditedEvent): void {
+		switch (event.name) {
+			case 'page.page.block_added': {
+				const e = event as BlockAddedEvent
+				const newBlock: Block = {
+					id: e.payload.blockId,
+					type: e.payload.type,
+					content: e.payload.content,
+					order: e.payload.order,
+					children: [],
+				}
+				if (e.payload.parentBlockId == null) {
+					this.props.blocks.push(newBlock)
+				} else {
+					const parent = this.findBlock(this.props.blocks, e.payload.parentBlockId)
+					if (parent) {
+						parent.children.push(newBlock)
+					}
+				}
+				break
+			}
+			case 'page.page.block_edited': {
+				const e = event as BlockEditedEvent
+				const block = this.findBlock(this.props.blocks, e.payload.blockId)
+				if (block) {
+					block.content = e.payload.content
+				}
+				break
+			}
+		}
+	}
+
+	private findBlock(blocks: Block[], blockId: string): Block | undefined {
+		for (const block of blocks) {
+			if (block.id === blockId) return block
+			const found = this.findBlock(block.children, blockId)
+			if (found) return found
+		}
+		return undefined
+	}
+}
diff --git a/packages/api/typescript/src/page/projections/PageViewProjectionRepository/DrizzlePageViewProjectionRepository.ts b/packages/api/typescript/src/page/projections/PageViewProjectionRepository/DrizzlePageViewProjectionRepository.ts
