@@ -0,0 +1,88 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { pageView } from '@template/contracts/db'
+import { PageViewProjection, PageViewProjectionSchema } from '../PageView'
+import type { Block } from '../../objects/Block'
+import { PageViewProjectionRepository } from './PageViewProjectionRepository'
+
+@injectable()
+export class DrizzlePageViewProjectionRepository extends PageViewProjectionRepository {
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	async findByKey(pageId: string, tx?: DrizzleClient): Promise<PageViewProjection | undefined> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient.select().from(pageView).where(eq(pageView.pageId, pageId)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async save(projection: PageViewProjection, tx?: DrizzleClient): Promise<void> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(projection)
+			await dbClient
+				.insert(pageView)
+				.values(data)
+				.onConflictDoUpdate({
+					target: pageView.pageId,
+					set: {
+						workspaceId: data.workspaceId,
+						parentPageId: data.parentPageId,
+						title: data.title,
+						blocks: data.blocks,
+						childPages: data.childPages,
+						updatedAt: new Date(),
+					},
+				})
+		})
+		if (!result.success) throw result.error
+	}
+
+	async insertIfNew(projection: PageViewProjection, tx?: DrizzleClient): Promise<boolean> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(projection)
+			const inserted = await dbClient
+				.insert(pageView)
+				.values(data)
+				.onConflictDoNothing({ target: pageView.pageId })
+				.returning({ pageId: pageView.pageId })
+			return inserted.length > 0
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	private toDomain(row: typeof pageView.$inferSelect): PageViewProjection {
+		const parsed = PageViewProjectionSchema.parse({
+			pageId: row.pageId,
+			workspaceId: row.workspaceId,
+			parentPageId: row.parentPageId,
+			title: row.title,
+			blocks: row.blocks,
+			childPages: row.childPages,
+		})
+		return new PageViewProjection({
+			...parsed,
+			blocks: parsed.blocks as Block[],
+		})
+	}
+
+	private toPersistence(projection: PageViewProjection): typeof pageView.$inferInsert {
+		return {
+			pageId: projection.props.pageId,
+			workspaceId: projection.props.workspaceId,
+			parentPageId: projection.props.parentPageId ?? null,
+			title: projection.props.title,
+			blocks: projection.props.blocks as unknown as Record<string, unknown>[],
+			childPages: projection.props.childPages as unknown as Record<string, unknown>[],
+			updatedAt: new Date(),
+		}
+	}
+}
