@@ -0,0 +1,55 @@
+import { injectable } from 'tsyringe-neo'
+import type { Transaction } from '@template/core-typescript'
+import { Page } from '../../entities/Page'
+import type { Block } from '../../objects/Block'
+import { PageRepository } from './PageRepository'
+
+@injectable()
+export class MockPageRepository extends PageRepository {
+	private store = new Map<string, Page>()
+
+	async findById(id: string, _tx?: Transaction): Promise<Page | undefined> {
+		const page = this.store.get(id)
+		return page ? this.clone(page) : undefined
+	}
+
+	async save(page: Page, _tx?: Transaction): Promise<Page> {
+		this.store.set(page.id.value, this.clone(page))
+		return page
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.store.delete(id)
+	}
+
+	seed(page: Page): void {
+		this.store.set(page.id.value, page)
+	}
+
+	clear(): void {
+		this.store.clear()
+	}
+
+	private clone(page: Page): Page {
+		return new Page({
+			id: page.id.value,
+			workspaceId: page.workspaceId.value,
+			parentPageId: page.parentPageId,
+			title: page.title,
+			blocks: this.cloneBlocks(page.blocks),
+			createdAt: page.createdAt,
+			updatedAt: page.updatedAt,
+			version: page.version,
+		})
+	}
+
+	private cloneBlocks(blocks: Block[]): Block[] {
+		return blocks.map(b => ({
+			id: b.id,
+			type: b.type,
+			content: b.content,
+			order: b.order,
+			children: this.cloneBlocks(b.children),
+		}))
+	}
+}
