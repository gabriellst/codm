new file mode 100644
index 000000000..5d5131730
--- /dev/null
+++ b/packages/contracts/db/schema/notion.ts
@@ -0,0 +1,110 @@
+import { pgSchema, uuid, text, timestamp, integer, jsonb, index } from 'drizzle-orm/pg-core'
+import { sql } from 'drizzle-orm'
+
+/**
+ * `notion` is the minimal Notion-like app schema.
+ *
+ * Tables:
+ *   - `workspaces`   — owner-scoped workspace
+ *   - `pages`        — hierarchical pages within a workspace (self-referential via parentPageId)
+ *   - `blocks`       — adjacency-list content blocks within a page
+ *   - `page_view`    — read-model projection: one row per page with denormalised block tree + child pages
+ */
+export const notionSchema = pgSchema('notion')
+
+export const workspaces = notionSchema.table(
+	'workspaces',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		ownerId: uuid('owner_id').notNull(),
+
+		name: text('name').notNull(),
+
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		ownerIdIdx: index('workspaces_owner_id_idx').on(t.ownerId),
+	}),
+)
+
+export const pages = notionSchema.table(
+	'pages',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		workspaceId: uuid('workspace_id')
+			.notNull()
+			.references(() => workspaces.id, { onDelete: 'cascade' }),
+
+		// Nullable self-reference — plain uuid column (no .references() to avoid circular TS init).
+		parentPageId: uuid('parent_page_id'),
+
+		title: text('title').notNull(),
+
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+		version: integer('version').notNull().default(1),
+	},
+	t => ({
+		workspaceIdIdx: index('pages_workspace_id_idx').on(t.workspaceId),
+		parentPageIdIdx: index('pages_parent_page_id_idx').on(t.parentPageId),
+	}),
+)
+
+export const blocks = notionSchema.table(
+	'blocks',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		pageId: uuid('page_id')
+			.notNull()
+			.references(() => pages.id, { onDelete: 'cascade' }),
+
+		// Nullable adjacency-list parent within the same page — plain uuid (no .references() to avoid circular TS init).
+		parentBlockId: uuid('parent_block_id'),
+
+		// Stores BlockType values: TEXT | HEADING | TOGGLE.
+		type: text('type').notNull(),
+
+		content: text('content').notNull().default(''),
+
+		// 'order' is reserved in SQL; use column name 'sort_order', JS key 'order'.
+		order: integer('sort_order').notNull().default(0),
+
+		createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+	},
+	t => ({
+		pageIdIdx: index('blocks_page_id_idx').on(t.pageId),
+		parentBlockIdIdx: index('blocks_parent_block_id_idx').on(t.parentBlockId),
+	}),
+)
+
+export const pageView = notionSchema.table(
+	'page_view',
+	{
+		// Primary key is the page's id — not defaultRandom.
+		pageId: uuid('page_id').primaryKey(),
+
+		workspaceId: uuid('workspace_id').notNull(),
+
+		// Nullable.
+		parentPageId: uuid('parent_page_id'),
+
+		title: text('title').notNull(),
+
+		// Nested block tree as JSON.
+		blocks: jsonb('blocks').notNull().default(sql`'[]'::jsonb`),
+
+		// [{id,title}] list of direct child pages.
+		childPages: jsonb('child_pages').notNull().default(sql`'[]'::jsonb`),
+
+		updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow(),
+	},
+	t => ({
+		workspaceIdIdx: index('page_view_workspace_id_idx').on(t.workspaceId),
+	}),
+)
