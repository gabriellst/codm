+import { injectable } from 'tsyringe-neo'
+import type { Transaction } from '@template/core-typescript'
+import { PageViewProjection } from '../PageView'
+import type { PageViewProjectionProps } from '../PageView'
+import { PageViewProjectionRepository } from './PageViewProjectionRepository'
+
+@injectable()
+export class MockPageViewProjectionRepository extends PageViewProjectionRepository {
+	private store = new Map<string, PageViewProjectionProps>()
+
+	async findByKey(pageId: string, _tx?: Transaction): Promise<PageViewProjection | undefined> {
+		const props = this.store.get(pageId)
+		if (!props) return undefined
+		// Return a clone to avoid mutations bleeding between reads
+		return new PageViewProjection(this.clone(props))
+	}
+
+	async save(projection: PageViewProjection, _tx?: Transaction): Promise<void> {
+		this.store.set(projection.props.pageId, this.clone(projection.props))
+	}
+
+	async insertIfNew(projection: PageViewProjection, _tx?: Transaction): Promise<boolean> {
+		if (this.store.has(projection.props.pageId)) return false
+		this.store.set(projection.props.pageId, this.clone(projection.props))
+		return true
+	}
+
+	private clone(props: PageViewProjectionProps): PageViewProjectionProps {
+		return JSON.parse(JSON.stringify(props)) as PageViewProjectionProps
+	}
+}
