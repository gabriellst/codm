diff --git a/packages/api/typescript/src/page/entities/Page.test.ts b/packages/api/typescript/src/page/entities/Page.test.ts
new file mode 100644
index 000000000..262bc693a
--- /dev/null
+++ b/packages/api/typescript/src/page/entities/Page.test.ts
@@ -0,0 +1,80 @@
+import { describe, expect, it } from 'bun:test'
+import { BaseError } from '@template/core-typescript'
+import { BlockType } from '@template/contracts-typescript/wire/enums'
+import { Page } from './Page'
+
+describe('Page aggregate', () => {
+	it('create() sets title and workspaceId, blocks starts empty', () => {
+		const workspaceId = crypto.randomUUID()
+		const page = Page.create({ workspaceId, title: 'My Page' })
+
+		expect(page.title).toBe('My Page')
+		expect(page.workspaceId.value).toBe(workspaceId)
+		expect(page.blocks).toHaveLength(0)
+		expect(page.parentPageId).toBeNull()
+	})
+
+	it('addBlock() nests a TEXT child under a root TOGGLE block', () => {
+		const page = Page.create({ workspaceId: crypto.randomUUID(), title: 'Nested test' })
+		const toggleId = crypto.randomUUID()
+		const textId = crypto.randomUUID()
+
+		page.addBlock({ blockId: toggleId, parentBlockId: null, type: BlockType.TOGGLE, content: 'Toggle' })
+		page.addBlock({ blockId: textId, parentBlockId: toggleId, type: BlockType.TEXT, content: 'Child text' })
+
+		expect(page.blocks).toHaveLength(1)
+		expect(page.blocks[0].id).toBe(toggleId)
+		expect(page.blocks[0].children).toHaveLength(1)
+		expect(page.blocks[0].children[0].id).toBe(textId)
+		expect(page.blocks[0].children[0].content).toBe('Child text')
+	})
+
+	it('addBlock() throws BLOCK_PARENT_NOT_CONTAINER when parent is TEXT', () => {
+		const page = Page.create({ workspaceId: crypto.randomUUID(), title: 'Container test' })
+		const textId = crypto.randomUUID()
+		page.addBlock({ blockId: textId, parentBlockId: null, type: BlockType.TEXT, content: 'A text block' })
+
+		let caught: BaseError<'BLOCK_PARENT_NOT_CONTAINER'> | undefined
+		try {
+			page.addBlock({ blockId: crypto.randomUUID(), parentBlockId: textId, type: BlockType.TEXT, content: 'child' })
+		} catch (e) {
+			caught = e as BaseError<'BLOCK_PARENT_NOT_CONTAINER'>
+		}
+		expect(caught).toBeInstanceOf(BaseError)
+		expect(caught?.code).toBe('BLOCK_PARENT_NOT_CONTAINER')
+	})
+
+	it('addBlock() throws BLOCK_NOT_FOUND for non-existent parentBlockId', () => {
+		const page = Page.create({ workspaceId: crypto.randomUUID(), title: 'Not found test' })
+
+		let caught: BaseError<'BLOCK_NOT_FOUND'> | undefined
+		try {
+			page.addBlock({ blockId: crypto.randomUUID(), parentBlockId: crypto.randomUUID(), type: BlockType.TEXT, content: 'child' })
+		} catch (e) {
+			caught = e as BaseError<'BLOCK_NOT_FOUND'>
+		}
+		expect(caught).toBeInstanceOf(BaseError)
+		expect(caught?.code).toBe('BLOCK_NOT_FOUND')
+	})
+
+	it('editBlock() throws BLOCK_NOT_FOUND for missing blockId; updates content for existing', () => {
+		const page = Page.create({ workspaceId: crypto.randomUUID(), title: 'Edit test' })
+		const blockId = crypto.randomUUID()
+		page.addBlock({ blockId, parentBlockId: null, type: BlockType.HEADING, content: 'Original' })
+
+		// Edit existing
+		const edited = page.editBlock({ blockId, content: 'Updated' })
+		expect(edited.content).toBe('Updated')
+		expect(page.blocks[0].content).toBe('Updated')
+
+		// Edit missing
+		let caught: BaseError<'BLOCK_NOT_FOUND'> | undefined
+		try {
+			page.editBlock({ blockId: crypto.randomUUID(), content: 'x' })
+		} catch (e) {
+			caught = e as BaseError<'BLOCK_NOT_FOUND'>
+		}
+		expect(caught).toBeInstanceOf(BaseError)
+		expect(caught?.code).toBe('BLOCK_NOT_FOUND')
+	})
+})
