+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<Workspace | undefined> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient.select().from(workspaces).where(eq(workspaces.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async findByOwnerId(ownerId: string, tx?: DrizzleClient): Promise<Workspace[]> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			return dbClient.select().from(workspaces).where(eq(workspaces.ownerId, ownerId))
+		})
+		if (!result.success || !result.data) return []
+		return result.data.map(r => this.toDomain(r))
+	}
+
+	async save(entity: Workspace, tx?: DrizzleClient): Promise<Workspace> {
+		entity.incrementVersion()
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+			await dbClient
+				.insert(workspaces)
+				.values(data)
+				.onConflictDoUpdate({
+					target: workspaces.id,
+					set: {
+						ownerId: data.ownerId,
+						name: data.name,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbClient.delete(workspaces).where(eq(workspaces.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: typeof workspaces.$inferSelect): Workspace {
+		const parsed = Workspace.schema.parse({
+			ownerId: row.ownerId,
+			name: row.name,
+		})
+		return new Workspace({
+			...parsed,
+			id: row.id,
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: Workspace): typeof workspaces.$inferInsert {
+		return {
+			id: entity.id.value,
+			ownerId: entity.ownerId.value,
+			name: entity.name,
+			createdAt: entity.createdAt,
+			updatedAt: entity.updatedAt,
+			version: entity.version,
+		}
+	}
+}
