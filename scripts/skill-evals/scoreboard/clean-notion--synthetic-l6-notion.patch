@@ -0,0 +1,74 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { type ZodType } from 'zod'
+import { Handler, z, DrizzleClient, BaseError } from '@template/core-typescript'
+import { BlockType } from '@template/contracts-typescript/wire/enums'
+import { pageView } from '@template/contracts/db'
+
+// ---------------------------------------------------------------------------
+// Recursive block-node wire shape (self-referential via z.lazy).
+// ---------------------------------------------------------------------------
+export type PageViewBlockNode = {
+	id: string
+	type: BlockType
+	content: string
+	order: number
+	children: PageViewBlockNode[]
+}
+
+export const PageViewBlockNodeSchema: ZodType<PageViewBlockNode> = z.lazy(() =>
+	z.object({
+		id: z.uuid(),
+		type: z.enum(BlockType),
+		content: z.string(),
+		order: z.number().int(),
+		children: z.array(PageViewBlockNodeSchema),
+	}),
+)
+
+// ---------------------------------------------------------------------------
+// Input / Output
+// ---------------------------------------------------------------------------
+export const GetPageViewInputSchema = z.object({
+	pageId: z.uuid(),
+})
+
+export const GetPageViewOutputSchema = z.object({
+	pageId: z.uuid(),
+	workspaceId: z.uuid(),
+	parentPageId: z.uuid().nullable(),
+	title: z.string(),
+	blocks: z.array(PageViewBlockNodeSchema),
+	childPages: z.array(z.object({ id: z.uuid(), title: z.string() })),
+})
+
+/**
+ * `GetPageView` — returns the denormalised projection row for a single page,
+ * including the nested block tree and the list of direct child pages.
+ * Reads directly from the `notion.page_view` projection table.
+ */
+@injectable()
+export class GetPageView extends Handler<typeof GetPageViewInputSchema, typeof GetPageViewOutputSchema> {
+	readonly name = 'get_page_view' as const
+	readonly inputSchema = GetPageViewInputSchema
+	readonly outputSchema = GetPageViewOutputSchema
+
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const rows = await this.db.select().from(pageView).where(eq(pageView.pageId, input.pageId)).limit(1)
+		const row = rows[0]
+		if (!row) throw new BaseError('PAGE_VIEW_NOT_FOUND')
+
+		return {
+			pageId: row.pageId,
+			workspaceId: row.workspaceId,
+			parentPageId: row.parentPageId ?? null,
+			title: row.title,
+			blocks: z.array(PageViewBlockNodeSchema).parse(row.blocks),
+			childPages: z.array(z.object({ id: z.uuid(), title: z.string() })).parse(row.childPages),
+		}
+	}
+}
diff --git a/packages/api/typescript/src/ui/usecases/ListWorkspacePages.ts b/packages/api/typescript/src/ui/usecases/ListWorkspacePages.ts
