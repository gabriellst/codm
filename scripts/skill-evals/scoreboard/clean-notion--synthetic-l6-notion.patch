@@ -0,0 +1,76 @@
+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import { BlockType } from '@template/contracts-typescript/wire/enums'
+import { BlockSchema } from '../objects/Block'
+import type { Block } from '../objects/Block'
+import type { PageDomainErrors } from '../errors'
+
+export const PageSchema = z.object({
+	workspaceId: z.instance(Id),
+	parentPageId: z.string().uuid().nullable(),
+	title: z.string().min(1),
+	blocks: z.array(BlockSchema as Z.ZodTypeAny),
+})
+
+export type PageProps = Omit<Z.infer<typeof PageSchema>, 'blocks'> & { blocks: Block[] }
+
+export class Page extends AggregateRoot<typeof PageSchema> {
+	static override schema = PageSchema
+
+	static create(data: { workspaceId: string; parentPageId?: string | null; title: string }): Page {
+		return new Page({
+			workspaceId: data.workspaceId,
+			parentPageId: data.parentPageId ?? null,
+			title: data.title,
+			blocks: [],
+		})
+	}
+
+	private findBlock(blocks: Block[], blockId: string): Block | undefined {
+		for (const block of blocks) {
+			if (block.id === blockId) return block
+			const found = this.findBlock(block.children, blockId)
+			if (found) return found
+		}
+		return undefined
+	}
+
+	addBlock(input: { blockId: string; parentBlockId: string | null; type: BlockType; content: string }): Block {
+		const { blockId, parentBlockId, type, content } = input
+
+		if (parentBlockId == null) {
+			const order = this.blocks.length
+			const newBlock: Block = { id: blockId, type, content, order, children: [] }
+			this.blocks.push(newBlock)
+			this.validate()
+			return newBlock
+		}
+
+		const parent = this.findBlock(this.blocks, parentBlockId)
+		if (!parent) {
+			throw new BaseError<PageDomainErrors>('BLOCK_NOT_FOUND')
+		}
+		if (parent.type !== BlockType.TOGGLE) {
+			throw new BaseError<PageDomainErrors>('BLOCK_PARENT_NOT_CONTAINER')
+		}
+
+		const order = parent.children.length
+		const newBlock: Block = { id: blockId, type, content, order, children: [] }
+		parent.children.push(newBlock)
+		this.validate()
+		return newBlock
+	}
+
+	editBlock(input: { blockId: string; content: string }): Block {
+		const { blockId, content } = input
+		const block = this.findBlock(this.blocks, blockId)
+		if (!block) {
+			throw new BaseError<PageDomainErrors>('BLOCK_NOT_FOUND')
+		}
+		block.content = content
+		this.validate()
+		return block
+	}
+}
+
+export interface Page extends PageProps {}
