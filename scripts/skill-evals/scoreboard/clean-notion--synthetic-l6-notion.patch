+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { container, type DependencyContainer } from 'tsyringe-neo'
+import { TestBed } from '@test/support'
+import { DrizzleClient } from '@template/core-typescript'
+import { BlockType } from '@template/contracts-typescript/wire/enums'
+import { workspaces } from '@template/contracts/db'
+import { Page } from '../../entities/Page'
+import { DrizzlePageRepository } from './DrizzlePageRepository'
+
+describe('DrizzlePageRepository (integration)', () => {
+	let testBed: TestBed
+	let testContainer: DependencyContainer
+	let db: DrizzleClient
+	let repo: DrizzlePageRepository
+
+	beforeAll(async () => {
+		testContainer = container.createChildContainer()
+		testBed = await TestBed.create('integration', { testContainer, ownerId: 'integration-tenant' })
+		db = testBed.resolve(DrizzleClient)
+		repo = new DrizzlePageRepository(db)
+	})
+	beforeEach(async () => {
+		await testBed.reset()
+	})
+	afterAll(async () => {
+		await testBed.destroy()
+	})
+
+	/** Seed a workspace row so the pages.workspaceId FK is satisfied. */
+	async function givenWorkspace(): Promise<string> {
+		const id = crypto.randomUUID()
+		await db.insert(workspaces).values({ id, ownerId: crypto.randomUUID(), name: 'WS' })
+		return id
+	}
+
+	it('save() then findById() round-trips a page with a nested block tree', async () => {
+		const workspaceId = await givenWorkspace()
+		const page = Page.create({ workspaceId, title: 'Roadmap' })
+		const toggleId = crypto.randomUUID()
+		const childId = crypto.randomUUID()
+		page.addBlock({ blockId: toggleId, parentBlockId: null, type: BlockType.TOGGLE, content: 'Q3' })
+		page.addBlock({ blockId: childId, parentBlockId: toggleId, type: BlockType.TEXT, content: 'Ship it' })
+
+		await repo.save(page)
+
+		const reloaded = await repo.findById(page.id.value)
+		expect(reloaded).toBeDefined()
+		expect(reloaded!.title).toBe('Roadmap')
+		expect(reloaded!.workspaceId.value).toBe(workspaceId)
+		expect(reloaded!.blocks).toHaveLength(1)
+		expect(reloaded!.blocks[0].id).toBe(toggleId)
+		expect(reloaded!.blocks[0].children).toHaveLength(1)
+		expect(reloaded!.blocks[0].children[0].id).toBe(childId)
+		expect(reloaded!.blocks[0].children[0].content).toBe('Ship it')
+	})
+
+	it('save() persists an editBlock content change', async () => {
+		const workspaceId = await givenWorkspace()
+		const page = Page.create({ workspaceId, title: 'Notes' })
+		const blockId = crypto.randomUUID()
+		page.addBlock({ blockId, parentBlockId: null, type: BlockType.HEADING, content: 'Original' })
+		await repo.save(page)
+
+		const loaded = await repo.findById(page.id.value)
+		loaded!.editBlock({ blockId, content: 'Updated' })
+		await repo.save(loaded!)
+
+		const reloaded = await repo.findById(page.id.value)
+		expect(reloaded!.blocks[0].content).toBe('Updated')
+	})
+
+	it('findById() returns undefined for an unknown page id', async () => {
+		const missing = await repo.findById(crypto.randomUUID())
+		expect(missing).toBeUndefined()
+	})
+
+	it('delete() removes the page and its blocks', async () => {
+		const workspaceId = await givenWorkspace()
+		const page = Page.create({ workspaceId, title: 'Trash me' })
+		page.addBlock({ blockId: crypto.randomUUID(), parentBlockId: null, type: BlockType.TEXT, content: 'x' })
+		await repo.save(page)
+
+		await repo.delete(page.id.value)
+
+		expect(await repo.findById(page.id.value)).toBeUndefined()
+	})
+})
diff --git a/packages/api/typescript/src/page/repositories/PageRepository/DrizzlePageRepository.ts b/packages/api/typescript/src/page/repositories/PageRepository/DrizzlePageRepository.ts
new file mode 100644
index 000000000..75a3daf05
--- /dev/null
+++ b/packages/api/typescript/src/page/repositories/PageRepository/DrizzlePageRepository.ts
@@ -0,0 +1,147 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { pages, blocks } from '@template/contracts/db'
+import { Page } from '../../entities/Page'
+import type { Block } from '../../objects/Block'
+import { PageRepository } from './PageRepository'
+
+@injectable()
+export class DrizzlePageRepository extends PageRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<Page | undefined> {
+		const dbClient = tx ?? this.db
+
+		const result = await tryCatchAsync(async () => {
+			const pageRows = await dbClient.select().from(pages).where(eq(pages.id, id)).limit(1)
+			if (!pageRows[0]) return undefined
+
+			const pageRow = pageRows[0]
+			const blockRows = await dbClient.select().from(blocks).where(eq(blocks.pageId, id))
+
+			// Rebuild adjacency-list tree into nested Block[]
+			const blockTree = this.buildTree(blockRows)
+
+			const parsed = Page.schema.parse({
+				workspaceId: pageRow.workspaceId,
+				parentPageId: pageRow.parentPageId,
+				title: pageRow.title,
+				blocks: blockTree,
+			})
+
+			return new Page({
+				...parsed,
+				id: pageRow.id,
+				createdAt: pageRow.createdAt,
+				updatedAt: pageRow.updatedAt,
+				version: pageRow.version,
+			})
+		})
+
+		if (!result.success) return undefined
+		return result.data
+	}
+
+	async save(page: Page, tx?: DrizzleClient): Promise<Page> {
+		page.incrementVersion()
+		const dbClient = tx ?? this.db
+
+		const result = await tryCatchAsync(async () => {
+			// Upsert the page row
+			await dbClient
+				.insert(pages)
+				.values({
+					id: page.id.value,
+					workspaceId: page.workspaceId.value,
+					parentPageId: page.parentPageId ?? null,
+					title: page.title,
+					createdAt: page.createdAt,
+					updatedAt: page.updatedAt,
+					version: page.version,
+				})
+				.onConflictDoUpdate({
+					target: pages.id,
+					set: {
+						workspaceId: page.workspaceId.value,
+						parentPageId: page.parentPageId ?? null,
+						title: page.title,
+						updatedAt: page.updatedAt,
+						version: page.version,
+					},
+				})
+
+			// Replace all blocks: delete then bulk-insert the flattened tree
+			await dbClient.delete(blocks).where(eq(blocks.pageId, page.id.value))
+
+			const flatBlocks = this.flattenTree(page.blocks, page.id.value, null)
+			if (flatBlocks.length > 0) {
+				await dbClient.insert(blocks).values(flatBlocks)
+			}
+
+			return page
+		})
+
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbClient.delete(pages).where(eq(pages.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	/** DFS flatten: tree → adjacency-list rows for bulk insert. */
+	private flattenTree(
+		blockList: Block[],
+		pageId: string,
+		parentBlockId: string | null,
+	): (typeof blocks.$inferInsert)[] {
+		const rows: (typeof blocks.$inferInsert)[] = []
+		for (const block of blockList) {
+			rows.push({
+				id: block.id,
+				pageId,
+				parentBlockId,
+				type: block.type,
+				content: block.content,
+				order: block.order,
+				createdAt: new Date(),
+				updatedAt: new Date(),
+			})
+			rows.push(...this.flattenTree(block.children, pageId, block.id))
+		}
+		return rows
+	}
+
+	/** Rebuild tree from flat adjacency-list rows. */
+	private buildTree(rows: (typeof blocks.$inferSelect)[]): Block[] {
+		const byParent = new Map<string | null, (typeof blocks.$inferSelect)[]>()
+
+		for (const row of rows) {
+			const key = row.parentBlockId ?? null
+			const group = byParent.get(key) ?? []
+			group.push(row)
+			byParent.set(key, group)
+		}
+
+		const build = (parentId: string | null): Block[] => {
+			const children = byParent.get(parentId) ?? []
+			children.sort((a, b) => a.order - b.order)
+			return children.map(row => ({
+				id: row.id,
+				type: row.type as Block['type'],
+				content: row.content,
+				order: row.order,
+				children: build(row.id),
+			}))
+		}
+
+		return build(null)
+	}
+}
