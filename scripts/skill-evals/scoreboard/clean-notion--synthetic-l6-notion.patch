+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { Handler, z, DrizzleClient } from '@template/core-typescript'
+import { pages } from '@template/contracts/db'
+
+// ---------------------------------------------------------------------------
+// Input / Output
+// ---------------------------------------------------------------------------
+export const ListWorkspacePagesInputSchema = z.object({
+	workspaceId: z.uuid(),
+})
+
+export const ListWorkspacePagesOutputSchema = z.object({
+	pages: z.array(
+		z.object({
+			id: z.uuid(),
+			title: z.string(),
+			parentPageId: z.uuid().nullable(),
+		}),
+	),
+})
+
+/**
+ * `ListWorkspacePages` — returns the full page list for a workspace, used by
+ * the sidebar page-tree navigator. Reads directly from `notion.pages`.
+ */
+@injectable()
+export class ListWorkspacePages extends Handler<typeof ListWorkspacePagesInputSchema, typeof ListWorkspacePagesOutputSchema> {
+	readonly name = 'list_workspace_pages' as const
+	readonly inputSchema = ListWorkspacePagesInputSchema
+	readonly outputSchema = ListWorkspacePagesOutputSchema
+
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const rows = await this.db
+			.select({ id: pages.id, title: pages.title, parentPageId: pages.parentPageId })
+			.from(pages)
+			.where(eq(pages.workspaceId, input.workspaceId))
+
+		return {
+			pages: rows.map(row => ({
+				id: row.id,
+				title: row.title,
+				parentPageId: row.parentPageId ?? null,
+			})),
+		}
+	}
+}
