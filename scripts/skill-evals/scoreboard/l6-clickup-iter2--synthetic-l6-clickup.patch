+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { taskBoardView } from '@template/contracts/db'
+import { TaskBoardViewProjection } from '../../projections/TaskBoardViewProjection'
+import { TaskBoardViewProjectionRepository } from './TaskBoardViewProjectionRepository'
+
+@injectable()
+export class DrizzleTaskBoardViewProjectionRepository extends TaskBoardViewProjectionRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async insertIfNew(projection: TaskBoardViewProjection, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc
+				.insert(taskBoardView)
+				.values(this.toPersistence(projection))
+				.onConflictDoNothing({ target: taskBoardView.taskId })
+		})
+		if (!result.success) throw result.error
+	}
+
+	async findByTaskId(taskId: string, tx?: DrizzleClient): Promise<TaskBoardViewProjection | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc
+				.select()
+				.from(taskBoardView)
+				.where(eq(taskBoardView.taskId, taskId))
+				.limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async save(projection: TaskBoardViewProjection, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc
+				.update(taskBoardView)
+				.set({
+					title: projection.props.title,
+					status: projection.props.status,
+					priority: projection.props.priority,
+					assigneeIds: projection.props.assigneeIds,
+					listId: projection.props.listId,
+					listName: projection.props.listName,
+				})
+				.where(eq(taskBoardView.taskId, projection.props.taskId))
+		})
+		if (!result.success) throw result.error
+	}
+
+	async findBySpace(spaceId: string): Promise<TaskBoardViewProjection[]> {
+		const result = await tryCatchAsync(async () => {
+			return this.db
+				.select()
+				.from(taskBoardView)
+				.where(eq(taskBoardView.spaceId, spaceId))
+				.orderBy(taskBoardView.status, taskBoardView.createdAt)
+		})
+		if (!result.success) throw result.error
+		return result.data.map(row => this.toDomain(row))
+	}
+
+	private toDomain(row: typeof taskBoardView.$inferSelect): TaskBoardViewProjection {
+		return new TaskBoardViewProjection({
+			id: row.id,
+			spaceId: row.spaceId,
+			taskId: row.taskId,
+			title: row.title,
+			status: row.status,
+			priority: row.priority,
+			assigneeIds: (row.assigneeIds as string[]) ?? [],
+			listId: row.listId,
+			listName: row.listName,
+			createdAt: row.createdAt,
+		})
+	}
+
+	private toPersistence(projection: TaskBoardViewProjection): typeof taskBoardView.$inferInsert {
+		return {
+			id: projection.props.id,
+			spaceId: projection.props.spaceId,
+			taskId: projection.props.taskId,
+			title: projection.props.title,
+			status: projection.props.status,
+			priority: projection.props.priority,
+			assigneeIds: projection.props.assigneeIds,
+			listId: projection.props.listId,
+			listName: projection.props.listName,
+			createdAt: projection.props.createdAt,
+		}
+	}
+}
