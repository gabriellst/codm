+import { injectable } from 'tsyringe-neo'
+import { Handler, z, BaseError, type Transaction } from '@template/core-typescript'
+import type { ApplicationErrors } from '../errors'
+import { Space } from '../entities/Space'
+import { WorkspaceRepository } from '../repositories/WorkspaceRepository'
+import { SpaceRepository } from '../repositories/SpaceRepository'
+import { SpaceCreatedEvent } from '../events'
+
+export const CreateSpaceInputSchema = z.object({
+	workspaceId: z.uuid(),
+	name: z.string().min(1).max(255),
+	description: z.string().optional(),
+	userId: z.uuid(),
+})
+
+export const CreateSpaceOutputSchema = z.object({
+	spaceId: z.uuid(),
+})
+
+@injectable()
+export class CreateSpace extends Handler<typeof CreateSpaceInputSchema, typeof CreateSpaceOutputSchema> {
+	readonly name = 'create_space' as const
+	readonly inputSchema = CreateSpaceInputSchema
+	readonly outputSchema = CreateSpaceOutputSchema
+
+	constructor(
+		private readonly workspaces: WorkspaceRepository,
+		private readonly spaces: SpaceRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const workspace = await this.workspaces.findById(input.workspaceId, tx)
+			if (!workspace) throw new BaseError<ApplicationErrors>('WORKSPACE_NOT_FOUND')
+
+			const space = Space.create({
+				workspaceId: input.workspaceId,
+				name: input.name,
+				description: input.description,
+			})
+			await this.spaces.save(space, tx)
+
+			await this.domainEventRepository.save(
+				new SpaceCreatedEvent({
+					entityId: space.id.value,
+					ownerId: input.workspaceId,
+					payload: { spaceId: space.id.value, workspaceId: input.workspaceId, name: space.name },
+				}),
+				tx,
+			)
+
+			return { spaceId: space.id.value }
+		})
+	}
+}
