+import { injectable } from 'tsyringe-neo'
+import { EventHandler, ExternalMediator } from '@template/core-typescript'
+import { TaskStatusChangedEvent as TaskStatusChangedIntegrationEvent } from '@template/contracts-typescript/wire/events'
+import { TaskStatus } from '@template/contracts-typescript/wire/enums'
+import { TaskStatusChangedDomainEvent } from '../events'
+
+@injectable()
+export class TaskStatusChangedPublisherHandler extends EventHandler<typeof TaskStatusChangedDomainEvent> {
+	readonly event = TaskStatusChangedDomainEvent
+
+	constructor(private readonly mediator: ExternalMediator) {
+		super()
+	}
+
+	async handle(event: this['input']): Promise<void> {
+		await this.mediator.publish(
+			new TaskStatusChangedIntegrationEvent({
+				ownerId: event.ownerId ?? event.payload.storeId,
+				payload: {
+					storeId: event.payload.storeId,
+					workspaceId: event.payload.workspaceId,
+					taskId: event.payload.taskId,
