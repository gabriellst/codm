diff --git a/packages/api/typescript/src/ui/usecases/GetSpaceBoardView.ts b/packages/api/typescript/src/ui/usecases/GetSpaceBoardView.ts
new file mode 100644
index 000000000..cfaa484b7
--- /dev/null
+++ b/packages/api/typescript/src/ui/usecases/GetSpaceBoardView.ts
@@ -0,0 +1,76 @@
+import { injectable } from 'tsyringe-neo'
+import { Handler, z, BaseError } from '@template/core-typescript'
+import { TaskBoardViewProjectionRepository } from '@task/repositories/TaskBoardViewProjectionRepository'
+import { SpaceRepository } from '@workspace/repositories/SpaceRepository'
+import { TaskStatus } from '@template/contracts-typescript/wire/enums'
+
+const STATUS_ORDER = [TaskStatus.TODO, TaskStatus.IN_PROGRESS, TaskStatus.IN_REVIEW, TaskStatus.DONE]
+
+export const GetSpaceBoardViewInputSchema = z.object({
+	spaceId: z.uuid(),
+})
+
+export const GetSpaceBoardViewOutputSchema = z.object({
+	columns: z.array(
+		z.object({
+			status: z.string(),
+			tasks: z.array(
+				z.object({
+					taskId: z.string(),
+					title: z.string(),
+					priority: z.string(),
+					assigneeIds: z.array(z.string()),
+					listId: z.string(),
+					listName: z.string(),
+					createdAt: z.date(),
+				}),
+			),
+		}),
+	),
+})
+
+@injectable()
+export class GetSpaceBoardView extends Handler<typeof GetSpaceBoardViewInputSchema, typeof GetSpaceBoardViewOutputSchema> {
+	readonly name = 'get_space_board_view' as const
+	readonly inputSchema = GetSpaceBoardViewInputSchema
+	readonly outputSchema = GetSpaceBoardViewOutputSchema
+
+	constructor(
+		private readonly taskBoardView: TaskBoardViewProjectionRepository,
+		private readonly spaces: SpaceRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const space = await this.spaces.findById(input.spaceId)
+		if (!space) throw new BaseError('SPACE_NOT_FOUND')
+
+		const projections = await this.taskBoardView.findBySpace(input.spaceId)
+
+		const colMap = new Map<string, { status: string; tasks: typeof projections }>()
+		for (const s of STATUS_ORDER) {
+			colMap.set(s, { status: s, tasks: [] })
+		}
+		for (const p of projections) {
+			const col = colMap.get(p.props.status)
+			if (col) col.tasks.push(p)
+			else colMap.set(p.props.status, { status: p.props.status, tasks: [p] })
+		}
+
+		const columns = [...colMap.values()].map(col => ({
+			status: col.status,
+			tasks: col.tasks.map(p => ({
+				taskId: p.props.taskId,
+				title: p.props.title,
+				priority: p.props.priority,
+				assigneeIds: p.props.assigneeIds,
+				listId: p.props.listId,
