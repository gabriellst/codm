+import { injectable } from 'tsyringe-neo'
+import { Handler, z, BaseError, DrizzleClient, tryCatchAsync, type Transaction } from '@template/core-typescript'
+import { workspaceMembers } from '@template/contracts/db'
+import type { ApplicationErrors } from '../errors'
+import { WorkspaceRepository } from '../repositories/WorkspaceRepository'
+
+export const InviteMemberInputSchema = z.object({
+	workspaceId: z.uuid(),
+	userId: z.uuid(),
+	role: z.string().default('MEMBER'),
+})
+
+export const InviteMemberOutputSchema = z.object({
+	memberId: z.uuid(),
+})
+
+@injectable()
+export class InviteMember extends Handler<typeof InviteMemberInputSchema, typeof InviteMemberOutputSchema> {
+	readonly name = 'invite_member' as const
+	readonly inputSchema = InviteMemberInputSchema
+	readonly outputSchema = InviteMemberOutputSchema
+
+	constructor(
+		private readonly workspaces: WorkspaceRepository,
+		private readonly db: DrizzleClient,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const workspace = await this.workspaces.findById(input.workspaceId, tx)
+			if (!workspace) throw new BaseError<ApplicationErrors>('WORKSPACE_NOT_FOUND')
+
+			const dbc = (tx as DrizzleClient | undefined) ?? this.db
+			const memberId = crypto.randomUUID()
+
+			const result = await tryCatchAsync(async () => {
+				await dbc.insert(workspaceMembers).values({
+					id: memberId,
+					workspaceId: input.workspaceId,
+					userId: input.userId,
+					role: input.role,
+				})
+			})
+			if (!result.success) throw result.error
+
+			return { memberId }
+		})
+	}
+}
