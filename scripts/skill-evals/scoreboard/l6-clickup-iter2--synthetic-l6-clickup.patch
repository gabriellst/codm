@@ -0,0 +1,79 @@
+import { test, expect, request as playwrightRequest } from '@playwright/test'
+
+test.describe('ClickUp tasks realtime', () => {
+	// Creates test data via API (not UI setup), opens board view, changes status via API,
+	// asserts the card moved to the new column WITHOUT page reload.
+
+	test('task moves to new status column when status changes via API', async ({ page }) => {
+		// 1. Setup: create workspace, space, list, task via API request context
+		const apiContext = await playwrightRequest.newContext({
+			baseURL: 'http://localhost:3030',
+			extraHTTPHeaders: { 'Content-Type': 'application/json' },
+		})
+
+		// Authenticate — capture session cookie
+		const signIn = await apiContext.post('/v1/sign-in', {
+			data: { email: 'test@example.com', password: 'password123' },
+		})
+		expect(signIn.ok()).toBeTruthy()
+
+		// Create workspace
+		const wsResponse = await apiContext.post('/v1/workspaces', {
+			data: { name: 'Test Workspace' },
+		})
+		expect(wsResponse.ok()).toBeTruthy()
+		const { workspaceId } = await wsResponse.json()
+
+		// Create space
+		const spaceResponse = await apiContext.post(`/v1/workspaces/${workspaceId}/spaces`, {
+			data: { name: 'Test Space' },
+		})
+		expect(spaceResponse.ok()).toBeTruthy()
+		const { spaceId } = await spaceResponse.json()
+
+		// Add list to space
+		const listResponse = await apiContext.post(`/v1/workspaces/${workspaceId}/spaces/${spaceId}/lists`, {
+			data: { name: 'Backlog' },
+		})
+		expect(listResponse.ok()).toBeTruthy()
+		const { listId } = await listResponse.json()
+
+		// Create task
+		const taskResponse = await apiContext.post('/v1/tasks', {
+			data: {
+				workspaceId,
+				spaceId,
+				listId,
+				title: 'Realtime test task',
+				priority: 'NORMAL',
+			},
+		})
+		expect(taskResponse.ok()).toBeTruthy()
+		const { taskId } = await taskResponse.json()
+
+		// 2. Navigate to board view for this space
+		await page.goto(`/app/spaces/${spaceId}?view=board`)
+
+		// 3. Assert task is in TODO column initially
+		const todoColumn = page.getByRole('region', { name: /to do/i })
+		await expect(todoColumn.getByText('Realtime test task')).toBeVisible()
+
+		// 4. The IN_PROGRESS column should NOT have our task yet
+		const inProgressColumn = page.getByRole('region', { name: /in progress/i })
+		await expect(inProgressColumn.getByText('Realtime test task')).not.toBeVisible()
+
+		// 5. Change the task status via the API (simulates external change / another session)
+		const statusResponse = await apiContext.patch(`/v1/tasks/${taskId}/status`, {
+			data: { status: 'IN_PROGRESS' },
+		})
+		expect(statusResponse.ok()).toBeTruthy()
+
+		// 6. Without reloading — the SSE event triggers invalidation and refetch.
+		// Assert the task has moved to IN_PROGRESS column.
+		await expect(inProgressColumn.getByText('Realtime test task')).toBeVisible({ timeout: 5000 })
+		// And no longer in TODO
+		await expect(todoColumn.getByText('Realtime test task')).not.toBeVisible()
+
+		await apiContext.dispose()
+	})
+})
