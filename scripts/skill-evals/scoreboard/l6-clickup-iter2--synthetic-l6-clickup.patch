+import { injectable } from 'tsyringe-neo'
+import { Handler, z, BaseError, type Transaction } from '@template/core-typescript'
+import type { ApplicationErrors } from '../errors'
+import { SpaceRepository } from '../repositories/SpaceRepository'
+import { ListAddedToSpaceEvent } from '../events'
+
+export const AddListToSpaceInputSchema = z.object({
+	spaceId: z.uuid(),
+	name: z.string().min(1).max(255),
+	userId: z.uuid(),
+})
+
+export const AddListToSpaceOutputSchema = z.object({
+	listId: z.uuid(),
+})
+
+@injectable()
+export class AddListToSpace extends Handler<typeof AddListToSpaceInputSchema, typeof AddListToSpaceOutputSchema> {
+	readonly name = 'add_list_to_space' as const
+	readonly inputSchema = AddListToSpaceInputSchema
+	readonly outputSchema = AddListToSpaceOutputSchema
+
+	constructor(private readonly spaces: SpaceRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const space = await this.spaces.findById(input.spaceId, tx)
+			if (!space) throw new BaseError<ApplicationErrors>('SPACE_NOT_FOUND')
+
+			const listId = space.addList({ name: input.name })
+			await this.spaces.save(space, tx)
+
+			await this.domainEventRepository.save(
+				new ListAddedToSpaceEvent({
+					entityId: space.id.value,
+					ownerId: space.workspaceId.value,
+					payload: {
+						spaceId: space.id.value,
+						workspaceId: space.workspaceId.value,
+						listId,
+						name: input.name,
+					},
+				}),
+				tx,
+			)
+
+			return { listId }
+		})
+	}
+}
