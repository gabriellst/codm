@@ -0,0 +1,151 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useQueryClient } from '@tanstack/react-query'
+import { getRouteApi } from '@tanstack/react-router'
+import {
+	useGetSpaceBoardView,
+	getSpaceBoardViewQueryKey,
+	useChangeTaskStatus,
+	TaskStatusEnum,
+	TaskPriorityEnum,
+	type TaskStatus,
+	type GetSpaceBoardView200,
+} from '@template/client-typescript/typescript'
+import { cn } from '@/lib/utils'
+import { Button } from '@/components/ui/button'
+import { useDialogStore } from '@/stores/useDialogStore'
+import { useServerEvents } from '@/hooks'
+import { CreateTaskDialog } from '../CreateTaskDialog'
+
+const routeApi = getRouteApi('/(app)/spaces/$spaceId/')
+
+const STATUS_NEXT: Record<TaskStatus, TaskStatus | null> = {
+	[TaskStatusEnum.TODO]: TaskStatusEnum.IN_PROGRESS,
+	[TaskStatusEnum.IN_PROGRESS]: TaskStatusEnum.IN_REVIEW,
+	[TaskStatusEnum.IN_REVIEW]: TaskStatusEnum.DONE,
+	[TaskStatusEnum.DONE]: null,
+}
+
+const BOARD_COLUMNS: TaskStatus[] = [
+	TaskStatusEnum.TODO,
+	TaskStatusEnum.IN_PROGRESS,
+	TaskStatusEnum.IN_REVIEW,
+	TaskStatusEnum.DONE,
+]
+
+interface SpaceBoardViewSectionProps extends ComponentProps<'div'> {}
+
+export function SpaceBoardViewSection({ className, ...props }: SpaceBoardViewSectionProps) {
+	const { t } = useTranslation()
+	const { spaceId } = routeApi.useParams()
+	const navigate = routeApi.useNavigate()
+	const queryClient = useQueryClient()
+	const show = useDialogStore(s => s.show)
+
+	const { data, isLoading } = useGetSpaceBoardView(spaceId)
+	const { mutate: changeStatus } = useChangeTaskStatus()
+
+	useServerEvents('integration.shared.task.status_changed', event => {
+		if (event.payload.spaceId !== spaceId) return
+		queryClient.invalidateQueries({ queryKey: getSpaceBoardViewQueryKey(spaceId) })
+	})
+
+	const columns = (data as GetSpaceBoardView200 | undefined)?.columns ?? []
+	const columnByStatus = Object.fromEntries(columns.map(c => [c.status, c.tasks])) as Record<
+		string,
+		GetSpaceBoardView200['columns'][number]['tasks']
+	>
+
+	// Derive a listId from any task for the CreateTaskDialog — fall back to empty string
+	const anyTask = columns.flatMap(c => c.tasks)[0]
+
+	return (
+		<div className={cn('flex flex-col gap-6', className)} {...props}>
+			{/* View toggle + New Task toolbar */}
+			<div className="flex items-center justify-between gap-3">
+				<div className="flex items-center gap-2">
+					<Button
+						variant="outline"
+						size="sm"
+						onClick={() => navigate({ search: prev => ({ ...prev, view: 'list' }) })}
+					>
+						{t('space.listView')}
+					</Button>
+					<Button
+						variant="default"
+						size="sm"
+						onClick={() => navigate({ search: prev => ({ ...prev, view: 'board' }) })}
+					>
+						{t('space.boardView')}
+					</Button>
+				</div>
+				<Button
+					size="sm"
+					onClick={() =>
+						show(
+							<CreateTaskDialog
+								spaceId={spaceId}
+								workspaceId=""
+								listId={anyTask?.listId ?? ''}
+							/>,
+						)
+					}
+				>
+					{t('space.newTask')}
+				</Button>
+			</div>
+
+			{/* Board columns */}
+			{isLoading ? (
+				<p className="text-muted-foreground text-sm">{t('space.loading')}</p>
+			) : (
+				<div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
+					{BOARD_COLUMNS.map(status => {
+						const tasks = columnByStatus[status] ?? []
+						const nextStatus = STATUS_NEXT[status]
+						return (
+							<section
+								key={status}
+								aria-label={t(`enums.TaskStatus.${status}`)}
+								className="bg-muted/40 flex flex-col gap-3 rounded-xl p-4"
+							>
+								<h3 className="text-sm font-semibold">{t(`enums.TaskStatus.${status}`)}</h3>
+								{tasks.length === 0 ? (
+									<p className="text-muted-foreground text-xs">{t('space.emptyColumn')}</p>
+								) : (
+									<div className="flex flex-col gap-2">
+										{tasks.map(task => (
+											<div
+												key={task.taskId}
+												className="bg-card flex flex-col gap-2 rounded-lg border p-3"
+											>
+												<span className="text-sm font-medium">{task.title}</span>
+												<span className="text-muted-foreground self-start rounded px-2 py-0.5 text-xs ring-1 ring-inset ring-current">
+													{t(`enums.TaskPriority.${task.priority as keyof typeof TaskPriorityEnum}`)}
+												</span>
+												{nextStatus && (
+													<Button
+														variant="outline"
+														size="sm"
+														className="mt-1 w-full"
+														onClick={() =>
+															changeStatus({ taskId: task.taskId, data: { status: nextStatus } })
+														}
+													>
+														{t('space.moveTo', {
+															status: t(`enums.TaskStatus.${nextStatus}`),
+														})}
+													</Button>
+												)}
+											</div>
+										))}
+									</div>
+								)}
+							</section>
+						)
+					})}
+				</div>
+			)}
+		</div>
+	)
+}
