+import Z from 'zod'
+import { z } from '@template/core-typescript'
+import { TaskCreatedEventSchema } from '../events/TaskCreatedEvent'
+
+type TaskCreatedPayload = Z.infer<typeof TaskCreatedEventSchema>
+
+export const TaskBoardViewProjectionSchema = z.object({
+	id: z.uuid(),
+	spaceId: z.uuid(),
+	taskId: z.uuid(),
+	title: z.string(),
+	status: z.string(),
+	priority: z.string(),
+	assigneeIds: z.array(z.uuid()),
+	listId: z.uuid(),
+	listName: z.string(),
+	createdAt: z.date(),
+})
+
+export type TaskBoardViewProjectionProps = Z.infer<typeof TaskBoardViewProjectionSchema>
+
+export class TaskBoardViewProjection {
+	constructor(public props: TaskBoardViewProjectionProps) {}
+
+	static create(event: TaskCreatedPayload): TaskBoardViewProjection {
+		return new TaskBoardViewProjection({
+			id: crypto.randomUUID(),
+			spaceId: event.payload.spaceId,
+			taskId: event.payload.taskId,
+			title: event.payload.title,
+			status: event.payload.status,
+			priority: event.payload.priority,
+			assigneeIds: event.payload.assigneeIds,
+			listId: event.payload.listId,
+			listName: event.payload.listName,
+			createdAt: new Date(),
+		})
+	}
+
+	applyStatusChange(newStatus: string): void {
+		this.props.status = newStatus
+	}
+}
