@@ -0,0 +1,74 @@
+import { injectable } from 'tsyringe-neo'
+import { Handler, z, BaseError } from '@template/core-typescript'
+import { TaskListViewProjectionRepository } from '@task/repositories/TaskListViewProjectionRepository'
+import { SpaceRepository } from '@workspace/repositories/SpaceRepository'
+
+export const GetSpaceListViewInputSchema = z.object({
+	spaceId: z.uuid(),
+})
+
+export const GetSpaceListViewOutputSchema = z.object({
+	lists: z.array(
+		z.object({
+			id: z.string(),
+			name: z.string(),
+			order: z.number(),
+			tasks: z.array(
+				z.object({
+					taskId: z.string(),
+					title: z.string(),
+					status: z.string(),
+					priority: z.string(),
+					assigneeIds: z.array(z.string()),
+					createdAt: z.date(),
+				}),
+			),
+		}),
+	),
+})
+
+@injectable()
+export class GetSpaceListView extends Handler<typeof GetSpaceListViewInputSchema, typeof GetSpaceListViewOutputSchema> {
+	readonly name = 'get_space_list_view' as const
+	readonly inputSchema = GetSpaceListViewInputSchema
+	readonly outputSchema = GetSpaceListViewOutputSchema
+
+	constructor(
+		private readonly taskListView: TaskListViewProjectionRepository,
+		private readonly spaces: SpaceRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const space = await this.spaces.findById(input.spaceId)
+		if (!space) throw new BaseError('SPACE_NOT_FOUND')
+
+		const projections = await this.taskListView.findBySpace(input.spaceId)
+
+		const listMap = new Map<string, { id: string; name: string; order: number; tasks: typeof projections }>()
+		for (const l of space.lists) {
+			listMap.set(l.id, { id: l.id, name: l.name, order: l.order, tasks: [] })
+		}
+		for (const p of projections) {
+			const entry = listMap.get(p.props.listId)
+			if (entry) entry.tasks.push(p)
+		}
+
+		const lists = [...listMap.values()]
+			.sort((a, b) => a.order - b.order)
+			.map(l => ({
+				...l,
+				tasks: l.tasks.map(p => ({
+					taskId: p.props.taskId,
+					title: p.props.title,
+					status: p.props.status,
+					priority: p.props.priority,
+					assigneeIds: p.props.assigneeIds,
+					createdAt: p.props.createdAt,
+				})),
+			}))
+
+		return { lists }
+	}
+}
