@@ -0,0 +1,150 @@
+import { useTranslation } from 'react-i18next'
+import { useForm } from '@tanstack/react-form'
+import { useQueryClient } from '@tanstack/react-query'
+import {
+	useCreateTask,
+	createTaskMutationRequestSchema,
+	getSpaceListViewQueryKey,
+	getSpaceBoardViewQueryKey,
+	TaskPriorityEnum,
+	type CreateTaskMutationRequest,
+} from '@template/client-typescript/typescript'
+import type { DeepPartial } from '@/lib'
+import { useDialogStore } from '@/stores/useDialogStore'
+import { DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+import { Button } from '@/components/ui/button'
+import { Input } from '@/components/ui/input'
+import { Select } from '@/components/ui/select'
+import { Field, FieldError, FieldGroup, FieldLabel } from '@/components/ui/field'
+import { Spinner } from '@/components/ui/spinner'
+
+interface CreateTaskDialogProps {
+	spaceId: string
+	workspaceId: string
+	listId: string
+}
+
+export function CreateTaskDialog({ spaceId, workspaceId, listId }: CreateTaskDialogProps) {
+	const { t } = useTranslation()
+	const queryClient = useQueryClient()
+	const hide = useDialogStore(s => s.hide)
+
+	const { mutateAsync: createTask, isPending } = useCreateTask()
+
+	const defaultValues: DeepPartial<CreateTaskMutationRequest> = {
+		workspaceId,
+		spaceId,
+		listId,
+		title: '',
+		description: undefined,
+		priority: TaskPriorityEnum.NORMAL,
+		assigneeIds: [],
+	}
+
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: createTaskMutationRequestSchema },
+		onSubmit: async ({ value }) => {
+			const result = createTaskMutationRequestSchema.safeParse(value)
+			if (!result.success) return
+			await createTask({ data: result.data })
+			queryClient.invalidateQueries({ queryKey: getSpaceListViewQueryKey(spaceId) })
+			queryClient.invalidateQueries({ queryKey: getSpaceBoardViewQueryKey(spaceId) })
+			hide()
+		},
+	})
+
+	return (
+		<DialogContent className="sm:max-w-md" showCloseButton>
+			<DialogHeader>
+				<DialogTitle>{t('space.task.createTitle')}</DialogTitle>
+			</DialogHeader>
+
+			<form
+				className="flex flex-col gap-0"
+				noValidate
+				onSubmit={e => {
+					e.preventDefault()
+					e.stopPropagation()
+					form.handleSubmit()
+				}}
+			>
+				<FieldGroup>
+					<form.Field name="title">
+						{field => {
+							const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+							return (
+								<Field>
+									<FieldLabel htmlFor={field.name}>{t('space.task.titleLabel')}</FieldLabel>
+									<Input
+										id={field.name}
+										type="text"
+										placeholder={t('space.task.titlePlaceholder')}
+										value={field.state.value ?? ''}
+										onBlur={field.handleBlur}
+										onChange={e => field.handleChange(e.target.value)}
+										aria-invalid={isInvalid}
+									/>
+									{isInvalid && <FieldError errors={field.state.meta.errors} />}
+								</Field>
+							)
+						}}
+					</form.Field>
+
+					<form.Field name="description">
+						{field => (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('space.task.descriptionLabel')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									placeholder={t('space.task.descriptionPlaceholder')}
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value || undefined)}
+								/>
+							</Field>
+						)}
+					</form.Field>
+
+					<form.Field name="priority">
+						{field => {
+							const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+							return (
+								<Field>
+									<FieldLabel htmlFor={field.name}>{t('space.task.priorityLabel')}</FieldLabel>
+									<Select
+										enum={TaskPriorityEnum}
+										i18nPrefix="enums.TaskPriority"
+										value={field.state.value}
+										onValueChange={v => field.handleChange(v as CreateTaskMutationRequest['priority'])}
+										id={field.name}
+										aria-invalid={isInvalid}
+									/>
+									{isInvalid && <FieldError errors={field.state.meta.errors} />}
+								</Field>
+							)
+						}}
+					</form.Field>
+
+					<form.Subscribe selector={s => ({ canSubmit: s.canSubmit, isSubmitting: s.isSubmitting })}>
+						{({ canSubmit, isSubmitting }) => {
+							const busy = isSubmitting || isPending
+							return (
+								<div className="flex justify-end gap-2 pt-2">
+									<Button type="button" variant="outline" onClick={hide}>
+										{t('space.task.cancel')}
+									</Button>
+									<Button type="submit" disabled={!canSubmit || busy}>
+										{busy && <Spinner className="mr-2" />}
+										{t('space.task.submit')}
+									</Button>
+								</div>
+							)
+						}}
+					</form.Subscribe>
+				</FieldGroup>
+			</form>
+		</DialogContent>
+	)
+}
