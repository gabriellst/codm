+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { tasks, spaces, workspaces } from '@template/contracts/db'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { Task, TaskSchema } from '../../entities/Task'
+import { TaskRepository } from './TaskRepository'
+
+type TaskRow = typeof tasks.$inferSelect & { storeId: string; listName: string }
+
+@injectable()
+export class DrizzleTaskRepository extends TaskRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<Task | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc
+				.select({
+					id: tasks.id,
+					workspaceId: tasks.workspaceId,
+					spaceId: tasks.spaceId,
+					listId: tasks.listId,
+					title: tasks.title,
+					description: tasks.description,
+					status: tasks.status,
+					priority: tasks.priority,
+					assigneeIds: tasks.assigneeIds,
+					createdAt: tasks.createdAt,
+					updatedAt: tasks.updatedAt,
+					storeId: workspaces.storeId,
+					lists: spaces.lists,
+				})
+				.from(tasks)
+				.innerJoin(spaces, eq(tasks.spaceId, spaces.id))
+				.innerJoin(workspaces, eq(spaces.workspaceId, workspaces.id))
+				.where(eq(tasks.id, id))
+				.limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		const row = result.data
+		const listEntry = row.lists.find(l => l.id === row.listId)
+		return this.toDomain({ ...row, listName: listEntry?.name ?? '' })
+	}
+
+	async findBySpace(spaceId: string, tx?: DrizzleClient): Promise<Task[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () =>
+			dbc
+				.select({
+					id: tasks.id,
+					workspaceId: tasks.workspaceId,
+					spaceId: tasks.spaceId,
+					listId: tasks.listId,
+					title: tasks.title,
+					description: tasks.description,
+					status: tasks.status,
+					priority: tasks.priority,
+					assigneeIds: tasks.assigneeIds,
+					createdAt: tasks.createdAt,
+					updatedAt: tasks.updatedAt,
+					storeId: workspaces.storeId,
+					lists: spaces.lists,
+				})
+				.from(tasks)
+				.innerJoin(spaces, eq(tasks.spaceId, spaces.id))
+				.innerJoin(workspaces, eq(spaces.workspaceId, workspaces.id))
+				.where(eq(tasks.spaceId, spaceId)),
+		)
+		if (!result.success) throw result.error
+		return result.data.map(row => {
+			const listEntry = row.lists.find(l => l.id === row.listId)
+			return this.toDomain({ ...row, listName: listEntry?.name ?? '' })
+		})
+	}
+
+	async findByList(listId: string, tx?: DrizzleClient): Promise<Task[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () =>
+			dbc
+				.select({
+					id: tasks.id,
+					workspaceId: tasks.workspaceId,
+					spaceId: tasks.spaceId,
+					listId: tasks.listId,
+					title: tasks.title,
+					description: tasks.description,
+					status: tasks.status,
+					priority: tasks.priority,
+					assigneeIds: tasks.assigneeIds,
+					createdAt: tasks.createdAt,
+					updatedAt: tasks.updatedAt,
+					storeId: workspaces.storeId,
+					lists: spaces.lists,
+				})
+				.from(tasks)
+				.innerJoin(spaces, eq(tasks.spaceId, spaces.id))
+				.innerJoin(workspaces, eq(spaces.workspaceId, workspaces.id))
+				.where(eq(tasks.listId, listId)),
+		)
+		if (!result.success) throw result.error
+		return result.data.map(row => {
+			const listEntry = row.lists.find(l => l.id === row.listId)
+			return this.toDomain({ ...row, listName: listEntry?.name ?? '' })
+		})
+	}
+
+	async save(entity: Task, tx?: DrizzleClient): Promise<Task> {
+		entity.incrementVersion()
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+			await dbc
+				.insert(tasks)
+				.values(data)
+				.onConflictDoUpdate({
+					target: tasks.id,
+					set: {
+						title: data.title,
+						description: data.description,
+						status: data.status,
+						priority: data.priority,
+						assigneeIds: data.assigneeIds,
+						updatedAt: new Date(),
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc.delete(tasks).where(eq(tasks.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: TaskRow): Task {
+		const parsed = TaskSchema.parse({
+			workspaceId: row.workspaceId,
+			spaceId: row.spaceId,
+			listId: row.listId,
+			listName: row.listName,
+			storeId: row.storeId,
+			title: row.title,
+			description: row.description ?? null,
+			status: row.status as TaskStatus,
+			priority: row.priority as TaskPriority,
+			assigneeIds: (row.assigneeIds as string[]) ?? [],
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+		})
+		return new Task({
+			...parsed,
+			id: row.id,
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+		})
+	}
+
+	private toPersistence(entity: Task): typeof tasks.$inferInsert {
+		return {
+			id: entity.id.value,
+			workspaceId: entity.workspaceId.value,
+			spaceId: entity.spaceId.value,
+			listId: entity.listId,
+			title: entity.title,
+			description: entity.description ?? undefined,
+			status: entity.status,
+			priority: entity.priority,
+			assigneeIds: entity.assigneeIds,
+		}
+	}
+}
