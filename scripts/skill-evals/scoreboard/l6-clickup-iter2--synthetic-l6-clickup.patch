+import { injectable } from 'tsyringe-neo'
+import type { Transaction } from '@template/core-typescript'
+import { Task } from '../../entities/Task'
+import { TaskRepository } from './TaskRepository'
+
+@injectable()
+export class MockTaskRepository extends TaskRepository {
+	private rows = new Map<string, Task>()
+
+	async findById(id: string, _tx?: Transaction): Promise<Task | undefined> {
+		return this.rows.get(id)
+	}
+
+	async findBySpace(spaceId: string, _tx?: Transaction): Promise<Task[]> {
+		return [...this.rows.values()].filter(t => t.spaceId.value === spaceId)
+	}
+
+	async findByList(listId: string, _tx?: Transaction): Promise<Task[]> {
+		return [...this.rows.values()].filter(t => t.listId === listId)
+	}
+
+	async save(entity: Task, _tx?: Transaction): Promise<Task> {
+		entity.incrementVersion()
+		this.rows.set(entity.id.value, entity)
+		return entity
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.rows.delete(id)
+	}
+
+	seed(entity: Task): void {
+		this.rows.set(entity.id.value, entity)
+	}
+
+	clear(): void {
+		this.rows.clear()
+	}
+}
