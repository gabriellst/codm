+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import type { WorkspaceDomainErrors } from '../errors'
+import { SpaceList } from '../objects/SpaceList'
+
+export const SpaceSchema = z.object({
+	workspaceId: z.instance(Id),
+	name: z.string().min(1).max(255),
+	description: z.string().nullable(),
+	lists: z.array(z.instance(SpaceList)).default([]),
+	createdAt: z.date(),
+})
+
+export type SpaceProps = Z.infer<typeof SpaceSchema>
+
+export class Space extends AggregateRoot<typeof SpaceSchema> {
+	static override schema = SpaceSchema
+
+	static create(data: { workspaceId: string; name: string; description?: string }): Space {
+		return new Space({
+			workspaceId: data.workspaceId,
+			name: data.name.trim(),
+			description: data.description ?? null,
+			lists: [],
+			createdAt: new Date(),
+		})
+	}
+
+	addList(data: { name: string }): string {
+		const listId = crypto.randomUUID()
+		const order = this.lists.length
+		this.lists = [...this.lists, new SpaceList({ id: listId, name: data.name.trim(), order })]
+		this.validate()
+		return listId
+	}
+
+	removeList(listId: string): void {
+		const idx = this.lists.findIndex(l => l.id === listId)
+		if (idx === -1) throw new BaseError<WorkspaceDomainErrors>('LIST_NOT_FOUND')
+		this.lists = this.lists.filter(l => l.id !== listId)
+		this.validate()
+	}
+
+	getList(listId: string): SpaceList | undefined {
+		return this.lists.find(l => l.id === listId)
+	}
+}
+
+export interface Space extends SpaceProps {}
