--- /dev/null
+++ b/packages/contracts/db/schema/workspace.ts
@@ -0,0 +1,66 @@
+import { pgSchema, uuid, varchar, text, timestamp, jsonb, uniqueIndex } from 'drizzle-orm/pg-core'
+
+/**
+ * `workspace` is the BC for the ClickUp-style project management feature.
+ *
+ * A Workspace is a store-scoped project container. Spaces sub-divide a
+ * Workspace into functional areas; each Space carries an ordered list of
+ * Lists embedded as a jsonb column (lists are lightweight containers,
+ * not aggregates).
+ *
+ * Tables:
+ *   - `workspaces`         — Store-scoped workspace root
+ *   - `spaces`             — Areas within a workspace (carry embedded lists)
+ *   - `workspace_members`  — Many-to-many: workspace ↔ user with role
+ */
+export const workspaceSchema = pgSchema('workspace')
+
+export const workspaces = workspaceSchema.table('workspaces', {
+	id: uuid('id').primaryKey().defaultRandom(),
+	storeId: uuid('store_id').notNull(),
+	name: varchar('name', { length: 255 }).notNull(),
+	createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+})
+
+/**
+ * `spaces` — sub-divisions of a Workspace.
+ *
+ * lists column is JSONB: Array<{ id: string; name: string; order: number }>
+ * Lists are stored inline (not as a separate table) because they have no
+ * independent lifecycle — they are created and destroyed as part of the Space
+ * aggregate. Order is maintained by the `order` field inside each element.
+ */
+export const spaces = workspaceSchema.table('spaces', {
+	id: uuid('id').primaryKey().defaultRandom(),
+	workspaceId: uuid('workspace_id')
+		.notNull()
+		.references(() => workspaces.id),
+	name: varchar('name', { length: 255 }).notNull(),
+	description: text('description'),
+	lists: jsonb('lists')
+		.$type<Array<{ id: string; name: string; order: number }>>()
+		.notNull()
+		.default([]),
+	createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+})
+
+/**
+ * `workspace_members` — role-bearing membership link between a User and a Workspace.
+ *
+ * Unique on (workspace_id, user_id) — a user can only hold one role per workspace.
+ */
+export const workspaceMembers = workspaceSchema.table(
+	'workspace_members',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+		workspaceId: uuid('workspace_id')
+			.notNull()
+			.references(() => workspaces.id),
+		userId: uuid('user_id').notNull(),
+		role: varchar('role', { length: 50 }).notNull().default('MEMBER'),
+		joinedAt: timestamp('joined_at', { withTimezone: true }).notNull().defaultNow(),
+	},
+	t => ({
+		workspaceMemberUniq: uniqueIndex('workspace_member_unique').on(t.workspaceId, t.userId),
+	}),
+)
