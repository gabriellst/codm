+import { injectable } from 'tsyringe-neo'
+import { Handler, z, BaseError } from '@template/core-typescript'
+import { WorkspaceRepository } from '@workspace/repositories/WorkspaceRepository'
+import { SpaceRepository } from '@workspace/repositories/SpaceRepository'
+
+export const GetWorkspaceInputSchema = z.object({
+	workspaceId: z.uuid(),
+})
+
+export const GetWorkspaceOutputSchema = z.object({
+	workspace: z.object({
+		id: z.uuid(),
+		name: z.string(),
+		storeId: z.uuid(),
+	}),
+	spaces: z.array(
+		z.object({
+			id: z.uuid(),
+			name: z.string(),
+			description: z.string().nullable(),
+			lists: z.array(
+				z.object({
+					id: z.uuid(),
+					name: z.string(),
+					order: z.number(),
+				}),
+			),
+		}),
+	),
+})
+
+@injectable()
+export class GetWorkspace extends Handler<typeof GetWorkspaceInputSchema, typeof GetWorkspaceOutputSchema> {
+	readonly name = 'get_workspace' as const
+	readonly inputSchema = GetWorkspaceInputSchema
+	readonly outputSchema = GetWorkspaceOutputSchema
+
+	constructor(
+		private readonly workspaces: WorkspaceRepository,
+		private readonly spaces: SpaceRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const workspace = await this.workspaces.findById(input.workspaceId)
+		if (!workspace) throw new BaseError('WORKSPACE_NOT_FOUND')
+
+		const spaceList = await this.spaces.findByWorkspace(workspace.id.value)
+
+		return {
+			workspace: {
+				id: workspace.id.value,
+				name: workspace.name,
+				storeId: workspace.storeId.value,
+			},
+			spaces: spaceList.map(s => ({
+				id: s.id.value,
+				name: s.name,
+				description: s.description,
+				lists: s.lists.map(l => ({ id: l.id, name: l.name, order: l.order })),
+			})),
+		}
+	}
+}
