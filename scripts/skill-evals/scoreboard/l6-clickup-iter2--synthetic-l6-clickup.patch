+import { pgSchema, uuid, varchar, text, timestamp, integer, jsonb, index, uniqueIndex } from 'drizzle-orm/pg-core'
+import { sql } from 'drizzle-orm'
+import { spaces } from './workspace'
+
+/**
+ * `task` is the BC for ClickUp-style Task management.
+ *
+ * Tasks live within a Space+List (both anchored to a Workspace). Status and
+ * priority are stored as `text` (not pgEnum) to avoid migration coupling —
+ * the valid values are enforced by the domain layer and TypeSpec contracts.
+ *
+ * Tables:
+ *   - `tasks`           — Task write-side aggregate
+ *   - `task_list_view`  — Materialized list view: spaceId → listId → tasks
+ *   - `task_board_view` — Materialized board view: spaceId → status column
+ */
+export const taskSchema = pgSchema('task')
+
+/**
+ * `tasks` — Task aggregate (TS-owned write-side).
+ *
+ * status: TaskStatus (TODO | IN_PROGRESS | IN_REVIEW | DONE) — stored as text.
