new file mode 100644
index 000000000..352243180
--- /dev/null
+++ b/packages/api/typescript/src/task/entities/Task.ts
@@ -0,0 +1,79 @@
+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import { TaskStatus, TaskPriority } from '@template/contracts-typescript/wire/enums'
+import type { TaskDomainErrors } from '../errors'
+
+export const TaskSchema = z.object({
+	workspaceId: z.instance(Id),
+	spaceId: z.instance(Id),
+	listId: z.uuid(),
+	listName: z.string().min(1),
+	storeId: z.instance(Id),
+	title: z.string().min(1).max(500),
+	description: z.string().nullable(),
+	status: z.enum(TaskStatus).default(TaskStatus.TODO),
+	priority: z.enum(TaskPriority).default(TaskPriority.NORMAL),
+	assigneeIds: z.array(z.uuid()).default([]),
+	createdAt: z.date(),
+	updatedAt: z.date(),
+})
+
+export type TaskProps = Z.infer<typeof TaskSchema>
+
+export class Task extends AggregateRoot<typeof TaskSchema> {
+	static override schema = TaskSchema
+
+	static create(data: {
+		workspaceId: string
+		spaceId: string
+		listId: string
+		listName: string
+		storeId: string
+		title: string
+		description?: string
+		priority?: TaskPriority
+		assigneeIds?: string[]
+	}): Task {
+		return new Task({
+			workspaceId: data.workspaceId,
+			spaceId: data.spaceId,
+			listId: data.listId,
+			listName: data.listName,
+			storeId: data.storeId,
+			title: data.title.trim(),
+			description: data.description ?? null,
+			status: TaskStatus.TODO,
+			priority: data.priority ?? TaskPriority.NORMAL,
+			assigneeIds: data.assigneeIds ?? [],
+			createdAt: new Date(),
+			updatedAt: new Date(),
+		})
+	}
+
+	changeStatus(newStatus: TaskStatus): TaskStatus {
+		const fromStatus = this.status
+		if (fromStatus === newStatus) {
+			throw new BaseError<TaskDomainErrors>('TASK_ALREADY_HAS_STATUS')
+		}
+		this.status = newStatus
+		this.updatedAt = new Date()
+		this.validate()
+		return fromStatus
+	}
+
+	assign(userId: string): void {
+		if (!this.assigneeIds.includes(userId)) {
+			this.assigneeIds = [...this.assigneeIds, userId]
+			this.updatedAt = new Date()
+			this.validate()
+		}
+	}
+
+	unassign(userId: string): void {
+		this.assigneeIds = this.assigneeIds.filter(id => id !== userId)
+		this.updatedAt = new Date()
+		this.validate()
+	}
+}
+
+export interface Task extends TaskProps {}
