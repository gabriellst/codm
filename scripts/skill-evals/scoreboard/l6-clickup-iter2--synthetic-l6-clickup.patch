+	async findById(id: string, tx?: DrizzleClient): Promise<Space | undefined> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbc.select().from(spaces).where(eq(spaces.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async findByWorkspace(workspaceId: string, tx?: DrizzleClient): Promise<Space[]> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () =>
+			dbc.select().from(spaces).where(eq(spaces.workspaceId, workspaceId)),
+		)
+		if (!result.success) throw result.error
+		return result.data.map(r => this.toDomain(r))
+	}
+
+	async save(entity: Space, tx?: DrizzleClient): Promise<Space> {
+		entity.incrementVersion()
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+			await dbc
+				.insert(spaces)
+				.values(data)
+				.onConflictDoUpdate({
+					target: spaces.id,
+					set: {
+						name: data.name,
+						description: data.description,
+						lists: data.lists,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbc = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbc.delete(spaces).where(eq(spaces.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: typeof spaces.$inferSelect): Space {
+		const rawLists = (row.lists ?? []) as Array<{ id: string; name: string; order: number }>
+		const parsed = SpaceSchema.parse({
+			workspaceId: row.workspaceId,
+			name: row.name,
+			description: row.description ?? null,
+			lists: rawLists.map(l => new SpaceList({ id: l.id, name: l.name, order: l.order })),
+			createdAt: row.createdAt,
+		})
+		return new Space({
+			...parsed,
+			id: row.id,
+			createdAt: row.createdAt,
+		})
+	}
+
+	private toPersistence(entity: Space): typeof spaces.$inferInsert {
+		return {
+			id: entity.id.value,
+			workspaceId: entity.workspaceId.value,
+			name: entity.name,
+			description: entity.description,
+			lists: entity.lists.map(l => ({ id: l.id, name: l.name, order: l.order })),
+		}
+	}
+}
