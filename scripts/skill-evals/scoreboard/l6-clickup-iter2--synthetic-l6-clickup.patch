+import { injectable } from 'tsyringe-neo'
+import { Handler, BaseError, z, type Transaction } from '@template/core-typescript'
+import { TaskPriority } from '@template/contracts-typescript/wire/enums'
+import { Task } from '../entities/Task'
+import { TaskRepository } from '../repositories/TaskRepository'
+import { SpaceRepository } from '@workspace/repositories/SpaceRepository'
+import { TaskCreatedEvent } from '../events'
+
+export const CreateTaskInputSchema = z.object({
+	workspaceId: z.uuid(),
+	spaceId: z.uuid(),
+	listId: z.uuid(),
+	storeId: z.uuid(),
+	title: z.string().min(1).max(500),
+	description: z.string().nullable().optional(),
+	priority: z.enum(TaskPriority).optional(),
+	assigneeIds: z.array(z.uuid()).optional(),
+	userId: z.uuid(),
+})
+
+export const CreateTaskOutputSchema = z.object({
+	taskId: z.uuid(),
+})
+
+@injectable()
+export class CreateTask extends Handler<typeof CreateTaskInputSchema, typeof CreateTaskOutputSchema> {
+	readonly name = 'create_task' as const
+	readonly inputSchema = CreateTaskInputSchema
+	readonly outputSchema = CreateTaskOutputSchema
+
+	constructor(
+		private readonly tasks: TaskRepository,
+		private readonly spaces: SpaceRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const space = await this.spaces.findById(input.spaceId, tx)
+			if (!space) throw new BaseError('SPACE_NOT_FOUND')
+
+			const list = space.getList(input.listId)
+			const listName = list?.name ?? 'List'
+
+			const task = Task.create({
+				workspaceId: input.workspaceId,
+				spaceId: input.spaceId,
+				listId: input.listId,
+				listName,
+				storeId: input.storeId,
+				title: input.title,
+				description: input.description ?? undefined,
+				priority: input.priority,
+				assigneeIds: input.assigneeIds,
+			})
+			await this.tasks.save(task, tx)
+
+			await this.domainEventRepository.save(
+				new TaskCreatedEvent({
+					entityId: task.id.value,
+					ownerId: input.storeId,
+					payload: {
+						taskId: task.id.value,
+						spaceId: task.spaceId.value,
+						listId: task.listId,
+						listName: task.listName,
+						workspaceId: task.workspaceId.value,
+						storeId: task.storeId.value,
+						title: task.title,
+						status: task.status,
+						priority: task.priority,
+						assigneeIds: task.assigneeIds,
+					},
+				}),
+				tx,
+			)
+
+			return { taskId: task.id.value }
+		})
+	}
+}
