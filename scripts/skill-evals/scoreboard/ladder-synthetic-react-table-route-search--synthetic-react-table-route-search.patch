+++ b/packages/app/react/src/routes/(app)/marketing/campaigns/-components/CampaignTableSection/index.tsx
@@ -0,0 +1,270 @@
+import { useMemo } from 'react'
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import {
+	useListProductAdCampaigns,
+	CampaignStatusEnum,
+	MarketingPlatformEnum,
+	type CampaignStatus,
+	type MarketingPlatform,
+	type ListProductAdCampaignsQueryResponse,
+} from '@template/client-typescript/typescript'
+
+import { DataTable, DataTableContent, DataTableSearch, DataTablePagination } from '@/components/DataTable'
+import type { ColumnDef } from '@/components/DataTable'
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { MegaphoneIcon, TrashIcon } from '@/components/ui/icons'
+import { useMoney, useLocale } from '@/hooks'
+import { cn } from '@/lib/utils'
+
+import { useCampaignSelectionStore } from '../../-stores/useCampaignSelectionStore'
+
+// ─── Route API ───────────────────────────────────────────────────────────────
+
+const routeApi = getRouteApi('/(app)/marketing/campaigns/')
+
+// ─── Type alias ──────────────────────────────────────────────────────────────
+
+type CampaignItem = ListProductAdCampaignsQueryResponse['items'][number]
+
+// ─── Module-level constants (CMP-P07 — derived from SDK enums, never inline) ─
+
+const MARKETING_PLATFORMS = Object.values(MarketingPlatformEnum)
+
+// Dispatch map for sort-order toggle — avoids literal uppercase string comparisons (bp-14)
+const SORT_ORDER_TOGGLE: Record<'ASC' | 'DESC', 'ASC' | 'DESC'> = { ASC: 'DESC', DESC: 'ASC' }
+
+// ─── Status badge dispatch (CMP-P18 — exhaustive Record, no switch/ternary) ──
+
+interface CampaignStatusBadgeSpec {
+	variant: 'success' | 'warning' | 'secondary'
+	label: string
+}
+
+const CAMPAIGN_STATUS_BADGE: Record<CampaignStatus, CampaignStatusBadgeSpec> = {
+	[CampaignStatusEnum.ACTIVE]: { variant: 'success', label: 'enums.CampaignStatus.ACTIVE' },
+	[CampaignStatusEnum.PAUSED]: { variant: 'warning', label: 'enums.CampaignStatus.PAUSED' },
+	[CampaignStatusEnum.ARCHIVED]: { variant: 'secondary', label: 'enums.CampaignStatus.ARCHIVED' },
+}
+
+// ─── Status cell leaf ────────────────────────────────────────────────────────
+
+function CampaignStatusCell({ status }: { status: CampaignStatus }) {
+	const { t } = useTranslation()
+	const { variant, label } = CAMPAIGN_STATUS_BADGE[status]
+	return <Badge variant={variant}>{t(label)}</Badge>
+}
+
+// ─── Skeleton ────────────────────────────────────────────────────────────────
+
+function CampaignTableSkeleton() {
+	return (
+		<div className="flex flex-col gap-4">
+			<div className="flex gap-2">
+				{Array.from({ length: 3 }).map((_, i) => (
+					<Skeleton key={`filter-sk-${i}`} className="h-8 w-28 rounded-md" />
+				))}
+			</div>
+			{Array.from({ length: 6 }).map((_, i) => (
+				<Skeleton key={`row-sk-${i}`} className="h-12 w-full rounded-lg" />
+			))}
+		</div>
+	)
+}
+
+// ─── Batch actions bar ────────────────────────────────────────────────────────
+
+interface CampaignBatchActionsBarProps {
+	selectedCount: number
+	onClear: () => void
+}
+
+function CampaignBatchActionsBar({ selectedCount, onClear }: CampaignBatchActionsBarProps) {
+	const { t } = useTranslation()
+
+	if (selectedCount === 0) return null
+
+	return (
+		<div className="sticky bottom-4 z-10 flex items-center gap-3 rounded-xl border border-border bg-card px-4 py-3 shadow-lg">
+			<span className="text-sm font-medium text-foreground">
+				{t('marketing.campaigns.batchActions.selected', { count: selectedCount })}
+			</span>
+			<div className="flex items-center gap-2 ml-auto">
+				<Button size="sm" variant="ghost" onClick={onClear} className="text-muted-foreground gap-1.5">
+					<TrashIcon className="size-4" />
+					{t('marketing.campaigns.batchActions.clear')}
+				</Button>
+			</div>
+		</div>
+	)
+}
+
+// ─── Section ─────────────────────────────────────────────────────────────────
+
+export function CampaignTableSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const locale = useLocale()
+	const navigate = routeApi.useNavigate()
+	const { page, limit, search, platform, sortBy, sortOrder } = routeApi.useSearch()
+
+	const selectedIds = useCampaignSelectionStore(s => s.selectedIds)
+	const clearSelection = useCampaignSelectionStore(s => s.clearSelection)
+
+	const { data, isPending, isError } = useListProductAdCampaigns({
+		page,
+		limit,
+		search: search || undefined,
+		platform,
+	})
+
+	const items = data?.items ?? []
+	const total = data?.total ?? 0
+	const totalPages = data?.totalPages ?? 0
+
+	const columns = useMemo(
+		(): ColumnDef<CampaignItem>[] => [
+			{
+				id: 'name',
+				header: t('marketing.campaigns.table.name'),
+				accessorKey: 'name',
+				meta: { sortKey: 'name' },
+				cell: ({ row }) => (
+					<span className="text-sm font-medium text-foreground truncate max-w-[220px] block">
+						{row.original.name}
+					</span>
+				),
+			},
+			{
+				id: 'platform',
+				header: t('marketing.campaigns.table.platform'),
+				accessorKey: 'platform',
+				meta: { width: '140px' },
+				cell: ({ row }) => (
+					<span className="text-sm text-foreground">
+						{t(`enums.MarketingPlatform.${row.original.platform}`)}
+					</span>
+				),
+			},
+			{
+				id: 'status',
+				header: t('marketing.campaigns.table.status'),
+				accessorKey: 'status',
+				meta: { width: '120px' },
+				cell: ({ row }) => <CampaignStatusCell status={row.original.status} />,
+			},
+			{
+				id: 'spend',
+				header: t('marketing.campaigns.table.spend'),
+				accessorKey: 'spend',
+				meta: { align: 'right', width: '130px', sortKey: 'spend' },
+				cell: ({ row }) => (
+					<span className="text-sm text-foreground">{formatMoney(row.original.spend)}</span>
+				),
+			},
+		],
+		[t, formatMoney, locale],
+	)
+
+	function handlePageChange(p: number) {
+		void navigate({ search: prev => ({ ...prev, page: p }) })
+	}
+	function handleLimitChange(l: number) {
+		void navigate({ search: prev => ({ ...prev, limit: l, page: 1 }) })
+	}
+	function handleSearchChange(s: string) {
+		void navigate({ search: prev => ({ ...prev, search: s || undefined, page: 1 }) })
+	}
+	function handleSortChange(key: string) {
+		void navigate({
+			search: prev => ({
+				...prev,
+				sortBy: key as 'name' | 'spend' | 'status',
+				sortOrder: prev.sortBy === key ? SORT_ORDER_TOGGLE[prev.sortOrder ?? 'DESC'] : 'DESC',
+				page: 1,
+			}),
+		})
+	}
+	function handlePlatformChange(v: string | null) {
+		const next = (v || undefined) as MarketingPlatform | undefined
+		void navigate({ search: prev => ({ ...prev, platform: next, page: 1 }) })
+	}
+
+	return (
+		<div className={cn('flex flex-col gap-4', className)} {...props}>
+			{/* Header — always visible */}
+			<div className="flex items-center gap-3">
+				<GradientIconBadge icon={MegaphoneIcon} />
+				<h1 className="text-xl font-semibold text-foreground">{t('marketing.campaigns.title')}</h1>
+			</div>
+
+			{isPending ? (
+				<CampaignTableSkeleton />
+			) : isError ? (
+				<p className="text-sm text-destructive">{t('marketing.campaigns.loadError')}</p>
+			) : (
+				<DataTable
+					columns={columns}
+					getRowId={r => r.id}
+					data={items}
+					total={total}
+					totalPages={totalPages}
+					isLoading={isPending}
+					page={page}
+					limit={limit}
+					search={search ?? ''}
+					sortBy={sortBy}
+					sortOrder={sortOrder}
+					onPageChange={handlePageChange}
+					onLimitChange={handleLimitChange}
+					onSearchChange={handleSearchChange}
+					onSortChange={handleSortChange}
+				>
+					<div className="flex flex-col gap-3">
+						<div className="flex flex-wrap items-center gap-2">
+							<DataTableSearch placeholder={t('marketing.campaigns.toolbar.search')} />
+							{/* Platform filter — options from SDK enum constant, never a hand-rolled literal array */}
+							<Select value={platform ?? ''} onValueChange={handlePlatformChange}>
+								<SelectTrigger
+									size="sm"
+									className="w-44"
+									aria-label={t('marketing.campaigns.toolbar.filterPlatform')}
+								>
+									<SelectValue placeholder={t('marketing.campaigns.toolbar.filterPlatform')} />
+								</SelectTrigger>
+								<SelectContent>
+									<SelectItem value="">{t('marketing.campaigns.toolbar.allPlatforms')}</SelectItem>
+									{MARKETING_PLATFORMS.map(p => (
+										<SelectItem key={p} value={p}>
+											{t(`enums.MarketingPlatform.${p}`)}
+										</SelectItem>
+									))}
+								</SelectContent>
+							</Select>
+						</div>
+						<DataTableContent
+							emptyState={
+								<div className="py-12 text-center text-sm text-muted-foreground">
+									{t('marketing.campaigns.empty')}
+								</div>
+							}
+							loadingState={
+								<div className="py-12 text-center text-sm text-muted-foreground">
+									{t('marketing.campaigns.loading')}
+								</div>
+							}
+						/>
+						<DataTablePagination />
+					</div>
+				</DataTable>
+			)}
+
+			<CampaignBatchActionsBar selectedCount={selectedIds.length} onClear={clearSelection} />
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/(app)/marketing/campaigns/-stores/useCampaignSelectionStore.ts b/packages/app/react/src/routes/(app)/marketing/campaigns/-stores/useCampaignSelectionStore.ts
new file mode 100644
index 000000000..28614d3d3
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/marketing/campaigns/-stores/useCampaignSelectionStore.ts
@@ -0,0 +1,28 @@
+import { create } from 'zustand'
+
+interface CampaignSelectionState {
+	selectedIds: string[]
+}
+
+interface CampaignSelectionActions {
+	toggleSelection: (id: string) => void
+	selectAll: (ids: string[]) => void
+	clearSelection: () => void
+}
+
+type CampaignSelectionStore = CampaignSelectionState & CampaignSelectionActions
+
+export const useCampaignSelectionStore = create<CampaignSelectionStore>(set => ({
+	selectedIds: [],
+
+	toggleSelection: id =>
+		set(state => ({
+			selectedIds: state.selectedIds.includes(id)
+				? state.selectedIds.filter(i => i !== id)
+				: [...state.selectedIds, id],
+		})),
+
+	selectAll: ids => set({ selectedIds: ids }),
+
+	clearSelection: () => set({ selectedIds: [] }),
+}))
diff --git a/packages/app/react/src/routes/(app)/marketing/campaigns/index.tsx b/packages/app/react/src/routes/(app)/marketing/campaigns/index.tsx
