@@ -0,0 +1,38 @@
+import { createFileRoute } from '@tanstack/react-router'
+import { zodValidator } from '@/lib/zod-validator'
+import { z } from 'zod'
+import { listProductAdCampaignsQueryParamsSchema, type ListProductAdCampaignsQueryResponse } from '@template/client-typescript/typescript'
+
+import { CampaignTableSection } from './-components/CampaignTableSection'
+
+// Row item type — exported so components can reference it without re-importing from the SDK.
+export type CampaignItem = ListProductAdCampaignsQueryResponse['items'][number]
+
+// Search schema composed from the SDK's query-params schema:
+// - profileId omitted (not a bookmarkable URL filter)
+// - platform kept from the SDK (typed by marketingPlatformSchema — no hand-rolled enum literal array)
+// - sortBy / sortOrder added with defaults so a garbage deep link still renders
+export const campaignsSearchSchema = listProductAdCampaignsQueryParamsSchema
+	.omit({ profileId: true })
+	.and(
+		z.object({
+			sortBy: z.enum(['name', 'spend', 'status']).optional().default('name'),
+			sortOrder: z.enum(['ASC', 'DESC']).optional().default('DESC'),
+		}),
+	)
+
+export type CampaignsSearch = z.infer<typeof campaignsSearchSchema>
+
+export const Route = createFileRoute('/(app)/marketing/campaigns/')({
+	staticData: { breadcrumb: 'Campanhas' },
+	validateSearch: zodValidator(campaignsSearchSchema),
+	component: RouteComponent,
+})
+
+function RouteComponent() {
+	return (
+		<div className="flex flex-1 flex-col gap-6 overflow-y-auto p-6 md:p-8">
+			<CampaignTableSection />
+		</div>
+	)
+}
