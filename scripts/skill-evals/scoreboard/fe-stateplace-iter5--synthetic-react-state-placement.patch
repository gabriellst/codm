@@ -0,0 +1,220 @@
+import { useMemo } from 'react'
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useListQuickProductRanking } from '@template/client-typescript/typescript'
+import type { ListQuickProductRankingQueryResponse, SignedMoney } from '@template/client-typescript/typescript'
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Button } from '@/components/ui/button'
+import { Badge } from '@/components/ui/badge'
+import { Checkbox } from '@/components/ui/checkbox'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { StarIcon } from '@/components/ui/icons'
+import { cn } from '@/lib/utils'
+import { useTenancyStore } from '@/stores'
+import { useMoney } from '@/hooks'
+import { useReportsStore } from '../../-stores/useReportsStore'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+type RankingItem = ListQuickProductRankingQueryResponse['items'][number]
+
+const SKELETON_COUNT = 5
+
+export function TopProductsSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const { startDate, endDate, productIds } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+	const compareBasket = useReportsStore(s => s.compareBasket)
+	const clearBasket = useReportsStore(s => s.clearBasket)
+
+	const { data, isPending, isError } = useListQuickProductRanking({
+		tenancyScope,
+		startDate,
+		endDate,
+		productIds,
+	})
+
+	const basketItems = useMemo(() => {
+		if (!data || !compareBasket.length) return []
+		return data.items.filter(item => compareBasket.includes(item.productId))
+	}, [data, compareBasket])
+
+	return (
+		<Card className={cn('gap-4 p-6', className)} {...props}>
+			{/* Header with basket actions */}
+			<div className="flex flex-wrap items-center gap-4">
+				<GradientIconBadge icon={StarIcon} />
+				<div className="flex min-w-0 flex-1 flex-col gap-1">
+					<span className="text-lg font-medium text-muted-foreground">{t('reports.ranking.title')}</span>
+					{isPending ? (
+						<Skeleton className="h-4 w-24" />
+					) : data ? (
+						<span className="text-sm text-muted-foreground">
+							{t('reports.ranking.totalProducts', { count: data.totalProducts })}
+						</span>
+					) : null}
+				</div>
+				{compareBasket.length > 0 && (
+					<div className="flex items-center gap-2">
+						<Badge variant="secondary" aria-label={t('reports.ranking.basketCountAria', { count: compareBasket.length })}>
+							{t('reports.ranking.basketCount', { count: compareBasket.length })}
+						</Badge>
+						<Button
+							variant="ghost"
+							size="sm"
+							onClick={clearBasket}
+							aria-label={t('reports.ranking.clearBasketAria')}
+						>
+							{t('reports.ranking.clearBasket')}
+						</Button>
+					</div>
+				)}
+			</div>
+
+			<div className="border-t border-border/60" />
+
+			{/* Table */}
+			<div
+				role="list"
+				aria-label={t('reports.ranking.listAria')}
+				className="flex flex-col divide-y divide-border/40"
+			>
+				{isPending ? (
+					Array.from({ length: SKELETON_COUNT }).map((_, i) => (
+						<div key={`ranking-skeleton-${i}`} className="flex items-center gap-3 py-3">
+							<Skeleton className="size-4 shrink-0 rounded" />
+							<Skeleton className="size-8 shrink-0 rounded-lg" />
+							<Skeleton className="h-4 flex-1" />
+							<Skeleton className="h-4 w-24 shrink-0" />
+							<Skeleton className="h-4 w-16 shrink-0" />
+						</div>
+					))
+				) : isError || !data ? (
+					<p className="py-3 text-sm text-muted-foreground">{t('reports.ranking.loadError')}</p>
+				) : data.items.length === 0 ? (
+					<p className="py-3 text-sm text-muted-foreground">{t('reports.ranking.empty')}</p>
+				) : (
+					data.items.map((item, index) => (
+						<RankingRow
+							key={item.productId}
+							rank={index + 1}
+							item={item}
+							isCompared={compareBasket.includes(item.productId)}
+							formatMoney={formatMoney}
+						/>
+					))
+				)}
+			</div>
+
+			{/* Comparison panel — only shows when ≥ 2 items selected */}
+			{basketItems.length >= 2 && (
+				<ComparisonPanel items={basketItems} formatMoney={formatMoney} />
+			)}
+		</Card>
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Row leaf — receives single item as prop (rendered N times in .map())
+// ---------------------------------------------------------------------------
+
+interface RankingRowProps {
+	rank: number
+	item: RankingItem
+	isCompared: boolean
+	formatMoney: (m: SignedMoney) => string
+}
+
+function RankingRow({ rank, item, isCompared, formatMoney }: RankingRowProps) {
+	const { t } = useTranslation()
+	const toggleCompare = useReportsStore(s => s.toggleCompare)
+
+	return (
+		<div
+			role="listitem"
+			aria-label={t('reports.ranking.rowAria', { name: item.name })}
+			className={cn(
+				'flex items-center gap-3 py-3 transition-colors',
+				isCompared && 'bg-accent/30',
+			)}
+		>
+			{/* Compare toggle */}
+			<Checkbox
+				id={`compare-${item.productId}`}
+				checked={isCompared}
+				onCheckedChange={() => toggleCompare(item.productId)}
+				aria-label={t('reports.ranking.compareToggleAria', { name: item.name })}
+				className="shrink-0"
+			/>
+
+			{/* Rank number */}
+			<span className="w-5 shrink-0 text-right text-sm font-medium text-muted-foreground">
+				{rank}
+			</span>
+
+			{/* Thumbnail */}
+			{item.imageUrl ? (
+				<img
+					src={item.imageUrl}
+					alt={item.name}
+					className="size-8 shrink-0 rounded-lg object-cover"
+				/>
+			) : (
+				<div className="size-8 shrink-0 rounded-lg bg-muted" aria-hidden />
+			)}
+
+			{/* Name */}
+			<span className="flex-1 truncate text-sm font-medium text-foreground">{item.name}</span>
+
+			{/* Sales count */}
+			<span className="shrink-0 text-sm text-muted-foreground">
+				{t('reports.ranking.salesCount', { count: item.sales.count.value })}
+			</span>
+
+			{/* Revenue */}
+			<span className="shrink-0 text-sm font-semibold text-foreground">
+				{formatMoney(item.sales.value.value)}
+			</span>
+		</div>
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Comparison panel — shown when ≥ 2 items are in the basket
+// ---------------------------------------------------------------------------
+
+interface ComparisonPanelProps {
+	items: RankingItem[]
+	formatMoney: (m: SignedMoney) => string
+}
+
+function ComparisonPanel({ items, formatMoney }: ComparisonPanelProps) {
+	const { t } = useTranslation()
+
+	return (
+		<div className="rounded-lg border border-border/60 p-4" aria-label={t('reports.ranking.comparisonAria')}>
+			<p className="mb-3 text-sm font-semibold text-foreground">
+				{t('reports.ranking.comparisonTitle')}
+			</p>
+			<div className="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
+				{items.map(item => (
+					<div
+						key={item.productId}
+						className="flex flex-col gap-1 rounded-md border border-border/60 p-3"
+					>
+						<span className="truncate text-xs font-medium text-foreground">{item.name}</span>
+						<span className="text-xs text-muted-foreground">
+							{formatMoney(item.sales.value.value)}
+						</span>
+						<span className="text-xs text-muted-foreground">
+							{t('reports.ranking.salesCount', { count: item.sales.count.value })}
+						</span>
+					</div>
+				))}
+			</div>
+		</div>
+	)
+}
