@@ -0,0 +1,23 @@
+import { create } from 'zustand'
+
+interface ReportsState {
+	compareBasket: string[]
+}
+
+interface ReportsActions {
+	toggleCompare: (productId: string) => void
+	clearBasket: () => void
+}
+
+type ReportsStore = ReportsState & ReportsActions
+
+export const useReportsStore = create<ReportsStore>(set => ({
+	compareBasket: [],
+	toggleCompare: (productId: string) =>
+		set(state => ({
+			compareBasket: state.compareBasket.includes(productId)
+				? state.compareBasket.filter(id => id !== productId)
+				: [...state.compareBasket, productId],
+		})),
+	clearBasket: () => set({ compareBasket: [] }),
+}))
