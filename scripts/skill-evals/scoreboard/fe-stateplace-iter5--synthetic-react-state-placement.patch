diff --git a/packages/app/react/src/routes/(app)/reports/-components/GoalEditorCard/index.tsx b/packages/app/react/src/routes/(app)/reports/-components/GoalEditorCard/index.tsx
new file mode 100644
index 000000000..0d3307755
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/GoalEditorCard/index.tsx
@@ -0,0 +1,278 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useForm } from '@tanstack/react-form'
+import { useQueryClient } from '@tanstack/react-query'
+import { differenceInCalendarDays, parseISO } from 'date-fns'
+import { toast } from 'sonner'
+import {
+	useGetGoal,
+	useCreateGoal,
+	getGoalQueryKey,
+	createGoalMutationRequestSchema,
+	GoalTypeEnum,
+	type GetGoalQueryResponse,
+	type CreateGoalMutationRequest,
+} from '@template/client-typescript/typescript'
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import { FieldError, FieldGroup, FieldLabel } from '@/components/ui/field'
+import { Select } from '@/components/ui/select'
+import { CurrencyInput } from '@/components/ui/currency-input'
+import { DatePicker } from '@/components/ui/date-picker'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { StarIcon } from '@/components/ui/icons'
+import { cn } from '@/lib/utils'
+import { useMoney } from '@/hooks'
+import type { DeepPartial } from '@/lib'
+
+type ActiveGoal = NonNullable<GetGoalQueryResponse['goal']>
+
+export function GoalEditorCard({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { data, isPending, isError } = useGetGoal()
+	const goal = data?.goal ?? null
+
+	return (
+		<Card className={cn('gap-4 p-6', className)} {...props}>
+			<div className="flex items-center gap-4">
+				<GradientIconBadge icon={StarIcon} />
+				<span className="flex-1 text-lg font-medium text-muted-foreground">
+					{t('reports.goal.title')}
+				</span>
+			</div>
+
+			<div className="border-t border-border/60" />
+
+			{isPending ? (
+				<GoalEditorSkeleton />
+			) : isError ? (
+				<p className="text-sm text-muted-foreground">{t('reports.goal.loadError')}</p>
+			) : (
+				// key forces remount when the active goal changes so defaultValues reset correctly
+				<GoalEditorForm key={goal?.id ?? 'new'} goal={goal} />
+			)}
+		</Card>
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Form — one instance per goal (mounted via key above)
+// ---------------------------------------------------------------------------
+
+interface GoalEditorFormProps {
+	goal: ActiveGoal | null
+}
+
+function GoalEditorForm({ goal }: GoalEditorFormProps) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const queryClient = useQueryClient()
+
+	const createGoal = useCreateGoal({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('reports.goal.saveSuccess'))
+				queryClient.invalidateQueries({ queryKey: getGoalQueryKey() })
+			},
+		},
+	})
+
+	const defaultValues: DeepPartial<CreateGoalMutationRequest> = goal
+		? {
+				type: goal.type,
+				targetAmount: goal.targetAmount,
+				from: goal.from,
+				to: goal.to,
+			}
+		: {}
+
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: createGoalMutationRequestSchema },
+		onSubmit: async ({ value }) => {
+			const result = createGoalMutationRequestSchema.safeParse(value)
+			if (!result.success) return
+			await createGoal.mutateAsync({ data: result.data })
+		},
+	})
+
+	return (
+		<form
+			className="flex flex-col gap-4"
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+		>
+			{/* Unsaved-changes banner — visible as soon as form diverges from loaded goal */}
+			<form.Subscribe selector={state => state.isDirty}>
+				{isDirty =>
+					isDirty ? (
+						<div className="rounded-md border border-warning/50 bg-warning/10 px-3 py-2 text-sm text-warning-foreground">
+							{t('reports.goal.unsavedChanges')}
+						</div>
+					) : null
+				}
+			</form.Subscribe>
+
+			<div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
+				{/* Goal type */}
+				<form.Field name="type">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<FieldGroup>
+								<FieldLabel htmlFor={field.name}>{t('reports.goal.typeLabel')}</FieldLabel>
+								<Select
+									enum={GoalTypeEnum}
+									i18nPrefix="enums.GoalType"
+									value={field.state.value}
+									onValueChange={field.handleChange}
+									placeholder="reports.goal.typePlaceholder"
+									id={field.name}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</FieldGroup>
+						)
+					}}
+				</form.Field>
+
+				{/* Target amount */}
+				<form.Field name="targetAmount">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<FieldGroup>
+								<FieldLabel htmlFor={field.name}>{t('reports.goal.amountLabel')}</FieldLabel>
+								<CurrencyInput
+									amountCents={field.state.value?.amountCents ?? 0}
+									currency={field.state.value?.currency ?? 'BRL'}
+									onAmountChange={cents =>
+										field.handleChange({ ...field.state.value, amountCents: cents })
+									}
+									onCurrencyChange={c =>
+										field.handleChange({ ...field.state.value, currency: c })
+									}
+									id={field.name}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</FieldGroup>
+						)
+					}}
+				</form.Field>
+
+				{/* From date */}
+				<form.Field name="from">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<FieldGroup>
+								<FieldLabel htmlFor={field.name}>{t('reports.goal.fromLabel')}</FieldLabel>
+								<DatePicker
+									date={field.state.value ? parseISO(field.state.value as string) : undefined}
+									onDateChange={d => field.handleChange(d?.toISOString() ?? '')}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</FieldGroup>
+						)
+					}}
+				</form.Field>
+
+				{/* To date */}
+				<form.Field name="to">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<FieldGroup>
+								<FieldLabel htmlFor={field.name}>{t('reports.goal.toLabel')}</FieldLabel>
+								<DatePicker
+									date={field.state.value ? parseISO(field.state.value as string) : undefined}
+									onDateChange={d => field.handleChange(d?.toISOString() ?? '')}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</FieldGroup>
+						)
+					}}
+				</form.Field>
+			</div>
+
+			{/* Live run-rate preview — reacts as the user types, before any save */}
+			<form.Subscribe
+				selector={state => ({
+					values: state.values,
+				})}
+			>
+				{({ values }) => {
+					const amountCents = values.targetAmount?.amountCents ?? 0
+					const currency = values.targetAmount?.currency
+					const fromStr = values.from as string | undefined
+					const toStr = values.to as string | undefined
+
+					if (!amountCents || !currency || !fromStr || !toStr) return null
+
+					let days: number
+					try {
+						days = differenceInCalendarDays(parseISO(toStr), parseISO(fromStr))
+					} catch {
+						return null
+					}
+
+					if (days <= 0) return null
+
+					const dailyCents = Math.round(amountCents / days)
+
+					return (
+						<div className="rounded-md bg-muted/50 px-3 py-2 text-sm text-muted-foreground">
+							{t('reports.goal.runRate', {
+								value: formatMoney({ amountCents: dailyCents, currency }),
+							})}
+						</div>
+					)
+				}}
+			</form.Subscribe>
+
+			{/* Submit */}
+			<form.Subscribe
+				selector={state => ({
+					canSubmit: state.canSubmit,
+					isSubmitting: state.isSubmitting,
+					values: state.values,
+				})}
+			>
+				{({ canSubmit, isSubmitting, values }) => {
+					const isPending = isSubmitting || createGoal.isPending
+					const isValid = createGoalMutationRequestSchema.safeParse(values).success
+					const isDisabled = !canSubmit || isPending || !isValid
+					return (
+						<div className="flex justify-end">
+							<Button type="submit" disabled={isDisabled}>
+								{isPending && <Spinner className="mr-2" />}
+								{t('reports.goal.save')}
+							</Button>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+function GoalEditorSkeleton() {
+	return (
+		<div className="flex flex-col gap-4">
+			<div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
+				{[1, 2, 3, 4].map(i => (
+					<div key={i} className="flex flex-col gap-1.5">
+						<Skeleton className="h-4 w-20" />
+						<Skeleton className="h-9 w-full" />
+					</div>
+				))}
+			</div>
+			<Skeleton className="h-9 w-24 self-end" />
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/(app)/reports/-components/RevenueTrendSection/index.tsx b/packages/app/react/src/routes/(app)/reports/-components/RevenueTrendSection/index.tsx
