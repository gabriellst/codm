+import { createFileRoute } from '@tanstack/react-router'
+import { endOfDay, startOfDay, subDays } from 'date-fns'
+import { z } from 'zod'
+import { getChartQueryParamsSchema } from '@template/client-typescript/typescript'
+import { RouteError } from '@/components/RouteError'
+import { RevenueTrendSection } from './-components/RevenueTrendSection'
+import { TopProductsSection } from './-components/TopProductsSection'
+import { GoalEditorCard } from './-components/GoalEditorCard'
+
+// Period + granularity live in the URL so the view is bookmarkable and shareable.
+// tenancyScope is account-level global state (useTenancyStore) — NOT a URL param.
+// chartType is fixed to 'income' on this page — NOT a URL param.
+// compareBasket is ephemeral and personal — lives in the route store, NOT the URL.
+export const reportsSearchSchema = getChartQueryParamsSchema
+	.omit({ chartType: true, tenancyScope: true, startDate: true, endDate: true, frequency: true })
+	.and(
+		z.object({
+			startDate: z.string().default(() => startOfDay(subDays(new Date(), 29)).toISOString()),
+			endDate: z.string().default(() => endOfDay(new Date()).toISOString()),
+			frequency: z
+				.enum(['HOURLY', 'DAILY', 'WEEKLY', 'MONTHLY', 'YEARLY'])
+				.optional()
+				.default('DAILY'),
+		}),
+	)
+
+export type ReportsSearchParams = z.infer<typeof reportsSearchSchema>
+
+export const Route = createFileRoute('/(app)/reports/')({
+	staticData: { breadcrumb: 'Relatórios' },
+	validateSearch: search => reportsSearchSchema.parse(search ?? {}),
+	errorComponent: RouteError,
+	component: RouteComponent,
+})
+
+function RouteComponent() {
+	return (
+		<div className="flex flex-1 flex-col gap-6 overflow-y-auto p-6 md:p-8">
+			<RevenueTrendSection />
+			<TopProductsSection />
+			<GoalEditorCard />
+		</div>
+	)
+}
