index 000000000..2da636554
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/RevenueTrendSection/index.tsx
@@ -0,0 +1,177 @@
+import { useMemo } from 'react'
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { format } from 'date-fns'
+import { ResponsiveContainer, BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip } from 'recharts'
+import {
+	useGetChart,
+	AnalyticsFrequencyEnum,
+	type AnalyticsFrequency,
+} from '@template/client-typescript/typescript'
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Select } from '@/components/ui/select'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { BarGraphIcon } from '@/components/ui/icons'
+import { cn } from '@/lib/utils'
+import { useTenancyStore } from '@/stores'
+import { useMoney } from '@/hooks'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+interface ChartRow {
+	label: string
+	revenue: number
+	profit: number
+}
+
+const SKELETON_HEIGHTS = [55, 80, 45, 90, 65, 40, 75, 85, 50, 70, 60, 88]
+
+export function RevenueTrendSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const { startDate, endDate, frequency, productIds } = routeApi.useSearch()
+	const navigate = routeApi.useNavigate()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+
+	const activeFrequency = (frequency ?? 'DAILY') as AnalyticsFrequency
+
+	const { data, isPending, isError } = useGetChart({
+		chartType: 'income',
+		tenancyScope,
+		frequency: activeFrequency,
+		startDate,
+		endDate,
+		productIds,
+	})
+
+	const rows = useMemo((): ChartRow[] => {
+		if (!data || data.kind !== 'income') return []
+		return data.buckets.map(b => ({
+			label: format(new Date(b.timestamp), 'dd/MM'),
+			revenue: b.revenue.amountCents / 100,
+			profit: b.profit.amountCents / 100,
+		}))
+	}, [data])
+
+	const currency = data?.kind === 'income' ? data.currency : undefined
+
+	function handleFrequencyChange(value: AnalyticsFrequency) {
+		navigate({ search: prev => ({ ...prev, frequency: value }) })
+	}
+
+	return (
+		<Card className={cn('gap-4 p-6', className)} {...props}>
+			{/* Header */}
+			<div className="flex flex-wrap items-center gap-4">
+				<GradientIconBadge icon={BarGraphIcon} />
+				<span className="flex-1 text-lg font-medium text-muted-foreground">
+					{t('reports.trend.title')}
+				</span>
+				<Select
+					enum={AnalyticsFrequencyEnum}
+					i18nPrefix="enums.AnalyticsFrequency"
+					value={activeFrequency}
+					onValueChange={handleFrequencyChange}
+					aria-label={t('reports.trend.frequencyAria')}
+				/>
+			</div>
+
+			<div className="border-t border-border/60" />
+
+			{/* Chart area */}
+			{isPending ? (
+				<RevenueTrendSkeleton />
+			) : isError || !rows.length ? (
+				<p className="py-8 text-center text-sm text-muted-foreground">
+					{isError ? t('reports.trend.loadError') : t('reports.trend.empty')}
+				</p>
+			) : (
+				<div aria-label={t('reports.trend.chartAria')}>
+					<ResponsiveContainer width="100%" height={256}>
+						<BarChart data={rows} margin={{ top: 8, right: 8, bottom: 24, left: 48 }}>
+							<CartesianGrid
+								strokeDasharray="4 4"
+								stroke="color-mix(in oklch, var(--border) 60%, transparent)"
+								vertical={false}
+							/>
+							<XAxis
+								dataKey="label"
+								tick={{ fill: 'color-mix(in oklch, var(--muted-foreground) 60%, transparent)', fontSize: 11 }}
+								tickLine={false}
+								axisLine={false}
+							/>
+							<YAxis
+								tick={{ fill: 'color-mix(in oklch, var(--muted-foreground) 60%, transparent)', fontSize: 11 }}
+								tickLine={false}
+								axisLine={false}
+								tickFormatter={v => {
+									const n = Number(v)
+									if (Math.abs(n) >= 1000) return `${(n / 1000).toFixed(0)}k`
+									return String(n.toFixed(0))
+								}}
+							/>
+							<Tooltip
+								content={({ payload, label }) => {
+									if (!payload?.length) return null
+									const revenue = payload.find(p => p.dataKey === 'revenue')?.value
+									const profit = payload.find(p => p.dataKey === 'profit')?.value
+									return (
+										<div className="rounded-lg border border-border bg-card px-3 py-2 text-xs shadow-lg">
+											<div className="mb-1.5 font-semibold text-foreground">{label}</div>
+											<div className="flex flex-col gap-1">
+												<div className="flex items-center justify-between gap-4">
+													<span className="text-foreground/80">{t('reports.trend.tooltip.revenue')}</span>
+													<span className="font-medium text-foreground">
+														{currency && revenue != null
+															? formatMoney({ amountCents: Number(revenue) * 100, currency })
+															: '—'}
+													</span>
+												</div>
+												<div className="flex items-center justify-between gap-4">
+													<span className="text-foreground/80">{t('reports.trend.tooltip.profit')}</span>
+													<span className="font-medium text-foreground">
+														{currency && profit != null
+															? formatMoney({ amountCents: Number(profit) * 100, currency })
+															: '—'}
+													</span>
+												</div>
+											</div>
+										</div>
+									)
+								}}
+							/>
+							<Bar
+								dataKey="revenue"
+								fill="var(--primary)"
+								radius={[3, 3, 0, 0]}
+								name={t('reports.trend.tooltip.revenue')}
+							/>
+							<Bar
+								dataKey="profit"
+								fill="var(--success)"
+								radius={[3, 3, 0, 0]}
+								name={t('reports.trend.tooltip.profit')}
+							/>
+						</BarChart>
+					</ResponsiveContainer>
+				</div>
+			)}
+		</Card>
+	)
+}
+
+function RevenueTrendSkeleton() {
+	return (
+		<div className="flex h-64 items-end gap-1 px-8 pb-6">
+			{SKELETON_HEIGHTS.map((h, i) => (
+				<Skeleton
+					key={`trend-skeleton-${i}`}
+					className="flex-1 rounded"
+					style={{ height: `${h}%` }}
+				/>
+			))}
+		</div>
+	)
+}
