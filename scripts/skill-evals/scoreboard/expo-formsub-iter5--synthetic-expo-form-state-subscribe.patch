--- /dev/null
+++ b/packages/app/expo/app/(sheets)/kit-form/-components/KitItemList/KitItemRow/index.tsx
@@ -0,0 +1,72 @@
+// The 3-mode discriminant selector prevents re-renders when the editor's
+// draft fields change. Selector returns a primitive (0 | 1 | 2):
+//   0 → no row selected (idle)
+//   1 → THIS row is the one being edited (highlighted)
+//   2 → ANOTHER row is being edited (dimmed)
+// TanStack Form's structural-equality check only fires a re-render when the
+// mode actually changes — typing in NumField/Input in the editor does NOT
+// re-render every row.
+
+import { Pressable, Text, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import type { KitForm, KitItemFormData } from '../../../-types'
+
+interface KitItemRowProps {
+	form: KitForm
+	item: KitItemFormData
+	itemIndex: number
+}
+
+export function KitItemRow({ form, item, itemIndex }: KitItemRowProps) {
+	const { t } = useTranslation()
+
+	const handleSelect = () => {
+		form.setFieldValue('editingSelection', { index: itemIndex })
+		form.setFieldValue('draftProductId', item.productId)
+		form.setFieldValue('draftProductName', item.productName)
+		form.setFieldValue('draftQuantity', item.quantity)
+		form.setFieldValue('draftQuantityModifier', item.quantityModifier)
+	}
+
+	return (
+		<form.Subscribe
+			selector={s => {
+				const sel = s.values.editingSelection
+				if (sel == null) return 0 as const
+				return sel.index === itemIndex ? (1 as const) : (2 as const)
+			}}
+		>
+			{mode => {
+				const isSelected = mode === 1
+				const isOtherEditing = mode === 2
+
+				return (
+					<Pressable
+						onPress={handleSelect}
+						accessibilityRole="button"
+						accessibilityLabel={t('kitForm.productLabel')}
+						className={[
+							'flex-row items-center justify-between py-3 px-3.5 rounded-md border',
+							isSelected
+								? 'bg-muted/40 border-white/[0.32]'
+								: 'bg-card/30 border-white/[0.08]',
+							isOtherEditing ? 'opacity-40' : '',
+						].join(' ')}
+					>
+						<View className="flex-1 gap-0.5">
+							<Text className="text-foreground font-sans-semi text-sm">{item.productName}</Text>
+							<Text className="text-foreground-subtle font-sans text-xs">
+								{item.quantity} × {t(`enums.quantityModifier.${item.quantityModifier}`)}
+							</Text>
+						</View>
+						{isSelected ? (
+							<Text className="text-foreground-subtle font-sans text-xs ml-3">
+								{t('common.save')}
+							</Text>
+						) : null}
+					</Pressable>
+				)
+			}}
+		</form.Subscribe>
+	)
+}
diff --git a/packages/app/expo/app/(sheets)/kit-form/-components/KitItemList/index.tsx b/packages/app/expo/app/(sheets)/kit-form/-components/KitItemList/index.tsx
