@@ -0,0 +1,52 @@
+// KitItemList subscribes to `items` by reference — the FlatList only
+// re-renders when items are added/removed/reordered. Typing in the
+// editor's draft fields leaves this component untouched because the
+// selector returns the stable `items` array reference.
+//
+// Empty state shows the "Add first item" CTA that opens the product picker
+// (same picker as the editor's product field button).
+
+import { Pressable, Text, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import { Eyebrow } from '@/components/ui/Eyebrow'
+import type { KitForm, KitItemFormData } from '../../-types'
+import { KitItemRow } from './KitItemRow'
+
+interface KitItemListProps {
+	form: KitForm
+	onOpenPicker: () => void
+}
+
+export function KitItemList({ form, onOpenPicker }: KitItemListProps) {
+	const { t } = useTranslation()
+
+	return (
+		<View className="gap-3">
+			<Eyebrow>{t('kitForm.itemsTitle')}</Eyebrow>
+
+			<form.Subscribe selector={s => s.values.items ?? []}>
+				{items =>
+					items.length === 0 ? (
+						<Pressable
+							onPress={onOpenPicker}
+							accessibilityRole="button"
+							className="py-4 items-center rounded-md border border-dashed border-white/[0.22]"
+						>
+							<Text className="text-foreground-subtle font-sans-semi text-sm">
+								+ {t('kitForm.emptyItemsCta')}
+							</Text>
+						</Pressable>
+					) : (
+						<View className="gap-2">
+							{items.map((item, index) =>
+								item ? (
+									<KitItemRow key={item.productId} form={form} item={item as KitItemFormData} itemIndex={index} />
+								) : null,
+							)}
+						</View>
+					)
+				}
+			</form.Subscribe>
+		</View>
+	)
+}
