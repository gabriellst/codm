+++ b/packages/app/expo/app/(sheets)/kit-form/-types.ts
@@ -0,0 +1,54 @@
+// app/(sheets)/kit-form/-types.ts
+//
+// The merged form schema is the API mutation request payload PLUS UI-only
+// fields:
+//   - `itemNames`: display names for each item (index-matched with `items`)
+//   - `editingSelection`: null = adding a new item; populated = editing row at
+//     that index
+//   - `draftProduct*` / `draftQuantity` / `draftQuantityModifier`: the editor's
+//     live draft — used by both the "add" and "edit" modes
+//
+// At submit time, `createKitMutationRequestSchema.safeParse(...)` strips all
+// UI-only fields before the request goes to the server.
+//
+// `KitForm` is exported as a TYPE only — `_inferKitForm` is never called at
+// runtime; it exists so child components can annotate `form: KitForm` without
+// re-deriving TanStack Form's generic arguments at every call site.
+
+import { z } from 'zod/v4'
+import { useForm } from '@tanstack/react-form'
+import type { DeepPartial } from '@/lib'
+
+export const kitItemFormSchema = z.object({
+	productId: z.string(),
+	productName: z.string(),
+	quantity: z.number(),
+	quantityModifier: z.enum(['EQ', 'GT', 'GTE', 'LT', 'LTE']),
+})
+
+export type KitItemFormData = z.infer<typeof kitItemFormSchema>
+
+export const kitFormSchema = z.object({
+	name: z.string(),
+	type: z.enum(['SINGLE', 'MULTIPLE']),
+	shipping: z.number(),
+	cost: z.number().optional(),
+	items: z.array(kitItemFormSchema),
+	editingSelection: z.object({ index: z.number().int().nonnegative() }).nullable(),
+	draftProductId: z.string(),
+	draftProductName: z.string(),
+	draftQuantity: z.number(),
+	draftQuantityModifier: z.enum(['EQ', 'GT', 'GTE', 'LT', 'LTE']),
+})
+
+export type KitFormData = z.infer<typeof kitFormSchema>
+
+function _inferKitForm() {
+	const defaults: DeepPartial<KitFormData> = {}
+	return useForm({
+		defaultValues: defaults,
+		validators: { onChange: kitFormSchema },
+	})
+}
+
+export type KitForm = ReturnType<typeof _inferKitForm>
diff --git a/packages/app/expo/app/(sheets)/kit-form/index.tsx b/packages/app/expo/app/(sheets)/kit-form/index.tsx
