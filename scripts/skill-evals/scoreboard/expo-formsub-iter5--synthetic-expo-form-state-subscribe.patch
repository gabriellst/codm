@@ -0,0 +1,189 @@
+// KitItemEditor — assembles one kit item (product + quantity + rule).
+//
+// Always renders the same draft fields regardless of mode:
+//   add mode  (editingSelection == null) → "Add item" button
+//   edit mode (editingSelection != null) → "Save item" + "Cancel" buttons
+//
+// The product field is a Pressable that opens the in-page product picker
+// rather than a TextInput — the user never types a product name directly.
+//
+// Perf: each form.Field subscription is scoped to a single draft field, so
+// sibling NumFields don't force each other to re-render. The submit-area
+// form.Subscribe captures all draft values in one shallow-compared selector
+// so the button row re-renders only when something actionable changes.
+
+import { Pressable, Text, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import {
+	QuantityModifierEnum,
+	type QuantityModifier,
+} from '@template/client-typescript/typescript'
+import { Button } from '@/components/ui/Button'
+import { NumField } from '@/components/ui/NumField'
+import type { KitForm } from '../../-types'
+
+interface KitItemEditorProps {
+	form: KitForm
+	onOpenPicker: () => void
+}
+
+export function KitItemEditor({ form, onOpenPicker }: KitItemEditorProps) {
+	const { t } = useTranslation()
+
+	return (
+		<View className="gap-3 py-3 px-4 rounded-xl border border-white/[0.10] bg-card/60">
+			<form.Field name="draftProductName">
+				{field => (
+					<View className="gap-1.5">
+						<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+							{t('kitForm.productLabel')}
+						</Text>
+						<Pressable
+							onPress={onOpenPicker}
+							accessibilityRole="button"
+							accessibilityLabel={t('kitForm.productLabel')}
+							className="px-3 py-2.5 rounded-md border border-white/[0.10] bg-card/40 flex-row items-center justify-between"
+						>
+							<Text
+								className={[
+									'font-sans text-sm flex-1',
+									field.state.value ? 'text-foreground' : 'text-foreground-subtle',
+								].join(' ')}
+							>
+								{field.state.value || t('kitForm.productPlaceholder')}
+							</Text>
+							<Text className="text-foreground-subtle font-sans text-xs ml-2">›</Text>
+						</Pressable>
+					</View>
+				)}
+			</form.Field>
+
+			<View className="flex-row gap-3 items-start">
+				<View className="flex-1">
+					<form.Field name="draftQuantity">
+						{field => (
+							<NumField
+								label={t('kitForm.quantityLabel')}
+								value={field.state.value ?? 1}
+								onChange={field.handleChange}
+								step={1}
+								min={1}
+							/>
+						)}
+					</form.Field>
+				</View>
+
+				<View className="flex-1 gap-1.5">
+					<Text className="text-foreground-subtle font-sans-semi text-xs uppercase text-center">
+						{t('kitForm.quantityModifierLabel')}
+					</Text>
+					<form.Field name="draftQuantityModifier">
+						{field => (
+							<View className="flex-row flex-wrap gap-1.5 justify-center">
+								{(Object.values(QuantityModifierEnum) as QuantityModifier[]).map(mod => (
+									<Pressable
+										key={mod}
+										onPress={() => field.handleChange(mod)}
+										accessibilityRole="button"
+										accessibilityLabel={t(`enums.quantityModifier.${mod}`)}
+										className={[
+											'px-2 py-1 rounded border',
+											field.state.value === mod
+												? 'bg-muted/60 border-white/[0.32]'
+												: 'border-white/[0.08]',
+										].join(' ')}
+									>
+										<Text
+											className={[
+												'font-sans text-[11px]',
+												field.state.value === mod ? 'text-foreground' : 'text-foreground-subtle',
+											].join(' ')}
+										>
+											{t(`enums.quantityModifier.${mod}`)}
+										</Text>
+									</Pressable>
+								))}
+							</View>
+						)}
+					</form.Field>
+				</View>
+			</View>
+
+			<form.Subscribe
+				selector={s => ({
+					sel: s.values.editingSelection,
+					draftProductId: s.values.draftProductId ?? '',
+					draftProductName: s.values.draftProductName ?? '',
+					draftQuantity: s.values.draftQuantity ?? 1,
+					draftQuantityModifier: (s.values.draftQuantityModifier ?? 'EQ') as QuantityModifier,
+					items: s.values.items ?? [],
+				})}
+			>
+				{({ sel, draftProductId, draftProductName, draftQuantity, draftQuantityModifier, items }) => {
+					const canConfirm = !!draftProductId && draftQuantity > 0
+
+					const resetDraft = () => {
+						form.setFieldValue('draftProductId', '')
+						form.setFieldValue('draftProductName', '')
+						form.setFieldValue('draftQuantity', 1)
+						form.setFieldValue('draftQuantityModifier', 'EQ')
+					}
+
+					if (sel != null) {
+						return (
+							<View className="gap-2">
+								<Button
+									label={t('kitForm.saveItem')}
+									fullWidth
+									disabled={!canConfirm}
+									onPress={() => {
+										const updated = [...items]
+										updated[sel.index as number] = {
+											productId: draftProductId,
+											productName: draftProductName,
+											quantity: draftQuantity,
+											quantityModifier: draftQuantityModifier,
+										}
+										form.setFieldValue('items', updated)
+										form.setFieldValue('editingSelection', null)
+										resetDraft()
+									}}
+								/>
+								<Button
+									label={t('kitForm.cancelEdit')}
+									variant="ghost"
+									fullWidth
+									onPress={() => {
+										form.setFieldValue('editingSelection', null)
+										resetDraft()
+									}}
+								/>
+							</View>
+						)
+					}
+
+					return (
+						<Button
+							label={t('kitForm.addItem')}
+							variant="ghost"
+							fullWidth
+							disabled={!canConfirm}
+							onPress={() => {
+								form.setFieldValue('items', [
+									...items,
+									{
+										productId: draftProductId,
+										productName: draftProductName,
+										quantity: draftQuantity,
+										quantityModifier: draftQuantityModifier,
+									},
+								])
+								resetDraft()
+							}}
+						/>
+					)
+				}}
+			</form.Subscribe>
+		</View>
+	)
+}
diff --git a/packages/app/expo/app/(sheets)/kit-form/-components/KitItemList/KitItemRow/index.tsx b/packages/app/expo/app/(sheets)/kit-form/-components/KitItemList/KitItemRow/index.tsx
