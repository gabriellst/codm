@@ -0,0 +1,24 @@
+import { create } from 'zustand'
+
+interface KitFormStoreState {
+	isPickerOpen: boolean
+}
+
+interface KitFormStoreActions {
+	openPicker: () => void
+	closePicker: () => void
+	reset: () => void
+}
+
+type KitFormStore = KitFormStoreState & KitFormStoreActions
+
+const initialState: KitFormStoreState = {
+	isPickerOpen: false,
+}
+
+export const useKitFormStore = create<KitFormStore>(set => ({
+	...initialState,
+	openPicker: () => set({ isPickerOpen: true }),
+	closePicker: () => set({ isPickerOpen: false }),
+	reset: () => set(initialState),
+}))
diff --git a/packages/app/expo/app/(sheets)/kit-form/-types.ts b/packages/app/expo/app/(sheets)/kit-form/-types.ts
