@@ -0,0 +1,268 @@
+import { useEffect } from 'react'
+import { Pressable, ScrollView, Text, View } from 'react-native'
+import { router } from 'expo-router'
+import { useForm } from '@tanstack/react-form'
+import { useQueryClient } from '@tanstack/react-query'
+import { Haptics } from 'react-native-nitro-haptics'
+import { useTranslation } from 'react-i18next'
+import { z } from 'zod/v4'
+import {
+	useCreateKit,
+	listKitsQueryKey,
+	createKitMutationRequestSchema,
+	ProductCostTypeEnum,
+	type ProductCostType,
+} from '@template/client-typescript/typescript'
+import { Protected } from '@/components/Protected'
+import { Button } from '@/components/ui/Button'
+import { Eyebrow } from '@/components/ui/Eyebrow'
+import { Input, InputGroup, InputPrefix } from '@/components/ui/Input'
+import { KeyboardAware } from '@/components/ui/KeyboardAware'
+import { NumField } from '@/components/ui/NumField'
+import { IconClose } from '@/components/ui/Icons'
+import type { DeepPartial } from '@/lib'
+import { fg } from '@/lib/tokens'
+import { useTypedSearchParams } from '@/lib/typed-route'
+import { kitFormSchema, type KitFormData } from './-types'
+import { useKitFormStore } from './-stores/kit-form-store'
+import { KitItemEditor } from './-components/KitItemEditor'
+import { KitItemList } from './-components/KitItemList'
+import { ProductPicker } from './-components/ProductPicker'
+
+const paramsSchema = z.object({
+	type: z.enum(['SINGLE', 'MULTIPLE']).default('SINGLE'),
+})
+
+export default function KitFormSheet() {
+	const { t } = useTranslation()
+	const [{ type: preselectedType }] = useTypedSearchParams(paramsSchema)
+	const queryClient = useQueryClient()
+	const createKit = useCreateKit()
+	const openPicker = useKitFormStore(s => s.openPicker)
+	const resetStore = useKitFormStore(s => s.reset)
+
+	// Ensure picker never survives unmount/remount
+	useEffect(() => {
+		resetStore()
+		return () => { resetStore() }
+	}, [resetStore])
+
+	const form = useForm({
+		defaultValues: {
+			name: '',
+			type: preselectedType,
+			shipping: 0,
+			cost: undefined,
+			items: [],
+			editingSelection: null,
+			draftProductId: '',
+			draftProductName: '',
+			draftQuantity: 1,
+			draftQuantityModifier: 'EQ',
+		} as DeepPartial<KitFormData>,
+		validators: { onChange: kitFormSchema },
+		onSubmit: async ({ value }) => {
+			const api = createKitMutationRequestSchema.safeParse({
+				name: value.name,
+				type: value.type,
+				shipping: value.shipping,
+				cost: value.cost,
+				items: (value.items ?? []).map(({ productId, quantity, quantityModifier }) => ({
+					productId,
+					quantity,
+					quantityModifier,
+				})),
+			})
+			if (!api.success) return
+
+			await createKit.mutateAsync(
+				{ data: api.data },
+				{
+					onSuccess: () => {
+						Haptics.notification('success')
+						router.back()
+					},
+					onSettled: () => queryClient.invalidateQueries({ queryKey: listKitsQueryKey() }),
+				},
+			)
+		},
+	})
+
+	return (
+		<Protected>
+			<KeyboardAware style={{ flex: 1 }}>
+				<ScrollView
+					className="flex-1"
+					contentContainerStyle={{ paddingBottom: 32, paddingTop: 16, paddingHorizontal: 20, gap: 20 }}
+					keyboardShouldPersistTaps="handled"
+				>
+					{/* Header */}
+					<View className="flex-row items-center justify-between mb-2">
+						<Text className="text-foreground font-sans-bold text-xl flex-1">
+							{t('kitForm.title')}
+						</Text>
+						<Pressable
+							onPress={() => router.back()}
+							accessibilityRole="button"
+							accessibilityLabel={t('common.close')}
+							hitSlop={12}
+						>
+							<IconClose size={20} color={fg.fg1} />
+						</Pressable>
+					</View>
+
+					{/* Kit name */}
+					<form.Field name="name">
+						{field => (
+							<View className="gap-1.5">
+								<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+									{t('kitForm.nameLabel')}
+								</Text>
+								<InputGroup>
+									<Input
+										value={field.state.value ?? ''}
+										onChangeText={field.handleChange}
+										onBlur={field.handleBlur}
+										placeholder={t('kitForm.namePlaceholder')}
+										accessibilityLabel={t('kitForm.nameLabel')}
+									/>
+								</InputGroup>
+								{field.state.meta.isTouched && !field.state.meta.isValid ? (
+									<Text className="text-destructive text-xs font-sans">
+										{field.state.meta.errors.join(', ')}
+									</Text>
+								) : null}
+							</View>
+						)}
+					</form.Field>
+
+					{/* Kit type */}
+					<form.Field name="type">
+						{field => (
+							<View className="gap-1.5">
+								<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+									{t('kitForm.typeLabel')}
+								</Text>
+								<View className="flex-row gap-2">
+									{(Object.values(ProductCostTypeEnum) as ProductCostType[]).map(type => (
+										<Pressable
+											key={type}
+											onPress={() => field.handleChange(type)}
+											accessibilityRole="button"
+											accessibilityLabel={t(`enums.productCostType.${type}`)}
+											className={[
+												'flex-1 py-2.5 items-center rounded-md border',
+												field.state.value === type
+													? 'bg-muted/60 border-white/[0.32]'
+													: 'border-white/[0.08]',
+											].join(' ')}
+										>
+											<Text
+												className={[
+													'font-sans-semi text-sm',
+													field.state.value === type
+														? 'text-foreground'
+														: 'text-foreground-subtle',
+												].join(' ')}
+											>
+												{t(`enums.productCostType.${type}`)}
+											</Text>
+										</Pressable>
+									))}
+								</View>
+							</View>
+						)}
+					</form.Field>
+
+					{/* Shipping */}
+					<form.Field name="shipping">
+						{field => (
+							<View className="gap-1.5">
+								<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+									{t('kitForm.shippingLabel')}
+								</Text>
+								<InputGroup>
+									<InputPrefix>R$</InputPrefix>
+									<Input
+										value={String(field.state.value ?? 0)}
+										onChangeText={v => field.handleChange(Number(v.replace(',', '.')) || 0)}
+										onBlur={field.handleBlur}
+										keyboardType="decimal-pad"
+										accessibilityLabel={t('kitForm.shippingLabel')}
+									/>
+								</InputGroup>
+							</View>
+						)}
+					</form.Field>
+
+					{/* Optional extra cost */}
+					<form.Field name="cost">
+						{field => (
+							<View className="gap-1.5">
+								<Text className="text-foreground-subtle font-sans-semi text-xs uppercase">
+									{t('kitForm.costLabel')}
+								</Text>
+								<InputGroup>
+									<InputPrefix>R$</InputPrefix>
+									<Input
+										value={field.state.value != null ? String(field.state.value) : ''}
+										onChangeText={v => {
+											const parsed = Number(v.replace(',', '.'))
+											field.handleChange(v === '' ? undefined : isNaN(parsed) ? undefined : parsed)
+										}}
+										onBlur={field.handleBlur}
+										keyboardType="decimal-pad"
+										accessibilityLabel={t('kitForm.costLabel')}
+									/>
+								</InputGroup>
+							</View>
+						)}
+					</form.Field>
+
+					{/* Item editor */}
+					<KitItemEditor form={form} onOpenPicker={openPicker} />
+
+					{/* Items list */}
+					<KitItemList form={form} onOpenPicker={openPicker} />
+
+					{/* Submit */}
+					<form.Subscribe
+						selector={s => ({
+							canSubmit: s.canSubmit,
+							isSubmitting: s.isSubmitting,
+							values: s.values,
+						})}
+					>
+						{({ canSubmit, isSubmitting, values }) => {
+							const apiCheck = createKitMutationRequestSchema.safeParse({
+								name: values.name,
+								type: values.type,
+								shipping: values.shipping,
+								cost: values.cost,
+								items: (values.items ?? []).map(({ productId, quantity, quantityModifier }) => ({
+									productId,
+									quantity,
+									quantityModifier,
+								})),
+							})
+							const isDisabled =
+								!canSubmit || isSubmitting || createKit.isPending || !apiCheck.success
+							return (
+								<Button
+									label={t('kitForm.submit')}
+									fullWidth
+									onPress={() => void form.handleSubmit()}
+									disabled={isDisabled}
+								/>
+							)
+						}}
+					</form.Subscribe>
+				</ScrollView>
+			</KeyboardAware>
+
+			{/* In-page product picker overlay — rendered at the screen level so
+			    the Modal is never nested inside a ScrollView */}
+			<ProductPicker form={form} />
+		</Protected>
+	)
+}
