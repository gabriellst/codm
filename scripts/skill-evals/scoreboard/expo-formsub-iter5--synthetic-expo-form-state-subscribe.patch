@@ -0,0 +1,52 @@
+import { FlatList, Pressable, Text, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import { useListProductsForKit } from '@template/client-typescript/typescript'
+import { Sheet } from '@/components/ui/Sheet'
+import { formatMoney } from '@/lib/format'
+import type { KitForm } from '../../-types'
+import { useKitFormStore } from '../../-stores/kit-form-store'
+
+interface ProductPickerProps {
+	form: KitForm
+}
+
+export function ProductPicker({ form }: ProductPickerProps) {
+	const { t } = useTranslation()
+	const isPickerOpen = useKitFormStore(s => s.isPickerOpen)
+	const closePicker = useKitFormStore(s => s.closePicker)
+	const { data } = useListProductsForKit({ page: 1, limit: 20 })
+
+	const handleSelect = (productId: string, productName: string) => {
+		form.setFieldValue('draftProductId', productId)
+		form.setFieldValue('draftProductName', productName)
+		closePicker()
+	}
+
+	return (
+		<Sheet open={isPickerOpen} onClose={closePicker} title={t('kitForm.pickerTitle')} size="tall">
+			<FlatList
+				data={data?.items ?? []}
+				keyExtractor={item => item.id}
+				keyboardShouldPersistTaps="handled"
+				renderItem={({ item }) => (
+					<Pressable
+						onPress={() => handleSelect(item.id, item.name)}
+						accessibilityRole="button"
+						accessibilityLabel={item.name}
+						className="flex-row items-center justify-between py-3 px-1 border-b border-white/[0.06]"
+					>
+						<View className="flex-1 gap-0.5">
+							<Text className="text-foreground font-sans-semi text-sm">{item.name}</Text>
+							{item.sku ? (
+								<Text className="text-foreground-subtle font-sans text-xs">{item.sku}</Text>
+							) : null}
+						</View>
+						<Text className="text-foreground-subtle font-sans text-sm ml-3">
+							{formatMoney(item.currentCost.amountCents / 100, item.currentCost.currency)}
+						</Text>
+					</Pressable>
+				)}
+			/>
+		</Sheet>
+	)
+}
