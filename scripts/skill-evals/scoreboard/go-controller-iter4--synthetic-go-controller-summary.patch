+func newSummaryController(counts map[enums.SyncStatus]int) *SyncJobsSummaryController {
+	repo := &controllerTestRepo{}
+	repo.counts = counts
+	uc := usecases.NewGetSyncJobsSummary(repo)
+	return NewSyncJobsSummaryController(uc)
+}
+
+func TestSyncJobsSummaryController_HappyPath(t *testing.T) {
+	storeID := objects.NewID().String()
+	ctrl := newSummaryController(map[enums.SyncStatus]int{
+		enums.SyncStatusPending:   3,
+		enums.SyncStatusRunning:   1,
+		enums.SyncStatusCompleted: 5,
+	})
