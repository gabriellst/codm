+package controllers
+
+import (
+	"net/http"
+
+	"template/api-go/internal/sync/usecases"
+	coreerrors "template/core-go/errors"
+	"template/core-go/pkg/httputil"
+	"template/core-go/types"
+)
+
+// SyncJobsSummaryRequest is the decoded query params for GET /sync/jobs/summary.
+type SyncJobsSummaryRequest struct {
+	StoreID string `from:"query" name:"storeId" validate:"required,uuid"`
+}
+
+// SyncJobsSummaryController handles GET /sync/jobs/summary — per-status job counts
+// for a store, intended for the ops dashboard header.
+type SyncJobsSummaryController struct {
+	uc *usecases.GetSyncJobsSummary
+}
+
+// NewSyncJobsSummaryController constructs the controller.
+func NewSyncJobsSummaryController(uc *usecases.GetSyncJobsSummary) *SyncJobsSummaryController {
+	return &SyncJobsSummaryController{uc: uc}
+}
+
+// Metadata returns route metadata for auto-registration.
+func (c *SyncJobsSummaryController) Metadata() types.ControllerMetadata {
+	return types.ControllerMetadata{
+		Context:     "sync",
+		Path:        "/sync/jobs/summary",
+		Method:      http.MethodGet,
+		Description: "Per-status sync-job counts for a store (ops dashboard header)",
+		Tags:        []string{"sync"},
+		Request:     SyncJobsSummaryRequest{},
+		Response:    usecases.GetSyncJobsSummaryOutput{},
+		Errors: []coreerrors.ErrorCode{
+			"INVALID_ID",
+		},
+	}
+}
+
+// Handle reads storeId from query params and returns per-status counts.
+func (c *SyncJobsSummaryController) Handle(w http.ResponseWriter, r *http.Request) {
+	req, err := httputil.DecodeRequest[SyncJobsSummaryRequest](r)
+	if err != nil {
+		httputil.RespondError(w, err)
+		return
+	}
+
+	out, err := c.uc.Execute(r.Context(), usecases.GetSyncJobsSummaryInput{
+		StoreID: req.StoreID,
+	})
+	if err != nil {
+		httputil.RespondError(w, err)
+		return
+	}
+	httputil.RespondJSON(w, http.StatusOK, out)
+}
