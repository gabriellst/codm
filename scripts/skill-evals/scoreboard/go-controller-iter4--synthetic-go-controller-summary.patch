+	req := httptest.NewRequest(http.MethodGet, "/sync/jobs/summary?storeId="+storeID, nil)
+	w := httptest.NewRecorder()
+	ctrl.Handle(w, req)
+
+	if w.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200; body=%s", w.Code, w.Body.String())
+	}
+
+	var out usecases.GetSyncJobsSummaryOutput
+	if err := json.Unmarshal(w.Body.Bytes(), &out); err != nil {
+		t.Fatalf("unmarshal: %v", err)
+	}
+	if out.Pending != 3 {
+		t.Errorf("Pending = %d, want 3", out.Pending)
+	}
+	if out.Running != 1 {
+		t.Errorf("Running = %d, want 1", out.Running)
+	}
+	if out.Completed != 5 {
+		t.Errorf("Completed = %d, want 5", out.Completed)
+	}
+	if out.Total != 9 {
+		t.Errorf("Total = %d, want 9", out.Total)
+	}
+}
+
