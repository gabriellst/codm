@@ -0,0 +1,95 @@
+package usecases
+
+import (
+	"context"
+	"testing"
+
+	"template/api-go/internal/sync/enums"
+	"template/core-go/objects"
+)
+
+func TestGetSyncJobsSummary_EmptyStore(t *testing.T) {
+	repo := &fakeSyncJobRepoForStatus{}
+	uc := NewGetSyncJobsSummary(repo)
+
+	out, err := uc.Execute(context.Background(), GetSyncJobsSummaryInput{
+		StoreID: objects.NewID().String(),
+	})
+	if err != nil {
+		t.Fatalf("Execute: %v", err)
+	}
+	if out.Total != 0 {
+		t.Errorf("Total = %d, want 0", out.Total)
+	}
+	if out.Pending != 0 || out.Running != 0 || out.Completed != 0 || out.Failed != 0 || out.Cancelled != 0 {
+		t.Errorf("all counts should be 0 for empty store: %+v", out)
+	}
+}
+
+func TestGetSyncJobsSummary_MixedStatuses(t *testing.T) {
+	repo := &fakeSyncJobRepoForStatus{
+		counts: map[enums.SyncStatus]int{
+			enums.SyncStatusPending:   2,
+			enums.SyncStatusRunning:   1,
+			enums.SyncStatusCompleted: 3,
+			enums.SyncStatusFailed:    1,
+		},
+	}
+	uc := NewGetSyncJobsSummary(repo)
+
+	out, err := uc.Execute(context.Background(), GetSyncJobsSummaryInput{
+		StoreID: objects.NewID().String(),
+	})
+	if err != nil {
+		t.Fatalf("Execute: %v", err)
+	}
+	if out.Pending != 2 {
+		t.Errorf("Pending = %d, want 2", out.Pending)
+	}
+	if out.Running != 1 {
+		t.Errorf("Running = %d, want 1", out.Running)
+	}
+	if out.Completed != 3 {
+		t.Errorf("Completed = %d, want 3", out.Completed)
+	}
+	if out.Failed != 1 {
+		t.Errorf("Failed = %d, want 1", out.Failed)
+	}
+	if out.Cancelled != 0 {
+		t.Errorf("Cancelled = %d, want 0", out.Cancelled)
+	}
+	wantTotal := 2 + 1 + 3 + 1
+	if out.Total != wantTotal {
+		t.Errorf("Total = %d, want %d", out.Total, wantTotal)
+	}
+}
+
+func TestGetSyncJobsSummary_TotalEqualsSumOfNamedFields(t *testing.T) {
+	// Asserts the exhaustiveness guarantee: Total must equal the sum of all
+	// named fields. If a new SyncStatus is added to SyncStatusValues() without
+	// a corresponding field+case, this test will catch the discrepancy.
+	repo := &fakeSyncJobRepoForStatus{
+		counts: map[enums.SyncStatus]int{
+			enums.SyncStatusPending:   1,
+			enums.SyncStatusRunning:   1,
+			enums.SyncStatusCompleted: 1,
+			enums.SyncStatusFailed:    1,
+			enums.SyncStatusCancelled: 1,
+		},
+	}
+	uc := NewGetSyncJobsSummary(repo)
+
+	out, err := uc.Execute(context.Background(), GetSyncJobsSummaryInput{
+		StoreID: objects.NewID().String(),
+	})
+	if err != nil {
+		t.Fatalf("Execute: %v", err)
+	}
+	namedSum := out.Pending + out.Running + out.Completed + out.Failed + out.Cancelled
+	if out.Total != namedSum {
+		t.Errorf("Total (%d) != sum of named fields (%d) — a new SyncStatus is missing a field/case", out.Total, namedSum)
+	}
+	if out.Total != 5 {
+		t.Errorf("Total = %d, want 5", out.Total)
+	}
+}
