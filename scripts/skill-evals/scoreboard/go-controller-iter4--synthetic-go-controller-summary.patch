+const countByStatusSQL = `
+SELECT status, COUNT(*) FROM sync_jobs
+WHERE store_id = $1
+GROUP BY status`
+
+func (r *PgSyncJobRepository) CountByStatus(ctx context.Context, storeID objects.ID) (map[enums.SyncStatus]int, error) {
+	rows, err := r.querier(ctx).QueryContext(ctx, countByStatusSQL, storeID.UUID())
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := make(map[enums.SyncStatus]int)
+	for rows.Next() {
+		var status string
+		var count int
+		if err := rows.Scan(&status, &count); err != nil {
+			return nil, err
+		}
+		st := enums.SyncStatus(status)
+		if st.Valid() {
+			out[st] = count
+		}
+	}
+	return out, rows.Err()
+}
