diff --git a/packages/api/go/internal/sync/usecases/get_sync_jobs_summary.go b/packages/api/go/internal/sync/usecases/get_sync_jobs_summary.go
new file mode 100644
index 000000000..5cfdde27f
--- /dev/null
+++ b/packages/api/go/internal/sync/usecases/get_sync_jobs_summary.go
@@ -0,0 +1,76 @@
+package usecases
+
+import (
+	"context"
+
+	"template/api-go/internal/sync/enums"
+	"template/api-go/internal/sync/repositories/syncjob"
+	coreerrors "template/core-go/errors"
+	"template/core-go/objects"
+)
+
+// GetSyncJobsSummaryInput carries the store ID.
+type GetSyncJobsSummaryInput struct {
+	StoreID string `validate:"required,uuid"`
+}
+
+// GetSyncJobsSummaryOutput is the enum-exhaustive per-status count response.
+// One field per SyncStatus member plus Total.
+//
+// Exhaustiveness guarantee: Execute iterates enums.SyncStatusValues() to populate
+// these fields and Total. Adding a new SyncStatus to SyncStatusValues() will cause
+// its count to appear in Total but have no named field — the mismatch is caught by
+// the use-case test that asserts total == sum of all named fields.
+type GetSyncJobsSummaryOutput struct {
+	Pending   int `json:"pending"`
+	Running   int `json:"running"`
+	Completed int `json:"completed"`
+	Failed    int `json:"failed"`
+	Cancelled int `json:"cancelled"`
+	Total     int `json:"total"`
+}
+
+// GetSyncJobsSummary returns per-status sync-job counts for a store.
+type GetSyncJobsSummary struct {
+	jobs syncjob.SyncJobRepository
+}
+
+// NewGetSyncJobsSummary constructs the use case.
+func NewGetSyncJobsSummary(jobs syncjob.SyncJobRepository) *GetSyncJobsSummary {
+	return &GetSyncJobsSummary{jobs: jobs}
+}
+
+func (u *GetSyncJobsSummary) Name() string { return "GetSyncJobsSummary" }
+
+// Execute queries per-status counts via a single GROUP BY and maps them to the
+// output struct by iterating SyncStatusValues() — exhaustive by construction.
+func (u *GetSyncJobsSummary) Execute(ctx context.Context, in GetSyncJobsSummaryInput) (GetSyncJobsSummaryOutput, error) {
+	storeID, err := objects.IDFromString(in.StoreID)
+	if err != nil {
+		return GetSyncJobsSummaryOutput{}, coreerrors.NewBaseError(coreerrors.CodeInvalidID, "invalid store id")
+	}
+
+	counts, err := u.jobs.CountByStatus(ctx, storeID)
+	if err != nil {
+		return GetSyncJobsSummaryOutput{}, err
+	}
+
+	var out GetSyncJobsSummaryOutput
+	for _, s := range enums.SyncStatusValues() {
+		n := counts[s]
+		out.Total += n
+		switch s {
+		case enums.SyncStatusPending:
+			out.Pending = n
+		case enums.SyncStatusRunning:
+			out.Running = n
+		case enums.SyncStatusCompleted:
+			out.Completed = n
+		case enums.SyncStatusFailed:
+			out.Failed = n
+		case enums.SyncStatusCancelled:
+			out.Cancelled = n
+		}
+	}
+	return out, nil
+}
diff --git a/packages/api/go/internal/sync/usecases/get_sync_jobs_summary_test.go b/packages/api/go/internal/sync/usecases/get_sync_jobs_summary_test.go
