@@ -0,0 +1,106 @@
+import { z } from '@template/core-typescript'
+import Z from 'zod'
+import type { CardCreatedEvent } from '../events/CardCreatedEvent'
+import type { CardMovedEvent } from '../events/CardMovedEvent'
+
+export type BoardViewProjectionEvent = CardCreatedEvent | CardMovedEvent
+
+export const BoardViewCardSchema = z.object({
+	id: z.uuid(),
+	title: z.string(),
+	position: z.number().int().nonnegative(),
+	createdBy: z.uuid(),
+})
+
+export const BoardViewListSchema = z.object({
+	id: z.uuid(),
+	title: z.string(),
+	position: z.number().int().nonnegative(),
+	cards: z.array(BoardViewCardSchema),
+})
+
+export const BoardViewDataSchema = z.object({
+	id: z.uuid(),
+	title: z.string(),
+	isArchived: z.boolean(),
+	lists: z.array(BoardViewListSchema),
+})
+
+export const BoardViewProjectionSchema = z.object({
+	boardId: z.uuid(),
+	storeId: z.uuid(),
+	data: BoardViewDataSchema,
+})
+
+export type BoardViewProjectionProps = Z.infer<typeof BoardViewProjectionSchema>
+export type BoardViewData = Z.infer<typeof BoardViewDataSchema>
+export type BoardViewListData = Z.infer<typeof BoardViewListSchema>
+export type BoardViewCardData = Z.infer<typeof BoardViewCardSchema>
+
+export class BoardViewProjection {
+	constructor(public props: BoardViewProjectionProps) {}
+
+	get boardId(): string {
+		return this.props.boardId
+	}
+
+	get storeId(): string {
+		return this.props.storeId
+	}
+
+	get data(): BoardViewData {
+		return this.props.data
+	}
+
+	static create(board: {
+		id: { value: string }
+		storeId: { value: string }
+		title: string
+		isArchived: boolean
+		lists: Array<{ id: string; title: string; position: number }>
+	}): BoardViewProjection {
+		return new BoardViewProjection({
+			boardId: board.id.value,
+			storeId: board.storeId.value,
+			data: {
+				id: board.id.value,
+				title: board.title,
+				isArchived: board.isArchived,
+				lists: board.lists.map(l => ({
+					id: l.id,
+					title: l.title,
+					position: l.position,
+					cards: [],
+				})),
+			},
+		})
+	}
+
+	applyCardCreated(payload: {
+		cardId: string
+		listId: string
+		title: string
+		position: number
+		createdBy: string
+	}): void {
+		const list = this.props.data.lists.find(l => l.id === payload.listId)
+		if (!list) return
+		list.cards.push({
+			id: payload.cardId,
+			title: payload.title,
+			position: payload.position,
+			createdBy: payload.createdBy,
+		})
+		list.cards.sort((a, b) => a.position - b.position)
+	}
+
+	applyCardMoved(payload: { cardId: string; fromListId: string; toListId: string }): void {
+		const fromList = this.props.data.lists.find(l => l.id === payload.fromListId)
+		const toList = this.props.data.lists.find(l => l.id === payload.toListId)
+		if (!fromList || !toList) return
+		const idx = fromList.cards.findIndex(c => c.id === payload.cardId)
+		if (idx === -1) return
+		const [card] = fromList.cards.splice(idx, 1)
+		toList.cards.push(card!)
+	}
+}
