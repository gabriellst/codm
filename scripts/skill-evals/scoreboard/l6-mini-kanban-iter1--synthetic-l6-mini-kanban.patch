@@ -0,0 +1,69 @@
+import type { ComponentProps } from 'react'
+import { useForm } from '@tanstack/react-form'
+import { useQueryClient } from '@tanstack/react-query'
+import { useCreateCard, createCardMutationRequestSchema, getBoardQueryKey } from '@template/client-typescript/typescript'
+import { useDialogStore } from '@/stores/useDialogStore'
+import { Button } from '@/components/ui/button'
+import { useTranslation } from 'react-i18next'
+import { cn } from '@/lib/utils'
+
+interface Props extends ComponentProps<'div'> {
+	boardId: string
+	listId: string
+}
+
+export function CreateCardDialog({ boardId, listId, className, ...props }: Props) {
+	const { t } = useTranslation()
+	const { hide } = useDialogStore()
+	const queryClient = useQueryClient()
+	const { mutate: createCard } = useCreateCard({
+		mutation: {
+			onSuccess: () => {
+				queryClient.invalidateQueries({ queryKey: getBoardQueryKey(boardId) })
+				hide()
+			},
+		},
+	})
+
+	const form = useForm({
+		defaultValues: { title: '' },
+		validators: {
+			onChange: createCardMutationRequestSchema.pick({ title: true }),
+		},
+		onSubmit: ({ value }) => {
+			createCard({ boardId, data: { listId, title: value.title } })
+		},
+	})
+
+	return (
+		<div className={cn('flex flex-col gap-4 p-4 min-w-[320px]', className)} {...props}>
+			<h2 className="text-lg font-semibold">{t('kanban.board.createCard')}</h2>
+			<form
+				onSubmit={e => {
+					e.preventDefault()
+					form.handleSubmit()
+				}}
+				className="flex flex-col gap-3"
+			>
+				<form.Field name="title">
+					{field => (
+						<div className="flex flex-col gap-1">
+							<label className="text-sm font-medium">{t('kanban.board.cardTitle')}</label>
+							<input
+								className="border rounded px-3 py-2 text-sm"
+								value={field.state.value}
+								onChange={e => field.handleChange(e.target.value)}
+								placeholder={t('kanban.board.cardTitle')}
+								aria-label={t('kanban.board.cardTitle')}
+							/>
+						</div>
+					)}
+				</form.Field>
+				<div className="flex gap-2 justify-end">
+					<Button type="button" variant="ghost" onClick={hide}>{t('kanban.board.cancel')}</Button>
+					<Button type="submit">{t('kanban.board.createCard')}</Button>
+				</div>
+			</form>
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/(app)/kanban/$boardId/-components/BoardSection/index.tsx b/packages/app/react/src/routes/(app)/kanban/$boardId/-components/BoardSection/index.tsx
new file mode 100644
index 000000000..2a0d15e18
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/kanban/$boardId/-components/BoardSection/index.tsx
@@ -0,0 +1,67 @@
+import type { ComponentProps } from 'react'
+import { getRouteApi } from '@tanstack/react-router'
+import { useQueryClient } from '@tanstack/react-query'
+import { useGetBoard, getBoardQueryKey, useMoveCard } from '@template/client-typescript/typescript'
+import { useServerEvents } from '@/hooks'
+import { useDialogStore } from '@/stores/useDialogStore'
+import { cn } from '@/lib/utils'
+import { CreateCardDialog } from './CreateCardDialog'
+
+const routeApi = getRouteApi('/(app)/kanban/$boardId/')
+
+export function BoardSection({ className, ...props }: ComponentProps<'div'>) {
+	const { boardId } = routeApi.useParams()
+	const queryClient = useQueryClient()
+	const { show } = useDialogStore()
+	const { data, isPending } = useGetBoard(boardId)
+
+	useServerEvents('integration.shared.card.moved', event => {
+		if (event.payload.boardId !== boardId) return
+		queryClient.invalidateQueries({ queryKey: getBoardQueryKey(boardId) })
+	})
+
+	const { mutate: moveCard } = useMoveCard()
+
+	if (isPending) return <div>Loading board...</div>
+	if (!data) return <div>Board not found</div>
+
+	return (
+		<div className={cn('flex gap-4 overflow-x-auto p-6 h-full', className)} {...props}>
+			{(data.lists ?? []).sort((a, b) => a.position - b.position).map(list => (
+				<div key={list.id} role="region" aria-label={list.title} className="flex flex-col gap-2 min-w-[280px] flex-shrink-0">
+					<h3 className="font-semibold text-sm">{list.title}</h3>
+					<div className="flex flex-col gap-2">
+						{list.cards.sort((a, b) => a.position - b.position).map(card => (
+							<div
+								key={card.id}
+								aria-label={card.title}
+								className="rounded border p-3 bg-background cursor-pointer"
+							>
+								<p className="text-sm">{card.title}</p>
+								{data.lists.findIndex(l => l.id === list.id) < data.lists.length - 1 && (
+									<button
+										aria-label={`Move ${card.title} to next list`}
+										className="text-xs mt-1 text-muted-foreground"
+										onClick={() => {
+											const nextList = data.lists[data.lists.findIndex(l => l.id === list.id) + 1]
+											if (nextList) moveCard({ cardId: card.id, data: { toListId: nextList.id, toPosition: 0 } })
+										}}
+									>
+										→ Move
+									</button>
+								)}
+							</div>
+						))}
+					</div>
+					<button
+						aria-label={`Add card to ${list.title}`}
+						className="text-sm text-muted-foreground hover:text-foreground"
+						onClick={() => show(<CreateCardDialog boardId={boardId} listId={list.id} />)}
+					>
+						+ Add card
+					</button>
+				</div>
+			))}
+		</div>
+	)
+}
