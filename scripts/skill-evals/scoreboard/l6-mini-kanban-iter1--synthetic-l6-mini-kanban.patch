+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, Id, tryCatchAsync } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { kanbanBoardViews } from '@template/contracts/db'
+import { BoardViewProjection, type BoardViewData } from './BoardViewProjection'
+
+export abstract class BoardViewProjectionRepository {
+	abstract findByBoardId(boardId: string, tx?: Transaction): Promise<BoardViewProjection | undefined>
+	abstract save(projection: BoardViewProjection, tx?: Transaction): Promise<void>
+	abstract insertIfNew(projection: BoardViewProjection, tx?: Transaction): Promise<void>
+}
+
+@injectable()
+export class MockBoardViewProjectionRepository extends BoardViewProjectionRepository {
+	private store = new Map<string, BoardViewProjection>()
+
+	async findByBoardId(boardId: string, _tx?: Transaction): Promise<BoardViewProjection | undefined> {
+		return this.store.get(boardId)
+	}
+
+	async save(projection: BoardViewProjection, _tx?: Transaction): Promise<void> {
+		this.store.set(projection.boardId, projection)
+	}
+
+	async insertIfNew(projection: BoardViewProjection, _tx?: Transaction): Promise<void> {
+		if (!this.store.has(projection.boardId)) {
+			this.store.set(projection.boardId, projection)
+		}
+	}
+
+	seed(projection: BoardViewProjection): void {
+		this.store.set(projection.boardId, projection)
+	}
+
+	clear(): void {
+		this.store.clear()
+	}
+}
+
+@injectable()
+export class DrizzleBoardViewProjectionRepository extends BoardViewProjectionRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findByBoardId(boardId: string, tx?: DrizzleClient): Promise<BoardViewProjection | undefined> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient
+				.select()
+				.from(kanbanBoardViews)
+				.where(eq(kanbanBoardViews.boardId, boardId))
+				.limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return new BoardViewProjection({
+			boardId: result.data.boardId,
+			storeId: result.data.storeId,
+			data: result.data.data as BoardViewData,
+		})
+	}
+
+	async save(projection: BoardViewProjection, tx?: DrizzleClient): Promise<void> {
+		const dbClient = tx ?? this.db
+		await tryCatchAsync(async () => {
+			await dbClient
+				.insert(kanbanBoardViews)
+				.values({
+					id: Id.value(),
+					boardId: projection.boardId,
+					storeId: projection.storeId,
+					data: projection.data,
+					updatedAt: new Date(),
+				})
+				.onConflictDoUpdate({
+					target: kanbanBoardViews.boardId,
+					set: { data: projection.data, updatedAt: new Date() },
+				})
+		})
+	}
+
+	async insertIfNew(projection: BoardViewProjection, tx?: DrizzleClient): Promise<void> {
+		const dbClient = tx ?? this.db
+		await tryCatchAsync(async () => {
+			await dbClient
+				.insert(kanbanBoardViews)
+				.values({
+					id: Id.value(),
+					boardId: projection.boardId,
+					storeId: projection.storeId,
+					data: projection.data,
+					updatedAt: new Date(),
+				})
+				.onConflictDoNothing()
+		})
+	}
+}
