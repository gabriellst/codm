+	const { data, isPending } = useListBoards()
+
+	if (isPending) return <div className={cn('p-6', className)} {...props}>Loading boards...</div>
+
+	return (
+		<div className={cn('p-6 flex flex-col gap-4', className)} {...props}>
+			<h1 className="text-2xl font-bold">Boards</h1>
+			{(data?.boards ?? []).map(board => (
+				<Link key={board.id} to="/kanban/$boardId" params={{ boardId: board.id }}>
+					<div className="rounded border p-4">{board.title}</div>
+				</Link>
+			))}
+		</div>
+	)
+}
