diff --git a/packages/api/typescript/src/ui/usecases/GetBoard.ts b/packages/api/typescript/src/ui/usecases/GetBoard.ts
new file mode 100644
index 000000000..6fe9f27a6
--- /dev/null
+++ b/packages/api/typescript/src/ui/usecases/GetBoard.ts
@@ -0,0 +1,65 @@
+import { injectable } from 'tsyringe-neo'
+import { and, eq } from 'drizzle-orm'
+import { BaseError, DrizzleClient, Handler, z } from '@template/core-typescript'
+import { kanbanBoardViews } from '@template/contracts/db'
+import type { KanbanApplicationErrors } from '@kanban/errors'
+
+// ---------------------------------------------------------------------------
+// Input — boardId from path params + storeId from ctx.session.
+// ---------------------------------------------------------------------------
+export const GetBoardInputSchema = z.object({
+	boardId: z.uuid(),
+	storeId: z.uuid(),
+})
+
+// ---------------------------------------------------------------------------
+// Output — denormalized BoardViewData from kanban_board_views.
+// ---------------------------------------------------------------------------
+export const GetBoardOutputSchema = z.object({
+	id: z.uuid(),
+	title: z.string(),
+	isArchived: z.boolean(),
+	lists: z.array(
+		z.object({
+			id: z.uuid(),
+			title: z.string(),
+			position: z.number().int().nonnegative(),
+			cards: z.array(
+				z.object({
+					id: z.uuid(),
+					title: z.string(),
+					position: z.number().int().nonnegative(),
+					createdBy: z.uuid(),
+				}),
+			),
+		}),
+	),
+})
+
+/**
+ * `GetBoard` — BFF query that reads the denormalized board view from
+ * `kanban.board_views`. Throws BOARD_NOT_FOUND when the projection row is
+ * absent (board does not exist or belongs to a different store).
+ */
+@injectable()
+export class GetBoard extends Handler<typeof GetBoardInputSchema, typeof GetBoardOutputSchema> {
+	readonly name = 'get_board' as const
+	readonly inputSchema = GetBoardInputSchema
+	readonly outputSchema = GetBoardOutputSchema
+
+	constructor(private readonly db: DrizzleClient) {
+		super()
+	}
+
+	protected async handle(input: this['input']): Promise<this['output']> {
+		const rows = await this.db
+			.select()
+			.from(kanbanBoardViews)
+			.where(and(eq(kanbanBoardViews.boardId, input.boardId), eq(kanbanBoardViews.storeId, input.storeId)))
+			.limit(1)
+
+		if (rows.length === 0) throw new BaseError<KanbanApplicationErrors>('BOARD_NOT_FOUND')
+
+		return rows[0]!.data as this['output']
+	}
+}
