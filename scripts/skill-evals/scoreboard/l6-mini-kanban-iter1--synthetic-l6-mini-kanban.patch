@@ -0,0 +1,34 @@
+import { AggregateRoot, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+
+export const CardSchema = z.object({
+	boardId: z.instance(Id),
+	listId: z.uuid(),
+	title: z.string().min(1).max(255),
+	position: z.number().int().nonnegative(),
+	createdBy: z.uuid(),
+})
+
+export type CardProps = Z.infer<typeof CardSchema>
+
+export class Card extends AggregateRoot<typeof CardSchema> {
+	static override schema = CardSchema
+
+	static create(data: { boardId: string; listId: string; title: string; position: number; createdBy: string }): Card {
+		return new Card({
+			id: Id.value(),
+			boardId: new Id(data.boardId),
+			listId: data.listId,
+			title: data.title,
+			position: data.position,
+			createdBy: data.createdBy,
+		})
+	}
+
+	move(toListId: string, toPosition: number): void {
+		this.listId = toListId
+		this.position = toPosition
+	}
+}
+
+export interface Card extends CardProps {}
diff --git a/packages/api/typescript/src/kanban/errors/index.ts b/packages/api/typescript/src/kanban/errors/index.ts
new file mode 100644
index 000000000..501cc938a
--- /dev/null
+++ b/packages/api/typescript/src/kanban/errors/index.ts
@@ -0,0 +1,27 @@
+import { HttpStatusCode, registerErrorCodes } from '@template/core-typescript'
+import type { BaseDomainErrors, BaseApplicationErrors, BaseInterfaceErrors, BaseInfrastructureErrors } from '@template/core-typescript'
+
+export type KanbanDomainErrors =
+	| 'BOARD_NOT_FOUND'
+	| 'BOARD_ARCHIVED'
+	| 'LIST_NOT_FOUND_ON_BOARD'
+	| 'CARD_NOT_FOUND'
+	| 'CARD_BOARD_MISMATCH'
+
+export type DomainErrors = BaseDomainErrors | KanbanDomainErrors
+
+export type KanbanApplicationErrors = KanbanDomainErrors
+
+export type ApplicationErrors = BaseApplicationErrors | KanbanApplicationErrors
+
+export type InterfaceErrors = BaseInterfaceErrors
+export type InfrastructureErrors = BaseInfrastructureErrors
+export type Errors = ApplicationErrors | DomainErrors | InfrastructureErrors | InterfaceErrors
+
+registerErrorCodes({
+	BOARD_NOT_FOUND: HttpStatusCode.NOT_FOUND,
+	BOARD_ARCHIVED: HttpStatusCode.CONFLICT,
+	LIST_NOT_FOUND_ON_BOARD: HttpStatusCode.UNPROCESSABLE_ENTITY,
+	CARD_NOT_FOUND: HttpStatusCode.NOT_FOUND,
+	CARD_BOARD_MISMATCH: HttpStatusCode.UNPROCESSABLE_ENTITY,
+})
