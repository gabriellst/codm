@@ -0,0 +1,62 @@
+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { Card } from '../entities/Card'
+import { CardCreatedEvent } from '../events'
+import { BoardRepository } from '../repositories/BoardRepository'
+import { CardRepository } from '../repositories/CardRepository'
+import type { KanbanApplicationErrors } from '../errors'
+
+export const CreateCardInputSchema = z.object({
+	boardId: z.uuid(),
+	listId: z.uuid(),
+	title: z.string().min(1).max(255),
+	createdBy: z.uuid(),
+})
+
+export const CreateCardOutputSchema = z.object({
+	cardId: z.uuid(),
+})
+
+@injectable()
+export class CreateCard extends Handler<typeof CreateCardInputSchema, typeof CreateCardOutputSchema> {
+	readonly name = 'create_card' as const
+	readonly inputSchema = CreateCardInputSchema
+	readonly outputSchema = CreateCardOutputSchema
+
+	constructor(
+		private readonly boardRepo: BoardRepository,
+		private readonly cardRepo: CardRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const board = await this.boardRepo.findById(input.boardId, tx)
+			if (!board) throw new BaseError<KanbanApplicationErrors>('BOARD_NOT_FOUND')
+			board.rejectIfArchived()
+			if (!board.hasListId(input.listId)) throw new BaseError<KanbanApplicationErrors>('LIST_NOT_FOUND_ON_BOARD')
+			const position = await this.cardRepo.countByBoardAndList(input.boardId, input.listId, tx)
+			const card = Card.create({ boardId: input.boardId, listId: input.listId, title: input.title, position, createdBy: input.createdBy })
+			await this.cardRepo.save(card, tx)
+			await this.domainEventRepository.save(
+				new CardCreatedEvent({
+					entityId: card.id.value,
+					ownerId: board.storeId.value,
+					payload: {
+						cardId: card.id.value,
+						boardId: input.boardId,
+						listId: input.listId,
+						storeId: board.storeId.value,
+						title: input.title,
+						position,
+						createdBy: input.createdBy,
+					},
+				}),
+				tx,
+			)
+			return { cardId: card.id.value }
+		})
+	}
+}
