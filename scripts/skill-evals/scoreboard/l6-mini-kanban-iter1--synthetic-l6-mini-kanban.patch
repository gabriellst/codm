+export abstract class BoardRepository extends Repository<Board> {
+	abstract findById(id: string, tx?: Transaction): Promise<Board | undefined>
+	abstract override save(entity: Board, tx?: Transaction): Promise<Board>
+	abstract override delete(id: string, tx?: Transaction): Promise<void>
+	abstract findByStoreId(storeId: string, tx?: Transaction): Promise<Board[]>
+}
+
+@injectable()
+export class MockBoardRepository extends BoardRepository {
+	private store = new Map<string, Board>()
+
+	async findById(id: string, _tx?: Transaction): Promise<Board | undefined> {
+		return this.store.get(id)
+	}
+
+	async save(entity: Board, _tx?: Transaction): Promise<Board> {
+		entity.incrementVersion()
+		this.store.set(entity.id.value, entity)
+		return entity
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.store.delete(id)
+	}
+
+	async findByStoreId(storeId: string, _tx?: Transaction): Promise<Board[]> {
+		return Array.from(this.store.values()).filter(b => b.storeId.value === storeId)
+	}
+
+	seed(entity: Board): void {
+		this.store.set(entity.id.value, entity)
+	}
+
+	clear(): void {
+		this.store.clear()
+	}
+}
+
+@injectable()
+export class DrizzleBoardRepository extends BoardRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<Board | undefined> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient.select().from(kanbanBoards).where(eq(kanbanBoards.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async save(entity: Board, tx?: DrizzleClient): Promise<Board> {
+		entity.incrementVersion()
+		const dbClient = tx ?? this.db
+		const data = this.toPersistence(entity)
+		const result = await tryCatchAsync(async () => {
+			await dbClient
+				.insert(kanbanBoards)
+				.values(data)
+				.onConflictDoUpdate({
+					target: kanbanBoards.id,
+					set: {
+						title: data.title,
+						lists: data.lists,
+						isArchived: data.isArchived,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbClient = tx ?? this.db
+		await tryCatchAsync(async () => {
+			await dbClient.delete(kanbanBoards).where(eq(kanbanBoards.id, id))
+		})
+	}
+
+	async findByStoreId(storeId: string, tx?: DrizzleClient): Promise<Board[]> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient.select().from(kanbanBoards).where(eq(kanbanBoards.storeId, storeId))
+			return rows.map(row => this.toDomain(row))
+		})
+		if (!result.success) return []
+		return result.data
+	}
+
+	private toDomain(row: typeof kanbanBoards.$inferSelect): Board {
+		return new Board({
+			id: row.id,
+			storeId: row.storeId,
+			title: row.title,
+			lists: row.lists as Array<{ id: string; title: string; position: number }>,
+			isArchived: row.isArchived,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: Board): typeof kanbanBoards.$inferInsert {
+		return {
+			id: entity.id.value,
+			storeId: entity.storeId.value,
+			title: entity.title,
+			lists: entity.lists.map(l => ({ id: l.id, title: l.title, position: l.position })),
+			isArchived: entity.isArchived,
+			updatedAt: new Date(),
+			version: entity.version,
+		}
+	}
+}
