@@ -0,0 +1,44 @@
+import { injectable } from 'tsyringe-neo'
+import { Projector } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { CardCreatedEvent } from '../events/CardCreatedEvent'
+import { CardMovedEvent } from '../events/CardMovedEvent'
+import type { BoardViewProjectionEvent } from '../projections/BoardViewProjection'
+import { BoardViewProjectionRepository } from '../projections/BoardViewProjectionRepository'
+
+@injectable()
+export class BoardViewProjector extends Projector<BoardViewProjectionEvent> {
+	readonly events = [CardCreatedEvent.name, CardMovedEvent.name] as const
+
+	constructor(private readonly repo: BoardViewProjectionRepository) {
+		super()
+	}
+
+	async handle(event: BoardViewProjectionEvent, tx?: Transaction): Promise<void> {
+		if (event instanceof CardCreatedEvent) {
+			const proj = await this.repo.findByBoardId(event.payload.boardId, tx)
+			if (!proj) return
+			proj.applyCardCreated({
+				cardId: event.payload.cardId,
+				listId: event.payload.listId,
+				title: event.payload.title,
+				position: event.payload.position,
+				createdBy: event.payload.createdBy,
+			})
+			await this.repo.save(proj, tx)
+			return
+		}
+		if (event instanceof CardMovedEvent) {
+			const proj = await this.repo.findByBoardId(event.payload.boardId, tx)
+			if (!proj) return
+			proj.applyCardMoved({
+				cardId: event.payload.cardId,
+				fromListId: event.payload.fromListId,
+				toListId: event.payload.toListId,
+			})
+			await this.repo.save(proj, tx)
+			return
+		}
+		const _: never = event
+	}
+}
