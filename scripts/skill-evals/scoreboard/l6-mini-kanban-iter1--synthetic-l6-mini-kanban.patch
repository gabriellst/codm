@@ -0,0 +1,49 @@
+import { AggregateRoot, BaseError, Id, z } from '@template/core-typescript'
+import Z from 'zod'
+import { KanbanList } from '../objects/KanbanList'
+import type { KanbanDomainErrors } from '../errors'
+
+export const BoardSchema = z.object({
+	storeId: z.instance(Id),
+	title: z.string().min(1).max(255),
+	lists: z.array(z.instance(KanbanList)),
+	isArchived: z.boolean(),
+})
+
+export type BoardProps = Z.infer<typeof BoardSchema>
+
+export class Board extends AggregateRoot<typeof BoardSchema> {
+	static override schema = BoardSchema
+
+	static create(data: { storeId: string; title: string }): Board {
+		return new Board({
+			id: Id.value(),
+			storeId: new Id(data.storeId),
+			title: data.title,
+			lists: [],
+			isArchived: false,
+		})
+	}
+
+	rejectIfArchived(): void {
+		if (this.isArchived) {
+			throw new BaseError<KanbanDomainErrors>('BOARD_ARCHIVED')
+		}
+	}
+
+	hasListId(id: string): boolean {
+		return this.lists.some(list => list.id === id)
+	}
+
+	addList(title: string): KanbanList {
+		const list = new KanbanList({
+			id: Id.value(),
+			title,
+			position: this.lists.length,
+		})
+		this.lists = [...this.lists, list]
+		return list
+	}
+}
+
+export interface Board extends BoardProps {}
