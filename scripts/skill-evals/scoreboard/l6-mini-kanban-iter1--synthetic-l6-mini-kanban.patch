+ *   2. Navigating to /kanban renders the boards list with the new board
+ *   3. Navigating to /kanban/$boardId renders the board section without error
+ *   4. The browser opens the SSE connection to GET /v1/ui/events
+ *   5. A card.moved integration event pushed via API causes the board to
+ *      re-fetch without a page reload (invalidateQueries path, driven by
+ *      the `useServerEvents('integration.shared.card.moved', …)` hook in
+ *      BoardSection)
+ *
+ * Note: The full move-card realtime assertion (step 5) requires at least two
+ * lists and one card to be seeded. There is no HTTP endpoint for adding a list
+ * to a board (Board.addList() is domain-only), so the card-moved trigger is
+ * exercised by verifying the SSE connection is established and the board
+ * section subscribes — the guard-then-invalidate callback wiring is unit-level
+ * tested. The E2E validates the frontend stack end-to-end through SSE connect.
+ */
+test.describe('Kanban board — realtime card.moved', () => {
+	test('board page connects to SSE and renders without error after board creation', async ({
+		page,
+		context,
+	}) => {
+		// 1. Auth setup — sign up a fresh user and inject session cookies so
+		//    authenticated routes (RequireStoreMember middleware) accept requests.
+		const session = await apiSignUp({
+			name: 'Kanban E2E User',
+			email: `kanban-e2e-${Date.now()}@test.com`,
+			password: 'Password123!',
+		})
+		await injectSession(context, session)
+
+		// 2. Create a board via API using the authenticated session cookie.
+		const boardRes = await page.request.post(`${API_BASE_URL}/v1/ui/kanban/boards`, {
+			data: { title: 'Realtime Test Board' },
+			headers: {
+				'Content-Type': 'application/json',
+				Cookie: `better-auth.session_token=${session.token}`,
+				Origin: API_BASE_URL,
+			},
+		})
+		expect(boardRes.ok()).toBeTruthy()
+		const { boardId } = (await boardRes.json()) as { boardId: string }
+		expect(typeof boardId).toBe('string')
+
+		// 3. Navigate to the boards list and confirm the new board appears.
+		await page.goto('/kanban')
+		await expect(page.getByRole('link', { name: 'Realtime Test Board' })).toBeVisible()
+
+		// 4. Navigate to the board detail page.
+		//    Register the SSE request promise BEFORE navigation so we don't miss it.
+		const sseRequestPromise = page.waitForRequest(
+			req => req.url().includes('/v1/ui/events') && req.method() === 'GET',
+		)
+
+		await page.goto(`/kanban/${boardId}`)
+
+		// 5. Board section renders — either the empty board container or the
+		//    "Board not found" fallback, but NOT the loading spinner (the GET
+		//    /v1/ui/kanban/boards/:boardId request must complete successfully).
+		//    Wait for the GET board response to come back with 200.
+		await page.waitForResponse(
+			res => res.url().includes(`/v1/ui/kanban/boards/${boardId}`) && res.status() === 200,
+		)
+
+		// The board was just created so it has no lists — BoardSection renders an
+		// empty container (the `<div className="flex gap-4 …">` with zero children).
+		// We confirm the loading state has resolved by asserting the "Loading board…"
+		// text is gone and no error is shown.
+		await expect(page.getByText('Loading board...')).not.toBeVisible()
+		await expect(page.getByText('Board not found')).not.toBeVisible()
+
+		// 6. SSE connection is established — the browser MUST have connected to
+		//    GET /v1/ui/events (mounted once in the (app) layout via
+		//    useServerEventSource). This confirms the realtime wiring is alive.
+		await sseRequestPromise
+
+		// 7. Realtime card.moved path — full smoke:
+		//    Because there is no addList HTTP endpoint we cannot seed lists/cards
+		//    via API and therefore cannot trigger a real PATCH /v1/ui/kanban/cards/:id/move.
+		//    The SSE subscription (useServerEvents('integration.shared.card.moved', …))
+		//    and invalidateQueries path are validated at the integration-test level
+		//    (BoardSection.test.tsx / BoardViewProjector.test.ts). The E2E here
+		//    confirms the SSE connection is live (step 6) so the guard-then-invalidate
+		//    callback would fire were a card.moved event to arrive.
+	})
+})
