+import type { Transaction } from '@template/core-typescript'
+import { Board } from '../entities/Board'
+import { BoardCreatedEvent } from '../events'
+import { BoardRepository } from '../repositories/BoardRepository'
+import { BoardViewProjectionRepository } from '../projections/BoardViewProjectionRepository'
+import { BoardViewProjection } from '../projections/BoardViewProjection'
+import type { KanbanApplicationErrors } from '../errors'
+
+export const CreateBoardInputSchema = z.object({
+	storeId: z.uuid(),
+	title: z.string().min(1).max(255),
+})
+
+export const CreateBoardOutputSchema = z.object({
+	boardId: z.uuid(),
+})
+
+@injectable()
+export class CreateBoard extends Handler<typeof CreateBoardInputSchema, typeof CreateBoardOutputSchema> {
+	readonly name = 'create_board' as const
+	readonly inputSchema = CreateBoardInputSchema
+	readonly outputSchema = CreateBoardOutputSchema
+
+	constructor(
+		private readonly boardRepo: BoardRepository,
+		private readonly boardViewRepo: BoardViewProjectionRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const board = Board.create({ storeId: input.storeId, title: input.title })
+			await this.boardRepo.save(board, tx)
+			await this.boardViewRepo.insertIfNew(BoardViewProjection.create(board), tx)
+			await this.domainEventRepository.save(
+				new BoardCreatedEvent({
+					entityId: board.id.value,
+					ownerId: board.storeId.value,
+					payload: { boardId: board.id.value, storeId: board.storeId.value, title: board.title },
+				}),
+				tx,
+			)
+			return { boardId: board.id.value }
+		})
+	}
+}
