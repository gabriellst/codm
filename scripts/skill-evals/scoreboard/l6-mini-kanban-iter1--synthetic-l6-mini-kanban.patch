@@ -0,0 +1,60 @@
+import { injectable } from 'tsyringe-neo'
+import { BaseError, Handler, z } from '@template/core-typescript'
+import type { Transaction } from '@template/core-typescript'
+import { CardMovedEvent } from '../events'
+import { BoardRepository } from '../repositories/BoardRepository'
+import { CardRepository } from '../repositories/CardRepository'
+import type { KanbanApplicationErrors } from '../errors'
+
+export const MoveCardInputSchema = z.object({
+	cardId: z.uuid(),
+	toListId: z.uuid(),
+	toPosition: z.number().int().nonnegative(),
+})
+
+export const MoveCardOutputSchema = z.object({
+	cardId: z.uuid(),
+})
+
+@injectable()
+export class MoveCard extends Handler<typeof MoveCardInputSchema, typeof MoveCardOutputSchema> {
+	readonly name = 'move_card' as const
+	readonly inputSchema = MoveCardInputSchema
+	readonly outputSchema = MoveCardOutputSchema
+
+	constructor(
+		private readonly boardRepo: BoardRepository,
+		private readonly cardRepo: CardRepository,
+	) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const card = await this.cardRepo.findById(input.cardId, tx)
+			if (!card) throw new BaseError<KanbanApplicationErrors>('CARD_NOT_FOUND')
+			const board = await this.boardRepo.findById(card.boardId.value, tx)
+			if (!board) throw new BaseError<KanbanApplicationErrors>('BOARD_NOT_FOUND')
+			board.rejectIfArchived()
+			if (!board.hasListId(input.toListId)) throw new BaseError<KanbanApplicationErrors>('LIST_NOT_FOUND_ON_BOARD')
+			const fromListId = card.listId
+			card.move(input.toListId, input.toPosition)
+			await this.cardRepo.save(card, tx)
+			await this.domainEventRepository.save(
+				new CardMovedEvent({
+					entityId: card.id.value,
+					ownerId: board.storeId.value,
+					payload: {
+						cardId: card.id.value,
+						boardId: board.id.value,
+						fromListId,
+						toListId: input.toListId,
+						storeId: board.storeId.value,
+					},
+				}),
+				tx,
+			)
+			return { cardId: card.id.value }
+		})
+	}
+}
