index 000000000..b7f7b52e2
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/ComparisonPanel/index.tsx
@@ -0,0 +1,165 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useListQuickProductRanking } from '@template/client-typescript/typescript'
+import type { ListQuickProductRankingQueryResponse } from '@template/client-typescript/typescript'
+import { IconX } from '@tabler/icons-react'
+
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Button } from '@/components/ui/button'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { BalanceIcon } from '@/components/ui/icons'
+import { cn } from '@/lib/utils'
+import { useTenancyStore } from '@/stores'
+import { useMoney } from '@/hooks'
+import { useReportsStore } from '../../-stores/useReportsStore'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+type RankingItem = ListQuickProductRankingQueryResponse['items'][number]
+
+export function ComparisonPanel({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { startDate, endDate } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore((s) => s.tenancyScope)
+	const { comparisonBasket, clearBasket, toggleCompare } = useReportsStore()
+
+	const enabled = comparisonBasket.length > 0
+	const productIds = enabled ? comparisonBasket : undefined
+
+	const { data, isPending, isError } = useListQuickProductRanking(
+		{ tenancyScope, startDate, endDate, productIds },
+		{ query: { enabled } },
+	)
+
+	if (!enabled) return null
+
+	return (
+		<Card className={cn('gap-4 p-6', className)} {...props}>
+			<div className="flex items-center gap-3">
+				<GradientIconBadge icon={BalanceIcon} />
+				<span className="flex-1 text-lg font-medium text-muted-foreground">
+					{t('reports.comparison.panelTitle')}
+				</span>
+				<Button
+					variant="ghost"
+					size="icon-sm"
+					aria-label={t('reports.comparison.clearAriaLabel')}
+					onClick={clearBasket}
+				>
+					<IconX size={16} />
+				</Button>
+			</div>
+
+			<div className="border-t border-border/60" />
+
+			{isPending ? (
+				<ComparisonPanelSkeleton count={comparisonBasket.length} />
+			) : isError ? (
+				<p className="text-sm text-muted-foreground">{t('reports.comparison.loadError')}</p>
+			) : !data || data.items.length === 0 ? (
+				<p className="text-sm text-muted-foreground">{t('reports.comparison.empty')}</p>
+			) : (
+				<div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
+					{data.items.map((item) => (
+						<ComparisonCard
+							key={item.productId}
+							item={item}
+							onRemove={() => toggleCompare(item.productId)}
+						/>
+					))}
+				</div>
+			)}
+		</Card>
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Comparison card leaf — receives item as prop (rendered N times in map)
+// ---------------------------------------------------------------------------
+
+interface ComparisonCardProps {
+	item: RankingItem
+	onRemove: () => void
+}
+
+function ComparisonCard({ item, onRemove }: ComparisonCardProps) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+
+	return (
+		<div className="flex flex-col gap-3 rounded-lg border border-border/60 p-4">
+			<div className="flex items-start justify-between gap-2">
+				<div className="flex items-center gap-2">
+					{item.imageUrl ? (
+						<img
+							src={item.imageUrl}
+							alt={t('reports.topProducts.imageAlt')}
+							className="size-8 shrink-0 rounded object-cover"
+						/>
+					) : (
+						<div className="size-8 shrink-0 rounded bg-muted" />
+					)}
+					<span className="line-clamp-2 text-sm font-medium text-foreground">{item.name}</span>
+				</div>
+				<Button
+					variant="ghost"
+					size="icon-sm"
+					aria-label={t('reports.comparison.removeAriaLabel', { name: item.name })}
+					onClick={onRemove}
+					className="shrink-0"
+				>
+					<IconX size={12} />
+				</Button>
+			</div>
+
+			<div className="flex flex-col gap-1.5">
+				<div className="flex items-center justify-between gap-2 text-xs">
+					<span className="text-muted-foreground">{t('reports.topProducts.columns.revenue')}</span>
+					<span className="font-medium tabular-nums text-foreground">
+						{formatMoney(item.sales.value.value)}
+					</span>
+				</div>
+				<div className="flex items-center justify-between gap-2 text-xs">
+					<span className="text-muted-foreground">{t('reports.topProducts.columns.sales')}</span>
+					<span className="tabular-nums text-muted-foreground">{item.sales.count.value}</span>
+				</div>
+				{item.sales.value.deltaPct !== null && (
+					<div className="flex items-center justify-between gap-2 text-xs">
+						<span className="text-muted-foreground">{t('reports.comparison.delta')}</span>
+						<span
+							className={cn(
+								'tabular-nums font-medium',
+								item.sales.value.deltaPct >= 0 ? 'text-success' : 'text-destructive',
+							)}
+						>
+							{`${item.sales.value.deltaPct >= 0 ? '+' : ''}${item.sales.value.deltaPct.toFixed(1)}%`}
+						</span>
+					</div>
+				)}
+			</div>
+		</div>
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Skeleton
+// ---------------------------------------------------------------------------
+
+function ComparisonPanelSkeleton({ count }: { count: number }) {
+	return (
+		<div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
+			{Array.from({ length: count }).map((_, i) => (
+				<div key={`cmp-skeleton-${i}`} className="flex flex-col gap-3 rounded-lg border border-border/60 p-4">
+					<div className="flex items-center gap-2">
+						<Skeleton className="size-8 shrink-0 rounded" />
+						<Skeleton className="h-4 flex-1" />
+					</div>
+					<Skeleton className="h-3 w-full" />
+					<Skeleton className="h-3 w-4/5" />
+				</div>
+			))}
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/(app)/reports/-components/PeriodTargetCard/index.tsx b/packages/app/react/src/routes/(app)/reports/-components/PeriodTargetCard/index.tsx
new file mode 100644
index 000000000..740528edb
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/PeriodTargetCard/index.tsx
@@ -0,0 +1,305 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useForm } from '@tanstack/react-form'
+import { useQueryClient } from '@tanstack/react-query'
+import { getRouteApi } from '@tanstack/react-router'
+import { differenceInCalendarDays, parseISO } from 'date-fns'
+import { toast } from 'sonner'
+import {
+	useGetGoal,
+	useCreateGoal,
+	useUpdateGoal,
+	getGoalQueryKey,
+	CurrencyCodeEnum,
+	GoalTypeEnum,
+	createGoalMutationRequestSchema,
+	updateGoalMutationRequestSchema,
+	type CreateGoalMutationRequest,
+	type GetGoalQueryResponse,
+} from '@template/client-typescript/typescript'
+
+import { type DeepPartial } from '@/lib'
+import { cn } from '@/lib/utils'
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Button } from '@/components/ui/button'
+import { Spinner } from '@/components/ui/spinner'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { MoneyIcon } from '@/components/ui/icons'
+import { Field, FieldError, FieldGroup, FieldLabel } from '@/components/ui/field'
+import { Input } from '@/components/ui/input'
+import { ToggleGroup } from '@/components/ui/toggle-group'
+import { CurrencyInput } from '@/components/ui/currency-input'
+import { useMoney } from '@/hooks'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+type LoadedGoal = NonNullable<GetGoalQueryResponse['goal']>
+
+export function PeriodTargetCard({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { startDate, endDate } = routeApi.useSearch()
+	const { data, isPending, isError } = useGetGoal()
+	const goal = data?.goal ?? null
+
+	return (
+		<Card className={cn('gap-4 p-6', className)} {...props}>
+			<div className="flex items-center gap-3">
+				<GradientIconBadge icon={MoneyIcon} />
+				<span className="flex-1 text-lg font-medium text-muted-foreground">
+					{t('reports.periodTarget.title')}
+				</span>
+			</div>
+
+			<div className="border-t border-border/60" />
+
+			{isPending ? (
+				<PeriodTargetSkeleton />
+			) : isError ? (
+				<p className="text-sm text-muted-foreground">{t('reports.periodTarget.loadError')}</p>
+			) : (
+				<PeriodTargetForm goal={goal} startDate={startDate} endDate={endDate} />
+			)}
+		</Card>
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Form — always visible (no toggle/drawer)
+// ---------------------------------------------------------------------------
+
+interface PeriodTargetFormProps {
+	goal: LoadedGoal | null
+	startDate: string
+	endDate: string
+}
+
+function PeriodTargetForm({ goal, startDate, endDate }: PeriodTargetFormProps) {
+	const { t } = useTranslation()
+	const queryClient = useQueryClient()
+	const formatMoney = useMoney()
+
+	const invalidateGoalQueries = () => {
+		queryClient.invalidateQueries({ queryKey: getGoalQueryKey() })
+		queryClient.invalidateQueries({ queryKey: [{ url: '/v1/analytics/goals/progress' }] })
+	}
+
+	const createGoal = useCreateGoal({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('reports.periodTarget.saveSuccess'))
+				invalidateGoalQueries()
+			},
+		},
+	})
+
+	const updateGoal = useUpdateGoal({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('reports.periodTarget.saveSuccess'))
+				invalidateGoalQueries()
+			},
+		},
+	})
+
+	const isPending = createGoal.isPending || updateGoal.isPending
+
+	const defaultValues: DeepPartial<CreateGoalMutationRequest> = {
+		type: goal?.type ?? GoalTypeEnum.REVENUE,
+		targetAmount: {
+			amountCents: goal?.targetAmount.amountCents ?? 0,
+			currency: goal?.targetAmount.currency ?? CurrencyCodeEnum.BRL,
+		},
+		from: goal?.from ?? startDate,
+		to: goal?.to ?? endDate,
+	}
+
+	const form = useForm({
+		defaultValues,
+		validators: { onChange: createGoalMutationRequestSchema },
+		onSubmit: async ({ value }) => {
+			const result = createGoalMutationRequestSchema.safeParse(value)
+			if (!result.success) return
+
+			if (goal?.id) {
+				const { type: _type, ...updateFields } = result.data
+				const updateResult = updateGoalMutationRequestSchema.safeParse({
+					ids: [goal.id],
+					...updateFields,
+				})
+				if (!updateResult.success) return
+				await updateGoal.mutateAsync({ data: updateResult.data })
+			} else {
+				await createGoal.mutateAsync({ data: result.data })
+			}
+		},
+	})
+
+	return (
+		<form
+			className="flex flex-col gap-4"
+			noValidate
+			onSubmit={(e) => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+		>
+			<form.Subscribe
+				selector={(s) => {
+					const dirty =
+						s.values.type !== (goal?.type ?? GoalTypeEnum.REVENUE) ||
+						s.values.targetAmount?.amountCents !== (goal?.targetAmount.amountCents ?? 0)
+					return dirty && s.isTouched
+				}}
+			>
+				{(isDirty) =>
+					isDirty ? (
+						<div className="rounded-md bg-warning/10 px-3 py-2 text-xs font-medium text-warning">
+							{t('reports.periodTarget.unsavedChanges')}
+						</div>
+					) : null
+				}
+			</form.Subscribe>
+
+			<FieldGroup>
+				{/* Goal type */}
+				<form.Field name="type">
+					{(field) => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel>{t('reports.periodTarget.form.type')}</FieldLabel>
+								<ToggleGroup
+									enum={GoalTypeEnum}
+									i18nPrefix="enums.GoalType"
+									value={field.state.value}
+									onValueChange={field.handleChange}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				{/* Target amount */}
+				<form.Field name="targetAmount">
+					{(field) => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel>{t('reports.periodTarget.form.target')}</FieldLabel>
+								<CurrencyInput
+									amountCents={field.state.value?.amountCents ?? 0}
+									currency={field.state.value?.currency ?? CurrencyCodeEnum.BRL}
+									onAmountChange={(cents) =>
+										field.handleChange({ ...field.state.value, amountCents: cents })
+									}
+									onCurrencyChange={(c) =>
+										field.handleChange({ ...field.state.value, currency: c })
+									}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				{/* Start date */}
+				<form.Field name="from">
+					{(field) => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('reports.periodTarget.form.from')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="date"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={(e) => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+
+				{/* End date */}
+				<form.Field name="to">
+					{(field) => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('reports.periodTarget.form.to')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="date"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={(e) => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+			</FieldGroup>
+
+			<form.Subscribe
+				selector={(s) => ({
+					amountCents: s.values.targetAmount?.amountCents ?? 0,
+					currency: s.values.targetAmount?.currency ?? CurrencyCodeEnum.BRL,
+					from: s.values.from ?? startDate,
+					to: s.values.to ?? endDate,
+				})}
+			>
+				{({ amountCents, currency, from, to }) => {
+					const days = Math.max(
+						1,
+						differenceInCalendarDays(parseISO(to.slice(0, 10)), parseISO(from.slice(0, 10))) + 1,
+					)
+					const dailyCents = Math.round(amountCents / days)
+					const dailyStr = formatMoney({ amountCents: dailyCents, currency })
+					return (
+						<div className="rounded-md bg-muted/50 px-3 py-2 text-xs text-muted-foreground">
+							{t('reports.periodTarget.dailyRunRate', { value: dailyStr, days })}
+						</div>
+					)
+				}}
+			</form.Subscribe>
+
+			{/* Submit */}
+			<form.Subscribe selector={(s) => [s.values, s.isSubmitting] as const}>
+				{([values, isSubmitting]) => (
+					<Button
+						type="submit"
+						className="w-full"
+						disabled={!createGoalMutationRequestSchema.safeParse(values).success || isPending}
+					>
+						{isSubmitting || isPending ? <Spinner /> : t('reports.periodTarget.form.save')}
+					</Button>
+				)}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Skeleton
+// ---------------------------------------------------------------------------
+
+function PeriodTargetSkeleton() {
+	return (
+		<div className="flex flex-col gap-4">
+			<Skeleton className="h-8 w-full" />
+			<Skeleton className="h-10 w-full" />
+			<Skeleton className="h-8 w-full" />
+			<Skeleton className="h-8 w-full" />
+			<Skeleton className="h-9 w-full" />
+		</div>
+	)
+}
