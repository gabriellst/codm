--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/RevenueTrendSection/index.tsx
@@ -0,0 +1,136 @@
+import { useMemo } from 'react'
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { format } from 'date-fns'
+import { ptBR, enUS } from 'date-fns/locale'
+import { useGetChart, AnalyticsFrequencyEnum } from '@template/client-typescript/typescript'
+import type { AnalyticsFrequency } from '@template/client-typescript/typescript'
+
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { ToggleGroup } from '@/components/ui/toggle-group'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { BarGraphIcon } from '@/components/ui/icons'
+import { cn } from '@/lib/utils'
+import { tryCatch } from '@/lib/utils'
+import { useTenancyStore } from '@/stores'
+import { useLocale } from '@/hooks'
+import { DEFAULT_LOCALE } from '@/lib/locale'
+import { ChartMode } from '../../index'
+
+import { TrendChartCanvas } from './TrendChartCanvas'
+import type { TrendBucket } from './TrendChartCanvas'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+const FREQUENCY_FORMAT: Record<AnalyticsFrequency, string> = {
+	[AnalyticsFrequencyEnum.HOURLY]: 'HH:mm',
+	[AnalyticsFrequencyEnum.DAILY]: 'dd/MM',
+	[AnalyticsFrequencyEnum.WEEKLY]: 'dd/MM',
+	[AnalyticsFrequencyEnum.MONTHLY]: 'MMM yy',
+	[AnalyticsFrequencyEnum.YEARLY]: 'yyyy',
+}
+
+/**
+ * RevenueTrendSection — income-recorte revenue/profit chart for the Reports page.
+ * Owns: frequency toggle (writes to URL, bookmarkable); bar/line mode (URL, bookmarkable).
+ * Reads: startDate, endDate, productIds, frequency, chartMode from URL; tenancyScope from global store.
+ * chartType is fixed to 'income' — this page only shows the income recorte.
+ */
+export function RevenueTrendSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const appLocale = useLocale()
+	const { startDate, endDate, productIds, frequency, chartMode } = routeApi.useSearch()
+	const navigate = routeApi.useNavigate()
+	const tenancyScope = useTenancyStore((s) => s.tenancyScope)
+
+	const dfnsLocale = appLocale === DEFAULT_LOCALE ? ptBR : enUS
+
+	const { data, isPending, isError } = useGetChart({
+		chartType: 'income',
+		tenancyScope,
+		frequency,
+		startDate,
+		endDate,
+		productIds,
+	})
+
+	const buckets = useMemo((): TrendBucket[] => {
+		if (!data || data.kind !== 'income') return []
+		const fmt = FREQUENCY_FORMAT[data.frequency]
+		return data.buckets.map((b) => {
+			const labelResult = tryCatch(() => format(new Date(b.timestamp), fmt, { locale: dfnsLocale }))
+			return {
+				label: labelResult.success ? labelResult.data : b.timestamp,
+				revenue: b.revenue,
+				profit: b.profit,
+				orders: b.orders,
+			}
+		})
+	}, [data, dfnsLocale])
+
+	const handleFrequencyChange = (next: AnalyticsFrequency) => {
+		navigate({ search: (prev) => ({ ...prev, frequency: next }) })
+	}
+
+	const handleModeChange = (next: ChartMode) => {
+		navigate({ search: (prev) => ({ ...prev, chartMode: next }) })
+	}
+
+	return (
+		<Card className={cn('flex flex-col gap-4 p-6', className)} {...props}>
+			{/* Header */}
+			<div className="flex items-center gap-3">
+				<GradientIconBadge icon={BarGraphIcon} />
+				<span className="flex-1 text-lg font-medium text-muted-foreground">
+					{t('reports.revenueTrend.title')}
+				</span>
+				<div className="flex items-center gap-2">
+					<ToggleGroup
+						enum={AnalyticsFrequencyEnum}
+						i18nPrefix="enums.AnalyticsFrequency"
+						value={frequency}
+						onValueChange={handleFrequencyChange}
+						size="sm"
+						aria-label={t('reports.revenueTrend.granularityAriaLabel')}
+					/>
+					<ToggleGroup
+						enum={ChartMode}
+						i18nPrefix="reports.revenueTrend.mode"
+						value={chartMode}
+						onValueChange={(v) => handleModeChange(v as ChartMode)}
+						size="sm"
+					/>
+				</div>
+			</div>
+
+			{/* Chart body */}
+			<div className="min-h-64">
+				{isPending ? (
+					<Skeleton className="h-64 w-full rounded-lg" />
+				) : isError || buckets.length === 0 ? (
+					<div className="flex h-64 items-center justify-center text-sm text-muted-foreground">
+						{isError ? t('reports.revenueTrend.loadError') : t('reports.revenueTrend.empty')}
+					</div>
+				) : (
+					<TrendChartCanvas buckets={buckets} mode={chartMode} className="h-64" />
+				)}
+			</div>
+
+			{/* Legend */}
+			{!isPending && !isError && buckets.length > 0 && (
+				<div className="flex items-center gap-4 text-xs text-muted-foreground">
+					<span className="flex items-center gap-1.5">
+						<span className="inline-block size-2.5 rounded-sm bg-[hsl(var(--primary)/0.85)]" />
+						{t('reports.revenueTrend.legend.revenue')}
+					</span>
+					<span className="flex items-center gap-1.5">
+						<span className="inline-block size-2.5 rounded-sm bg-[hsl(var(--success)/0.85)]" />
+						{t('reports.revenueTrend.legend.profit')}
+					</span>
+				</div>
+			)}
+		</Card>
+	)
+}
