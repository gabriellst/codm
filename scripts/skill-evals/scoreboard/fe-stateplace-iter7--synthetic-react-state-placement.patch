+import type { ComponentProps } from 'react'
+import { createFileRoute } from '@tanstack/react-router'
+import { endOfDay, startOfDay, subDays } from 'date-fns'
+import { listQuickProductRankingQueryParamsSchema, analyticsFrequencySchema, AnalyticsFrequencyEnum } from '@template/client-typescript/typescript'
+import { z } from 'zod'
+
+import { cn } from '@/lib/utils'
+import { RevenueTrendSection } from './-components/RevenueTrendSection'
+import { TopProductsSection } from './-components/TopProductsSection'
+import { PeriodTargetCard } from './-components/PeriodTargetCard'
+import { ComparisonPanel } from './-components/ComparisonPanel'
+import { ReportsToolbar } from './-components/ReportsToolbar'
+
+export enum ChartMode {
+	bar = 'bar',
+	line = 'line',
+}
+
+// Period + granularity live in the URL — bookmarkable and shareable.
+// tenancyScope is the account-level global store (not URL state).
+// chartType is fixed to 'income' (constant — not in URL).
+// comparisonBasket is ephemeral per-session (route store — not URL state).
+// Composed from the SDK's ListQuickProductRanking query-params schema: drop tenancyScope
+// (app-global store) and the required dates, then `.and` defaulted dates + chart config.
+export const reportsSearchSchema = listQuickProductRankingQueryParamsSchema
+	.omit({ tenancyScope: true, startDate: true, endDate: true })
+	.and(
+		z.object({
+			startDate: z.string().default(() => startOfDay(subDays(new Date(), 29)).toISOString()),
+			endDate: z.string().default(() => endOfDay(new Date()).toISOString()),
+			frequency: analyticsFrequencySchema.optional().default(AnalyticsFrequencyEnum.DAILY),
+			chartMode: z.enum(ChartMode).default(ChartMode.bar),
+		}),
+	)
+
+export type ReportsSearchParams = z.infer<typeof reportsSearchSchema>
+
+export const Route = createFileRoute('/(app)/reports/')({
+	staticData: { breadcrumb: 'Relatórios' },
+	validateSearch: (search) => reportsSearchSchema.parse(search ?? {}),
+	component: RouteComponent,
+})
+
+function RouteComponent() {
+	return <ReportsPage />
+}
+
+export function ReportsPage({ className, ...props }: ComponentProps<'div'>) {
+	return (
+		<div className={cn('flex flex-1 flex-col gap-6 overflow-y-auto p-6 md:p-8', className)} {...props}>
+			<ReportsToolbar />
+			<RevenueTrendSection />
+			<div className="grid grid-cols-1 gap-6 xl:grid-cols-3">
+				<div className="xl:col-span-2">
+					<TopProductsSection />
+				</div>
+				<PeriodTargetCard />
+			</div>
+			<ComparisonPanel />
+		</div>
+	)
+}
