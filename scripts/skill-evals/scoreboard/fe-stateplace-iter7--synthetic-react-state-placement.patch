@@ -0,0 +1,150 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useListQuickProductRanking } from '@template/client-typescript/typescript'
+import type { ListQuickProductRankingQueryResponse } from '@template/client-typescript/typescript'
+import { IconGitCompare } from '@tabler/icons-react'
+
+import { Card } from '@/components/ui/card'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Button } from '@/components/ui/button'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { StarIcon } from '@/components/ui/icons'
+import { cn } from '@/lib/utils'
+import { useTenancyStore } from '@/stores'
+import { useMoney } from '@/hooks'
+import { useReportsStore } from '../../-stores/useReportsStore'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+type RankingItem = ListQuickProductRankingQueryResponse['items'][number]
+
+const SKELETON_COUNT = 10
+
+export function TopProductsSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { startDate, endDate, productIds } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore((s) => s.tenancyScope)
+	const { comparisonBasket, toggleCompare } = useReportsStore()
+
+	const { data, isPending, isError } = useListQuickProductRanking({
+		tenancyScope,
+		startDate,
+		endDate,
+		productIds,
+	})
+
+	return (
+		<Card className={cn('gap-4 p-6', className)} {...props}>
+			{/* Header */}
+			<div className="flex items-center gap-4">
+				<GradientIconBadge icon={StarIcon} />
+				<span className="flex-1 text-lg font-medium text-muted-foreground">
+					{t('reports.topProducts.title')}
+				</span>
+				{isPending ? (
+					<Skeleton className="h-4 w-20" />
+				) : data ? (
+					<span className="text-sm text-muted-foreground">
+						{t('reports.topProducts.totalProducts', { count: data.totalProducts })}
+					</span>
+				) : null}
+			</div>
+
+			<div className="border-t border-border/60" />
+
+			{/* Column headers */}
+			<div className="grid grid-cols-[1fr_auto_auto_auto] gap-3 px-1 text-xs font-medium text-muted-foreground">
+				<span>{t('reports.topProducts.columns.name')}</span>
+				<span className="text-right">{t('reports.topProducts.columns.sales')}</span>
+				<span className="text-right">{t('reports.topProducts.columns.revenue')}</span>
+				<span className="sr-only">{t('reports.topProducts.compareColumn')}</span>
+			</div>
+
+			{/* List */}
+			<div
+				className="flex flex-col divide-y divide-border/40"
+				role="list"
+				aria-label={t('reports.topProducts.listAria')}
+			>
+				{isPending ? (
+					Array.from({ length: SKELETON_COUNT }).map((_, i) => (
+						<div key={`product-skeleton-${i}`} className="grid grid-cols-[1fr_auto_auto_auto] items-center gap-3 py-2">
+							<Skeleton className="h-4 flex-1" />
+							<Skeleton className="h-4 w-10" />
+							<Skeleton className="h-4 w-20" />
+							<Skeleton className="h-6 w-6 rounded" />
+						</div>
+					))
+				) : isError ? (
+					<p className="py-4 text-sm text-muted-foreground">{t('reports.topProducts.loadError')}</p>
+				) : !data || data.items.length === 0 ? (
+					<p className="py-4 text-sm text-muted-foreground">{t('reports.topProducts.empty')}</p>
+				) : (
+					data.items.map((item, index) => (
+						<TopProductRow
+							key={item.productId}
+							rank={index + 1}
+							item={item}
+							isInBasket={comparisonBasket.includes(item.productId)}
+							onToggleCompare={() => toggleCompare(item.productId)}
+						/>
+					))
+				)}
+			</div>
+		</Card>
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Leaf row — rendered N times, receives props from parent
+// ---------------------------------------------------------------------------
+
+interface TopProductRowProps {
+	rank: number
+	item: RankingItem
+	isInBasket: boolean
+	onToggleCompare: () => void
+}
+
+function TopProductRow({ rank, item, isInBasket, onToggleCompare }: TopProductRowProps) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+
+	return (
+		<div
+			className="grid grid-cols-[1fr_auto_auto_auto] items-center gap-3 py-2"
+			role="listitem"
+			aria-label={item.name}
+		>
+			<div className="flex min-w-0 items-center gap-2">
+				<span className="w-5 shrink-0 text-xs text-muted-foreground">{rank}</span>
+				{item.imageUrl ? (
+					<img
+						src={item.imageUrl}
+						alt={t('reports.topProducts.imageAlt')}
+						className="size-7 shrink-0 rounded object-cover"
+					/>
+				) : (
+					<div className="size-7 shrink-0 rounded bg-muted" />
+				)}
+				<span className="truncate text-sm font-medium text-foreground">{item.name}</span>
+			</div>
+			<span className="text-right text-sm tabular-nums text-muted-foreground">
+				{item.sales.count.value}
+			</span>
+			<span className="text-right text-sm tabular-nums text-foreground">
+				{formatMoney(item.sales.value.value)}
+			</span>
+			<Button
+				variant={isInBasket ? 'default' : 'ghost'}
+				size="icon-sm"
+				aria-label={t('reports.topProducts.compareToggleAriaLabel', { name: item.name })}
+				onClick={onToggleCompare}
+				aria-pressed={isInBasket}
+			>
+				<IconGitCompare size={14} />
+			</Button>
+		</div>
+	)
+}
