@@ -0,0 +1,71 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { IconX } from '@tabler/icons-react'
+import type { DateRange } from 'react-day-picker'
+
+import { DatePicker } from '@/components/ui/date-picker'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { BarGraphIcon } from '@/components/ui/icons'
+import { cn } from '@/lib/utils'
+import { useReportsStore } from '../../-stores/useReportsStore'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+export function ReportsToolbar({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { startDate, endDate } = routeApi.useSearch()
+	const navigate = routeApi.useNavigate()
+	const { comparisonBasket, clearBasket } = useReportsStore()
+
+	const range: DateRange = {
+		from: startDate ? new Date(startDate) : undefined,
+		to: endDate ? new Date(endDate) : undefined,
+	}
+
+	const handleRangeChange = (next: DateRange | undefined) => {
+		if (!next?.from) return
+		navigate({
+			search: (prev) => ({
+				...prev,
+				startDate: next.from!.toISOString(),
+				endDate: next.to ? next.to.toISOString() : next.from!.toISOString(),
+			}),
+		})
+	}
+
+	return (
+		<div
+			className={cn('flex items-center justify-between gap-4', className)}
+			{...props}
+		>
+			<div className="flex items-center gap-3">
+				<GradientIconBadge icon={BarGraphIcon} />
+				<h1 className="text-2xl font-bold text-foreground">{t('reports.title')}</h1>
+			</div>
+
+			<div className="flex items-center gap-2">
+				{comparisonBasket.length > 0 && (
+					<div className="flex items-center gap-1.5 rounded-md bg-primary/10 px-2.5 py-1 text-sm text-primary">
+						<span>{t('reports.comparison.count', { count: comparisonBasket.length })}</span>
+						<button
+							type="button"
+							className="ml-0.5 rounded p-0.5 hover:bg-primary/20 transition-colors"
+							onClick={clearBasket}
+							aria-label={t('reports.comparison.clearAriaLabel')}
+						>
+							<IconX size={12} />
+						</button>
+					</div>
+				)}
+				<DatePicker
+					mode="range"
+					range={range}
+					onRangeChange={handleRangeChange}
+					showPresets
+					aria-label={t('reports.toolbar.periodAriaLabel')}
+				/>
+			</div>
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/(app)/reports/-components/RevenueTrendSection/TrendChartCanvas.tsx b/packages/app/react/src/routes/(app)/reports/-components/RevenueTrendSection/TrendChartCanvas.tsx
new file mode 100644
index 000000000..922a78241
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/RevenueTrendSection/TrendChartCanvas.tsx
@@ -0,0 +1,225 @@
+import { useCallback } from 'react'
+import type { ComponentProps } from 'react'
+import { ParentSize } from '@visx/responsive'
+import { Group } from '@visx/group'
+import { Bar, LinePath } from '@visx/shape'
+import { scaleBand, scaleLinear } from '@visx/scale'
+import { AxisBottom, AxisLeft } from '@visx/axis'
+import { GridRows } from '@visx/grid'
+import { curveMonotoneX } from '@visx/curve'
+import { useTooltip, TooltipWithBounds, defaultStyles } from '@visx/tooltip'
+import { localPoint } from '@visx/event'
+
+import type { SignedMoney } from '@template/client-typescript/typescript'
+import { useMoney } from '@/hooks'
+import { cn } from '@/lib/utils'
+
+export interface TrendBucket {
+	label: string
+	revenue: SignedMoney
+	profit: SignedMoney
+	orders: number
+}
+
+export type TrendChartMode = 'bar' | 'line'
+
+interface TrendChartCanvasProps extends ComponentProps<'div'> {
+	buckets: TrendBucket[]
+	mode: TrendChartMode
+}
+
+const COLOR_REVENUE = 'var(--primary)'
+const COLOR_PROFIT = 'var(--success)'
+const COLOR_AXIS = 'color-mix(in oklch, var(--muted-foreground) 60%, transparent)'
+const COLOR_GRID = 'color-mix(in oklch, var(--border) 60%, transparent)'
+const MARGIN = { top: 16, right: 8, bottom: 40, left: 62 }
+
+function centsToMajor(cents: number): number {
+	return cents / 100
+}
+
+interface TooltipData {
+	bucket: TrendBucket
+	x: number
+	y: number
+}
+
+function InnerChart({
+	buckets,
+	mode,
+	width,
+	height,
+}: {
+	buckets: TrendBucket[]
+	mode: TrendChartMode
+	width: number
+	height: number
+}) {
+	const formatMoney = useMoney()
+	const { showTooltip, hideTooltip, tooltipData, tooltipLeft, tooltipTop, tooltipOpen } =
+		useTooltip<TooltipData>()
+
+	const innerWidth = Math.max(0, width - MARGIN.left - MARGIN.right)
+	const innerHeight = Math.max(0, height - MARGIN.top - MARGIN.bottom)
+
+	const xScale = scaleBand<string>({
+		range: [0, innerWidth],
+		domain: buckets.map((b) => b.label),
+		padding: 0.2,
+	})
+
+	const maxRevenue = Math.max(...buckets.map((b) => Math.abs(centsToMajor(b.revenue.amountCents))), 1)
+	const yScale = scaleLinear<number>({
+		range: [innerHeight, 0],
+		domain: [0, maxRevenue * 1.15],
+		nice: true,
+	})
+
+	const getX = (b: TrendBucket) => xScale(b.label) ?? 0
+	const getRevenue = (b: TrendBucket) => yScale(Math.max(0, centsToMajor(b.revenue.amountCents)))
+	const getProfit = (b: TrendBucket) => yScale(Math.max(0, centsToMajor(b.profit.amountCents)))
+
+	const handleMouseMove = useCallback(
+		(event: React.MouseEvent<SVGElement>, bucket: TrendBucket) => {
+			const coords = localPoint(event) ?? { x: 0, y: 0 }
+			showTooltip({ tooltipData: { bucket, x: coords.x, y: coords.y }, tooltipLeft: coords.x, tooltipTop: coords.y })
+		},
+		[showTooltip],
+	)
+
+	if (width < 10) return null
+
+	return (
+		<div style={{ position: 'relative' }}>
+			<svg width={width} height={height}>
+				<Group left={MARGIN.left} top={MARGIN.top}>
+					<GridRows
+						scale={yScale}
+						width={innerWidth}
+						stroke={COLOR_GRID}
+						strokeDasharray="3,3"
+						numTicks={5}
+					/>
+
+					{mode === 'bar'
+						? buckets.map((b) => {
+								const bw = (xScale.bandwidth() / 2) - 1
+								const ry = getRevenue(b)
+								const py = getProfit(b)
+								return (
+									<Group key={b.label} onMouseMove={(e) => handleMouseMove(e, b)} onMouseLeave={hideTooltip}>
+										<Bar
+											x={getX(b)}
+											y={ry}
+											width={bw}
+											height={innerHeight - ry}
+											fill={COLOR_REVENUE}
+											fillOpacity={0.85}
+											rx={2}
+										/>
+										<Bar
+											x={getX(b) + bw + 2}
+											y={py}
+											width={bw}
+											height={innerHeight - py}
+											fill={COLOR_PROFIT}
+											fillOpacity={0.85}
+											rx={2}
+										/>
+									</Group>
+								)
+							})
+						: null}
+
+					{mode === 'line' ? (
+						<>
+							<LinePath
+								data={buckets}
+								x={(b) => getX(b) + xScale.bandwidth() / 2}
+								y={getRevenue}
+								stroke={COLOR_REVENUE}
+								strokeWidth={2}
+								curve={curveMonotoneX}
+							/>
+							<LinePath
+								data={buckets}
+								x={(b) => getX(b) + xScale.bandwidth() / 2}
+								y={getProfit}
+								stroke={COLOR_PROFIT}
+								strokeWidth={2}
+								curve={curveMonotoneX}
+							/>
+							{buckets.map((b) => (
+								<circle
+									key={b.label}
+									cx={getX(b) + xScale.bandwidth() / 2}
+									cy={getRevenue(b)}
+									r={3}
+									fill={COLOR_REVENUE}
+									onMouseMove={(e) => handleMouseMove(e, b)}
+									onMouseLeave={hideTooltip}
+								/>
+							))}
+						</>
+					) : null}
+
+					<AxisBottom
+						scale={xScale}
+						top={innerHeight}
+						stroke={COLOR_AXIS}
+						tickStroke={COLOR_AXIS}
+						tickLabelProps={{ fill: COLOR_AXIS, fontSize: 11, textAnchor: 'middle' }}
+						numTicks={Math.min(buckets.length, 12)}
+					/>
+					<AxisLeft
+						scale={yScale}
+						stroke={COLOR_AXIS}
+						tickStroke={COLOR_AXIS}
+						tickLabelProps={{ fill: COLOR_AXIS, fontSize: 11, textAnchor: 'end', dx: -4 }}
+						numTicks={5}
+						tickFormat={(v) => {
+							const n = Number(v)
+							if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`
+							if (n >= 1_000) return `${(n / 1_000).toFixed(0)}k`
+							return String(n)
+						}}
+					/>
+				</Group>
+			</svg>
+
+			{tooltipOpen && tooltipData && (
+				<TooltipWithBounds
+					key={Math.random()}
+					top={tooltipTop}
+					left={tooltipLeft}
+					style={{
+						...defaultStyles,
+						background: 'var(--popover)',
+						color: 'var(--popover-foreground)',
+						border: '1px solid var(--border)',
+						borderRadius: '0.5rem',
+						fontSize: 12,
+						padding: '8px 12px',
+					}}
+				>
+					<div className="flex flex-col gap-1">
+						<span className="font-medium">{tooltipData.bucket.label}</span>
+						<span>{formatMoney(tooltipData.bucket.revenue)}</span>
+					</div>
+				</TooltipWithBounds>
+			)}
+		</div>
+	)
+}
+
+export function TrendChartCanvas({ buckets, mode, className, ...props }: TrendChartCanvasProps) {
+	return (
+		<div className={cn('min-h-64 w-full', className)} {...props}>
+			<ParentSize>
+				{({ width, height }) => (
+					<InnerChart buckets={buckets} mode={mode} width={width} height={Math.max(height, 256)} />
+				)}
+			</ParentSize>
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/(app)/reports/-components/RevenueTrendSection/index.tsx b/packages/app/react/src/routes/(app)/reports/-components/RevenueTrendSection/index.tsx
