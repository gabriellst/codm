@@ -0,0 +1,29 @@
+import { create } from 'zustand'
+
+// Comparison basket — ephemeral per-session client state: must NOT survive a refresh
+// (STR-P10 case 3) and must NOT appear in the URL (it is per-user and not shareable).
+// A teammate following a shared link should not inherit your comparison selection.
+
+interface ReportsState {
+	comparisonBasket: string[] // product IDs selected for side-by-side comparison
+}
+
+interface ReportsActions {
+	toggleCompare: (productId: string) => void
+	clearBasket: () => void
+}
+
+type ReportsStore = ReportsState & ReportsActions
+
+export const useReportsStore = create<ReportsStore>((set) => ({
+	comparisonBasket: [],
+
+	toggleCompare: (productId) =>
+		set((state) => ({
+			comparisonBasket: state.comparisonBasket.includes(productId)
+				? state.comparisonBasket.filter((id) => id !== productId)
+				: [...state.comparisonBasket, productId],
+		})),
+
+	clearBasket: () => set({ comparisonBasket: [] }),
+}))
