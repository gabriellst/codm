+import { type ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useGetChart } from '@template/client-typescript/typescript'
+import { Skeleton } from '@/components/ui/skeleton'
+import { useMoney } from '@/hooks'
+import { useTenancyStore } from '@/stores'
+import { cn } from '@/lib/utils'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+const PERIOD_ORDER = ['MORNING', 'AFTERNOON', 'EVENING', 'NIGHT'] as const
+
+function SkeletonRows() {
+	return (
+		<div className="flex flex-col gap-3 p-6">
+			{[1, 2, 3, 4].map(i => (
+				<Skeleton key={i} className="h-10 w-full rounded-md" />
+			))}
+		</div>
+	)
+}
+
+export function PeriodVariant({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const { chartType, startDate, endDate } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+
+	const { data, isPending, isError } = useGetChart({
+		chartType,
+		tenancyScope,
+		frequency: 'DAILY',
+		startDate,
+		endDate,
+	})
+
+	const PERIOD_LABELS: Record<(typeof PERIOD_ORDER)[number], string> = {
+		MORNING: t('reports.period.MORNING'),
+		AFTERNOON: t('reports.period.AFTERNOON'),
+		EVENING: t('reports.period.EVENING'),
+		NIGHT: t('reports.period.NIGHT'),
+	}
+
+	const maxRevenue =
+		data?.kind === 'period'
+			? Math.max(...PERIOD_ORDER.map(p => data.segments[p].revenue.amountCents), 1)
+			: 1
+
+	return (
+		<div className={cn('overflow-x-auto', className)} {...props}>
+			{isPending ? (
+				<SkeletonRows />
+			) : isError ? (
+				<div className="flex items-center justify-center p-12 text-sm text-muted-foreground">
+					{t('reports.loadError')}
+				</div>
+			) : data?.kind === 'period' ? (
+				<table className="w-full text-sm" aria-label={t('reports.chartType.period')}>
+					<thead>
+						<tr className="border-b text-left text-muted-foreground">
+							<th className="p-3 font-medium">{t('reports.columns.segment')}</th>
+							<th className="p-3 text-right font-medium">{t('reports.columns.revenue')}</th>
+							<th className="p-3 text-right font-medium">{t('reports.columns.profit')}</th>
+							<th className="p-3 text-right font-medium">{t('reports.columns.orders')}</th>
+							<th className="w-32 p-3" />
+						</tr>
+					</thead>
+					<tbody>
+						{PERIOD_ORDER.map(period => {
+							const seg = data.segments[period]
+							const barPct = Math.max(0, Math.round((seg.revenue.amountCents / maxRevenue) * 100))
+							return (
+								<tr key={period} className="border-b transition-colors last:border-0 hover:bg-muted/50">
+									<td className="p-3 font-medium">{PERIOD_LABELS[period]}</td>
+									<td className="p-3 text-right tabular-nums">{formatMoney(seg.revenue)}</td>
+									<td className="p-3 text-right tabular-nums">{formatMoney(seg.profit)}</td>
+									<td className="p-3 text-right tabular-nums">{seg.orders}</td>
+									<td className="p-3">
+										<div className="h-2 overflow-hidden rounded-full bg-primary/20">
+											<div
+												className="h-full rounded-full bg-primary"
+												style={{ width: `${barPct}%` }}
+											/>
+										</div>
+									</td>
+								</tr>
+							)
+						})}
+					</tbody>
+				</table>
+			) : null}
+		</div>
+	)
+}
