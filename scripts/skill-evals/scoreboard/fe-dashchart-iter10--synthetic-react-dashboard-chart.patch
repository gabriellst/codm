+import { createFileRoute } from '@tanstack/react-router'
+import { format, subDays } from 'date-fns'
+import { getChartQueryParamsSchema, ChartTypeEnum } from '@template/client-typescript/typescript'
+import { z } from 'zod'
+
+import { ChartReportSection } from './-components/ChartReportSection'
+
+// Period + chart type are bookmarkable URL state. tenancyScope is app-global (useTenancyStore),
+// frequency is fixed at DAILY for v1 — neither belongs in the URL.
+const reportsSearchSchema = getChartQueryParamsSchema
+	.omit({ tenancyScope: true, frequency: true, productIds: true, startDate: true, endDate: true, chartType: true })
+	.and(
+		z.object({
+			chartType: z.enum(ChartTypeEnum).default(ChartTypeEnum.income),
+			startDate: z.string().default(() => format(subDays(new Date(), 29), 'yyyy-MM-dd')),
+			endDate: z.string().default(() => format(new Date(), 'yyyy-MM-dd')),
+		}),
+	)
+
+export type ReportsSearch = z.infer<typeof reportsSearchSchema>
+
+export const Route = createFileRoute('/(app)/reports/')({
+	staticData: { breadcrumb: 'Relatórios' },
+	validateSearch: search => reportsSearchSchema.parse(search ?? {}),
+	component: RouteComponent,
+})
+
+function RouteComponent() {
+	return (
+		<div className="flex flex-1 flex-col gap-6 overflow-y-auto p-6 md:p-8">
+			<ChartReportSection />
+		</div>
+	)
+}
