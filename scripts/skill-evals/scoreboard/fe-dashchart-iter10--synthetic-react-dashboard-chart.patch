+import { type ComponentProps, type ComponentType } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { ChartTypeEnum, type ChartType } from '@template/client-typescript/typescript'
+import { Card } from '@/components/ui/card'
+import { Tabs, TabsList, TabsTrigger } from '@/components/ui/tabs'
+import { Input } from '@/components/ui/input'
+import { cn } from '@/lib/utils'
+
+import { IncomeVariant } from './IncomeVariant'
+import { WeekdayVariant } from './WeekdayVariant'
+import { HourVariant } from './HourVariant'
+import { PeriodVariant } from './PeriodVariant'
+import { RegionVariant } from './RegionVariant'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+// Module-level constant — not inside JSX (bp-09)
+const CHART_TYPES = Object.values(ChartTypeEnum)
+
+// Each variant owns its own useGetChart call — no data prop (bp-02)
+const VARIANT_COMPONENTS: Record<ChartType, ComponentType> = {
+	income: IncomeVariant,
+	weekday: WeekdayVariant,
+	hour: HourVariant,
+	period: PeriodVariant,
+	region: RegionVariant,
+}
+
+export function ChartReportSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const { chartType, startDate, endDate } = routeApi.useSearch()
+	const navigate = routeApi.useNavigate()
+
+	const CHART_TYPE_LABELS: Record<ChartType, string> = {
+		income: t('enums.ChartType.income'),
+		weekday: t('enums.ChartType.weekday'),
+		hour: t('enums.ChartType.hour'),
+		period: t('enums.ChartType.period'),
+		region: t('enums.ChartType.region'),
+	}
+
+	function handleChartTypeChange(next: string) {
+		// biome-ignore lint/suspicious/noExplicitAny: search params may be extended by route
+		navigate({ search: (prev: any) => ({ ...prev, chartType: next as ChartType }) })
+	}
+
+	function handleStartDateChange(e: React.ChangeEvent<HTMLInputElement>) {
+		// biome-ignore lint/suspicious/noExplicitAny: search params may be extended by route
+		navigate({ search: (prev: any) => ({ ...prev, startDate: e.target.value }) })
+	}
+
+	function handleEndDateChange(e: React.ChangeEvent<HTMLInputElement>) {
+		// biome-ignore lint/suspicious/noExplicitAny: search params may be extended by route
+		navigate({ search: (prev: any) => ({ ...prev, endDate: e.target.value }) })
+	}
+
+	const VariantComponent = VARIANT_COMPONENTS[chartType]
+
+	return (
+		<div className={cn('flex flex-col gap-6', className)} {...props}>
+			{/* Header — always visible */}
+			<div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
+				<h1 className="text-2xl font-bold text-foreground">{t('reports.title')}</h1>
+				<div className="flex items-center gap-2">
+					<Input
+						type="date"
+						value={startDate.substring(0, 10)}
+						onChange={handleStartDateChange}
+						aria-label={t('reports.dateRange.startDate')}
+						className="w-40"
+					/>
+					<span className="text-muted-foreground">–</span>
+					<Input
+						type="date"
+						value={endDate.substring(0, 10)}
+						onChange={handleEndDateChange}
+						aria-label={t('reports.dateRange.endDate')}
+						className="w-40"
+					/>
+				</div>
+			</div>
+
+			{/* Recorte selector — always visible */}
+			<Tabs value={chartType} onValueChange={handleChartTypeChange}>
+				<TabsList aria-label={t('reports.recorteLabel')}>
+					{CHART_TYPES.map(type => (
+						<TabsTrigger key={type} value={type}>
+							{CHART_TYPE_LABELS[type]}
+						</TabsTrigger>
+					))}
+				</TabsList>
+			</Tabs>
+
+			{/* Variant owns its own query, loading and empty states */}
+			<Card className="overflow-hidden p-0">
+				<VariantComponent />
+			</Card>
+		</div>
+	)
+}
