@@ -0,0 +1,99 @@
+import { type ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useGetChart } from '@template/client-typescript/typescript'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Empty, EmptyHeader, EmptyTitle, EmptyDescription } from '@/components/ui/empty'
+import { useMoney, useLocale } from '@/hooks'
+import { useTenancyStore } from '@/stores'
+import { cn } from '@/lib/utils'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+function SkeletonRows() {
+	return (
+		<div className="flex flex-col gap-3 p-6">
+			{[1, 2, 3, 4, 5].map(i => (
+				<Skeleton key={i} className="h-10 w-full rounded-md" />
+			))}
+		</div>
+	)
+}
+
+export function IncomeVariant({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const locale = useLocale()
+	const { chartType, startDate, endDate } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+
+	const { data, isPending, isError } = useGetChart({
+		chartType,
+		tenancyScope,
+		frequency: 'DAILY',
+		startDate,
+		endDate,
+	})
+
+	const isEmpty = data?.kind === 'income' && data.buckets.length === 0
+	const maxRevenue = data?.kind === 'income' ? Math.max(...data.buckets.map(b => b.revenue.amountCents), 1) : 1
+
+	return (
+		<div className={cn('overflow-x-auto', className)} {...props}>
+			{isPending ? (
+				<SkeletonRows />
+			) : isError ? (
+				<div className="flex items-center justify-center p-12 text-sm text-muted-foreground">
+					{t('reports.loadError')}
+				</div>
+			) : isEmpty ? (
+				<div className="p-8">
+					<Empty>
+						<EmptyHeader>
+							<EmptyTitle>{t('reports.empty.title')}</EmptyTitle>
+							<EmptyDescription>{t('reports.empty.description')}</EmptyDescription>
+						</EmptyHeader>
+					</Empty>
+				</div>
+			) : data?.kind === 'income' ? (
+				<table className="w-full text-sm" aria-label={t('reports.chartType.income')}>
+					<thead>
+						<tr className="border-b text-left text-muted-foreground">
+							<th className="p-3 font-medium">{t('reports.columns.segment')}</th>
+							<th className="p-3 text-right font-medium">{t('reports.columns.revenue')}</th>
+							<th className="p-3 text-right font-medium">{t('reports.columns.profit')}</th>
+							<th className="p-3 text-right font-medium">{t('reports.columns.orders')}</th>
+							<th className="w-32 p-3" />
+						</tr>
+					</thead>
+					<tbody>
+						{data.buckets.map(bucket => {
+							const barPct = Math.max(0, Math.round((bucket.revenue.amountCents / maxRevenue) * 100))
+							return (
+								<tr
+									key={bucket.timestamp}
+									className="border-b transition-colors last:border-0 hover:bg-muted/50"
+								>
+									<td className="p-3 font-medium">
+										{new Date(bucket.timestamp).toLocaleDateString(locale)}
+									</td>
+									<td className="p-3 text-right tabular-nums">{formatMoney(bucket.revenue)}</td>
+									<td className="p-3 text-right tabular-nums">{formatMoney(bucket.profit)}</td>
+									<td className="p-3 text-right tabular-nums">{bucket.orders}</td>
+									<td className="p-3">
+										<div className="h-2 overflow-hidden rounded-full bg-primary/20">
+											<div
+												className="h-full rounded-full bg-primary"
+												style={{ width: `${barPct}%` }}
+											/>
+										</div>
+									</td>
+								</tr>
+							)
+						})}
+					</tbody>
+				</table>
+			) : null}
+		</div>
+	)
+}
