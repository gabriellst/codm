@@ -0,0 +1,205 @@
+import { useMemo } from 'react'
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { useQueryClient } from '@tanstack/react-query'
+import {
+	useListPurchaseOrders,
+	listPurchaseOrdersQueryKey,
+	useCancelPurchaseOrder,
+	PurchaseOrderStatusEnum,
+	type PurchaseOrderStatus,
+	type CurrencyCode,
+	type ListPurchaseOrders200,
+} from '@template/client-typescript/typescript'
+import { toast } from 'sonner'
+import { IconPlus, IconX } from '@tabler/icons-react'
+
+import { DataTable, DataTableContent, DataTablePagination } from '@/components/DataTable'
+import type { ColumnDef } from '@/components/DataTable'
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Skeleton } from '@/components/ui/skeleton'
+import { useMoney, useServerEvents } from '@/hooks'
+import { useDialogStore } from '@/stores/useDialogStore'
+import { useTenancyStore } from '@/stores/useTenancyStore'
+import { cn } from '@/lib/utils'
+
+import { CreatePurchaseOrderDialog } from './CreatePurchaseOrderDialog'
+
+// ─── Route API ───────────────────────────────────────────────────────────────
+
+const routeApi = getRouteApi('/(app)/procurement/purchase-orders/')
+
+// ─── Type aliases ────────────────────────────────────────────────────────────
+
+type PurchaseOrderItem = ListPurchaseOrders200['items'][number]
+
+// ─── Status badge dispatch map ────────────────────────────────────────────────
+
+interface StatusBadgeSpec {
+	variant: 'info' | 'warning' | 'error'
+	label: string
+}
+
+const STATUS_BADGE: Record<PurchaseOrderStatus, StatusBadgeSpec> = {
+	[PurchaseOrderStatusEnum.DRAFT]: { variant: 'warning', label: 'enums.PurchaseOrderStatus.DRAFT' },
+	[PurchaseOrderStatusEnum.PLACED]: { variant: 'info', label: 'enums.PurchaseOrderStatus.PLACED' },
+	[PurchaseOrderStatusEnum.CANCELLED]: { variant: 'error', label: 'enums.PurchaseOrderStatus.CANCELLED' },
+}
+
+// ─── Skeleton ─────────────────────────────────────────────────────────────────
+
+function PurchaseOrderListSkeleton() {
+	return (
+		<div className="flex flex-col gap-4">
+			<div className="flex items-center justify-between">
+				<Skeleton className="h-7 w-48" />
+				<Skeleton className="h-9 w-28 rounded-md" />
+			</div>
+			{Array.from({ length: 5 }).map((_, i) => (
+				<Skeleton key={`po-sk-${i}`} className="h-12 w-full rounded-lg" />
+			))}
+		</div>
+	)
+}
+
+// ─── Section ─────────────────────────────────────────────────────────────────
+
+export function PurchaseOrderListSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const navigate = routeApi.useNavigate()
+	const { page, limit, status, search } = routeApi.useSearch()
+	const queryClient = useQueryClient()
+	const formatMoney = useMoney()
+	const { show } = useDialogStore()
+	const tenancyScope = useTenancyStore(s => s.tenancyScope)
+
+	const { data, isPending, isError } = useListPurchaseOrders({ page, limit, status, search: search || undefined })
+
+	// Real-time: invalidate list when a new purchase order is recorded
+	useServerEvents('integration.shared.purchase_order.recorded', event => {
+		if (event.payload.storeId !== tenancyScope) return
+		queryClient.invalidateQueries({ queryKey: listPurchaseOrdersQueryKey() })
+	})
+
+	const cancelMutation = useCancelPurchaseOrder()
+
+	const items = data?.items ?? []
+	const total = data?.total ?? 0
+
+	const columns = useMemo(
+		(): ColumnDef<PurchaseOrderItem>[] => [
+			{
+				id: 'supplierName',
+				header: t('procurement.purchaseOrders.supplierName'),
+				accessorKey: 'supplierName',
+				cell: ({ row }) => <span className="font-medium text-foreground">{row.original.supplierName}</span>,
+			},
+			{
+				id: 'status',
+				header: t('procurement.purchaseOrders.status'),
+				accessorKey: 'status',
+				meta: { width: '130px' },
+				cell: ({ row }) => {
+					const spec = STATUS_BADGE[row.original.status]
+					return <Badge variant={spec.variant}>{t(spec.label)}</Badge>
+				},
+			},
+			{
+				id: 'totalAmount',
+				header: t('procurement.purchaseOrders.totalAmount'),
+				meta: { align: 'right', width: '140px' },
+				cell: ({ row }) =>
+					formatMoney({
+						amountCents: row.original.totalAmountCents,
+						currency: row.original.totalAmountCurrency as CurrencyCode,
+					}),
+			},
+			{
+				id: 'createdAt',
+				header: 'Date',
+				accessorKey: 'createdAt',
+				meta: { width: '120px' },
+				cell: ({ row }) => (
+					<span className="text-sm text-muted-foreground">
+						{new Date(row.original.createdAt).toLocaleDateString()}
+					</span>
+				),
+			},
+			{
+				id: 'actions',
+				header: '',
+				meta: { width: '80px' },
+				cell: ({ row }) => {
+					if (row.original.status === PurchaseOrderStatusEnum.CANCELLED) return null
+					return (
+						<Button
+							variant="ghost"
+							size="sm"
+							aria-label={t('procurement.purchaseOrders.cancel')}
+							onClick={() => {
+								cancelMutation.mutate(
+									{ purchaseOrderId: row.original.id },
+									{
+										onSuccess: () => {
+											toast.success(t('procurement.purchaseOrders.confirmCancel'))
+											queryClient.invalidateQueries({ queryKey: listPurchaseOrdersQueryKey() })
+										},
+									},
+								)
+							}}
+						>
+							<IconX className="size-4 text-destructive" />
+							{t('procurement.purchaseOrders.cancel')}
+						</Button>
+					)
+				},
+			},
+		],
+		[t, formatMoney, cancelMutation, queryClient],
+	)
+
+	return (
+		<div className={cn('flex flex-col gap-4', className)} {...props}>
+			{/* Header */}
+			<div className="flex items-center justify-between">
+				<h1 className="text-xl font-semibold text-foreground">{t('procurement.purchaseOrders.title')}</h1>
+				<Button size="sm" onClick={() => show(<CreatePurchaseOrderDialog />)}>
+					<IconPlus className="size-4" />
+					{t('procurement.purchaseOrders.create')}
+				</Button>
+			</div>
+
+			{isPending ? (
+				<PurchaseOrderListSkeleton />
+			) : isError ? (
+				<p className="text-sm text-destructive">{t('procurement.purchaseOrders.empty')}</p>
+			) : (
+				<DataTable
+					columns={columns}
+					getRowId={r => r.id}
+					data={items}
+					total={total}
+					totalPages={data?.total ? Math.ceil(data.total / limit) : 0}
+					isLoading={isPending}
+					page={page}
+					limit={limit}
+					search={search}
+					onPageChange={p => navigate({ search: prev => ({ ...prev, page: p }) })}
+					onLimitChange={l => navigate({ search: prev => ({ ...prev, limit: l, page: 1 }) })}
+					onSearchChange={s => navigate({ search: prev => ({ ...prev, search: s, page: 1 }) })}
+				>
+					<DataTableContent
+						emptyState={
+							<div className="py-12 text-center text-sm text-muted-foreground">
+								{t('procurement.purchaseOrders.empty')}
+							</div>
+						}
+					/>
+					<DataTablePagination />
+				</DataTable>
+			)}
+		</div>
+	)
+}
