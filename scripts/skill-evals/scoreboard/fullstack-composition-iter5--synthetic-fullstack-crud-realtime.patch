+import { describe, it, expect } from 'bun:test'
+import { PurchaseOrderStatus, CurrencyCode } from '@template/contracts-typescript/wire/enums'
+import { PurchaseOrder } from './PurchaseOrder'
+
+const STORE_ID = '00000000-0000-0000-0000-000000000001'
+const TOTAL = { amountCents: 10_000, currency: CurrencyCode.BRL }
+
+describe('PurchaseOrder entity', () => {
+	it('creates in PLACED status', () => {
+		const po = PurchaseOrder.create({ storeId: STORE_ID, supplierName: 'Acme', totalAmount: TOTAL })
+		expect(po.status).toBe(PurchaseOrderStatus.PLACED)
+		expect(po.supplierName).toBe('Acme')
+		expect(po.totalAmount.amountCents).toBe(10_000)
+		expect(po.storeId.value).toBe(STORE_ID)
+	})
+
+	it('cancel transitions PLACED → CANCELLED', () => {
+		const po = PurchaseOrder.create({ storeId: STORE_ID, supplierName: 'Acme', totalAmount: TOTAL })
+		po.cancel()
+		expect(po.status).toBe(PurchaseOrderStatus.CANCELLED)
+	})
+
+	it('cancel throws PURCHASE_ORDER_ALREADY_CANCELLED when already cancelled', () => {
+		const po = PurchaseOrder.create({ storeId: STORE_ID, supplierName: 'Acme', totalAmount: TOTAL })
+		po.cancel()
+		expect(() => po.cancel()).toThrow()
+	})
+})
