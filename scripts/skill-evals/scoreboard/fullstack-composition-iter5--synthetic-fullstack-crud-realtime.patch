@@ -0,0 +1,184 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useForm } from '@tanstack/react-form'
+import { useQueryClient } from '@tanstack/react-query'
+import { toast } from 'sonner'
+import {
+	useCreatePurchaseOrder,
+	listPurchaseOrdersQueryKey,
+	CurrencyCodeEnum,
+	createPurchaseOrderMutationRequestSchema,
+	type CurrencyCode,
+	type CreatePurchaseOrderMutationRequest,
+} from '@template/client-typescript/typescript'
+
+import { cn } from '@/lib/utils'
+import { Button } from '@/components/ui/button'
+import { Field, FieldError, FieldGroup, FieldLabel } from '@/components/ui/field'
+import { Input } from '@/components/ui/input'
+import { Spinner } from '@/components/ui/spinner'
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select'
+import { useDialogStore } from '@/stores/useDialogStore'
+
+// ─── Constants ────────────────────────────────────────────────────────────────
+
+const CURRENCY_OPTIONS = Object.values(CurrencyCodeEnum)
+
+// ─── Types ────────────────────────────────────────────────────────────────────
+
+interface FormValues {
+	supplierName: string
+	totalAmountCents: number
+	totalAmountCurrency: CurrencyCode
+}
+
+type CreatePurchaseOrderDialogProps = ComponentProps<'div'>
+
+// ─── Component ───────────────────────────────────────────────────────────────
+
+/**
+ * CreatePurchaseOrderDialog — dialog for creating a new purchase order.
+ * Self-contained: owns form state, mutation, toast, and invalidation.
+ * Opened via useDialogStore().show(<CreatePurchaseOrderDialog />).
+ */
+export function CreatePurchaseOrderDialog({ className, ...props }: CreatePurchaseOrderDialogProps) {
+	const { t } = useTranslation()
+	const hide = useDialogStore(s => s.hide)
+	const queryClient = useQueryClient()
+
+	const createPurchaseOrder = useCreatePurchaseOrder({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('procurement.purchaseOrders.create'))
+				queryClient.invalidateQueries({ queryKey: listPurchaseOrdersQueryKey() })
+				hide()
+			},
+		},
+	})
+
+	const defaultValues: FormValues = {
+		supplierName: '',
+		totalAmountCents: 0,
+		totalAmountCurrency: CurrencyCodeEnum.BRL,
+	}
+
+	const form = useForm({
+		defaultValues,
+		onSubmit: async ({ value }) => {
+			const body: CreatePurchaseOrderMutationRequest = {
+				supplierName: value.supplierName,
+				totalAmount: {
+					amountCents: value.totalAmountCents,
+					currency: value.totalAmountCurrency,
+				},
+			}
+			const result = createPurchaseOrderMutationRequestSchema.safeParse(body)
+			if (!result.success) return
+			await createPurchaseOrder.mutateAsync({ data: result.data })
+		},
+	})
+
+	return (
+		<div className={cn('flex flex-col gap-6 p-6', className)} {...props}>
+			<div className="flex flex-col gap-1">
+				<h2 className="text-lg font-semibold text-foreground">{t('procurement.purchaseOrders.create')}</h2>
+			</div>
+
+			<form
+				noValidate
+				onSubmit={e => {
+					e.preventDefault()
+					e.stopPropagation()
+					form.handleSubmit()
+				}}
+			>
+				<FieldGroup>
+					<form.Field
+						name="supplierName"
+						validators={{ onChange: createPurchaseOrderMutationRequestSchema.shape.supplierName }}
+					>
+						{field => (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('procurement.purchaseOrders.supplierName')}</FieldLabel>
+								<Input
+									id={field.name}
+									placeholder={t('procurement.purchaseOrders.supplierName')}
+									value={field.state.value}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+								/>
+								{field.state.meta.errors[0] && <FieldError>{String(field.state.meta.errors[0])}</FieldError>}
+							</Field>
+						)}
+					</form.Field>
+
+					<form.Field name="totalAmountCents">
+						{field => (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('procurement.purchaseOrders.totalAmount')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="number"
+									min={0}
+									step={1}
+									placeholder="0"
+									value={field.state.value}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(Number(e.target.value))}
+								/>
+								{field.state.meta.errors[0] && <FieldError>{String(field.state.meta.errors[0])}</FieldError>}
+							</Field>
+						)}
+					</form.Field>
+
+					<form.Field name="totalAmountCurrency">
+						{field => (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('procurement.purchaseOrders.currency')}</FieldLabel>
+								<Select
+									value={field.state.value}
+									onValueChange={v => field.handleChange((v ?? CurrencyCodeEnum.BRL) as CurrencyCode)}
+								>
+									<SelectTrigger id={field.name}>
+										<SelectValue placeholder={t('procurement.purchaseOrders.currency')} />
+									</SelectTrigger>
+									<SelectContent>
+										{CURRENCY_OPTIONS.map(c => (
+											<SelectItem key={c} value={c}>
+												{t(`enums.CurrencyCode.${c}`)}
+											</SelectItem>
+										))}
+									</SelectContent>
+								</Select>
+								{field.state.meta.errors[0] && <FieldError>{String(field.state.meta.errors[0])}</FieldError>}
+							</Field>
+						)}
+					</form.Field>
+
+					<form.Subscribe selector={s => [s.values, s.isSubmitting] as const}>
+						{([values, isSubmitting]) => {
+							const body: CreatePurchaseOrderMutationRequest = {
+								supplierName: values.supplierName,
+								totalAmount: {
+									amountCents: values.totalAmountCents,
+									currency: values.totalAmountCurrency,
+								},
+							}
+							const isValid = createPurchaseOrderMutationRequestSchema.safeParse(body).success
+							return (
+								<div className="flex justify-end gap-2 pt-2">
+									<Button type="button" variant="outline" onClick={hide}>
+										{t('procurement.purchaseOrders.cancel')}
+									</Button>
+									<Button type="submit" disabled={!isValid || isSubmitting}>
+										{isSubmitting ? <Spinner /> : t('procurement.purchaseOrders.create')}
+									</Button>
+								</div>
+							)
+						}}
+					</form.Subscribe>
+				</FieldGroup>
+			</form>
+		</div>
+	)
+}
