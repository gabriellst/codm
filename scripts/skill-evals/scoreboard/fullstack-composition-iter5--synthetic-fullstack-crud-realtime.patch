diff --git a/packages/api/typescript/src/procurement/usecases/CreatePurchaseOrder.ts b/packages/api/typescript/src/procurement/usecases/CreatePurchaseOrder.ts
new file mode 100644
index 000000000..5fcfbd857
--- /dev/null
+++ b/packages/api/typescript/src/procurement/usecases/CreatePurchaseOrder.ts
@@ -0,0 +1,57 @@
+import { injectable } from 'tsyringe-neo'
+import { Handler, z, type Transaction } from '@template/core-typescript'
+import { MoneySchema } from '../../shared/objects'
+import { PurchaseOrder } from '../entities/PurchaseOrder'
+import { PurchaseOrderRepository } from '../repositories/PurchaseOrderRepository'
+import { PurchaseOrderCreatedEvent } from '../events'
+
+export const CreatePurchaseOrderInputSchema = z.object({
+	userId: z.uuid(),
+	storeId: z.uuid(),
+	supplierName: z.string().min(1).max(500),
+	totalAmount: MoneySchema,
+})
+
+export const CreatePurchaseOrderOutputSchema = z.object({
+	purchaseOrderId: z.uuid(),
+})
+
+@injectable()
+export class CreatePurchaseOrder extends Handler<typeof CreatePurchaseOrderInputSchema, typeof CreatePurchaseOrderOutputSchema> {
+	readonly name = 'create_purchase_order' as const
+	readonly inputSchema = CreatePurchaseOrderInputSchema
+	readonly outputSchema = CreatePurchaseOrderOutputSchema
+
+	constructor(private readonly orders: PurchaseOrderRepository) {
+		super()
+	}
+
+	protected async handle(input: this['input'], tx?: Transaction): Promise<this['output']> {
+		return this.withTransaction(tx, async tx => {
+			const entity = PurchaseOrder.create({
+				storeId: input.storeId,
+				supplierName: input.supplierName,
+				totalAmount: input.totalAmount,
+			})
+			await this.orders.save(entity, tx)
+
+			await this.domainEventRepository.save(
+				new PurchaseOrderCreatedEvent({
+					entityId: entity.id.value,
+					ownerId: input.storeId,
+					payload: {
+						purchaseOrderId: entity.id.value,
+						storeId: input.storeId,
+						supplierName: entity.supplierName,
+						status: entity.status,
+						totalAmountCents: entity.totalAmount.amountCents,
+						totalAmountCurrency: entity.totalAmount.currency,
+					},
+				}),
+				tx,
+			)
+
+			return { purchaseOrderId: entity.id.value }
+		})
+	}
+}
diff --git a/packages/api/typescript/src/procurement/usecases/PurchaseOrder.test.ts b/packages/api/typescript/src/procurement/usecases/PurchaseOrder.test.ts
new file mode 100644
index 000000000..61d8dda38
--- /dev/null
+++ b/packages/api/typescript/src/procurement/usecases/PurchaseOrder.test.ts
@@ -0,0 +1,76 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { container, type DependencyContainer } from 'tsyringe-neo'
+import { TestBed, testId } from '@test/support'
+import { DomainEventRepository } from '@template/core-typescript'
+import { CurrencyCode } from '@template/contracts-typescript/wire/enums'
+import { CreatePurchaseOrder } from './CreatePurchaseOrder'
+import { CancelPurchaseOrder } from './CancelPurchaseOrder'
+import { PurchaseOrderRepository } from '../repositories/PurchaseOrderRepository'
+import { PurchaseOrderCreatedEvent, PurchaseOrderCancelledEvent } from '../events'
+
+const STORE = testId('store', '1')
+const USER = testId('user', '1')
+const TOTAL = { amountCents: 50_000, currency: CurrencyCode.BRL }
+
+describe('PurchaseOrder use cases', () => {
+	let testBed: TestBed
+	let testContainer: DependencyContainer
+	let create: CreatePurchaseOrder
+	let cancel: CancelPurchaseOrder
+	let repo: PurchaseOrderRepository
+
+	beforeAll(async () => {
+		testContainer = container.createChildContainer()
+		testBed = await TestBed.create('integration', { testContainer, ownerId: 'integration-tenant' })
+		create = testBed.resolve(CreatePurchaseOrder)
+		cancel = testBed.resolve(CancelPurchaseOrder)
+		repo = testBed.resolve(PurchaseOrderRepository)
+	})
+	beforeEach(async () => {
+		await testBed.reset()
+	})
+	afterAll(async () => {
+		await testBed.destroy()
+	})
+
+	function eventRepo() {
+		return testBed.resolve(DomainEventRepository)
+	}
+
+	it('CreatePurchaseOrder persists in PLACED status + emits PurchaseOrderCreatedEvent', async () => {
+		const { purchaseOrderId } = await create.execute({ userId: USER, storeId: STORE, supplierName: 'Acme Corp', totalAmount: TOTAL })
+
+		const saved = await repo.findById(purchaseOrderId)
+		expect(saved?.supplierName).toBe('Acme Corp')
+		expect(saved?.totalAmount.amountCents).toBe(50_000)
+
+		const events = await eventRepo().findByType(PurchaseOrderCreatedEvent)
+		expect(events).toHaveLength(1)
+		expect(events[0]!.payload.purchaseOrderId).toBe(purchaseOrderId)
+		expect(events[0]!.payload.storeId).toBe(STORE)
+	})
+
+	it('CancelPurchaseOrder transitions to CANCELLED + emits PurchaseOrderCancelledEvent', async () => {
+		const { purchaseOrderId } = await create.execute({ userId: USER, storeId: STORE, supplierName: 'Acme Corp', totalAmount: TOTAL })
+		await cancel.execute({ userId: USER, storeId: STORE, purchaseOrderId })
+
+		const saved = await repo.findById(purchaseOrderId)
+		expect(saved?.status).toBe('CANCELLED')
+
+		const events = await eventRepo().findByType(PurchaseOrderCancelledEvent)
+		expect(events).toHaveLength(1)
+		expect(events[0]!.payload.purchaseOrderId).toBe(purchaseOrderId)
+	})
+
+	it('CancelPurchaseOrder throws PURCHASE_ORDER_ALREADY_CANCELLED on double cancel', async () => {
+		const { purchaseOrderId } = await create.execute({ userId: USER, storeId: STORE, supplierName: 'Acme Corp', totalAmount: TOTAL })
+		await cancel.execute({ userId: USER, storeId: STORE, purchaseOrderId })
+		await expect(cancel.execute({ userId: USER, storeId: STORE, purchaseOrderId })).rejects.toMatchObject({ name: 'PURCHASE_ORDER_ALREADY_CANCELLED' })
+	})
+
+	it('CancelPurchaseOrder throws PURCHASE_ORDER_NOT_FOUND on missing id', async () => {
+		await expect(
+			cancel.execute({ userId: USER, storeId: STORE, purchaseOrderId: testId('po', 'missing') }),
+		).rejects.toMatchObject({ name: 'PURCHASE_ORDER_NOT_FOUND' })
+	})
+})
