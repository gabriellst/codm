@@ -0,0 +1,34 @@
+package purchaseorderaudit
+
+import (
+	"context"
+	"database/sql"
+
+	"template/api-go/internal/sync/handlers"
+)
+
+// PgPurchaseOrderAuditRepository persists purchase order audit rows to Postgres.
+type PgPurchaseOrderAuditRepository struct{ db *sql.DB }
+
+func NewPgPurchaseOrderAuditRepository(db *sql.DB) *PgPurchaseOrderAuditRepository {
+	return &PgPurchaseOrderAuditRepository{db: db}
+}
+
+var _ handlers.PurchaseOrderAuditInserter = (*PgPurchaseOrderAuditRepository)(nil)
+
+const insertAudit = `
+	INSERT INTO procurement.purchase_order_audit
+		(purchase_order_id, store_id, supplier_name, status, total_amount_cents, total_amount_currency)
+	VALUES ($1, $2, $3, $4, $5, $6)`
+
+func (r *PgPurchaseOrderAuditRepository) Insert(ctx context.Context, row handlers.PurchaseOrderAuditRow) error {
+	_, err := r.db.ExecContext(ctx, insertAudit,
+		row.PurchaseOrderID,
+		row.StoreID,
+		row.SupplierName,
+		row.Status,
+		row.TotalAmountCents,
+		row.TotalAmountCurrency,
+	)
+	return err
+}
