@@ -0,0 +1,102 @@
+package handlers
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+
+	wire "template/contracts-go/wire"
+	"template/core-go/types"
+)
+
+// stubPurchaseOrderAuditRepo captures the last Insert call.
+type stubPurchaseOrderAuditRepo struct {
+	inserted *PurchaseOrderAuditRow
+}
+
+func (s *stubPurchaseOrderAuditRepo) Insert(_ context.Context, row PurchaseOrderAuditRow) error {
+	s.inserted = &row
+	return nil
+}
+
+// rawPurchaseOrderRecorded wraps a JSON payload as a types.IntegrationEventI.
+func rawPurchaseOrderRecorded() types.IntegrationEventI {
+	raw, _ := json.Marshal(map[string]any{
+		"name":                wire.PurchaseOrderRecordedEventName,
+		"entityId":            "ent-1",
+		"ownerId":             "owner-1",
+		"occurredAt":          time.Now().UTC().Format(time.RFC3339),
+		"purchaseOrderId":     "po-123",
+		"storeId":             "store-456",
+		"supplierName":        "ACME Supplies",
+		"status":              "PENDING",
+		"totalAmountCents":    int64(100000),
+		"totalAmountCurrency": "BRL",
+	})
+	return &fakePurchaseOrderEvent{name: wire.PurchaseOrderRecordedEventName, raw: raw}
+}
+
+type fakePurchaseOrderEvent struct {
+	name string
+	raw  json.RawMessage
+}
+
+func (e *fakePurchaseOrderEvent) GetEventName() string        { return e.name }
+func (e *fakePurchaseOrderEvent) GetOwnerID() string          { return "" }
+func (e *fakePurchaseOrderEvent) GetPayload() json.RawMessage { return e.raw }
+
+func TestPurchaseOrderRecordedHandler_EventName(t *testing.T) {
+	h := NewPurchaseOrderRecordedHandler(&stubPurchaseOrderAuditRepo{})
+	if h.EventName() != wire.PurchaseOrderRecordedEventName {
+		t.Fatalf("EventName = %q, want %q", h.EventName(), wire.PurchaseOrderRecordedEventName)
+	}
+}
+
+func TestPurchaseOrderRecordedHandler_Handle_InsertsAuditRow(t *testing.T) {
+	repo := &stubPurchaseOrderAuditRepo{}
+	h := NewPurchaseOrderRecordedHandler(repo)
+
+	if err := h.Handle(context.Background(), rawPurchaseOrderRecorded()); err != nil {
+		t.Fatalf("Handle: %v", err)
+	}
+
+	if repo.inserted == nil {
+		t.Fatal("expected Insert to be called")
+	}
+	if repo.inserted.PurchaseOrderID != "po-123" {
+		t.Errorf("PurchaseOrderID = %q, want %q", repo.inserted.PurchaseOrderID, "po-123")
+	}
+	if repo.inserted.StoreID != "store-456" {
+		t.Errorf("StoreID = %q, want %q", repo.inserted.StoreID, "store-456")
+	}
+	if repo.inserted.SupplierName != "ACME Supplies" {
+		t.Errorf("SupplierName = %q, want %q", repo.inserted.SupplierName, "ACME Supplies")
+	}
+	if repo.inserted.Status != "PENDING" {
+		t.Errorf("Status = %q, want %q", repo.inserted.Status, "PENDING")
+	}
+	if repo.inserted.TotalAmountCents != 100000 {
+		t.Errorf("TotalAmountCents = %d, want 100000", repo.inserted.TotalAmountCents)
+	}
+	if repo.inserted.TotalAmountCurrency != "BRL" {
+		t.Errorf("TotalAmountCurrency = %q, want %q", repo.inserted.TotalAmountCurrency, "BRL")
+	}
+}
+
+func TestPurchaseOrderRecordedHandler_Handle_WrongTypeReturnsError(t *testing.T) {
+	h := NewPurchaseOrderRecordedHandler(&stubPurchaseOrderAuditRepo{})
+
+	// An event that does not implement GetPayload() — no payload provider.
+	var wrongEvent noPayloadEvent
+	err := h.Handle(context.Background(), wrongEvent)
+	if err == nil {
+		t.Fatal("expected error for wrong event type, got nil")
+	}
+}
+
+// noPayloadEvent satisfies types.IntegrationEventI but carries no payload.
+type noPayloadEvent struct{}
+
+func (noPayloadEvent) GetEventName() string { return "wrong.event" }
+func (noPayloadEvent) GetOwnerID() string   { return "" }
