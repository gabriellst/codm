diff --git a/packages/app/react/src/lib/union.ts b/packages/app/react/src/lib/union.ts
index 47b1a4d96..f9cc4840c 100644
--- a/packages/app/react/src/lib/union.ts
+++ b/packages/app/react/src/lib/union.ts
@@ -80,3 +80,18 @@ type VariantField<
 	Match extends Partial<UnionShape<M>>,
 	F extends keyof Extract<UnionShape<M>, Match> & string,
 > = Extract<UnionShape<M>, Match>[F]
+
+/**
+ * Runtime variant of `pickUnionVariant` for call sites where the discriminant values come from
+ * a store or user selection (i.e. typed as `string`, not as literal values known at compile time).
+ * `Partial<UnionShape<M>>` distributes over union members, making it impossible to pass the full
+ * platform-literal-union type to the typed overload. This variant accepts plain strings and
+ * internally delegates to the same runtime logic — trading compile-time literal checking for
+ * call-site ergonomics at the store/selection boundary.
+ */
+export function pickUnionVariantByStrings<M extends z.ZodObject>(
+	union: z.ZodUnion<readonly M[]>,
+	match: Partial<Record<string, string>>,
+): M {
+	return pickUnionVariant(union, match as Partial<UnionShape<M>>)
+}
