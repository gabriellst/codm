+import { create } from 'zustand'
+import type { ConnectionMode } from '@template/client-typescript/typescript'
+
+interface ConnectStore {
+	currentStepIndex: number
+	direction: 1 | -1
+	connectionMode: ConnectionMode | undefined
+	selectedPlatform: string | undefined
+	selectedType: string | undefined
+	setConnectionMode: (mode: ConnectionMode | undefined) => void
+	setSelectedPlatform: (platform: string | undefined) => void
+	setSelectedType: (type: string | undefined) => void
+	setCurrentStepIndex: (index: number) => void
+	setDirection: (direction: 1 | -1) => void
+	reset: () => void
+}
+
+const initialState = {
+	currentStepIndex: 0,
+	direction: 1 as const,
+	connectionMode: undefined as ConnectionMode | undefined,
+	selectedPlatform: undefined as string | undefined,
+	selectedType: undefined as string | undefined,
+}
+
+export const useConnectStore = create<ConnectStore>()(set => ({
+	...initialState,
+	setConnectionMode: connectionMode => set({ connectionMode }),
+	setSelectedPlatform: selectedPlatform => set({ selectedPlatform }),
+	setSelectedType: selectedType => set({ selectedType }),
+	setCurrentStepIndex: currentStepIndex => set({ currentStepIndex }),
+	setDirection: direction => set({ direction }),
+	reset: () => set(initialState),
+}))
