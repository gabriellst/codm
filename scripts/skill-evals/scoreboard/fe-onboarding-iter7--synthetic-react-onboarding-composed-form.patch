+import { useState, type ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Button } from '@/components/ui/button'
+import { IconArrowRight, IconArrowLeft } from '@tabler/icons-react'
+import { Spinner } from '@/components/ui/spinner'
+import type { ConnectionMode } from '@template/client-typescript/typescript'
+import { cn } from '@/lib/utils'
+
+export interface OnboardingTarget {
+	platform: string
+	type: string
+	connectionMode: ConnectionMode
+}
+
+// The four targets the wizard launches with.
+export const ONBOARDING_TARGETS: readonly OnboardingTarget[] = [
+	{ platform: 'SHOPIFY', type: 'SALES_CHANNEL', connectionMode: 'CREDENTIALS' },
+	{ platform: 'YAMPI', type: 'CHECKOUT', connectionMode: 'CREDENTIALS' },
+	{ platform: 'META', type: 'MARKETING_PLATFORM', connectionMode: 'MANUAL' },
+	{ platform: 'MERCADOPAGO', type: 'PAYMENT_GATEWAY', connectionMode: 'MANUAL' },
+] as const
+
+// Static platform icon map — no template-literal dispatch (CMP-P18 / bp-25)
+const PLATFORM_ICONS: Record<string, string> = {
+	SHOPIFY: '🛒',
+	YAMPI: '🏪',
+	META: '📣',
+	MERCADOPAGO: '💳',
+}
+
+// Static display name keys — no template-literal dispatch
+const PLATFORM_NAME_KEYS: Record<string, string> = {
+	SHOPIFY: 'onboarding.target.shopifyName',
+	YAMPI: 'onboarding.target.yampiName',
+	META: 'onboarding.target.metaName',
+	MERCADOPAGO: 'onboarding.target.mercadopagoName',
+}
+
+const PLATFORM_DESCRIPTION_KEYS: Record<string, string> = {
+	SHOPIFY: 'onboarding.target.shopifyDescription',
+	YAMPI: 'onboarding.target.yampiDescription',
+	META: 'onboarding.target.metaDescription',
+	MERCADOPAGO: 'onboarding.target.mercadopagoDescription',
+}
+
+interface TargetStepProps extends ComponentProps<'div'> {
+	connectionMode: ConnectionMode
+	onSubmit: (platform: string, type: string) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+export function TargetStep({ connectionMode, onSubmit, onBack, isSubmitting, className, ...props }: TargetStepProps) {
+	const { t } = useTranslation()
+	const [selected, setSelected] = useState<OnboardingTarget | undefined>(undefined)
+
+	const targets = ONBOARDING_TARGETS.filter(t => t.connectionMode === connectionMode)
+
+	return (
+		<div className={cn('flex flex-col gap-8', className)} {...props}>
+			<div className="text-center">
+				<h2 className="text-2xl font-semibold tracking-tight">{t('onboarding.target.title')}</h2>
+				<p className="text-muted-foreground mt-2">{t('onboarding.target.subtitle')}</p>
+			</div>
+
+			<div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
+				{targets.map(target => (
+					<button
+						key={target.platform}
+						type="button"
+						onClick={() => setSelected(target)}
+						className={cn(
+							'flex flex-col gap-3 rounded-xl border p-5 text-left transition-all',
+							'hover:border-primary/50 hover:bg-muted/30',
+							selected?.platform === target.platform
+								? 'border-primary bg-primary/5 ring-1 ring-primary'
+								: 'border-border bg-background',
+						)}
+					>
+						<span className="text-3xl">{PLATFORM_ICONS[target.platform] ?? '🔗'}</span>
+						<div>
+							<p className="font-semibold">{t(PLATFORM_NAME_KEYS[target.platform] ?? target.platform)}</p>
+							<p className="text-xs text-muted-foreground mt-0.5">
+								{t(PLATFORM_DESCRIPTION_KEYS[target.platform] ?? '')}
+							</p>
+						</div>
+					</button>
+				))}
+			</div>
+
+			<div className="flex justify-between">
+				<div>
+					{onBack && (
+						<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+							<IconArrowLeft className="mr-1 size-4" />
+							{t('common.back')}
+						</Button>
+					)}
+				</div>
+				<Button
+					type="button"
+					disabled={!selected || isSubmitting}
+					onClick={() => selected && onSubmit(selected.platform, selected.type)}
+				>
+					{isSubmitting && <Spinner className="mr-2" />}
+					{t('common.next')}
+					<IconArrowRight className="ml-1 size-4" />
+				</Button>
+			</div>
+		</div>
+	)
+}
