diff --git a/packages/app/react/src/routes/onboarding/-components/ConnectWizard/index.tsx b/packages/app/react/src/routes/onboarding/-components/ConnectWizard/index.tsx
new file mode 100644
index 000000000..f66720539
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/ConnectWizard/index.tsx
@@ -0,0 +1,187 @@
+import { useCallback, useState, type ComponentProps, type ReactNode } from 'react'
+import { useNavigate } from '@tanstack/react-router'
+import { toast } from 'sonner'
+import { useTranslation } from 'react-i18next'
+import {
+	useConnectIntegration,
+	connectIntegrationMutationRequestSchema,
+	ConnectionModeEnum,
+	type ConnectionMode,
+} from '@template/client-typescript/typescript'
+import { pickUnionVariantByStrings } from '@/lib/union'
+import { cn } from '@/lib/utils'
+import { useConnectStore } from '../../-stores/useConnectStore'
+import { ConnectionModeStep } from '../ConnectionModeStep'
+import { TargetStep } from '../TargetStep'
+import { CredentialsStep } from '../CredentialsStep'
+import { ReviewStep } from '../ReviewStep'
+
+// ─── Step sequences — const-asserted tuples keyed by SDK ConnectionMode ──────
+
+const CREDENTIALS_STEPS = ['CONNECTION_MODE', 'TARGET', 'CREDENTIALS', 'REVIEW'] as const
+const MANUAL_STEPS = ['CONNECTION_MODE', 'TARGET', 'REVIEW'] as const
+const INITIAL_STEPS = ['CONNECTION_MODE'] as const
+
+type ConnectStepId = (typeof CREDENTIALS_STEPS)[number] | (typeof MANUAL_STEPS)[number]
+
+const STEP_SEQUENCES: Record<ConnectionMode, readonly ConnectStepId[]> = {
+	[ConnectionModeEnum.CREDENTIALS]: CREDENTIALS_STEPS,
+	[ConnectionModeEnum.MANUAL]: MANUAL_STEPS,
+	[ConnectionModeEnum.OAUTH]: MANUAL_STEPS,
+}
+
+// ─── ConnectWizard ────────────────────────────────────────────────────────────
+
+type ConnectWizardProps = ComponentProps<'div'>
+
+export function ConnectWizard({ className, ...props }: ConnectWizardProps) {
+	const { t } = useTranslation()
+	const navigate = useNavigate()
+
+	const {
+		currentStepIndex,
+		connectionMode,
+		selectedPlatform,
+		selectedType,
+		setConnectionMode,
+		setSelectedPlatform,
+		setSelectedType,
+		setCurrentStepIndex,
+		setDirection,
+		reset,
+	} = useConnectStore()
+
+	// Accumulated payload — local transient state (STR-P10 case 5).
+	// No TanStack Form needed: the wizard submits exactly once, no field-level
+	// validation in the parent, no progressive server saves.
+	// Typed as Record<string, unknown> to avoid distributing DeepPartial over the union;
+	// the payload is validated via pickUnionVariant(...).safeParse before submission.
+	const [accumulated, setAccumulated] = useState<Record<string, unknown>>({})
+
+	const connect = useConnectIntegration({
+		mutation: {
+			onSuccess: () => {
+				toast.success(t('onboarding.toast.success'), {
+					description: t('onboarding.toast.successDescription'),
+				})
+				reset()
+				navigate({ to: '/' })
+			},
+		},
+	})
+
+	const steps = connectionMode ? STEP_SEQUENCES[connectionMode] : INITIAL_STEPS
+	const currentStep = steps[currentStepIndex] ?? 'CONNECTION_MODE'
+
+	const goNext = useCallback(() => {
+		setDirection(1)
+		setCurrentStepIndex(currentStepIndex + 1)
+	}, [currentStepIndex, setDirection, setCurrentStepIndex])
+
+	const goBack = useCallback(() => {
+		setDirection(-1)
+		setCurrentStepIndex(Math.max(0, currentStepIndex - 1))
+	}, [currentStepIndex, setDirection, setCurrentStepIndex])
+
+	const handleConnectionModeSubmit = useCallback(
+		(mode: ConnectionMode) => {
+			setAccumulated(prev => ({ ...prev, connectionMode: mode }))
+			setConnectionMode(mode)
+			goNext()
+		},
+		[setConnectionMode, goNext],
+	)
+
+	const handleTargetSubmit = useCallback(
+		(platform: string, type: string) => {
+			setAccumulated(prev => ({ ...prev, platform, type }))
+			setSelectedPlatform(platform)
+			setSelectedType(type)
+			goNext()
+		},
+		[setSelectedPlatform, setSelectedType, goNext],
+	)
+
+	const handleCredentialsSubmit = useCallback(
+		(credentials: object) => {
+			setAccumulated(prev => ({ ...prev, credentials }))
+			goNext()
+		},
+		[goNext],
+	)
+
+	const handleFinalSubmit = useCallback(async () => {
+		if (!connectionMode || !selectedPlatform || !selectedType) return
+
+		const payload = {
+			...accumulated,
+			connectionMode,
+			platform: selectedPlatform,
+			type: selectedType,
+		}
+
+		const result = pickUnionVariantByStrings(connectIntegrationMutationRequestSchema, {
+			platform: selectedPlatform,
+			connectionMode,
+		}).safeParse(payload)
+
+		if (!result.success) {
+			toast.error(t('common.validationError'))
+			return
+		}
+
+		await connect.mutateAsync({ data: result.data })
+	}, [connectionMode, selectedPlatform, selectedType, accumulated, connect, t])
+
+	// Progress bar — use the full sequence for the selected mode, or CREDENTIALS as default
+	const fullSteps = connectionMode ? STEP_SEQUENCES[connectionMode] : CREDENTIALS_STEPS
+	const progress = Math.round(((currentStepIndex + 1) / fullSteps.length) * 100)
+
+	const stepComponents: Record<ConnectStepId, ReactNode> = {
+		CONNECTION_MODE: (
+			<ConnectionModeStep
+				onSubmit={handleConnectionModeSubmit}
+				isSubmitting={connect.isPending}
+			/>
+		),
+		TARGET: (
+			<TargetStep
+				connectionMode={connectionMode!}
+				onSubmit={handleTargetSubmit}
+				onBack={goBack}
+				isSubmitting={connect.isPending}
+			/>
+		),
+		CREDENTIALS: (
+			<CredentialsStep
+				platform={selectedPlatform!}
+				onSubmit={handleCredentialsSubmit}
+				onBack={goBack}
+				isSubmitting={connect.isPending}
+			/>
+		),
+		REVIEW: (
+			<ReviewStep
+				accumulated={accumulated}
+				selectedPlatform={selectedPlatform}
+				selectedConnectionMode={connectionMode}
+				selectedType={selectedType}
+				onSubmit={handleFinalSubmit}
+				onBack={goBack}
+				isSubmitting={connect.isPending}
+			/>
+		),
+	}
+
+	return (
+		<div className={cn('flex flex-col gap-6', className)} {...props}>
+			<div className="h-1 w-full rounded-full bg-border overflow-hidden">
+				<div
+					className="h-full rounded-full bg-primary transition-all duration-300"
+					style={{ width: `${progress}%` }}
+				/>
+			</div>
+			{stepComponents[currentStep]}
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx b/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx
new file mode 100644
index 000000000..039eba9d1
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx
@@ -0,0 +1,91 @@
+import { useState, type ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Button } from '@/components/ui/button'
+import { IconArrowRight } from '@tabler/icons-react'
+import { Spinner } from '@/components/ui/spinner'
+import {
+	connectIntegrationMutationRequestSchema,
+	ConnectionModeEnum,
+	type ConnectionMode,
+} from '@template/client-typescript/typescript'
+import { unionVariantValues } from '@/lib/union'
+import { cn } from '@/lib/utils'
+
+// The onboarding launches with these four targets only; derive available modes from
+// the union discriminant and then restrict to what the initial targets support.
+const ALL_MODES = unionVariantValues(connectIntegrationMutationRequestSchema, 'connectionMode')
+const ONBOARDING_MODES = ALL_MODES.filter(
+	(m): m is ConnectionMode =>
+		m === ConnectionModeEnum.CREDENTIALS || m === ConnectionModeEnum.MANUAL,
+)
+
+const MODE_ICONS: Record<ConnectionMode, string> = {
+	[ConnectionModeEnum.CREDENTIALS]: '🔑',
+	[ConnectionModeEnum.MANUAL]: '📋',
+	[ConnectionModeEnum.OAUTH]: '🔐',
+}
+
+// Static typed keys — no template literal for non-enum copy (bp-25)
+const MODE_DESCRIPTION_KEYS: Record<ConnectionMode, string> = {
+	[ConnectionModeEnum.CREDENTIALS]: 'onboarding.connectionMode.credentialsDescription',
+	[ConnectionModeEnum.MANUAL]: 'onboarding.connectionMode.manualDescription',
+	[ConnectionModeEnum.OAUTH]: 'onboarding.connectionMode.oauthDescription',
+}
+
+interface ConnectionModeStepProps extends ComponentProps<'div'> {
+	onSubmit: (mode: ConnectionMode) => void
+	isSubmitting?: boolean
+}
+
+export function ConnectionModeStep({ onSubmit, isSubmitting, className, ...props }: ConnectionModeStepProps) {
+	const { t } = useTranslation()
+	const [selected, setSelected] = useState<ConnectionMode | undefined>(undefined)
+
+	return (
+		<div className={cn('flex flex-col gap-8', className)} {...props}>
+			<div className="text-center">
+				<h1 className="text-3xl font-bold tracking-tight">{t('onboarding.welcome.title')}</h1>
+				<p className="text-muted-foreground mt-2">{t('onboarding.welcome.subtitle')}</p>
+			</div>
+
+			<div className="flex flex-col gap-4">
+				<p className="text-sm font-medium text-foreground">{t('onboarding.connectionMode.title')}</p>
+				<p className="text-sm text-muted-foreground">{t('onboarding.connectionMode.subtitle')}</p>
+				<div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
+					{ONBOARDING_MODES.map(mode => (
+						<button
+							key={mode}
+							type="button"
+							onClick={() => setSelected(mode)}
+							className={cn(
+								'flex flex-col gap-2 rounded-xl border p-4 text-left transition-all',
+								'hover:border-primary/50 hover:bg-muted/30',
+								selected === mode
+									? 'border-primary bg-primary/5 ring-1 ring-primary'
+									: 'border-border bg-background',
+							)}
+						>
+							<span className="text-2xl">{MODE_ICONS[mode] ?? '🔗'}</span>
+							<span className="font-medium">{t(`enums.ConnectionMode.${mode}`)}</span>
+							<span className="text-xs text-muted-foreground">
+								{t(MODE_DESCRIPTION_KEYS[mode])}
+							</span>
+						</button>
+					))}
+				</div>
+			</div>
+
+			<div className="flex justify-end">
+				<Button
+					type="button"
+					disabled={!selected || isSubmitting}
+					onClick={() => selected && onSubmit(selected)}
+				>
+					{isSubmitting && <Spinner className="mr-2" />}
+					{t('common.next')}
+					<IconArrowRight className="ml-1 size-4" />
+				</Button>
+			</div>
+		</div>
+	)
+}
