+import { type ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useForm } from '@tanstack/react-form'
+import { Button } from '@/components/ui/button'
+import { Field, FieldLabel, FieldError, FieldGroup } from '@/components/ui/field'
+import { Input } from '@/components/ui/input'
+import { IconArrowRight, IconArrowLeft } from '@tabler/icons-react'
+import { Spinner } from '@/components/ui/spinner'
+import { connectIntegrationMutationRequestSchema } from '@template/client-typescript/typescript'
+import { pickUnionVariantField } from '@/lib/union'
+import type { DeepPartial } from '@/lib'
+import { cn } from '@/lib/utils'
+import type { z } from 'zod/v4'
+
+// ─── Shopify credentials ─────────────────────────────────────────────────────
+
+const shopifyCredentialsSchema = pickUnionVariantField(
+	connectIntegrationMutationRequestSchema,
+	{ platform: 'SHOPIFY', connectionMode: 'CREDENTIALS' },
+	'credentials',
+)
+type ShopifyCredentials = z.infer<typeof shopifyCredentialsSchema>
+
+interface ShopifyCredentialsFormProps {
+	defaultValues?: DeepPartial<ShopifyCredentials>
+	onSubmit: (credentials: ShopifyCredentials) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+function ShopifyCredentialsForm({ defaultValues, onSubmit, onBack, isSubmitting }: ShopifyCredentialsFormProps) {
+	const { t } = useTranslation()
+	const defaults: DeepPartial<ShopifyCredentials> = defaultValues ?? {}
+	const form = useForm({
+		defaultValues: defaults,
+		validators: { onChange: shopifyCredentialsSchema },
+		onSubmit: async ({ value }) => {
+			const result = shopifyCredentialsSchema.safeParse(value)
+			if (!result.success) return
+			onSubmit(result.data)
+		},
+	})
+
+	return (
+		<form
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+			className="flex flex-col gap-6"
+		>
+			<FieldGroup>
+				<form.Field name="shopDomain">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.shopDomain')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									placeholder="mystore.myshopify.com"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+				<form.Field name="clientId">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.clientId')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+				<form.Field name="clientSecret">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.clientSecret')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="password"
+									autoComplete="new-password"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+			</FieldGroup>
+
+			<form.Subscribe selector={state => ({ canSubmit: state.canSubmit, isSubmitting: state.isSubmitting, values: state.values })}>
+				{({ canSubmit, isSubmitting: formSubmitting, values }) => {
+					const isPending = formSubmitting || isSubmitting
+					const isDisabled = !canSubmit || isPending || !shopifyCredentialsSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<div>
+								{onBack && (
+									<Button type="button" variant="outline" onClick={onBack} disabled={isPending}>
+										<IconArrowLeft className="mr-1 size-4" />
+										{t('common.back')}
+									</Button>
+								)}
+							</div>
+							<Button type="submit" disabled={isDisabled}>
+								{isPending && <Spinner className="mr-2" />}
+								{t('common.next')}
+								<IconArrowRight className="ml-1 size-4" />
+							</Button>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+// ─── Yampi credentials ────────────────────────────────────────────────────────
+
+const yampiCredentialsSchema = pickUnionVariantField(
+	connectIntegrationMutationRequestSchema,
+	{ platform: 'YAMPI', connectionMode: 'CREDENTIALS' },
+	'credentials',
+)
+type YampiCredentials = z.infer<typeof yampiCredentialsSchema>
+
+interface YampiCredentialsFormProps {
+	defaultValues?: DeepPartial<YampiCredentials>
+	onSubmit: (credentials: YampiCredentials) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+function YampiCredentialsForm({ defaultValues, onSubmit, onBack, isSubmitting }: YampiCredentialsFormProps) {
+	const { t } = useTranslation()
+	const defaults: DeepPartial<YampiCredentials> = defaultValues ?? {}
+	const form = useForm({
+		defaultValues: defaults,
+		validators: { onChange: yampiCredentialsSchema },
+		onSubmit: async ({ value }) => {
+			const result = yampiCredentialsSchema.safeParse(value)
+			if (!result.success) return
+			onSubmit(result.data)
+		},
+	})
+
+	return (
+		<form
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+			className="flex flex-col gap-6"
+		>
+			<FieldGroup>
+				<form.Field name="alias">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.alias')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+				<form.Field name="userToken">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.userToken')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="text"
+									autoComplete="off"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+				<form.Field name="userSecretKey">
+					{field => {
+						const isInvalid = field.state.meta.isTouched && !field.state.meta.isValid
+						return (
+							<Field>
+								<FieldLabel htmlFor={field.name}>{t('onboarding.credentials.userSecretKey')}</FieldLabel>
+								<Input
+									id={field.name}
+									type="password"
+									autoComplete="new-password"
+									value={field.state.value ?? ''}
+									onBlur={field.handleBlur}
+									onChange={e => field.handleChange(e.target.value)}
+									aria-invalid={isInvalid}
+								/>
+								{isInvalid && <FieldError errors={field.state.meta.errors} />}
+							</Field>
+						)
+					}}
+				</form.Field>
+			</FieldGroup>
+
+			<form.Subscribe selector={state => ({ canSubmit: state.canSubmit, isSubmitting: state.isSubmitting, values: state.values })}>
+				{({ canSubmit, isSubmitting: formSubmitting, values }) => {
+					const isPending = formSubmitting || isSubmitting
+					const isDisabled = !canSubmit || isPending || !yampiCredentialsSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<div>
+								{onBack && (
+									<Button type="button" variant="outline" onClick={onBack} disabled={isPending}>
+										<IconArrowLeft className="mr-1 size-4" />
+										{t('common.back')}
+									</Button>
+								)}
+							</div>
+							<Button type="submit" disabled={isDisabled}>
+								{isPending && <Spinner className="mr-2" />}
+								{t('common.next')}
+								<IconArrowRight className="ml-1 size-4" />
+							</Button>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
+
+// ─── Dispatch ─────────────────────────────────────────────────────────────────
+
+// Map each platform to its concrete credential form — dispatch by map (CMP-P18)
+const CREDENTIAL_FORMS: Record<string, React.ComponentType<{ defaultValues?: DeepPartial<object>; onSubmit: (creds: object) => void; onBack?: () => void; isSubmitting?: boolean }>> = {
+	SHOPIFY: ShopifyCredentialsForm as React.ComponentType<{ defaultValues?: DeepPartial<object>; onSubmit: (creds: object) => void; onBack?: () => void; isSubmitting?: boolean }>,
+	YAMPI: YampiCredentialsForm as React.ComponentType<{ defaultValues?: DeepPartial<object>; onSubmit: (creds: object) => void; onBack?: () => void; isSubmitting?: boolean }>,
+}
+
+// ─── CredentialsStep ──────────────────────────────────────────────────────────
+
+interface CredentialsStepProps extends ComponentProps<'div'> {
+	platform: string
+	onSubmit: (credentials: object) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+export function CredentialsStep({ platform, onSubmit, onBack, isSubmitting, className, ...props }: CredentialsStepProps) {
+	const { t } = useTranslation()
+	const CredentialForm = CREDENTIAL_FORMS[platform]
+
+	if (!CredentialForm) return null
+
+	return (
+		<div className={cn('flex flex-col gap-8', className)} {...props}>
+			<div className="text-center">
+				<h2 className="text-2xl font-semibold tracking-tight">{t('onboarding.credentials.title')}</h2>
+				<p className="text-muted-foreground mt-2">{t('onboarding.credentials.subtitle')}</p>
+			</div>
+			<CredentialForm onSubmit={onSubmit} onBack={onBack} isSubmitting={isSubmitting} />
+		</div>
+	)
+}
