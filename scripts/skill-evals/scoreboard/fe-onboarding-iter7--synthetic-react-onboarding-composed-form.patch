+import { type ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Button } from '@/components/ui/button'
+import { IconArrowLeft, IconCheck } from '@tabler/icons-react'
+import { Spinner } from '@/components/ui/spinner'
+import {
+	connectIntegrationMutationRequestSchema,
+	type ConnectionMode,
+} from '@template/client-typescript/typescript'
+import { pickUnionVariantByStrings } from '@/lib/union'
+import { cn } from '@/lib/utils'
+
+// Static platform display keys — no template-literal dispatch (bp-25)
+const PLATFORM_DISPLAY_KEYS: Record<string, string> = {
+	SHOPIFY: 'onboarding.target.shopifyName',
+	YAMPI: 'onboarding.target.yampiName',
+	META: 'onboarding.target.metaName',
+	MERCADOPAGO: 'onboarding.target.mercadopagoName',
+}
+
+const TYPE_DISPLAY_KEYS: Record<string, string> = {
+	SALES_CHANNEL: 'onboarding.review.typeSalesChannel',
+	CHECKOUT: 'onboarding.review.typeCheckout',
+	PAYMENT_GATEWAY: 'onboarding.review.typePaymentGateway',
+	MARKETING_PLATFORM: 'onboarding.review.typeMarketingPlatform',
+}
+
+const CONNECTION_MODE_DISPLAY_KEYS: Record<string, string> = {
+	CREDENTIALS: 'enums.ConnectionMode.CREDENTIALS',
+	MANUAL: 'enums.ConnectionMode.MANUAL',
+	OAUTH: 'enums.ConnectionMode.OAUTH',
+}
+
+interface ReviewRowProps {
+	label: string
+	value: string
+}
+
+function ReviewRow({ label, value }: ReviewRowProps) {
+	return (
+		<div className="flex justify-between gap-4 py-3 border-b border-border/50 last:border-0">
+			<span className="text-sm text-muted-foreground">{label}</span>
+			<span className="text-sm font-medium">{value}</span>
+		</div>
+	)
+}
+
+interface ReviewStepProps extends ComponentProps<'div'> {
+	accumulated: Record<string, unknown>
+	selectedPlatform: string | undefined
+	selectedConnectionMode: ConnectionMode | undefined
+	selectedType: string | undefined
+	onSubmit: () => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+export function ReviewStep({
+	accumulated,
+	selectedPlatform,
+	selectedConnectionMode,
+	selectedType,
+	onSubmit,
+	onBack,
+	isSubmitting,
+	className,
+	...props
+}: ReviewStepProps) {
+	const { t } = useTranslation()
+
+	// Gate submit: the fully assembled payload must parse against the matched union member
+	const isValid =
+		selectedPlatform && selectedConnectionMode
+			? pickUnionVariantByStrings(connectIntegrationMutationRequestSchema, {
+					platform: selectedPlatform,
+					connectionMode: selectedConnectionMode,
+				}).safeParse(accumulated).success
+			: false
+
+	return (
+		<div className={cn('flex flex-col gap-8', className)} {...props}>
+			<div className="text-center">
+				<h2 className="text-2xl font-semibold tracking-tight">{t('onboarding.review.title')}</h2>
+				<p className="text-muted-foreground mt-2">{t('onboarding.review.subtitle')}</p>
+			</div>
+
+			<div
+				className={cn(
+					'rounded-xl border border-border/60 bg-background/50 px-4',
+				)}
+			>
+				{selectedPlatform && (
+					<ReviewRow
+						label={t('onboarding.review.platform')}
+						value={t(PLATFORM_DISPLAY_KEYS[selectedPlatform] ?? selectedPlatform)}
+					/>
+				)}
+				{selectedType && (
+					<ReviewRow
+						label={t('onboarding.review.type')}
+						value={t(TYPE_DISPLAY_KEYS[selectedType] ?? selectedType)}
+					/>
+				)}
+				{selectedConnectionMode && (
+					<ReviewRow
+						label={t('onboarding.review.connectionMode')}
+						value={t(CONNECTION_MODE_DISPLAY_KEYS[selectedConnectionMode] ?? selectedConnectionMode)}
+					/>
+				)}
+			</div>
+
+			<div className="flex justify-between">
+				<div>
+					{onBack && (
+						<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+							<IconArrowLeft className="mr-1 size-4" />
+							{t('common.back')}
+						</Button>
+					)}
+				</div>
+				<Button type="button" disabled={!isValid || isSubmitting} onClick={onSubmit}>
+					{isSubmitting ? <Spinner className="mr-2" /> : <IconCheck className="mr-1 size-4" />}
+					{t('onboarding.review.connect')}
+				</Button>
+			</div>
+		</div>
+	)
+}
