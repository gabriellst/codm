@@ -0,0 +1,90 @@
+import { injectable } from 'tsyringe-neo'
+import { eq } from 'drizzle-orm'
+import { DrizzleClient, tryCatchAsync } from '@template/core-typescript'
+import { storeVisualization } from '@template/contracts/db'
+import { StoreVisualization, StoreVisualizationSchema } from '@ui/entities'
+import type { DashboardMode } from '@ui/enums'
+import { StoreVisualizationRepository } from './StoreVisualizationRepository'
+
+@injectable()
+export class DrizzleStoreVisualizationRepository extends StoreVisualizationRepository {
+	constructor(private db: DrizzleClient) {
+		super()
+	}
+
+	async findById(id: string, tx?: DrizzleClient): Promise<StoreVisualization | undefined> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient.select().from(storeVisualization).where(eq(storeVisualization.id, id)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async findByStoreId(storeId: string, tx?: DrizzleClient): Promise<StoreVisualization | undefined> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const rows = await dbClient.select().from(storeVisualization).where(eq(storeVisualization.storeId, storeId)).limit(1)
+			return rows[0]
+		})
+		if (!result.success || !result.data) return undefined
+		return this.toDomain(result.data)
+	}
+
+	async save(entity: StoreVisualization, tx?: DrizzleClient): Promise<StoreVisualization> {
+		entity.incrementVersion()
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			const data = this.toPersistence(entity)
+			await dbClient
+				.insert(storeVisualization)
+				.values(data)
+				.onConflictDoUpdate({
+					target: storeVisualization.storeId,
+					set: {
+						dashboardMode: data.dashboardMode,
+						updatedAt: new Date(),
+						version: data.version,
+					},
+				})
+			return entity
+		})
+		if (!result.success) throw result.error
+		return result.data
+	}
+
+	async delete(id: string, tx?: DrizzleClient): Promise<void> {
+		const dbClient = tx ?? this.db
+		const result = await tryCatchAsync(async () => {
+			await dbClient.delete(storeVisualization).where(eq(storeVisualization.id, id))
+		})
+		if (!result.success) throw result.error
+	}
+
+	private toDomain(row: typeof storeVisualization.$inferSelect): StoreVisualization {
+		// Raw primitives — the entity schema's z.instance(...) transform constructs the VOs.
+		const parsed = StoreVisualizationSchema.parse({
+			storeId: row.storeId,
+			dashboardMode: row.dashboardMode as DashboardMode,
+		})
+		return new StoreVisualization({
+			...parsed,
+			id: row.id,
+			createdAt: row.createdAt,
+			updatedAt: row.updatedAt,
+			version: row.version,
+		})
+	}
+
+	private toPersistence(entity: StoreVisualization): typeof storeVisualization.$inferInsert {
+		return {
+			id: entity.id.value,
+			storeId: entity.storeId.value,
+			dashboardMode: entity.dashboardMode,
+			createdAt: entity.createdAt,
+			updatedAt: entity.updatedAt,
+			version: entity.version,
+		}
+	}
+}
