+import { injectable } from 'tsyringe-neo'
+import type { Transaction } from '@template/core-typescript'
+import { StoreVisualization } from '@ui/entities'
+import { StoreVisualizationRepository } from './StoreVisualizationRepository'
+
+@injectable()
+export class MockStoreVisualizationRepository extends StoreVisualizationRepository {
+	private records = new Map<string, StoreVisualization>()
+
+	async findById(id: string, _tx?: Transaction): Promise<StoreVisualization | undefined> {
+		return this.records.get(id)
+	}
+
+	async findByStoreId(storeId: string, _tx?: Transaction): Promise<StoreVisualization | undefined> {
+		return [...this.records.values()].find(v => v.storeId.value === storeId)
+	}
+
+	async save(entity: StoreVisualization, _tx?: Transaction): Promise<StoreVisualization> {
+		this.records.set(entity.id.value, entity)
+		return entity
+	}
+
+	async delete(id: string, _tx?: Transaction): Promise<void> {
+		this.records.delete(id)
+	}
+
+	seed(entity: StoreVisualization): void {
+		this.records.set(entity.id.value, entity)
+	}
+
+	clear(): void {
+		this.records.clear()
+	}
+}
