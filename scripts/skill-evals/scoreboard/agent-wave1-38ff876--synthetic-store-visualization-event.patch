diff --git a/packages/api/typescript/src/ui/repositories/StoreVisualizationRepository/DrizzleStoreVisualizationRepository.ts b/packages/api/typescript/src/ui/repositories/StoreVisualizationRepository/DrizzleStoreVisualizationRepository.ts
