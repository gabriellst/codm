+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { container, type DependencyContainer } from 'tsyringe-neo'
+import { TestBed, testId } from '@test/support'
+import { DomainEventRepository } from '@template/core-typescript'
+import { SetStoreVisualization } from './SetStoreVisualization'
+import { StoreVisualizationRepository } from '../repositories/StoreVisualizationRepository'
+import { StoreVisualizationUpdatedEvent } from '../events'
+import { DashboardMode } from '../enums'
+
+describe('SetStoreVisualization', () => {
+	let testBed: TestBed
+	let testContainer: DependencyContainer
+	let useCase: SetStoreVisualization
+	let repo: StoreVisualizationRepository
+
+	beforeAll(async () => {
+		testContainer = container.createChildContainer()
+		testBed = await TestBed.create('integration', { testContainer, ownerId: 'integration-tenant' })
+		useCase = testBed.resolve(SetStoreVisualization)
+		repo = testBed.resolve(StoreVisualizationRepository)
+	})
+	beforeEach(async () => {
+		await testBed.reset()
+	})
+	afterAll(async () => {
+		await testBed.destroy()
+	})
+
+	async function readEvents() {
+		return testBed.resolve(DomainEventRepository).findByType(StoreVisualizationUpdatedEvent)
+	}
+
+	it('first set creates the row and emits ui.store_visualization.updated', async () => {
+		const storeId = testId('store', '1')
+
+		const result = await useCase.execute({ storeId, dashboardMode: DashboardMode.NATIONAL })
+		expect(result).toEqual({ storeId, dashboardMode: DashboardMode.NATIONAL })
+
+		const persisted = await repo.findByStoreId(storeId)
+		expect(persisted?.dashboardMode).toBe(DashboardMode.NATIONAL)
+
+		const evts = await readEvents()
+		expect(evts).toHaveLength(1)
+		expect(evts[0]!.payload).toEqual({ storeId, dashboardMode: DashboardMode.NATIONAL })
+	})
+
+	it('second set upserts the same row (no duplicate) and emits again with the new mode', async () => {
+		const storeId = testId('store', '2')
+
+		await useCase.execute({ storeId, dashboardMode: DashboardMode.NATIONAL })
+		await useCase.execute({ storeId, dashboardMode: DashboardMode.GLOBAL })
+
+		const persisted = await repo.findByStoreId(storeId)
+		expect(persisted?.dashboardMode).toBe(DashboardMode.GLOBAL)
+
+		const evts = await readEvents()
+		expect(evts).toHaveLength(2)
+		expect(evts[1]!.payload).toEqual({ storeId, dashboardMode: DashboardMode.GLOBAL })
+	})
+
+	it('rejects a value outside the DashboardMode enum', async () => {
+		await expect(useCase.execute({ storeId: testId('store', '3'), dashboardMode: 'SIDEWAYS' as DashboardMode })).rejects.toMatchObject({
+			name: 'VALIDATION_ERROR',
+		})
+	})
+})
