+import { pgSchema, uuid, text, timestamp, integer, uniqueIndex } from 'drizzle-orm/pg-core'
+
+/**
+ * `ui` is the BFF context's own schema — read-side preferences the UI persists
+ * for itself, never canonical domain state.
+ *
+ * Tables:
+ *   - `store_visualization` — per-store dashboard visualization mode
+ */
+export const uiSchema = pgSchema('ui')
+
+export const storeVisualization = uiSchema.table(
+	'store_visualization',
+	{
+		id: uuid('id').primaryKey().defaultRandom(),
+
+		// The store this preference belongs to — one row per store.
+		storeId: uuid('store_id').notNull(),
+
+		// DashboardMode context enum (GLOBAL | NATIONAL). Stored as text (repo
+		// convention, never pgEnum); the enum is context-local to api-ts `ui`, so
+		// the column stays untyped here (contracts never imports from api).
+		dashboardMode: text('dashboard_mode').notNull(),
+
