+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { container, type DependencyContainer } from 'tsyringe-neo'
+import { TestBed } from '@test/support'
+import { testId } from '@test/support'
+import { StoreVisualizationRepository } from './StoreVisualizationRepository'
+import { StoreVisualization } from '../../entities/StoreVisualization'
+import { DashboardMode } from '../../enums'
+
+describe('DrizzleStoreVisualizationRepository', () => {
+	let testBed: TestBed
+	let testContainer: DependencyContainer
+	let repository: StoreVisualizationRepository
+
+	beforeAll(async () => {
+		testContainer = container.createChildContainer()
+		testBed = await TestBed.create('integration', { testContainer, ownerId: 'integration-tenant' })
+		repository = testBed.resolve(StoreVisualizationRepository)
+	})
+	beforeEach(async () => {
+		await testBed.reset()
+	})
+	afterAll(async () => {
+		await testBed.destroy()
+	})
+
+	it('saves and retrieves by id', async () => {
+		const entity = StoreVisualization.create({ storeId: testId('store', '1'), dashboardMode: DashboardMode.NATIONAL })
+		await repository.save(entity)
+		const found = await repository.findById(entity.id.value)
+		expect(found?.id.value).toBe(entity.id.value)
+		expect(found?.dashboardMode).toBe(DashboardMode.NATIONAL)
+	})
+
+	it('retrieves by storeId and upserts on conflict (one row per store)', async () => {
+		const storeId = testId('store', '2')
+		await repository.save(StoreVisualization.create({ storeId }))
+
+		const found = await repository.findByStoreId(storeId)
+		expect(found?.dashboardMode).toBe(DashboardMode.GLOBAL)
+
+		found!.changeMode(DashboardMode.NATIONAL)
+		await repository.save(found!)
+
+		const reloaded = await repository.findByStoreId(storeId)
+		expect(reloaded?.dashboardMode).toBe(DashboardMode.NATIONAL)
+	})
+
+	it('returns undefined for unknown id', async () => {
+		const found = await repository.findById(testId())
+		expect(found).toBeUndefined()
+	})
+})
