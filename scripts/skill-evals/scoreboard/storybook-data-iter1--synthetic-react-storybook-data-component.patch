+import type { Meta, StoryObj } from '@storybook/react'
+import { listCostCountriesQueryOptions } from '@template/client-typescript/typescript'
+import type { ListCostCountriesQueryResponse } from '@template/client-typescript/typescript'
+
+import { connected, errorQuery, loadingQuery, mockQuery } from '@/storybook'
+import type { DeepPartial } from '@/lib'
+
+import { costsSearchSchema } from '../../index'
+import { useProductCostsStore } from '../../-stores/useProductCostsStore'
+import { CostFormSection } from '.'
+
+// ---------------------------------------------------------------------------
+// Mock data
+// ---------------------------------------------------------------------------
+const MOCK_COUNTRIES: DeepPartial<ListCostCountriesQueryResponse> = {
+	countries: [
+		{ code: 'BR', withCostCount: 12, total: 30 },
+		{ code: 'US', withCostCount: 5, total: 20 },
+		{ code: 'AR', withCostCount: 0, total: 8 },
+		{ code: 'CL', withCostCount: 3, total: 10 },
+		{ code: 'MX', withCostCount: 7, total: 15 },
+	],
+}
+
+const listQueryOptions = listCostCountriesQueryOptions()
+
+function givenStores(stores: { selectedIds: string[] }) {
+	useProductCostsStore.setState({ selectedIds: stores.selectedIds })
+}
+
+// ---------------------------------------------------------------------------
+// Meta
+// ---------------------------------------------------------------------------
+const meta: Meta<typeof CostFormSection> = {
+	title: 'CustosDeProduto/CostFormSection',
+	component: CostFormSection,
+	parameters: connected({
+		layout: 'padded',
+		route: {
+			id: '/(app)/products/costs/',
+			validateSearch: search => costsSearchSchema.parse(search ?? {}),
+		},
+	}),
+	beforeEach() {
+		givenStores({ selectedIds: ['prod-001', 'prod-002'] })
+		return () => useProductCostsStore.setState({ selectedIds: [] })
+	},
+	decorators: [
+		Story => (
+			<div className="w-[360px]">
+				<Story />
+			</div>
+		),
+	],
+}
+export default meta
+type Story = StoryObj<typeof CostFormSection>
+
+/** Default — countries loaded, 2 products pre-selected so the scope toggle is active. */
+export const Default: Story = {
+	parameters: {
+		msw: { handlers: [mockQuery(listQueryOptions, MOCK_COUNTRIES)] },
+	},
+}
+
+/** Loading — country selector shows skeleton while the query resolves. */
+export const Loading: Story = {
+	parameters: {
+		msw: { handlers: [loadingQuery(listQueryOptions)] },
+	},
+}
+
+/** Error — countries query fails (400); form renders without the country selector. */
+export const ErrorState: Story = {
+	parameters: {
+		msw: { handlers: [errorQuery(listQueryOptions, 400)] },
+	},
+}
