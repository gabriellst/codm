+import { createFileRoute } from '@tanstack/react-router'
+import { endOfDay, startOfDay, subDays } from 'date-fns'
+import { z } from 'zod'
+import { chartTypeSchema } from '@template/client-typescript/typescript'
+
+import { zodValidator } from '@/lib/zod-validator'
+
+import { ChartReportSection } from './-components/ChartReportSection'
+
+// chartType, startDate, endDate are bookmarkable — they live in the URL.
+// tenancyScope is an account-level global store (not URL state).
+// frequency is fixed at DAILY for v1.
+export const reportsSearchSchema = z.object({
+	chartType: chartTypeSchema.default('income'),
+	startDate: z.string().default(() => startOfDay(subDays(new Date(), 29)).toISOString()),
+	endDate: z.string().default(() => endOfDay(new Date()).toISOString()),
+})
+
+export type ReportsSearch = z.infer<typeof reportsSearchSchema>
+
+export const Route = createFileRoute('/(app)/reports/')({
+	staticData: { breadcrumb: 'Relatórios de Vendas' },
+	validateSearch: zodValidator(reportsSearchSchema),
+	component: RouteComponent,
+})
+
+function RouteComponent() {
+	return (
+		<div className="flex flex-1 flex-col gap-6 overflow-y-auto p-6 md:p-8">
+			<ChartReportSection />
+		</div>
+	)
+}
