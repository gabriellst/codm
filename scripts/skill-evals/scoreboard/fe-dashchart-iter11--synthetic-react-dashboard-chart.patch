diff --git a/packages/app/react/src/routes/(app)/reports/-components/ChartReportSection/ReportTable.tsx b/packages/app/react/src/routes/(app)/reports/-components/ChartReportSection/ReportTable.tsx
new file mode 100644
index 000000000..dc63de911
--- /dev/null
+++ b/packages/app/react/src/routes/(app)/reports/-components/ChartReportSection/ReportTable.tsx
@@ -0,0 +1,95 @@
+import type { ComponentProps } from 'react'
+import type { Money, SignedMoney } from '@template/client-typescript/typescript'
+import { Empty, EmptyHeader, EmptyTitle } from '@/components/ui/empty'
+import { cn } from '@/lib/utils'
+
+export interface ReportRow {
+	label: string
+	revenue: SignedMoney
+	profit: SignedMoney | null
+	orders: number
+}
+
+/** SignedMoney is structurally identical to Money but Kubb emits separate types; convert explicitly. */
+export function toMoney(s: SignedMoney): Money {
+	return { amountCents: s.amountCents, currency: s.currency }
+}
+
+interface DataRowProps {
+	row: ReportRow
+	maxRevenueCents: number
+	formatMoney: (m: Money) => string
+	showProfit: boolean
+}
+
+function DataRow({ row, maxRevenueCents, formatMoney, showProfit }: DataRowProps) {
+	const barPct = maxRevenueCents > 0 ? Math.max(0, row.revenue.amountCents) / maxRevenueCents : 0
+
+	return (
+		<div role="listitem" aria-label={row.label} className="flex items-center gap-3 py-2 border-b border-border/50 last:border-0">
+			<span className="w-28 shrink-0 text-sm text-foreground truncate">{row.label}</span>
+			<div className="flex-1 h-1.5 rounded-full bg-muted overflow-hidden" aria-hidden>
+				<div className="h-full rounded-full bg-primary/80 transition-all duration-300" style={{ width: `${barPct * 100}%` }} />
+			</div>
+			<span className="w-28 shrink-0 text-right text-sm text-foreground tabular-nums">{formatMoney(toMoney(row.revenue))}</span>
+			{showProfit ? (
+				<span
+					className={cn(
+						'w-24 shrink-0 text-right text-sm tabular-nums',
+						row.profit !== null ? (row.profit.amountCents >= 0 ? 'text-success' : 'text-destructive') : 'text-muted-foreground',
+					)}
+				>
+					{row.profit !== null ? formatMoney(toMoney(row.profit)) : '—'}
+				</span>
+			) : null}
+			<span className="w-14 shrink-0 text-right text-sm text-muted-foreground tabular-nums">{row.orders}</span>
+		</div>
+	)
+}
+
+export interface ReportTableHeaders {
+	label: string
+	revenue: string
+	profit: string | null
+	orders: string
+}
+
+interface ReportTableProps extends ComponentProps<'div'> {
+	rows: ReportRow[]
+	formatMoney: (m: Money) => string
+	headers: ReportTableHeaders
+	emptyMessage: string
+}
+
+export function ReportTable({ rows, formatMoney, headers, emptyMessage, className, ...props }: ReportTableProps) {
+	const showProfit = headers.profit !== null
+	const maxRevenueCents = Math.max(...rows.map(r => r.revenue.amountCents), 0)
+
+	if (rows.length === 0) {
+		return (
+			<Empty>
+				<EmptyHeader>
+					<EmptyTitle>{emptyMessage}</EmptyTitle>
+				</EmptyHeader>
+			</Empty>
+		)
+	}
+
+	return (
+		<div className={cn('flex flex-col', className)} {...props}>
+			<div className="flex items-center gap-3 pb-2 border-b border-border text-xs font-medium text-muted-foreground">
+				<span className="w-28 shrink-0">{headers.label}</span>
+				<span className="flex-1" />
+				<span className="w-28 shrink-0 text-right">{headers.revenue}</span>
+				{showProfit ? <span className="w-24 shrink-0 text-right">{headers.profit}</span> : null}
+				<span className="w-14 shrink-0 text-right">{headers.orders}</span>
+			</div>
+			<div role="list" aria-label="report rows">
+				{rows.map((row, i) => (
+					<DataRow key={`${row.label}-${i}`} row={row} maxRevenueCents={maxRevenueCents} formatMoney={formatMoney} showProfit={showProfit} />
+				))}
+			</div>
+		</div>
+	)
+}
