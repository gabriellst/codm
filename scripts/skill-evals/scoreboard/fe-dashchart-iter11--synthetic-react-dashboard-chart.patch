+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import {
+	AnalyticsFrequencyEnum,
+	ChartTypeEnum,
+	useGetChart,
+} from '@template/client-typescript/typescript'
+import { useMoney } from '@/hooks'
+import { useTenancyStore } from '@/stores'
+import { Skeleton } from '@/components/ui/skeleton'
+import { cn } from '@/lib/utils'
+import { ReportTable } from './ReportTable'
+import type { ReportRow } from './ReportTable'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+const PERIOD_ORDER = ['MORNING', 'AFTERNOON', 'EVENING', 'NIGHT'] as const
+
+function LoadingSkeleton({ className, ...props }: ComponentProps<'div'>) {
+	return (
+		<div className={cn('flex flex-col gap-2', className)} aria-hidden {...props}>
+			{Array.from({ length: 8 }).map((_, i) => (
+				<Skeleton key={`sk-${i}`} className="h-10 w-full rounded-md" />
+			))}
+		</div>
+	)
+}
+
+export function PeriodVariant({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const formatMoney = useMoney()
+	const { tenancyScope } = useTenancyStore()
+	const { startDate, endDate } = routeApi.useSearch()
+
+	const { data, isPending, isError } = useGetChart({
+		chartType: ChartTypeEnum.period,
+		tenancyScope,
+		frequency: AnalyticsFrequencyEnum.DAILY,
+		startDate,
+		endDate,
+	})
+
+	if (isPending) return <LoadingSkeleton className={className} {...props} />
+	if (isError || !data || data.kind !== 'period') {
+		return (
+			<div className={cn('py-4', className)} {...props}>
+				<p className="text-sm text-muted-foreground">{t('reports.loadError')}</p>
+			</div>
+		)
+	}
+
+	// Literal t() keys — type-checked; each key must exist in both locale files
+	const PERIOD_LABELS: Record<(typeof PERIOD_ORDER)[number], string> = {
+		MORNING: t('reports.period.morning'),
+		AFTERNOON: t('reports.period.afternoon'),
+		EVENING: t('reports.period.evening'),
+		NIGHT: t('reports.period.night'),
+	}
+
+	const rows: ReportRow[] = PERIOD_ORDER.map(key => {
+		const seg = data.segments[key]
+		return {
+			label: PERIOD_LABELS[key],
+			revenue: seg.revenue,
+			profit: seg.profit,
+			orders: seg.orders,
+		}
+	})
+
+	return (
+		<ReportTable
+			rows={rows}
+			formatMoney={formatMoney}
+			headers={{
+				label: t('reports.table.shift'),
+				revenue: t('reports.table.revenue'),
+				profit: t('reports.table.profit'),
+				orders: t('reports.table.orders'),
+			}}
+			emptyMessage={t('reports.empty')}
+			className={className}
+			{...props}
+		/>
+	)
+}
