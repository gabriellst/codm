@@ -0,0 +1,97 @@
+import type { ComponentProps, ComponentType } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { ChartTypeEnum, type ChartType } from '@template/client-typescript/typescript'
+
+import { Card } from '@/components/ui/card'
+import { GradientIconBadge } from '@/components/ui/gradient-icon-badge'
+import { BarGraphIcon } from '@/components/ui/icons'
+import { Select } from '@/components/ui/select'
+import { DatePicker } from '@/components/ui/date-picker'
+import { cn } from '@/lib/utils'
+
+import { IncomeVariant } from './IncomeVariant'
+import { WeekdayVariant } from './WeekdayVariant'
+import { HourVariant } from './HourVariant'
+import { PeriodVariant } from './PeriodVariant'
+import { RegionVariant } from './RegionVariant'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+// ─── Variant dispatch map (CMP-P18) ─────────────────────────────────────────
+// Each variant owns its own useGetChart query — no data passed as props (bp-02).
+const VARIANT_MAP: Record<ChartType, ComponentType> = {
+	[ChartTypeEnum.income]: IncomeVariant,
+	[ChartTypeEnum.weekday]: WeekdayVariant,
+	[ChartTypeEnum.hour]: HourVariant,
+	[ChartTypeEnum.period]: PeriodVariant,
+	[ChartTypeEnum.region]: RegionVariant,
+}
+
+// ─── Section ─────────────────────────────────────────────────────────────────
+
+export function ChartReportSection({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const navigate = routeApi.useNavigate()
+	const { chartType, startDate, endDate } = routeApi.useSearch()
+
+	function handleChartTypeChange(v: ChartType) {
+		void navigate({ search: prev => ({ ...prev, chartType: v }) })
+	}
+
+	function handleDateRangeChange(range: { from?: Date; to?: Date } | undefined) {
+		void navigate({
+			search: prev => ({
+				...prev,
+				startDate: range?.from ? range.from.toISOString() : prev.startDate,
+				endDate: range?.to ? range.to.toISOString() : prev.endDate,
+			}),
+		})
+	}
+
+	const VariantComponent = VARIANT_MAP[chartType]
+
+	return (
+		<Card className={cn('flex flex-col gap-6 p-6', className)} {...props}>
+			{/* Header — always visible */}
+			<div className="flex flex-wrap items-center gap-3">
+				<GradientIconBadge icon={BarGraphIcon} />
+				<h1 className="flex-1 text-xl font-semibold text-foreground">{t('reports.title')}</h1>
+			</div>
+
+			{/* Controls — always visible while data loads */}
+			<div className="flex flex-wrap items-center gap-3">
+				<div className="flex items-center gap-2">
+					<span className="text-sm text-muted-foreground">{t('reports.recorte.label')}</span>
+					{/* enum mode: derives options + labels from ChartTypeEnum + i18nPrefix (bp-09, bp-23) */}
+					<Select
+						enum={ChartTypeEnum}
+						i18nPrefix="enums.ChartType"
+						value={chartType}
+						onValueChange={handleChartTypeChange}
+						className="w-44"
+					/>
+				</div>
+
+				<DatePicker
+					mode="range"
+					range={
+						startDate || endDate
+							? {
+									from: startDate ? new Date(startDate) : undefined,
+									to: endDate ? new Date(endDate) : undefined,
+								}
+							: undefined
+					}
+					onRangeChange={handleDateRangeChange}
+					placeholder={t('reports.dateRange')}
+					size="sm"
+					variant="outline"
+				/>
+			</div>
+
+			{/* Data-dependent area — each variant owns its query + loading state */}
+			<VariantComponent />
+		</Card>
+	)
+}
