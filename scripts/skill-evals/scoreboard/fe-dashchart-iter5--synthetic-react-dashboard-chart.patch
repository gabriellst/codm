@@ -0,0 +1,39 @@
+import { createFileRoute } from '@tanstack/react-router'
+import { endOfDay, startOfDay, subDays } from 'date-fns'
+import { ChartTypeEnum, chartTypeSchema, getChartQueryParamsSchema } from '@template/client-typescript/typescript'
+import { z } from 'zod'
+
+import { RouteError } from '@/components/RouteError'
+
+import { ReportChartSection } from './-components/ReportChartSection'
+
+// chartType + startDate + endDate live in URL (bookmarkable / shareable per team link).
+// tenancyScope → app-global store (never URL).
+// frequency → fixed at DAILY for v1 (never URL).
+// Defaults: last 30 days, recorte = income.
+export const reportsSearchSchema = getChartQueryParamsSchema
+	.omit({ tenancyScope: true, frequency: true, startDate: true, endDate: true, chartType: true })
+	.and(
+		z.object({
+			chartType: chartTypeSchema.default(ChartTypeEnum.income),
+			startDate: z.string().default(() => startOfDay(subDays(new Date(), 29)).toISOString()),
+			endDate: z.string().default(() => endOfDay(new Date()).toISOString()),
+		}),
+	)
+
+export type ReportsSearch = z.infer<typeof reportsSearchSchema>
+
+export const Route = createFileRoute('/(app)/reports/')({
+	staticData: { breadcrumb: 'Relatórios' },
+	validateSearch: (search) => reportsSearchSchema.parse(search ?? {}),
+	errorComponent: RouteError,
+	component: RouteComponent,
+})
+
+function RouteComponent() {
+	return (
+		<div className="flex flex-1 flex-col gap-6 overflow-y-auto p-6 md:p-8">
+			<ReportChartSection />
+		</div>
+	)
+}
