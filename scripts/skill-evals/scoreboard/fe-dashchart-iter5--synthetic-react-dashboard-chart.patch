+	if (isError) {
+		return (
+			<div className={cn('py-12 text-center', className)} {...props}>
+				<p className="text-sm text-muted-foreground">{t('reports.loadError')}</p>
+			</div>
+		)
+	}
+
+	if (!data || data.kind !== ChartTypeEnum.region || Object.keys(data.regions).length === 0) {
+		return (
+			<Empty className={className} {...props}>
+				<EmptyHeader>
+					<EmptyTitle>{t('reports.empty.title')}</EmptyTitle>
+					<EmptyDescription>{t('reports.empty.description')}</EmptyDescription>
+				</EmptyHeader>
+			</Empty>
+		)
+	}
+
+	const rows = Object.entries(data.regions).sort(
+		([, a], [, b]) => Math.abs(b.total.amountCents) - Math.abs(a.total.amountCents),
+	)
+	const maxTotal = Math.max(...rows.map(([, r]) => Math.abs(r.total.amountCents)), 1)
+
+	return (
+		<div className={cn('flex flex-col gap-0', className)} {...props}>
+			<div className="grid grid-cols-[1fr_9rem_5rem] gap-x-3 px-3 pb-2 text-xs font-medium text-muted-foreground">
+				<span>{t('reports.columns.region')}</span>
+				<span className="text-right">{t('reports.columns.total')}</span>
+				<span className="text-right">{t('reports.columns.orders')}</span>
+			</div>
+			<div role="list" aria-label={t('reports.listAria')}>
+				{rows.map(([key, region]) => {
+					const barPct = (Math.abs(region.total.amountCents) / maxTotal) * 100
+					const label = region.state ? `${region.state}, ${region.country}` : region.country || key
+					return (
+						<div
+							key={key}
+							role="listitem"
+							className="relative grid grid-cols-[1fr_9rem_5rem] gap-x-3 border-b px-3 py-2.5 last:border-0"
+						>
+							<div
+								className="absolute inset-y-0 left-0 rounded bg-primary/8"
+								style={{ width: `${barPct}%` }}
+								aria-hidden="true"
+							/>
+							<span className="relative text-sm text-muted-foreground">{label}</span>
+							<span className="relative text-right text-sm font-medium tabular-nums">
+								{formatMoney(region.total)}
+							</span>
+							<span className="relative text-right text-xs tabular-nums text-muted-foreground">
+								{region.orders}
+							</span>
+						</div>
+					)
+				})}
+			</div>
+		</div>
+	)
+}
