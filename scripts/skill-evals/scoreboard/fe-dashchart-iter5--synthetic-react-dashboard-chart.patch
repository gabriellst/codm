@@ -0,0 +1,103 @@
+import type { ComponentProps } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { AnalyticsFrequencyEnum, ChartTypeEnum, useGetChart } from '@template/client-typescript/typescript'
+
+import { Skeleton } from '@/components/ui/skeleton'
+import { Empty, EmptyDescription, EmptyHeader, EmptyTitle } from '@/components/ui/empty'
+import { cn } from '@/lib/utils'
+import { useLocale, useMoney } from '@/hooks'
+import { useTenancyStore } from '@/stores'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+export function IncomeVariant({ className, ...props }: ComponentProps<'div'>) {
+	const { t } = useTranslation()
+	const locale = useLocale()
+	const formatMoney = useMoney()
+	const { startDate, endDate } = routeApi.useSearch()
+	const tenancyScope = useTenancyStore((s) => s.tenancyScope)
+
+	const { data, isPending, isError } = useGetChart({
+		chartType: ChartTypeEnum.income,
+		tenancyScope,
+		frequency: AnalyticsFrequencyEnum.DAILY,
+		startDate,
+		endDate,
+	})
+
+	if (isPending) {
+		return (
+			<div className={cn('flex flex-col gap-2', className)} aria-busy="true" {...props}>
+				{Array.from({ length: 8 }, (_, i) => (
+					<Skeleton key={i} className="h-10 w-full" />
+				))}
+			</div>
+		)
+	}
+
+	if (isError) {
+		return (
+			<div className={cn('py-12 text-center', className)} {...props}>
+				<p className="text-sm text-muted-foreground">{t('reports.loadError')}</p>
+			</div>
+		)
+	}
+
+	if (!data || data.kind !== ChartTypeEnum.income || data.buckets.length === 0) {
+		return (
+			<Empty className={className} {...props}>
+				<EmptyHeader>
+					<EmptyTitle>{t('reports.empty.title')}</EmptyTitle>
+					<EmptyDescription>{t('reports.empty.description')}</EmptyDescription>
+				</EmptyHeader>
+			</Empty>
+		)
+	}
+
+	const { buckets } = data
+	const maxRevenue = Math.max(...buckets.map((b) => Math.abs(b.revenue.amountCents)), 1)
+
+	return (
+		<div className={cn('flex flex-col gap-0', className)} {...props}>
+			<div className="grid grid-cols-[1fr_9rem_9rem_5rem] gap-x-3 px-3 pb-2 text-xs font-medium text-muted-foreground">
+				<span>{t('reports.columns.label')}</span>
+				<span className="text-right">{t('reports.columns.revenue')}</span>
+				<span className="text-right">{t('reports.columns.profit')}</span>
+				<span className="text-right">{t('reports.columns.orders')}</span>
+			</div>
+			<div role="list" aria-label={t('reports.listAria')}>
+				{buckets.map((bucket) => {
+					const barPct = (Math.abs(bucket.revenue.amountCents) / maxRevenue) * 100
+					const dateLabel = new Date(bucket.timestamp).toLocaleDateString(locale, {
+						month: 'short',
+						day: 'numeric',
+					})
+					return (
+						<div
+							key={bucket.timestamp}
+							role="listitem"
+							className="relative grid grid-cols-[1fr_9rem_9rem_5rem] gap-x-3 border-b px-3 py-2.5 last:border-0"
+						>
+							<div
+								className="absolute inset-y-0 left-0 rounded bg-primary/8"
+								style={{ width: `${barPct}%` }}
+								aria-hidden="true"
+							/>
+							<span className="relative text-sm text-muted-foreground">{dateLabel}</span>
+							<span className="relative text-right text-sm font-medium tabular-nums">
+								{formatMoney(bucket.revenue)}
+							</span>
+							<span className="relative text-right text-sm tabular-nums text-success">
+								{formatMoney(bucket.profit)}
+							</span>
+							<span className="relative text-right text-xs tabular-nums text-muted-foreground">
+								{bucket.orders}
+							</span>
+						</div>
+					)
+				})}
+			</div>
+		</div>
+	)
+}
