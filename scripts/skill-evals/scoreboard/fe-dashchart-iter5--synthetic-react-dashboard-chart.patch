+import { useMemo, type ComponentProps, type FC } from 'react'
+import { useTranslation } from 'react-i18next'
+import { getRouteApi } from '@tanstack/react-router'
+import { ChartTypeEnum } from '@template/client-typescript/typescript'
+import type { ChartType } from '@template/client-typescript/typescript'
+
+import { Card } from '@/components/ui/card'
+import { Select } from '@/components/ui/select'
+import { cn } from '@/lib/utils'
+import { useLocale } from '@/hooks'
+
+import { IncomeVariant } from './IncomeVariant'
+import { WeekdayVariant } from './WeekdayVariant'
+import { HourVariant } from './HourVariant'
+import { PeriodVariant } from './PeriodVariant'
+import { RegionVariant } from './RegionVariant'
+
+const routeApi = getRouteApi('/(app)/reports/')
+
+// Each variant owns its own useGetChart call — React Query deduplicates the request.
+const VARIANT_MAP: Record<ChartType, FC> = {
+	[ChartTypeEnum.income]: IncomeVariant,
+	[ChartTypeEnum.weekday]: WeekdayVariant,
+	[ChartTypeEnum.hour]: HourVariant,
+	[ChartTypeEnum.period]: PeriodVariant,
+	[ChartTypeEnum.region]: RegionVariant,
+}
+
+export function ReportChartSection({ className, ...props }: ComponentProps<'section'>) {
+	const { t } = useTranslation()
+	const locale = useLocale()
+	const navigate = routeApi.useNavigate()
+	const { chartType, startDate, endDate } = routeApi.useSearch()
+
+	// Dates come from the schema's default() — always valid ISO strings.
+	const dateRangeLabel = useMemo(() => {
+		const start = new Date(startDate).toLocaleDateString(locale, { month: 'short', day: 'numeric' })
+		const end = new Date(endDate).toLocaleDateString(locale, { month: 'short', day: 'numeric' })
+		return `${start} – ${end}`
+	}, [startDate, endDate, locale])
+
+	const VariantComponent = VARIANT_MAP[chartType]
+
+	return (
+		<section className={cn('flex flex-col gap-4', className)} aria-label={t('reports.title')} {...props}>
+			{/* Header — always visible while variant data loads */}
+			<div className="flex items-center justify-between gap-3">
+				<h1 className="text-2xl font-bold text-foreground">{t('reports.title')}</h1>
+				<div className="flex items-center gap-3">
+					<Select
+						enum={ChartTypeEnum}
+						i18nPrefix="reports.recorte"
+						value={chartType}
+						onValueChange={(v) => navigate({ search: (prev) => ({ ...prev, chartType: v }) })}
+						aria-label={t('reports.recorteSelectorAria')}
+					/>
+					<span className="text-sm text-muted-foreground">{dateRangeLabel}</span>
+				</div>
+			</div>
+
+			{/* Data area — variant owns its own query + skeleton + empty state */}
+			<Card className="p-6">
+				<VariantComponent />
+			</Card>
+		</section>
+	)
+}
