@@ -0,0 +1,171 @@
+import { Pressable, View } from 'react-native'
+import { useRouter } from 'expo-router'
+import { useTranslation } from 'react-i18next'
+import { useQueryClient } from '@tanstack/react-query'
+import { Haptics } from 'react-native-nitro-haptics'
+import {
+	NotificationCategoryEnum,
+	listNotificationsQueryKey,
+	useMarkNotificationRead,
+	type NotificationCategory,
+} from '@template/client-typescript/typescript'
+import { Text } from '@/components/ui/Text'
+import { IconCheck, IconTrophy, IconClose, IconBolt, IconCalendar, IconUser, IconChart, IconTrend, type IconProps } from '@/components/ui/Icons'
+import { cn } from '@/lib/utils'
+import { formatRelativeHistoryDate } from '@/lib/format-date'
+import type { NotificationItem } from '../NotificationListSection'
+
+interface CategoryStyle {
+	Icon: React.FC<IconProps>
+	color: string
+	bgColor: string
+}
+
+// Module-level, exhaustive, no ?? fallback — one entry per enum value.
+const categoryStyles: Record<NotificationCategory, CategoryStyle> = {
+	[NotificationCategoryEnum.ORDER_RECEIVED]: {
+		Icon: IconTrophy,
+		color: '#4ade80',
+		bgColor: 'rgba(74,222,128,0.12)',
+	},
+	[NotificationCategoryEnum.SYNC_ERROR]: {
+		Icon: IconClose,
+		color: '#ff453a',
+		bgColor: 'rgba(255,69,58,0.12)',
+	},
+	[NotificationCategoryEnum.FEATURE_ANNOUNCEMENT]: {
+		Icon: IconBolt,
+		color: '#3b82f6',
+		bgColor: 'rgba(59,130,246,0.12)',
+	},
+	[NotificationCategoryEnum.DAILY_DIGEST]: {
+		Icon: IconCalendar,
+		color: '#f59e0b',
+		bgColor: 'rgba(245,158,11,0.12)',
+	},
+	[NotificationCategoryEnum.INTEGRATION_DISCONNECTED]: {
+		Icon: IconTrend,
+		color: '#dc2626',
+		bgColor: 'rgba(220,38,38,0.12)',
+	},
+	[NotificationCategoryEnum.INVITATION]: {
+		Icon: IconUser,
+		color: '#a855f7',
+		bgColor: 'rgba(168,85,247,0.12)',
+	},
+	[NotificationCategoryEnum.OTHER]: {
+		Icon: IconChart,
+		color: '#6f6f76',
+		bgColor: 'rgba(111,111,118,0.12)',
+	},
+} as const
+
+interface NotificationRowProps {
+	notification: NotificationItem
+}
+
+export function NotificationRow({ notification }: NotificationRowProps) {
+	const { t, i18n } = useTranslation()
+	const router = useRouter()
+	const queryClient = useQueryClient()
+	const markRead = useMarkNotificationRead()
+
+	const { Icon, color, bgColor } = categoryStyles[notification.category]
+
+	const handleMarkRead = async () => {
+		if (notification.read) return
+		await markRead.mutateAsync(
+			{ data: { notificationDeliveryIds: [notification.id] } },
+			{
+				onSuccess: () => Haptics.notification('success'),
+				onSettled: () =>
+					queryClient.invalidateQueries({ queryKey: listNotificationsQueryKey() }),
+			},
+		)
+	}
+
+	const handleRowPress = () => {
+		router.push({
+			pathname: '/(sheets)/notification-detail',
+			params: { id: notification.id },
+		})
+	}
+
+	const dateLabel = formatRelativeHistoryDate({
+		isoDate: notification.createdAt,
+		t,
+		language: i18n.language,
+	})
+
+	return (
+		<Pressable
+			onPress={handleRowPress}
+			accessibilityRole="button"
+			accessibilityLabel={notification.title}
+			className={cn(
+				'flex-row items-start gap-3 rounded-xl p-4',
+				notification.read ? 'bg-card' : 'bg-card border border-border-strong',
+			)}
+		>
+			{/* Unread indicator dot */}
+			{!notification.read && (
+				<View className="absolute top-3 right-3 w-2 h-2 rounded-full bg-primary" />
+			)}
+
+			{/* Category icon */}
+			<View
+				className="w-9 h-9 rounded-lg items-center justify-center flex-shrink-0"
+				style={{ backgroundColor: bgColor }}
+			>
+				<Icon size={18} color={color} />
+			</View>
+
+			{/* Content */}
+			<View className="flex-1 gap-0.5">
+				<View className="flex-row items-center justify-between">
+					<Text
+						className={cn(
+							'font-sans-semi text-sm flex-1 mr-2',
+							notification.read ? 'text-muted-foreground' : 'text-foreground',
+						)}
+						numberOfLines={1}
+					>
+						{notification.title}
+					</Text>
+					<Text className="text-foreground-subtle font-sans text-xs flex-shrink-0">
+						{dateLabel}
+					</Text>
+				</View>
+
+				<Text
+					className="text-muted-foreground font-sans text-xs"
+					numberOfLines={2}
+				>
+					{notification.message}
+				</Text>
+
+				{/* Category label */}
+				<Text className="text-foreground-subtle font-sans-semi text-xs mt-1">
+					{t(`enums.notificationCategory.${notification.category}`)}
+				</Text>
+			</View>
+
+			{/* Mark-as-read button */}
+			{!notification.read && (
+				<Pressable
+					onPress={e => {
+						e.stopPropagation?.()
+						void handleMarkRead()
+					}}
+					accessibilityRole="button"
+					accessibilityLabel={t('notifications.markAsRead')}
+					hitSlop={8}
+					disabled={markRead.isPending}
+					className="flex-shrink-0 mt-0.5"
+				>
+					<IconCheck size={18} color={markRead.isPending ? '#44444a' : '#4ade80'} />
+				</Pressable>
+			)}
+		</Pressable>
+	)
+}
