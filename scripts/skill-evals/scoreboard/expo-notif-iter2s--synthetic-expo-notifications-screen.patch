@@ -0,0 +1,147 @@
+import { useMemo } from 'react'
+import { Pressable, ScrollView, View } from 'react-native'
+import { useTranslation } from 'react-i18next'
+import { z } from 'zod'
+import {
+	NotificationCategoryEnum,
+	useListNotifications,
+	type ListNotifications200,
+	type NotificationCategory,
+} from '@template/client-typescript/typescript'
+import { Text } from '@/components/ui/Text'
+import { EmptyState } from '@/components/ui/EmptyState'
+import { ScreenError } from '@/components/ui/ScreenError'
+import { ToggleRow } from '@/components/ui/ToggleRow'
+import { cn } from '@/lib/utils'
+import { useTypedSearchParams } from '@/lib/typed-route'
+import { NotificationRow } from '../NotificationRow'
+
+export type NotificationItem = ListNotifications200['items'][number]
+
+// URL-validated filter schema. Every field has a safe fallback so garbage
+// deep-link params render defaults, never crash.
+export const notificationsSearchSchema = z.object({
+	category: z
+		.enum(Object.values(NotificationCategoryEnum) as [NotificationCategory, ...NotificationCategory[]])
+		.optional(),
+	// URL params arrive as strings; coerce "true"/"false" explicitly.
+	unreadOnly: z
+		.string()
+		.optional()
+		.transform(v => v === 'true'),
+})
+
+export type NotificationsSearchParams = z.infer<typeof notificationsSearchSchema>
+
+function SkeletonRows() {
+	return (
+		<View className="flex-col gap-3 px-5">
+			{[1, 2, 3, 4, 5].map(key => (
+				<View key={key} className="h-20 rounded-xl bg-card/50" />
+			))}
+		</View>
+	)
+}
+
+export function NotificationListSection() {
+	const { t } = useTranslation()
+	const [{ category, unreadOnly }, setParams] = useTypedSearchParams(notificationsSearchSchema)
+
+	const { data, error, refetch } = useListNotifications(
+		unreadOnly ? { unreadOnly: true } : undefined,
+	)
+
+	const filtered = useMemo<NotificationItem[] | undefined>(() => {
+		if (!data) return undefined
+		if (!category) return data.items
+		return data.items.filter(n => n.category === category)
+	}, [data, category])
+
+	const categories = Object.values(NotificationCategoryEnum) as NotificationCategory[]
+
+	if (error) return <ScreenError onRetry={() => void refetch()} />
+
+	return (
+		<ScrollView
+			contentContainerStyle={{ paddingBottom: 110, paddingTop: 8 }}
+			contentInsetAdjustmentBehavior="automatic"
+			showsVerticalScrollIndicator={false}
+			className="flex-1"
+		>
+			{/* Category filter chips */}
+			<ScrollView
+				horizontal
+				showsHorizontalScrollIndicator={false}
+				contentContainerStyle={{ paddingHorizontal: 20, gap: 8, paddingBottom: 12 }}
+				className="flex-grow-0"
+			>
+				<Pressable
+					onPress={() => setParams({ category: undefined })}
+					accessibilityRole="button"
+					accessibilityLabel={t('notifications.filterAll')}
+					className={cn(
+						'rounded-full px-4 py-1.5 border',
+						!category ? 'bg-foreground border-foreground' : 'bg-transparent border-border-strong',
+					)}
+				>
+					<Text
+						className={cn(
+							'font-sans-semi text-xs',
+							!category ? 'text-background' : 'text-muted-foreground',
+						)}
+					>
+						{t('notifications.filterAll')}
+					</Text>
+				</Pressable>
+				{categories.map(cat => (
+					<Pressable
+						key={cat}
+						onPress={() => setParams({ category: category === cat ? undefined : cat })}
+						accessibilityRole="button"
+						accessibilityLabel={t(`enums.notificationCategory.${cat}`)}
+						className={cn(
+							'rounded-full px-4 py-1.5 border',
+							category === cat
+								? 'bg-foreground border-foreground'
+								: 'bg-transparent border-border-strong',
+						)}
+					>
+						<Text
+							className={cn(
+								'font-sans-semi text-xs',
+								category === cat ? 'text-background' : 'text-muted-foreground',
+							)}
+						>
+							{t(`enums.notificationCategory.${cat}`)}
+						</Text>
+					</Pressable>
+				))}
+			</ScrollView>
+
+			{/* Unread-only toggle */}
+			<View className="mx-5 mb-4">
+				<ToggleRow
+					label={t('notifications.unreadOnly')}
+					value={unreadOnly}
+					onChange={v => setParams({ unreadOnly: v })}
+				/>
+			</View>
+
+			{/* List */}
+			{filtered === undefined ? (
+				<SkeletonRows />
+			) : filtered.length === 0 ? (
+				<EmptyState
+					title={t('notifications.empty.title')}
+					body={t('notifications.empty.body')}
+				/>
+			) : (
+				<View className="flex-col gap-2 px-5">
+					{filtered.map(notification => (
+						<NotificationRow key={notification.id} notification={notification} />
+					))}
+				</View>
+			)}
+		</ScrollView>
+	)
+}
diff --git a/packages/app/expo/app/(tabs)/notifications/-components/NotificationRow/index.tsx b/packages/app/expo/app/(tabs)/notifications/-components/NotificationRow/index.tsx
