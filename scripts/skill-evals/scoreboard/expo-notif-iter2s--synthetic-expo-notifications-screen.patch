@@ -0,0 +1,155 @@
+import { Pressable, ScrollView, View } from 'react-native'
+import { router } from 'expo-router'
+import { useTranslation } from 'react-i18next'
+import { useQueryClient } from '@tanstack/react-query'
+import { z } from 'zod'
+import { Haptics } from 'react-native-nitro-haptics'
+import {
+	listNotificationsQueryKey,
+	useListNotifications,
+	useMarkNotificationRead,
+} from '@template/client-typescript/typescript'
+import { Protected } from '@/components/Protected'
+import { Text } from '@/components/ui/Text'
+import { IconClose, IconCheck } from '@/components/ui/Icons'
+import { fg, fs } from '@/lib/tokens'
+import { formatRelativeHistoryDate } from '@/lib/format-date'
+import { useTypedSearchParams } from '@/lib/typed-route'
+
+// Garbage or missing id → empty string → not-found state, never crashes.
+const detailParamsSchema = z.object({
+	id: z.string().default(''),
+})
+
+export default function NotificationDetailSheet() {
+	const { t, i18n } = useTranslation()
+	const queryClient = useQueryClient()
+	const [{ id }] = useTypedSearchParams(detailParamsSchema)
+
+	// No single-GET endpoint exists; fetch the list and find by id.
+	// React Query caches the result so warm navigations are instant;
+	// cold deep links trigger a real fetch and find the item once loaded.
+	const { data } = useListNotifications({ limit: 100 })
+	const notification = data?.items.find(n => n.id === id) ?? null
+
+	const markRead = useMarkNotificationRead()
+
+	const handleMarkRead = async () => {
+		if (!notification || notification.read) return
+		await markRead.mutateAsync(
+			{ data: { notificationDeliveryIds: [notification.id] } },
+			{
+				onSuccess: () => Haptics.notification('success'),
+				onSettled: () =>
+					queryClient.invalidateQueries({ queryKey: listNotificationsQueryKey() }),
+			},
+		)
+	}
+
+	const dateLabel =
+		notification
+			? formatRelativeHistoryDate({
+					isoDate: notification.createdAt,
+					t,
+					language: i18n.language,
+				})
+			: null
+
+	return (
+		<Protected>
+			<View className="flex-1 px-5 pt-4 pb-6">
+				{/* Header */}
+				<View className="flex-row items-center justify-between mb-4">
+					<View className="w-6" />
+					<Text
+						className="text-foreground font-sans-bold text-center flex-1"
+						style={{ fontSize: fs.headerTitle }}
+					>
+						{t('notificationDetail.title')}
+					</Text>
+					<Pressable
+						onPress={() => router.back()}
+						accessibilityRole="button"
+						accessibilityLabel={t('common.close')}
+						hitSlop={12}
+					>
+						<IconClose size={20} color={fg.fg1} />
+					</Pressable>
+				</View>
+
+				{/* Body */}
+				{!data ? (
+					// Still loading — show skeleton placeholder
+					<View className="flex-col gap-3">
+						{[1, 2, 3].map(k => (
+							<View key={k} className="h-6 rounded-lg bg-card/50" />
+						))}
+					</View>
+				) : !notification ? (
+					<View className="flex-1 items-center justify-center">
+						<Text className="text-foreground-subtle font-sans text-sm text-center">
+							{t('notificationDetail.notFound')}
+						</Text>
+					</View>
+				) : (
+					<ScrollView
+						showsVerticalScrollIndicator={false}
+						contentContainerStyle={{ gap: 16, paddingBottom: 24 }}
+					>
+						{/* Title */}
+						<Text className="text-foreground font-sans-bold text-base">
+							{notification.title}
+						</Text>
+
+						{/* Full message */}
+						<Text className="text-muted-foreground font-sans text-sm leading-relaxed">
+							{notification.message}
+						</Text>
+
+						{/* Metadata rows */}
+						<View className="bg-card rounded-xl overflow-hidden">
+							<MetaRow
+								label={t('notificationDetail.category')}
+								value={t(`enums.notificationCategory.${notification.category}`)}
+							/>
+							<View className="h-px bg-border mx-4" />
+							<MetaRow
+								label={t('notificationDetail.createdAt')}
+								value={dateLabel ?? ''}
+							/>
+							<View className="h-px bg-border mx-4" />
+							<MetaRow
+								label={t('notificationDetail.read')}
+								value={notification.read ? '✓' : '—'}
+							/>
+						</View>
+
+						{/* Mark as read */}
+						{!notification.read && (
+							<Pressable
+								onPress={() => void handleMarkRead()}
+								accessibilityRole="button"
+								disabled={markRead.isPending}
+								className="flex-row items-center justify-center gap-2 rounded-xl py-3 bg-success/10 border border-success/30"
+							>
+								<IconCheck size={16} color="#4ade80" />
+								<Text className="text-success font-sans-semi text-sm">
+									{t('notificationDetail.markAsRead')}
+								</Text>
+							</Pressable>
+						)}
+					</ScrollView>
+				)}
+			</View>
+		</Protected>
+	)
+}
+
+function MetaRow({ label, value }: { label: string; value: string }) {
+	return (
+		<View className="flex-row items-center justify-between px-4 py-3">
+			<Text className="text-foreground-subtle font-sans text-sm">{label}</Text>
+			<Text className="text-foreground font-sans-semi text-sm">{value}</Text>
+		</View>
+	)
+}
