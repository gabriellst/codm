+import { type ComponentProps } from 'react'
+import { useForm } from '@tanstack/react-form'
+import { Button } from '@/components/ui/button'
+import { type DeepPartial, cn } from '@/lib'
+import { IconArrowRight, IconArrowLeft } from '@tabler/icons-react'
+import { Spinner } from '@/components/ui/spinner'
+import { useTranslation } from 'react-i18next'
+import { z } from 'zod/v4'
+
+// ─── Onboarding targets ───────────────────────────────────────────────────────
+// Fixed (platform, type, connectionMode) tuples for the 4 onboarding targets.
+
+export const ONBOARDING_TARGETS = [
+	{ platform: 'SHOPIFY', type: 'SALES_CHANNEL', connectionMode: 'CREDENTIALS' } as const,
+	{ platform: 'YAMPI', type: 'CHECKOUT', connectionMode: 'CREDENTIALS' } as const,
+	{ platform: 'META', type: 'MARKETING_PLATFORM', connectionMode: 'MANUAL' } as const,
+	{ platform: 'MERCADOPAGO', type: 'PAYMENT_GATEWAY', connectionMode: 'MANUAL' } as const,
+]
+
+export type OnboardingTarget = (typeof ONBOARDING_TARGETS)[number]
+
+// ─── Schema ───────────────────────────────────────────────────────────────────
+
+// Named sub-enums derived from ONBOARDING_TARGETS so z.enum receives an object (bp-13)
+// and the inferred types flow as specific literals to WizardFormValues.
+type OnboardingPlatform = (typeof ONBOARDING_TARGETS)[number]['platform']
+type OnboardingType = (typeof ONBOARDING_TARGETS)[number]['type']
+
+const ONBOARDING_PLATFORM_ENUM = Object.fromEntries(
+	ONBOARDING_TARGETS.map(t => [t.platform, t.platform]),
+) as { [K in OnboardingPlatform]: K }
+
+const ONBOARDING_TYPE_ENUM = Object.fromEntries(
+	ONBOARDING_TARGETS.map(t => [t.type, t.type]),
+) as { [K in OnboardingType]: K }
+
+export const TargetStepSchema = z.object({
+	platform: z.enum(ONBOARDING_PLATFORM_ENUM),
+	type: z.enum(ONBOARDING_TYPE_ENUM),
+})
+export type TargetStepData = z.infer<typeof TargetStepSchema>
+
+// ─── Component ───────────────────────────────────────────────────────────────
+
+interface TargetStepProps extends Omit<ComponentProps<'form'>, 'onSubmit'> {
+	/** Filters shown targets to the user's chosen connection mode. */
+	connectionMode: 'CREDENTIALS' | 'MANUAL'
+	defaultValues?: DeepPartial<TargetStepData>
+	onSubmit: (data: TargetStepData) => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+export function TargetStep({ connectionMode, defaultValues, onSubmit, onBack, isSubmitting, className, ...props }: TargetStepProps) {
+	const { t } = useTranslation()
+
+	const filteredTargets = ONBOARDING_TARGETS.filter(target => target.connectionMode === connectionMode)
+
+	const form = useForm({
+		defaultValues: defaultValues ?? {},
+		validators: { onChange: TargetStepSchema },
+		onSubmit: async form => {
+			const result = TargetStepSchema.safeParse(form.value)
+			if (!result.success) return
+			onSubmit(result.data)
+		},
+	})
+
+	return (
+		<form
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+			className={cn('flex flex-col gap-6 p-2', className)}
+			{...props}
+		>
+			<div className="text-center">
+				<h2 className="text-2xl font-semibold tracking-tight">{t('onboarding.target.title')}</h2>
+				<p className="text-muted-foreground mt-2">{t('onboarding.target.subtitle')}</p>
+			</div>
+
+			<form.Field name="platform">
+				{platformField => (
+					<form.Field name="type">
+						{typeField => (
+							<div className="flex flex-col gap-3">
+								{filteredTargets.map(target => {
+									const isSelected =
+										platformField.state.value === target.platform && typeField.state.value === target.type
+									return (
+										<button
+											key={`${target.platform}:${target.type}`}
+											type="button"
+											onClick={() => {
+												platformField.handleChange(target.platform)
+												typeField.handleChange(target.type)
+											}}
+											className={cn(
+												'rounded-lg border px-4 py-3 text-left transition-colors',
+												isSelected
+													? 'border-primary bg-primary/5 ring-1 ring-primary'
+													: 'border-border hover:border-primary/50',
+											)}
+										>
+											<p className="font-medium">{t(`enums.IntegrationPlatform.${target.platform}`)}</p>
+											<p className="text-muted-foreground text-sm">
+												{t(`enums.IntegrationType.${target.type}`)}
+											</p>
+										</button>
+									)
+								})}
+							</div>
+						)}
+					</form.Field>
+				)}
+			</form.Field>
+
+			<form.Subscribe selector={state => ({ canSubmit: state.canSubmit, values: state.values })}>
+				{({ canSubmit, values }) => {
+					const isDisabled = isSubmitting || !canSubmit || !TargetStepSchema.safeParse(values).success
+					return (
+						<div className="flex justify-between">
+							<div>
+								{onBack && (
+									<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+										<IconArrowLeft className="mr-1 size-4" />
+										{t('common.back')}
+									</Button>
+								)}
+							</div>
+							<div className="flex gap-2">
+								<Button type="submit" disabled={isDisabled}>
+									{isSubmitting && <Spinner className="mr-2" />}
+									{t('common.next')}
+									<IconArrowRight className="ml-1 size-4" />
+								</Button>
+							</div>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
