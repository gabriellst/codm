@@ -0,0 +1,26 @@
+import { create } from 'zustand'
+
+interface OnboardingWizardState {
+	currentStepIndex: number
+	direction: 1 | -1
+}
+
+interface OnboardingWizardActions {
+	setCurrentStepIndex: (index: number) => void
+	setDirection: (direction: 1 | -1) => void
+	reset: () => void
+}
+
+type OnboardingWizardStore = OnboardingWizardState & OnboardingWizardActions
+
+const initialState: OnboardingWizardState = {
+	currentStepIndex: 0,
+	direction: 1,
+}
+
+export const useOnboardingWizardStore = create<OnboardingWizardStore>()(set => ({
+	...initialState,
+	setCurrentStepIndex: currentStepIndex => set({ currentStepIndex }),
+	setDirection: direction => set({ direction }),
+	reset: () => set(initialState),
+}))
