+					{onBack && (
+						<Button type="button" variant="outline" onClick={onBack} disabled={isSubmitting}>
+							<IconArrowLeft className="mr-1 size-4" />
+							{t('common.back')}
+						</Button>
+					)}
+				</div>
+				<Button type="button" disabled={!isPayloadValid || isSubmitting} onClick={onSubmit}>
+					{isSubmitting && <Spinner className="mr-2" />}
+					{t('onboarding.review.connectButton')}
+				</Button>
+			</div>
+		</div>
+	)
+}
