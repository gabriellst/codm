diff --git a/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx b/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx
new file mode 100644
index 000000000..e84b94562
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/ConnectionModeStep/index.tsx
@@ -0,0 +1,94 @@
+import { type ComponentProps } from 'react'
+import { useForm } from '@tanstack/react-form'
+import { Button } from '@/components/ui/button'
+import { FieldGroup } from '@/components/ui/field'
+import { ToggleGroup } from '@/components/ui/toggle-group'
+import { type DeepPartial, cn } from '@/lib'
+import { connectIntegrationMutationRequestSchema, ConnectionModeEnum } from '@template/client-typescript/typescript'
+import { unionVariantValues } from '@/lib'
+import { IconArrowRight } from '@tabler/icons-react'
+import { Spinner } from '@/components/ui/spinner'
+import { useTranslation } from 'react-i18next'
+import { z } from 'zod/v4'
+
+// Modes actually present in the connect-integration union (excludes OAUTH which is absent)
+const modeValues = unionVariantValues(connectIntegrationMutationRequestSchema, 'connectionMode') as (typeof ConnectionModeEnum)[keyof typeof ConnectionModeEnum][]
+
+// Named sub-enum derived from the SDK ConnectionModeEnum, restricted to what the union supports.
+// z.enum(NamedEnum) satisfies the no-inline-literal rule (bp-13).
+const OnboardingConnectionModeEnum = Object.fromEntries(modeValues.map(v => [v, v])) as Pick<
+	typeof ConnectionModeEnum,
+	'CREDENTIALS' | 'MANUAL'
+>
+
+export const ConnectionModeStepSchema = z.object({
+	connectionMode: z.enum(OnboardingConnectionModeEnum),
+})
+export type ConnectionModeStepData = z.infer<typeof ConnectionModeStepSchema>
+
+interface ConnectionModeStepProps extends Omit<ComponentProps<'form'>, 'onSubmit'> {
+	defaultValues?: DeepPartial<ConnectionModeStepData>
+	onSubmit: (data: ConnectionModeStepData) => void
+	isSubmitting?: boolean
+}
+
+export function ConnectionModeStep({ defaultValues, onSubmit, isSubmitting, className, ...props }: ConnectionModeStepProps) {
+	const { t } = useTranslation()
+
+	const form = useForm({
+		defaultValues: defaultValues ?? {},
+		validators: { onChange: ConnectionModeStepSchema },
+		onSubmit: async form => {
+			const result = ConnectionModeStepSchema.safeParse(form.value)
+			if (!result.success) return
+			onSubmit(result.data)
+		},
+	})
+
+	return (
+		<form
+			onSubmit={e => {
+				e.preventDefault()
+				e.stopPropagation()
+				form.handleSubmit()
+			}}
+			className={cn('flex flex-col gap-6 p-2', className)}
+			{...props}
+		>
+			<div className="text-center">
+				<h2 className="text-2xl font-semibold tracking-tight">{t('onboarding.connectionMode.title')}</h2>
+				<p className="text-muted-foreground mt-2">{t('onboarding.connectionMode.subtitle')}</p>
+			</div>
+
+			<FieldGroup>
+				<form.Field name="connectionMode">
+					{field => (
+						<ToggleGroup
+							enum={OnboardingConnectionModeEnum}
+							i18nPrefix="enums.ConnectionMode"
+							value={field.state.value}
+							onValueChange={field.handleChange}
+							orientation="vertical"
+							spacing={2}
+						/>
+					)}
+				</form.Field>
+			</FieldGroup>
+
+			<form.Subscribe selector={state => ({ canSubmit: state.canSubmit, values: state.values })}>
+				{({ canSubmit, values }) => {
+					const isDisabled = isSubmitting || !canSubmit || !ConnectionModeStepSchema.safeParse(values).success
+					return (
+						<div className="flex justify-end">
+							<Button type="submit" disabled={isDisabled}>
+								{isSubmitting && <Spinner className="mr-2" />}
+								{t('common.next')}
+								<IconArrowRight className="ml-1 size-4" />
+							</Button>
+						</div>
+					)
+				}}
+			</form.Subscribe>
+		</form>
+	)
+}
diff --git a/packages/app/react/src/routes/onboarding/-components/OnboardingWizard/index.tsx b/packages/app/react/src/routes/onboarding/-components/OnboardingWizard/index.tsx
new file mode 100644
index 000000000..736b33845
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/OnboardingWizard/index.tsx
@@ -0,0 +1,186 @@
+import { type ComponentProps, type ReactElement, useState } from 'react'
+import { useNavigate } from '@tanstack/react-router'
+import { useQueryClient } from '@tanstack/react-query'
+import { toast } from 'sonner'
+import { useTranslation } from 'react-i18next'
+import {
+	useConnectIntegration,
+	connectIntegrationMutationRequestSchema,
+	listPlatformDescriptorsQueryKey,
+	ConnectionModeEnum,
+} from '@template/client-typescript/typescript'
+import { cn } from '@/lib'
+import { useOnboardingWizardStore } from '../../-stores/useOnboardingWizardStore'
+import { ConnectionModeStep } from '../ConnectionModeStep'
+import { TargetStep, type TargetStepData } from '../TargetStep'
+import { ShopifyCredentialsStep } from '../ShopifyCredentialsStep'
+import { YampiCredentialsStep } from '../YampiCredentialsStep'
+import { ReviewStep, type WizardFormValues } from '../ReviewStep'
+
+// ─── Step identifiers ─────────────────────────────────────────────────────────
+
+const STEP = {
+	CONNECTION_MODE: 'CONNECTION_MODE',
+	TARGET: 'TARGET',
+	CREDENTIALS: 'CREDENTIALS',
+	REVIEW: 'REVIEW',
+} as const
+
+type Step = (typeof STEP)[keyof typeof STEP]
+
+const MODE_STEPS = {
+	[ConnectionModeEnum.CREDENTIALS]: [STEP.CONNECTION_MODE, STEP.TARGET, STEP.CREDENTIALS, STEP.REVIEW] as const,
+	[ConnectionModeEnum.MANUAL]: [STEP.CONNECTION_MODE, STEP.TARGET, STEP.REVIEW] as const,
+} as const
+
+// Platform → credentials step dispatcher (dispatch map, not if-chain — CMP-P18)
+interface CredentialStepProps {
+	defaultValues?: WizardFormValues['credentials']
+	onSubmit: (data: WizardFormValues['credentials']) => void
+	onBack?: () => void
+}
+
+const PLATFORM_CREDENTIALS_STEP: Record<string, (props: CredentialStepProps) => ReactElement> = {
+	SHOPIFY: ({ defaultValues, onSubmit, onBack }) => (
+		<ShopifyCredentialsStep defaultValues={defaultValues} onSubmit={onSubmit} onBack={onBack} />
+	),
+	YAMPI: ({ defaultValues, onSubmit, onBack }) => (
+		<YampiCredentialsStep defaultValues={defaultValues} onSubmit={onSubmit} onBack={onBack} />
+	),
+}
+
+// ─── Component ───────────────────────────────────────────────────────────────
+
+interface OnboardingWizardProps extends ComponentProps<'div'> {}
+
+export function OnboardingWizard({ className, ...props }: OnboardingWizardProps) {
+	const { t } = useTranslation()
+	const navigate = useNavigate()
+	const queryClient = useQueryClient()
+	const { currentStepIndex, setCurrentStepIndex, setDirection } = useOnboardingWizardStore()
+
+	const [formValues, setFormValues] = useState<WizardFormValues>({})
+
+	const connect = useConnectIntegration({
+		mutation: {
+			onSuccess: async () => {
+				await queryClient.invalidateQueries({ queryKey: listPlatformDescriptorsQueryKey() })
+				toast.success(t('onboarding.toast.success'), { description: t('onboarding.toast.successDescription') })
+				await navigate({ to: '/dashboard' as string })
+			},
+		},
+	})
+
+	const steps: readonly Step[] =
+		formValues.connectionMode === ConnectionModeEnum.CREDENTIALS ||
+		formValues.connectionMode === ConnectionModeEnum.MANUAL
+			? MODE_STEPS[formValues.connectionMode]
+			: MODE_STEPS[ConnectionModeEnum.CREDENTIALS]
+
+	const currentStep: Step = steps[currentStepIndex] ?? STEP.CONNECTION_MODE
+
+	const goNext = (index: number) => {
+		setDirection(1)
+		setCurrentStepIndex(index + 1)
+	}
+
+	const goBack = (index: number) => {
+		setDirection(-1)
+		setCurrentStepIndex(index - 1)
+	}
+
+	// ── Step handlers ──────────────────────────────────────────────────────────
+
+	const handleConnectionModeSubmit = (data: { connectionMode: 'CREDENTIALS' | 'MANUAL' }) => {
+		setFormValues(prev => ({
+			...prev,
+			connectionMode: data.connectionMode,
+			platform: undefined,
+			type: undefined,
+			credentials: undefined,
+		}))
+		goNext(currentStepIndex)
+	}
+
+	const handleTargetSubmit = (data: TargetStepData) => {
+		setFormValues(prev => ({ ...prev, platform: data.platform, type: data.type, credentials: undefined }))
+		goNext(currentStepIndex)
+	}
+
+	const handleCredentialsSubmit = (credentials: WizardFormValues['credentials']) => {
+		setFormValues(prev => ({ ...prev, credentials }))
+		goNext(currentStepIndex)
+	}
+
+	const handleFinalSubmit = async () => {
+		const { connectionMode, platform, type, credentials } = formValues
+		if (!connectionMode || !platform || !type) return
+
+		const result = connectIntegrationMutationRequestSchema.safeParse({
+			connectionMode,
+			platform,
+			type,
+			credentials: credentials ?? {},
+		})
+
+		if (!result.success) return
+
+		await connect.mutateAsync({ data: result.data })
+	}
+
+	// ── Render current step ───────────────────────────────────────────────────
+
+	const renderStep = () => {
+		if (currentStep === STEP.CONNECTION_MODE) {
+			return (
+				<ConnectionModeStep
+					defaultValues={formValues.connectionMode ? { connectionMode: formValues.connectionMode } : undefined}
+					onSubmit={handleConnectionModeSubmit}
+				/>
+			)
+		}
+
+		if (currentStep === STEP.TARGET && formValues.connectionMode) {
+			return (
+				<TargetStep
+					connectionMode={formValues.connectionMode}
+					defaultValues={{ platform: formValues.platform, type: formValues.type }}
+					onSubmit={handleTargetSubmit}
+					onBack={() => goBack(currentStepIndex)}
+				/>
+			)
+		}
+
+		if (currentStep === STEP.CREDENTIALS && formValues.platform) {
+			const CredentialsStep = PLATFORM_CREDENTIALS_STEP[formValues.platform]
+			if (CredentialsStep) {
+				return (
+					<CredentialsStep
+						defaultValues={formValues.credentials}
+						onSubmit={handleCredentialsSubmit}
+						onBack={() => goBack(currentStepIndex)}
+					/>
+				)
+			}
+		}
+
+		if (currentStep === STEP.REVIEW) {
+			return (
+				<ReviewStep
+					formValues={formValues}
+					onSubmit={handleFinalSubmit}
+					onBack={() => goBack(currentStepIndex)}
+					isSubmitting={connect.isPending}
+				/>
+			)
+		}
+
+		return null
+	}
+
+	return (
+		<div className={cn('flex flex-col', className)} {...props}>
+			{renderStep()}
+		</div>
+	)
+}
diff --git a/packages/app/react/src/routes/onboarding/-components/ReviewStep/index.tsx b/packages/app/react/src/routes/onboarding/-components/ReviewStep/index.tsx
new file mode 100644
index 000000000..6f31edfd6
--- /dev/null
+++ b/packages/app/react/src/routes/onboarding/-components/ReviewStep/index.tsx
@@ -0,0 +1,99 @@
+import { type ComponentProps } from 'react'
+import { Button } from '@/components/ui/button'
+import { connectIntegrationMutationRequestSchema } from '@template/client-typescript/typescript'
+import { IconArrowLeft } from '@tabler/icons-react'
+import { Spinner } from '@/components/ui/spinner'
+import { useTranslation } from 'react-i18next'
+import { cn } from '@/lib'
+import type { TargetStepData } from '../TargetStep'
+
+// ─── Types ────────────────────────────────────────────────────────────────────
+
+export interface WizardFormValues {
+	connectionMode?: 'CREDENTIALS' | 'MANUAL'
+	platform?: TargetStepData['platform']
+	type?: TargetStepData['type']
+	credentials?: Record<string, string>
+}
+
+// ─── Component ───────────────────────────────────────────────────────────────
+
+interface ReviewStepProps extends ComponentProps<'div'> {
+	/** Full accumulated wizard state — shown as summary and used as the submit payload. */
+	formValues: WizardFormValues
+	onSubmit: () => void
+	onBack?: () => void
+	isSubmitting?: boolean
+}
+
+export function ReviewStep({ formValues, onSubmit, onBack, isSubmitting, className, ...props }: ReviewStepProps) {
+	const { t } = useTranslation()
+
+	const { connectionMode, platform, type, credentials } = formValues
+
+	// Validate the fully assembled envelope against the union schema — correct tool for dynamic
+	// runtime values (pickUnionVariant is for static literal-dispatch; safeParse on the union
+	// handles any valid member regardless of which discriminant values are present).
+	const isPayloadValid =
+		!!connectionMode &&
+		!!platform &&
+		!!type &&
+		connectIntegrationMutationRequestSchema.safeParse({
+			connectionMode,
+			platform,
+			type,
+			credentials: credentials ?? {},
+		}).success
+
+	return (
