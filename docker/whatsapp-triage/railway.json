{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/whatsapp-triage/Dockerfile",
    "watchPatterns": ["packages/api/go/**", "packages/contracts/generated/go/**", "docker/whatsapp-triage/**"]
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
