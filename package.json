{
	"name": "codm",
	"description": "Polyglot fullstack monorepo template (TS+Go backends, React web + Astro landing + Tauri desktop shell, contracts-driven SDKs).",
	"author": "Template Authors",
	"license": "MIT",
	"keywords": [
		"polyglot",
		"template",
		"monorepo"
	],
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/contracts",
		"packages/contracts/generated/typescript",
		"packages/api/typescript",
		"packages/api/typescript/core",
		"packages/app/astro",
		"packages/app/react",
		"packages/app/styles",
		"packages/app/tauri",
		"packages/client",
		"packages/client/dist/typescript",
		"packages/e2e"
	],
	"scripts": {
		"build": "nx run-many -t build",
		"dev": "nx run-many -t dev -p api-typescript,api-go,app-react,app-astro --parallel=4",
		"dev:api": "nx run-many -t dev -p api-typescript,api-go --parallel=2",
		"dev:api:typescript": "nx run api-typescript:dev",
		"dev:api:go": "nx run api-go:dev",
		"dev:app:react": "nx run app-react:dev",
		"dev:app:astro": "nx run app-astro:dev",
		"desktop:dev": "nx run app-tauri:dev",
		"desktop:sidecars": "nx run app-tauri:sidecars",
		"desktop:bundle": "nx run app-tauri:bundle",
		"desktop:generate": "bun packages/app/tauri/config/generate.ts",
		"tsc": "nx run-many -t tsc",
		"test": "nx run-many -t test --exclude=e2e",
		"lint": "nx run-many -t lint",
		"e2e": "nx run e2e:test",
		"test:e2e:headed": "bun --cwd packages/e2e test:headed",
		"sdk": "nx run client:generate",
		"sdk:typescript": "nx run client:generate",
		"sdk:go": "nx run client:generate",
		"sdk:build": "nx run client:build",
		"contracts": "cd packages/contracts && bun run all",
		"testing:check-dts": "bun scripts/testing-dts.ts",
		"emit-openapi": "nx run-many -t emit-openapi",
		"migrate:create": "cd packages/contracts && bun run drizzle:generate",
		"migrate:dev": "cd packages/api/typescript && bun scripts/migrate.ts",
		"format": "bun format:biome && bun format:eslint",
		"format:biome": "bun scripts/format-biome.ts",
		"format:biome:all": "bun x biome format --write .",
		"check:biome": "bun x biome check --diagnostic-level=error .",
		"format:eslint": "bun x eslint --quiet --fix .",
		"stack:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
		"stack:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
		"stack:reset": "docker compose --env-file .env -f docker/docker-compose.yml down -v && docker compose --env-file .env -f docker/docker-compose.yml up -d",
		"stack:logs": "docker compose --env-file .env -f docker/docker-compose.yml logs -f",
		"docker:compose": "bun stack:up",
		"prepare": "git config --local core.hooksPath .githooks || true",
		"cli": "bun scripts/cli.ts",
		"review": "bun scripts/review.ts --output ./review --parallel 25",
		"review:all": "bun scripts/review.ts --all --output ./review --parallel 25",
		"detect": "bun scripts/detectors/run-all.ts",
		"detect:slice": "bun scripts/detectors/slice-closure.ts",
		"detect:baseline": "bun scripts/detectors/registry-scan.ts --update-baseline",
		"detect:self-test": "bun test ./.claude/hooks ./packages/app/tauri/config ./scripts/detectors",
		"test:tooling": "bun tsc:scripts && bun test ./.claude/hooks ./packages/app/tauri/config ./scripts/detectors ./scripts/eslint-rules ./scripts/cli ./scripts/db ./scripts/lib ./scripts/examples ./scripts/sync ./scripts/create-template ./scripts/taxonomy-parity.test.ts ./scripts/skill-examples.test.ts ./scripts/review-plan.test.ts ./scripts/skill-evals/run.test.ts ./scripts/skill-evals/validate-grader-ids.test.ts ./packages/api/typescript/tests/architecture/union-parity.test.ts",
		"tsc:scripts": "tsc -p tsconfig.scripts.json --noEmit",
		"env:generate": "bun scripts/env/generate.ts",
		"check:generated": "bun scripts/check-generated.ts",
		"og:generate": "bun scripts/og/generate.ts",
		"examples:promote": "bun scripts/examples/promote.ts",
		"sync:check": "bun scripts/sync/check.ts",
		"sync:pull": "bun scripts/sync/pull.ts"
	},
	"dependencies": {
		"react": "19",
		"react-dom": "19",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@eslint/js": "^9.38.0",
		"@nx/js": "^22.6.5",
		"@tsconfig/bun": "^1.0.9",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.9.1",
		"@types/react": "19",
		"@types/react-dom": "19",
		"@typescript-eslint/utils": "^8.46.2",
		"drizzle-orm": "^0.45.2",
		"eslint": "^9.38.0",
		"eslint-config-biome": "^2.1.3",
		"glob": "^11.0.0",
		"jiti": "^2.7.0",
		"lint-staged": "^16.2.6",
		"nx": "^22.6.5",
		"playwright": "^1.59.1",
		"ts-morph": "^24.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2",
		"yaml": "^2.6.0"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"git-commit-msg-linter"
	],
	"engines": {
		"bun": ">=1.0.0"
	}
}
