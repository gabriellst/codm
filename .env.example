# ===========================================
# template — root environment variables
# ===========================================
# GENERATED from template.config.ts REPO.env — do NOT hand-edit.
# Change the registry, then run: bun env:generate
# Single source for all workspaces; copy to .env and fill in secrets.

# ---- Project ----
PROJECT=template  # docker-compose prefix + Config.name; DATABASE_URL db name must match
SERVICE=backend  # docker-compose container prefix (${PROJECT}-${SERVICE})

# ---- Billing gateway credentials ----
# Adapters for ALL gateways ship with the template; which are ACTIVE + these secrets are the product plug.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAGARME_API_KEY=
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_PASSWORD=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PAGBANK_API_TOKEN=

# ---- Backend — kernel (api-typescript core Config) ----
NODE_ENV=development
API_PORT=3030  # api-typescript
DATABASE_URL=postgres://postgres:postgres@localhost:5432/template?sslmode=disable
REDIS_URL=redis://localhost:6379
API_EVENT_GROUP_ID=api-typescript  # outbox source tag consumed by api-typescript
API_URL=http://localhost:3030  # api-typescript public URL
API_GO_URL=http://localhost:3032  # api-go public URL (SDK aggregate client)
APP_URL=http://localhost:5173  # app-web public URL (kernel reads it for redirects/urls)
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3030/v1/authentication
JWT_SECRET=CHANGE_ME  # HMAC secret for signed tokens (e.g. invitation links)
INTERNAL_SERVICE_KEY=CHANGE_ME  # Go→TS S2S header seam (x-internal-service-key)
OPERATOR_API_KEY=  # operator endpoints (quota overrides); FAILS CLOSED when empty
CREDENTIAL_VAULT_KEY=  # AES-256 seam for AesCredentialVault — unbound in the base; a product binding the vault re-adds it to REQUIRED_SECRETS_IN_PROD
CORS_ALLOWED_ORIGINS=*  # comma-separated; '*' for dev; all backends read this key
OTEL_COLLECTOR_TRACE_URL=http://localhost:4317/v1/traces
OTEL_COLLECTOR_LOG_URL=http://localhost:4317/v1/logs
OTEL_SERVICE_NAME=api-typescript  # per-service override; go sets its own
# advanced knobs (schema defaults are sane — uncomment to override):
# RATE_LIMIT_DISABLED=false

# ---- Backend — product (ProductConfig: brand + billing policy) ----
PRODUCT_NAME=Your Product  # brand rendered in transactional emails + billing copy
BILLING_SANDBOX=true  # in-process SandboxPaymentProvider; REQUIRED for the billing e2e flow; unset = false
BILLING_DEFAULT_GATEWAY=PAGARME
BILLING_GATEWAY_PIX=
BILLING_GATEWAY_CARD=
BILLING_CHECKOUT_IMAGE_URL=  # hosted-checkout branding image; empty renders none
# advanced knobs (schema defaults are sane — uncomment to override):
# BILLING_SANDBOX_PERIOD_MS=120000
# BILLING_DUNNING_GRACE_DAYS=3
# BILLING_DUNNING_MAX_ATTEMPTS=4
# BILLING_DUNNING_RETRY_OFFSETS_DAYS=1,3,5
# BILLING_DUNNING_WINDOW_DAYS=10
# BILLING_CHARGEBACK_SCAN_DAYS=90
# BILLING_CHECKOUT_RECONCILE_AFTER_MINUTES=30
# BILLING_CHECKOUT_RECONCILE_MAX_AGE_HOURS=48
# BILLING_PENDING_RECONCILE_AFTER_MINUTES=30
# BILLING_PENDING_RECONCILE_MAX_AGE_HOURS=48
# BILLING_REFUND_DRIFT_SCAN_DAYS=30
# BILLING_REFUND_RECONCILE_MAX_AGE_HOURS=72
# BILLING_WINDOW_RECONCILE_EVERY_HOURS=6
# BILLING_WINDOW_RECONCILE_MAX_AGE_DAYS=14
# BILLING_WITHDRAWAL_WINDOW_DAYS=7

# ---- Go worker (api-go) ----
API_GO_PORT=3032  # api-go
API_GO_EVENT_GROUP_ID=api-go  # outbox source tag consumed by api-go
API_VERSION=v1  # read by api-go; api-typescript reads VERSION (defaults ok in dev)

# ---- Frontend (only VITE_* reach the browser) ----
VITE_PORT=5173  # read by the e2e harness only — vite.config.ts hardcodes 5173; keep in sync
VITE_API_URL=http://localhost:3030
