# ===========================================
# codm — root environment variables
# ===========================================
# GENERATED from template.config.ts REPO.env — do NOT hand-edit.
# Change the registry, then run: bun env:generate
# Single source for all workspaces; copy to .env and fill in secrets.

# ---- Project ----
PROJECT=codm  # docker-compose prefix + Config.name (container naming only — there is no external database)
SERVICE=backend  # docker-compose container prefix (${PROJECT}-${SERVICE})

# ---- Backend — kernel (api-typescript core Config) ----
NODE_ENV=development
API_PORT=3030  # api-typescript
CODM_DATA_DIR=~/.codm/data  # shared data dir for the real daemon; ~ expands to $HOME. BOTH sidecars open the SAME codm.db here (api-go via modernc, api-ts via libsql; whatsmeow session tables live in the same file), and both run the same idempotent migration applier on boot in whatever order they start.
REDIS_URL=redis://localhost:6379
API_EVENT_GROUP_ID=api-typescript  # outbox source tag consumed by api-typescript
API_URL=http://localhost:3030  # api-typescript public URL
API_GO_URL=http://localhost:3032  # api-go public URL (SDK aggregate client)
APP_URL=http://localhost:5173  # app-web public URL (kernel reads it for redirects/urls)
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3030/v1/authentication
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CODM_CLOUD_URL=http://localhost:3030  # cloud profile public origin (better-auth baseURL/trustedOrigins); defaults to API_URL
JWT_SECRET=CHANGE_ME  # HMAC secret for signed tokens (e.g. invitation links)
INTERNAL_SERVICE_KEY=CHANGE_ME  # Go→TS S2S header seam (x-internal-service-key)
OPERATOR_API_KEY=  # operator endpoints (quota overrides); FAILS CLOSED when empty
CREDENTIAL_VAULT_KEY=  # AES-256 seam for AesCredentialVault — unbound in the base; a product binding the vault re-adds it to REQUIRED_SECRETS_IN_PROD
CORS_ALLOWED_ORIGINS=*  # comma-separated; '*' for dev; all backends read this key
OTEL_COLLECTOR_TRACE_URL=http://localhost:4317/v1/traces
OTEL_COLLECTOR_LOG_URL=http://localhost:4317/v1/logs
OTEL_SERVICE_NAME=api-typescript  # per-service override; go sets its own
# advanced knobs (schema defaults are sane — uncomment to override):
# RATE_LIMIT_DISABLED=false

# ---- Backend — product (ProductConfig: brand + billing policy) ----
PRODUCT_NAME=Your Product  # brand rendered in transactional-email chrome (MailSender Layout header + footer)

# ---- Backend — boot flags (raw process.env, outside the Zod schemas) ----
# schema: 'raw' — read before/without Config.env by design (profile/test seams); see each entry doc.
CODM_APP_VERSION=  # versão do bundle desktop, injetada pelo shell nos sidecars
CODM_PROFILE=  # cloud profile switch — 'cloud' boots only auth+owner (baked as ENV in docker/cloud.Dockerfile; Railway-only deploy, compose aposentado 2026-08-07); unset boots the full desktop daemon

# ---- Go worker (api-go) ----
API_GO_PORT=3032  # api-go
CHANNEL_PORT=3032  # gateway HTTP port (fallback: PORT)
PORT=3030  # generic port fallback (TS honors it at runtime, outside the Config schema)
CHANNEL_ALLOWED_ORIGINS=http://localhost:5173  # gateway CORS allowlist (fallback: ALLOWED_ORIGINS)
ALLOWED_ORIGINS=http://localhost:5173  # generic CORS fallback
CHANNEL_ENVIRONMENT=DEVELOPMENT  # gateway environment (fallback: ENVIRONMENT)
ENVIRONMENT=DEVELOPMENT  # generic environment fallback
CHANNEL_EVENT_GROUP_ID=codm-gateway  # outbox source tag for the gateway
CHANNEL_GLOBAL_API_KEY=  # gateway HTTP apikey guard (TS proxy sends it server-side; fallback: GLOBAL_API_KEY)
GLOBAL_API_KEY=  # generic apikey fallback
WHATSMEOW_LOG_LEVEL=WARN  # whatsmeow client log level
CODM_E2E=  # test-only gateway ingress seam (internal/channel/testseam); refused under PRODUCTION
API_GO_EVENT_GROUP_ID=api-go  # outbox source tag consumed by api-go
API_VERSION=v1  # read by api-go; api-typescript reads VERSION (defaults ok in dev)

# ---- Frontend (only VITE_* reach the browser) ----
VITE_PORT=5173  # read by the e2e harness only — vite.config.ts hardcodes 5173; keep in sync
VITE_API_URL=http://localhost:3030
VITE_CODM_CLOUD_URL=http://localhost:3030  # cloud profile public origin the desktop console opens for OAuth sign-in (mirrors CODM_CLOUD_URL for the browser; defaults to VITE_API_URL)
SITE_URL=  # app-astro canonical origin (sitemap/RSS/canonical) at build time; MUST be set in production builds — empty falls back to http://localhost:4321

# ---- Parked (documented, no active consumer) ----
# Declared with consumers: [] on purpose — no workspace reads these yet; see each entry doc for why it is kept.
STRIPE_SECRET_KEY=  # parked — no billing code ships this SP (Decision 1); test-mode key
STRIPE_PUBLISHABLE_KEY=  # parked — no billing code ships this SP (Decision 1); test-mode key
