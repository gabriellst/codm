{
	"name": "@codm/api-typescript",
	"description": "TypeScript backend — auth, reads, projections, BFF queries",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		"./testing": {
			"types": "./testing.d.ts",
			"default": "./tests/support/testing.ts"
		}
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"smoke:node": "bun run scripts/smoke-node-boot.ts",
