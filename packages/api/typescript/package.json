		"tsc": "bun x tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@codm/client-typescript": "workspace:*",
		"@codm/contracts": "workspace:*",
		"@codm/contracts-typescript": "workspace:*",
		"@codm/core-typescript": "workspace:*",
		"@faker-js/faker": "^10.4.0",
		"better-auth": "^1.4.6",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^1.0.0",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.8.5",
		"react": "^19.0.0",
		"reflect-metadata": "^0.2.2",
		"tsyringe-neo": "^5.1.0",
		"uuidv7": "^1.2.1",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^22.18.10",
		"@types/papaparse": "^5.3.15",
		"bun-types": "^1.3.14"
	}
