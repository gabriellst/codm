{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src",
		"noEmit": true,
		"skipLibCheck": true,
		"paths": {},
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"exactOptionalPropertyTypes": false,
		"typeRoots": ["../../../../node_modules/@types", "./node_modules/@types"]
	},
	"include": ["src/**/*"],
	"exclude": ["src/__tests__/**"]
}
