{
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"name": "api-typescript",
	"sourceRoot": "packages/api/typescript/src",
	"projectType": "application",
	"targets": {
		"emit-openapi": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": [
				"{projectRoot}/src/**/*.ts",
				"!{projectRoot}/src/**/*.test.ts",
				"{projectRoot}/scripts/**/*",
				"{projectRoot}/tsconfig.json"
			],
			"outputs": ["{projectRoot}/public/docs/openapi.json"],
			"options": {
				"command": "EMIT_OPENAPI=true START_SERVER=false bun run scripts/emit-openapi.ts",
				"cwd": "packages/api/typescript"
			}
		},
		"tsc": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": [
				"{projectRoot}/src/**/*.ts",
				"{projectRoot}/tsconfig.build.json",
				"{projectRoot}/tsconfig.json"
			],
			"options": { "command": "bun x tsc -p tsconfig.build.json --noEmit", "cwd": "packages/api/typescript" }
		},
		"build": {
			"executor": "nx:run-commands",
			"cache": true,
			"dependsOn": ["tsc"],
			"inputs": ["production", "{projectRoot}/tsconfig.build.json", "sharedGlobals"],
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "bun run scripts/build.ts",
				"cwd": "packages/api/typescript"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": { "command": "bun run --watch ./src", "cwd": "packages/api/typescript" }
		},
		"test": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": [
				"{projectRoot}/src/**/*",
				"{projectRoot}/tests/**/*",
				"{projectRoot}/bunfig.toml",
				"sharedGlobals"
			],
			"options": { "command": "bun test", "cwd": "packages/api/typescript" }
		}
	}
}
