    "/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "description": "Get the current authenticated session",
        "operationId": "GetSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Get the current authenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "name": {
                          "nullable": true,
                          "type": "string"
                        },
                        "emailVerified": {
                          "type": "boolean"
                        },
                        "language": {
                          "$ref": "#/components/schemas/Language"
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "name",
                        "emailVerified"
                      ],
                      "additionalProperties": false
                    },
                    "session": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "userId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "ownerId": {
                          "nullable": true,
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "userId",
                        "expiresAt",
                        "ownerId"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "user",
                    "session"
                  ],
                  "additionalProperties": false,
                  "examples": [
                    {
                      "user": {
                        "id": "019e4d24-6524-7041-9e1c-8108180cddae",
                        "email": "user@example.com",
                        "name": "Alice",
                        "emailVerified": true
                      },
                      "session": {
                        "id": "019e4d24-6524-7041-9e1c-8108180cddaf",
                        "userId": "019e4d24-6524-7041-9e1c-8108180cddae",
                        "expiresAt": "2030-01-01T00:00:00.000Z",
                        "ownerId": null
                      }
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "value": {
                      "user": {
                        "id": "019e4d24-6524-7041-9e1c-8108180cddae",
                        "email": "user@example.com",
                        "name": "Alice",
                        "emailVerified": true
                      },
                      "session": {
                        "id": "019e4d24-6524-7041-9e1c-8108180cddaf",
                        "userId": "019e4d24-6524-7041-9e1c-8108180cddae",
                        "expiresAt": "2030-01-01T00:00:00.000Z",
                        "ownerId": null
                      }
                    },
                    "summary": "Example"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/identity/account/avatar": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "MOCK. Accept-and-echo multipart avatar upload — returns new pictureUrl",
        "operationId": "UploadAvatar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "MOCK. Accept-and-echo multipart avatar upload — returns new pictureUrl",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pictureUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "pictureUrl"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/desktop-callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "description": "Bridges a better-auth browser session into a one-time token, returned to the app over its loopback listener",
        "operationId": "DesktopCallback",
        "parameters": [
          {
            "in": "query",
            "name": "port",
            "schema": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Bridges a better-auth browser session into a one-time token, returned to the app over its loopback listener",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "<redirect>"
                  ]
                },
                "examples": {
                  "default": {
                    "value": "<redirect>",
                    "summary": "Example"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sign-in/social": {
      "get": {
        "tags": [
          "auth"
        ],
        "description": "Redireciona o browser do sistema para o provedor social escolhido, iniciando o login do desktop",
        "operationId": "SignInSocial",
        "parameters": [
          {
            "in": "query",
            "name": "provider",
            "schema": {
              "$ref": "#/components/schemas/SocialProvider"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "port",
            "schema": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Redireciona o browser do sistema para o provedor social escolhido, iniciando o login do desktop",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "<redirect>"
                  ]
                },
                "examples": {
                  "default": {
                    "value": "<redirect>",
                    "summary": "Example"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/owners": {
      "post": {
        "tags": [
          "owner"
        ],
        "description": "Create a new owner (tenant); the creator becomes the responsible user",
        "operationId": "CreateOwner",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "kind": {
                    "$ref": "#/components/schemas/OwnerKind"
                  },
                  "timezone": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pictureUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "name"
                ]
              },
              "examples": {
                "default": {
                  "value": {
                    "name": "Acme Org",
                    "kind": "ORGANIZATION",
                    "timezone": "America/Sao_Paulo",
                    "pictureUrl": "https://cdn.example.com/logo.png"
                  },
                  "summary": "Example"
                }
              }
            }
          }
        },
        "parameters": [],
        "responses": {
          "200": {
            "description": "Create a new owner (tenant); the creator becomes the responsible user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ownerId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "ownerId"
                  ],
                  "additionalProperties": false,
                  "examples": [
                    {
                      "ownerId": "019e4d24-6524-7041-9e1c-8108180cddae"
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "value": {
                      "ownerId": "019e4d24-6524-7041-9e1c-8108180cddae"
                    },
                    "summary": "Example"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/owners/settings": {
