              },
              "examples": {
                "default": {
                  "value": {
                    "name": "New Acme",
                    "pictureUrl": "https://cdn.example.com/new-logo.png",
                    "timezone": "America/Sao_Paulo"
                  },
                  "summary": "Example"
                }
              }
            }
          }
        },
        "parameters": [],
        "responses": {
          "200": {
            "description": "Update owner profile settings (name / picture / timezone)",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/owners/disable": {
      "post": {
        "tags": [
          "owner"
        ],
        "description": "Disable a owner (C19 DisableOwner; OWNER only)",
        "operationId": "DisableOwner",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              },
              "examples": {
                "default": {
                  "value": {
                    "reason": "closing for maintenance"
                  },
                  "summary": "Example"
                }
              }
            }
          }
        },
        "parameters": [],
        "responses": {
          "200": {
            "description": "Disable a owner (C19 DisableOwner; OWNER only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ownerId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "isDisabled": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ownerId",
                    "isDisabled"
                  ],
                  "additionalProperties": false,
                  "examples": [
                    {
                      "ownerId": "019e4d24-6524-7041-9e1c-8108180cddae",
                      "isDisabled": true
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "value": {
                      "ownerId": "019e4d24-6524-7041-9e1c-8108180cddae",
                      "isDisabled": true
                    },
                    "summary": "Example"
                  }
                }
              }
            }
          }
        }
      }
    },
