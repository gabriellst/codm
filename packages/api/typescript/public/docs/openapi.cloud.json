    "/owners/{ownerId}/activate": {
      "post": {
        "tags": [
          "owner"
        ],
        "description": "Switch the authenticated session to the given owner (SPEC-07 SetActiveOwner)",
        "operationId": "SetActiveOwner",
        "parameters": [
          {
            "in": "path",
            "name": "ownerId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "019e4d24-6524-7041-9e1c-8108180cddae"
          }
        ],
        "responses": {
          "200": {
            "description": "Switch the authenticated session to the given owner (SPEC-07 SetActiveOwner)",
