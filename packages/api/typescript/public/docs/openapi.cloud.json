        "description": "better-auth passthrough",
        "operationId": "AuthPassthroughGet",
        "parameters": [],
        "responses": {
          "200": {
            "description": "better-auth passthrough",
            "content": {
              "application/json": {
                "schema": {
                  "examples": [
