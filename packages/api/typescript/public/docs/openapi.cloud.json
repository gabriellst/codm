{
  "openapi": "3.0.3",
  "info": {
    "version": "1.0.0",
    "title": "codm-backend"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "shared"
        ],
        "description": "Readiness do daemon: banco, migrações e os timers de poll (canal WhatsApp entra só como diagnóstico)",
        "operationId": "Health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Readiness do daemon: banco, migrações e os timers de poll (canal WhatsApp entra só como diagnóstico)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "$ref": "#/components/schemas/Status"
                    },
                    "components": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "$ref": "#/components/schemas/Status2"
                          },
                          "gate": {
                            "type": "boolean"
                          },
                          "detail": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "status",
                          "gate"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "status",
                    "components"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/session/cloud-token": {
      "post": {
        "tags": [
          "shared"
        ],
        "description": "Push a freshly-exchanged session token into the local daemon",
        "operationId": "SetCloudToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "token"
                ]
              },
              "examples": {
                "default": {
                  "value": {
                    "token": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"
                  },
                  "summary": "Example"
                }
              }
            }
          }
        },
        "parameters": [],
        "responses": {
          "200": {
            "description": "Push a freshly-exchanged session token into the local daemon",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/sign-in/loopback": {
      "get": {
        "tags": [
          "shared"
        ],
        "description": "Loopback landing (RFC 8252): receives the one-time sign-in code from the system browser",
        "operationId": "SignInLoopback",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Loopback landing (RFC 8252): receives the one-time sign-in code from the system browser",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "<html>…</html>"
                  ]
                },
                "examples": {
                  "default": {
                    "value": "<html>…</html>",
                    "summary": "Example"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sign-in/loopback/claim": {
      "get": {
        "tags": [
          "shared"
        ],
        "description": "Claims the one-time sign-in code delivered to the loopback landing (single use)",
        "operationId": "ClaimSignInCode",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Claims the one-time sign-in code delivered to the loopback landing (single use)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "nullable": true,
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false,
                  "examples": [
                    {
                      "code": null
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "value": {
                      "code": null
                    },
                    "summary": "Example"
                  }
                }
              }
            }
          }
        }
      }
    },
