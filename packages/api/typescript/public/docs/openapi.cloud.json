      "post": {
        "tags": [
          "auth"
        ],
        "description": "better-auth passthrough",
        "operationId": "AuthPassthroughPost",
        "parameters": [],
        "responses": {
          "200": {
            "description": "better-auth passthrough",
            "content": {
              "application/json": {
                "schema": {
                  "examples": [
                    {}
                  ],
                  "x-tpl-unknown": true
                },
                "examples": {
                  "default": {
                    "value": {},
                    "summary": "Example"
                  }
                }
              }
            }
          }
        }
      }
