  "paths": {
    "/activity/entries": {
      "get": {
        "operationId": "ListActivity",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "before",
            "schema": {
              "example": "2026-07-01T12:00:00Z",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListActivityOutput"
                }
              }
            },
            "description": "OK"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the owner-scoped activity feed, newest first",
        "tags": [
          "Activity"
        ]
      }
    }
  },
