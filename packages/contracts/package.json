{
	"name": "@codedm/contracts",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./db/schema-sqlite/index.ts",
		"./db": "./db/schema-sqlite/index.ts",
		"./db/migrations": "./db/migrations.ts"
	},
	"scripts": {
		"tsp:compile": "tsp compile wire/",
		"tsp:watch": "tsp compile wire/ --watch",
		"codegen:wire:typescript": "bun codegen/emit-wire-ts.ts",
		"codegen:wire:go": "bun codegen/emit-wire-go.ts",
		"codegen:wire": "bun run codegen:wire:typescript && bun run codegen:wire:go",
		"db:sync-go": "bun ../../scripts/db/sync-sqlite-migrations.ts",
		"db:check-go": "bun ../../scripts/db/sync-sqlite-migrations.ts --check",
		"drizzle:generate": "drizzle-kit generate --config=db/schema-sqlite/drizzle.config.ts",
		"all": "bun run tsp:compile && bun run codegen:wire && bun run drizzle:generate",
		"test": "bun test codegen/"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"yaml": "^2.6.0"
	},
	"devDependencies": {
		"@typespec/compiler": "^1.5.0",
		"@typespec/openapi": "^1.5.0",
		"@typespec/openapi3": "^1.5.0",
		"drizzle-kit": "^0.31.0",
		"@codedm/contracts-typescript": "workspace:*"
	}
}
