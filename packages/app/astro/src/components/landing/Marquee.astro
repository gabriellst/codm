---
import type { CollectionEntry } from 'astro:content'

interface Props {
	t: CollectionEntry<'landing'>['data']['marquee']
}

const { t } = Astro.props
// Four copies so the -50% marquee keyframe lands exactly two set-widths in —
// a whole multiple of the pattern, i.e. a seamless loop. Copies beyond the
// first are aria-hidden (visual filler only).
const sets = [0, 1, 2, 3]
---

<div class="mx-auto mb-[100px] max-w-[1080px] overflow-hidden rounded-full bg-[var(--muted)] px-0 py-3">
	<div class="animate-marquee flex w-max">
		{
			sets.map(set => (
				<div aria-hidden={set > 0 ? 'true' : undefined} class="flex">
					{t.items.map(item => (
						<div class="flex items-center gap-4 whitespace-nowrap px-4 font-mono text-xs text-[var(--muted-foreground)]/80">
							<span>{item}</span>
							<span class="text-[var(--border)]">✳</span>
						</div>
					))}
				</div>
			))
		}
	</div>
</div>
