---
import type { CollectionEntry } from 'astro:content'

interface Props {
	t: CollectionEntry<'landing'>['data']['demo']['chat']
}

const { t } = Astro.props
---

<div
	class="rounded-[calc(var(--radius)*1.625)] border border-[var(--border)] bg-[var(--background)] p-[22px] shadow-[0_24px_60px_rgba(22,22,22,0.08)]"
>
	<div class="flex items-center gap-2.5 border-b border-[var(--muted)] pb-3.5">
		<div class="flex h-9 w-9 items-center justify-center rounded-full bg-[var(--secondary)] text-xs font-bold">
			{t.initials}
		</div>
		<div>
			<div class="text-sm font-bold">{t.name}</div>
			<div class="font-mono text-[10.5px] text-[var(--muted-foreground)]/80">{t.meta}</div>
		</div>
		<div
			class="ml-auto flex items-center gap-1.5 rounded-full bg-[var(--primary)] px-[11px] py-[5px] text-[10.5px] font-bold text-[var(--primary-foreground)]"
		>
			<span class="animate-pulse-dot-fast h-[5px] w-[5px] rounded-full bg-[var(--primary-foreground)]"></span>
			{t.status}
		</div>
	</div>
	<div class="flex flex-col gap-2.5 pt-4">
		{
			t.messages.map(message =>
				message.kind === 'in' ? (
					<div class="max-w-[85%] self-start rounded-[16px_16px_16px_5px] bg-[var(--muted)] px-3.5 py-2.5 text-[13.5px] leading-[1.45]">
						{message.text}
					</div>
				) : message.kind === 'system' ? (
					<div class="self-center font-mono text-[10px] text-[var(--muted-foreground)]/70">{message.text}</div>
				) : (
					<div class="flex max-w-[85%] flex-col items-end self-end">
						{message.label && (
							<div class="mb-[3px] mr-1.5 font-mono text-[9.5px] font-semibold text-[var(--muted-foreground)]/80">
								{message.label}
							</div>
						)}
						<div class="rounded-[16px_16px_5px_16px] bg-[var(--primary)] px-3.5 py-2.5 text-[13.5px] leading-[1.45] text-[var(--primary-foreground)]">
							{message.text}
						</div>
					</div>
				),
			)
		}
	</div>
</div>
