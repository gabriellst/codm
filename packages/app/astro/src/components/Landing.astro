---
import { getEntry } from 'astro:content'
import ClosingCta from '~/components/landing/ClosingCta.astro'
import DemoSection from '~/components/landing/DemoSection.astro'
import FeaturesSection from '~/components/landing/FeaturesSection.astro'
import Hero from '~/components/landing/Hero.astro'
import Marquee from '~/components/landing/Marquee.astro'
import RouterSection from '~/components/landing/RouterSection.astro'
import type { Locale } from '~/i18n'

interface Props {
	locale: Locale
}

// Composition root: one getEntry, typed slices down (§4.3). PricingSection is
// built (landing/PricingSection.astro) but intentionally NOT mounted — D8.
const { locale } = Astro.props
const entry = await getEntry('landing', `${locale}/landing`)
const t = entry!.data

const githubHref = t.footer.links.github
const downloadHref = `${githubHref}/releases`
// /docs doesn't exist yet — anchor to the repo README until it ships (arch doc, out-of-scope list).
const docsHref = `${githubHref}#readme`
---

<Hero t={t.hero} downloadHref={downloadHref} githubHref={githubHref} />
<Marquee t={t.marquee} />
<DemoSection t={t.demo} />
<RouterSection t={t.router} />
<FeaturesSection t={t.features} />
<ClosingCta t={t.closingCta} downloadHref={downloadHref} docsHref={docsHref} />
