---
import { getEntry } from 'astro:content'
import { getLocale } from '~/i18n'
import LocaleSwitcher from '~/components/LocaleSwitcher.astro'

const locale = getLocale(Astro.url)
const entry = await getEntry('landing', `${locale}/landing`)
const t = entry!.data
const homeHref = locale === 'pt' ? '/' : '/en/'
const blogHref = locale === 'pt' ? '/blog' : '/en/blog'
---

<header
	class="sticky top-0 z-50 flex h-16 items-center justify-between border-b border-[var(--border)] bg-[var(--background)]/80 px-6 backdrop-blur-md md:px-20"
>
	<a href={homeHref} class="flex items-center gap-1 text-lg font-extrabold tracking-tight" aria-label="CodeDM">
		<span>Code</span>
		<span class="rounded-md bg-[var(--primary)] px-1.5 py-0.5 text-[var(--primary-foreground)]">DM</span>
	</a>
	<div class="flex items-center gap-4">
		<a
			href={blogHref}
			class="hidden text-sm font-medium text-[var(--muted-foreground)] transition-colors hover:text-[var(--foreground)] sm:inline"
		>
			Blog
		</a>
		<a
			href="/docs"
			class="hidden text-sm font-medium text-[var(--muted-foreground)] transition-colors hover:text-[var(--foreground)] sm:inline"
		>
			{t.nav.docs}
		</a>
		<LocaleSwitcher />
		<a
			href="/download"
			class="inline-flex items-center justify-center rounded-full bg-[var(--primary)] px-4 py-2 text-sm font-semibold text-[var(--primary-foreground)] transition-opacity hover:opacity-90"
		>
			{t.nav.download}
		</a>
	</div>
</header>
