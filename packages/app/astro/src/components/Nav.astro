---
import { getEntry } from 'astro:content'
import LocaleSwitcher from '~/components/LocaleSwitcher.astro'
import { getLocale, routeFor } from '~/i18n'

const locale = getLocale(Astro.url)
const entry = await getEntry('landing', `${locale}/landing`)
const t = entry!.data

const homeHref = routeFor(locale, '/')
const blogHref = routeFor(locale, '/blog')
const githubHref = t.footer.links.github
const downloadHref = `${githubHref}/releases`

const anchors = [
	{ href: '#demo', label: t.nav.links.demo },
	{ href: '#router', label: t.nav.links.router },
	{ href: '#features', label: t.nav.links.features },
]
const pill =
	'whitespace-nowrap rounded-full px-[13px] py-2 text-[13px] font-semibold text-[var(--muted-foreground)] transition-colors hover:bg-[var(--muted)] hover:text-[var(--foreground)]'
---

<nav
	id="site-nav"
	class="fixed left-6 right-6 top-4 z-50 flex items-center gap-0.5 pb-1.5 pl-5 pr-1.5 pt-1.5 transition-[transform,opacity] duration-300"
>
	<a href={homeHref} class="mr-auto text-[14.5px] font-extrabold tracking-[-0.3px]" aria-label="CodeDM">
		Code<span class="ml-[3px] rounded-md bg-[var(--primary)] px-1.5 py-px text-[var(--primary-foreground)]">DM</span>
	</a>
	{anchors.map(anchor => <a href={anchor.href} class:list={['hidden sm:inline', pill]}>{anchor.label}</a>)}
	<a href={githubHref} class={pill}>{t.nav.links.github}</a>
	<a href={blogHref} class={pill}>{t.nav.links.blog}</a>
	<LocaleSwitcher />
	<a
		href={downloadHref}
		class="ml-3 whitespace-nowrap rounded-full bg-[var(--primary)] px-[18px] py-[9px] text-[13px] font-bold text-[var(--primary-foreground)] transition-opacity hover:opacity-90"
	>
		{t.nav.download}
	</a>
</nav>

<script>
	// Hide-on-scroll (D7): slide the pill row away scrolling down, bring it back
	// scrolling up. Skipped entirely under prefers-reduced-motion.
	const nav = document.getElementById('site-nav')
	if (nav && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let lastY = 0
		addEventListener(
			'scroll',
			() => {
				const y = scrollY
				const hidden = y > 80 && y > lastY
				nav.classList.toggle('-translate-y-[140%]', hidden)
				nav.classList.toggle('opacity-0', hidden)
				lastY = y
			},
			{ passive: true },
		)
	}
</script>
