---
import { getEntry } from 'astro:content'
import type { Locale } from '~/i18n'

interface Props {
	locale: Locale
}

const { locale } = Astro.props
const entry = await getEntry('landing', `home.${locale}`)
const t = entry!.data

// Footer GitHub label = nav label minus the external-arrow glyph (single copy source).
const githubLabel = t.nav.links.github.replace(/\s*↗\s*$/, '')
// /docs and /changelog don't exist yet — anchor to GitHub until those routes ship (arch doc, out-of-scope list).
const links = [
	{ href: t.footer.links.github, label: githubLabel },
	{ href: `${t.footer.links.github}#readme`, label: t.footer.links.docs },
	{ href: `${t.footer.links.github}/releases`, label: t.footer.links.changelog },
]
---

<footer
	class="mx-auto flex max-w-[1160px] flex-wrap items-center gap-5 px-11 pb-[30px] pt-[26px] text-[12.5px] text-[var(--muted-foreground)]/80"
>
	<span class="flex items-center text-sm font-extrabold tracking-tight text-[var(--foreground)]" aria-label="CODM">
		Code<span class="ml-0.5 rounded-[5px] bg-[var(--primary)] px-[5px] text-[var(--primary-foreground)]">DM</span>
	</span>
	<span>{t.footer.copyright}</span>
	<div class="ml-auto flex gap-5 font-semibold">
		{
			links.map(link => (
				<a href={link.href} class="text-[var(--muted-foreground)]/80 transition-colors hover:text-[var(--foreground)]">
					{link.label}
				</a>
			))
		}
	</div>
</footer>
