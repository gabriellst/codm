---
import type { CollectionEntry } from 'astro:content'
import DotWave from '../_islands/DotWave.tsx'

interface Props {
	t: CollectionEntry<'landing'>['data']['closingCta']
	downloadHref: string
	// Same honest label as the Hero's primary CTA (t.hero.downloadMac) — macOS
	// (Apple Silicon) only, no OS detection (Task T3).
	downloadLabel: string
	docsHref: string
}

const { t, downloadHref, downloadLabel, docsHref } = Astro.props
---

<section class="px-6 pb-6">
	<div
		class="dark relative mx-auto max-w-[1160px] overflow-hidden rounded-[36px] bg-[var(--route-background)] px-10 py-[110px] text-center text-[var(--foreground)]"
	>
		<div aria-hidden="true" class="pointer-events-none absolute inset-0">
			<DotWave client:visible variant="cta" />
		</div>
		<div class="relative">
			<h2
				class="mb-[18px] mt-0 text-balance text-[length:clamp(38px,5.5vw,68px)] font-extrabold leading-none tracking-[-1.5px]"
			>
				<span class="block">{t.titleBold}</span>
				<span class="block font-light">{t.titleLight}</span>
			</h2>
			<div class="mb-[34px] font-mono text-xs text-[var(--muted-foreground)]">{t.note}</div>
			<div class="flex flex-wrap items-center justify-center gap-2.5">
				<a
					href={downloadHref}
					class="whitespace-nowrap rounded-full bg-[var(--primary)] px-[26px] py-[13px] text-[14.5px] font-bold text-[var(--primary-foreground)] transition-opacity hover:opacity-90"
				>
					{downloadLabel}
				</a>
				<a
					href={docsHref}
					class="whitespace-nowrap rounded-full border-[1.5px] border-[var(--foreground)] px-6 py-[11.5px] text-[14.5px] font-bold text-[var(--foreground)] transition-colors hover:bg-[var(--secondary)]"
				>
					{t.secondary}
				</a>
			</div>
		</div>
	</div>
</section>
