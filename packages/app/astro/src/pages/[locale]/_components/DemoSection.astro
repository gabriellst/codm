---
import type { CollectionEntry } from 'astro:content'
import ChatMock from './ChatMock.astro'

interface Props {
	t: CollectionEntry<'landing'>['data']['demo']
}

const { t } = Astro.props
---

<section id="demo" class="px-6 pb-[110px] md:px-11">
	<div class="mx-auto grid max-w-[1020px] items-center gap-14 md:grid-cols-[0.9fr_1.1fr]">
		<div>
			<div class="mb-4 font-mono text-[11px] tracking-[2px] text-[var(--muted-foreground)]/80">{t.eyebrow}</div>
			<h2 class="mb-[18px] mt-0 text-balance text-[34px] font-extrabold leading-[1.1] tracking-[-0.8px]">{t.title}</h2>
			<p class="mb-6 mt-0 text-pretty text-[15px] leading-[1.65] text-[var(--muted-foreground)]">{t.body}</p>
			<div class="flex flex-col gap-[9px] font-mono text-xs text-[var(--muted-foreground)]">
				{
					t.steps.map((step, i) => (
						<div class="flex items-center gap-2.5">
							<span class="inline-flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full bg-[var(--muted)] text-[10px]">
								{i + 1}
							</span>
							<span>
								{step.body}
								{step.title && <span class="font-semibold text-[var(--foreground)]"> {step.title}</span>}
							</span>
						</div>
					))
				}
			</div>
		</div>
		<ChatMock t={t.chat} />
	</div>
</section>
