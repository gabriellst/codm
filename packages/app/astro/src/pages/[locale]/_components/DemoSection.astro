---
import type { CollectionEntry } from 'astro:content'
import Icon from '~/components/Icon.astro'

interface Props {
	t: CollectionEntry<'landing'>['data']['howItWorks']
}

const { t } = Astro.props

// D3 (design/codm.pen `ji2y3` → `zwRb8`, "Seção — Como funciona (escura)"): full-bleed
// #111111 section, three tilted gradient-green cards, each miming a different piece of UI
// (contact bubble+status pill / terminal / agent bubble+tag). The gradient HIGHLIGHT stops
// are one-off illustration compositions (see tokens.css comment on `--illustration-surface-*`)
// — kept as literal, commented inline gradients rather than tokenized.
const cardGradients = [
	'radial-gradient(140% 110% at 20% 15%, #4a7a16E6, #4a7a1600), radial-gradient(120% 90% at 90% 85%, #2c4a12CC, #2c4a1200)',
	'radial-gradient(140% 110% at 80% 20%, #3D660AE6, #3D660A00), radial-gradient(120% 90% at 15% 90%, #2c4a12CC, #2c4a1200)',
	'radial-gradient(140% 110% at 50% 90%, #5a9414E6, #5a941400), radial-gradient(120% 90% at 85% 10%, #233a10CC, #233a1000)',
] as const
---

<section id="how-it-works" class="relative overflow-hidden bg-[var(--site-dark)] px-6 py-24 md:px-16">
	<div aria-hidden="true" class="pointer-events-none absolute -left-40 -top-28 h-[360px] w-[560px] rounded-full bg-[var(--secondary-foreground)]/30 blur-[90px]"></div>
	<div aria-hidden="true" class="pointer-events-none absolute -right-10 bottom-0 h-[340px] w-[520px] rounded-full bg-[var(--primary)]/20 blur-[90px]"></div>

	<div class="relative mx-auto flex max-w-[1160px] flex-col items-center">
		<h2 class="m-0 text-balance text-center text-[length:clamp(32px,5vw,52px)] font-extrabold leading-none tracking-[-1.6px] text-white">
			{t.title}
		</h2>
		<p class="mx-auto mt-[18px] max-w-[640px] text-pretty text-center text-base leading-[1.55] text-[var(--site-dark-muted-foreground)]">{t.subtitle}</p>

		<div class="relative mt-[54px] grid w-full gap-6 px-3 md:grid-cols-3">
			{
				t.cards.map((card, i) => (
					<div
						class="relative flex h-[420px] flex-col overflow-hidden rounded-asymmetric-xl p-6 md:h-[560px]"
						style={{
							backgroundColor: i === 1 ? 'var(--illustration-surface-b)' : 'var(--illustration-surface-a)',
							backgroundImage: cardGradients[i],
							transform: `rotate(${i === 0 ? 1.2 : i === 1 ? -0.8 : 0.8}deg)`,
						}}
					>
						<span class="font-mono text-[13px] font-bold text-[var(--success-bright)]">{card.number}</span>
						{/* D-motion (2026-08-25) Decision 7 — "bolhas do demo de conversa": each card's inner UI
						    mock is a `reveal-back` group with a DOUBLED `--i` step (`--stagger` ×2 via `i * 2` —
						    "stagger sequencial mais lento", no separate token needed). Below the fold: no
						    `is-inview` in the markup. */}
						<div class="flex flex-1 flex-col items-center justify-center">
							{i === 0 && 'status' in card && (
								<div class="reveal-back reveal-stagger flex flex-col items-center" style={{ '--i': i * 2 }}>
									<div class="w-[250px] rounded-[6px_16px_16px_16px] bg-white px-[14px] py-[10px] text-[13.5px] leading-[1.45] text-[var(--foreground)]">
										{card.bubble}
									</div>
									<div class="mt-3 inline-flex items-center gap-[7px] rounded-full bg-white/[0.12] px-3 py-[6px]">
										<span class="h-1.5 w-1.5 rounded-full bg-[var(--success-bright)]" />
										<span class="font-mono text-[11px] text-white/80">{card.status}</span>
									</div>
								</div>
							)}
							{i === 1 && 'terminalLabel' in card && (
								<div
									class="reveal-back reveal-stagger w-[280px] rounded-asymmetric-md bg-[var(--illustration-terminal)]/80 p-[14px_16px]"
									style={{ '--i': i * 2 }}
								>
									<p class="m-0 font-mono text-[11.5px] leading-[1.55] text-[var(--success-bright)]">{card.terminalLabel}</p>
									<p class="m-0 font-mono text-[11.5px] leading-[1.55] text-[var(--terminal-text-mid)]">{card.terminalLines[0]}</p>
									<p class="m-0 font-mono text-[11.5px] leading-[1.55] text-[var(--terminal-text-dim)]">{card.terminalLines[1]}</p>
									<p class="m-0 font-mono text-[11.5px] leading-[1.55] text-[var(--success-bright)]">{card.terminalLines[2]}</p>
								</div>
							)}
							{i === 2 && 'tag' in card && (
								<div class="reveal-back reveal-stagger flex flex-col items-center" style={{ '--i': i * 2 }}>
									<span class="rounded-full bg-white/[0.12] px-[10px] py-1 font-mono text-[10.5px] text-white/80">{card.tag}</span>
									<div class="mt-[10px] w-[250px] rounded-[16px_6px_16px_16px] bg-[var(--primary)] px-[14px] py-[10px] text-[13.5px] leading-[1.45] text-[var(--primary-foreground)]">
										{card.bubble}
									</div>
								</div>
							)}
						</div>
						<div class="flex flex-col gap-[7px]">
							<h3 class="m-0 text-[18px] font-extrabold text-white">{card.title}</h3>
							<p class="m-0 text-[13.5px] leading-[1.5] text-white/70">{card.body}</p>
						</div>
					</div>
				))
			}
		</div>

		{/* D-motion (2026-08-25) Decision 7 — chips are "badges" (`reveal-back`, Decision 1). */}
		<div class="relative mt-10 flex flex-wrap items-center justify-center gap-3">
			{
				t.chips.map((chip, i) => (
					<div
						class="reveal-back reveal-stagger inline-flex items-center gap-[7px] rounded-asymmetric-md border border-white/[0.12] bg-white/[0.08] px-[13px] py-[8px]"
						style={{ '--i': i }}
					>
						{chip.icon === 'dot' ? (
							<span class="h-1.5 w-1.5 rounded-full bg-[var(--success-bright)]" />
						) : (
							<Icon name={chip.icon} size={13} class="text-[var(--success-bright)]" />
						)}
						<span class="text-xs font-semibold text-white/80">{chip.text}</span>
					</div>
				))
			}
		</div>
	</div>
</section>
