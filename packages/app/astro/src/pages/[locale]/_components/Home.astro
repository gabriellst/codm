---
import { getEntry } from 'astro:content'
import { DMG_DOWNLOAD_URL } from '~/config/download'
import type { Locale } from '~/i18n'
import ClosingCta from './ClosingCta.astro'
import DemoSection from './DemoSection.astro'
import FeaturesSection from './FeaturesSection.astro'
import Hero from './Hero.astro'
import Marquee from './Marquee.astro'
import PricingSection from './PricingSection.astro'
import RouterSection from './RouterSection.astro'

interface Props {
	locale: Locale
}

// Composition root for the home page: one getEntry, typed slices down. Sibling
// sections live next to this file in `_components/`; the interactive island lives
// in `../_islands/`.
const { locale } = Astro.props
const entry = await getEntry('landing', `home.${locale}`)
const t = entry!.data

const githubHref = t.footer.links.github
// Direct download link (Task T3) — fixed R2 alias, no OS detection, no
// GitHub-releases redirect. Single source of truth in ~/config/download.
const downloadHref = DMG_DOWNLOAD_URL
// /docs doesn't exist yet — anchor to the repo README until it ships (arch doc, out-of-scope list).
const docsHref = `${githubHref}#readme`
---

<Hero t={t.hero} downloadHref={downloadHref} githubHref={githubHref} />
<Marquee t={t.marquee} />
<DemoSection t={t.demo} />
<RouterSection t={t.router} />
<FeaturesSection t={t.features} />
<PricingSection locale={locale} t={t.pricing} />
<ClosingCta t={t.closingCta} downloadHref={downloadHref} downloadLabel={t.hero.downloadMac} docsHref={docsHref} />
