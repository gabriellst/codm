---
import { getEntry } from 'astro:content'
import BaseLayout from '~/layouts/BaseLayout.astro'
import Landing from '~/components/Landing.astro'

const entry = await getEntry('landing', 'pt/landing')
const t = entry!.data
---

<BaseLayout title={`CodeDM — ${t.hero.title}`} description={t.hero.subtitle}>
	<Landing locale="pt" />
</BaseLayout>
