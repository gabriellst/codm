		"android": "EXPO_PUBLIC_API_URL=http://localhost:3030 expo run:android --emulator",
		"android-device": "./scripts/run-device.sh android",
		"dev:ios:clean": "pkill -f 'expo|metro' 2>/dev/null; watchman watch-del-all 2>/dev/null; rm -rf \"$TMPDIR\"/metro-* \"$TMPDIR\"/haste-map-* ios/Pods ios/build ios/.xcode.env.local ~/Library/Developer/Xcode/DerivedData/* && cd ios && pod install --repo-update && cd .. && EXPO_PUBLIC_API_URL=http://localhost:3030 expo run:ios",
