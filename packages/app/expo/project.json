{
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"name": "app-expo",
	"sourceRoot": "packages/app/expo/app",
	"projectType": "application",
	"targets": {
		"tsc": {
			"executor": "nx:run-commands",
			"cache": true,
			"dependsOn": [{ "projects": "client-typescript", "target": "build" }],
			"inputs": [
				"{projectRoot}/app/**/*",
				"{projectRoot}/components/**/*",
				"{projectRoot}/lib/**/*",
				"{projectRoot}/locales/**/*",
				"{projectRoot}/tsconfig.json",
				"^production"
			],
			"options": { "command": "bun x tsc --noEmit", "cwd": "packages/app/expo" }
		},
		"lint": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["{projectRoot}/app/**/*", "{projectRoot}/components/**/*", "{projectRoot}/lib/**/*"],
			"options": { "command": "expo lint", "cwd": "packages/app/expo" }
		},
		"ios": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [{ "projects": "client-typescript", "target": "build" }],
			"options": { "command": "bun run ios", "cwd": "packages/app/expo" }
		},
		"ios-device": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [{ "projects": "client-typescript", "target": "build" }],
			"options": { "command": "bun run ios-device", "cwd": "packages/app/expo" }
		},
		"android": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [{ "projects": "client-typescript", "target": "build" }],
			"options": { "command": "bun run android", "cwd": "packages/app/expo" }
		},
		"android-device": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [{ "projects": "client-typescript", "target": "build" }],
			"options": { "command": "bun run android-device", "cwd": "packages/app/expo" }
		}
	}
}
