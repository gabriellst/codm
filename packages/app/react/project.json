{
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"name": "app-react",
	"sourceRoot": "packages/app/react/src",
	"projectType": "application",
	"targets": {
		"tsc": {
			"executor": "nx:run-commands",
			"cache": true,
			"dependsOn": [
				{
					"projects": "client-typescript",
					"target": "build"
				}
			],
			"inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tsconfig.json", "{projectRoot}/tsr.config.json"],
			"options": {
				"command": "bun x tsc --noEmit",
				"cwd": "packages/app/react"
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"cache": true,
			"dependsOn": ["tsc"],
			"inputs": ["production", "{projectRoot}/vite.config.ts", "{projectRoot}/index.html"],
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "vite build",
				"cwd": "packages/app/react"
			}
		},
		"build-spa": {
			"executor": "nx:run-commands",
			"cache": true,
			"dependsOn": ["tsc"],
			"inputs": ["production", "{projectRoot}/vite.config.ts"],
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "CODM_DESKTOP=true vite build && if [ ! -f dist/client/_shell.html ]; then echo 'build-spa: dist/client/_shell.html missing — TanStack Start renamed its SPA shell output; update build-spa in project.json' >&2; exit 1; fi && cp dist/client/_shell.html dist/client/index.html",
				"cwd": "packages/app/react"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [
				{
					"projects": "client-typescript",
					"target": "build"
				}
			],
			"options": {
				"command": "vite --host",
				"cwd": "packages/app/react"
			}
		},
		"dev-spa": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [
				{
					"projects": "client-typescript",
					"target": "build"
				}
			],
			"options": {
				"command": "PORT= CODM_DESKTOP=true CODM_DESKTOP_DEV=true vite --host",
				"cwd": "packages/app/react"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"cache": true,
			"dependsOn": [
				{
					"projects": "client-typescript",
					"target": "build"
				}
			],
			"inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tests/**/*", "{projectRoot}/bunfig.toml"],
			"options": {
				"command": "bun test",
				"cwd": "packages/app/react"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["{projectRoot}/src/**/*", "{workspaceRoot}/eslint.config.ts"],
			"options": {
				"command": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
				"cwd": "packages/app/react"
			}
		}
	}
}
