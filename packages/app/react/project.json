{
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"name": "app-react",
	"sourceRoot": "packages/app/react/src",
	"projectType": "application",
	"targets": {
		"tsc": {
			"executor": "nx:run-commands",
			"cache": true,
			"dependsOn": [{ "projects": "client-typescript", "target": "build" }],
			"inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tsconfig.json", "{projectRoot}/tsr.config.json"],
			"options": { "command": "bun x tsc --noEmit", "cwd": "packages/app/react" }
		},
		"build": {
			"executor": "nx:run-commands",
			"cache": true,
			"dependsOn": ["tsc"],
			"inputs": ["production", "{projectRoot}/vite.config.ts", "{projectRoot}/index.html"],
			"outputs": ["{projectRoot}/dist"],
			"options": { "command": "vite build", "cwd": "packages/app/react" }
		},
		"dev": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [{ "projects": "client-typescript", "target": "build" }],
			"options": { "command": "vite --host", "cwd": "packages/app/react" }
		},
		"lint": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["{projectRoot}/src/**/*", "{workspaceRoot}/eslint.config.ts"],
			"options": {
				"command": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
				"cwd": "packages/app/react"
			}
		}
	}
}
