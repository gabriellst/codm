{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"jsx": "react-jsx",

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"allowSyntheticDefaultImports": true,

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		/* Path mapping */
		"paths": {
			"@/*": ["./src/*"]
		},

		/* Type resolution - use root node_modules for shared types */
		"typeRoots": ["../node_modules/@types", "./node_modules/@types"]
	},
	"include": ["src", "tests"],
	"exclude": ["node_modules", "dist", "storybook-static", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
