{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"jsx": "react-jsx",

		/* tsyringe-neo decorator metadata (spec Decision 5) — Bun resolves ONE tsconfig for the whole
		 * test run (the nearest to CWD, i.e. this file), not per-source-file, so classes pulled in
		 * transitively from packages/api/typescript/src/** (the integration harness's backend
		 * controllers/use cases) need these enabled HERE too, even though this console itself never
		 * declares a decorator. Without this, tsyringe-neo throws `TypeInfo not known for "<Class>"` —
		 * `Reflect.getMetadata('design:paramtypes', …)` comes back empty because Bun's transpiler
		 * never emitted it. Mirrors packages/api/typescript/tsconfig.json. */
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"allowSyntheticDefaultImports": true,

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		/* Path mapping */
		"paths": {
			"@/*": ["./src/*"]
		},

		/* Type resolution - use root node_modules for shared types */
		"typeRoots": ["../node_modules/@types", "./node_modules/@types"]
	},
	"include": ["src", "tests", "scripts"],
	"exclude": [
		"node_modules",
		"dist",
		"storybook-static",
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"tests/**/*.test.ts"
	]
}
