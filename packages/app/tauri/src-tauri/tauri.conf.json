{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "CodeDM",
	"version": "0.1.0",
	"identifier": "app.codedm.desktop",
	"build": {
		"devUrl": "http://localhost:5173/",
		"frontendDist": "../../react/dist/client",
		"beforeDevCommand": "bun x nx run app-react:dev-spa",
		"beforeBuildCommand": "bun x nx run app-react:build-spa"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "CodeDM",
				"width": 1280,
				"height": 800,
				"minWidth": 980,
				"minHeight": 640,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": {
					"x": 19,
					"y": 18
				},
				"visible": false
			},
			{
				"label": "boot-error",
				"width": 720,
				"height": 520,
				"url": "boot-error.html",
				"visible": false,
				"title": "CodeDM — boot failed"
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://localhost:3030 http://127.0.0.1:3030 ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": [
			"binaries/codedm-daemon",
			"binaries/codedm-gateway"
		],
		"icon": [
			"icons/icon.icns",
			"icons/icon.ico",
			"icons/32x32.png",
			"icons/128x128.png"
		],
		"resources": {
			"binaries/migrations": "migrations",
			"binaries/daemon-runtime": "daemon-runtime"
		}
	}
}
