{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "CodeDM",
	"version": "0.1.0",
	"identifier": "app.codedm.desktop",
	"build": {
		"devUrl": "http://localhost:5173/app/",
		"frontendDist": "../../react/dist/client",
		"beforeDevCommand": "bun x nx run app-react:dev",
		"beforeBuildCommand": "bun x nx run app-react:build-spa"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "CodeDM",
				"width": 1280,
				"height": 800,
				"minWidth": 980,
				"minHeight": 640
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://localhost:3030 http://127.0.0.1:3030 ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": [
			"binaries/codedm-daemon",
			"binaries/codedm-gateway"
		],
		"icon": [
			"icons/icon.icns",
			"icons/icon.ico",
			"icons/32x32.png",
			"icons/128x128.png"
		]
	}
}
