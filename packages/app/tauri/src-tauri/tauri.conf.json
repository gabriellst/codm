{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "CODM",
	"version": "0.1.6",
	"identifier": "app.codm.desktop",
	"build": {
		"devUrl": "http://localhost:5173/",
		"frontendDist": "../../react/dist/client",
		"beforeDevCommand": "bun x nx run app-react:dev-spa",
		"beforeBuildCommand": "bun x nx run app-react:build-spa"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "CODM",
				"width": 1280,
				"height": 800,
				"minWidth": 980,
				"minHeight": 640,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": {
					"x": 19,
					"y": 18
				},
				"visible": false
			},
			{
				"label": "boot-error",
				"width": 720,
				"height": 520,
				"url": "boot-error.html",
				"visible": false,
				"title": "CODM — boot failed"
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://localhost:3030 http://127.0.0.1:3030 ipc: http://ipc.localhost"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMjEzMzQwOTY5MkUxMjcKUldRbjRaS1dRRE1oMDVKSTE2UFZiaVNZYjNTeU4wYnl3RUdXN1V4eG5zSjRiQ3V3QXVIamtxMkgK",
			"endpoints": [
				"https://pub-ae0c8cac60c94920b35464575c09e67d.r2.dev/stable/latest.json"
			]
		},
		"deep-link": {
			"desktop": {
				"schemes": [
					"codm"
				]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"externalBin": [
			"binaries/codm-daemon",
			"binaries/codm-gateway"
		],
		"icon": [
			"icons/icon.icns",
			"icons/icon.ico",
			"icons/32x32.png",
			"icons/128x128.png"
		],
		"resources": {
			"binaries/migrations": "migrations",
			"binaries/daemon-runtime": "daemon-runtime"
		},
		"macOS": {
			"signingIdentity": "-",
			"entitlements": "entitlements.plist"
		}
	}
}
